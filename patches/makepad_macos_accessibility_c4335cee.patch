+
+fn scale_accessibility_update(mut update: TreeUpdate, factor: f64) -> TreeUpdate {
+    if factor.is_finite() && factor > 0.0 && factor != 1.0 {
+        for (_, node) in &mut update.nodes {
+            if let Some(bounds) = node.bounds() {
+                node.set_bounds(AccessibilityRect {
+                    x0: bounds.x0 * factor,
+                    y0: bounds.y0 * factor,
+                    x1: bounds.x1 * factor,
+                    y1: bounds.y1 * factor,
+                });
+            }
+        }
+    }
+    update
+}
