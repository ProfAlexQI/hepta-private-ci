+#[cfg(test)]
+mod accessibility_tests {
+    use super::*;
+    use accesskit::{Action, Node, NodeId, Role, Tree, TreeId};
+
+    fn update_with_bounds(bounds: AccessibilityRect) -> TreeUpdate {
+        let root = NodeId(1);
+        let mut node = Node::new(Role::Window);
+        node.set_bounds(bounds);
+        TreeUpdate {
+            nodes: vec![(root, node)],
+            tree: Some(Tree {
+                root,
+                toolkit_name: Some("Makepad".into()),
+                toolkit_version: None,
+            }),
+            tree_id: TreeId::ROOT,
+            focus: root,
+        }
+    }
+
+    #[test]
+    fn accessibility_bounds_are_scaled_to_physical_pixels() {
+        let update = scale_accessibility_update(
+            update_with_bounds(AccessibilityRect {
+                x0: 10.0,
+                y0: 20.0,
+                x1: 110.0,
+                y1: 70.0,
+            }),
+            2.0,
+        );
+        assert_eq!(
+            update.nodes[0].1.bounds(),
+            Some(AccessibilityRect {
+                x0: 20.0,
+                y0: 40.0,
+                x1: 220.0,
+                y1: 140.0,
+            })
+        );
+    }
+
+    #[test]
+    fn activation_returns_the_latest_full_tree() {
+        let expected = update_with_bounds(AccessibilityRect {
+            x0: 0.0,
+            y0: 0.0,
+            x1: 100.0,
+            y1: 100.0,
+        });
+        let latest_update = Rc::new(RefCell::new(Some(expected.clone())));
+        let mut handler = MacosAccessibilityActivation { latest_update };
+        assert_eq!(handler.request_initial_tree(), Some(expected));
+    }
+
+    #[test]
+    fn accessibility_action_requests_are_forwarded_to_the_makepad_sink() {
+        let expected = ActionRequest {
+            action: Action::Focus,
+            target_tree: TreeId::ROOT,
+            target_node: NodeId(7),
+            data: None,
+        };
+        let received = Rc::new(RefCell::new(None));
+        let received_for_sink = received.clone();
+        let mut handler = MacosAccessibilityActions::new(move |request| {
+            *received_for_sink.borrow_mut() = Some(request);
+        });
+
+        handler.do_action(expected.clone());
+
+        assert_eq!(*received.borrow(), Some(expected));
+    }
+}
