#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pathname"

root = Pathname.new(__dir__).join("..").expand_path
producer_parts = (1..4).map do |index|
  root.join("scripts/hepta-ui-v4-exact-head-qualification-index.part#{index}.rb")
end
files = {
  producer: root.join("scripts/hepta-ui-v4-exact-head-qualification-index"),
  workflow: root.join(".github/workflows/hepta-ui-v4-exact-head-qualification-index.yml"),
  schema: root.join("docs/ui/schemas/hepta.ui.v4.exact-head-qualification-index.v1.schema.json"),
  contract: root.join("docs/ui/HEPTA_UI_EXACT_HEAD_QUALIFICATION_INDEX_V1.json"),
  document: root.join("docs/ui/HEPTA_UI_V4_TRANCHE_18_EXACT_HEAD_QUALIFICATION_INDEX_2026-08-28.md")
}.freeze

checks = {}
files.each { |name, path| checks["file.#{name}"] = path.file? && !path.zero? }
producer_parts.each_with_index do |path, index|
  checks["file.producer_part#{index + 1}"] = path.file? && !path.zero?
end
producer = ([files.fetch(:producer)] + producer_parts).map(&:read).join
workflow = files.fetch(:workflow).read
schema = JSON.parse(files.fetch(:schema).read)
contract = JSON.parse(files.fetch(:contract).read)
document = files.fetch(:document).read

checks["producer.statuses"] = %w[
  PASS_EXACT_HEAD_PRE_RUNTIME_QUALIFICATION
  PASS_EXACT_HEAD_WINDOWS_RUNTIME_QUALIFICATION
  FAIL_EXACT_HEAD_QUALIFICATION_INDEX
  PASS_EXACT_HEAD_QUALIFICATION_INDEX_SELF_TEST
].all? { |status| producer.include?(status) }
checks["producer.inherited_source_statuses"] = %w[
  PASS_WINDOWS_MATERIAL_PROFILE_AGGREGATE_SOURCE_ONLY
  PASS_WINDOWS_MATERIAL_PROFILE_RUNTIME_SOURCE_ONLY
  PASS_EXACT_CANDIDATE_MATERIALIZATION_HARDENING_SOURCE_ONLY
  PASS_EXACT_HEAD_QUALIFICATION_CLOSURE_SOURCE_ONLY
].all? { |status| producer.include?(status) } &&
  !producer.lines.first(30).join.include?("PASS_EXACT_HEAD_QUALIFICATION_INDEX_SOURCE_ONLY")
checks["producer.jobs"] = [
  "Exact-head full source chain and patcher self-test",
  "Candidate-bound Makepad materialization",
  "Exact-head compile and focused tests (ubuntu-latest)",
  "Exact-head compile and focused tests (windows-latest)",
  "Exact-head compile and focused tests (macos-latest)",
  "Governed exact-head Windows Mica/Acrylic producer"
].all? { |term| producer.include?(term) }
checks["producer.executable_evidence"] =
  producer.include?("runner_id missing") &&
  producer.include?("runner_name missing") &&
  producer.include?("steps missing") &&
  producer.include?("missing steps")
checks["producer.identity_binding"] =
  producer.include?("candidate commit invalid") &&
  producer.include?("candidate tree invalid") &&
  producer.include?("materialization commit drift") &&
  producer.include?("materialization tree drift") &&
  producer.include?("runtime commit drift") &&
  producer.include?("runtime tree drift")
checks["producer.runtime_chain"] = %w[
  VerifiedPersistentChromeWithBackdropReadback
  VerifiedAcrylicWithBackdropReadback
  VerifiedSolidRollbackWithBackdropReadback
  Destroyed\ identity\ drift
  runtime\ sequence\ order\ drift
].all? { |term| producer.include?(term.tr("\\", "")) }
checks["producer.atomic_bounded"] =
  producer.include?("write_json_atomic") && producer.include?("failures.uniq.first(64)")
checks["producer.self_tests"] =
  producer.include?("pre-runtime self-test failed") &&
  producer.include?("runtime self-test failed") &&
  producer.include?("failure self-test did not fail")
checks["producer.authority_false"] = %w[
  network mutation effect liveAdapter production operatorAcceptance promotion release
].all? { |key| producer.include?("\"#{key}\" => false") }

checks["schema.statuses"] = schema.dig("properties", "status", "enum") == %w[
  PASS_EXACT_HEAD_PRE_RUNTIME_QUALIFICATION
  PASS_EXACT_HEAD_WINDOWS_RUNTIME_QUALIFICATION
  FAIL_EXACT_HEAD_QUALIFICATION_INDEX
]
checks["schema.four_source_statuses"] =
  schema.dig("$defs", "sourceEvidence", "properties", "statuses", "minItems") == 4 &&
  schema.dig("$defs", "sourceEvidence", "properties", "statuses", "maxItems") == 4
checks["schema.strict_candidate"] =
  schema.dig("$defs", "candidate", "additionalProperties") == false &&
  schema.dig("$defs", "gitObject", "pattern") == "^[0-9a-f]{40}$"
checks["schema.authority_false"] =
  schema.dig("$defs", "authority", "properties").values.all? { |entry| entry["const"] == false }
checks["schema.product_false"] = %w[
  productBound transientSystemMaterialBound completeProfileBound
  systemMaterialBound nativeProductRuntime deviceValidation
].all? { |key| schema.dig("$defs", "qualification", "properties", key, "const") == false }
checks["schema.failure_bounded"] =
  schema.dig("properties", "failures", "maxItems") == 64 &&
  schema.dig("properties", "failures", "items", "maxLength") == 4096

checks["contract.source_only"] =
  contract.dig("qualification", "sourceImplemented") == true &&
  contract.fetch("qualification").reject { |key, _| key == "sourceImplemented" }.values.none? &&
  contract.fetch("authority").values.none?
checks["contract.replay_model"] =
  contract.dig("producer", "completedRunReplayRequired") == true &&
  contract.dig("producer", "indexSourceGateIsSeparate") == true &&
  contract.fetch("sourceStatuses").length == 4
checks["contract.platforms_makepad"] =
  contract.dig("producer", "compilePlatforms") == %w[ubuntu-latest windows-latest macos-latest] &&
  contract.dig("producer", "makepadRevision") == "c4335cee10b22aca768510c9d072b0ca1bba15c8"

checks["workflow.triggers"] =
  workflow.include?("workflow_run:") && workflow.include?("workflow_dispatch:") &&
  workflow.include?("pull_request:")
checks["workflow.read_only"] =
  workflow.include?("contents: read") && workflow.include?("actions: read") &&
  !workflow.match?(/^\s*(?:deploy|publish|release)\s*:/i)
checks["workflow.source_gate"] =
  workflow.include?("hepta-ui-v4-exact-head-qualification-index --self-test") &&
  workflow.include?("hepta-ui-v4-exact-head-qualification-index-gate") &&
  workflow.include?("PASS_EXACT_HEAD_QUALIFICATION_INDEX_SOURCE_ONLY")
checks["workflow.source_run_validation"] =
  workflow.include?("wrong workflow") && workflow.include?("source run is not completed") &&
  workflow.include?("repository drift") && workflow.include?("invalid source head")
checks["workflow.jobs_artifacts"] =
  workflow.include?("actions/runs/$SOURCE_RUN_ID/jobs?per_page=100") &&
  workflow.include?("actions/runs/$SOURCE_RUN_ID/artifacts?per_page=100") &&
  workflow.include?("archive_download_url") && workflow.include?("unsafe artifact name")
checks["workflow.producer_cli"] = %w[
  --jobs --artifacts --candidate-commit --candidate-tree --repository --run-id --output
].all? { |term| workflow.include?(term) }
checks["workflow.runtime_mode"] =
  workflow.include?("require_windows_runtime") &&
  workflow.include?("--require-windows-runtime") &&
  workflow.include?("PASS_EXACT_HEAD_WINDOWS_RUNTIME_QUALIFICATION")
checks["workflow.bounded_failure"] =
  workflow.include?("continue-on-error: true") &&
  workflow.include?("FAIL_EXACT_HEAD_QUALIFICATION_INDEX") &&
  workflow.include?("failure list missing")

checks["document.boundary"] =
  document.include?("PASS_EXACT_HEAD_PRE_RUNTIME_QUALIFICATION") &&
  document.include?("PASS_EXACT_HEAD_WINDOWS_RUNTIME_QUALIFICATION") &&
  document.include?("productBound=false") && document.include?("release=false")

failures = checks.reject { |_key, value| value }.keys
puts JSON.pretty_generate(
  schema: "hepta.ui.v4.exact-head-qualification-index-source-gate.v1",
  status: failures.empty? ? "PASS_EXACT_HEAD_QUALIFICATION_INDEX_SOURCE_ONLY" :
    "FAIL_EXACT_HEAD_QUALIFICATION_INDEX_SOURCE",
  source_implemented: failures.empty?,
  hosted_index_validation: false,
  pre_runtime_qualification: false,
  windows_runtime_qualification: false,
  product_bound: false,
  transient_system_material_binding: false,
  complete_profile_binding: false,
  system_material_binding: false,
  native_product_runtime: false,
  device_validation: false,
  production_authority: false,
  effect_authority: false,
  live_adapter_authority: false,
  operator_acceptance: false,
  promotion: false,
  release: false,
  checks: checks,
  failures: failures
)
exit(failures.empty? ? 0 : 1)
