#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE="$ROOT/scripts/hepta-durable-memory-receipt-boundary-route-gate-specs-v1.json"

usage() {
  echo "usage: scripts/hepta-durable-memory-receipt-boundary-route-gate-runner <id|--validate>" >&2
  exit 2
}

sha256_text() {
  printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
}

validate_registry() {
  jq -e '
    .schema_version == "hepta_durable_memory_receipt_boundary_route_gate_specs_v1"
    and .executor == "scripts/hepta-durable-memory-receipt-boundary-route-gate-runner"
    and .receipt_state_machine == ["precondition", "denial", "receipt", "persistence", "retention", "terminal"]
    and (.specs | length) == 3
    and ((.specs | map(.id) | unique | length) == 3)
    and (.specs | map(.gate_spec.receipt_state)) == ["persistence", "persistence", "persistence"]
    and (.specs | all(
      (.id | test("^[a-z0-9-]+$"))
      and .gate_spec.method == "GET"
      and .gate_spec.pattern == ("/api/" + .id)
      and .gate_spec.source_command == ("/" + .id + " --json")
      and .gate_spec.capability == .id
      and (.gate_spec.side_effect_boundary | contains("performs no"))
      and (.wrapper | test("^scripts/[a-z0-9-]+-route-gate\\.sh$"))
      and (.source.capture_label | test("^[a-z0-9-]+-gate$"))
      and (.source.script | test("^scripts/[a-z0-9-]+-gate\\.sh$"))
      and (.source.validation_filter | type == "string" and length > 100)
      and (.native_requirements | type == "array" and length >= 8)
      and (.focused_test | test("^[a-z0-9_]+$"))
      and (.test_log_stem | test("^[a-z0-9-]+$"))
      and (.live_validation_filter | type == "string" and length > 100)
      and (.normalization_remove_fields | type == "array" and length >= 7)
      and (.baseline_normalized_output_sha256 | test("^[0-9a-f]{64}$"))
      and (.report_template | type == "object" and length > 20)
    ))
  ' "$SPEC_FILE" >/dev/null
}

[[ -f "$SPEC_FILE" ]] || {
  echo "missing durable Memory receipt-boundary route registry: $SPEC_FILE" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}

[[ $# == 1 ]] || usage
if [[ "$1" == "--validate" ]]; then
  validate_registry
  echo '{"schema":"hepta_durable_memory_receipt_boundary_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
  exit 0
fi

id="$1"
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
validate_registry
spec="$(jq -cer --arg id "$id" '.specs[] | select(.id == $id)' "$SPEC_FILE")" || {
  echo "unknown durable Memory receipt-boundary route spec id: $id" >&2
  exit 1
}

BASE_URL="${HEPTA_LIVE_URL:-http://127.0.0.1:7373}"
MANIFEST="${HEPTA_MANIFEST:-codex-rs/Cargo.toml}"
REQUIRE_LIVE_ENDPOINT="${HEPTA_ROUTE_GATE_REQUIRE_LIVE_ENDPOINT:-0}"
EXPECTED_ROUTE_COUNT="${HEPTA_EXPECTED_ROUTE_COUNT:-$(bash "$ROOT/scripts/lib/hepta-native-route-count.sh")}"
NATIVE_GATEWAY_SOURCE="hepta-native-gateway-source-set-v1"

cd "$ROOT"
source scripts/lib/hepta-json-report-capture.sh
source scripts/lib/hepta-source-set.sh

source_json="$(
  capture_json_report \
    "$(jq -r '.source.capture_label' <<<"$spec")" \
    "$(jq -r '.source.script' <<<"$spec")"
)"
jq -e "$(jq -r '.source.validation_filter' <<<"$spec")" >/dev/null <<<"$source_json"

while IFS= read -r requirement; do
  require_source_text \
    "$(jq -r '.file' <<<"$requirement")" \
    "$(jq -r '.text' <<<"$requirement")" \
    "$id native route invariant"
done < <(jq -c '.native_requirements[]' <<<"$spec")

TEST_LOG="$(mktemp "/tmp/$(jq -r '.test_log_stem' <<<"$spec").XXXXXX")"
trap 'rm -f "$TEST_LOG"' EXIT
cargo test --offline --manifest-path "$MANIFEST" -q -p hepta-native-gateway --lib \
  "$(jq -r '.focused_test' <<<"$spec")" -- --nocapture >"$TEST_LOG"

live_json='{}'
live_checked=false
if [[ "$REQUIRE_LIVE_ENDPOINT" == "1" ]]; then
  live_json="$(curl -fsS "$BASE_URL$(jq -r '.gate_spec.pattern' <<<"$spec")")"
  jq -e --argjson expected "$EXPECTED_ROUTE_COUNT" \
    "$(jq -r '.live_validation_filter' <<<"$spec")" >/dev/null <<<"$live_json"
  live_checked=true
fi

terminal_json="$(
  capture_json_report \
    "hepta-preflight-terminal-coverage-inventory-gate" \
    scripts/hepta-preflight-terminal-coverage-inventory-gate.sh
)"
jq -e '
  .status == "ready"
  and .preflight_terminal_coverage_inventory_ready == true
  and .required_marker_count >= 300
  and .present_required_marker_count == .required_marker_count
  and .missing_required_marker_count == 0
  and .duplicate_required_marker_count == 0
  and .out_of_order_required_marker_count == 0
' >/dev/null <<<"$terminal_json"

source_sha256="$(sha256_text "$source_json")"
native_gateway_sha256="$(sha256_file "$NATIVE_GATEWAY_SOURCE")"
test_log_sha256="$(sha256_file "$TEST_LOG")"
live_route_sha256="$(sha256_text "$live_json")"
terminal_coverage_sha256="$(sha256_text "$terminal_json")"

report="$(
  jq -n \
    --argjson spec "$spec" \
    --argjson expected_route_count "$EXPECTED_ROUTE_COUNT" \
    --argjson require_live_endpoint "$REQUIRE_LIVE_ENDPOINT" \
    --argjson live_endpoint_verified "$live_checked" \
    --arg source_sha256 "$source_sha256" \
    --arg native_gateway_sha256 "$native_gateway_sha256" \
    --arg focused_test_log "$TEST_LOG" \
    --arg test_log_sha256 "$test_log_sha256" \
    --arg live_route_sha256 "$live_route_sha256" \
    --arg terminal_coverage_sha256 "$terminal_coverage_sha256" \
    --argjson source "$source_json" \
    --argjson live "$live_json" \
    --argjson terminal "$terminal_json" '
      def set_if_present($key; $value):
        if has($key) then .[$key] = $value else . end;
      $spec.report_template
      | set_if_present("expected_route_count"; $expected_route_count)
      | set_if_present("require_live_endpoint"; $require_live_endpoint)
      | set_if_present("live_endpoint_required"; $live_endpoint_verified)
      | set_if_present("live_endpoint_verified"; $live_endpoint_verified)
      | set_if_present("native_gateway_sha256"; $native_gateway_sha256)
      | set_if_present("focused_test_log"; $focused_test_log)
      | set_if_present("focused_test_log_sha256"; $test_log_sha256)
      | set_if_present("test_log_sha256"; $test_log_sha256)
      | set_if_present("script_gate_sha256"; $source_sha256)
      | set_if_present("script_gate_status"; $source.status)
      | set_if_present("live_route_sha256"; $live_route_sha256)
      | set_if_present("live_route_status"; (if $live_endpoint_verified then ($live.status // "unknown") else "not_required" end))
      | set_if_present("live_route_count"; ($live.route_count // null))
      | set_if_present("live_missing_route_count"; ($live.missing_route_count // null))
      | set_if_present("terminal_coverage_sha256"; $terminal_coverage_sha256)
      | set_if_present("terminal_coverage_present_required_marker_count"; $terminal.present_required_marker_count)
      | set_if_present("terminal_coverage_required_marker_count"; $terminal.required_marker_count)
      | set_if_present("terminal_present_required_marker_count"; $terminal.present_required_marker_count)
      | set_if_present("terminal_required_marker_count"; $terminal.required_marker_count)
      | set_if_present("terminal_missing_required_marker_count"; $terminal.missing_required_marker_count)
    '
)"

actual_output_sha="$(
  jq -S --argjson remove "$(jq -c '.normalization_remove_fields' <<<"$spec")" \
    'delpaths($remove | map([.]))' <<<"$report" |
    shasum -a 256 | awk '{print $1}'
)"
expected_output_sha="$(jq -r '.baseline_normalized_output_sha256' <<<"$spec")"
[[ "$actual_output_sha" == "$expected_output_sha" ]] || {
  echo "durable Memory receipt-boundary route normalized output parity mismatch for $id: $actual_output_sha != $expected_output_sha" >&2
  exit 1
}

jq . <<<"$report"
