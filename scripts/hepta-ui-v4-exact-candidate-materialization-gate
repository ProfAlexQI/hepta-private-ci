#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pathname"

root = Pathname.new(__dir__).join("..").expand_path
files = {
  materializer: root.join("scripts/hepta-ui-v4-materialize-makepad-windows-hook"),
  wrapper: root.join("scripts/hepta-ui-v4-run-fixed-makepad-windows-ack-patch"),
  contract: root.join("docs/ui/HEPTA_UI_EXACT_CANDIDATE_MATERIALIZATION_HARDENING_V1.json"),
  schema: root.join("docs/ui/schemas/hepta.ui.v4.vendored-makepad-materialization.v1.schema.json"),
  workflow: root.join(".github/workflows/hepta-ui-v4-windows-material-profile-exact.yml")
}.freeze

checks = {}
files.each { |name, path| checks["file.#{name}"] = path.file? && !path.zero? }

materializer = files[:materializer].read
wrapper = files[:wrapper].read
contract = JSON.parse(files[:contract].read)
schema = JSON.parse(files[:schema].read)
workflow = files[:workflow].read

checks["materializer.failure_receipt"] =
  materializer.include?("FAIL_PATCHED_CHECKOUT_MATERIALIZATION") &&
  materializer.include?("write_json_atomic(receipt, payload)") &&
  materializer.include?("patchReceiptPresent") &&
  materializer.include?("byteslice(0, 4096)")
checks["materializer.no_stale_override"] = materializer.include?("FileUtils.rm_f(config)")
checks["wrapper.self_test"] =
  wrapper.include?("--self-test") &&
  wrapper.include?("PASS_MAKEPAD_PATCHER_SELF_TEST") &&
  wrapper.include?("ambiguous match was accepted")
checks["wrapper.safe_replacement"] =
  wrapper.include?("text.sub(before) { after }") &&
  wrapper.include?("text.sub(pattern) { replacement }")
checks["wrapper.canonical_blob_bound"] =
  wrapper.include?("369e607f4f80d08d739d2f83778fb4e37aa50d4e")
checks["schema.pass_fail"] =
  schema.dig("properties","status","enum")&.sort ==
    %w[FAIL_PATCHED_CHECKOUT_MATERIALIZATION PASS_PATCHED_CHECKOUT_MATERIALIZED_SOURCE_ONLY].sort
checks["schema.authority_false"] =
  schema.dig("properties","authority","properties").values.all? { |entry| entry["const"] == false }
checks["contract.source_only"] =
  contract.dig("qualification","sourceImplemented") == true &&
  contract.fetch("qualification").reject { |key, _| key == "sourceImplemented" }.values.none? &&
  contract.fetch("authority").values.none?

checks["workflow.exact_candidate_env"] =
  workflow.include?('HEPTA_CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}')
checks["workflow.exact_checkout"] =
  workflow.scan('ref: ${{ env.HEPTA_CANDIDATE_SHA }}').length >= 3 &&
  workflow.include?('test "$(git rev-parse HEAD)" = "$HEPTA_CANDIDATE_SHA"')
checks["workflow.pipefail"] = workflow.scan("set -o pipefail").length >= 2
checks["workflow.self_test"] =
  workflow.include?("hepta-ui-v4-run-fixed-makepad-windows-ack-patch --self-test")
checks["workflow.read_only"] =
  workflow.include?("permissions:") && workflow.include?("contents: read") &&
  !workflow.match?(/^\s*(?:deploy|publish|release)\s*:/i)

failures = checks.reject { |_key, value| value }.keys
puts JSON.pretty_generate(
  schema: "hepta.ui.v4.exact-candidate-materialization-hardening-source-gate.v1",
  status: failures.empty? ? "PASS_EXACT_CANDIDATE_MATERIALIZATION_HARDENING_SOURCE_ONLY" :
    "FAIL_EXACT_CANDIDATE_MATERIALIZATION_HARDENING_SOURCE",
  source_implemented: failures.empty?,
  exact_head_hosted_validation: false,
  materialization_success: false,
  failure_receipt_runtime_validation: false,
  patched_makepad_compile_validation: false,
  windows_runtime_validation: false,
  product_bound: false,
  system_material_binding: false,
  production_authority: false,
  effect_authority: false,
  live_adapter_authority: false,
  operator_acceptance: false,
  promotion: false,
  release: false,
  checks: checks,
  failures: failures
)
exit(failures.empty? ? 0 : 1)
