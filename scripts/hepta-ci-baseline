#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
MANIFEST="$ROOT/codex-rs/Cargo.toml"
source "$ROOT/scripts/lib/hepta-v2-test-inventory.sh"

usage() {
  echo "usage: scripts/hepta-ci-baseline <contract|contract-self-test|static|ui-contract|nightly-static|rust-backend|full-workspace>" >&2
  exit 2
}

require_tools() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null || {
      echo "missing Hepta CI baseline tool: $tool" >&2
      exit 1
    }
  done
}

assert_lockfiles_clean() {
  if ! git -C "$ROOT" diff --quiet -- codex-rs/Cargo.lock apps/hepta-native/Cargo.lock MODULE.bazel.lock \
    || ! git -C "$ROOT" diff --cached --quiet -- codex-rs/Cargo.lock apps/hepta-native/Cargo.lock MODULE.bazel.lock; then
    echo "Hepta CI baseline detected dependency lockfile drift" >&2
    git -C "$ROOT" status --short -- \
      codex-rs/Cargo.lock apps/hepta-native/Cargo.lock MODULE.bazel.lock >&2
    exit 1
  fi
}

run_static() {
  require_tools bash git jq perl python3 rg shasum
  cd "$ROOT"
  run_static_gate architecture-budget-verify scripts/hepta-architecture-budget verify
  run_static_gate architecture-budget-self-test scripts/hepta-architecture-budget self-test
  run_static_gate architecture-v2-boundary-verify scripts/hepta-v2-architecture-boundary verify
  run_static_gate architecture-v2-boundary-self-test scripts/hepta-v2-architecture-boundary self-test
  run_static_gate native-ingress-composition-verify scripts/hepta-native-ingress-composition verify
  run_static_gate native-ingress-composition-self-test scripts/hepta-native-ingress-composition self-test
  run_static_gate safe-lint-security-verify scripts/hepta-safe-lint-security-baseline verify
  run_static_gate safe-lint-security-self-test scripts/hepta-safe-lint-security-baseline self-test
  run_static_gate dependency-security-verify scripts/hepta-dependency-security verify
  run_static_gate dependency-security-self-test scripts/hepta-dependency-security self-test
  run_static_gate gate-compat-debt-verify scripts/hepta-gate-compat-debt verify
  run_static_gate gate-compat-debt-self-test scripts/hepta-gate-compat-debt self-test
  run_static_gate panic-debt-verify scripts/hepta-panic-debt-baseline verify
  run_static_gate panic-debt-self-test scripts/hepta-panic-debt-baseline self-test
  run_static_gate suffix-ladder-freeze scripts/check-hepta-suffix-ladder-freeze.sh
  run_static_gate test-evidence-matrix scripts/hepta-test-evidence-matrix verify
  run_static_gate test-evidence-matrix-self-test scripts/hepta-test-evidence-matrix self-test
  run_static_gate terminal-coverage-inventory scripts/hepta-preflight-terminal-coverage-inventory-gate.sh
  run_static_gate terminal-coverage-diagnostic scripts/hepta-preflight-terminal-coverage-diagnostic-contract-gate.sh
  run_static_gate jq-conditional-route-summary scripts/hepta-jq-conditional-route-summary-self-test
  run_static_gate state-machine-gate-runner scripts/hepta-state-machine-gate-runner-self-test
  run_static_gate runtime-export-source-set scripts/hepta-runtime-crate-root-source-set-self-test
  run_static_gate immutable-release-provenance scripts/hepta-immutable-release-tree self-test
  run_static_gate active-binary-consistency scripts/hepta-active-binary-consistency-self-test.sh
  run_static_gate watchdog-provenance scripts/hepta-watchdog-provenance-self-test.sh
  git diff --check
  git diff --cached --check
}

run_static_gate() {
  local name="$1"
  shift
  echo "[hepta-ci-baseline] static gate: $name"
  "$@" >/dev/null
}

run_ui_contract() (
  require_tools base64 bash cargo cmp curl diff ditto file find git jq mktemp node perl plutil python3 readlink rg ruby rustup sed seq shasum sips sort stat strings unzip uuidgen wc
  assert_lockfiles_clean
  cd "$ROOT"
  local schema_validator="${HEPTA_CHECK_JSONSCHEMA_BIN:-}"
  if [[ -z "$schema_validator" ]]; then
    schema_validator="$(command -v check-jsonschema 2>/dev/null || true)"
  elif [[ "$schema_validator" != */* ]]; then
    schema_validator="$(command -v "$schema_validator" 2>/dev/null || true)"
  fi
  if [[ -z "$schema_validator" || ! -x "$schema_validator" \
    || "$("$schema_validator" --version 2>/dev/null)" != "check-jsonschema, version 0.37.4" ]]; then
    echo "Hepta UI contract requires check-jsonschema 0.37.4" >&2
    exit 1
  fi
  export HEPTA_CHECK_JSONSCHEMA_BIN="$schema_validator"

  run_static_gate ui-contract-commit-closure-self-test \
    scripts/hepta-ui-contract-commit-closure-gate-self-test.sh
  run_static_gate ui-contract-commit-closure \
    scripts/hepta-ui-contract-commit-closure-gate verify
  run_static_gate control-ui-schema-validator-self-test \
    scripts/hepta-control-ui-schema-validator-v1-self-test.sh

  local evidence_dir cleanup_evidence=0
  evidence_dir="${HEPTA_UI_CI_EVIDENCE_DIR:-}"
  if [[ -z "$evidence_dir" ]]; then
    evidence_dir="$(mktemp -d "${TMPDIR:-/tmp}/hepta-ui-ci-contract.XXXXXX")"
    cleanup_evidence=1
  else
    mkdir -p "$evidence_dir"
    evidence_dir="$(cd "$evidence_dir" && pwd -P)"
  fi
  if [[ "$cleanup_evidence" == "1" ]]; then
    trap 'rm -R -- "$evidence_dir"' EXIT
  fi

  run_static_gate native-product-shell-v2 \
    scripts/hepta-native-product-shell-gate-v2.sh \
      --output "$evidence_dir/native-product-shell.json"
  run_static_gate native-product-shell-v2-self-test \
    scripts/hepta-native-product-shell-gate-v2-self-test.sh
  run_static_gate native-mobile-readiness-self-test \
    scripts/hepta-native-mobile-readiness-self-test.sh
  run_static_gate native-ios-simulator-ui-qualification-self-test \
    scripts/hepta-native-ios-simulator-ui-qualification-self-test.sh
  run_static_gate native-android-emulator-smoke-self-test \
    scripts/hepta-native-android-emulator-smoke-self-test.sh
  run_static_gate native-android-emulator-live-readback-self-test \
    scripts/hepta-native-android-emulator-live-readback-self-test.sh
  run_static_gate current-readiness-self-test \
    scripts/hepta-ui-current-readiness-self-test.sh
  run_static_gate native-current-package-self-test \
    scripts/hepta-native-current-package-gate-self-test.sh
  run_static_gate native-window-verifier-self-test \
    scripts/hepta-ui-native-window-verifier-self-test.sh
  run_static_gate release-promotion-verifier-self-test \
    scripts/hepta-ui-release-verifier-self-test.sh
  run_static_gate device-lab-promotion-verifier-self-test \
    scripts/hepta-ui-device-lab-verifier-self-test.sh
  run_static_gate accessibility-promotion-verifier-self-test \
    scripts/hepta-ui-accessibility-verifier-self-test.sh
  run_static_gate matrix-live-promotion-verifier-self-test \
    scripts/hepta-ui-matrix-live-verifier-self-test.sh
  run_static_gate bridge-live-promotion-verifier-self-test \
    scripts/hepta-ui-bridge-live-verifier-self-test.sh
  run_static_gate native-macos-release-chain-self-test \
    scripts/hepta-native-macos-release-chain-self-test.sh
  run_static_gate release-artifact-intake-v3-self-test \
    scripts/hepta-ui-release-artifact-intake-v3-self-test.sh
  run_static_gate release-consumer-forged-tuple-self-test \
    scripts/hepta-ui-release-consumer-forged-tuple-self-test.sh
  run_static_gate native-live-bridge-contract-self-test \
    scripts/hepta-native-live-bridge-contract-gate-self-test.sh
  run_static_gate native-live-bridge-contract \
    scripts/hepta-native-live-bridge-contract-gate.sh \
      --output "$evidence_dir/native-live-bridge-blocker.json"
  jq -e '
    .status == "blocked"
    and .contract_gate_ready == true
    and .backend_handoff_ready == true
    and .hepta_live_bridge_ready == false
    and .actual_request.performed == false
  ' "$evidence_dir/native-live-bridge-blocker.json" >/dev/null
  run_static_gate native-live-bridge-rust-contract \
    cargo test --locked --offline --manifest-path apps/hepta-native/Cargo.toml hepta_bridge
  run_static_gate native-accessibility-rust-contract \
    cargo test --locked --offline --manifest-path apps/hepta-native/Cargo.toml accessibility::tests
  run_static_gate legacy-visual-archive-self-test \
    scripts/hepta-ui-legacy-visual-archive-self-test.sh
  run_static_gate browser-entrypoint-migration \
    scripts/hepta-live-gates-entrypoint-migration.sh
  run_static_gate control-ui-debt-audit \
    scripts/hepta-control-ui-debt-audit \
      --output "$evidence_dir/control-ui-debt.json"
  run_static_gate control-ui-css-metrics-self-test \
    scripts/hepta-control-ui-css-metrics-self-test.sh
  run_static_gate control-ui-route-retirement-self-test \
    scripts/hepta-control-ui-route-retirement-candidates-gate-self-test.sh
  run_static_gate control-ui-route-retirement \
    scripts/hepta-control-ui-route-retirement-candidates-gate \
      --output "$evidence_dir/control-ui-route-retirement.json"
  jq -e '
    .status == "ready"
    and .retirement_status == "blocked"
    and .eligible_candidate_count == 0
    and .http_behavior_changed == false
    and .route_count_reduced == false
  ' "$evidence_dir/control-ui-route-retirement.json" >/dev/null

  scripts/hepta-ui-current-readiness.sh \
    --evidence-dir "$evidence_dir/current-readiness" \
    --output "$evidence_dir/current-readiness.json" \
    --target-dir "${HEPTA_NATIVE_CARGO_TARGET_DIR:-$evidence_dir/native-target}" \
    --verify-features \
    --verify-browser \
    --require source >/dev/null

  jq -e '
    .status == "ready"
    and .readiness.source == true
    and .source_binding.repository_worktree_clean == true
    and .gates.native_product_shell.status == "ready"
    and .gates.native_mobile.source_contract_ready == true
    and .gates.control_browser.ready == true
  ' "$evidence_dir/current-readiness.json" >/dev/null

  assert_lockfiles_clean
  git diff --check
  git diff --cached --check
)

budgeted_cargo() {
  local name="$1"
  local max_seconds="$2"
  shift 2
  "$ROOT/scripts/hepta-budgeted-test" run \
    --name "$name" \
    --max-seconds "$max_seconds" \
    --workspace "$ROOT" \
    -- "$@"
}

assert_test_inventory() {
  hepta_v2_assert_test_inventory "$@"
}

