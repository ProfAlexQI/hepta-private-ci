  assert_test_inventory "Architecture V2 cross-process write lock" 4 \
    '.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/cross_process_write_lock.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-cross-process-write-lock-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib 'cross_process_write_lock::tests'
  assert_test_inventory "Architecture V2 dispatch-selector" 3 \
    'architecture_v2_dispatch_selector_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_dispatch_selector.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-dispatch-selector-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_dispatch_selector_
  assert_test_inventory "Architecture V2 native-mutation" 8 \
    'architecture_v2_native_mutation_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_native_mutation.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-native-mutation-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_native_mutation_
  assert_test_inventory "Architecture V2 provider-effect ACK" 2 \
    'architecture_v2_provider_effect_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_provider_effect.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-provider-effect-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_provider_effect_
  assert_test_inventory "Architecture V2 sealed-read" 9 \
    'architecture_v2_sealed_read_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_sealed_read.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-sealed-read-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_sealed_read_
  assert_test_inventory "Architecture V2 process-control" 2 \
    'architecture_v2_process_control_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_process_control.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-process-control-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_process_control_
  assert_test_inventory "Architecture V2 maintenance-mutation" 7 \
    'architecture_v2_maintenance_.*' \
    "$ROOT/codex-rs/hepta-runtime/src/runtime_kernel/tests/architecture_v2_maintenance_mutation.rs"
  budgeted_cargo ci-hepta-runtime-architecture-v2-maintenance-mutation-tests 600 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-runtime --lib architecture_v2_maintenance_
  local turn_coordinator_test
  for turn_coordinator_test in \
    generic_read_only_tool_call_runs_through_tool_loop \
    medium_risk_tool_requires_approval_until_granted \
    quarantined_exec_intent_never_enters_the_production_tool_loop \
    returns_and_validates_structured_tool_output \
    exposes_sessions_memory_and_history_snapshots
  do
    budgeted_cargo "ci-hepta-runtime-${turn_coordinator_test}" 600 \
      cargo test --locked --manifest-path "$MANIFEST" -q \
        -p hepta-runtime --lib "$turn_coordinator_test"
  done
  budgeted_cargo ci-hepta-native-gateway-tests 2400 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p hepta-native-gateway
  budgeted_cargo ci-model-catalog-tests 1800 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p codex-models-manager bundled_catalog_
  budgeted_cargo ci-core-history-tests 2400 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p codex-core context_manager::history::tests
  budgeted_cargo ci-state-memory-mode-test 1800 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p codex-state claim_stage1_jobs_include_enabled_paginated_and_skip_disabled_paginated_threads
  budgeted_cargo ci-thread-store-tests 1800 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p codex-thread-store paginated_
  budgeted_cargo ci-plugin-tests 2400 \
    cargo test --locked --manifest-path "$MANIFEST" -q \
      -p codex-core-plugins
  assert_lockfiles_clean
  git -C "$ROOT" diff --check
  git -C "$ROOT" diff --cached --check
}

run_full_workspace() {
  require_tools cargo git perl shasum
  assert_lockfiles_clean
  budgeted_cargo ci-full-workspace-tests 7200 \
    cargo test --locked --manifest-path "$MANIFEST" --workspace
  assert_lockfiles_clean
  git -C "$ROOT" diff --check
  git -C "$ROOT" diff --cached --check
}

[[ $# -eq 1 ]] || usage
case "$1" in
  contract)
    exec "$ROOT/scripts/hepta-ci-baseline-contract" verify
    ;;
  contract-self-test)
    exec "$ROOT/scripts/hepta-ci-baseline-contract" self-test
    ;;
  static)
    run_static
    ;;
  ui-contract)
    run_ui_contract
    ;;
  nightly-static)
    run_static
    ;;
  rust-backend)
    run_rust_backend
    ;;
  full-workspace)
    run_full_workspace
    ;;
  *)
    usage
    ;;
esac
