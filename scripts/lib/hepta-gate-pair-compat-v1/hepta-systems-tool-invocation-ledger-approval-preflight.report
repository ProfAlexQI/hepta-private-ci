#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-router-lookup-shadow.report"
RUST_SOURCE="$ROOT/codex-rs/tools/src/tool_invocation_ledger_approval_preflight.rs"
LEDGER_SOURCE="$ROOT/codex-rs/hepta-runtime/src/tool_invocation.rs"
BROKER_SOURCE="$ROOT/codex-rs/hepta-runtime/src/approval_broker.rs"
GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-ledger-approval-preflight.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_INVOCATION_LEDGER_APPROVAL_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-invocation-ledger-approval-preflight-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable router lookup shadow report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing ledger approval preflight Rust source: $RUST_SOURCE"
[[ -f "$LEDGER_SOURCE" ]] || fail "missing ToolInvocationLedger source: $LEDGER_SOURCE"
[[ -f "$BROKER_SOURCE" ]] || fail "missing ApprovalBroker source: $BROKER_SOURCE"
[[ -f "$DOC" ]] || fail "missing ledger approval preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the ledger approval preflight report"
fi

jq -n \
  --slurpfile source <("$SOURCE_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-ledger-approval-preflight.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TOOL_INVOCATION_LEDGER_APPROVAL_PREFLIGHT_2026-06-21.md" \
  '
  def preflight_entry($entry):
    ($entry.shadow_route == "disabled_approval_ledger_lookup_shadow" and $entry.shadow_ready == true) as $shadow_ready |
    ($entry.registry_guard_route == "require_approval_ledger") as $approval_guard |
    {
      plugin_id:$entry.plugin_id,
      candidate_tool_id:$entry.candidate_tool_id,
      contribution_kind:$entry.contribution_kind,
      source_shadow_route:$entry.shadow_route,
      registry_guard_route:$entry.registry_guard_route,
      preflight_route:(if ($shadow_ready and $approval_guard) then "approval_ledger_preflight_required" elif $shadow_ready then "blocked_by_registry_guard" else "blocked_by_router_lookup_shadow" end),
      ledger_preflight_ready:($shadow_ready and $approval_guard),
      approval_preflight_required:($shadow_ready and $approval_guard),
      tool_invocation_ledger_binding_present:true,
      approval_broker_preflight_binding_present:true,
      router_registration_lookup_enabled:false,
      registry_lookup_executed:false,
      registry_source_of_truth_enabled:false,
      tool_registration_enabled:false,
      tool_invocation_enabled:false,
      ledger_write_enabled:false,
      approval_request_enabled:false,
      side_effect_free:true
    };

  ($source[0]) as $source |
  ($source.entries | map(preflight_entry(.))) as $entries |
  ($entries | map(select(.ledger_preflight_ready == true)) | length) as $ready_count |
  ($entries | map(select(.preflight_route == "approval_ledger_preflight_required")) | length) as $required_count |
  ($source.router_lookup_shadow_ready
    and $source.router_registration_lookup_enabled == false
    and $source.registry_lookup_executed == false
    and $source.registry_source_of_truth_enabled == false
    and $source.tool_registration_enabled == false
    and $source.tool_invocation_enabled == false
    and $source.ledger_written == false
    and $source.approval_requested == false
    and $ready_count == ($entries | length)
    and $required_count == ($entries | length)
    and ($entries | all(.tool_invocation_ledger_binding_present == true and .approval_broker_preflight_binding_present == true))
    and ($entries | all(if .preflight_route == "approval_ledger_preflight_required" then (.registry_guard_route == "require_approval_ledger" and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end))) as $preflight_ready |
  {
    runtime:"hepta",
    surface:"tool_invocation_ledger_approval_preflight",
    plugin_id:$source.plugin_id,
    status:(if $preflight_ready then "ready" else "blocked" end),
    source_router_lookup_shadow_surface:$source.surface,
    source_router_lookup_shadow_ready:$source.router_lookup_shadow_ready,
    tool_invocation_ledger_binding_present:true,
    approval_broker_preflight_binding_present:true,
    ledger_write_switch_enabled:false,
    approval_request_switch_enabled:false,
    candidate_count:($entries | length),
    ledger_approval_preflight_ready_count:$ready_count,
    ledger_approval_preflight_blocked_count:(($entries | length) - $ready_count),
    approval_ledger_preflight_required_count:$required_count,
    all_shadow_entries_bound_to_ledger_approval_preflight:($ready_count == ($entries | length) and $required_count == ($entries | length) and ($entries | all(.tool_invocation_ledger_binding_present == true and .approval_broker_preflight_binding_present == true))),
    all_ledger_approval_entries_keep_approval_guard:($entries | all(if .preflight_route == "approval_ledger_preflight_required" then (.registry_guard_route == "require_approval_ledger" and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end)),
    tool_invocation_ledger_approval_preflight_ready:$preflight_ready,
    ledger_approval_preflight_allowed:$preflight_ready,
    router_registration_lookup_enabled:false,
    registry_lookup_executed:false,
    registry_source_of_truth_enabled:false,
    tool_registration_enabled:false,
    tool_invocation_enabled:false,
    ledger_written:false,
    approval_requested:false,
    live_mutation_ready:false,
    next_migration_step:"restore_tool_execution_adapter_preflight_without_invocation",
    entries:$entries,
    blockers:[
      "router_registration_lookup_disabled",
      "registry_lookup_execution_disabled",
      "registry_source_of_truth_enablement_disabled",
      "tool_registration_disabled",
      "tool_invocation_disabled",
      "tool_invocation_ledger_write_disabled",
      "approval_broker_request_disabled"
    ],
    next_actions:[
      "restore_tool_execution_adapter_preflight_without_invocation",
      "keep_ledger_and_approval_preflight_read_only_until_execution_adapter_preflight_is_restored",
      "keep_registration_invocation_ledger_approval_and_live_mutation_disabled_until_explicit_cutover"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      rust_contract:"codex-rs/tools/src/tool_invocation_ledger_approval_preflight.rs",
      router_lookup_shadow_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-router-lookup-shadow.report",
      tool_invocation_ledger_runtime:"codex-rs/hepta-runtime/src/tool_invocation.rs",
      approval_broker_runtime:"codex-rs/hepta-runtime/src/approval_broker.rs"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      plugin_cache_mutated:false,
      plugin_installed:false,
      manifest_rewritten:false,
      manifest_schema_written:false,
      registry_source_of_truth_enabled:false,
      router_registration_lookup_enabled:false,
      registry_lookup_executed:false,
      registration_cutover_executed:false,
      tool_registered:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      local_storage_created:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
