#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistent-mailbox-handoff-event-mapping.report"

report="$(
  capture_json_report \
    "hepta-work-graph-persistent-mailbox-handoff-event-mapping-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_persistent_mailbox_handoff_event_mapping_gate"
  and .schema_version == "work_graph_persistent_mailbox_handoff_event_mapping_v1"
  and .preview_mode == "report_only_persistent_mailbox_handoff_event_mapping_no_live_wait_change"
  and .mailbox_event_mapping_count == 4
  and (.mailbox_event_mappings | map(.work_graph_event_kind) == [
    "MailboxMessageQueued",
    "MailboxMessageDelivered",
    "MailboxAckObserved",
    "MailboxDeadlineExpired"
  ])
  and (.mailbox_event_mappings | all(
    .source_surface_id == "multi_agent_v2_mailbox_wait"
    and .parent_child_task_ref_required == true
    and .maps_to_shadow_event_store == true
    and .persists_mailbox_event == false
  ))
  and (.mailbox_event_mappings | any(.artifact_refs_required == true))
  and (.mailbox_event_mappings | any(.deadline_ref_required == true))
  and (.mailbox_event_mappings | any(.ack_ref_required == true))
  and .handoff_event_mapping_count == 4
  and (.handoff_event_mappings | map(.work_graph_event_kind) == [
    "HandoffRequested",
    "HandoffAccepted",
    "HandoffArtifactLinked",
    "TaskBarrierSatisfied"
  ])
  and (.handoff_event_mappings | all(.maps_to_shadow_event_store == true and .persists_handoff_event == false))
  and (.handoff_event_mappings | any(.approval_ref_required == true))
  and (.handoff_event_mappings | any(.artifact_refs_required == true))
  and .ack_deadline_contract_count == 3
  and (.ack_deadline_contracts | all(
    .timeout_policy == "deadline_required_no_unbounded_wait"
    and .mutates_mailbox_state == false
  ))
  and .wait_agent_target_count == 3
  and (.wait_agent_targets | map(.wait_target_type) == [
    "named_task",
    "task_result",
    "barrier"
  ])
  and (.wait_agent_targets | all(.wait_agent_mode == "named_task_result_barrier_preview" and .live_wait_behavior_enabled == false))
  and (.wait_agent_targets | map(select(.wait_target_type == "named_task" or .wait_target_type == "task_result")) | all(.returns_task_result_ref == true))
  and (.wait_agent_targets | map(select(.wait_target_type == "barrier")) | all(.returns_barrier_ref == true))
  and .required_prior_gates == ["hepta_work_graph_append_only_event_store_shadow_path_gate"]
  and .required_prior_gate_count == 1
  and .source_shadow_path_gate == "hepta_work_graph_append_only_event_store_shadow_path_gate"
  and .source_shadow_path_scheduler_prior_gate_count == 5
  and .source_shadow_path_required_prior_gate_count == 9
  and .source_shadow_path_readiness_complete == true
  and .source_shadow_path_ready_for_persistent_mailbox_handoff == true
  and .source_shadow_path_no_persistence_confirmed == true
  and .persistent_mailbox_handoff_mapping_readiness_complete == true
  and .recommended_next_gate == "hepta_work_graph_agent_role_agent_card_manifest_report_only_gate"
  and .mailbox_events_map_to_work_graph_events == true
  and .ack_deadline_parent_child_artifact_refs_ready == true
  and .wait_agent_named_task_result_barrier_ready == true
  and .persistent_mailbox_store_enabled == false
  and .live_wait_agent_behavior_changed == false
  and .ready_for_agent_role_agent_card_manifest == true
  and .ready_for_live_execution == false
  and .source_probes.persistent_mailbox_handoff_event_mapping.rust_module_present == true
  and .source_probes.persistent_mailbox_handoff_event_mapping.report_script_present == true
  and .source_probes.persistent_mailbox_handoff_event_mapping.gate_script_present == true
  and .source_probes.append_only_event_store_shadow_path.gate_script_present == true
  and .source_probes.append_only_event_store_shadow_path.report_gate == "hepta_work_graph_append_only_event_store_shadow_path_gate"
  and .source_probes.append_only_event_store_shadow_path.scheduler_prior_gate_count == 5
  and .source_probes.append_only_event_store_shadow_path.required_prior_gate_count == 9
  and .source_probes.append_only_event_store_shadow_path.append_only_shadow_path_readiness_complete == true
  and .source_probes.append_only_event_store_shadow_path.ready_for_persistent_mailbox_handoff == true
  and .source_probes.append_only_event_store_shadow_path.shadow_store_write_enabled == false
  and .source_probes.append_only_event_store_shadow_path.live_cutover_enabled == false
  and .source_probes.append_only_event_store_shadow_path.ready_for_live_execution == false
  and .source_probes.append_only_event_store_shadow_path.side_effects_all_false == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_persistent_mailbox_handoff_event_mapping --lib

echo "Hepta WorkGraph persistent mailbox/handoff event mapping gate passed"
