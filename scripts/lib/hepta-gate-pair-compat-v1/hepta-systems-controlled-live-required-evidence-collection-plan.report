#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
DENIAL_READBACK_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-readiness-denial-readback-index.report"
NON_SEND_READBACK_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-non-send-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_required_evidence_collection_plan.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_COLLECTION_PLAN_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-collection-plan-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$DENIAL_READBACK_REPORT" ]] || fail "missing executable Phase 5a denial readback report: $DENIAL_READBACK_REPORT"
[[ -x "$NON_SEND_READBACK_REPORT" ]] || fail "missing executable Phase 5c non-send readback report: $NON_SEND_READBACK_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 5d Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 5d architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 5d required evidence collection plan report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if grep -q 'controlled_live_required_evidence_collection_plan_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

denial_json="${HEPTA_CONTROLLED_LIVE_DENIAL_READBACK_JSON:-}"
if [[ -n "$denial_json" ]]; then
  [[ -f "$denial_json" ]] || fail "missing cached Phase 5a denial readback report: $denial_json"
else
  denial_json="$tmpdir/denial.json"
  "$DENIAL_READBACK_REPORT" >"$denial_json" || fail "failed to render Phase 5a denial readback report"
fi

nonsend_json="${HEPTA_CONTROLLED_LIVE_OPERATOR_PACKET_NONSEND_JSON:-}"
if [[ -n "$nonsend_json" ]]; then
  [[ -f "$nonsend_json" ]] || fail "missing cached Phase 5c non-send readback report: $nonsend_json"
else
  nonsend_json="$tmpdir/nonsend.json"
  "$NON_SEND_READBACK_REPORT" >"$nonsend_json" || fail "failed to render Phase 5c non-send readback report"
fi

jq -n \
  --slurpfile denial "$denial_json" \
  --slurpfile nonsend "$nonsend_json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_COLLECTION_PLAN_2026-06-27.md" \
  '
  def collection_route($id):
    "controlled_live_required_evidence.collection." + $id;
  ($denial[0]) as $denial |
  ($nonsend[0]) as $nonsend |
  ($denial.entries | map({
    id,
    source_blocker_id,
    layer,
    query_key,
    collection_route:collection_route(.source_blocker_id),
    operator_label,
    required_evidence,
    collection_mode:"plan_only_no_recording",
    current_state,
    queryable:true,
    operator_visible:true,
    evidence_required:true,
    evidence_recorded:false,
    evidence_recording_allowed:false,
    credential_read_allowed:false,
    approval_acceptance_allowed:false,
    blocker_waiver_allowed:false,
    persistence_allowed:false,
    live_mutation_allowed:false
  })) as $entries |
  ($entries | map(select(.queryable == true)) | length) as $queryable_plan_count |
  ($entries | map(select(.operator_visible == true)) | length) as $operator_visible_plan_count |
  ($entries | map(select(.evidence_required == true and (.required_evidence | length) > 0)) | length) as $required_evidence_count |
  ($entries | map(select(.evidence_recorded == true)) | length) as $evidence_recorded_count |
  ($entries | map(select(.blocker_waiver_allowed == true)) | length) as $blocker_waived_count |
  ($denial.readback_index_ready == true
    and $nonsend.non_send_readback_ready == true
    and $denial.index_entry_count == 7
    and ($entries | length) == 7
    and $queryable_plan_count == 7
    and $operator_visible_plan_count == 7
    and $required_evidence_count == 7
    and $evidence_recorded_count == 0
    and $blocker_waived_count == 0
    and $lib_export_present == true
    and ($entries | all(.collection_mode == "plan_only_no_recording"
      and .current_state == "missing"
      and .evidence_recording_allowed == false
      and .credential_read_allowed == false
      and .approval_acceptance_allowed == false
      and .persistence_allowed == false
      and .live_mutation_allowed == false))) as $plan_ready |
  {
    runtime:"hepta",
    surface:"controlled_live_required_evidence_collection_plan",
    status:(if $plan_ready then "ready_blocked" else "blocked" end),
    gate:"controlled_live_required_evidence_collection_plan_gate",
    schema_version:"controlled_live_required_evidence_collection_plan_v1",
    plugin_id:"hepta-system@hepta-local",
    source_denial_readback_index_ready:$denial.readback_index_ready,
    source_non_send_readback_ready:$nonsend.non_send_readback_ready,
    source_blocker_count:$denial.source_blocker_count,
    lib_export_present:$lib_export_present,
    plan_entry_count:($entries | length),
    queryable_plan_count:$queryable_plan_count,
    operator_visible_plan_count:$operator_visible_plan_count,
    required_evidence_count:$required_evidence_count,
    evidence_recorded_count:$evidence_recorded_count,
    evidence_collection_plan_ready:$plan_ready,
    approval_acceptance_ready:false,
    approval_accepted:false,
    blocker_waived_count:$blocker_waived_count,
    credential_read_allowed:false,
    evidence_recording_allowed:false,
    evidence_persisted:false,
    controlled_live_cutover_ready:false,
    live_execution_allowed:false,
    entries:$entries,
    next_actions:[
      "phase5e_controlled_live_required_evidence_readback_index_without_recording",
      "keep_required_evidence_plan_queryable_without_recording_or_acceptance"
    ],
    next_migration_step:"phase5e_controlled_live_required_evidence_readback_index_without_recording",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      approval_requested:false,
      approval_accepted:false,
      approval_recorded:false,
      evidence_recorded:false,
      evidence_persisted:false,
      blocker_waived:false,
      credential_read:false,
      packet_sent:false,
      readback_persisted:false,
      ledger_written:false,
      workflow_event_log_written:false,
      sqlite_written:false,
      native_post_mutation_performed:false,
      gateway_or_auth_mutated:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      replay_executed:false,
      rollback_executed:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }'
