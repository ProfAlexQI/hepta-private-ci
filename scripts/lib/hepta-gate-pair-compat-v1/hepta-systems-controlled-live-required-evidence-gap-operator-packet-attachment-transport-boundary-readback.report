#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
NON_SEND_READBACK_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-non-send-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_TRANSPORT_BOUNDARY_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-transport-boundary-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$NON_SEND_READBACK_REPORT" ]] || fail "missing executable Phase 5j operator packet attachment non-send readback report: $NON_SEND_READBACK_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 5k Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 5k architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 5k operator packet attachment transport boundary readback report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if grep -q 'controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

nonsend_json="${HEPTA_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_NONSEND_JSON:-}"
if [[ -n "$nonsend_json" ]]; then
  [[ -f "$nonsend_json" ]] || fail "missing cached Phase 5j operator packet attachment non-send readback report: $nonsend_json"
else
  nonsend_json="$tmpdir/nonsend.json"
  "$NON_SEND_READBACK_REPORT" >"$nonsend_json" || fail "failed to render Phase 5j operator packet attachment non-send readback report"
fi

jq -n \
  --slurpfile nonsend "$nonsend_json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-transport-boundary-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_TRANSPORT_BOUNDARY_READBACK_2026-06-27.md" \
  '
  def transport_key($id):
    "controlled_live.required_evidence.gap.operator_packet_attachment.transport_boundary." + $id;
  def transport_route($id):
    "readback://controlled-live/operator-packet/attachment/transport-boundary/" + ($id | gsub("_"; "-"));
  ($nonsend[0]) as $nonsend |
  ($nonsend.entries | map({
    id,
    source_blocker_id,
    packet_id,
    packet_payload_hash,
    attachment_key,
    attachment_route,
    non_send_readback_key,
    non_send_readback_route,
    transport_boundary_key:transport_key(.source_blocker_id),
    transport_boundary_route:transport_route(.source_blocker_id),
    operator_display_order,
    operator_status,
    observed_state:"transport_boundary_closed_no_send",
    previous_state,
    current_state,
    state_delta,
    owner,
    risk_bucket,
    operator_label,
    required_evidence,
    operator_visible:true,
    attachment_visible:true,
    non_send_confirmed:true,
    gateway_auth_boundary:"closed",
    native_post_boundary:"closed",
    telegram_transport_boundary:"closed",
    channel_send_boundary:"closed",
    gateway_or_auth_mutation_allowed:false,
    native_post_mutation_allowed:false,
    telegram_transport_mutation_allowed:false,
    channel_send_allowed:false,
    transport_mutation_allowed:false,
    approval_request_allowed:false,
    approval_acceptance_allowed:false,
    blocker_waiver_allowed:false,
    credential_read_allowed:false,
    evidence_recording_allowed:false,
    packet_persistence_allowed:false,
    attachment_persistence_allowed:false,
    readback_persistence_allowed:false,
    live_mutation_allowed:false,
    evidence_recorded:false
  })) as $entries |
  ($entries | map(select(.operator_visible == true
    and .attachment_visible == true
    and .non_send_confirmed == true
    and .gateway_auth_boundary == "closed"
    and .native_post_boundary == "closed"
    and .telegram_transport_boundary == "closed"
    and .channel_send_boundary == "closed"
    and .gateway_or_auth_mutation_allowed == false
    and .native_post_mutation_allowed == false
    and .telegram_transport_mutation_allowed == false
    and .channel_send_allowed == false
    and .transport_mutation_allowed == false
    and .live_mutation_allowed == false)) | length) as $transport_boundary_ready_count |
  ($entries | map(select(.gateway_auth_boundary == "closed")) | length) as $gateway_auth_boundary_closed_count |
  ($entries | map(select(.native_post_boundary == "closed")) | length) as $native_post_boundary_closed_count |
  ($entries | map(select(.telegram_transport_boundary == "closed")) | length) as $telegram_transport_boundary_closed_count |
  ($entries | map(select(.channel_send_boundary == "closed")) | length) as $channel_send_boundary_closed_count |
  ($entries | map(select(.evidence_recorded == true)) | length) as $evidence_recorded_count |
  ($entries | map(select(.blocker_waiver_allowed == true)) | length) as $blocker_waived_count |
  ($nonsend.non_send_readback_ready == true
    and $nonsend.readback_entry_count == 7
    and $nonsend.unchanged_missing_readback_count == 7
    and $nonsend.attachment_send_attempted == false
    and $nonsend.packet_send_attempted == false
    and $nonsend.approval_request_sent == false
    and $nonsend.approval_accepted == false
    and $nonsend.packet_persisted == false
    and $nonsend.attachment_persisted == false
    and $nonsend.readback_persisted == false
    and $lib_export_present == true
    and ($entries | length) == 7
    and $transport_boundary_ready_count == 7
    and $gateway_auth_boundary_closed_count == 7
    and $native_post_boundary_closed_count == 7
    and $telegram_transport_boundary_closed_count == 7
    and $channel_send_boundary_closed_count == 7
    and $evidence_recorded_count == 0
    and $blocker_waived_count == 0
    and ($entries | all(.observed_state == "transport_boundary_closed_no_send"
      and .previous_state == "missing"
      and .current_state == "missing"
      and .state_delta == "unchanged_missing"
      and .approval_request_allowed == false
      and .approval_acceptance_allowed == false
      and .credential_read_allowed == false
      and .evidence_recording_allowed == false
      and .packet_persistence_allowed == false
      and .attachment_persistence_allowed == false
      and .readback_persistence_allowed == false
      and .live_mutation_allowed == false))) as $transport_boundary_readback_ready |
  {
    runtime:"hepta",
    surface:"controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback",
    status:(if $transport_boundary_readback_ready then "ready_blocked" else "blocked" end),
    gate:"controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback_gate",
    schema_version:"controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    source_non_send_readback_ready:$nonsend.non_send_readback_ready,
    source_readback_entry_count:$nonsend.readback_entry_count,
    source_unchanged_missing_readback_count:$nonsend.unchanged_missing_readback_count,
    lib_export_present:$lib_export_present,
    transport_boundary_entry_count:($entries | length),
    transport_boundary_ready_count:$transport_boundary_ready_count,
    gateway_auth_boundary_closed_count:$gateway_auth_boundary_closed_count,
    native_post_boundary_closed_count:$native_post_boundary_closed_count,
    telegram_transport_boundary_closed_count:$telegram_transport_boundary_closed_count,
    channel_send_boundary_closed_count:$channel_send_boundary_closed_count,
    evidence_recorded_count:$evidence_recorded_count,
    blocker_waived_count:$blocker_waived_count,
    packet_send_attempted:false,
    attachment_send_attempted:false,
    approval_request_ready:false,
    approval_request_sent:false,
    approval_acceptance_ready:false,
    approval_accepted:false,
    approval_recorded:false,
    credential_read_allowed:false,
    evidence_recording_allowed:false,
    evidence_persisted:false,
    packet_persisted:false,
    attachment_persisted:false,
    readback_persisted:false,
    gateway_or_auth_mutation_allowed:false,
    native_post_mutation_allowed:false,
    telegram_transport_mutation_allowed:false,
    channel_send_allowed:false,
    transport_mutation_allowed:false,
    controlled_live_cutover_ready:false,
    live_execution_allowed:false,
    transport_boundary_readback_ready:$transport_boundary_readback_ready,
    entries:$entries,
    next_actions:[
      "phase5l_controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback_without_credential_read",
      "keep_gateway_auth_native_post_telegram_transport_and_channel_send_boundaries_closed"
    ],
    next_migration_step:"phase5l_controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback_without_credential_read",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      approval_requested:false,
      approval_accepted:false,
      approval_recorded:false,
      evidence_recorded:false,
      evidence_persisted:false,
      blocker_waived:false,
      credential_read:false,
      packet_sent:false,
      attachment_sent:false,
      packet_persisted:false,
      attachment_persisted:false,
      readback_persisted:false,
      ledger_written:false,
      workflow_event_log_written:false,
      sqlite_written:false,
      native_post_mutation_performed:false,
      gateway_or_auth_mutated:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      replay_executed:false,
      rollback_executed:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }'
