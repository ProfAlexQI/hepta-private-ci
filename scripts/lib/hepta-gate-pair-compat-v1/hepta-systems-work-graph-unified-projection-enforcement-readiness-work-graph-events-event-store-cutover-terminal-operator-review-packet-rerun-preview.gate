#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-work-graph-events-event-store-cutover-terminal-operator-review-packet-rerun-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-unified-projection-enforcement-readiness-work-graph-events-event-store-cutover-terminal-operator-review-packet-rerun-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun_preview_gate"
  and .schema_version == "work_graph_unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun_preview_v1"
  and .preview_mode == "read_only_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun_no_execution"
  and .source_surface_count == 7
  and .event_store_cutover_terminal_operator_review_packet_outcome_count == 7
  and .event_store_cutover_terminal_operator_review_packet_application_covered_source_count == 7
  and .previous_ready_surface_count == 7
  and .event_store_cutover_terminal_operator_review_packet_contract_ready_source_count == 7
  and .previous_append_only_work_graph_events_primary_blocked_surface_count == 0
  and .event_store_cutover_terminal_operator_review_packet_application_missing_surface_count_after == 0
  and .append_only_work_graph_events_primary_blocked_surface_count == 0
  and .replay_readback_execution_blocked_surface_count == 0
  and .runtime_adapter_enforcement_blocked_surface_count == 0
  and .append_only_work_graph_events_enabled_source_count == 0
  and .event_store_enabled_source_count == 0
  and .replay_readback_enabled_source_count == 0
  and .runtime_canonical_adapter_enforcement_enabled_source_count == 0
  and .rerun_ready_surface_count == 7
  and .rerun_blocked_surface_count == 0
  and .decision_delta_count == 7
  and .cleared_blocker_count == 1
  and .residual_blocker_count == 0
  and .enforcement_stage_count == 6
  and .required_prior_gate_count == 80
' >/dev/null <<<"$report"

jq -e '
  (.decision_deltas | all(
    .covered_by_event_store_cutover_terminal_operator_review_packet_application_preview == true
    and .event_store_cutover_terminal_operator_review_packet_contract_ready == true
    and .event_store_cutover_terminal_operator_review_packet_application_applied == false
    and .append_only_work_graph_events_enabled == false
    and .event_store_enabled == false
    and .replay_readback_execution_enabled == false
    and .runtime_canonical_adapter_enforcement_enabled == false
    and .work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun_enforcement_decision == "allow_preview_only"
    and .next_required_gate == "hepta_work_graph_append_only_work_graph_events_event_store_cutover_terminal_no_cutover_decision_readback_preview_gate"
  ))
  and (.cleared_blockers | map(.id) == [
    "work_graph_events_event_store_cutover_terminal_operator_review_packet_application_required_for_terminal_no_cutover_decision"
  ])
  and .cleared_blockers[0].source_count_before == 7
  and .cleared_blockers[0].source_count_after == 0
' >/dev/null <<<"$report"

jq -e '
  (.residual_blockers | length == 0)
  and (.enforcement_stages | map(.id) == [
    "work_graph_events_terminal_operator_review_packet",
    "work_graph_events_terminal_approval_absence_readback",
    "work_graph_events_terminal_non_send_evidence",
    "work_graph_events_git_mutation_boundary_proof",
    "work_graph_events_terminal_no_cutover_decision",
    "work_graph_events_terminal_operator_review_packet_blocker_mapping"
  ])
  and (.enforcement_stages | all(.enforcement_enabled == false))
' >/dev/null <<<"$report"

jq -e '
  (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_append_only_work_graph_events_event_store_cutover_terminal_operator_review_packet_application_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_append_only_work_graph_events_event_store_cutover_terminal_no_cutover_decision_readback_preview_gate"
  and .ready_for_terminal_no_cutover_decision_readback_preview == true
  and .ready_for_append_only_work_graph_events == false
  and .ready_for_event_store_cutover_terminal_operator_review_packet == false
  and .ready_for_replay_readback == false
  and .ready_for_runtime_adapter_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun.rust_module_present == true
  and .source_probes.unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun.report_script_present == true
  and .source_probes.unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun.gate_script_present == true
  and .source_probes.append_only_work_graph_events_event_store_cutover_terminal_operator_review_packet_application.rust_module_present == true
  and .source_probes.append_only_work_graph_events_event_store_cutover_terminal_operator_review_packet_application.gate_script_present == true
  and .source_probes.append_only_work_graph_events_event_store_cutover_terminal_operator_review_packet_application.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_unified_projection_enforcement_readiness_work_graph_events_event_store_cutover_terminal_operator_review_packet_rerun_preview --lib

echo "Hepta WorkGraph unified projection enforcement readiness WorkGraph events event-store cutover terminal operator-review packet rerun preview gate passed"
