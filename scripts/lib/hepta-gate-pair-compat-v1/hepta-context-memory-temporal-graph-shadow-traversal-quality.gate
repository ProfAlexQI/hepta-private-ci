#!/usr/bin/env bash
set -euo pipefail

repo_root="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
manifest="$repo_root/codex-rs/Cargo.toml"
contracts="$repo_root/codex-rs/CONTEXT_DEBUG_CONTRACTS.md"
debug_gate="$repo_root/scripts/hepta-context-debug-gate.sh"
preflight_script="$repo_root/scripts/hepta-context-preflight.sh"
release_manifest="$repo_root/codex-rs/CONTEXT_LANE_RELEASE_MANIFEST.tsv"
report_script="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-temporal-graph-shadow-traversal-quality.report"
gate_script="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-temporal-graph-shadow-traversal-quality.gate"
front_door_gate="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-source-aware-compression-front-door.gate"
hepta_core_memory="$repo_root/codex-rs/hepta-core/src/memory.rs"
hepta_core_temporal="$repo_root/codex-rs/hepta-core/src/memory/temporal.rs"
hepta_core_temporal_quality="$repo_root/codex-rs/hepta-core/src/memory/temporal/quality.rs"
hepta_core_status_entry="$repo_root/codex-rs/hepta-core/src/memory/context_plane/status/entry.rs"
hepta_core_activation_target="$repo_root/codex-rs/hepta-core/src/memory/context_plane/activation/target.rs"
hepta_core_operator="$repo_root/codex-rs/hepta-core/src/memory/context_plane/operator.rs"
hepta_memory_context_plane_helpers="$repo_root/codex-rs/hepta-memory/src/context_plane_helpers.rs"
hepta_memory_snapshot_helpers="$repo_root/codex-rs/hepta-memory/src/recall_helpers/snapshot.rs"
hepta_memory_store_helpers="$repo_root/codex-rs/hepta-memory/src/recall_helpers/store.rs"
lane="${HEPTA_CARGO_LANE:-${HEPTA_LANE:-hepta-context}}"
target_root="${HEPTA_CARGO_TARGET_ROOT:-$HOME/.openclaw/tmp/cargo-targets}"
target_leaf="$lane"
if [[ "$target_leaf" != hepta-* ]]; then
  target_leaf="hepta-$target_leaf"
fi
export CARGO_TARGET_DIR="${HEPTA_CARGO_TARGET_DIR:-$target_root/$target_leaf}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
report_output="$(mktemp -t hepta-context-memory-temporal-graph-shadow-traversal-quality-report.XXXXXX)"

cleanup() {
  rm -f "$report_output"
}
trap cleanup EXIT

fail() {
  echo "hepta-context-memory-temporal-graph-shadow-traversal-quality-gate: $*" >&2
  if [ -s "$report_output" ]; then
    echo "temporal graph shadow traversal quality report output:" >&2
    cat "$report_output" >&2
  fi
  exit 1
}

assert_file_contains() {
  local file_path="$1"
  local needle="$2"
  local label="$3"

  if ! grep -F "$needle" "$file_path" >/dev/null; then
    fail "$label must contain: $needle"
  fi
}

assert_report_line() {
  local expected="$1"
  if ! grep -F -x "$expected" "$report_output" >/dev/null; then
    fail "temporal graph shadow traversal quality report must contain line: $expected"
  fi
}

line_number_of() {
  local file_path="$1"
  local needle="$2"
  local line

  line="$(grep -n -F "$needle" "$file_path" | head -n 1 | cut -d: -f1 || true)"
  if [ -z "$line" ]; then
    fail "$file_path is missing required text: $needle"
  fi
  printf '%s\n' "$line"
}

assert_line_before() {
  local file_path="$1"
  local before_needle="$2"
  local after_needle="$3"
  local label="$4"
  local before_line
  local after_line

  before_line="$(line_number_of "$file_path" "$before_needle")"
  after_line="$(line_number_of "$file_path" "$after_needle")"
  if [ "$before_line" -ge "$after_line" ]; then
    fail "$label expected '$before_needle' before '$after_needle'"
  fi
}

bash "$report_script" >"$report_output"

for line in \
  "temporal-graph-shadow-traversal-quality=pass" \
  "temporal-graph-shadow-traversal-quality.payload-light=pass" \
  "temporal-graph-shadow-traversal-quality.schema=1" \
  "temporal-graph-shadow-traversal-quality.source-traversal-diff-schema=1" \
  "temporal-graph-shadow-traversal-quality.mode=shadow-traversal-quality-slo" \
  "temporal-graph-shadow-traversal-quality.fixture-count=5" \
  "temporal-graph-shadow-traversal-quality.slo-required-count=5" \
  "temporal-graph-shadow-traversal-quality.slo-pass-count=5" \
  "temporal-graph-shadow-traversal-quality.coverage-basis-points=10000" \
  "temporal-graph-shadow-traversal-quality.precision-basis-points=10000" \
  "temporal-graph-shadow-traversal-quality.leak-rate-basis-points=0" \
  "temporal-graph-shadow-traversal-quality.latency-budget-ms=20" \
  "temporal-graph-shadow-traversal-quality.projected-latency-ms=5" \
  "temporal-graph-shadow-traversal-quality.token-saved-estimate=768" \
  "temporal-graph-shadow-traversal-quality.operator-review-required-count=5" \
  "temporal-graph-shadow-traversal-quality.win-count=1" \
  "temporal-graph-shadow-traversal-quality.loss-count=0" \
  "temporal-graph-shadow-traversal-quality.cost-count=5" \
  "temporal-graph-shadow-traversal-quality.stage-required-count=5" \
  "temporal-graph-shadow-traversal-quality.stage-projected-count=5" \
  "temporal-graph-shadow-traversal-quality.digest-count=5" \
  "temporal-graph-shadow-traversal-quality.freshness-pass-count=5" \
  "temporal-graph-shadow-traversal-quality.replay-guard-pass-count=5" \
  "temporal-graph-shadow-traversal-quality.stale-replay-rejected-count=5" \
  "temporal-graph-shadow-traversal-quality.aggregate-counters-only=pass" \
  "temporal-graph-shadow-traversal-quality.llm-rerank=disabled" \
  "temporal-graph-shadow-traversal-quality.graph-persistence=disabled" \
  "temporal-graph-shadow-traversal-quality.production-route=disabled" \
  "temporal-graph-shadow-traversal-quality.production-write-count=0" \
  "temporal-graph-shadow-traversal-quality.graph-write-count=0" \
  "temporal-graph-shadow-traversal-quality.hot-path-write=disabled" \
  "temporal-graph-shadow-traversal-quality.prompt-assembly-change=disabled" \
  "temporal-graph-shadow-traversal-quality.runtime-activation=disabled" \
  "temporal-graph-shadow-traversal-quality.operator-activation=disabled"; do
  assert_report_line "$line"
done

for term in \
  "Temporal graph shadow traversal quality/SLO surface" \
  "shadow temporal graph traversal quality/SLO" \
  "memory_temporal_graph_shadow_traversal_quality" \
  "ContextMemoryTemporalGraphShadowTraversalQualityReport" \
  "context_memory_temporal_graph_shadow_traversal_quality_report" \
  "recall_context_memory_temporal_graph_shadow_traversal_quality_report" \
  "quality_fixture_count" \
  "quality_slo_required_count" \
  "quality_slo_pass_count" \
  "coverage_basis_points" \
  "precision_basis_points" \
  "leak_rate_basis_points" \
  "projected_latency_ms" \
  "token_saved_estimate" \
  "operator_review_required_count" \
  "traversal_win_count" \
  "traversal_loss_count" \
  "traversal_cost_count" \
  "aggregate_counters_only" \
  "llm_rerank=false" \
  "graph_persistence=false" \
  "production_route=false" \
  "production_write=false" \
  "graph_write=false" \
  "must not export candidate payloads" \
  "must not persist graph facts" \
  "must not enable LLM rerank" \
  "must not alter production recall routing" \
  "hepta-context-memory-temporal-graph-shadow-traversal-quality-report.sh" \
  "hepta-context-memory-temporal-graph-shadow-traversal-quality-gate.sh"; do
  assert_file_contains "$contracts" "$term" "temporal graph shadow traversal quality contract"
done

assert_file_contains "$hepta_core_memory" \
  "CONTEXT_MEMORY_TEMPORAL_GRAPH_SHADOW_TRAVERSAL_QUALITY_SCHEMA_VERSION" \
  "temporal graph shadow traversal quality schema version"
assert_file_contains "$hepta_core_memory" \
  "ContextMemoryTemporalGraphShadowTraversalQualityReport" \
  "temporal graph shadow traversal quality public re-export"
assert_file_contains "$hepta_core_temporal" \
  "mod quality;" \
  "temporal graph shadow traversal quality module boundary"
assert_file_contains "$hepta_core_temporal" \
  "pub use quality::ContextMemoryTemporalGraphShadowTraversalQualityReport" \
  "temporal graph shadow traversal quality wrapper re-export"
assert_file_contains "$hepta_core_temporal_quality" \
  "ContextMemoryTemporalGraphShadowTraversalQualityReport" \
  "temporal graph shadow traversal quality rust report"
assert_file_contains "$hepta_core_temporal_quality" \
  "pub fn from_traversal_diff" \
  "temporal graph shadow traversal quality diff constructor"
assert_file_contains "$hepta_core_temporal_quality" \
  "pub fn has_traversal_quality_integrity" \
  "temporal graph shadow traversal quality integrity gate"
assert_file_contains "$hepta_core_status_entry" \
  "from_temporal_graph_shadow_traversal_quality" \
  "temporal graph shadow traversal quality status entry"
assert_file_contains "$hepta_core_activation_target" \
  "MemoryTemporalGraphShadowTraversalQuality" \
  "temporal graph shadow traversal quality activation target"
assert_file_contains "$hepta_core_activation_target" \
  "TemporalGraphShadowTraversalQualityShadowOnly" \
  "temporal graph shadow traversal quality activation blocker"
assert_file_contains "$hepta_core_operator" \
  "memory_temporal_graph_shadow_traversal_quality_token_saved_estimate" \
  "temporal graph shadow traversal quality operator counter"

assert_file_contains "$hepta_memory_context_plane_helpers" \
  "context_memory_temporal_graph_shadow_traversal_quality_report" \
  "temporal graph shadow traversal quality hepta-memory context-plane helper"
assert_file_contains "$hepta_memory_snapshot_helpers" \
  "recall_context_memory_temporal_graph_shadow_traversal_quality_report" \
  "temporal graph shadow traversal quality hepta-memory snapshot helper"
assert_file_contains "$hepta_memory_store_helpers" \
  "recall_context_memory_temporal_graph_shadow_traversal_quality_report" \
  "temporal graph shadow traversal quality hepta-memory store helper"

assert_file_contains "$debug_gate" "hepta-context-memory-temporal-graph-shadow-traversal-quality-gate.sh" \
  "temporal graph shadow traversal quality debug gate"
assert_file_contains "$preflight_script" "context memory temporal graph shadow traversal quality/SLO gate" \
  "temporal graph shadow traversal quality preflight stage"
assert_file_contains "$release_manifest" "codex-rs/hepta-core/src/memory/temporal/quality.rs" \
  "temporal graph shadow traversal quality rust release manifest"
assert_file_contains "$release_manifest" "scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-temporal-graph-shadow-traversal-quality.report" \
  "temporal graph shadow traversal quality report release manifest"
assert_file_contains "$release_manifest" "scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-temporal-graph-shadow-traversal-quality.gate" \
  "temporal graph shadow traversal quality gate release manifest"
assert_file_contains "$front_door_gate" "memory_temporal_graph_shadow_traversal_quality_gate_script" \
  "temporal graph shadow traversal quality front-door static check"

assert_line_before \
  "$debug_gate" \
  "hepta-context-memory-temporal-graph-shadow-traversal-diff-gate.sh" \
  "hepta-context-memory-temporal-graph-shadow-traversal-quality-gate.sh" \
  "temporal graph shadow traversal quality debug order"
assert_line_before \
  "$debug_gate" \
  "hepta-context-memory-temporal-graph-shadow-traversal-quality-gate.sh" \
  "hepta-context-memory-eval-harness-seed-gate.sh" \
  "temporal graph shadow traversal quality debug order"
assert_line_before \
  "$preflight_script" \
  "context memory temporal graph shadow traversal diff gate" \
  "context memory temporal graph shadow traversal quality/SLO gate" \
  "temporal graph shadow traversal quality preflight order"
assert_line_before \
  "$preflight_script" \
  "context memory temporal graph shadow traversal quality/SLO gate" \
  "context memory eval harness seed gate" \
  "temporal graph shadow traversal quality preflight order"

leak_pattern='(prompt_text|transcript_text|memory_text|answer_text|session_id|memory_id|source_id|trace_id|query_text|query_payload|candidate_text|candidate_payload|candidate_id|path_payload|tool_args|tool_outputs|raw_payload|raw_graph_payload|entity_hash|fact_hash|edge_hash|operator_identity|llm-rerank=enabled|graph-persistence=enabled|production-route=enabled|runtime-activation=enabled|production-write=enabled|graph-write=enabled|operator-activation=enabled|production-write-count=[1-9]|graph-write-count=[1-9])'
if grep -E "$leak_pattern" "$report_output" >/dev/null; then
  fail "temporal graph shadow traversal quality report leaked payload, route, write, persistence, rerank, or activation state"
fi

bash -n "$report_script"
bash -n "$gate_script"

cargo test --manifest-path "$manifest" -p hepta-core \
  context_plane \
  --lib --message-format=short

cargo test --manifest-path "$manifest" -p hepta-memory \
  context_plane \
  --lib --message-format=short

echo "temporal-graph-shadow-traversal-quality=pass"
echo "temporal-graph-shadow-traversal-quality.payload-light=pass"
echo "temporal-graph-shadow-traversal-quality.stage-projected-count=5"
echo "temporal-graph-shadow-traversal-quality.llm-rerank=disabled"
echo "temporal-graph-shadow-traversal-quality.graph-persistence=disabled"
echo "temporal-graph-shadow-traversal-quality.production-route=disabled"
echo "temporal-graph-shadow-traversal-quality.production-write=disabled"
echo "temporal-graph-shadow-traversal-quality.graph-write=disabled"
echo "temporal-graph-shadow-traversal-quality.runtime-activation=disabled"
