#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-install-cache-idempotency-denial-receipt-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_INSTALL_CACHE_IDEMPOTENCY_DENIAL_RECEIPT_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-plugin-install-cache-idempotency-denial-receipt-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable install-cache idempotency denial receipt report: $REPORT"
[[ -f "$DOC" ]] || fail "missing install-cache idempotency denial receipt architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the install-cache idempotency denial receipt report"
fi

rg -q 'Hepta Systems Plugin Install Cache Idempotency Denial Receipt Readback' "$DOC" \
  || fail "architecture note must document the install-cache idempotency denial receipt readback"
rg -q 'stable idempotency keys, stable denial receipt ids, uniqueness checks, and idempotency-denial anchors' "$DOC" \
  || fail "architecture note must document stable key and receipt checks"
rg -q 'no idempotency index write, denial receipt persistence, noop preflight execution, plugin install, cache mutation, install-cache materialization, rollback/uninstall execution, manifest rewrite, manifest schema write, dynamic activation, permission grant, MCP server start, app connector start, ToolRegistry registration, tool invocation, ledger write, approval request, receipt persistence, runtime event-log write, SQLite write, credential read, external network, Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, channel send, package/release, canary activation, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed side-effect boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback"
  and .status == "ready_blocked"
  and .gate == "hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback_gate"
  and .schema_version == "hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .manifest_name == "hepta-system"
  and .manifest_version == "0.0.0-fixture"
  and .source_install_cache_noop_preflight_ready == true
  and .lib_export_present == true
  and .candidate_count == 2
  and .idempotency_entry_count == 2
  and .stable_idempotency_key_count == 2
  and .unique_idempotency_key_count == 2
  and .stable_denial_receipt_id_count == 2
  and .unique_denial_receipt_id_count == 2
  and .idempotency_denial_anchor_count == 2
  and .idempotency_key_mismatch_count == 0
  and .denial_receipt_id_mismatch_count == 0
  and .duplicate_idempotency_key_count == 0
  and .duplicate_denial_receipt_id_count == 0
  and .idempotency_index_projected_count == 2
  and .idempotency_index_written_count == 0
  and .denial_receipt_projected_count == 2
  and .denial_receipt_persisted_count == 0
  and .noop_preflight_executed_count == 0
  and .cache_materialized_count == 0
  and .cache_mutated_count == 0
  and .plugin_installed_count == 0
  and .dynamic_activation_started_count == 0
  and .install_cache_idempotency_denial_receipt_readback_ready == true
  and .idempotency_index_write_allowed == false
  and .denial_receipt_persistence_allowed == false
  and .noop_preflight_execution_allowed == false
  and .plugin_install_allowed == false
  and .plugin_cache_mutation_allowed == false
  and .install_cache_materialization_allowed == false
  and .dynamic_activation_allowed == false
  and .rollback_uninstall_execution_allowed == false
  and .permission_grant_allowed == false
  and .mcp_server_start_allowed == false
  and .app_connector_start_allowed == false
  and .tool_registry_registration_allowed == false
  and .tool_invocation_allowed == false
  and .ledger_write_allowed == false
  and .approval_request_allowed == false
  and .receipt_persistence_allowed == false
  and .runtime_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .live_execution_allowed == false
  and (.entries | length) == 2
  and any(.entries[]; .candidate_tool_id == "preview:mcp:hepta-system@hepta-local:hepta_system_local_mcp" and .contribution_kind == "mcp_server" and .first_idempotency_key == "install-cache-noop:hepta-system:local-mcp:v0" and .second_idempotency_key == "install-cache-noop:hepta-system:local-mcp:v0" and .first_denial_receipt_id == "denial-receipt:hepta-system:local-mcp:install-cache-noop" and .second_denial_receipt_id == "denial-receipt:hepta-system:local-mcp:install-cache-noop" and .idempotency_denial_anchor == "idempotency-denial-anchor:hepta-system:local-mcp:v0")
  and any(.entries[]; .candidate_tool_id == "preview:connector:hepta-system@hepta-local:hepta_system_local_app" and .contribution_kind == "app_connector" and .first_idempotency_key == "install-cache-noop:hepta-system:local-app:v0" and .second_idempotency_key == "install-cache-noop:hepta-system:local-app:v0" and .first_denial_receipt_id == "denial-receipt:hepta-system:local-app:install-cache-noop" and .second_denial_receipt_id == "denial-receipt:hepta-system:local-app:install-cache-noop" and .idempotency_denial_anchor == "idempotency-denial-anchor:hepta-system:local-app:v0")
  and (.entries | all(.noop_preflight_ready == true and .stable_idempotency_key == true and .unique_idempotency_key == true and .stable_denial_receipt_id == true and .unique_denial_receipt_id == true and .idempotency_index_projected == true and .idempotency_index_written == false and .denial_receipt_projected == true and .denial_receipt_persisted == false and .noop_preflight_executed == false and .cache_materialized == false and .cache_mutated == false and .plugin_installed == false and .dynamic_activation_started == false and .rollback_uninstall_executed == false and .permission_granted == false and .mcp_server_started == false and .app_connector_started == false and .tool_registered == false and .tool_invoked == false and .ledger_written == false and .approval_requested == false and .receipt_persisted == false and .runtime_event_log_written == false and .sqlite_written == false and .live_execution_started == false))
  and (.blockers | index("idempotency_index_write_disabled")) != null
  and (.blockers | index("denial_receipt_persistence_disabled")) != null
  and (.blockers | index("noop_preflight_execution_disabled")) != null
  and (.blockers | index("plugin_install_disabled")) != null
  and (.blockers | index("plugin_cache_mutation_disabled")) != null
  and (.blockers | index("install_cache_materialization_disabled")) != null
  and (.blockers | index("dynamic_activation_disabled")) != null
  and (.blockers | index("rollback_uninstall_execution_disabled")) != null
  and (.blockers | index("tool_registry_registration_disabled")) != null
  and (.blockers | index("tool_invocation_disabled")) != null
  and (.blockers | index("ledger_write_disabled")) != null
  and (.blockers | index("approval_request_disabled")) != null
  and (.blockers | index("receipt_persistence_disabled")) != null
  and (.blockers | index("runtime_event_log_write_disabled")) != null
  and (.blockers | index("sqlite_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.next_actions | index("hepta_systems_plugin_install_cache_rollback_uninstall_noop_readback")) != null
  and .recommended_next_gate == "hepta_systems_plugin_install_cache_rollback_uninstall_noop_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback --lib
)

printf 'hepta-systems-plugin-install-cache-idempotency-denial-receipt-readback-gate: PASS: install-cache idempotency keys and denial receipt ids are stable without writes, receipt persistence, cache mutation, or live activation\n'
