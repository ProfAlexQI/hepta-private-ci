#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-export-query-observability-final-index.report"
READBACK_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-export-query-observability-readback.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_EXPORT_QUERY_OBSERVABILITY_FINAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-export-query-observability-final-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable terminal public claim delivery receipt export/query/observability final index report: $REPORT"
[[ -x "$READBACK_GATE" ]] || fail "missing executable terminal public claim delivery receipt export/query/observability readback gate: $READBACK_GATE"
[[ -f "$DOC" ]] || fail "missing terminal public claim delivery receipt export/query/observability final index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the terminal public claim delivery receipt export/query/observability final index report"
fi

grep -q 'Terminal Public Claim Delivery Receipt Export/Query/Observability Final Index' "$DOC" \
  || fail "architecture note must document Terminal Public Claim Delivery Receipt Export/Query/Observability Final Index"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that final index does not invoke export/query/observability gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_export_query_observability_final_index"
  and .status == "ready_blocked"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_export_query_observability_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_export_query_observability_final_index_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_export_query_observability_denial_gate_invoked == false
  and .query_registered == false
  and .query_executed == false
  and .export_file_written == false
  and .observability_metric_recorded == false
  and .dashboard_panel_recorded == false
  and .alert_registered == false
  and .readback_surface_recorded == false
  and .release_publication_authority_from_export_query_observability_derived == false
  and .activation_authority_from_export_query_observability_derived == false
  and .install_from_export_query_observability_executed == false
  and .active_binary_from_export_query_observability_mutated == false
  and .provider_invoked == false
  and .credential_read == false
  and .final_blocker_count == 104
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .next_migration_step == "attach_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_export_query_observability_final_index_to_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_summary_briefing_without_observability"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$READBACK_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-export-query-observability-final-index-gate: PASS: terminal public claim delivery receipt export/query/observability final index is ready but blocked\n'
