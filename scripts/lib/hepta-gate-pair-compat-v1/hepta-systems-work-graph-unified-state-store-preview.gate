#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-state-store-preview.report"

report="$(capture_json_report "hepta-work-graph-unified-state-store-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_unified_state_store_preview_gate"
  and .schema_version == "work_graph_unified_state_store_preview_v1"
  and .preview_mode == "read_only_store_shape_preview_no_persistence"
  and .collection_count == 6
  and (.collections | length) == .collection_count
  and (.collections | map(.id) == [
    "nodes",
    "edges",
    "taskResults",
    "artifacts",
    "approvals",
    "timelineEvents"
  ])
  and (.collections | all((.key_fields | length) >= 2))
  and .index_count == 6
  and (.indexes | length) == .index_count
  and (.indexes | map(.id) == [
    "byTraceId",
    "bySourceSurface",
    "byStatus",
    "byEdgeKind",
    "byTaskResultStatus",
    "byTimelineTrace"
  ])
  and .operation_count == 6
  and (.operations | length) == .operation_count
  and (.operations | map(.id) == [
    "preview_project_node",
    "preview_project_edge",
    "preview_validate_task_result",
    "preview_explain_admission",
    "preview_render_timeline",
    "preview_role_manifest_projection"
  ])
  and (.operations | all(.mutates_store == false))
  and .invariant_count == 6
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "deterministic_identity_required",
    "append_only_evidence_required",
    "redacted_payload_only",
    "idempotent_projection_required",
    "readback_before_promotion",
    "preview_store_does_not_persist"
  ])
  and (.invariants | all(.required == true))
  and .adapter_preview_count == 6
  and (.adapter_previews | length) == .adapter_preview_count
  and (.adapter_previews | map(.source_surface_id) == [
    "update_plan_tool",
    "multi_agent_v2_thread_spawn",
    "agent_jobs_batch_workers",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_agent_harness"
  ])
  and (.adapter_previews | all(.persistence_enabled == false))
  and (.adapter_previews | all((.projected_collection_ids | index("nodes")) and (.required_contract_gates | length) == 5))
  and .recommended_next_gate == "hepta_work_graph_adapter_projection_fixture_gate"
  and .ready_for_adapter_projection_fixtures == true
  and .ready_for_store_persistence == false
  and .ready_for_live_execution == false
  and .source_probes.unified_state_store.rust_module_present == true
  and .source_probes.unified_state_store.report_script_present == true
  and .source_probes.unified_state_store.gate_script_present == true
  and .source_probes.role_manifest_contract.rust_module_present == true
  and .source_probes.role_manifest_contract.report_script_present == true
  and .source_probes.role_manifest_contract.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_unified_state_store --lib

echo "Hepta WorkGraph unified state store preview gate passed"
