#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-read-only-status-dry-run-operator-evidence-acceptance-recording-persistence-denial-receipt-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_INVOCATION_READ_ONLY_STATUS_DRY_RUN_OPERATOR_EVIDENCE_ACCEPTANCE_RECORDING_PERSISTENCE_DENIAL_RECEIPT_READBACK_2026-07-01.md"

fail() {
  printf 'hepta-systems-plugin-tool-invocation-read-only-status-dry-run-operator-evidence-acceptance-recording-persistence-denial-receipt-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable operator evidence acceptance recording persistence denial receipt report: $REPORT"
[[ -f "$DOC" ]] || fail "missing operator evidence acceptance recording persistence denial receipt architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the operator evidence acceptance recording persistence denial receipt report"
fi

rg -q 'Hepta Systems Plugin Tool Invocation Read Only Status Dry Run Operator Evidence Acceptance Recording Persistence Denial Receipt Readback' "$DOC" \
  || fail "architecture note must document the persistence denial receipt readback"
rg -q 'persistence denial receipt, receipt digest, write denial, non-recording denial receipt anchor, ledger and receipt persistence denial anchors, idempotency key' "$DOC" \
  || fail "architecture note must document the query-only persistence denial projection"
rg -q 'no feature gate open, dry-run execution, operator evidence packet send, operator evidence packet persistence, operator evidence recording, operator acceptance recording, acceptance record persistence, persistence denial receipt persistence, non-recording denial receipt persistence, idempotency index write, ledger persistence, receipt persistence, ToolRegistry registration, ToolRegistry mutation, registry lookup execution, tool invocation, connector start, runtime event-log write, SQLite write, credential read, external network, Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, package/release, canary activation, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed persistence denial receipt boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_denial_receipt_readback"
  and .status == "ready_blocked"
  and .gate == "hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_denial_receipt_readback_gate"
  and .schema_version == "hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_denial_receipt_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .manifest_name == "hepta-system"
  and .manifest_version == "0.0.0-fixture"
  and .source_acceptance_recording_open_preconditions_readback_ready == true
  and .lib_export_present == true
  and .candidate_count == 2
  and .persistence_denial_entry_count == 2
  and .selected_read_only_status_tool_count == 1
  and .non_selected_preflight_boundary_count == 1
  and .persistence_denial_receipt_projected_count == 2
  and .persistence_denial_receipt_digest_projected_count == 2
  and .persistence_write_denial_projected_count == 2
  and .non_recording_denial_receipt_anchor_projected_count == 2
  and .acceptance_recording_open_denial_receipt_anchor_projected_count == 2
  and .ledger_persistence_denial_anchor_projected_count == 2
  and .receipt_persistence_denial_anchor_projected_count == 2
  and .tool_invocation_denial_anchor_projected_count == 2
  and .runtime_write_denial_anchor_projected_count == 2
  and .live_execution_denial_anchor_projected_count == 2
  and .persistence_idempotency_key_projected_count == 2
  and .stable_persistence_denial_receipt_count == 2
  and .unique_persistence_denial_receipt_count == 2
  and .stable_persistence_denial_receipt_digest_count == 2
  and .unique_persistence_denial_receipt_digest_count == 2
  and .stable_persistence_idempotency_key_count == 2
  and .unique_persistence_idempotency_key_count == 2
  and .persistence_denial_receipt_mismatch_count == 0
  and .duplicate_persistence_denial_receipt_count == 0
  and .persistence_denial_receipt_digest_mismatch_count == 0
  and .duplicate_persistence_denial_receipt_digest_count == 0
  and .persistence_idempotency_mismatch_count == 0
  and .duplicate_persistence_idempotency_key_count == 0
  and .feature_gate_opened_count == 0
  and .dry_run_executed_count == 0
  and .operator_evidence_packet_sent_count == 0
  and .operator_evidence_packet_persisted_count == 0
  and .operator_evidence_recorded_count == 0
  and .operator_acceptance_recorded_count == 0
  and .acceptance_record_persisted_count == 0
  and .persistence_denial_receipt_persisted_count == 0
  and .non_recording_denial_receipt_persisted_count == 0
  and .idempotency_index_written_count == 0
  and .ledger_written_count == 0
  and .receipt_persisted_count == 0
  and .tool_registered_count == 0
  and .registry_lookup_executed_count == 0
  and .tool_invoked_count == 0
  and .mcp_server_started_count == 0
  and .app_connector_started_count == 0
  and .runtime_event_log_written_count == 0
  and .sqlite_written_count == 0
  and .live_execution_started_count == 0
  and .persistence_denial_receipt_readback_ready == true
  and .feature_gate_open_allowed == false
  and .dry_run_execution_allowed == false
  and .operator_evidence_packet_send_allowed == false
  and .operator_evidence_packet_persistence_allowed == false
  and .operator_evidence_recording_allowed == false
  and .operator_acceptance_recording_allowed == false
  and .acceptance_record_persistence_allowed == false
  and .persistence_denial_receipt_persistence_allowed == false
  and .non_recording_denial_receipt_persistence_allowed == false
  and .idempotency_index_write_allowed == false
  and .ledger_persistence_allowed == false
  and .receipt_persistence_allowed == false
  and .tool_registry_registration_allowed == false
  and .registry_lookup_execution_allowed == false
  and .tool_invocation_allowed == false
  and .connector_start_allowed == false
  and .runtime_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .live_execution_allowed == false
  and (.entries | length) == 2
  and any(.entries[]; .candidate_tool_id == "preview:mcp:hepta-system@hepta-local:hepta_system_local_mcp" and .contribution_kind == "mcp_server" and .dry_run_path_selected == true and .persistence_denial_receipt_id == "operator-evidence-acceptance-recording-persistence-denial-receipt:hepta-system:local-mcp:read-only-status-dry-run:acceptance-record-persistence-disabled" and .persistence_idempotency_key == "operator-evidence-acceptance-recording-persistence-idempotency:hepta-system:local-mcp:read-only-status-dry-run")
  and any(.entries[]; .candidate_tool_id == "preview:connector:hepta-system@hepta-local:hepta_system_local_app" and .contribution_kind == "app_connector" and .dry_run_path_selected == false and .persistence_denial_receipt_id == "operator-evidence-acceptance-recording-persistence-denial-receipt:hepta-system:local-app:not-selected:acceptance-record-persistence-disabled" and .persistence_idempotency_key == "operator-evidence-acceptance-recording-persistence-idempotency:hepta-system:local-app:not-selected")
  and (.entries | all(.persistence_denial_receipt_projected == true and .persistence_denial_receipt_digest_projected == true and .persistence_write_denial_projected == true and .non_recording_denial_receipt_anchor_projected == true and .acceptance_recording_open_denial_receipt_anchor_projected == true and .ledger_persistence_denial_anchor_projected == true and .receipt_persistence_denial_anchor_projected == true and .tool_invocation_denial_anchor_projected == true and .runtime_write_denial_anchor_projected == true and .live_execution_denial_anchor_projected == true and .persistence_idempotency_key_projected == true and .stable_persistence_denial_receipt == true and .unique_persistence_denial_receipt == true and .stable_persistence_denial_receipt_digest == true and .unique_persistence_denial_receipt_digest == true and .stable_persistence_idempotency_key == true and .unique_persistence_idempotency_key == true and .feature_gate_opened == false and .dry_run_executed == false and .operator_evidence_packet_sent == false and .operator_evidence_packet_persisted == false and .operator_evidence_recorded == false and .operator_acceptance_recorded == false and .acceptance_record_persisted == false and .persistence_denial_receipt_persisted == false and .non_recording_denial_receipt_persisted == false and .idempotency_index_written == false and .ledger_written == false and .receipt_persisted == false and .tool_registered == false and .registry_lookup_executed == false and .tool_invoked == false and .mcp_server_started == false and .app_connector_started == false and .runtime_event_log_written == false and .sqlite_written == false and .live_execution_started == false))
  and (.blockers | index("acceptance_recording_persistence_disabled")) != null
  and (.blockers | index("acceptance_record_persistence_disabled")) != null
  and (.blockers | index("persistence_denial_receipt_persistence_disabled")) != null
  and (.blockers | index("idempotency_index_write_disabled")) != null
  and (.blockers | index("ledger_persistence_disabled")) != null
  and (.blockers | index("receipt_persistence_disabled")) != null
  and (.blockers | index("tool_registry_registration_disabled")) != null
  and (.blockers | index("runtime_event_log_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.next_actions | index("hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_open_preconditions_readback")) != null
  and .recommended_next_gate == "hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_open_preconditions_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_evidence_acceptance_recording_persistence_denial_receipt_readback --lib
)

printf 'hepta-systems-plugin-tool-invocation-read-only-status-dry-run-operator-evidence-acceptance-recording-persistence-denial-receipt-readback-gate: PASS: operator evidence acceptance-recording persistence denial receipts are queryable without persistence, idempotency writes, tool invocation, runtime writes, or live mutation\n'
