#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
TERMINAL_PUBLIC_GA_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-public-ga-non-promotion-summary-final-index.report"
OPERATOR_PACKET_SCRIPT="$ROOT/scripts/hepta-public-ga-operator-approval-packet.sh"
OPERATOR_PACKET_COMPAT_WRAPPER="$ROOT/scripts/hepta-codex-public-ga-operator-approval-packet.sh"
OPERATOR_PACKET_DOC="$ROOT/docs/release/HEPTA_PUBLIC_GA_OPERATOR_APPROVAL_PACKET_2026-05-20.md"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_PUBLIC_GA_FINAL_INDEX_PUBLIC_GA_OPERATOR_PACKET_NON_SEND_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-public-ga-final-index-public-ga-operator-packet-non-send-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$TERMINAL_PUBLIC_GA_FINAL_INDEX_REPORT" ]] || fail "missing executable terminal Public GA non-promotion summary final index report: $TERMINAL_PUBLIC_GA_FINAL_INDEX_REPORT"
[[ -x "$OPERATOR_PACKET_SCRIPT" ]] || fail "missing executable Public GA operator packet script: $OPERATOR_PACKET_SCRIPT"
[[ -x "$OPERATOR_PACKET_COMPAT_WRAPPER" ]] || fail "missing executable Public GA operator packet compatibility wrapper: $OPERATOR_PACKET_COMPAT_WRAPPER"
[[ -f "$OPERATOR_PACKET_DOC" ]] || fail "missing Public GA operator packet release note: $OPERATOR_PACKET_DOC"
[[ -f "$DOC" ]] || fail "missing Public GA operator packet non-send readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Public GA operator packet non-send readback report"
fi

OPERATOR_PACKET_CURL_COUNT="$(grep -c 'curl -fsS' "$OPERATOR_PACKET_SCRIPT" || true)"
OPERATOR_PACKET_ENDPOINT_COUNT="$(grep 'curl -fsS' "$OPERATOR_PACKET_SCRIPT" | wc -l | tr -d '[:space:]')"
OPERATOR_PACKET_REQUIRED_APPROVAL_STATIC_COUNT=0
if grep -q 'required_operator_approval_count == 8' "$OPERATOR_PACKET_SCRIPT" \
  && grep -q 'eight explicit approvals' "$OPERATOR_PACKET_DOC"; then
  OPERATOR_PACKET_REQUIRED_APPROVAL_STATIC_COUNT=8
fi
OPERATOR_PACKET_COMPAT_WRAPPER_EXEC_COUNT="$(grep -c 'exec .*hepta-public-ga-operator-approval-packet.sh' "$OPERATOR_PACKET_COMPAT_WRAPPER" || true)"

jq -n \
  --slurpfile terminal <("$TERMINAL_PUBLIC_GA_FINAL_INDEX_REPORT") \
  --argjson operator_packet_curl_count "$OPERATOR_PACKET_CURL_COUNT" \
  --argjson operator_packet_endpoint_count "$OPERATOR_PACKET_ENDPOINT_COUNT" \
  --argjson operator_packet_required_approval_static_count "$OPERATOR_PACKET_REQUIRED_APPROVAL_STATIC_COUNT" \
  --argjson operator_packet_compat_wrapper_exec_count "$OPERATOR_PACKET_COMPAT_WRAPPER_EXEC_COUNT" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-public-ga-final-index-public-ga-operator-packet-non-send-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TERMINAL_PUBLIC_GA_FINAL_INDEX_PUBLIC_GA_OPERATOR_PACKET_NON_SEND_READBACK_2026-06-21.md" \
  '
  ($terminal[0]) as $source |
  ($source.side_effects + {
    public_ga_operator_packet_non_send_readback_written:false,
    public_ga_operator_approval_packet_invoked:false,
    public_ga_operator_compat_wrapper_invoked:false,
    public_ga_operator_packet_live_endpoint_read_performed:false,
    public_ga_operator_packet_endpoint_curl_performed:false,
    public_ga_operator_packet_report_materialized:false,
    public_ga_operator_packet_sent:false,
    public_ga_operator_packet_recorded:false,
    public_ga_operator_packet_accepted:false,
    operator_approval_request_sent:false,
    operator_approval_recorded:false,
    external_network_read:false,
    external_send_performed:false,
    public_ga_claim_recorded:false
  }) as $side_effects |
  [
    "terminal_public_ga_non_promotion_summary_final_index_ready_but_blocked",
    "public_ga_operator_packet_source_probe_only",
    "public_ga_operator_compat_wrapper_source_probe_only",
    "public_ga_operator_packet_live_endpoint_read_blocked",
    "public_ga_operator_packet_send_blocked",
    "public_ga_operator_packet_recording_blocked",
    "public_ga_operator_packet_acceptance_blocked",
    "operator_approval_request_send_blocked",
    "operator_approval_recording_blocked",
    "public_ga_claim_disabled",
    "public_release_claim_disabled",
    "public_distribution_publication_disabled",
    "release_artifact_write_disabled",
    "publication_evidence_recording_disabled",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "rollback_execution_blocked"
  ] as $readback_blockers |
  ($source.terminal_public_ga_non_promotion_summary_final_index_ready == true
    and $source.terminal_public_ga_non_promotion_summary_final_index_blocked == true
    and $source.public_ga_operator_approval_packet_invoked == false
    and $source.public_ga_operator_packet_live_endpoint_read_performed == false
    and $source.public_ga_claim_allowed == false
    and $source.public_ga_claimed == false
    and $source.operator_approval_recorded == false
    and $source.source_canonical_governance_tool_execution_closure_backfeed_ready == true
    and $source.source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
    and $source.source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
    and $source.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
    and $source.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
    and $source.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
    and $operator_packet_curl_count == 2
    and $operator_packet_endpoint_count == 2
    and $operator_packet_required_approval_static_count == 8
    and $operator_packet_compat_wrapper_exec_count == 1
    and ($side_effects | to_entries | all(.value == false))) as $readback_ready |
  {
    runtime:"hepta",
    surface:"public_ga_operator_packet_non_send_readback",
    plugin_id:$source.plugin_id,
    status:(if $readback_ready then "ready_blocked" else "blocked" end),
    source_terminal_public_ga_non_promotion_summary_final_index_surface:$source.surface,
    source_terminal_public_ga_non_promotion_summary_final_index_ready:$source.terminal_public_ga_non_promotion_summary_final_index_ready,
    source_terminal_public_ga_non_promotion_summary_final_index_blocked:$source.terminal_public_ga_non_promotion_summary_final_index_blocked,
    source_canonical_governance_tool_execution_closure_backfeed_ready:$source.source_canonical_governance_tool_execution_closure_backfeed_ready,
    source_canonical_governance_tool_execution_closure_backfeed_blocker_count:$source.source_canonical_governance_tool_execution_closure_backfeed_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_count:$source.source_canonical_governance_tool_execution_closure_backfeed_category_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_ready_count:$source.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count:$source.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_categorization_ready:$source.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready,
    source_canonical_governance_tool_execution_closure_backfeed_categories:$source.source_canonical_governance_tool_execution_closure_backfeed_categories,
    public_ga_operator_packet_non_send_readback_ready:$readback_ready,
    public_ga_operator_packet_non_send_readback_blocked:true,
    terminal_public_ga_non_promotion_summary_final_index_attached:true,
    public_ga_operator_approval_packet_present:true,
    public_ga_operator_compat_wrapper_present:true,
    public_ga_operator_approval_packet_doc_present:true,
    public_ga_operator_packet_target_curl_count:$operator_packet_curl_count,
    public_ga_operator_packet_target_endpoint_count:$operator_packet_endpoint_count,
    public_ga_operator_packet_required_approval_static_count:$operator_packet_required_approval_static_count,
    public_ga_operator_compat_wrapper_exec_count:$operator_packet_compat_wrapper_exec_count,
    public_ga_operator_approval_packet_invoked:false,
    public_ga_operator_compat_wrapper_invoked:false,
    public_ga_operator_packet_live_endpoint_read_performed:false,
    public_ga_operator_packet_endpoint_curl_performed:false,
    public_ga_operator_packet_report_materialized:false,
    public_ga_operator_packet_sent:false,
    public_ga_operator_packet_recorded:false,
    public_ga_operator_packet_accepted:false,
    operator_approval_request_sent:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_claim_non_promotion_denial_gate_invoked:false,
    terminal_publication_evidence_non_persistence_summary_gate_invoked:false,
    hepta_watchdog_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_denial_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    readback_blocker_count:($readback_blockers | length),
    readback_blockers:$readback_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    public_distribution_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    public_ga_claim_allowed:false,
    public_release_published:false,
    public_ga_claimed:false,
    publication_evidence_summary_recorded:false,
    publication_evidence_summary_persisted:false,
    publication_evidence_receipt_persisted:false,
    publication_evidence_ledger_persisted:false,
    rollback_execution_allowed:false,
    next_migration_step:"derive_public_ga_operator_packet_non_send_static_readback_without_packet_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      terminal_public_ga_non_promotion_summary_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-public-ga-non-promotion-summary-final-index.report",
      public_ga_operator_approval_packet:"scripts/hepta-public-ga-operator-approval-packet.sh",
      public_ga_operator_compat_wrapper:"scripts/hepta-codex-public-ga-operator-approval-packet.sh",
      public_ga_operator_approval_packet_doc:"docs/release/HEPTA_PUBLIC_GA_OPERATOR_APPROVAL_PACKET_2026-05-20.md"
    },
    side_effect_free:true,
    side_effects:$side_effects
  }'
