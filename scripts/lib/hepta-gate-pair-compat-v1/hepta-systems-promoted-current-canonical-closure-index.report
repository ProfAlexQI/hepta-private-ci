#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PROMOTED_CLOSURE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-closure.report"
CURRENT_CONSUMER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_CLOSURE_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-promoted-current-canonical-closure-index-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PROMOTED_CLOSURE_REPORT" ]] || fail "missing executable promoted current canonical closure report: $PROMOTED_CLOSURE_REPORT"
[[ -x "$CURRENT_CONSUMER_REPORT" ]] || fail "missing executable current canonical consumer report: $CURRENT_CONSUMER_REPORT"
[[ -f "$DOC" ]] || fail "missing promoted current canonical closure index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the promoted current canonical closure index report"
fi

jq -n \
  --slurpfile closure <("$PROMOTED_CLOSURE_REPORT") \
  --slurpfile consumer <("$CURRENT_CONSUMER_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-closure-index.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_CLOSURE_INDEX_2026-06-21.md" \
  '
  ($closure[0]) as $closure |
  ($consumer[0]) as $consumer |
  [
    {
      id:"promoted_current_canonical_closure",
      surface:$closure.surface,
      source_ready:$closure.promoted_current_canonical_closure_ready,
      required:true,
      invoked_by_report:false,
      gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-closure.gate"
    },
    {
      id:"current_canonical_consumer",
      surface:$consumer.surface,
      source_ready:$consumer.current_canonical_consumer_ready,
      required:true,
      invoked_by_report:false,
      gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.gate"
    }
  ] as $index_inputs |
  [
    "manual_operator_live_cutover_approval_required",
    "tool_execution_live_cutover_allowed_false",
    "tool_execution_public_ga_allowed_false",
    "canonical_gate_not_invoked_by_promoted_closure_index",
    "wrapper_target_not_invoked_by_promoted_closure_index",
    "legacy_closure_index_not_replaced_in_place",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started"
  ] as $index_blockers |
  ($closure.promoted_current_canonical_closure_ready == true
    and $closure.promoted_closure_kind == "non_circular_successor_closure"
    and $closure.promoted_wrapper_attached == true
    and $closure.historical_canonical_gate_alias_readback_attached == true
    and $closure.historical_canonical_gate_alias_readback_pending == false
    and $closure.legacy_current_canonical_closure_replaced_in_place == false
    and $closure.legacy_current_canonical_wrapper_replaced_in_place == false
    and $consumer.current_canonical_consumer_ready == true
    and $consumer.current_canonical_consumer_surface == "post_canonical_closure_compact_capability_summary"
    and $consumer.previous_current_summary_superseded_by_post_canonical_closure == true
    and $consumer.stale_pre_creation_blockers_present == false
    and $closure.canonical_gate_wrapper_invoked == false
    and $closure.wrapper_target_invoked == false
    and $consumer.canonical_gate_wrapper_invoked == false
    and $consumer.wrapper_target_invoked == false
    and $closure.execution_enabled_count == 0
    and $closure.public_ga_enabled_count == 0
    and $consumer.execution_enabled_count == 0
    and $consumer.public_ga_enabled_count == 0
    and $closure.tool_execution_live_cutover_allowed == false
    and $closure.tool_execution_public_ga_allowed == false
    and $consumer.tool_execution_live_cutover_allowed == false
    and $consumer.tool_execution_public_ga_allowed == false
    and ($index_inputs | all(.required == true and .source_ready == true and .invoked_by_report == false))
    and ($closure.side_effects | to_entries | all(.value == false))
    and ($consumer.side_effects | to_entries | all(.value == false))) as $index_ready |
  {
    runtime:"hepta",
    surface:"promoted_current_canonical_closure_index",
    plugin_id:$closure.plugin_id,
    status:(if $index_ready then "ready" else "blocked" end),
    source_promoted_current_canonical_closure_surface:$closure.surface,
    source_promoted_current_canonical_closure_ready:$closure.promoted_current_canonical_closure_ready,
    source_current_canonical_consumer_surface:$consumer.surface,
    source_current_canonical_consumer_ready:$consumer.current_canonical_consumer_ready,
    source_current_canonical_consumer_promoted_surface:$consumer.current_canonical_consumer_surface,
    promoted_current_canonical_closure_index_ready:$index_ready,
    promoted_closure_index_kind:"non_circular_successor_index",
    promoted_closure_index_input_count:($index_inputs | length),
    promoted_closure_index_inputs:$index_inputs,
    promoted_closure_attached:true,
    promoted_wrapper_attached:$closure.promoted_wrapper_attached,
    current_canonical_consumer_attached:true,
    historical_canonical_gate_alias_readback_attached:$closure.historical_canonical_gate_alias_readback_attached,
    historical_canonical_gate_alias_readback_pending:$closure.historical_canonical_gate_alias_readback_pending,
    legacy_current_canonical_closure_index_replaced_in_place:false,
    legacy_current_canonical_closure_replaced_in_place:false,
    legacy_current_canonical_wrapper_replaced_in_place:false,
    historical_canonical_gate_mutated:false,
    canonical_summary_mutated:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    index_blocker_count:($index_blockers | length),
    index_blockers:$index_blockers,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"derive_promoted_post_canonical_closure_compact_capability_summary_without_alias_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      promoted_current_canonical_closure_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-closure.report",
      current_canonical_consumer_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      current_canonical_wrapper_mutated:false,
      promoted_current_canonical_wrapper_mutated:false,
      current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_index_mutated:false,
      historical_canonical_gate_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
