#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
MIGRATION_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-preflight-non-live-adapter-migration-final-index.report"
PUBLIC_GA_READINESS_SCRIPT="$ROOT/scripts/hepta-public-ga-readiness.sh"
PUBLIC_GA_READINESS_ARCH_DOC="$ROOT/docs/architecture/HEPTA_PUBLIC_GA_READINESS.md"
PUBLIC_GA_READINESS_RELEASE_DOC="$ROOT/docs/release/HEPTA_PUBLIC_GA_READINESS_GATE_2026-05-20.md"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_MIGRATION_FINAL_INDEX_PUBLIC_GA_READINESS_ATTACHMENT_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$MIGRATION_FINAL_INDEX_REPORT" ]] || fail "missing executable Public GA readiness non-live migration final index report: $MIGRATION_FINAL_INDEX_REPORT"
[[ -x "$PUBLIC_GA_READINESS_SCRIPT" ]] || fail "missing executable Public GA readiness script: $PUBLIC_GA_READINESS_SCRIPT"
[[ -f "$PUBLIC_GA_READINESS_RELEASE_DOC" ]] || fail "missing Public GA readiness release gate note: $PUBLIC_GA_READINESS_RELEASE_DOC"
[[ -f "$DOC" ]] || fail "missing Public GA readiness attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Public GA readiness attachment report"
fi

PUBLIC_GA_READINESS_CURL_COUNT="$(grep -c 'curl -fsS' "$PUBLIC_GA_READINESS_SCRIPT" || true)"
PUBLIC_GA_READINESS_ENDPOINT_COUNT="$(grep 'curl -fsS' "$PUBLIC_GA_READINESS_SCRIPT" | wc -l | tr -d '[:space:]')"
if [[ -f "$PUBLIC_GA_READINESS_ARCH_DOC" ]]; then
  PUBLIC_GA_READINESS_ARCH_DOC_PRESENT=true
else
  PUBLIC_GA_READINESS_ARCH_DOC_PRESENT=false
fi

jq -n \
  --slurpfile migration <("$MIGRATION_FINAL_INDEX_REPORT") \
  --argjson public_ga_readiness_curl_count "$PUBLIC_GA_READINESS_CURL_COUNT" \
  --argjson public_ga_readiness_endpoint_count "$PUBLIC_GA_READINESS_ENDPOINT_COUNT" \
  --argjson public_ga_readiness_arch_doc_present "$PUBLIC_GA_READINESS_ARCH_DOC_PRESENT" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_MIGRATION_FINAL_INDEX_PUBLIC_GA_READINESS_ATTACHMENT_2026-06-21.md" \
  '
  ($migration[0]) as $migration |
  ($migration.side_effects + {
    public_ga_readiness_attachment_report_written:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    external_network_read:false,
    public_ga_claim_recorded:false
  }) as $side_effects |
  [
    "public_ga_readiness_attachment_non_live_only",
    "public_ga_readiness_script_invocation_blocked",
    "public_ga_readiness_live_endpoint_read_blocked",
    "public_ga_readiness_endpoint_curl_blocked",
    "public_ga_readiness_report_materialization_blocked",
    "public_ga_readiness_dedicated_architecture_note_missing",
    "public_ga_readiness_attachment_recording_blocked",
    "public_ga_claim_disabled",
    "public_release_claim_disabled",
    "public_distribution_publication_disabled",
    "publication_evidence_recording_disabled",
    "terminal_publication_evidence_gate_not_invoked",
    "watchdog_not_invoked",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "operator_approval_not_recorded",
    "rollback_execution_blocked"
  ] as $attachment_blockers |
  ($migration.public_ga_readiness_preflight_non_live_adapter_migration_final_index_ready == true
    and $migration.public_ga_readiness_preflight_non_live_adapter_migration_final_index_blocked == true
    and $migration.public_ga_readiness_preflight_migration_basis == "non_live_adapter_final_index"
    and $migration.public_ga_readiness_non_live_adapter_final_index_attached == true
    and $migration.public_ga_readiness_endpoint_inventory_from_adapter == true
    and $migration.public_ga_readiness_target_endpoint_count == 9
    and $migration.public_ga_readiness_live_endpoint_read_required_by_migration == false
    and $migration.public_ga_readiness_script_invoked == false
    and $migration.public_ga_readiness_live_endpoint_read_performed == false
    and $migration.public_ga_readiness_endpoint_curl_performed == false
    and $migration.public_ga_readiness_report_materialized == false
    and $migration.public_ga_readiness_attachment_allowed == false
    and $public_ga_readiness_curl_count == 9
    and $public_ga_readiness_endpoint_count == 9
    and ($side_effects | to_entries | all(.value == false))) as $attachment_ready |
  {
    runtime:"hepta",
    surface:"public_ga_readiness_non_live_migration_final_index_public_ga_readiness_attachment",
    plugin_id:$migration.plugin_id,
    status:(if $attachment_ready then "ready_blocked" else "blocked" end),
    source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_surface:$migration.surface,
    source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_ready:$migration.public_ga_readiness_preflight_non_live_adapter_migration_final_index_ready,
    source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_blocked:$migration.public_ga_readiness_preflight_non_live_adapter_migration_final_index_blocked,
    public_ga_readiness_attachment_ready:$attachment_ready,
    public_ga_readiness_attachment_blocked:true,
    public_ga_readiness_attachment_basis:"preflight_non_live_adapter_migration_final_index",
    public_ga_readiness_preflight_non_live_adapter_migration_final_index_attached:true,
    public_ga_readiness_script_present:true,
    public_ga_readiness_release_gate_doc_present:true,
    public_ga_readiness_existing_doc_present:$public_ga_readiness_arch_doc_present,
    public_ga_readiness_dedicated_architecture_note_required:($public_ga_readiness_arch_doc_present == false),
    public_ga_readiness_endpoint_inventory_from_adapter:true,
    public_ga_readiness_non_live_endpoint_inventory_ready:true,
    public_ga_readiness_target_endpoint_count:$migration.public_ga_readiness_target_endpoint_count,
    public_ga_readiness_target_curl_count:$public_ga_readiness_curl_count,
    public_ga_readiness_target_live_endpoint_count:$public_ga_readiness_endpoint_count,
    public_ga_readiness_live_endpoint_read_required_by_original_target:true,
    public_ga_readiness_live_endpoint_read_required_by_attachment:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    public_ga_readiness_attachment_allowed:false,
    terminal_publication_evidence_non_persistence_summary_gate_invoked:false,
    hepta_watchdog_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_denial_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    attachment_blocker_count:($attachment_blockers | length),
    attachment_blockers:$attachment_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    public_distribution_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    public_ga_claim_allowed:false,
    public_release_published:false,
    public_ga_claimed:false,
    publication_evidence_summary_recorded:false,
    publication_evidence_summary_persisted:false,
    publication_evidence_receipt_persisted:false,
    publication_evidence_ledger_persisted:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    next_migration_step:"derive_public_ga_readiness_non_live_attachment_readback_without_readiness_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      public_ga_readiness_preflight_non_live_adapter_migration_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-preflight-non-live-adapter-migration-final-index.report",
      public_ga_readiness_script:"scripts/hepta-public-ga-readiness.sh",
      public_ga_readiness_release_gate_note:"docs/release/HEPTA_PUBLIC_GA_READINESS_GATE_2026-05-20.md",
      public_ga_readiness_expected_architecture_note:"docs/architecture/HEPTA_PUBLIC_GA_READINESS.md"
    },
    side_effect_free:true,
    side_effects:$side_effects
  }'
