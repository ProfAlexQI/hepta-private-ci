#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-persistence-open-preconditions-readback.report"
SHADOW_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_PERSISTENCE_OPEN_PRECONDITIONS_READBACK_2026-07-07.md"

fail() {
  printf 'hepta-systems-controlled-live-evidence-receipt-store-persistence-open-preconditions-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable receipt store persistence open-preconditions report: $REPORT"
[[ -x "$SHADOW_REPORT" ]] || fail "missing executable receipt store shadow write rehearsal report: $SHADOW_REPORT"
[[ -f "$DOC" ]] || fail "missing architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the controlled-live evidence receipt store persistence open-preconditions report"
fi

grep -q 'Controlled Live Evidence Receipt Store Persistence Open Preconditions Readback' "$DOC" \
  || fail "architecture note must document Controlled Live Evidence Receipt Store Persistence Open Preconditions Readback"
grep -q 'controlled live evidence receipt store persistence open-preconditions readback without opening persistence' "$DOC" \
  || fail "architecture note must document persistence open-preconditions without opening persistence"
grep -q 'no receipt store write, receipt persistence, approval request, approval acceptance, approval recording, evidence recording, evidence persistence, blocker waiver, credential read, packet send, attachment send, packet persistence, attachment persistence, readback persistence, ledger write, event-log write, SQLite write, Native POST mutation, Telegram transport mutation, gateway/auth mutation, channel send, provider call, model call, replay, rollback, kill-switch rehearsal execution, kill-switch mutation, package, release, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed persistence open-preconditions boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_evidence_receipt_store_persistence_open_preconditions_readback"
  and .status == "ready_blocked"
  and .gate == "controlled_live_evidence_receipt_store_persistence_open_preconditions_readback_gate"
  and .schema_version == "controlled_live_evidence_receipt_store_persistence_open_preconditions_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_shadow_write_rehearsal_ready == true
  and .source_shadow_write_rehearsal_entry_count == 7
  and .source_in_memory_shadow_receipt_rendered_count == 7
  and .source_receipt_store_written == false
  and .source_receipt_persisted == false
  and .lib_export_present == true
  and .precondition_entry_count == 7
  and .precondition_catalog_ready_count == 7
  and .operator_approval_required_count == 7
  and .operator_approval_present_count == 0
  and .evidence_acceptance_required_count == 7
  and .evidence_acceptance_present_count == 0
  and .store_path_write_grant_required_count == 7
  and .store_path_write_grant_present_count == 0
  and .atomic_append_required_count == 7
  and .atomic_append_enabled_count == 0
  and .post_write_readback_required_count == 7
  and .post_write_readback_persisted_count == 0
  and .rollback_rehearsal_required_count == 7
  and .rollback_rehearsal_verified_count == 0
  and .retention_policy_required_count == 7
  and .retention_policy_committed_count == 0
  and .persistence_denial_confirmed_count == 7
  and .ledger_denial_confirmed_count == 7
  and .workflow_event_log_denial_confirmed_count == 7
  and .sqlite_denial_confirmed_count == 7
  and .live_denial_confirmed_count == 7
  and .evidence_recorded_count == 0
  and .blocker_waived_count == 0
  and .persistence_open_preconditions_readback_ready == true
  and .persistence_open_allowed == false
  and .approval_request_allowed == false
  and .approval_acceptance_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persisted == false
  and .receipt_persistence_allowed == false
  and .receipt_persisted == false
  and .receipt_store_write_allowed == false
  and .receipt_store_written == false
  and .ledger_write_allowed == false
  and .workflow_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .credential_read_allowed == false
  and .live_execution_allowed == false
  and (.blockers | index("operator_approval_missing")) != null
  and (.blockers | index("evidence_acceptance_missing")) != null
  and (.blockers | index("store_path_write_grant_missing")) != null
  and (.blockers | index("atomic_append_not_enabled")) != null
  and (.blockers | index("post_write_readback_missing")) != null
  and (.blockers | index("rollback_rehearsal_missing")) != null
  and (.blockers | index("retention_policy_not_committed")) != null
  and (.blockers | index("receipt_persistence_disabled")) != null
  and (.blockers | index("ledger_write_disabled")) != null
  and (.blockers | index("sqlite_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.entries | length) == 7
  and (.entries | all((.receipt_path | startswith(".hepta/controlled-live/evidence-receipts/status-canary/")) and (.receipt_id | startswith("controlled-live-evidence-receipt-preflight:")) and (.idempotency_key | startswith("controlled-live-evidence-receipt-preflight:idempotency:")) and (.shadow_write_route | startswith("readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/")) and (.persistence_precondition_key | startswith("controlled_live.evidence_receipt_store.persistence_open_preconditions.")) and (.persistence_precondition_route | startswith("readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/")) and (.operator_approval_id | startswith("operator-approval:controlled-live-evidence-receipt-store:")) and (.evidence_acceptance_key | startswith("controlled_live.evidence_acceptance.required.")) and (.store_path_write_grant_key | startswith("controlled_live.receipt_store.write_grant.required.")) and (.atomic_append_plan_id | startswith("atomic-append-plan:controlled-live-evidence-receipt-store:")) and (.post_write_readback_route | startswith("readback://controlled-live/evidence-receipt-store/post-write/")) and (.rollback_rehearsal_route | startswith("readback://controlled-live/evidence-receipt-store/rollback-rehearsal/")) and (.retention_policy_id | startswith("retention-policy:controlled-live-evidence-receipt-store:")) and .operator_status == "blocked_missing_evidence" and .observed_state == "persistence_open_preconditions_listed_no_persistence" and .previous_state == "missing" and .current_state == "missing" and .state_delta == "unchanged_missing" and .precondition_state == "required_missing" and .shadow_rehearsal_confirmed == true and .operator_approval_required == true and .operator_approval_present == false and .evidence_acceptance_required == true and .evidence_acceptance_present == false and .store_path_write_grant_required == true and .store_path_write_grant_present == false and .atomic_append_required == true and .atomic_append_enabled == false and .post_write_readback_required == true and .post_write_readback_persisted == false and .rollback_rehearsal_required == true and .rollback_rehearsal_verified == false and .retention_policy_required == true and .retention_policy_committed == false and .persistence_denied == true and .ledger_denied == true and .workflow_event_log_denied == true and .sqlite_denied == true and .live_denied == true and .approval_request_allowed == false and .approval_acceptance_allowed == false and .evidence_recording_allowed == false and .evidence_recorded == false and .blocker_waiver_allowed == false and .receipt_persistence_allowed == false and .receipt_persisted == false and .receipt_store_write_allowed == false and .receipt_store_written == false and .ledger_write_allowed == false and .workflow_event_log_write_allowed == false and .sqlite_write_allowed == false and .credential_read_allowed == false and .live_mutation_allowed == false))
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/dirty-worktree-boundary" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:dirty_worktree_boundary")
  and any(.entries[]; .source_blocker_id == "operator_live_approval_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/operator-live-approval-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:operator_live_approval_missing")
  and any(.entries[]; .source_blocker_id == "fresh_soak_readback_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/fresh-soak-readback-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:fresh_soak_readback_missing")
  and any(.entries[]; .source_blocker_id == "credential_boundary_attestation_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/credential-boundary-attestation-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:credential_boundary_attestation_missing")
  and any(.entries[]; .source_blocker_id == "gateway_native_telegram_post_boundary_approval_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/gateway-native-telegram-post-boundary-approval-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:gateway_native_telegram_post_boundary_approval_missing")
  and any(.entries[]; .source_blocker_id == "rollback_rehearsal_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/rollback-rehearsal-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:rollback_rehearsal_missing")
  and any(.entries[]; .source_blocker_id == "kill_switch_rehearsal_missing" and .persistence_precondition_route == "readback://controlled-live/evidence-receipt-store/persistence-open-preconditions/kill-switch-rehearsal-missing" and .operator_approval_id == "operator-approval:controlled-live-evidence-receipt-store:kill_switch_rehearsal_missing")
  and (.next_actions | index("controlled_live_evidence_receipt_store_operator_acceptance_packet_readback_without_acceptance")) != null
  and .next_migration_step == "controlled_live_evidence_receipt_store_operator_acceptance_packet_readback_without_acceptance"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SHADOW_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback"
  and .status == "ready_blocked"
  and .in_memory_shadow_write_rehearsal_ready == true
  and .shadow_write_rehearsal_entry_count == 7
  and .shadow_write_rehearsal_ready_count == 7
  and .in_memory_shadow_receipt_rendered_count == 7
  and .receipt_store_write_allowed == false
  and .receipt_store_written == false
  and .receipt_persistence_allowed == false
  and .receipt_persisted == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime controlled_live_evidence_receipt_store_persistence_open_preconditions_readback --lib
)

printf 'hepta-systems-controlled-live-evidence-receipt-store-persistence-open-preconditions-readback-gate: PASS: receipt persistence open-preconditions are listed and persistence stays closed\n'
