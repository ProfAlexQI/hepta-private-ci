#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PACKET_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-consumer-cutover-packet.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_CONSUMER_CUTOVER_PACKET_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-promoted-current-canonical-consumer-cutover-packet-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PACKET_REPORT" ]] || fail "missing executable promoted current canonical consumer cutover packet report: $PACKET_REPORT"
[[ -f "$DOC" ]] || fail "missing promoted current canonical consumer cutover packet readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the promoted current canonical consumer cutover packet readback report"
fi

jq -n \
  --slurpfile packet <("$PACKET_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-consumer-cutover-packet-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_CONSUMER_CUTOVER_PACKET_READBACK_2026-06-21.md" \
  '
  ($packet[0]) as $packet |
  [
    {
      id:"packet_ready",
      source_ready:$packet.terminal_successor_canonical_consumer_cutover_packet_ready,
      readback_ok:true,
      required:true
    },
    {
      id:"packet_not_recorded",
      source_ready:($packet.cutover_packet_recorded == false),
      readback_ok:true,
      required:true
    },
    {
      id:"packet_not_accepted",
      source_ready:($packet.cutover_packet_accepted == false),
      readback_ok:true,
      required:true
    },
    {
      id:"approval_missing",
      source_ready:($packet.operator_live_cutover_approval_recorded == false),
      readback_ok:true,
      required:true
    },
    {
      id:"successor_cutover_blocked",
      source_ready:($packet.successor_consumer_cutover_allowed == false),
      readback_ok:true,
      required:true
    }
  ] as $readback_checks |
  [
    "manual_operator_live_cutover_approval_missing",
    "packet_recording_disabled",
    "packet_acceptance_disabled",
    "successor_consumer_cutover_allowed_false",
    "canonical_gate_not_invoked_by_packet_readback",
    "wrapper_target_not_invoked_by_packet_readback",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "public_ga_disabled"
  ] as $readback_blockers |
  ($packet.terminal_successor_canonical_consumer_cutover_packet_ready == true
    and $packet.terminal_successor_consumer_cutover_packet_kind == "report_only_non_authorizing_packet"
    and $packet.source_cutover_preflight_basis == "verified_preflight_report_snapshot"
    and $packet.source_cutover_preflight_report_reexecuted == false
    and $packet.packet_field_count == 10
    and $packet.packet_present_required_field_count == 7
    and $packet.packet_missing_required_field_count == 3
    and $packet.cutover_packet_recorded == false
    and $packet.cutover_packet_accepted == false
    and $packet.operator_live_cutover_approval_recorded == false
    and $packet.successor_consumer_cutover_allowed == false
    and $packet.canonical_gate_wrapper_invoked == false
    and $packet.wrapper_target_invoked == false
    and $packet.execution_enabled_count == 0
    and $packet.public_ga_enabled_count == 0
    and ($readback_checks | all(.required == true and .source_ready == true and .readback_ok == true))
    and ($packet.side_effects | to_entries | all(.value == false))) as $readback_ready |
  {
    runtime:"hepta",
    surface:"promoted_current_canonical_consumer_cutover_packet_readback",
    plugin_id:$packet.plugin_id,
    status:(if $readback_ready then "ready" else "blocked" end),
    source_cutover_packet_surface:$packet.surface,
    source_cutover_packet_ready:$packet.terminal_successor_canonical_consumer_cutover_packet_ready,
    source_cutover_packet_kind:$packet.terminal_successor_consumer_cutover_packet_kind,
    source_cutover_preflight_basis:$packet.source_cutover_preflight_basis,
    source_cutover_preflight_report_reexecuted:$packet.source_cutover_preflight_report_reexecuted,
    terminal_successor_canonical_consumer_cutover_packet_readback_ready:$readback_ready,
    readback_mode:"static_report_readback_only",
    readback_check_count:($readback_checks | length),
    readback_checks:$readback_checks,
    packet_field_count:$packet.packet_field_count,
    packet_present_required_field_count:$packet.packet_present_required_field_count,
    packet_missing_required_field_count:$packet.packet_missing_required_field_count,
    packet_blocker_count:$packet.packet_blocker_count,
    packet_blockers:$packet.packet_blockers,
    readback_blocker_count:($readback_blockers | length),
    readback_blockers:$readback_blockers,
    cutover_packet_recorded:false,
    cutover_packet_accepted:false,
    operator_live_cutover_approval_recorded:false,
    successor_consumer_cutover_allowed:false,
    rollback_anchor:$packet.rollback_anchor,
    current_canonical_consumer_replaced_in_place:false,
    current_canonical_consumer_mutated:false,
    promoted_current_canonical_consumer_mutated:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"derive_terminal_successor_canonical_consumer_cutover_packet_acceptance_preflight_without_live_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      cutover_packet_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-consumer-cutover-packet.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      promoted_post_canonical_summary_mutated:false,
      current_canonical_consumer_mutated:false,
      promoted_current_canonical_consumer_mutated:false,
      cutover_packet_recorded:false,
      cutover_packet_accepted:false,
      current_canonical_wrapper_mutated:false,
      promoted_current_canonical_wrapper_mutated:false,
      current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_index_mutated:false,
      historical_canonical_gate_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
