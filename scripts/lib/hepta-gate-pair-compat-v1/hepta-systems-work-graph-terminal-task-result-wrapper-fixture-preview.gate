#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-task-result-wrapper-fixture-preview.report"

report="$(capture_json_report "hepta-work-graph-terminal-task-result-wrapper-fixture-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_fixture_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_fixture_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_fixture_preview_no_execution"
  and .fixture_count == 8
  and .expected_task_result_count == 8
  and (.fixtures | length) == .fixture_count
  and (.fixtures | map(.source_surface_id) == [
    "multi_agent_v2_thread_spawn",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "agent_jobs_batch_workers",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_task_board",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_agent_harness"
  ])
  and (.fixtures | all(
    .expected_event_contract_id == "task_result_event_intake"
    and .fixture_state == "fixture_declared_not_executed"
    and .executes_fixture == false
    and .persists_task_result == false
    and .enforces_task_result == false
    and .mutates_store == false
  ))
  and (.fixtures | map(.expected_canonical_status) | unique == [
    "blocked",
    "cancelled",
    "failed",
    "succeeded",
    "superseded"
  ])
  and .field_assertion_count == 11
  and .terminal_required_field_count == 6
  and (.field_assertions | length) == .field_assertion_count
  and (.field_assertions | all(.required == true and .assertion_id == "task_result_fixture_field_present_and_redacted"))
  and (.field_assertions | map(select(.terminal_required == true) | .wire_name) == [
    "taskId",
    "status",
    "summary",
    "evidence",
    "verifier",
    "traceId"
  ])
  and .verifier_contract_count == 8
  and (.verifier_contracts | length) == .verifier_contract_count
  and (.verifier_contracts | all(.stores_raw_payload == false and .performs_readback == false and .mutates_store == false))
  and .blocker_count == 4
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "fixture_runner_disabled",
    "golden_task_result_hashes_preview_only",
    "wrapper_execution_disabled",
    "task_result_enforcement_disabled"
  ])
  and (.blockers | map(select(.severity == "high")) | length) == 2
  and (.blockers | all(.required_before_wrapper_execution == true))
  and .required_prior_gate_count == 13
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_readback_preview_gate"
  and .ready_for_wrapper_readback_preview == true
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_fixture.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_fixture.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_fixture.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_terminal_task_result_wrapper_fixture --lib

echo "Hepta WorkGraph terminal TaskResult wrapper fixture preview gate passed"
