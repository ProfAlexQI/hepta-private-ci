#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-claim-final-index-terminal-operator-readiness-non-approval-index.report"
RELEASE_CLAIM_FINAL_INDEX_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-non-activation-release-claim-index-attachment-final-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_CLAIM_FINAL_INDEX_TERMINAL_OPERATOR_READINESS_NON_APPROVAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-release-claim-final-index-terminal-operator-readiness-non-approval-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable terminal operator readiness non-approval attachment report: $REPORT"
[[ -x "$RELEASE_CLAIM_FINAL_INDEX_GATE" ]] || fail "missing executable terminal non-activation release claim attachment final index gate: $RELEASE_CLAIM_FINAL_INDEX_GATE"
[[ -f "$DOC" ]] || fail "missing terminal operator readiness non-approval attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the terminal operator readiness non-approval attachment report"
fi

grep -q 'Terminal Operator Readiness Non-Approval Index Attachment' "$DOC" \
  || fail "architecture note must document Terminal Operator Readiness Non-Approval Index Attachment"
grep -q 'source-probes the terminal operator readiness non-approval index gate' "$DOC" \
  || fail "architecture note must document source-probing the terminal operator readiness non-approval index gate"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that attachment does not invoke operator or live gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "terminal_release_claim_final_index_terminal_operator_readiness_non_approval_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_terminal_non_activation_release_claim_index_attachment_final_index_surface == "terminal_non_activation_release_claim_index_attachment_final_index"
  and .source_terminal_non_activation_release_claim_index_attachment_final_index_ready == true
  and .source_terminal_non_activation_release_claim_index_attachment_final_index_blocked == true
  and .terminal_operator_readiness_non_approval_index_attachment_ready == true
  and .terminal_operator_readiness_non_approval_index_attachment_blocked == true
  and .terminal_non_activation_release_claim_index_attachment_final_index_attached == true
  and .terminal_operator_readiness_non_approval_index_gate_present == true
  and .terminal_operator_readiness_non_approval_index_doc_present == true
  and .terminal_operator_readiness_non_approval_index_gate_invoked == false
  and .terminal_non_activation_release_claim_index_gate_invoked == false
  and .terminal_public_distribution_non_publication_lock_gate_invoked == false
  and .terminal_release_artifact_non_write_lock_gate_invoked == false
  and .terminal_release_governance_final_audit_gate_invoked == false
  and .terminal_summary_gates_invoked == false
  and .terminal_live_gates_invoked == false
  and .canonical_gate_wrapper_invoked == false
  and .wrapper_target_invoked == false
  and .source_successor_consumer_cutover_allowed == false
  and .source_canonical_governance_rollback_anchor == "current_canonical_consumer"
  and .attachment_blocker_count == 24
  and (.attachment_blockers | index("terminal_operator_readiness_non_approval_index_source_probed_not_invoked")) != null
  and (.attachment_blockers | index("operator_approval_not_recorded")) != null
  and (.attachment_blockers | index("rollback_execution_disabled")) != null
  and (.attachment_blockers | index("operator_readiness_index_persistence_disabled")) != null
  and .manual_operator_live_cutover_approval_required == true
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .tool_execution_live_cutover_allowed == false
  and .tool_execution_public_ga_allowed == false
  and .public_distribution_publication_allowed == false
  and .release_publication_allowed == false
  and .release_artifact_write_allowed == false
  and .public_release_claim_allowed == false
  and .release_claim_index_persistence_allowed == false
  and .package_or_release_write_allowed == false
  and .operator_approval_recorded == false
  and .operator_identity_accepted == false
  and .rollback_execution_allowed == false
  and .operator_readiness_index_persistence_allowed == false
  and .next_migration_step == "derive_terminal_operator_readiness_non_approval_index_attachment_readback_without_operator_gate_invocation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$RELEASE_CLAIM_FINAL_INDEX_GATE" >/dev/null

printf 'hepta-systems-terminal-release-claim-final-index-terminal-operator-readiness-non-approval-index-gate: PASS: terminal operator readiness non-approval attachment source-probes operator index without claim/distribution/release/live invocation\n'
