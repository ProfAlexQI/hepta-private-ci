#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
CHECKLIST_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-decision-checklist.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_checklist_packet_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_CLEAN_WORKTREE_STRATEGY_OPERATOR_DECISION_CHECKLIST_PACKET_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-decision-checklist-packet-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$CHECKLIST_REPORT" ]] || fail "missing executable Phase 18 operator decision checklist report: $CHECKLIST_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 19 Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 19 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 19 operator decision checklist packet readback report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$CHECKLIST_REPORT" >"$tmpdir/checklist.json" \
  || fail "failed to render Phase 18 operator decision checklist report"
jq -e . "$tmpdir/checklist.json" >/dev/null \
  || fail "invalid JSON rendered by Phase 18 operator decision checklist report"

lib_export_present=false
if grep -q 'dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_checklist_packet_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile checklist "$tmpdir/checklist.json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-decision-checklist-packet-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_CLEAN_WORKTREE_STRATEGY_OPERATOR_DECISION_CHECKLIST_PACKET_READBACK_2026-06-27.md" \
  '
  def route_prefix($group_type):
    if $group_type == "top_level" then "top-level"
    elif $group_type == "scope" then "scope"
    else $group_type
    end;
  def key_safe($value): ($value | gsub("[^A-Za-z0-9._-]"; "_"));
  def route_safe($value): ($value | gsub("_"; "-") | gsub("[^A-Za-z0-9.-]"; "-"));
  def packet_entry:
    . as $entry
    | {
      source_checklist_key:$entry.checklist_key,
      source_checklist_route:$entry.checklist_route,
      packet_key:("dirty_worktree.decision_checklist_packet." + $entry.group_type + "." + key_safe($entry.source_bucket)),
      packet_route:("operator-packet://release-boundary/dirty-worktree/clean-worktree-strategy/operator-decision-checklist/" + route_prefix($entry.group_type) + "/" + route_safe($entry.source_bucket)),
      readback_key:("dirty_worktree.decision_checklist_packet_readback." + $entry.group_type + "." + key_safe($entry.source_bucket)),
      readback_route:("readback://release-boundary/dirty-worktree/clean-worktree-strategy/operator-decision-checklist-packet/" + route_prefix($entry.group_type) + "/" + route_safe($entry.source_bucket)),
      decision_checkpoint:$entry.decision_checkpoint,
      group_type:$entry.group_type,
      source_bucket:$entry.source_bucket,
      source_entry_count:$entry.source_entry_count,
      tracked_count:$entry.tracked_count,
      untracked_count:$entry.untracked_count,
      owner_hint:$entry.owner_hint,
      review_lane:$entry.review_lane,
      recommended_strategy:$entry.recommended_strategy,
      operator_action:$entry.operator_action,
      evidence_requirement:$entry.evidence_requirement,
      decision_state:$entry.decision_state,
      packet_state:"operator_decision_checklist_packet_visible_unsent_unpersisted",
      readback_state:"operator_decision_checklist_packet_readback_visible_unpersisted",
      checklist_attached:true,
      packet_visible:$entry.operator_visible,
      packet_unsent:true,
      packet_unpersisted:true,
      readback_visible:true,
      readback_unpersisted:true,
      operator_visible:$entry.operator_visible,
      queryable:$entry.queryable,
      diffable:$entry.diffable,
      operator_decision_required:$entry.operator_decision_required,
      decision_recording_allowed:false,
      approval_acceptance_allowed:false,
      evidence_recording_allowed:false,
      git_add_blocked:$entry.git_add_blocked,
      git_index_mutation_blocked:$entry.git_index_mutation_blocked,
      git_commit_blocked:$entry.git_commit_blocked,
      git_push_blocked:$entry.git_push_blocked,
      git_reset_blocked:$entry.git_reset_blocked,
      git_checkout_blocked:$entry.git_checkout_blocked,
      git_revert_blocked:$entry.git_revert_blocked,
      cleanup_blocked:$entry.cleanup_blocked,
      delete_blocked:$entry.delete_blocked,
      strategy_application_blocked:$entry.strategy_application_blocked,
      release_cutover_allowed:false,
      canary_activation_allowed:false,
      live_execution_allowed:false
    };
  ($checklist[0]) as $checklist |
  ($checklist.entries | map(packet_entry)) as $entries |
  ($entries | length) as $packet_readback_entry_count |
  ($entries | map(.packet_key) | unique | length) as $stable_packet_key_count |
  ($entries | map(.readback_key) | unique | length) as $stable_readback_key_count |
  ($entries | map(.packet_route) | unique | length) as $packet_route_count |
  ($entries | map(.readback_route) | unique | length) as $readback_route_count |
  ($entries | map(select(.checklist_attached == true and .packet_visible == true and .packet_unsent == true and .packet_unpersisted == true and .readback_visible == true and .readback_unpersisted == true and .operator_visible == true and .queryable == true and .diffable == true and .operator_decision_required == true and .decision_recording_allowed == false and .approval_acceptance_allowed == false and .evidence_recording_allowed == false and .git_add_blocked == true and .git_index_mutation_blocked == true and .git_commit_blocked == true and .git_push_blocked == true and .git_reset_blocked == true and .git_checkout_blocked == true and .git_revert_blocked == true and .cleanup_blocked == true and .delete_blocked == true and .strategy_application_blocked == true and .release_cutover_allowed == false and .canary_activation_allowed == false and .live_execution_allowed == false)) | length) as $packet_readback_ready_count |
  ($entries | map(select(.checklist_attached == true)) | length) as $checklist_attached_count |
  ($entries | map(select(.packet_visible == true and .packet_unsent == true and .packet_unpersisted == true)) | length) as $packet_visible_unsent_unpersisted_count |
  ($entries | map(select(.readback_visible == true and .readback_unpersisted == true)) | length) as $readback_unpersisted_count |
  ($entries | map(select(.decision_state == "pending_operator_decision")) | length) as $pending_operator_decision_count |
  ($entries | map(select(.decision_recording_allowed == false)) | length) as $decision_recording_blocked_count |
  ($entries | map(select(.approval_acceptance_allowed == false)) | length) as $approval_acceptance_blocked_count |
  ($entries | map(select(.evidence_recording_allowed == true)) | length) as $evidence_recorded_count |
  ($entries | map(select(.git_add_blocked == true and .git_index_mutation_blocked == true and .git_commit_blocked == true and .git_push_blocked == true and .git_reset_blocked == true and .git_checkout_blocked == true and .git_revert_blocked == true)) | length) as $git_mutation_blocked_count |
  ($entries | map(select(.cleanup_blocked == true and .delete_blocked == true)) | length) as $cleanup_delete_blocked_count |
  ($entries | map(select(.strategy_application_blocked == true)) | length) as $strategy_application_blocked_count |
  ($checklist.operator_decision_checklist_ready == true
    and $checklist.decision_checklist_visible == true
    and $checklist.decision_checklist_persisted == false
    and $checklist.decision_recorded == false
    and $checklist.operator_packet_sent == false
    and $checklist.operator_packet_persisted == false
    and $checklist.readback_persisted == false
    and $checklist.strategy_applied == false
    and $lib_export_present == true
    and $packet_readback_entry_count == $checklist.checklist_entry_count
    and $stable_packet_key_count == $packet_readback_entry_count
    and $stable_readback_key_count == $packet_readback_entry_count
    and $packet_route_count == $packet_readback_entry_count
    and $readback_route_count == $packet_readback_entry_count
    and $packet_readback_ready_count == $packet_readback_entry_count
    and $checklist_attached_count == $packet_readback_entry_count
    and $packet_visible_unsent_unpersisted_count == $packet_readback_entry_count
    and $readback_unpersisted_count == $packet_readback_entry_count
    and $pending_operator_decision_count == $packet_readback_entry_count
    and $decision_recording_blocked_count == $packet_readback_entry_count
    and $approval_acceptance_blocked_count == $packet_readback_entry_count
    and $evidence_recorded_count == 0
    and $git_mutation_blocked_count == $packet_readback_entry_count
    and $cleanup_delete_blocked_count == $packet_readback_entry_count
    and $strategy_application_blocked_count == $packet_readback_entry_count) as $packet_readback_ready |
  {
    runtime:"hepta",
    surface:"dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_checklist_packet_readback",
    status:(if $packet_readback_ready then "ready_blocked" else "blocked" end),
    gate:"dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_checklist_packet_readback_gate",
    schema_version:"dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_checklist_packet_readback_v1",
    plugin_id:$checklist.plugin_id,
    source_operator_decision_checklist_gate:$checklist.gate,
    source_operator_decision_checklist_ready:$checklist.operator_decision_checklist_ready,
    source_decision_checklist_visible:$checklist.decision_checklist_visible,
    source_decision_checklist_persisted:$checklist.decision_checklist_persisted,
    source_decision_recorded:$checklist.decision_recorded,
    source_operator_packet_sent:$checklist.operator_packet_sent,
    source_operator_packet_persisted:$checklist.operator_packet_persisted,
    source_readback_persisted:$checklist.readback_persisted,
    source_strategy_applied:$checklist.strategy_applied,
    source_checklist_entry_count:$checklist.checklist_entry_count,
    lib_export_present:$lib_export_present,
    inventory_entry_count:$checklist.inventory_entry_count,
    tracked_change_count:$checklist.tracked_change_count,
    untracked_change_count:$checklist.untracked_change_count,
    packet_readback_scope:{
      packet_readback_id:"dirty-worktree.release-boundary.clean-worktree-strategy.operator-decision-checklist.packet-readback.v1",
      packet_readback_route:"readback://release-boundary/dirty-worktree/clean-worktree-strategy/operator-decision-checklist-packet/v1",
      source_checklist_route:$checklist.checklist_scope.checklist_route,
      readback_mode:"operator_decision_checklist_packet_readback_only",
      packet_send_boundary:"blocked",
      packet_persistence_boundary:"blocked",
      decision_recording_boundary:"blocked",
      git_mutation_boundary:"closed"
    },
    packet_readback_entry_count:$packet_readback_entry_count,
    stable_packet_key_count:$stable_packet_key_count,
    stable_readback_key_count:$stable_readback_key_count,
    packet_route_count:$packet_route_count,
    readback_route_count:$readback_route_count,
    packet_readback_ready_count:$packet_readback_ready_count,
    checklist_attached_count:$checklist_attached_count,
    packet_visible_unsent_unpersisted_count:$packet_visible_unsent_unpersisted_count,
    readback_unpersisted_count:$readback_unpersisted_count,
    pending_operator_decision_count:$pending_operator_decision_count,
    decision_recording_blocked_count:$decision_recording_blocked_count,
    approval_acceptance_blocked_count:$approval_acceptance_blocked_count,
    evidence_recorded_count:$evidence_recorded_count,
    git_mutation_blocked_count:$git_mutation_blocked_count,
    cleanup_delete_blocked_count:$cleanup_delete_blocked_count,
    strategy_application_blocked_count:$strategy_application_blocked_count,
    packet_readback_visible:$packet_readback_ready,
    packet_readback_persisted:false,
    decision_checklist_persisted:false,
    decision_recorded:false,
    operator_packet_sent:false,
    operator_packet_persisted:false,
    readback_persisted:false,
    strategy_applied:false,
    release_cutover_allowed:false,
    git_add_allowed:false,
    git_index_mutated:false,
    git_commit_allowed:false,
    git_push_allowed:false,
    git_reset_allowed:false,
    git_checkout_allowed:false,
    git_revert_allowed:false,
    cleanup_allowed:false,
    delete_allowed:false,
    evidence_recording_allowed:false,
    evidence_persistence_allowed:false,
    approval_request_sent:false,
    approval_acceptance_allowed:false,
    blocker_waiver_allowed:false,
    package_or_release_allowed:false,
    public_ga_allowed:false,
    canary_activation_allowed:false,
    live_activation_allowed:false,
    live_execution_allowed:false,
    operator_decision_checklist_packet_readback_ready:$packet_readback_ready,
    entries:$entries,
    blockers:[
      "operator_decision_checklist_packet_send_blocked",
      "operator_decision_checklist_packet_persistence_blocked",
      "operator_decision_checklist_packet_readback_persistence_blocked",
      "operator_decision_recording_blocked",
      "approval_acceptance_blocked",
      "evidence_recording_blocked",
      "git_add_blocked",
      "git_index_mutation_blocked",
      "git_commit_blocked",
      "git_push_blocked",
      "git_reset_blocked",
      "git_checkout_blocked",
      "git_revert_blocked",
      "cleanup_and_delete_blocked",
      "strategy_application_blocked",
      "release_cutover_blocked",
      "canary_activation_blocked",
      "live_activation_blocked"
    ],
    next_actions:[
      "phase20_dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_recording_boundary_readback_without_recording",
      "keep_operator_decision_checklist_packet_unsent_unpersisted_without_recording_or_git_mutation"
    ],
    next_migration_step:"phase20_dirty_worktree_release_boundary_clean_worktree_strategy_operator_decision_recording_boundary_readback_without_recording",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      packet_sent:false,
      packet_persisted:false,
      packet_readback_persisted:false,
      decision_checklist_persisted:false,
      decision_recorded:false,
      readback_persisted:false,
      git_add_performed:false,
      git_index_mutated:false,
      git_commit_created:false,
      git_push_performed:false,
      git_reset_performed:false,
      git_checkout_performed:false,
      git_revert_performed:false,
      cleanup_performed:false,
      unrelated_file_deleted:false,
      strategy_applied:false,
      evidence_recorded:false,
      evidence_persisted:false,
      approval_requested:false,
      approval_accepted:false,
      blocker_waived:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      canary_activation_started:false,
      live_activation_started:false,
      live_execution_started:false
    }
  }'
