#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
MIGRATION_PREFLIGHT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper-promoted-consumer-migration-preflight.report"
CURRENT_CONSUMER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_WRAPPER_2026-06-21.md"

fail() {
  printf 'hepta-systems-promoted-current-canonical-wrapper-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$MIGRATION_PREFLIGHT_REPORT" ]] || fail "missing executable promoted consumer migration preflight report: $MIGRATION_PREFLIGHT_REPORT"
[[ -x "$CURRENT_CONSUMER_REPORT" ]] || fail "missing executable current canonical consumer report: $CURRENT_CONSUMER_REPORT"
[[ -f "$DOC" ]] || fail "missing promoted current canonical wrapper architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the promoted current canonical wrapper report"
fi

jq -n \
  --slurpfile preflight <("$MIGRATION_PREFLIGHT_REPORT") \
  --slurpfile consumer <("$CURRENT_CONSUMER_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-wrapper.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PROMOTED_CURRENT_CANONICAL_WRAPPER_2026-06-21.md" \
  '
  ($preflight[0]) as $preflight |
  ($consumer[0]) as $consumer |
  [
    {
      id:"current_canonical_consumer",
      surface:$consumer.surface,
      source_ready:$consumer.current_canonical_consumer_ready,
      required:true,
      invoked_by_report:false,
      gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.gate"
    },
    {
      id:"promoted_consumer_migration_preflight",
      surface:$preflight.surface,
      source_ready:$preflight.migration_preflight_ready,
      required:true,
      invoked_by_report:false,
      gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper-promoted-consumer-migration-preflight.gate"
    }
  ] as $wrapper_inputs |
  [
    "manual_operator_live_cutover_approval_required",
    "tool_execution_live_cutover_allowed_false",
    "tool_execution_public_ga_allowed_false",
    "canonical_gate_not_invoked_by_promoted_wrapper",
    "wrapper_target_not_invoked_by_promoted_wrapper",
    "legacy_wrapper_not_replaced_in_place",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started"
  ] as $wrapper_blockers |
  ($consumer.current_canonical_consumer_ready == true
    and $consumer.current_canonical_consumer_surface == "post_canonical_closure_compact_capability_summary"
    and $consumer.previous_current_summary_superseded_by_post_canonical_closure == true
    and $consumer.stale_pre_creation_blockers_present == false
    and $preflight.migration_preflight_ready == true
    and $preflight.direct_current_wrapper_source_replacement_allowed == false
    and $preflight.direct_current_wrapper_source_replacement_blocked == true
    and $preflight.dependency_cycle_detected == true
    and $preflight.successor_wrapper_surface_required == true
    and $preflight.successor_wrapper_surface_allowed == true
    and $preflight.successor_wrapper_surface == "promoted_current_canonical_wrapper"
    and $preflight.current_canonical_wrapper_mutated == false
    and $preflight.canonical_summary_mutated == false
    and $preflight.historical_canonical_gate_mutated == false
    and $consumer.execution_enabled_count == 0
    and $consumer.public_ga_enabled_count == 0
    and $consumer.tool_execution_live_cutover_allowed == false
    and $consumer.tool_execution_public_ga_allowed == false
    and ($wrapper_inputs | all(.required == true and .source_ready == true and .invoked_by_report == false))
    and ($consumer.side_effects | to_entries | all(.value == false))
    and ($preflight.side_effects | to_entries | all(.value == false))) as $wrapper_ready |
  {
    runtime:"hepta",
    surface:"promoted_current_canonical_wrapper",
    plugin_id:$consumer.plugin_id,
    status:(if $wrapper_ready then "ready" else "blocked" end),
    source_current_canonical_consumer_surface:$consumer.surface,
    source_current_canonical_consumer_ready:$consumer.current_canonical_consumer_ready,
    source_promoted_consumer_surface:$consumer.current_canonical_consumer_surface,
    source_migration_preflight_surface:$preflight.surface,
    source_migration_preflight_ready:$preflight.migration_preflight_ready,
    promoted_current_canonical_wrapper_ready:$wrapper_ready,
    promoted_wrapper_kind:"non_circular_successor_report",
    promoted_wrapper_source_surface:"current_canonical_consumer",
    promoted_wrapper_consumes_post_canonical_summary:true,
    promoted_wrapper_input_count:($wrapper_inputs | length),
    promoted_wrapper_inputs:$wrapper_inputs,
    legacy_current_canonical_wrapper_replaced_in_place:false,
    legacy_current_canonical_wrapper_mutated:false,
    historical_canonical_gate_mutated:false,
    canonical_summary_mutated:false,
    direct_current_wrapper_source_replacement_allowed:false,
    dependency_cycle_detected_in_direct_replacement:true,
    successor_wrapper_surface_required:true,
    local_surface_count:$consumer.local_surface_count,
    local_surface_ready_count:$consumer.local_surface_ready_count,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    wrapper_blocker_count:($wrapper_blockers | length),
    wrapper_blockers:$wrapper_blockers,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"attach_promoted_current_canonical_wrapper_to_closure_successor_without_alias_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      current_canonical_consumer_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report",
      promoted_consumer_migration_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper-promoted-consumer-migration-preflight.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      current_canonical_wrapper_mutated:false,
      promoted_current_canonical_wrapper_mutated:false,
      historical_canonical_gate_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
