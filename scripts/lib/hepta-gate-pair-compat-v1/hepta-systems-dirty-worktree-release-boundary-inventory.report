#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
CANARY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-canary-readiness-plan.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/dirty_worktree_release_boundary_inventory.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_INVENTORY_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-inventory-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$CANARY_REPORT" ]] || fail "missing executable Phase 10 canary report: $CANARY_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 11 Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 11 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 11 dirty-worktree release-boundary inventory report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

canary_cache="${HEPTA_DIRTY_WORKTREE_RELEASE_BOUNDARY_CANARY_JSON:-}"
canary_json="$tmpdir/canary.json"
canary_cache_consumed=false
if [[ -n "$canary_cache" ]]; then
  [[ -f "$canary_cache" ]] || fail "missing cached controlled canary readiness plan report: $canary_cache"
  canary_json="$canary_cache"
  canary_cache_consumed=true
else
  "$CANARY_REPORT" >"$canary_json" \
    || fail "failed to render Phase 10 controlled canary readiness plan report"
fi
jq -e . "$canary_json" >/dev/null \
  || fail "invalid JSON rendered by Phase 10 controlled canary readiness plan report"

git -C "$ROOT" status --porcelain >"$tmpdir/git-status.txt"

jq -Rsc '
  def is_unmerged($code): ["AA","DD","AU","UA","DU","UD","UU"] | index($code) != null;
  def owned_scope($path):
    ($path | startswith("apps/hepta-native/")
      or startswith("codex-rs/hepta-runtime/")
      or startswith("codex-rs/core-plugins/")
      or startswith("codex-rs/hepta-plugins/")
      or startswith("codex-rs/plugin/")
      or startswith("codex-rs/utils/plugins/")
      or startswith("codex-rs/tools/")
      or startswith(".hepta/")
      or startswith("plugins/hepta-system/")
      or startswith("scripts/")
      or startswith("docs/architecture/HEPTA_SYSTEMS"));
  def change_kind($code; $index; $worktree):
    if $code == "??" then "untracked"
    elif is_unmerged($code) then "unmerged"
    elif ($index != " " and $worktree != " ") then "index_and_worktree"
    elif $index != " " then "index_only"
    elif $worktree != " " then "worktree_only"
    else "unknown"
    end;
  def top_level($path):
    if ($path | contains("/")) then ($path | split("/")[0]) else $path end;
  def route_path($path): ($path | gsub("[^A-Za-z0-9._/-]"; "-"));
  split("\n")
  | map(select(length > 0))
  | map(
      . as $line
      | ($line[0:2]) as $code
      | ($line[0:1]) as $index
      | ($line[1:2]) as $worktree
      | ($line[3:]) as $path
      | {
          status_code:$code,
          index_status:$index,
          worktree_status:$worktree,
          path:$path,
          top_level:top_level($path),
          change_kind:change_kind($code; $index; $worktree),
          scope_bucket:(if owned_scope($path) then "hepta_systems_owned" else "cross_lane_or_unowned" end),
          operator_visible:true,
          queryable:true,
          release_boundary_route:("readback://release-boundary/dirty-worktree/path/" + route_path($path)),
          git_mutation_allowed:false,
          cleanup_allowed:false,
          release_cutover_allowed:false
        }
    )
' "$tmpdir/git-status.txt" >"$tmpdir/git-status-entries.json"

lib_export_present=false
if grep -q 'dirty_worktree_release_boundary_inventory_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile canary "$canary_json" \
  --slurpfile entries "$tmpdir/git-status-entries.json" \
  --argjson lib_export_present "$lib_export_present" \
  --argjson canary_cache_consumed "$canary_cache_consumed" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-inventory.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_INVENTORY_2026-06-27.md" \
  '
  ($canary[0]) as $canary |
  ($entries[0]) as $entries |
  ($entries | length) as $entry_count |
  ($entries | map(select(.status_code != "??")) | length) as $tracked_count |
  ($entries | map(select(.status_code == "??")) | length) as $untracked_count |
  ($entries | map(select(.status_code != "??" and .index_status != " ")) | length) as $staged_count |
  ($entries | map(select(.status_code != "??" and .worktree_status != " ")) | length) as $unstaged_count |
  ($entries | map(select(.status_code | contains("M"))) | length) as $modified_count |
  ($entries | map(select(.status_code | contains("D"))) | length) as $deleted_count |
  ($entries | map(select(.status_code | contains("A"))) | length) as $added_count |
  ($entries | map(select(.status_code | contains("R"))) | length) as $renamed_count |
  ($entries | map(select(.change_kind == "unmerged")) | length) as $unmerged_count |
  ($entries | map(select(.scope_bucket == "hepta_systems_owned")) | length) as $owned_count |
  ($entries | map(select(.scope_bucket == "cross_lane_or_unowned")) | length) as $cross_count |
  ($entries | sort_by(.top_level) | group_by(.top_level) | map({
    top_level:.[0].top_level,
    count:length,
    tracked_count:(map(select(.status_code != "??")) | length),
    untracked_count:(map(select(.status_code == "??")) | length),
    hepta_systems_owned_count:(map(select(.scope_bucket == "hepta_systems_owned")) | length),
    cross_lane_or_unowned_count:(map(select(.scope_bucket == "cross_lane_or_unowned")) | length)
  })) as $top_buckets |
  ($entries | sort_by(.scope_bucket) | group_by(.scope_bucket) | map({
    scope_bucket:.[0].scope_bucket,
    count:length,
    tracked_count:(map(select(.status_code != "??")) | length),
    untracked_count:(map(select(.status_code == "??")) | length)
  })) as $scope_buckets |
  80 as $sample_limit |
  ($entry_count > $sample_limit) as $inventory_truncated |
  ($canary.controlled_canary_readiness_plan_ready == true
    and $canary.controlled_canary_activation_ready == false
    and $lib_export_present == true
    and $entry_count > 0
    and $entry_count == ($tracked_count + $untracked_count)
    and $entry_count == ($owned_count + $cross_count)
    and ($top_buckets | length) > 0
    and ($scope_buckets | length) > 0) as $inventory_ready |
  {
    runtime:"hepta",
    surface:"dirty_worktree_release_boundary_inventory",
    status:(if $inventory_ready then "ready_blocked" else "blocked" end),
    gate:"dirty_worktree_release_boundary_inventory_gate",
    schema_version:"dirty_worktree_release_boundary_inventory_v1",
    plugin_id:$canary.plugin_id,
    source_canary_gate:$canary.gate,
    source_canary_ready:$canary.controlled_canary_readiness_plan_ready,
    source_canary_activation_ready:$canary.controlled_canary_activation_ready,
    source_canary_cache_consumed:$canary_cache_consumed,
    lib_export_present:$lib_export_present,
    inventory_scope:{
      inventory_id:"dirty-worktree.release-boundary.inventory.v1",
      inventory_route:"readback://release-boundary/dirty-worktree/inventory/v1",
      source_command:"git status --porcelain",
      collection_mode:"read_only_inventory_no_git_mutation",
      mutation_boundary:"closed",
      release_boundary_state:"blocked_dirty_worktree"
    },
    inventory_entry_count:$entry_count,
    tracked_change_count:$tracked_count,
    untracked_change_count:$untracked_count,
    staged_change_count:$staged_count,
    unstaged_change_count:$unstaged_count,
    modified_change_count:$modified_count,
    deleted_change_count:$deleted_count,
    added_change_count:$added_count,
    renamed_change_count:$renamed_count,
    unmerged_change_count:$unmerged_count,
    hepta_systems_owned_count:$owned_count,
    cross_lane_or_unowned_count:$cross_count,
    top_level_bucket_count:($top_buckets | length),
    scope_bucket_count:($scope_buckets | length),
    inventory_sample_limit:$sample_limit,
    inventory_sample_count:($entries[:$sample_limit] | length),
    inventory_truncated:$inventory_truncated,
    inventory_counts:{
      inventory_entry_count:$entry_count,
      tracked_change_count:$tracked_count,
      untracked_change_count:$untracked_count,
      staged_change_count:$staged_count,
      unstaged_change_count:$unstaged_count,
      modified_change_count:$modified_count,
      deleted_change_count:$deleted_count,
      added_change_count:$added_count,
      renamed_change_count:$renamed_count,
      unmerged_change_count:$unmerged_count,
      hepta_systems_owned_count:$owned_count,
      cross_lane_or_unowned_count:$cross_count,
      top_level_bucket_count:($top_buckets | length),
      sample_entry_count:($entries[:$sample_limit] | length)
    },
    top_level_buckets:$top_buckets,
    scope_buckets:$scope_buckets,
    entries_sample:$entries[:$sample_limit],
    dirty_worktree_release_boundary_open:($entry_count > 0),
    dirty_worktree_release_boundary_resolved:($entry_count == 0),
    release_boundary_inventory_ready:$inventory_ready,
    operator_visible:true,
    queryable:true,
    diffable:true,
    release_cutover_allowed:false,
    git_add_allowed:false,
    git_index_mutated:false,
    git_commit_allowed:false,
    git_push_allowed:false,
    git_reset_allowed:false,
    git_checkout_allowed:false,
    git_revert_allowed:false,
    cleanup_allowed:false,
    delete_allowed:false,
    evidence_recording_allowed:false,
    evidence_persistence_allowed:false,
    package_or_release_allowed:false,
    public_ga_allowed:false,
    canary_activation_allowed:false,
    live_activation_allowed:false,
    live_execution_allowed:false,
    blockers:[
      "dirty_worktree_release_boundary_open",
      "release_cutover_blocked_until_inventory_grouping_freeze",
      "git_mutation_blocked",
      "cleanup_and_delete_blocked",
      "evidence_recording_blocked",
      "canary_activation_blocked",
      "live_activation_blocked"
    ],
    next_actions:[
      "phase12_dirty_worktree_release_boundary_grouping_freeze_plan_without_git_mutation"
    ],
    next_migration_step:"phase12_dirty_worktree_release_boundary_grouping_freeze_plan_without_git_mutation",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      git_commit_created:false,
      git_push_performed:false,
      git_reset_performed:false,
      git_checkout_performed:false,
      git_revert_performed:false,
      unrelated_file_deleted:false,
      cleanup_performed:false,
      evidence_recorded:false,
      evidence_persisted:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      canary_activation_started:false,
      live_activation_started:false,
      live_execution_started:false
    }
  }'
