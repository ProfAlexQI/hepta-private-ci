  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_final_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_final_index_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_denial_gate_invoked == false
  and .signing_receipt_recorded == false
  and .signing_receipt_persisted == false
  and .signing_receipt_materialized == false
  and .signing_receipt_filesystem_written == false
  and .signing_receipt_status_exposed == false
  and .artifact_signing_receipt_signing_receipt_signing_receipt_recorded == false
  and .notarization_submission_receipt_recorded == false
  and .notarization_ticket_receipt_recorded == false
  and .external_receipt_sent == false
  and .telegram_receipt_sent == false
  and .release_publication_authority_from_signing_receipt_derived == false
  and .activation_authority_from_signing_receipt_derived == false
  and .install_from_signing_receipt_executed == false
  and .active_binary_from_signing_receipt_mutated == false
  and .provider_invoked == false
  and .credential_read == false
  and .final_blocker_count == 260
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .next_migration_step == "attach_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_non_persistence_final_index_to_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_replay_idempotency_without_receipt"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$READBACK_GATE" >/dev/null

printf 'hepta-systems-terminal-public-claim-delivery-receipt-artifact-signing-receipt-signing-receipt-signing-receipt-non-persistence-policy-final-index-gate: PASS: artifact signing receipt signing receipt signing receipt non-persistence final index is ready but blocked\n'
