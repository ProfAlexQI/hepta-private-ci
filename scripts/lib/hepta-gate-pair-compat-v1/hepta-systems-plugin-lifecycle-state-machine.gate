#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-lifecycle-state-machine.report"
ABI_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-contribution-point-abi.gate"
LOADER_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-contribution-point-loader-binding.gate"
TOOL_INVENTORY_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-contribution-inventory-preview.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_LIFECYCLE_STATE_MACHINE_2026-06-27.md"

fail() {
  printf 'hepta-systems-plugin-lifecycle-state-machine-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable plugin lifecycle state-machine report: $REPORT"
[[ -x "$ABI_GATE" ]] || fail "missing executable contribution-point ABI gate: $ABI_GATE"
[[ -x "$LOADER_GATE" ]] || fail "missing executable loader binding gate: $LOADER_GATE"
[[ -x "$TOOL_INVENTORY_GATE" ]] || fail "missing executable plugin tool inventory gate: $TOOL_INVENTORY_GATE"
[[ -f "$DOC" ]] || fail "missing plugin lifecycle state-machine architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the plugin lifecycle state-machine report"
fi

grep -q 'Plugin Lifecycle State Machine' "$DOC" \
  || fail "architecture note must document Plugin Lifecycle State Machine"
grep -q 'does not install plugins' "$DOC" \
  || fail "architecture note must document no plugin install boundary"
grep -q 'live mutation disabled' "$DOC" \
  || fail "architecture note must document live mutation disabled boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "plugin_lifecycle_state_machine"
  and .status == "ready"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_abi_surface == "plugin_contribution_point_abi"
  and .source_abi_ready == true
  and .source_loader_binding_surface == "plugin_contribution_point_loader_binding"
  and .source_loader_binding_ready == true
  and .source_tool_preview_surface == "plugin_tool_contribution_inventory_preview"
  and .source_tool_preview_ready == true
  and .source_tool_preview_candidate_count == 2
  and .state_machine_export_present == true
  and .phase_summary_export_present == true
  and .restored_memory_state_machine == true
  and .restored_memory_phase_summary == true
  and .plugin_manifest_summary.skill_path_present == true
  and .plugin_manifest_summary.mcp_servers_path_present == true
  and .plugin_manifest_summary.apps_path_present == true
  and .plugin_manifest_summary.skill_count == 1
  and .plugin_manifest_summary.mcp_server_count == 1
  and .plugin_manifest_summary.app_count == 1
  and .plugin_manifest_summary.tool_schema_count == 2
  and .plugin_manifest_summary.permission_count == 2
  and .plugin_manifest_summary.activation_event_count == 2
  and .plugin_manifest_summary.tool_policy_count == 2
  and .fixture_shape_ready == true
  and .fixture_policy_metadata_ready == true
  and .lifecycle_phase_count == 6
  and .lifecycle_ready_phase_count == 6
  and .lifecycle_blocked_phase_count == 0
  and .lifecycle_state_machine_ready == true
  and .lifecycle_phase_summary_ready == true
  and .source_of_truth_ready == true
  and .tool_registry_registration_enabled == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .plugin_cache_mutated == false
  and .local_storage_created == false
  and .all_live_paths_blocked == true
  and .live_mutation_ready == false
  and (.phases | length) == 6
  and (.phases | all(.ready == true and .live_mutation_enabled == false and .blocker == null))
  and (.phases | any(.phase == "manifest_fixture_discovered"))
  and (.phases | any(.phase == "contribution_point_abi_audited"))
  and (.phases | any(.phase == "loader_binding_audited"))
  and (.phases | any(.phase == "fixture_policy_metadata_audited"))
  and (.phases | any(.phase == "tool_preview_contract_audited"))
  and (.phases | any(.phase == "live_mutation_blocked"))
  and (.blockers | index("tool_registry_dispatch_preflight_not_promoted")) != null
  and (.blockers | index("live_mutation_blocked_by_design")) != null
  and (.next_actions | index("phase2_promote_tool_registry_to_read_only_dispatch_preflight_without_invocation")) != null
  and .next_migration_step == "phase2_promote_tool_registry_to_read_only_dispatch_preflight_without_invocation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$ABI_GATE" >/dev/null
"$LOADER_GATE" >/dev/null
"$TOOL_INVENTORY_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-core-plugins lifecycle --quiet
)

printf 'hepta-systems-plugin-lifecycle-state-machine-gate: PASS: plugin lifecycle source-of-truth is restored with live paths blocked\n'
