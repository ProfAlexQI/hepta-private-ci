#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-receipt-notarization-final-index-delivery-receipt-signing-receipt-nonp.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-receipt-notarization-final-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_SIGNING_RECEIPT_NOTARIZATION_FINAL_INDEX_DELIVERY_RECEIPT_SIGNING_RECEIPT_NONP_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-receipt-nonp-attachment-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable artifact signing receipt signing receipt non-persistence attachment report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable artifact signing receipt signing/notarization final index gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing artifact signing receipt signing receipt non-persistence attachment architecture note: $DOC"

grep -q 'Artifact Signing Receipt Signing Receipt Non-Persistence Attachment' "$DOC" \
  || fail "architecture note must document Artifact Signing Receipt Signing Receipt Non-Persistence Attachment"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that attachment does not invoke signing receipt gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_attachment"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_artifact_signing_notarization_surface_final_index_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_artifact_signing_notarization_surface_final_index_blocked == true
  and .source_final_blocker_count == 146
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_attachment_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_attachment_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_static_mention_count >= 30
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_denial_gate_invoked == false
  and .signing_receipt_recorded == false
  and .signing_receipt_persisted == false
  and .signing_receipt_materialized == false
  and .signing_receipt_filesystem_written == false
  and .artifact_signing_receipt_recorded == false
  and .notarization_ticket_receipt_recorded == false
  and .external_receipt_sent == false
  and .telegram_receipt_sent == false
  and .release_publication_authority_from_signing_receipt_derived == false
  and .activation_authority_from_signing_receipt_derived == false
  and .install_from_signing_receipt_executed == false
  and .active_binary_from_signing_receipt_mutated == false
  and .provider_invoked == false
  and .credential_read == false
  and .attachment_blocker_count == 148
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .next_migration_step == "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_non_persistence_readback_without_signing"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-receipt-nonp-attachment-gate: PASS: artifact signing receipt signing receipt non-persistence attachment is ready but blocked\n'
