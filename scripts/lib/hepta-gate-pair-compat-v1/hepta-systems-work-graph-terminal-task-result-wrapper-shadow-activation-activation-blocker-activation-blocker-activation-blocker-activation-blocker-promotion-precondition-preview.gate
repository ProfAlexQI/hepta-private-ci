#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-task-result-wrapper-shadow-activation-activation-blocker-activation-blocker-activation-blocker-activation-blocker-promotion-precondition-preview.report"

report="$(capture_json_report "hepta-work-graph-terminal-task-result-wrapper-shadow-activation-activation-blocker-activation-blocker-activation-blocker-activation-blocker-promotion-precondition-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_preview_no_activation"
  and .target_count == 7
  and (.targets | length) == .target_count
  and (.targets | map(.activation_surface_id) == [
    "wrapper_execution_activation",
    "readback_execution_activation",
    "promotion_execution_activation",
    "task_result_enforcement_activation",
    "store_enablement_activation",
    "live_execution_activation",
    "external_delivery_activation"
  ])
  and (.targets | all(
    (.required_precondition_ids | length) == 4
    and (.required_drift_budget_ids | length) == 5
    and (.required_operator_summary_ids | length) == 5
    and .promotion_state == "blocked_preview_only"
    and .blocks_shadow_activation_blocker_activation_blocker_readback == true
    and .blocks_activation == true
    and .blocks_promotion_execution == true
    and .promotes_state == false
  ))
  and .precondition_binding_count == 4
  and (.precondition_bindings | length) == .precondition_binding_count
  and (.precondition_bindings | map(.id) == [
    "all_shadow_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budgets_zero_tolerance",
    "shadow_activation_blocker_activation_blocker_operator_summaries_reviewed",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_zero_mutation_required",
    "shadow_activation_blocker_activation_blocker_readback_remains_disabled_until_budget_review"
  ])
  and (.precondition_bindings | all(
    .source_gate_id == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budget_preview_gate"
    and .blocks_shadow_activation_blocker_activation_blocker_readback == true
    and .blocks_activation == true
    and .blocks_promotion == true
    and .currently_satisfied == false
  ))
  and .blocker_count == 5
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "shadow_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budgets_not_executed",
    "shadow_activation_blocker_activation_blocker_operator_review_missing",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_not_proven",
    "shadow_activation_blocker_activation_blocker_runtime_attachment_disabled",
    "shadow_activation_blocker_activation_blocker_promotion_execution_disabled"
  ])
  and (.blockers | map(select(.severity == "critical")) | length) == 2
  and (.blockers | map(select(.severity == "high")) | length) == 1
  and (.blockers | all(
    (.blocks_target_ids | length) == 7
    and .required_before_shadow_activation_blocker_activation_blocker_readback == true
    and .required_before_shadow_activation == true
    and .required_before_shadow_promotion == true
  ))
  and .audit_receipt_count == 7
  and (.audit_receipts | length) == .audit_receipt_count
  and (.audit_receipts | all(
    .persists_receipt == false
    and .authorizes_activation == false
    and .external_delivery_enabled == false
    and (.required_fields | index("receiptHash"))
    and (.required_fields | index("redactedEvidenceRefs"))
    and (.required_fields | index("sideEffectLockHash"))
    and (.required_fields | index("preconditionIds"))
    and (.required_fields | index("blockerIds"))
  ))
  and .invariant_count == 6
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "shadow_activation_blocker_activation_blocker_preconditions_are_preview_only",
    "zero_tolerance_activation_blocker_budgets_do_not_authorize_activation",
    "shadow_activation_blocker_activation_blocker_operator_summaries_do_not_record_approval",
    "shadow_activation_blocker_activation_blocker_audit_receipts_are_non_persistent",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_stays_false",
    "shadow_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and .required_prior_gate_count == 36
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budget_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview_gate"
  and .ready_for_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview == true
  and .ready_for_shadow_activation_blocker_activation_blocker_promotion_execution == false
  and .ready_for_shadow_activation_blocker_activation_blocker_readback_execution == false
  and .ready_for_shadow_activation_execution == false
  and .ready_for_activation == false
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budget.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_drift_budget.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition --lib

echo "Hepta WorkGraph terminal TaskResult wrapper shadow activation activation blocker promotion precondition preview gate passed"
