[[ -x "$SOURCE_REPORT" ]] || {
  echo "missing executable terminal public claim delivery receipt artifact signing receipt cancellation/supersession final index report: $SOURCE_REPORT" >&2
  exit 1
}
[[ -f "$SIGNING_AUDIT_GATE" ]] || {
  echo "missing terminal public claim delivery receipt artifact signing receipt audit/evidence denial gate: $SIGNING_AUDIT_GATE" >&2
  exit 1
}
[[ -f "$SIGNING_AUDIT_DOC" ]] || {
  echo "missing terminal public claim delivery receipt artifact signing receipt audit/evidence denial doc: $SIGNING_AUDIT_DOC" >&2
  exit 1
}

source_json="$("$SOURCE_REPORT")"

