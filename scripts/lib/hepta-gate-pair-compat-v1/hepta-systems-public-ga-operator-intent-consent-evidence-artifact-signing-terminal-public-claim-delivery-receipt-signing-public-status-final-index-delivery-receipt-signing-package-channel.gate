#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-public-status-final-index-delivery-receipt-signing-package-channel.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-public-status-final-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_SIGNING_PUBLIC_STATUS_FINAL_INDEX_DELIVERY_RECEIPT_SIGNING_PACKAGE_CHANNEL_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-package-channel-attachment-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable artifact signing receipt package/release/channel status attachment report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable artifact signing receipt terminal public claim/status final index gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing artifact signing receipt package/release/channel status attachment architecture note: $DOC"

grep -q 'Artifact Signing Receipt Package/Release/Channel Status Attachment' "$DOC" \
  || fail "architecture note must document Artifact Signing Receipt Package/Release/Channel Status Attachment"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that attachment does not invoke package/release/channel gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_attachment"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_terminal_public_claim_status_exposure_final_index_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_terminal_public_claim_status_exposure_final_index_blocked == true
  and .source_final_blocker_count == 140
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_attachment_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_attachment_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_static_mention_count >= 30
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_denial_gate_invoked == false
  and .package_release_channel_status_recorded == false
  and .package_release_channel_status_persisted == false
  and .package_channel_status_exposed == false
  and .release_channel_status_exposed == false
  and .registry_channel_status_exposed == false
  and .update_feed_status_exposed == false
  and .dashboard_channel_status_exposed == false
  and .status_endpoint_channel_status_exposed == false
  and .query_status_exposed == false
  and .export_status_exposed == false
  and .observability_status_exposed == false
  and .channel_status_delivered == false
  and .external_status_sent == false
  and .telegram_status_sent == false
  and .operator_approval_from_package_channel_derived == false
  and .release_publication_authority_from_package_channel_derived == false
  and .activation_authority_from_package_channel_derived == false
  and .install_from_package_channel_executed == false
  and .active_binary_from_package_channel_mutated == false
  and .provider_invoked == false
  and .credential_read == false
  and .attachment_blocker_count == 142
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .next_migration_step == "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_package_release_channel_status_readback_without_public_status"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-package-channel-attachment-gate: PASS: artifact signing receipt package/release/channel status attachment is ready but blocked\n'
