#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
COST_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-gate-recursion-cost-boundary-readback.report"
RECOVERY_RECEIPT_LOCAL_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-temporal-lite-replay-alignment-recovery-receipt-local-persistence-readback.gate"
RECOVERY_WINDOW_FEATURE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-temporal-lite-replay-alignment-recovery-window-feature-gated-readback.gate"
WORKGRAPH_LEGACY_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-work-graph-events-event-store-cutover-terminal-no-cutover-receipt-acknowledgement-replay-idempotency-closeout-rerun-preview.gate"
SINGLE_RENDER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-matrix-report-single-render-cache-boundary-readback.report"
DASHBOARD_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-readiness-dashboard.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/hepta_systems_gate_recursion_lean_contract_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_GATE_RECURSION_LEAN_CONTRACT_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-gate-recursion-lean-contract-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$COST_REPORT" ]] || fail "missing executable gate recursion cost report: $COST_REPORT"
[[ -x "$RECOVERY_RECEIPT_LOCAL_GATE" ]] || fail "missing executable recovery receipt local gate: $RECOVERY_RECEIPT_LOCAL_GATE"
[[ -x "$RECOVERY_WINDOW_FEATURE_GATE" ]] || fail "missing executable recovery window feature gate: $RECOVERY_WINDOW_FEATURE_GATE"
[[ -x "$WORKGRAPH_LEGACY_GATE" ]] || fail "missing executable WorkGraph legacy gate: $WORKGRAPH_LEGACY_GATE"
[[ -x "$SINGLE_RENDER_REPORT" ]] || fail "missing executable single-render report: $SINGLE_RENDER_REPORT"
[[ -x "$DASHBOARD_REPORT" ]] || fail "missing executable dashboard report: $DASHBOARD_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing lean contract Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing lean contract architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the gate recursion lean contract report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$COST_REPORT" >"$tmpdir/cost.json" || fail "failed to render gate recursion cost report"
jq -e . "$tmpdir/cost.json" >/dev/null || fail "gate recursion cost report did not render valid JSON"

lib_export_present=false
if grep -q 'hepta_systems_gate_recursion_lean_contract_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

recovery_receipt_local_uses_source_report=false
if grep -q 'REPORT=' "$RECOVERY_RECEIPT_LOCAL_GATE" \
  && grep -q '"$REPORT" | jq' "$RECOVERY_RECEIPT_LOCAL_GATE" \
  && ! grep -q 'SOURCE_GATE=' "$RECOVERY_RECEIPT_LOCAL_GATE" \
  && ! grep -q '"$SOURCE_GATE"' "$RECOVERY_RECEIPT_LOCAL_GATE"; then
  recovery_receipt_local_uses_source_report=true
fi

recovery_window_feature_uses_source_gate=false
if grep -q 'SOURCE_GATE=' "$RECOVERY_WINDOW_FEATURE_GATE" \
  && grep -q '"$SOURCE_GATE"' "$RECOVERY_WINDOW_FEATURE_GATE"; then
  recovery_window_feature_uses_source_gate=true
fi

single_render_matrix_once=false
if grep -q '"$MATRIX_REPORT" >"$tmpdir/matrix.json"' "$SINGLE_RENDER_REPORT"; then
  single_render_matrix_once=true
fi

dashboard_uses_single_render=false
if grep -q 'SINGLE_RENDER_REPORT=' "$DASHBOARD_REPORT" \
  && ! grep -q 'MATRIX_REPORT=' "$DASHBOARD_REPORT"; then
  dashboard_uses_single_render=true
fi

jq -n \
  --slurpfile cost "$tmpdir/cost.json" \
  --argjson lib_export_present "$lib_export_present" \
  --argjson recovery_receipt_local_uses_source_report "$recovery_receipt_local_uses_source_report" \
  --argjson recovery_window_feature_uses_source_gate "$recovery_window_feature_uses_source_gate" \
  --argjson workgraph_legacy_gate_present true \
  --argjson single_render_matrix_once "$single_render_matrix_once" \
  --argjson dashboard_uses_single_render "$dashboard_uses_single_render" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-gate-recursion-lean-contract-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_GATE_RECURSION_LEAN_CONTRACT_READBACK_2026-06-30.md" \
  '
  def entry($id; $area; $route; $state; $contract; $source_smoke; $targeted; $legacy_inventory; $current_full_chain; $observed): {
    entry_id:$id,
    contract_area:$area,
    source_route:$route,
    current_cost_state:$state,
    required_contract:$contract,
    projected_in_memory:true,
    source_report_smoke_required:$source_smoke,
    targeted_rust_test_required:$targeted,
    legacy_recursion_inventory_required:$legacy_inventory,
    current_full_upstream_gate_chain_invoked:$current_full_chain,
    contract_full_upstream_gate_chain_allowed:false,
    downstream_direct_matrix_render_required:false,
    observed_contract_ready:$observed,
    matrix_cache_written:false,
    compact_cache_persisted:false,
    source_report_semantics_changed:false,
    cargo_test_executed_by_report:false,
    workflow_execution_started:false,
    replay_executed:false,
    event_log_written:false,
    sqlite_written:false,
    live_execution_started:false
  };
  ($cost[0]) as $cost_report |
  [
    entry(
      "recovery_receipt_local_source_report_contract";
      "source_report_invariant_smoke";
      "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-temporal-lite-replay-alignment-recovery-receipt-local-persistence-readback.gate";
      "bounded_to_source_report_invariants_and_targeted_rust_test";
      "source report smoke plus one targeted Rust test; no upstream source-gate recursion";
      true;
      true;
      false;
      false;
      $recovery_receipt_local_uses_source_report
    ),
    entry(
      "legacy_recovery_window_feature_gate_inventory";
      "legacy_source_gate_recursion_inventory";
      "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-temporal-lite-replay-alignment-recovery-window-feature-gated-readback.gate";
      "legacy_gate_still_invokes_upstream_source_gate_chain";
      "inventory and migrate to source report smoke plus targeted Rust test";
      false;
      false;
      true;
      $recovery_window_feature_uses_source_gate;
      $recovery_window_feature_uses_source_gate
    ),
    entry(
      "legacy_workgraph_closeout_receipt_chain_inventory";
      "legacy_source_gate_recursion_inventory";
      "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-work-graph-events-event-store-cutover-terminal-no-cutover-receipt-acknowledgement-replay-idempotency-closeout-rerun-preview.gate";
      "legacy_workgraph_gate_chain_risk_remains_visible";
      "inventory before another WorkGraph suffix or closeout rerun path is added";
      false;
      false;
      true;
      true;
      $workgraph_legacy_gate_present
    ),
    entry(
      "matrix_single_render_contract";
      "matrix_report_single_render_contract";
      "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-matrix-report-single-render-cache-boundary-readback.gate";
      "single_matrix_render_contract_ready_without_cache_write";
      "consume one source matrix render and keep downstream direct renders removed";
      true;
      true;
      false;
      false;
      $single_render_matrix_once
    ),
    entry(
      "controlled_live_dashboard_single_render_contract";
      "dashboard_single_render_contract";
      "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-readiness-dashboard.gate";
      "dashboard_consumes_single_render_boundary_without_matrix_rerun";
      "validate dashboard from source reports and targeted Rust tests only";
      true;
      true;
      false;
      false;
      $dashboard_uses_single_render
    )
  ] as $entries |
  ($entries | length) as $contract_entry_count |
  ($entries | map(select(.source_report_smoke_required == true)) | length) as $source_report_smoke_contract_count |
  ($entries | map(select(.targeted_rust_test_required == true)) | length) as $targeted_rust_test_contract_count |
  ($entries | map(select(.legacy_recursion_inventory_required == true)) | length) as $legacy_recursion_inventory_count |
  ($entries | map(select(.current_full_upstream_gate_chain_invoked == true)) | length) as $current_full_upstream_gate_chain_count |
  ($entries | map(select(.contract_full_upstream_gate_chain_allowed == true)) | length) as $contract_full_upstream_gate_chain_allowed_count |
  ($cost_report.gate_recursion_cost_boundary_readback_ready == true
    and $cost_report.boundary_projection_count == 4
    and $lib_export_present == true
    and $contract_entry_count == 5
    and $source_report_smoke_contract_count == 3
    and $targeted_rust_test_contract_count == 3
    and $legacy_recursion_inventory_count == 2
    and $current_full_upstream_gate_chain_count == 2
    and $contract_full_upstream_gate_chain_allowed_count == 0
    and ($entries | all(.projected_in_memory == true
      and .observed_contract_ready == true
      and .contract_full_upstream_gate_chain_allowed == false
      and .downstream_direct_matrix_render_required == false
      and .matrix_cache_written == false
      and .compact_cache_persisted == false
      and .source_report_semantics_changed == false
      and .cargo_test_executed_by_report == false
      and .workflow_execution_started == false
      and .replay_executed == false
      and .event_log_written == false
      and .sqlite_written == false
      and .live_execution_started == false))) as $ready |
  {
    runtime:"hepta",
    surface:"hepta_systems_gate_recursion_lean_contract_readback",
    status:(if $ready then "ready_blocked" else "blocked" end),
    gate:"hepta_systems_gate_recursion_lean_contract_readback_gate",
    schema_version:"hepta_systems_gate_recursion_lean_contract_readback_v1",
    source_cost_boundary_ready:$cost_report.gate_recursion_cost_boundary_readback_ready,
    source_cost_boundary_projection_count:$cost_report.boundary_projection_count,
    lib_export_present:$lib_export_present,
    recovery_receipt_local_uses_source_report:$recovery_receipt_local_uses_source_report,
    recovery_window_feature_uses_source_gate:$recovery_window_feature_uses_source_gate,
    workgraph_legacy_gate_present:$workgraph_legacy_gate_present,
    single_render_matrix_once:$single_render_matrix_once,
    dashboard_uses_single_render:$dashboard_uses_single_render,
    contract_scope:"source_report_smoke_plus_targeted_test_no_recursive_source_gate_chain",
    contract_entry_count:$contract_entry_count,
    source_report_smoke_contract_count:$source_report_smoke_contract_count,
    targeted_rust_test_contract_count:$targeted_rust_test_contract_count,
    legacy_recursion_inventory_count:$legacy_recursion_inventory_count,
    current_full_upstream_gate_chain_count:$current_full_upstream_gate_chain_count,
    contract_full_upstream_gate_chain_allowed_count:$contract_full_upstream_gate_chain_allowed_count,
    matrix_cache_write_allowed:false,
    compact_cache_persistence_allowed:false,
    source_report_semantics_change_allowed:false,
    workflow_execution_allowed:false,
    replay_execution_allowed:false,
    event_log_write_allowed:false,
    sqlite_write_allowed:false,
    live_execution_allowed:false,
    lean_contract_readback_ready:$ready,
    entries:$entries,
    blockers:[
      "recursive_source_gate_chain_disabled_for_new_gates",
      "legacy_recursive_source_gate_inventory_required",
      "matrix_cache_write_disabled",
      "compact_cache_persistence_disabled",
      "source_report_semantics_change_disabled",
      "workflow_execution_disabled",
      "replay_execution_disabled",
      "event_log_write_disabled",
      "sqlite_write_disabled",
      "live_execution_disabled"
    ],
    next_actions:[
      "hepta_systems_workgraph_legacy_gate_recursion_inventory_readback"
    ],
    recommended_next_gate:"hepta_systems_workgraph_legacy_gate_recursion_inventory_readback",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      filesystem_written:false,
      matrix_cache_written:false,
      compact_cache_persisted:false,
      source_report_semantics_changed:false,
      full_upstream_gate_chain_invoked:false,
      cargo_test_executed_by_report:false,
      workflow_execution_started:false,
      replay_executed:false,
      event_log_written:false,
      sqlite_written:false,
      provider_invoked:false,
      model_invoked:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      channel_send_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }'
