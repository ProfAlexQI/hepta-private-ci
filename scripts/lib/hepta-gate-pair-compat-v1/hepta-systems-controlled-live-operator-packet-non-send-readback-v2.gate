#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)}"
export HEPTA_REPO_ROOT="$ROOT"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-non-send-readback-v2.report"
PACKET_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-preview-v2.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_OPERATOR_PACKET_NON_SEND_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-operator-packet-non-send-readback-v2-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 5c v2 report: $REPORT"
[[ -x "$PACKET_GATE" ]] || fail "missing executable Phase 5b v2 packet gate: $PACKET_GATE"
[[ -f "$DOC" ]] || fail "missing Phase 5c architecture note: $DOC"
command -v jq >/dev/null 2>&1 || fail "jq is required to validate the Phase 5c v2 report"

grep -q 'Controlled Live Operator Packet Non-Send Readback' "$DOC" || fail "architecture note must document the non-send readback"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_operator_packet_non_send_readback"
  and .status == "ready_blocked"
  and .schema_version == "controlled_live_operator_packet_non_send_readback_v2"
  and .compatibility_migration == "clean_worktree_boundary_v2_propagation"
  and .source_operator_packet_preview_ready == true
  and .source_blocker_readback_count == 7
  and .stable_blocker_slot_count == 7
  and .lib_export_present == true
  and .readback_entry_count == 6
  and .readback_ready_count == 6
  and .packet_visible_to_operator == true
  and .packet_send_attempted == false
  and .approval_request_ready == false
  and .approval_request_sent == false
  and .approval_recorded == false
  and .packet_persisted == false
  and .readback_persisted == false
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and .non_send_readback_ready == true
  and ((.source_worktree_boundary_state == "clean"
      and .source_dirty_worktree_boundary_tracked == false
      and .source_blocker_count == 6
      and .source_active_blocker_count == 6
      and .source_satisfied_entry_count == 1)
    or (.source_worktree_boundary_state == "dirty"
      and .source_dirty_worktree_boundary_tracked == true
      and .source_blocker_count == 7
      and .source_active_blocker_count == 7
      and .source_satisfied_entry_count == 0))
  and (.entries | length) == 6
  and (.entries | all(.operator_visible == true and .non_send_confirmed == true and .persistence_blocked == true and .approval_request_blocked == true and .live_mutation_allowed == false))
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$PACKET_GATE" >/dev/null

printf 'hepta-systems-controlled-live-operator-packet-non-send-readback-v2-gate: PASS: dynamic blocker semantics remain visible while the packet stays unsent and unpersisted\n'
