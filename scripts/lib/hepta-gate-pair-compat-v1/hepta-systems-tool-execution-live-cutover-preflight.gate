#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-live-cutover-preflight.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-result-acceptance-preflight.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_LIVE_CUTOVER_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-live-cutover-preflight-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution live cutover preflight report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable execution canary result acceptance preflight gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution live cutover preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution live cutover preflight report"
fi

grep -q 'Live Cutover Preflight' "$DOC" \
  || fail "architecture note must document Live Cutover Preflight"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'blocker matrix' "$DOC" \
  || fail "architecture note must document blocker matrix"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_live_cutover_preflight"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_acceptance_preflight_surface == "tool_execution_canary_result_acceptance_preflight"
  and .source_acceptance_preflight_ready == true
  and .source_canary_result_acceptance_allowed == false
  and .source_live_cutover_allowed == false
  and .operator_identity_binding_present == true
  and .explicit_live_cutover_approval_present == false
  and .rollback_anchor_present == true
  and .kill_switch_present == true
  and .observability_readback_required == true
  and .live_cutover_switch_enabled == false
  and .adapter_dispatch_switch_enabled == false
  and .tool_invocation_execution_switch_enabled == false
  and .live_cutover_started == false
  and .live_cutover_acceptance_record_written == false
  and .result_receipt_written == false
  and .candidate_count == 2
  and .live_cutover_preflight_ready_count == 2
  and .live_cutover_preflight_blocked_count == 0
  and .explicit_live_cutover_approval_required_count == 1
  and .explicit_live_cutover_approval_missing_count == 1
  and .rollback_anchor_present_count == 2
  and .kill_switch_present_count == 2
  and .observability_readback_required_count == 2
  and .selected_status_canary_count == 1
  and .preflight_only_non_selected_count == 1
  and .all_acceptance_preflight_entries_bound_to_live_cutover_preflight == true
  and .all_live_cutover_entries_keep_no_invocation_guard == true
  and .tool_execution_live_cutover_preflight_ready == true
  and .tool_execution_live_cutover_allowed == false
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .execution_adapter_dispatched == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_live_cutover_operator_packet_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .selected_for_status_canary == true and .preflight_only_non_selected_candidate == false and .source_acceptance_preflight_route == "canary_result_acceptance_pending_evidence" and .registry_guard_route == "require_approval_ledger" and .live_cutover_preflight_route == "live_cutover_preflight_ready_pending_approval" and .live_cutover_preflight_ready == true and .explicit_live_cutover_approval_required == true and .explicit_live_cutover_approval_present == false and .live_cutover_blocked == true and .rollback_anchor_present == true and .kill_switch_present == true and .observability_readback_required == true and .live_cutover_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_execution_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .selected_for_status_canary == false and .preflight_only_non_selected_candidate == true and .source_acceptance_preflight_route == "preflight_only_non_selected_candidate" and .registry_guard_route == "require_approval_ledger" and .live_cutover_preflight_route == "preflight_only_non_selected_candidate" and .live_cutover_preflight_ready == true and .explicit_live_cutover_approval_required == false and .explicit_live_cutover_approval_present == false and .live_cutover_blocked == false and .rollback_anchor_present == true and .kill_switch_present == true and .observability_readback_required == true and .live_cutover_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_execution_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("explicit_live_cutover_approval_missing")) != null
  and (.blockers | index("tool_invocation_execution_switch_disabled")) != null
  and (.next_actions | index("restore_tool_execution_live_cutover_operator_packet_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_live_cutover_preflight --quiet
)

printf 'hepta-systems-tool-execution-live-cutover-preflight-gate: PASS: live cutover blocker matrix is ready while dispatch, invocation, and mutation stay disabled\n'
