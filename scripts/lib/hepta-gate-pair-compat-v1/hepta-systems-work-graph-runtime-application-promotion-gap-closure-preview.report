#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/hepta-runtime-application-promotion-closure.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

capture_json_report \
  "hepta-work-graph-unified-projection-enforcement-readiness-append-only-store-runtime-rerun-preview-report" \
  "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-append-only-store-runtime-rerun-preview.report" \
  >"$tmpdir/runtime_rerun.json"

promotion_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_runtime_application_promotion_gap_closure_preview.rs
)"
promotion_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-runtime-application-promotion-gap-closure-preview.report
)"
promotion_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-runtime-application-promotion-gap-closure-preview.gate
)"
runtime_rerun_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-append-only-store-runtime-rerun-preview.gate
)"

jq -n \
  --slurpfile rerun "$tmpdir/runtime_rerun.json" \
  --argjson promotion_rust_module_present "$promotion_rust_module_present" \
  --argjson promotion_report_script_present "$promotion_report_script_present" \
  --argjson promotion_gate_script_present "$promotion_gate_script_present" \
  --argjson runtime_rerun_gate_script_present "$runtime_rerun_gate_script_present" \
  '
  $rerun[0] as $rerun
  | def unique_order: reduce .[] as $item ([]; if index($item) then . else . + [$item] end);
  def evidence_fields: [
      "source_surface_id",
      "runtime_application_domain_ids",
      "runtime_rerun_enforcement_decision",
      "residual_source_blocker_ids",
      "promotion_binding_ids",
      "readback_probe_id",
      "operator_review_gate_ref",
      "side_effect_lock_ref"
    ];
  def domains: [
      {
        id: "projection_adapter_runtime_closure",
        blocker_id: "projection_adapter_runtime_closure_application_disabled",
        priority: "p0"
      },
      {
        id: "store_guard_runtime_application",
        blocker_id: "store_guard_runtime_application_disabled",
        priority: "p0"
      },
      {
        id: "terminal_task_result_runtime_wrapper",
        blocker_id: "terminal_task_result_runtime_application_disabled",
        priority: "p0"
      },
      {
        id: "scheduler_admission_runtime_application",
        blocker_id: "scheduler_admission_runtime_application_disabled",
        priority: "p1"
      },
      {
        id: "role_manifest_runtime_application",
        blocker_id: "role_manifest_runtime_application_disabled",
        priority: "p1"
      }
    ];
  def domain_ids_for($decision):
      [domains[] as $domain
        | select($decision.residual_source_blocker_ids | index($domain.blocker_id))
        | $domain.id];
  def binding_id($source; $domain):
      "runtime_application_promotion_binding__" + $source + "__" + $domain;
  def plan_id($source):
      "runtime_application_promotion_closure_plan__" + $source;
  def readback_probe_id($source):
      "runtime_application_promotion_readback_probe__" + $source;
  def group_id($domain):
      if $domain == "projection_adapter_runtime_closure" then "projection_adapter_runtime_closure_promotion_group"
      elif $domain == "store_guard_runtime_application" then "store_guard_runtime_application_promotion_group"
      elif $domain == "terminal_task_result_runtime_wrapper" then "terminal_task_result_runtime_wrapper_promotion_group"
      elif $domain == "scheduler_admission_runtime_application" then "scheduler_admission_runtime_application_promotion_group"
      elif $domain == "role_manifest_runtime_application" then "role_manifest_runtime_application_promotion_group"
      else "runtime_application_promotion_group"
      end;
  def blocked_domains_for($blocker_id):
      ([domains[]
        | select(
            .blocker_id == $blocker_id
            or $blocker_id == "runtime_application_residuals_not_promoted"
            or $blocker_id == "readback_execution_disabled"
            or $blocker_id == "durable_store_runtime_switch_disabled"
            or $blocker_id == "wal_write_boundary_not_enabled"
            or $blocker_id == "idempotency_index_mutation_disabled"
            or $blocker_id == "rollback_readback_not_executed"
            or $blocker_id == "operator_review_required"
          )
        | .id]) as $domain_ids
      | if ($domain_ids | length) == 0 then ["runtime_application_promotion"] else $domain_ids end;
  def guard($id; $severity; $scope): {
      id: $id,
      severity: $severity,
      scope: $scope,
      enforced_in_preview: true,
      prevents_runtime_mutation: true,
      note: "preview records contracts only and does not promote runtime application"
    };
  def plan($decision):
      (domain_ids_for($decision)) as $domain_ids
      | {
          closure_plan_id: plan_id($decision.source_surface_id),
          source_surface_id: $decision.source_surface_id,
          source_category: $decision.source_category,
          runtime_rerun_decision: $decision.append_only_store_runtime_rerun_enforcement_decision,
          promotion_domain_ids: $domain_ids,
          promotion_binding_ids: ($domain_ids | map(binding_id($decision.source_surface_id; .))),
          readback_probe_id: readback_probe_id($decision.source_surface_id),
          evidence_field_ids: evidence_fields,
          residual_source_blocker_ids: $decision.residual_source_blocker_ids,
          expected_post_closure_state: "runtime_application_promotion_contract_ready_preview_after_application",
          closure_scope: "runtime_application_promotion_gap_closure",
          closure_state: "readback_pending_no_mutation",
          ready_for_readback_preview: true,
          applies_to_runtime: false,
          promotes_runtime_application: false,
          attaches_runtime_wrapper: false,
          enforces_scheduler_admission: false,
          enforces_role_manifest: false,
          mutates_store: false,
          writes_wal: false,
          records_approval: false
        };
  def binding($decision; $domain): {
      id: binding_id($decision.source_surface_id; $domain.id),
      source_surface_id: $decision.source_surface_id,
      source_category: $decision.source_category,
      promotion_domain_id: $domain.id,
      closes_blocker_id: $domain.blocker_id,
      required_evidence_field_ids: evidence_fields,
      binding_state: "readback_pending_no_mutation",
      applies_to_runtime: false,
      promotes_runtime_application: false,
      writes_store: false
    };
  def group($domain; $decisions):
      ($decisions | map(select(.residual_source_blocker_ids | index($domain.blocker_id)) | .source_surface_id)) as $sources
      | {
          id: group_id($domain.id),
          priority: $domain.priority,
          promotion_domain_id: $domain.id,
          closure_plan_ids: ($sources | map(plan_id(.))),
          promotion_binding_ids: ($sources | map(binding_id(. ; $domain.id))),
          affected_source_surface_ids: $sources,
          expected_contract_count_after_closure: ($sources | length),
          promotes_runtime_application: false
        };
  ($rerun.decision_deltas | map(select((domain_ids_for(.) | length) > 0))) as $closure_decisions
  | ($closure_decisions | map(plan(.))) as $plans
  | ($closure_decisions
      | map(. as $decision
          | domains[] as $domain
          | select($decision.residual_source_blocker_ids | index($domain.blocker_id))
          | binding($decision; $domain))) as $bindings
  | (domains | map(group(. ; $closure_decisions))) as $groups
  | ([
      guard("runtime_application_promotion_closure_preview_only"; "critical"; "closure"),
      guard("runtime_application_promotion_disabled"; "critical"; "runtime_application"),
      guard("readback_execution_disabled"; "critical"; "readback"),
      guard("wal_write_boundary_disabled"; "critical"; "wal"),
      guard("durable_store_runtime_switch_disabled"; "critical"; "store"),
      guard("idempotency_mutation_disabled"; "critical"; "idempotency"),
      guard("rollback_readback_execution_disabled"; "critical"; "rollback"),
      guard("task_result_persistence_disabled"; "high"; "task_result"),
      guard("scheduler_admission_runtime_enforcement_disabled"; "high"; "scheduler"),
      guard("role_manifest_runtime_enforcement_disabled"; "high"; "role_manifest"),
      guard("operator_review_bypass_disabled"; "high"; "operator_review")
    ]) as $guards
  | (($rerun.residual_blockers | map({
      id,
      severity,
      affected_source_surface_ids,
      blocked_promotion_domain_ids: blocked_domains_for(.id),
      required_before_runtime_application_promotion: true,
      recommended_fix
    })) + [{
      id: "runtime_application_promotion_readback_missing",
      severity: "high",
      affected_source_surface_ids: ($closure_decisions | map(.source_surface_id)),
      blocked_promotion_domain_ids: (domains | map(.id)),
      required_before_runtime_application_promotion: true,
      recommended_fix: "read back every runtime application promotion closure plan before application preview"
    }]) as $blockers
  | ($rerun.required_prior_gates + [$rerun.gate]) as $required_prior_gates
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "blocked",
      gate: "hepta_work_graph_runtime_application_promotion_gap_closure_preview_gate",
      schema_version: "work_graph_runtime_application_promotion_gap_closure_preview_v1",
      preview_mode: "read_only_runtime_application_promotion_gap_closure_no_enforcement",
      upstream_runtime_rerun_gate: "hepta_work_graph_unified_projection_enforcement_readiness_append_only_store_runtime_rerun_preview_gate",
      runtime_application_primary_residual_source_count: ($rerun.decision_deltas | map(select(.residual_source_blocker_ids | index("runtime_application_residuals_not_promoted"))) | length),
      runtime_application_closure_source_count: ($closure_decisions | length),
      operator_review_decision_source_count: ($rerun.decision_deltas | map(select(.append_only_store_runtime_rerun_enforcement_decision == "deny_operator_review_required")) | length),
      promotion_plan_count: ($plans | length),
      promotion_domain_count: (domains | length),
      promotion_binding_count: ($bindings | length),
      readback_probe_binding_count: ($plans | length),
      evidence_field_ref_count: ($plans | map(.evidence_field_ids | length) | add),
      promotion_group_count: ($groups | length),
      guard_count: ($guards | length),
      blocker_count: ($blockers | length),
      required_prior_gate_count: ($required_prior_gates | length),
      promotion_plans: $plans,
      promotion_bindings: $bindings,
      promotion_groups: $groups,
      guards: $guards,
      blockers: $blockers,
      required_prior_gates: $required_prior_gates,
      recommended_next_gate: "hepta_work_graph_runtime_application_promotion_gap_closure_readback_preview_gate",
      ready_for_runtime_application_promotion_readback_preview: true,
      ready_for_runtime_application_promotion_application_preview: false,
      ready_for_runtime_application_promotion: false,
      ready_for_operator_review_side_effect_lock: false,
      ready_for_append_only_store_enablement: false,
      ready_for_projection_enforcement: false,
      ready_for_live_execution: false,
      source_probes: {
        runtime_application_promotion_gap_closure: {
          rust_module_present: $promotion_rust_module_present,
          report_script_present: $promotion_report_script_present,
          gate_script_present: $promotion_gate_script_present
        },
        upstream_runtime_rerun: {
          upstream_gate: ($rerun.gate == "hepta_work_graph_unified_projection_enforcement_readiness_append_only_store_runtime_rerun_preview_gate"),
          gate_script_present: $runtime_rerun_gate_script_present,
          recommended_next_matches: ($rerun.recommended_next_gate == "hepta_work_graph_runtime_application_promotion_gap_closure_preview_gate")
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        wal_written: false,
        checkpoint_written: false,
        durable_store_switch_enabled: false,
        idempotency_index_mutated: false,
        append_only_store_enabled: false,
        runtime_application_promoted: false,
        runtime_wrapper_attached: false,
        scheduler_admission_enforced: false,
        role_manifest_enforced: false,
        task_result_enforcement_enabled: false,
        task_result_persisted: false,
        readback_executed: false,
        rollback_executed: false,
        approval_recorded: false,
        operator_review_recorded: false,
        runtime_mutation_performed: false,
        agent_spawn_performed: false,
        external_send_performed: false,
        model_invoked: false
      }
    }
  '
