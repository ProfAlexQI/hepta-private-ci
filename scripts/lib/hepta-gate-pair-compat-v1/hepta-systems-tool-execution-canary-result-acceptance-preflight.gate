#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-result-acceptance-preflight.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-readback-receipt-projection.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_CANARY_RESULT_ACCEPTANCE_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-canary-result-acceptance-preflight-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution canary result acceptance preflight report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable execution canary readback receipt projection gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution canary result acceptance preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution canary result acceptance preflight report"
fi

grep -q 'Canary Result Acceptance Preflight' "$DOC" \
  || fail "architecture note must document Canary Result Acceptance Preflight"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'pending evidence' "$DOC" \
  || fail "architecture note must document pending evidence"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_canary_result_acceptance_preflight"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_readback_projection_surface == "tool_execution_canary_readback_receipt_projection"
  and .source_readback_projection_ready == true
  and .source_canary_result_receipt_write_allowed == false
  and .source_canary_result_acceptance_allowed == false
  and .source_live_cutover_allowed == false
  and .canary_result_acceptance_policy_present == true
  and .operator_identity_binding_present == true
  and .canary_result_receipt_present == false
  and .canary_readback_evidence_present == false
  and .operator_canary_result_acceptance_present == false
  and .canary_acceptance_record_written == false
  and .canary_acceptance_receipt_written == false
  and .live_cutover_switch_enabled == false
  and .candidate_count == 2
  and .canary_result_acceptance_preflight_ready_count == 2
  and .canary_result_acceptance_preflight_blocked_count == 0
  and .canary_result_acceptance_pending_evidence_count == 1
  and .canary_result_receipt_required_count == 1
  and .canary_readback_evidence_required_count == 1
  and .canary_acceptance_record_write_blocked_count == 1
  and .canary_acceptance_receipt_write_blocked_count == 1
  and .selected_status_canary_count == 1
  and .preflight_only_non_selected_count == 1
  and .all_readback_projections_bound_to_acceptance_preflight == true
  and .all_acceptance_preflight_entries_keep_no_invocation_guard == true
  and .tool_execution_canary_result_acceptance_preflight_ready == true
  and .tool_execution_canary_result_acceptance_allowed == false
  and .tool_execution_live_cutover_allowed == false
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .execution_adapter_dispatched == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_live_cutover_preflight_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .selected_for_status_canary == true and .preflight_only_non_selected_candidate == false and .source_readback_projection_route == "canary_readback_receipt_projection_ready" and .registry_guard_route == "require_approval_ledger" and .canary_result_acceptance_preflight_route == "canary_result_acceptance_pending_evidence" and .canary_result_acceptance_preflight_ready == true and .canary_result_acceptance_pending_evidence == true and .canary_result_receipt_required == true and .canary_readback_evidence_required == true and .canary_acceptance_record_write_blocked == true and .canary_acceptance_receipt_write_blocked == true and .canary_result_receipt_present == false and .canary_readback_evidence_present == false and .operator_canary_result_acceptance_present == false and .canary_acceptance_record_written == false and .canary_acceptance_receipt_written == false and .live_cutover_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .selected_for_status_canary == false and .preflight_only_non_selected_candidate == true and .source_readback_projection_route == "preflight_only_non_selected_candidate" and .registry_guard_route == "require_approval_ledger" and .canary_result_acceptance_preflight_route == "preflight_only_non_selected_candidate" and .canary_result_acceptance_preflight_ready == true and .canary_result_acceptance_pending_evidence == false and .canary_result_receipt_required == false and .canary_readback_evidence_required == false and .canary_acceptance_record_write_blocked == false and .canary_acceptance_receipt_write_blocked == false and .canary_result_receipt_present == false and .canary_readback_evidence_present == false and .operator_canary_result_acceptance_present == false and .canary_acceptance_record_written == false and .canary_acceptance_receipt_written == false and .live_cutover_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("canary_result_receipt_absent")) != null
  and (.blockers | index("operator_canary_result_acceptance_absent")) != null
  and (.next_actions | index("restore_tool_execution_live_cutover_preflight_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_canary_result_acceptance_preflight --quiet
)

printf 'hepta-systems-tool-execution-canary-result-acceptance-preflight-gate: PASS: canary result acceptance remains pending evidence while live cutover and invocation stay disabled\n'
