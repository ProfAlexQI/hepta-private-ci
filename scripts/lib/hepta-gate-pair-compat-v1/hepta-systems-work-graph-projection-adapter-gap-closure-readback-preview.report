#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/hepta-projection-gap-closure-readback.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

capture_json_report \
  "hepta-work-graph-projection-adapter-gap-closure-preview-report" \
  "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-preview.report" \
  >"$tmpdir/gap_closure.json"

readback_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_projection_adapter_gap_closure_readback_preview.rs
)"
readback_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-readback-preview.report
)"
readback_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-readback-preview.gate
)"
gap_closure_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_projection_adapter_gap_closure_preview.rs
)"
gap_closure_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-preview.gate
)"

jq -n \
  --slurpfile closure "$tmpdir/gap_closure.json" \
  --argjson readback_rust_module_present "$readback_rust_module_present" \
  --argjson readback_report_script_present "$readback_report_script_present" \
  --argjson readback_gate_script_present "$readback_gate_script_present" \
  --argjson gap_closure_rust_module_present "$gap_closure_rust_module_present" \
  --argjson gap_closure_gate_script_present "$gap_closure_gate_script_present" \
  '
  $closure[0] as $closure
  | def readback_scope($kind):
      if $kind == "adapter_projection_fixture" then "fixture_catalog_shape"
      elif $kind == "unified_store_projection" then "unified_store_collection_shape"
      elif $kind == "observability_timeline_projection" then "timeline_event_shape"
      elif $kind == "task_result_projection" then "task_result_terminal_shape"
      else "adapter_projection_shape"
      end;
  def redaction_policy($source):
      if $source == "update_plan_tool" or $source == "plan_mode_proposed_plan_blocks" then "hash proposed plan text and expose only trace, step, node, and evidence refs"
      elif $source == "app_server_turn_plan_notification" then "hash notification payload and expose only trace, turn, and notification refs"
      elif $source == "multi_agent_v2_mailbox_wait" then "hash mailbox content and expose only trace, agent path, mailbox seq, and delivery refs"
      elif $source == "hepta_runtime_multi_agent_reducer" then "hash subagent output and expose only task result status, reducer strategy, and evidence refs"
      elif $source == "hepta_runtime_task_board" then "hash worker commands and artifacts; expose only lane, lease, status, and artifact refs"
      elif $source == "hepta_runtime_approval_broker" then "hash approval payload and expose only approver role, decision state, and evidence refs"
      else "hash raw payloads and expose only redacted evidence refs"
      end;
  def plan($action): {
      closure_action_id: $action.id,
      source_surface_id: $action.source_surface_id,
      adapter_kind: $action.adapter_kind,
      readback_scope: readback_scope($action.adapter_kind),
      expected_projected_collection_ids: $action.projected_collection_ids,
      expected_timeline_event_type_ids: $action.timeline_event_type_ids,
      required_evidence_fields: $action.required_evidence_fields,
      required_before_closure_application: true,
      readback_state: "preview_readback_defined_not_executed",
      performs_readback: false,
      mutates_runtime: false
    };
  def fixture_assertion($action): {
      closure_action_id: $action.id,
      source_surface_id: $action.source_surface_id,
      required_fixture_fields: $action.required_evidence_fields,
      expected_fixture_state: "fixture_shape_defined_runtime_not_attached",
      redaction_policy: redaction_policy($action.source_surface_id),
      performs_readback: false,
      mutates_fixture: false
    };
  def store_assertion($action): {
      closure_action_id: $action.id,
      source_surface_id: $action.source_surface_id,
      projected_collection_ids: $action.projected_collection_ids,
      required_evidence_fields: $action.required_evidence_fields,
      idempotency_guard_required: true,
      expected_projection_state: "store_projection_shape_defined_store_write_disabled",
      performs_readback: false,
      mutates_store: false
    };
  def timeline_assertion($action): {
      closure_action_id: $action.id,
      source_surface_id: $action.source_surface_id,
      timeline_event_type_ids: $action.timeline_event_type_ids,
      required_evidence_fields: $action.required_evidence_fields,
      redaction_policy: redaction_policy($action.source_surface_id),
      expected_event_state: "timeline_event_shape_defined_timeline_persistence_disabled",
      performs_readback: false,
      persists_timeline: false
    };
  def drift($id; $fields; $severity): {
      id: $id,
      compared_field_ids: $fields,
      severity: $severity,
      blocks_closure_application: true,
      performs_readback: false
    };
  def blocker($id; $severity; $affected; $fix): {
      id: $id,
      severity: $severity,
      affected_closure_action_ids: $affected,
      required_before_projection_enforcement: true,
      recommended_fix: $fix
    };
  ($closure.closure_actions | map(plan(.))) as $readback_plans
  | ($closure.closure_actions | map(select(.adapter_kind == "adapter_projection_fixture") | fixture_assertion(.))) as $fixture_assertions
  | ($closure.closure_actions | map(select(.adapter_kind == "unified_store_projection") | store_assertion(.))) as $store_assertions
  | ($closure.closure_actions | map(select(.adapter_kind == "observability_timeline_projection") | timeline_assertion(.))) as $timeline_assertions
  | [
      drift("detect_closure_action_source_drift"; ["closure_action_id", "source_surface_id", "adapter_kind"]; "critical"),
      drift("detect_store_projection_collection_drift"; ["projected_collection_ids", "required_evidence_fields"]; "critical"),
      drift("detect_timeline_event_type_drift"; ["timeline_event_type_ids", "eventKind", "evidenceRefs"]; "critical"),
      drift("detect_fixture_redaction_drift"; ["fixtureHash", "redactionState", "sourceSurfaceId"]; "high"),
      drift("detect_closure_plan_coverage_drift"; ["closure_plan_id", "closure_action_ids", "required_prior_gates"]; "high")
    ] as $drift_detectors
  | [
      blocker("gap_closure_readback_is_preview_only"; "medium"; ($closure.closure_actions | map(.id)); "keep closure readback as contract-only until adapter fixtures and store/timeline mappings are materialized"),
      blocker("adapter_fixture_readback_not_executed"; "high"; ($fixture_assertions | map(.closure_action_id)); "run fixture readback against deterministic source fixtures before closure application"),
      blocker("unified_store_projection_readback_not_executed"; "high"; ($store_assertions | map(.closure_action_id)); "verify projected collection hashes before enabling append-only store projection"),
      blocker("timeline_projection_readback_not_executed"; "high"; ($timeline_assertions | map(.closure_action_id)); "verify redacted timeline event shapes before enabling timeline persistence"),
      blocker("closure_application_preview_not_run"; "high"; ($closure.closure_actions | map(.id)); "run the closure application preview before rerunning enforcement readiness"),
      blocker("post_readback_enforcement_readiness_not_rerun"; "medium"; ($closure.closure_actions | map(.id)); "rerun unified projection enforcement-readiness after readback and application previews agree")
    ] as $blockers
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_projection_adapter_gap_closure_readback_preview_gate",
      schema_version: "work_graph_projection_adapter_gap_closure_readback_preview_v1",
      preview_mode: "read_only_projection_adapter_gap_closure_readback_preview_no_execution",
      source_gap_count: $closure.source_gap_count,
      closure_action_count: $closure.closure_action_count,
      readback_plan_count: ($readback_plans | length),
      fixture_readback_assertion_count: ($fixture_assertions | length),
      store_readback_assertion_count: ($store_assertions | length),
      timeline_readback_assertion_count: ($timeline_assertions | length),
      projected_collection_reference_count: (($store_assertions | map(.projected_collection_ids | length) | add) // 0),
      timeline_event_type_reference_count: (($timeline_assertions | map(.timeline_event_type_ids | length) | add) // 0),
      drift_detector_count: ($drift_detectors | length),
      blocker_count: ($blockers | length),
      required_prior_gate_count: (($closure.required_prior_gates + [$closure.gate]) | length),
      readback_plans: $readback_plans,
      fixture_readback_assertions: $fixture_assertions,
      store_readback_assertions: $store_assertions,
      timeline_readback_assertions: $timeline_assertions,
      drift_detectors: $drift_detectors,
      blockers: $blockers,
      required_prior_gates: ($closure.required_prior_gates + [$closure.gate]),
      recommended_next_gate: "hepta_work_graph_projection_adapter_gap_closure_application_preview_gate",
      ready_for_projection_adapter_gap_closure_application_preview: true,
      ready_for_projection_enforcement: false,
      ready_for_append_only_store_enablement: false,
      ready_for_live_execution: false,
      source_probes: {
        gap_closure_readback: {
          rust_module_present: $readback_rust_module_present,
          report_script_present: $readback_report_script_present,
          gate_script_present: $readback_gate_script_present
        },
        gap_closure_preview: {
          rust_module_present: $gap_closure_rust_module_present,
          gate_script_present: $gap_closure_gate_script_present,
          upstream_gate: ($closure.gate == "hepta_work_graph_projection_adapter_gap_closure_preview_gate")
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        adapter_projection_enforced: false,
        closure_applied_to_runtime: false,
        append_only_store_enabled: false,
        scheduler_admission_enforced: false,
        task_result_enforcement_enabled: false,
        timeline_persisted: false,
        readback_performed: false,
        approval_recorded: false,
        agent_spawn_performed: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
