#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${HEPTA_RECONSTRUCTION_REPO_ROOT:-${HEPTA_REPO_ROOT:-$(cd "$(dirname "$0")/.." && pwd -P)}}"
SESSION_ROOT="${HEPTA_AGENT_SESSION_ROOT:-$HOME/.openclaw/agents/hepta/agent/codex-home/sessions}"
REPO_PREFIX="$REPO_ROOT/"
ANCHOR_ID="${HEPTA_SESSION_PATCH_ANCHOR_ID:-plugin_contribution_point_abi}"
CALL_ID_FILTER="${HEPTA_SESSION_PATCH_CALL_ID:-}"
EXTRACT_LIMIT="${HEPTA_SESSION_PATCH_EXTRACT_LIMIT:-5}"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required for the Hepta selected patch extract report" >&2
  exit 127
fi

if [[ ! "$EXTRACT_LIMIT" =~ ^[0-9]+$ ]]; then
  echo "HEPTA_SESSION_PATCH_EXTRACT_LIMIT must be a non-negative integer" >&2
  exit 2
fi

if [[ ! -d "$SESSION_ROOT" ]]; then
  jq -n \
    --arg runtime "hepta" \
    --arg repo_root "$REPO_ROOT" \
    --arg session_root "$SESSION_ROOT" \
    --arg anchor_id "$ANCHOR_ID" \
    '{
      runtime:$runtime,
      surface:"hepta_systems_session_selected_patch_extract",
      status:"blocked",
      repo_root:$repo_root,
      session_root:$session_root,
      anchor_id:$anchor_id,
      side_effect_free:true,
      report_only:true,
      replay_applied:false,
      blocker:"missing_agent_session_root"
    }'
  exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

calls_jsonl="$tmpdir/calls.jsonl"
: >"$calls_jsonl"

while IFS= read -r -d '' session_file; do
  jq -c \
    --arg repo_prefix "$REPO_PREFIX" \
    --arg session_root "$SESSION_ROOT" \
    '
      def touched_paths($body):
        $body
        | split("\n")
        | map(select(test("^\\*\\*\\* (Add|Update|Delete) File: ")))
        | map(
            sub("^\\*\\*\\* Add File: "; "")
            | sub("^\\*\\*\\* Update File: "; "")
            | sub("^\\*\\*\\* Delete File: "; "")
          )
        | map(select(startswith($repo_prefix)))
        | map(ltrimstr($repo_prefix))
        | unique
        | sort;

      def anchor_ids($paths):
        [
          if any($paths[]; (ascii_downcase | contains("contribution_point_abi")) or (ascii_downcase | contains("plugin-contribution-point"))) then
            "plugin_contribution_point_abi"
          else empty end,
          if any($paths[]; (ascii_downcase | contains("tool_registry_router_lookup_shadow")) or (ascii_downcase | contains("tool-registry-router-lookup-shadow"))) then
            "tool_registry_router_lookup_shadow"
          else empty end,
          if any($paths[]; (ascii_downcase | contains("workflow_durable_store_replay_proof")) or (ascii_downcase | contains("workflow-durable-store-replay-proof")) or (ascii_downcase | contains("durable-store-replay-proof"))) then
            "workflow_durable_store_replay_proof"
          else empty end,
          if any($paths[]; (ascii_downcase | contains("hepta-systems-capability-matrix")) or contains("HEPTA_SYSTEMS_CAPABILITY_MATRIX") or (ascii_downcase | contains("hepta-systems-canonical-gate"))) then
            "compact_capability_matrix"
          else empty end,
          if any($paths[]; (ascii_downcase | contains("work_graph_scheduler")) or (ascii_downcase | contains("work-graph-scheduler")) or (ascii_downcase | contains("scheduler_cutover")) or (ascii_downcase | contains("scheduler-cutover"))) then
            "scheduler_cutover_preview_chain"
          else empty end
        ] | unique | sort;

      select(
        .type == "response_item"
        and .payload.type == "custom_tool_call"
        and .payload.name == "apply_patch"
        and ((.payload.input // "") | contains($repo_prefix))
      )
      | (.payload.input // "") as $body
      | (touched_paths($body)) as $paths
      | {
          timestamp,
          session:(input_filename | ltrimstr($session_root + "/")),
          call_id:.payload.call_id,
          touched_paths:$paths,
          anchor_ids:anchor_ids($paths),
          patch_line_count:($body | split("\n") | length),
          patch_body:$body
        }
    ' "$session_file" >>"$calls_jsonl"
done < <(find "$SESSION_ROOT" -type f -name '*.jsonl' -print0 2>/dev/null)

jq -n \
  --arg runtime "hepta" \
  --arg surface "hepta_systems_session_selected_patch_extract" \
  --arg repo_root "$REPO_ROOT" \
  --arg session_root "$SESSION_ROOT" \
  --arg anchor_id "$ANCHOR_ID" \
  --arg call_id_filter "$CALL_ID_FILTER" \
  --argjson extract_limit "$EXTRACT_LIMIT" \
  --slurpfile calls "$calls_jsonl" \
  '
    (
      $calls
      | sort_by(.timestamp, .session, .call_id)
      | map(select(.anchor_ids | index($anchor_id)))
      | map(select(($call_id_filter == "") or (.call_id == $call_id_filter)))
    ) as $matches
    | {
        runtime:$runtime,
        surface:$surface,
        status:(if ($matches | length) > 0 then "ready" else "blocked" end),
        repo_root:$repo_root,
        session_root:$session_root,
        anchor_id:$anchor_id,
        call_id_filter:(if $call_id_filter == "" then null else $call_id_filter end),
        extract_limit:$extract_limit,
        matched_patch_count:($matches | length),
        selected_patch_count:($matches[0:$extract_limit] | length),
        selected_patches:$matches[0:$extract_limit],
        side_effect_free:true,
        report_only:true,
        replay_applied:false,
        patch_body_emitted:true,
        patch_replay_enabled:false,
        recommended_next_local_step:"manual_apply_check_selected_patch_against_current_checkout"
      }
  '
