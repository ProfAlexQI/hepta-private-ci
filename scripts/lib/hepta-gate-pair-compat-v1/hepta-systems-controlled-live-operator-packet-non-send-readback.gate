#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-non-send-readback.report"
PACKET_PREVIEW_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-preview.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_OPERATOR_PACKET_NON_SEND_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-operator-packet-non-send-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 5c report: $REPORT"
[[ -x "$PACKET_PREVIEW_GATE" ]] || fail "missing executable Phase 5b operator packet preview gate: $PACKET_PREVIEW_GATE"
[[ -f "$DOC" ]] || fail "missing Phase 5c architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 5c non-send readback report"
fi

grep -q 'Controlled Live Operator Packet Non-Send Readback' "$DOC" \
  || fail "architecture note must document Controlled Live Operator Packet Non-Send Readback"
grep -q 'visible, unsent, unpersisted, and still not an approval request' "$DOC" \
  || fail "architecture note must document visible unsent packet state"
grep -q 'no approval request, approval recording, packet send, packet persistence, readback persistence, ledger write, event-log write, SQLite write, Native POST mutation, Telegram transport mutation, gateway/auth mutation, channel send, replay, rollback, package, release, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed non-send readback boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_operator_packet_non_send_readback"
  and .status == "ready_blocked"
  and .gate == "controlled_live_operator_packet_non_send_readback_gate"
  and .schema_version == "controlled_live_operator_packet_non_send_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_operator_packet_preview_ready == true
  and .source_packet_id == "controlled-live-operator-packet-preview"
  and .source_payload_hash == "sha256:controlled-live-operator-packet-preview-no-live-payload"
  and .source_blocker_readback_count == 7
  and .lib_export_present == true
  and .readback_entry_count == 6
  and .readback_ready_count == 6
  and .packet_visible_to_operator == true
  and .packet_send_attempted == false
  and .approval_request_ready == false
  and .approval_request_sent == false
  and .approval_recorded == false
  and .packet_persisted == false
  and .readback_persisted == false
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and .non_send_readback_ready == true
  and (.entries | length) == 6
  and (.entries | all(.operator_visible == true and .non_send_confirmed == true and .persistence_blocked == true and .approval_request_blocked == true and .live_mutation_allowed == false))
  and any(.entries[]; .id == "packet_preview_visible")
  and any(.entries[]; .id == "approval_request_not_sent")
  and any(.entries[]; .id == "packet_not_persisted")
  and any(.entries[]; .id == "transport_not_used")
  and any(.entries[]; .id == "cutover_not_promoted")
  and any(.entries[]; .id == "blocker_readback_integrity_retained")
  and (.next_actions | index("phase5d_controlled_live_required_evidence_collection_plan_without_recording")) != null
  and .next_migration_step == "phase5d_controlled_live_required_evidence_collection_plan_without_recording"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$PACKET_PREVIEW_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime controlled_live_operator_packet_non_send_readback --lib
)

printf 'hepta-systems-controlled-live-operator-packet-non-send-readback-gate: PASS: controlled-live operator packet is visible, unsent, unpersisted, and not an approval request\n'
