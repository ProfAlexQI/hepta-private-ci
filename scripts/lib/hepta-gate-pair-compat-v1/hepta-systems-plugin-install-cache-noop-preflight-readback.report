#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-operator-evidence-acceptance-packet-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/hepta_systems_plugin_install_cache_noop_preflight_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_INSTALL_CACHE_NOOP_PREFLIGHT_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-plugin-install-cache-noop-preflight-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable operator evidence acceptance packet report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing install-cache noop preflight Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing install-cache noop preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the install-cache noop preflight report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$SOURCE_REPORT" >"$tmpdir/source.json" || fail "failed to render operator evidence acceptance packet report"
jq -e . "$tmpdir/source.json" >/dev/null || fail "operator evidence acceptance packet report did not render valid JSON"

lib_export_present=false
if grep -q 'hepta_systems_plugin_install_cache_noop_preflight_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile source "$tmpdir/source.json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-install-cache-noop-preflight-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PLUGIN_INSTALL_CACHE_NOOP_PREFLIGHT_READBACK_2026-06-30.md" \
  '
  def preflight_route($kind):
    if $kind == "mcp_server" then
      "plugin-install-cache-noop-preflight://hepta-system/mcp"
    elif $kind == "app_connector" then
      "plugin-install-cache-noop-preflight://hepta-system/app"
    else
      "plugin-install-cache-noop-preflight://hepta-system/unknown"
    end;
  def install_cache_path($kind):
    if $kind == "mcp_server" then
      ".hepta/plugin-install-cache/noop/hepta-system/mcp/hepta_system_local_mcp"
    elif $kind == "app_connector" then
      ".hepta/plugin-install-cache/noop/hepta-system/app/hepta_system_local_app"
    else
      ".hepta/plugin-install-cache/noop/hepta-system/unknown"
    end;
  def artifact_digest($kind):
    if $kind == "mcp_server" then
      "sha256:noop-hepta-system-local-mcp-manifest-fixture"
    elif $kind == "app_connector" then
      "sha256:noop-hepta-system-local-app-manifest-fixture"
    else
      "sha256:noop-hepta-system-unknown-manifest-fixture"
    end;
  def rollback_uninstall_plan_id($kind):
    if $kind == "mcp_server" then
      "rollback-uninstall-plan:hepta-system:local-mcp:no-exec"
    elif $kind == "app_connector" then
      "rollback-uninstall-plan:hepta-system:local-app:no-exec"
    else
      "rollback-uninstall-plan:hepta-system:unknown:no-exec"
    end;
  def idempotency_key($kind):
    if $kind == "mcp_server" then
      "install-cache-noop:hepta-system:local-mcp:v0"
    elif $kind == "app_connector" then
      "install-cache-noop:hepta-system:local-app:v0"
    else
      "install-cache-noop:hepta-system:unknown:v0"
    end;
  def denial_receipt_id($kind):
    if $kind == "mcp_server" then
      "denial-receipt:hepta-system:local-mcp:install-cache-noop"
    elif $kind == "app_connector" then
      "denial-receipt:hepta-system:local-app:install-cache-noop"
    else
      "denial-receipt:hepta-system:unknown:install-cache-noop"
    end;
  def entry($source_entry): {
    candidate_tool_id:$source_entry.candidate_tool_id,
    contribution_kind:$source_entry.contribution_kind,
    preflight_route:preflight_route($source_entry.contribution_kind),
    install_cache_path:install_cache_path($source_entry.contribution_kind),
    artifact_digest:artifact_digest($source_entry.contribution_kind),
    rollback_uninstall_plan_id:rollback_uninstall_plan_id($source_entry.contribution_kind),
    idempotency_key:idempotency_key($source_entry.contribution_kind),
    denial_receipt_id:denial_receipt_id($source_entry.contribution_kind),
    source_operator_packet_projected:$source_entry.operator_packet_projected,
    source_checklist_projected:$source_entry.checklist_projected,
    source_non_acceptance_receipt_projected:$source_entry.non_acceptance_receipt_projected,
    source_evidence_item_required_count:$source_entry.evidence_item_required_count,
    source_acceptance_check_required_count:$source_entry.acceptance_check_required_count,
    cache_path_projected:true,
    artifact_digest_projected:true,
    rollback_uninstall_plan_projected:true,
    idempotency_key_projected:true,
    denial_receipt_projected:true,
    noop_preflight_ready:true,
    noop_preflight_executed:false,
    preflight_persisted:false,
    denial_receipt_persisted:false,
    cache_materialized:false,
    cache_mutated:false,
    plugin_installed:false,
    dynamic_activation_started:false,
    rollback_uninstall_executed:false,
    permission_granted:$source_entry.permission_granted,
    mcp_server_started:$source_entry.mcp_server_started,
    app_connector_started:$source_entry.app_connector_started,
    tool_registered:$source_entry.tool_registered,
    tool_invoked:$source_entry.tool_invoked,
    ledger_written:$source_entry.ledger_written,
    approval_requested:$source_entry.approval_requested,
    receipt_persisted:$source_entry.receipt_persisted,
    runtime_event_log_written:$source_entry.runtime_event_log_written,
    sqlite_written:$source_entry.sqlite_written,
    live_execution_started:$source_entry.live_execution_started
  };
  ($source[0]) as $source_report |
  ($source_report.entries | map(entry(.))) as $entries |
  ($entries | length) as $preflight_entry_count |
  ($entries | map(select(.cache_path_projected == true)) | length) as $cache_path_projected_count |
  ($entries | map(select(.artifact_digest_projected == true)) | length) as $artifact_digest_projected_count |
  ($entries | map(select(.rollback_uninstall_plan_projected == true)) | length) as $rollback_uninstall_plan_projected_count |
  ($entries | map(select(.idempotency_key_projected == true)) | length) as $idempotency_key_projected_count |
  ($entries | map(select(.denial_receipt_projected == true)) | length) as $denial_receipt_projected_count |
  ($entries | map(select(.noop_preflight_ready == true)) | length) as $noop_preflight_ready_count |
  ($entries | map(select(.noop_preflight_executed == true)) | length) as $noop_preflight_executed_count |
  ($entries | map(select(.preflight_persisted == true)) | length) as $preflight_persisted_count |
  ($entries | map(select(.denial_receipt_persisted == true)) | length) as $denial_receipt_persisted_count |
  ($entries | map(select(.cache_materialized == true)) | length) as $cache_materialized_count |
  ($entries | map(select(.cache_mutated == true)) | length) as $cache_mutated_count |
  ($entries | map(select(.plugin_installed == true)) | length) as $plugin_installed_count |
  ($entries | map(select(.dynamic_activation_started == true)) | length) as $dynamic_activation_started_count |
  ($source_report.operator_evidence_acceptance_packet_readback_ready == true
    and $source_report.candidate_count == 2
    and $source_report.packet_projected_count == 2
    and $source_report.checklist_projected_count == 2
    and $source_report.non_acceptance_receipt_projected_count == 2
    and $source_report.evidence_item_recorded_count == 0
    and $source_report.acceptance_check_recorded_count == 0
    and $source_report.plugin_install_allowed == false
    and $source_report.plugin_cache_mutation_allowed == false
    and $source_report.install_cache_materialization_allowed == false
    and $source_report.dynamic_activation_allowed == false
    and $lib_export_present == true
    and $preflight_entry_count == 2
    and $cache_path_projected_count == 2
    and $artifact_digest_projected_count == 2
    and $rollback_uninstall_plan_projected_count == 2
    and $idempotency_key_projected_count == 2
    and $denial_receipt_projected_count == 2
    and $noop_preflight_ready_count == 2
    and $noop_preflight_executed_count == 0
    and $preflight_persisted_count == 0
    and $denial_receipt_persisted_count == 0
    and $cache_materialized_count == 0
    and $cache_mutated_count == 0
    and $plugin_installed_count == 0
    and $dynamic_activation_started_count == 0
    and ($entries | all(.source_operator_packet_projected == true
      and .source_checklist_projected == true
      and .source_non_acceptance_receipt_projected == true
      and .source_evidence_item_required_count == 4
      and .source_acceptance_check_required_count == 5
      and .cache_path_projected == true
      and .artifact_digest_projected == true
      and .rollback_uninstall_plan_projected == true
      and .idempotency_key_projected == true
      and .denial_receipt_projected == true
      and .noop_preflight_ready == true
      and .noop_preflight_executed == false
      and .preflight_persisted == false
      and .denial_receipt_persisted == false
      and .cache_materialized == false
      and .cache_mutated == false
      and .plugin_installed == false
      and .dynamic_activation_started == false
      and .rollback_uninstall_executed == false
      and .permission_granted == false
      and .mcp_server_started == false
      and .app_connector_started == false
      and .tool_registered == false
      and .tool_invoked == false
      and .ledger_written == false
      and .approval_requested == false
      and .receipt_persisted == false
      and .runtime_event_log_written == false
      and .sqlite_written == false
      and .live_execution_started == false))) as $ready |
  {
    runtime:"hepta",
    surface:"hepta_systems_plugin_install_cache_noop_preflight_readback",
    status:(if $ready then "ready_blocked" else "blocked" end),
    gate:"hepta_systems_plugin_install_cache_noop_preflight_readback_gate",
    schema_version:"hepta_systems_plugin_install_cache_noop_preflight_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    manifest_name:$source_report.manifest_name,
    manifest_version:$source_report.manifest_version,
    source_operator_evidence_acceptance_packet_ready:$source_report.operator_evidence_acceptance_packet_readback_ready,
    lib_export_present:$lib_export_present,
    candidate_count:$source_report.candidate_count,
    preflight_entry_count:$preflight_entry_count,
    cache_path_projected_count:$cache_path_projected_count,
    artifact_digest_projected_count:$artifact_digest_projected_count,
    rollback_uninstall_plan_projected_count:$rollback_uninstall_plan_projected_count,
    idempotency_key_projected_count:$idempotency_key_projected_count,
    denial_receipt_projected_count:$denial_receipt_projected_count,
    noop_preflight_ready_count:$noop_preflight_ready_count,
    noop_preflight_executed_count:$noop_preflight_executed_count,
    preflight_persisted_count:$preflight_persisted_count,
    denial_receipt_persisted_count:$denial_receipt_persisted_count,
    cache_materialized_count:$cache_materialized_count,
    cache_mutated_count:$cache_mutated_count,
    plugin_installed_count:$plugin_installed_count,
    dynamic_activation_started_count:$dynamic_activation_started_count,
    install_cache_noop_preflight_readback_ready:$ready,
    noop_preflight_execution_allowed:false,
    preflight_persistence_allowed:false,
    denial_receipt_persistence_allowed:false,
    plugin_install_allowed:false,
    plugin_cache_mutation_allowed:false,
    install_cache_materialization_allowed:false,
    dynamic_activation_allowed:false,
    rollback_uninstall_execution_allowed:false,
    permission_grant_allowed:false,
    mcp_server_start_allowed:false,
    app_connector_start_allowed:false,
    tool_registry_registration_allowed:false,
    tool_invocation_allowed:false,
    ledger_write_allowed:false,
    approval_request_allowed:false,
    receipt_persistence_allowed:false,
    runtime_event_log_write_allowed:false,
    sqlite_write_allowed:false,
    live_execution_allowed:false,
    entries:$entries,
    blockers:[
      "noop_preflight_execution_disabled",
      "preflight_persistence_disabled",
      "denial_receipt_persistence_disabled",
      "plugin_install_disabled",
      "plugin_cache_mutation_disabled",
      "install_cache_materialization_disabled",
      "dynamic_activation_disabled",
      "rollback_uninstall_execution_disabled",
      "permission_grant_disabled",
      "mcp_server_start_disabled",
      "app_connector_start_disabled",
      "tool_registry_registration_disabled",
      "tool_invocation_disabled",
      "ledger_write_disabled",
      "approval_request_disabled",
      "receipt_persistence_disabled",
      "runtime_event_log_write_disabled",
      "sqlite_write_disabled",
      "live_execution_disabled"
    ],
    next_actions:[
      "hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback"
    ],
    recommended_next_gate:"hepta_systems_plugin_install_cache_idempotency_denial_receipt_readback",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      filesystem_written:false,
      noop_preflight_executed:false,
      preflight_persisted:false,
      denial_receipt_persisted:false,
      plugin_installed:false,
      plugin_cache_mutated:false,
      install_cache_materialized:false,
      rollback_uninstall_executed:false,
      dynamic_activation_started:false,
      permission_granted:false,
      mcp_server_started:false,
      app_connector_started:false,
      tool_registry_mutated:false,
      tool_registered:false,
      tool_invoked:false,
      ledger_written:false,
      approval_requested:false,
      receipt_persisted:false,
      runtime_event_log_written:false,
      sqlite_written:false,
      credential_read:false,
      external_network_used:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }
  '
