#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-receipt-readback.report"
ATTACHMENT_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-signing-notarization-final-index-delivery-receipt-signing-receipt.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_SIGNING_RECEIPT_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-receipt-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable terminal public claim delivery receipt artifact signing receipt non-persistence readback report: $REPORT"
[[ -x "$ATTACHMENT_GATE" ]] || fail "missing executable terminal public claim delivery receipt artifact signing receipt non-persistence attachment gate: $ATTACHMENT_GATE"
[[ -f "$DOC" ]] || fail "missing terminal public claim delivery receipt artifact signing receipt non-persistence readback architecture note: $DOC"

grep -q 'Terminal Public Claim Delivery Receipt Artifact Signing Receipt Non-Persistence Readback' "$DOC" \
  || fail "architecture note must document Terminal Public Claim Delivery Receipt Artifact Signing Receipt Non-Persistence Readback"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that readback does not invoke signing receipt gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_readback"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_readback_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_readback_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_attachment_attached == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_non_persistence_denial_gate_invoked == false
  and .signing_receipt_recorded == false
  and .signing_receipt_persisted == false
  and .signing_receipt_status_exposed == false
  and .artifact_signing_receipt_recorded == false
  and .package_signing_receipt_recorded == false
  and .signature_manifest_receipt_recorded == false
  and .notarization_submission_receipt_recorded == false
  and .notarization_ticket_receipt_recorded == false
  and .stapling_receipt_recorded == false
  and .installer_signing_receipt_recorded == false
  and .provenance_attestation_receipt_recorded == false
  and .sbom_manifest_receipt_recorded == false
  and .release_asset_receipt_recorded == false
  and .artifact_bundle_receipt_recorded == false
  and .cdn_artifact_receipt_recorded == false
  and .update_feed_receipt_recorded == false
  and .package_registry_receipt_recorded == false
  and .external_receipt_sent == false
  and .telegram_receipt_sent == false
  and .operator_approval_from_signing_receipt_derived == false
  and .release_publication_authority_from_signing_receipt_derived == false
  and .activation_authority_from_signing_receipt_derived == false
  and .install_from_signing_receipt_executed == false
  and .active_binary_from_signing_receipt_mutated == false
  and .provider_invoked == false
  and .credential_read == false
  and .readback_check_count == 120
  and .readback_blocker_count == 120
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$ATTACHMENT_GATE" >/dev/null

printf 'hepta-systems-terminal-public-claim-delivery-receipt-signing-receipt-readback-gate: PASS: terminal public claim delivery receipt artifact signing receipt non-persistence readback is ready but blocked\n'
