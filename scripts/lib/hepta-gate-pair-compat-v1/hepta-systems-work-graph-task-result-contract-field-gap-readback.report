#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

contract="$(
  capture_json_report \
    "hepta-work-graph-task-result-contract-preview-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-task-result-contract-preview.report"
)"
terminal="$(
  capture_json_report \
    "hepta-work-graph-terminal-envelope-readback-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-envelope-readback.report"
)"
alignment="$(
  capture_json_report \
    "hepta-work-graph-source-id-alignment-readback-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-source-id-alignment-readback.report"
)"

rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_task_result_contract_field_gap_readback.rs
)"
report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-task-result-contract-field-gap-readback.report
)"
gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-task-result-contract-field-gap-readback.gate
)"
scheduler_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-scheduler-admission-dry-run-enforcement.gate
)"

jq -n \
  --argjson contract "$contract" \
  --argjson terminal "$terminal" \
  --argjson alignment "$alignment" \
  --argjson rust_module_present "$rust_module_present" \
  --argjson report_script_present "$report_script_present" \
  --argjson gate_script_present "$gate_script_present" \
  --argjson scheduler_gate_script_present "$scheduler_gate_script_present" \
  '
  def blocker($id; $severity; $sources; $fix): {
    id: $id,
    severity: $severity,
    affected_source_surface_ids: $sources,
    blocks_live_execution: true,
    recommended_fix: $fix
  };
  ($contract.required_fields | map(.wire_name)) as $required_wire_fields
  | (
      $terminal.terminal_sources
      | map(
          .source_surface_id as $source_id
          | ($contract.adapter_previews | map(select(.source_surface_id == $source_id)) | .[0]) as $adapter
          | (($adapter != null)
             and (.missing_contract_required_wire_fields | length) == 0
             and (.missing_contract_terminal_wire_fields | length) == 0
             and ($adapter.covered_wire_fields == $required_wire_fields)) as $complete
          | {
              source_surface_id,
              canonical_node_kind,
              task_result_contract_adapter_state: (if $adapter != null then "present_report_only" else "missing" end),
              covered_contract_wire_fields: ($adapter.covered_wire_fields // []),
              missing_contract_required_wire_fields,
              missing_contract_terminal_wire_fields,
              readback_decision: (if $complete then "task_result_contract_fields_complete_report_only" else "task_result_contract_field_gap_remaining" end),
              live_enforcement_enabled: false,
              next_gap_step: (if $complete then "append_only_event_store_shadow_path" else "fill_task_result_contract_wire_field_projection" end)
            }
        )
    ) as $field_readbacks
  | ($field_readbacks | map(select(.readback_decision == "task_result_contract_fields_complete_report_only")) | length) as $full_count
  | ($field_readbacks | map(select(.task_result_contract_adapter_state != "present_report_only" or (.missing_contract_required_wire_fields | length) > 0 or (.missing_contract_terminal_wire_fields | length) > 0)) | length) as $gap_source_count
  | ($field_readbacks | map(.missing_contract_required_wire_fields | length) | add) as $required_gap_count
  | ($field_readbacks | map(.missing_contract_terminal_wire_fields | length) | add) as $terminal_gap_count
  | ($gap_source_count == 0
      and $required_gap_count == 0
      and $terminal_gap_count == 0
      and $alignment.source_id_alignment_readback_complete == true) as $complete
  | (
      (if $complete then [] else
        [blocker("task_result_contract_field_gap_remaining"; "high"; ($field_readbacks | map(select(.readback_decision == "task_result_contract_field_gap_remaining") | .source_surface_id)); "fill all required and terminal TaskResult contract wire fields before event-store shadow promotion")]
      end)
      + [blocker("append_only_event_store_shadow_path_not_enabled"; "high"; ($field_readbacks | map(.source_surface_id)); "shadow-write TaskResult events and replay them before enabling durable WorkGraph enforcement")]
      + [blocker("task_result_contract_live_enforcement_disabled"; "high"; ($field_readbacks | map(.source_surface_id)); "keep TaskResult contract validation report-only until append-only event-store, replay, and operator review gates pass")]
    ) as $blockers
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_task_result_contract_field_gap_readback_gate",
      schema_version: "work_graph_task_result_contract_field_gap_readback_v1",
      preview_mode: "read_only_task_result_contract_field_gap_readback_no_enforcement",
      required_wire_field_count: ($required_wire_fields | length),
      terminal_source_count: ($field_readbacks | length),
      terminal_source_full_contract_count: $full_count,
      gap_source_count: $gap_source_count,
      contract_required_field_gap_count: $required_gap_count,
      contract_terminal_field_gap_count: $terminal_gap_count,
      field_readbacks: $field_readbacks,
      blockers: $blockers,
      required_prior_gates: [
        "hepta_work_graph_task_result_contract_preview_gate",
        "hepta_work_graph_terminal_envelope_readback_gate",
        "hepta_work_graph_source_id_alignment_readback_gate"
      ],
      recommended_next_gate: "hepta_work_graph_append_only_event_store_shadow_path_gate",
      task_result_contract_field_gap_readback_complete: $complete,
      ready_for_append_only_event_store_shadow_path: $complete,
      ready_for_task_result_enforcement: false,
      ready_for_live_execution: false,
      source_probes: {
        task_result_contract_field_gap_readback: {
          rust_module_present: $rust_module_present,
          report_script_present: $report_script_present,
          gate_script_present: $gate_script_present
        },
        priors: {
          task_result_contract_gate: $contract.gate,
          terminal_envelope_readback_gate: $terminal.gate,
          source_id_alignment_readback_gate: $alignment.gate
        },
        scheduler_admission_dry_run: {
          gate_script_present: $scheduler_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        work_graph_event_persisted: false,
        adapter_projection_enforced: false,
        task_result_enforcement_enabled: false,
        scheduler_admission_enforced: false,
        live_admission_enforcement_enabled: false,
        runtime_mutation_performed: false,
        approval_recorded: false,
        agent_spawn_performed: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
