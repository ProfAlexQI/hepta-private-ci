#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-scheduler-admission-enforcement-gap-closure-readback-preview.report"

report="$(capture_json_report "hepta-work-graph-scheduler-admission-enforcement-gap-closure-readback-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_scheduler_admission_enforcement_gap_closure_readback_preview_gate"
  and .schema_version == "work_graph_scheduler_admission_enforcement_gap_closure_readback_preview_v1"
  and .preview_mode == "read_only_scheduler_admission_gap_closure_readback_no_execution"
  and .closure_plan_count == 5
  and .admission_binding_count == 5
  and .readback_probe_binding_count == 5
  and .readback_plan_count == 5
  and .admission_binding_assertion_count == 5
  and .readback_probe_assertion_count == 5
  and .evidence_field_assertion_count == 5
  and .guard_assertion_count == 9
  and .blocker_mapping_assertion_count == 10
  and .admission_check_ref_count == 35
  and .admission_decision_ref_count == 35
  and .evidence_field_ref_count == 90
  and .drift_detector_count == 6
  and .blocker_count == 12
  and .required_prior_gate_count == 33
' >/dev/null <<<"$report"

jq -e '
  (.readback_plans | map(.source_surface_id) == [
    "multi_agent_v2_thread_spawn",
    "agent_jobs_batch_workers",
    "hepta_runtime_task_board",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store"
  ])
  and (.readback_plans | all(
    .required_before_closure_application == true
    and .readback_state == "readback_assertions_defined_execution_disabled"
    and (.admission_check_ids | length) == 7
    and (.admission_decision_ids | length) == 7
    and (.required_evidence_fields | length) == 18
    and .performs_readback == false
    and .enforces_scheduler_admission == false
    and .starts_work == false
    and .acquires_lease == false
    and .consumes_budget == false
    and .records_approval == false
    and .mutates_idempotency_index == false
    and .writes_store == false
  ))
  and (.readback_plans | map(select(
    .source_surface_id == "hepta_runtime_task_board"
    and .target_node_kind == "worker_task"
    and .scheduler_blocker_id == "task_board_admission_not_enforced"
    and .readback_probe_id == "scheduler_admission_readback_probe:hepta_runtime_task_board"
  )) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  (.admission_binding_assertions | all(
    .expected_binding_state == "scheduler_admission_binding_defined_enforcement_disabled"
    and (.admission_check_ids | length) == 7
    and (.admission_decision_ids | length) == 7
    and .enforces_scheduler_admission == false
    and .starts_work == false
  ))
  and (.readback_probe_assertions | all(
    .expected_probe_state == "scheduler_admission_readback_probe_defined_execution_disabled"
    and (.required_evidence_fields | length) == 18
    and .performs_readback == false
    and .persists_evidence == false
    and .enforces_scheduler_admission == false
  ))
  and (.evidence_field_assertions | all(
    .required_field_count == 18
    and .expected_evidence_state == "scheduler_admission_evidence_contract_defined_no_readback_execution"
    and .performs_readback == false
    and .enforces_scheduler_admission == false
  ))
  and (.guard_assertions | all(
    .expected_guard_state == "guard_declared_satisfied_by_runtime_false"
    and .required_before_scheduler_admission_enforcement == true
    and .satisfied_by_readback_preview == false
    and .mutates_runtime == false
  ))
  and (.blocker_mapping_assertions | all(
    .expected_blocker_state == "blocks_scheduler_admission_until_readback_and_application_preview"
    and .required_before_scheduler_admission_enforcement == true
    and .performs_readback == false
    and .mutates_runtime == false
  ))
' >/dev/null <<<"$report"

jq -e '
  (.drift_detectors | map(.id) == [
    "scheduler_admission_source_coverage_drift",
    "scheduler_admission_check_binding_drift",
    "scheduler_admission_evidence_field_drift",
    "scheduler_admission_no_mutation_guard_drift",
    "scheduler_admission_blocker_mapping_drift",
    "scheduler_admission_prior_gate_drift"
  ])
  and (.drift_detectors | all(.blocks_closure_application == true and .performs_readback == false))
  and (.blockers | map({id, count: (.affected_source_surface_ids | length)}) == [
    {"id": "readback_execution_disabled", "count": 5},
    {"id": "scheduler_admission_enforcement_disabled", "count": 5},
    {"id": "lane_lease_acquisition_disabled", "count": 5},
    {"id": "dependency_readback_not_executed", "count": 5},
    {"id": "approval_recording_disabled", "count": 5},
    {"id": "idempotency_index_mutation_disabled", "count": 5},
    {"id": "budget_consumption_disabled", "count": 5},
    {"id": "role_manifest_residuals_not_enforced", "count": 3},
    {"id": "projection_timeline_runtime_residuals_not_promoted", "count": 4},
    {"id": "append_only_store_runtime_enablement_disabled", "count": 5},
    {"id": "scheduler_admission_closure_application_missing", "count": 5},
    {"id": "operator_review_required", "count": 5}
  ])
  and (.blockers | all(.required_before_scheduler_admission_enforcement == true))
' >/dev/null <<<"$report"

jq -e '
  (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_scheduler_admission_enforcement_gap_closure_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_scheduler_admission_enforcement_gap_closure_application_preview_gate"
  and .ready_for_scheduler_admission_closure_application_preview == true
  and .ready_for_readback_execution == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_projection_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.scheduler_admission_gap_closure_readback.rust_module_present == true
  and .source_probes.scheduler_admission_gap_closure_readback.report_script_present == true
  and .source_probes.scheduler_admission_gap_closure_readback.gate_script_present == true
  and .source_probes.scheduler_admission_gap_closure.upstream_gate == true
  and .source_probes.scheduler_admission_gap_closure.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_scheduler_admission_enforcement_gap_closure_readback --lib

echo "Hepta WorkGraph scheduler admission enforcement gap closure readback preview gate passed"
