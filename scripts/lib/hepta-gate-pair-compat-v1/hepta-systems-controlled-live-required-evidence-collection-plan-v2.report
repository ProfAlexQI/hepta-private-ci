#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)}"
export HEPTA_REPO_ROOT="$ROOT"
DENIAL_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-readiness-denial-readback-index-v2.report"
NON_SEND_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-non-send-readback-v2.report"
LEGACY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_required_evidence_collection_plan.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
RUNTIME_SOURCE_SET="${HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET:-$ROOT/scripts/lib/hepta-runtime-crate-root-source-set-v1.sh}"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_COLLECTION_PLAN_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-collection-plan-v2-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$DENIAL_REPORT" ]] || fail "missing executable Phase 5a v2 denial report: $DENIAL_REPORT"
[[ -x "$NON_SEND_REPORT" ]] || fail "missing executable Phase 5c v2 non-send report: $NON_SEND_REPORT"
[[ -x "$LEGACY_REPORT" ]] || fail "missing executable legacy Phase 5d report: $LEGACY_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 5d Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -x "$RUNTIME_SOURCE_SET" ]] || fail "missing executable runtime crate-root source-set resolver: $RUNTIME_SOURCE_SET"
[[ -f "$DOC" ]] || fail "missing Phase 5d architecture note: $DOC"
command -v jq >/dev/null 2>&1 || fail "jq is required to render the Phase 5d v2 report"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if HEPTA_REPO_ROOT="$ROOT" "$RUNTIME_SOURCE_SET" grep -q \
  'controlled_live_required_evidence_collection_plan_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

denial_json="${HEPTA_CONTROLLED_LIVE_DENIAL_READBACK_JSON:-}"
if [[ -n "$denial_json" ]]; then
  [[ -f "$denial_json" ]] || fail "missing cached Phase 5a v2 denial report: $denial_json"
else
  denial_json="$tmpdir/denial.json"
  "$DENIAL_REPORT" >"$denial_json" || fail "failed to render Phase 5a v2 denial report"
fi

nonsend_json="${HEPTA_CONTROLLED_LIVE_OPERATOR_PACKET_NONSEND_JSON:-}"
if [[ -n "$nonsend_json" ]]; then
  [[ -f "$nonsend_json" ]] || fail "missing cached Phase 5c v2 non-send report: $nonsend_json"
else
  nonsend_json="$tmpdir/nonsend.json"
  "$NON_SEND_REPORT" >"$nonsend_json" || fail "failed to render Phase 5c v2 non-send report"
fi

legacy_json="$tmpdir/legacy.json"
HEPTA_CONTROLLED_LIVE_DENIAL_READBACK_JSON="$denial_json" \
  HEPTA_CONTROLLED_LIVE_OPERATOR_PACKET_NONSEND_JSON="$nonsend_json" \
  "$LEGACY_REPORT" >"$legacy_json" || fail "failed to render legacy Phase 5d report"

jq -n \
  --slurpfile legacy "$legacy_json" \
  --slurpfile denial "$denial_json" \
  --slurpfile nonsend "$nonsend_json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan-v2.gate" \
  --arg legacy_gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan.gate" \
  --arg legacy_report "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan.report" \
  '
  ($legacy[0]) as $legacy |
  ($denial[0]) as $denial |
  ($nonsend[0]) as $nonsend |
  ($denial.entries | map({key:.source_blocker_id, value:.}) | from_entries) as $denial_by_id |
  ($legacy.entries | map(
    . as $entry |
    ($denial_by_id[$entry.source_blocker_id]) as $source |
    . + {
      current_state:$source.current_state,
      active_blocker:$source.active_blocker,
      evidence_required:$source.evidence_required,
      blocks_cutover:$source.blocks_cutover
    }
  )) as $entries |
  ($entries | map(select(.active_blocker == true)) | length) as $active_blocker_count |
  ($entries | map(select(.evidence_required == true and (.required_evidence | length) > 0)) | length) as $required_evidence_count |
  ($entries | map(select(.current_state == "satisfied")) | length) as $satisfied_entry_count |
  (($denial.source_worktree_boundary_state == "clean"
      and $denial.source_blocker_count == 6
      and $active_blocker_count == 6
      and $required_evidence_count == 6
      and $satisfied_entry_count == 1)
    or ($denial.source_worktree_boundary_state == "dirty"
      and $denial.source_blocker_count == 7
      and $active_blocker_count == 7
      and $required_evidence_count == 7
      and $satisfied_entry_count == 0)) as $worktree_state_consistent |
  ($denial.schema_version == "controlled_live_readiness_denial_readback_index_v2"
    and $denial.compatibility_migration == "clean_worktree_boundary_v2"
    and $denial.readback_index_ready == true
    and $denial.controlled_live_cutover_ready == false
    and $denial.ready_for_live_execution == false
    and $denial.side_effect_free == true
    and ($denial.side_effects | to_entries | all(.value == false))
    and $nonsend.schema_version == "controlled_live_operator_packet_non_send_readback_v2"
    and $nonsend.compatibility_migration == "clean_worktree_boundary_v2_propagation"
    and $nonsend.non_send_readback_ready == true
    and $nonsend.controlled_live_cutover_ready == false
    and $nonsend.live_execution_allowed == false
    and $nonsend.packet_send_attempted == false
    and $nonsend.packet_persisted == false
    and $nonsend.side_effect_free == true
    and ($nonsend.side_effects | to_entries | all(.value == false))
    and $nonsend.source_active_blocker_count == $active_blocker_count
    and $worktree_state_consistent
    and $lib_export_present == true
    and ($entries | length) == 7
    and ($entries | map(select(.queryable == true)) | length) == 7
    and ($entries | map(select(.operator_visible == true)) | length) == 7
    and ($entries | map(select(.evidence_recorded == true)) | length) == 0
    and ($entries | map(select(.blocker_waiver_allowed == true)) | length) == 0
    and $legacy.side_effect_free == true
    and ($legacy.side_effects | to_entries | all(.value == false))
    and ($entries | all(
      .collection_mode == "plan_only_no_recording"
      and .evidence_recording_allowed == false
      and .credential_read_allowed == false
      and .approval_acceptance_allowed == false
      and .persistence_allowed == false
      and .live_mutation_allowed == false
      and ((.active_blocker == true and .evidence_required == true and .current_state == "missing" and .blocks_cutover == true)
        or (.active_blocker == false and .evidence_required == false and .current_state == "satisfied" and .blocks_cutover == false))
    ))) as $plan_ready |
  $legacy
  | .status = (if $plan_ready then "ready_blocked" else "blocked" end)
  | .schema_version = "controlled_live_required_evidence_collection_plan_v2"
  | .compatibility_migration = "clean_worktree_boundary_v2_propagation"
  | .legacy_report = $legacy_report
  | .legacy_gate = $legacy_gate
  | .source_worktree_boundary_state = $denial.source_worktree_boundary_state
  | .source_dirty_worktree_boundary_tracked = $denial.source_dirty_worktree_boundary_tracked
  | .source_blocker_count = $denial.source_blocker_count
  | .stable_blocker_slot_count = ($entries | length)
  | .active_blocker_count = $active_blocker_count
  | .satisfied_entry_count = $satisfied_entry_count
  | .required_evidence_count = $required_evidence_count
  | .lib_export_present = $lib_export_present
  | .evidence_collection_plan_ready = $plan_ready
  | .controlled_live_cutover_ready = false
  | .live_execution_allowed = false
  | .entries = $entries
  | .local_gate = $gate
  '
