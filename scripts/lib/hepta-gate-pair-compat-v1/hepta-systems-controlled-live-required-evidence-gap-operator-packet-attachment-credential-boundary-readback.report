#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
TRANSPORT_BOUNDARY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-transport-boundary-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_CREDENTIAL_BOUNDARY_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-credential-boundary-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$TRANSPORT_BOUNDARY_REPORT" ]] || fail "missing executable Phase 5k operator packet attachment transport boundary readback report: $TRANSPORT_BOUNDARY_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 5l Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 5l architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 5l operator packet attachment credential boundary readback report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if grep -q 'controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

transport_json="${HEPTA_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_TRANSPORT_JSON:-}"
if [[ -n "$transport_json" ]]; then
  [[ -f "$transport_json" ]] || fail "missing cached Phase 5k operator packet attachment transport boundary readback report: $transport_json"
else
  transport_json="$tmpdir/transport.json"
  "$TRANSPORT_BOUNDARY_REPORT" >"$transport_json" || fail "failed to render Phase 5k operator packet attachment transport boundary readback report"
fi

jq -n \
  --slurpfile transport "$transport_json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-credential-boundary-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_CREDENTIAL_BOUNDARY_READBACK_2026-06-27.md" \
  '
  def credential_id($id):
    "credential_boundary_readback_" + $id;
  def credential_key($id):
    "controlled_live.required_evidence.gap.operator_packet_attachment.credential_boundary." + $id;
  def credential_route($id):
    "readback://controlled-live/operator-packet/attachment/credential-boundary/" + ($id | gsub("_"; "-"));
  ($transport[0]) as $transport |
  ($transport.entries | map({
    id:credential_id(.source_blocker_id),
    source_blocker_id,
    packet_id,
    packet_payload_hash,
    attachment_key,
    attachment_route,
    transport_boundary_key,
    transport_boundary_route,
    credential_boundary_key:credential_key(.source_blocker_id),
    credential_boundary_route:credential_route(.source_blocker_id),
    operator_display_order,
    operator_status,
    observed_state:"credential_boundary_closed_no_read",
    previous_state,
    current_state,
    state_delta,
    owner,
    risk_bucket,
    operator_label,
    required_evidence,
    operator_visible:true,
    attachment_visible:true,
    transport_boundary_confirmed:true,
    credential_boundary_readback_visible:true,
    credential_boundary_status:"closed_no_read",
    credential_attestation_state:"missing",
    credential_read_allowed:false,
    credential_read_attempted:false,
    credential_material_load_allowed:false,
    credential_material_loaded:false,
    credential_value_exposure_allowed:false,
    credential_value_exposed:false,
    credential_handle_resolution_allowed:false,
    credential_handle_resolved:false,
    credential_secret_material_visible:false,
    gateway_or_auth_mutation_allowed:false,
    native_post_mutation_allowed:false,
    telegram_transport_mutation_allowed:false,
    channel_send_allowed:false,
    transport_mutation_allowed:false,
    approval_request_allowed:false,
    approval_acceptance_allowed:false,
    blocker_waiver_allowed:false,
    evidence_recording_allowed:false,
    packet_persistence_allowed:false,
    attachment_persistence_allowed:false,
    readback_persistence_allowed:false,
    live_mutation_allowed:false,
    evidence_recorded:false
  })) as $entries |
  ($entries | map(select(.operator_visible == true
    and .attachment_visible == true
    and .transport_boundary_confirmed == true
    and .credential_boundary_readback_visible == true
    and .credential_boundary_status == "closed_no_read"
    and .credential_attestation_state == "missing"
    and .credential_read_allowed == false
    and .credential_read_attempted == false
    and .credential_material_load_allowed == false
    and .credential_material_loaded == false
    and .credential_value_exposure_allowed == false
    and .credential_value_exposed == false
    and .credential_handle_resolution_allowed == false
    and .credential_handle_resolved == false
    and .credential_secret_material_visible == false
    and .live_mutation_allowed == false)) | length) as $credential_boundary_ready_count |
  ($entries | map(select(.credential_boundary_status == "closed_no_read")) | length) as $credential_boundary_closed_count |
  ($entries | map(select(.credential_read_allowed == false and .credential_read_attempted == false)) | length) as $credential_read_blocked_count |
  ($entries | map(select(.credential_material_load_allowed == false and .credential_material_loaded == false)) | length) as $credential_material_load_blocked_count |
  ($entries | map(select(.credential_value_exposure_allowed == false and .credential_value_exposed == false)) | length) as $credential_value_exposure_blocked_count |
  ($entries | map(select(.credential_handle_resolution_allowed == false and .credential_handle_resolved == false)) | length) as $credential_handle_resolution_blocked_count |
  ($entries | map(select(.credential_attestation_state == "missing")) | length) as $credential_attestation_missing_count |
  ($entries | map(select(.evidence_recorded == true)) | length) as $evidence_recorded_count |
  ($entries | map(select(.blocker_waiver_allowed == true)) | length) as $blocker_waived_count |
  ($transport.transport_boundary_readback_ready == true
    and $transport.transport_boundary_entry_count == 7
    and $transport.transport_boundary_ready_count == 7
    and $transport.gateway_auth_boundary_closed_count == 7
    and $transport.native_post_boundary_closed_count == 7
    and $transport.telegram_transport_boundary_closed_count == 7
    and $transport.channel_send_boundary_closed_count == 7
    and $transport.packet_send_attempted == false
    and $transport.attachment_send_attempted == false
    and $transport.approval_request_sent == false
    and $transport.approval_accepted == false
    and $transport.credential_read_allowed == false
    and $transport.packet_persisted == false
    and $transport.attachment_persisted == false
    and $transport.readback_persisted == false
    and $lib_export_present == true
    and ($entries | length) == 7
    and $credential_boundary_ready_count == 7
    and $credential_boundary_closed_count == 7
    and $credential_read_blocked_count == 7
    and $credential_material_load_blocked_count == 7
    and $credential_value_exposure_blocked_count == 7
    and $credential_handle_resolution_blocked_count == 7
    and $credential_attestation_missing_count == 7
    and $evidence_recorded_count == 0
    and $blocker_waived_count == 0
    and ($entries | all(.observed_state == "credential_boundary_closed_no_read"
      and .previous_state == "missing"
      and .current_state == "missing"
      and .state_delta == "unchanged_missing"
      and .approval_request_allowed == false
      and .approval_acceptance_allowed == false
      and .credential_read_allowed == false
      and .credential_material_load_allowed == false
      and .credential_value_exposure_allowed == false
      and .credential_handle_resolution_allowed == false
      and .evidence_recording_allowed == false
      and .packet_persistence_allowed == false
      and .attachment_persistence_allowed == false
      and .readback_persistence_allowed == false
      and .live_mutation_allowed == false))) as $credential_boundary_readback_ready |
  {
    runtime:"hepta",
    surface:"controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback",
    status:(if $credential_boundary_readback_ready then "ready_blocked" else "blocked" end),
    gate:"controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback_gate",
    schema_version:"controlled_live_required_evidence_gap_operator_packet_attachment_credential_boundary_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    source_transport_boundary_readback_ready:$transport.transport_boundary_readback_ready,
    source_transport_boundary_entry_count:$transport.transport_boundary_entry_count,
    source_transport_boundary_ready_count:$transport.transport_boundary_ready_count,
    lib_export_present:$lib_export_present,
    credential_boundary_entry_count:($entries | length),
    credential_boundary_ready_count:$credential_boundary_ready_count,
    credential_boundary_closed_count:$credential_boundary_closed_count,
    credential_read_blocked_count:$credential_read_blocked_count,
    credential_material_load_blocked_count:$credential_material_load_blocked_count,
    credential_value_exposure_blocked_count:$credential_value_exposure_blocked_count,
    credential_handle_resolution_blocked_count:$credential_handle_resolution_blocked_count,
    credential_attestation_missing_count:$credential_attestation_missing_count,
    evidence_recorded_count:$evidence_recorded_count,
    blocker_waived_count:$blocker_waived_count,
    packet_send_attempted:false,
    attachment_send_attempted:false,
    approval_request_ready:false,
    approval_request_sent:false,
    approval_acceptance_ready:false,
    approval_accepted:false,
    approval_recorded:false,
    credential_read_allowed:false,
    credential_material_load_allowed:false,
    credential_value_exposure_allowed:false,
    credential_handle_resolution_allowed:false,
    evidence_recording_allowed:false,
    evidence_persisted:false,
    packet_persisted:false,
    attachment_persisted:false,
    readback_persisted:false,
    gateway_or_auth_mutation_allowed:false,
    native_post_mutation_allowed:false,
    telegram_transport_mutation_allowed:false,
    channel_send_allowed:false,
    transport_mutation_allowed:false,
    controlled_live_cutover_ready:false,
    live_execution_allowed:false,
    credential_boundary_readback_ready:$credential_boundary_readback_ready,
    entries:$entries,
    next_actions:[
      "phase5m_controlled_live_required_evidence_gap_operator_packet_attachment_rollback_rehearsal_boundary_readback_without_execution",
      "keep_credential_reads_material_loads_and_value_exposure_closed"
    ],
    next_migration_step:"phase5m_controlled_live_required_evidence_gap_operator_packet_attachment_rollback_rehearsal_boundary_readback_without_execution",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      approval_requested:false,
      approval_accepted:false,
      approval_recorded:false,
      evidence_recorded:false,
      evidence_persisted:false,
      blocker_waived:false,
      credential_read:false,
      credential_material_loaded:false,
      credential_value_exposed:false,
      credential_handle_resolved:false,
      packet_sent:false,
      attachment_sent:false,
      packet_persisted:false,
      attachment_persisted:false,
      readback_persisted:false,
      ledger_written:false,
      workflow_event_log_written:false,
      sqlite_written:false,
      native_post_mutation_performed:false,
      gateway_or_auth_mutated:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      replay_executed:false,
      rollback_executed:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }'
