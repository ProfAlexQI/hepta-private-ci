#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-operator-approval-decision-preflight.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-operator-approval-receipt-projection.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_OPERATOR_APPROVAL_DECISION_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-operator-approval-decision-preflight-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution operator approval decision preflight report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable execution operator approval receipt projection gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution operator approval decision preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution operator approval decision preflight report"
fi

grep -q 'Operator Approval Decision Preflight' "$DOC" \
  || fail "architecture note must document Operator Approval Decision Preflight"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'pending explicit approval' "$DOC" \
  || fail "architecture note must document pending explicit approval"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_operator_approval_decision_preflight"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_receipt_projection_surface == "tool_execution_operator_approval_receipt_projection"
  and .source_receipt_projection_ready == true
  and .source_operator_decision_write_allowed == false
  and .source_live_cutover_allowed == false
  and .operator_decision_policy_present == true
  and .operator_identity_binding_present == true
  and .operator_decision_record_written == false
  and .operator_decision_receipt_written == false
  and .operator_acceptance_present == false
  and .approval_request_sent == false
  and .canary_cutover_switch_enabled == false
  and .live_cutover_switch_enabled == false
  and .candidate_count == 2
  and .operator_approval_decision_preflight_ready_count == 2
  and .operator_approval_decision_preflight_blocked_count == 0
  and .operator_decision_pending_count == 2
  and .operator_decision_write_blocked_count == 2
  and .operator_acceptance_blocked_count == 2
  and .all_receipt_projections_bound_to_decision_preflight == true
  and .all_decision_preflight_entries_keep_approval_guard == true
  and .tool_execution_operator_approval_decision_preflight_ready == true
  and .tool_execution_operator_decision_acceptance_allowed == false
  and .tool_execution_canary_cutover_allowed == false
  and .tool_execution_live_cutover_allowed == false
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .execution_adapter_dispatched == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .operator_decision_record_written_flag == false
  and .operator_decision_receipt_written_flag == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_canary_cutover_plan_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .source_receipt_projection_route == "operator_approval_receipt_projection_ready" and .registry_guard_route == "require_approval_ledger" and .operator_approval_decision_preflight_route == "operator_approval_decision_pending_explicit_approval" and .operator_approval_decision_preflight_ready == true and .operator_decision_pending == true and .operator_decision_write_blocked == true and .operator_acceptance_blocked == true and .operator_decision_record_written == false and .operator_decision_receipt_written == false and .operator_acceptance_present == false and .approval_request_sent == false and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .source_receipt_projection_route == "operator_approval_receipt_projection_ready" and .registry_guard_route == "require_approval_ledger" and .operator_approval_decision_preflight_route == "operator_approval_decision_pending_explicit_approval" and .operator_approval_decision_preflight_ready == true and .operator_decision_pending == true and .operator_decision_write_blocked == true and .operator_acceptance_blocked == true and .operator_decision_record_written == false and .operator_decision_receipt_written == false and .operator_acceptance_present == false and .approval_request_sent == false and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("operator_decision_pending_explicit_approval")) != null
  and (.blockers | index("canary_cutover_switch_disabled")) != null
  and (.next_actions | index("restore_tool_execution_canary_cutover_plan_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_operator_approval_decision_preflight --quiet
)

printf 'hepta-systems-tool-execution-operator-approval-decision-preflight-gate: PASS: operator approval decisions remain pending while canary and live cutover stay disabled\n'
