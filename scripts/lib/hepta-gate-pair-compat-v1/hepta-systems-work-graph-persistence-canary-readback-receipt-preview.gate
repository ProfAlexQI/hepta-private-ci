#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-canary-readback-receipt-preview.report"

report="$(capture_json_report "hepta-work-graph-persistence-canary-readback-receipt-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_persistence_canary_readback_receipt_preview_gate"
  and .schema_version == "work_graph_persistence_canary_readback_receipt_preview_v1"
  and .preview_mode == "read_only_persistence_canary_readback_receipt_preview_no_receipt_write"
  and .receipt_contract_count == 6
  and (.receipt_contracts | length) == .receipt_contract_count
  and (.receipt_contracts | map(.source_dry_run_scenario_id) == [
    "canary_store_persistence_dry_run",
    "canary_wal_append_dry_run",
    "canary_checkpoint_write_dry_run",
    "canary_readback_receipt_dry_run",
    "canary_idempotency_index_dry_run",
    "canary_replay_execution_dry_run"
  ])
  and (.receipt_contracts | all(
    .redaction_state == "redacted_hash_only"
    and .persistence_enabled == false
    and .external_delivery_enabled == false
    and (.required_fields | index("priorGateReportHash"))
    and (.required_fields | index("zeroTrafficProof"))
    and (.required_fields | index("zeroWriteProof"))
    and (.required_fields | index("redactionState"))
    and (.required_fields | index("workflow_id"))
    and (.required_fields | index("run_id"))
    and (.required_fields | index("step_id"))
    and (.required_fields | index("checkpoint"))
    and (.required_fields | index("replay_key"))
    and (.required_fields | index("rollback_anchor"))
    and (.required_fields | index("receipt_hash"))
  ))
  and .digest_check_count == 6
  and (.digest_checks | length) == .digest_check_count
  and (.digest_checks | map(.id) == [
    "check_prior_gate_digest_hash",
    "check_feature_flag_digest_hash",
    "check_canary_evidence_hash",
    "check_zero_write_and_traffic_hash",
    "check_rollback_guard_hash",
    "check_durable_identity_digest_hash"
  ])
  and (.digest_checks | all(.blocks_promotion == true and (.compared_fields | length) >= 3))
  and .denial_reason_count == 7
  and (.denial_reasons | length) == .denial_reason_count
  and (.denial_reasons | map(.id) == [
    "missing_prior_gate_digest",
    "feature_flag_not_default_off",
    "canary_evidence_hash_missing",
    "zero_write_or_traffic_not_proven",
    "rollback_guard_receipt_missing",
    "receipt_redaction_missing",
    "durable_identity_evidence_missing"
  ])
  and (.denial_reasons | all(.blocks_promotion == true and (.applies_to_receipt_ids | length) == 6))
  and .operator_view_count == 4
  and (.operator_views | length) == .operator_view_count
  and (.operator_views | map(.id) == [
    "operator_canary_receipt_summary",
    "auditor_canary_digest_view",
    "rollback_receipt_preview_view",
    "promotion_blocker_packet_view"
  ])
  and (.operator_views | all(
    .external_delivery_enabled == false
    and (.required_fields | length) >= 4
    and (.required_fields | index("workflow_id"))
    and (.required_fields | index("receipt_hash"))
  ))
  and .durable_identity_evidence.schema_version == "work_graph_durable_identity_preview_v1"
  and .durable_identity_evidence.required_prior_gate == "hepta_work_graph_durable_identity_preview_gate"
  and .durable_identity_evidence.required_field_ids == [
    "workflow_id",
    "run_id",
    "step_id",
    "checkpoint",
    "replay_key",
    "rollback_anchor",
    "receipt_hash"
  ]
  and .durable_identity_evidence.required_for_receipt_contract_ids == [
    "store_persistence_canary_receipt",
    "wal_append_canary_receipt",
    "checkpoint_write_canary_receipt",
    "readback_receipt_canary_receipt",
    "idempotency_index_canary_receipt",
    "replay_execution_canary_receipt"
  ]
  and .durable_identity_evidence.durable_field_count == 7
  and .durable_identity_evidence.preview_binding_count == 5
  and .durable_identity_evidence.invariant_count == 7
  and .durable_identity_evidence.currently_satisfied == false
  and .invariant_count == 7
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "canary_readback_receipts_require_durable_identity_evidence",
    "canary_receipts_are_hash_only",
    "canary_receipts_require_prior_gate_digest",
    "canary_receipts_prove_zero_write_and_traffic",
    "canary_receipt_denials_block_promotion",
    "operator_views_are_not_external_delivery",
    "persistence_canary_readback_receipt_preview_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and (.required_prior_gates == [
    "hepta_work_graph_contract_preview_gate",
    "hepta_work_graph_task_result_contract_preview_gate",
    "hepta_work_graph_scheduler_admission_controller_preview_gate",
    "hepta_work_graph_observability_timeline_preview_gate",
    "hepta_work_graph_role_manifest_contract_preview_gate",
    "hepta_work_graph_unified_state_store_preview_gate",
    "hepta_work_graph_adapter_projection_fixture_gate",
    "hepta_work_graph_state_store_persistence_preview_gate",
    "hepta_work_graph_replay_readback_preview_gate",
    "hepta_work_graph_promotion_precondition_preview_gate",
    "hepta_work_graph_activation_enforcement_blocker_preview_gate",
    "hepta_work_graph_shadow_adapter_readback_preview_gate",
    "hepta_work_graph_persistence_feature_flag_preview_gate",
    "hepta_work_graph_persistence_canary_dry_run_preview_gate",
    "hepta_work_graph_durable_identity_preview_gate"
  ])
  and .recommended_next_gate == "hepta_work_graph_persistence_promotion_blocker_preview_gate"
  and .ready_for_promotion_blocker_preview == true
  and .ready_for_receipt_persistence == false
  and .ready_for_live_persistence == false
  and .source_probes.persistence_canary_readback_receipt.rust_module_present == true
  and .source_probes.persistence_canary_readback_receipt.report_script_present == true
  and .source_probes.persistence_canary_readback_receipt.gate_script_present == true
  and .source_probes.persistence_canary_dry_run.gate_script_present == true
  and .source_probes.persistence_feature_flag.gate_script_present == true
  and .source_probes.durable_identity.rust_module_present == true
  and .source_probes.durable_identity.report_script_present == true
  and .source_probes.durable_identity.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_persistence_canary_readback_receipt_preview --lib

echo "Hepta WorkGraph persistence canary readback receipt preview gate passed"
