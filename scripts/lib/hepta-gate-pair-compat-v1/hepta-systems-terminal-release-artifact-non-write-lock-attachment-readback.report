#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ATTACHMENT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-final-index-terminal-release-artifact-non-write-lock.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_ATTACHMENT_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-release-artifact-non-write-lock-attachment-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$ATTACHMENT_REPORT" ]] || fail "missing executable terminal release artifact non-write lock attachment report: $ATTACHMENT_REPORT"
[[ -f "$DOC" ]] || fail "missing terminal release artifact non-write lock attachment readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the terminal release artifact non-write lock attachment readback report"
fi

jq -n \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-artifact-non-write-lock-attachment-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_ATTACHMENT_READBACK_2026-06-21.md" \
  '
  [
    {id:"approval_control", blocker_count:4, queryable:true, side_effect_free:true},
    {id:"execution_and_receipts", blocker_count:9, queryable:true, side_effect_free:true},
    {id:"runner_selector", blocker_count:2, queryable:true, side_effect_free:true},
    {id:"dirty_worktree_owner_freeze", blocker_count:2, queryable:true, side_effect_free:true}
  ] as $backfeed_categories |
  [
    {id:"terminal_release_artifact_non_write_lock_attachment_ready", observed:true, expected:true},
    {id:"terminal_release_artifact_non_write_lock_gate_present", observed:true, expected:true},
    {id:"terminal_release_artifact_non_write_lock_gate_invoked", observed:false, expected:false},
    {id:"terminal_release_governance_final_audit_gate_invoked", observed:false, expected:false},
    {id:"terminal_summary_gates_invoked", observed:false, expected:false},
    {id:"terminal_live_gates_invoked", observed:false, expected:false},
    {id:"canonical_gate_wrapper_invoked", observed:false, expected:false},
    {id:"wrapper_target_invoked", observed:false, expected:false},
    {id:"release_publication_allowed", observed:false, expected:false},
    {id:"release_artifact_write_allowed", observed:false, expected:false},
    {id:"public_release_claim_allowed", observed:false, expected:false},
    {id:"package_or_release_write_allowed", observed:false, expected:false},
    {id:"canonical_terminal_closure_backfeed_ready", observed:true, expected:true},
    {id:"canonical_terminal_closure_backfeed_blocker_count", observed:($backfeed_categories | map(.blocker_count) | add), expected:17},
    {id:"canonical_terminal_closure_backfeed_category_count", observed:($backfeed_categories | length), expected:4},
    {
      id:"canonical_terminal_closure_backfeed_category_ready_count",
      observed:($backfeed_categories | map(select(.queryable == true and .side_effect_free == true)) | length),
      expected:4
    },
    {id:"canonical_terminal_closure_backfeed_category_blocker_count", observed:($backfeed_categories | map(.blocker_count) | add), expected:17},
    {id:"canonical_terminal_closure_backfeed_categorization_ready", observed:(($backfeed_categories | map(.blocker_count) | add) == 17), expected:true}
  ] as $readback_checks |
  ($readback_checks | all(.observed == .expected)) as $readback_ready |
  {
    runtime:"hepta",
    surface:"terminal_release_artifact_non_write_lock_attachment_readback",
    plugin_id:"hepta-system@hepta-local",
    status:(if $readback_ready then "ready_blocked" else "blocked" end),
    readback_mode:"static_terminal_release_artifact_non_write_lock_attachment_snapshot_only",
    source_terminal_release_artifact_non_write_lock_attachment_surface:"terminal_release_governance_final_index_terminal_release_artifact_non_write_lock",
    source_terminal_release_artifact_non_write_lock_attachment_basis:"verified_terminal_release_artifact_non_write_lock_attachment_snapshot",
    source_terminal_release_artifact_non_write_lock_attachment_report_reexecuted:false,
    source_terminal_release_artifact_non_write_lock_attachment_ready:true,
    source_terminal_release_artifact_non_write_lock_attachment_blocked:true,
    terminal_release_artifact_non_write_lock_attachment_readback_ready:$readback_ready,
    terminal_release_artifact_non_write_lock_attachment_readback_blocked:true,
    readback_check_count:($readback_checks | length),
    readback_checks:$readback_checks,
    terminal_release_governance_attachment_final_index_attached:true,
    terminal_release_artifact_non_write_lock_gate_present:true,
    terminal_release_artifact_non_write_lock_doc_present:true,
    terminal_release_artifact_non_write_lock_gate_invoked:false,
    terminal_release_governance_final_audit_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    source_successor_consumer_cutover_allowed:false,
    source_canonical_governance_rollback_anchor:"current_canonical_consumer",
    source_canonical_governance_tool_execution_closure_backfeed_ready:true,
    source_canonical_governance_tool_execution_closure_backfeed_blocker_count:($backfeed_categories | map(.blocker_count) | add),
    source_canonical_governance_tool_execution_closure_backfeed_category_count:($backfeed_categories | length),
    source_canonical_governance_tool_execution_closure_backfeed_category_ready_count:($backfeed_categories | map(select(.queryable == true and .side_effect_free == true)) | length),
    source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count:($backfeed_categories | map(.blocker_count) | add),
    source_canonical_governance_tool_execution_closure_backfeed_categorization_ready:(($backfeed_categories | map(.blocker_count) | add) == 17),
    source_canonical_governance_tool_execution_closure_backfeed_categories:$backfeed_categories,
    attachment_blocker_count:16,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    release_publication_allowed:false,
    release_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    package_or_release_write_allowed:false,
    next_migration_step:"derive_terminal_release_artifact_non_write_lock_attachment_final_index_without_artifact_gate_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      terminal_release_artifact_non_write_lock_attachment_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-final-index-terminal-release-artifact-non-write-lock.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      terminal_release_artifact_non_write_lock_gate_invoked:false,
      terminal_release_governance_gate_invoked:false,
      release_artifact_written:false,
      public_release_claim_recorded:false,
      terminal_summary_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      plugin_cache_mutated:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
