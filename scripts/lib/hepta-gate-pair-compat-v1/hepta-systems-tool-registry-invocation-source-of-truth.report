#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ROUTER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-router-preflight-binding.report"
RUST_SOURCE="$ROOT/codex-rs/tools/src/tool_registry_invocation_source_of_truth.rs"
GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-invocation-source-of-truth.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_REGISTRY_INVOCATION_SOURCE_OF_TRUTH_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-registry-invocation-source-of-truth-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$ROUTER_REPORT" ]] || fail "missing executable router preflight report: $ROUTER_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing tool registry invocation source-of-truth Rust source: $RUST_SOURCE"
[[ -f "$DOC" ]] || fail "missing tool registry invocation source-of-truth architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the tool registry invocation source-of-truth report"
fi

jq -n \
  --slurpfile router <("$ROUTER_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-invocation-source-of-truth.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TOOL_REGISTRY_INVOCATION_SOURCE_OF_TRUTH_2026-06-21.md" \
  '
  def invocation_entry($entry):
    ($entry.router_decision_route == "forward_require_approval_ledger_dry_run") as $forwarded |
    {
      plugin_id:$entry.plugin_id,
      candidate_tool_id:$entry.candidate_tool_id,
      contribution_kind:$entry.contribution_kind,
      router_decision_route:$entry.router_decision_route,
      registry_guard_route:$entry.registry_guard_route,
      invocation_source_route:(if $forwarded then "approval_ledger_dry_run_source_only" elif $entry.router_decision_route == "block_source_registry" then "blocked_by_source_registry" else "blocked_by_router_preflight" end),
      invocation_source_ready:($forwarded and $entry.registry_guard_route == "require_approval_ledger"),
      router_registration_lookup_enabled:false,
      registry_source_of_truth_enabled:false,
      tool_registration_enabled:false,
      tool_invocation_enabled:false,
      ledger_write_enabled:false,
      approval_request_enabled:false,
      side_effect_free:true
    };

  ($router[0]) as $router |
  ($router.entries | map(invocation_entry(.))) as $entries |
  ($entries | map(select(.invocation_source_ready == true)) | length) as $ready_count |
  ($entries | map(select(.invocation_source_route == "approval_ledger_dry_run_source_only")) | length) as $dry_run_count |
  {
    runtime:"hepta",
    surface:"tool_registry_invocation_source_of_truth",
    plugin_id:$router.plugin_id,
    status:"ready",
    source_router_preflight_surface:$router.surface,
    source_router_preflight_ready:$router.invocation_router_preflight_binding_ready,
    source_router_forward_count:$router.router_forward_require_approval_ledger_count,
    candidate_count:($entries | length),
    invocation_source_ready_count:$ready_count,
    invocation_source_blocked_count:(($entries | length) - $ready_count),
    approval_ledger_dry_run_source_count:$dry_run_count,
    all_forwarded_candidates_bound_to_invocation_source:($ready_count == $router.router_forward_require_approval_ledger_count and $dry_run_count == $router.router_forward_require_approval_ledger_count),
    all_invocation_sources_keep_approval_ledger_guard:($entries | all(if .invocation_source_route == "approval_ledger_dry_run_source_only" then (.registry_guard_route == "require_approval_ledger" and .router_registration_lookup_enabled == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end)),
    invocation_source_of_truth_plan_ready:true,
    router_registration_lookup_enabled:false,
    registry_source_of_truth_enabled:false,
    tool_registration_enabled:false,
    tool_invocation_enabled:false,
    ledger_written:false,
    approval_requested:false,
    live_mutation_ready:false,
    next_migration_step:"restore_tool_registry_registration_lookup_cutover_preflight_without_execution",
    entries:$entries,
    blockers:[
      "router_registration_lookup_disabled",
      "registry_source_of_truth_enablement_disabled",
      "tool_registration_disabled",
      "tool_invocation_disabled",
      "ledger_write_disabled",
      "approval_request_disabled"
    ],
    next_actions:[
      "restore_tool_registry_registration_lookup_cutover_preflight_without_execution",
      "keep_invocation_source_of_truth_read_only_until_cutover",
      "keep_registration_invocation_ledger_and_approval_disabled_until_explicit_cutover"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      rust_contract:"codex-rs/tools/src/tool_registry_invocation_source_of_truth.rs",
      router_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-router-preflight-binding.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      plugin_cache_mutated:false,
      plugin_installed:false,
      manifest_rewritten:false,
      manifest_schema_written:false,
      registry_source_of_truth_enabled:false,
      router_registration_lookup_enabled:false,
      registration_cutover_executed:false,
      tool_registered:false,
      tool_invoked:false,
      tool_ledger_written:false,
      approval_requested:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      local_storage_created:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
