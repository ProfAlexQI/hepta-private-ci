#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-index.report"
BRIDGE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-terminal-governance-bridge.gate"
PATCH_QUEUE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-session-patch-queue.gate"
SNAPSHOT_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-missing-path-snapshot-evidence.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_CANONICAL_SUMMARY_ATTACHMENT_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-canonical-summary-attachment-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable canonical summary attachment index report: $REPORT"
[[ -x "$BRIDGE_GATE" ]] || fail "missing executable terminal governance bridge gate: $BRIDGE_GATE"
[[ -x "$PATCH_QUEUE_GATE" ]] || fail "missing executable session patch queue gate: $PATCH_QUEUE_GATE"
[[ -x "$SNAPSHOT_GATE" ]] || fail "missing executable historical canonical missing path snapshot evidence gate: $SNAPSHOT_GATE"
[[ -f "$DOC" ]] || fail "missing canonical summary attachment index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the canonical summary attachment index report"
fi

grep -q 'Canonical Summary Attachment Index' "$DOC" \
  || fail "architecture note must document Canonical Summary Attachment Index"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'does not replay historical patches' "$DOC" \
  || fail "architecture note must document historical patch non-replay"
grep -q 'snapshot evidence' "$DOC" \
  || fail "architecture note must document snapshot evidence"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_canonical_summary_attachment_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_terminal_governance_bridge_surface == "tool_execution_terminal_governance_bridge"
  and .source_terminal_governance_bridge_ready == true
  and .source_manual_operator_live_cutover_approval_required == true
  and .source_live_cutover_allowed == false
  and .source_public_ga_allowed == false
  and .source_terminal_live_gates_invoked == false
  and .source_long_soak_required == false
  and .source_patch_queue_surface == "hepta_systems_session_patch_queue"
  and .source_patch_queue_ready == true
  and .source_patch_replay_applied == false
  and .source_patch_replay_enabled == false
  and .source_patch_body_emitted == false
  and .source_snapshot_surface == "historical_canonical_missing_path_snapshot_evidence"
  and .source_snapshot_ready == true
  and .source_snapshot_decouples_from_current_filesystem_state == true
  and .canonical_summary_probe_basis == "historical_snapshot_evidence"
  and .canonical_summary_current_filesystem_probe_used == false
  and .canonical_summary_probe_count == 8
  and .canonical_summary_present_count == 0
  and .current_checkout_missing_canonical_summary == true
  and .historical_snapshot_missing_canonical_summary == true
  and .historical_snapshot_evidence_consumable_after_wrapper_creation == true
  and .canonical_summary_available == false
  and (.canonical_source_probes | length) == 8
  and (.canonical_source_probes | all(.present == false and .probe_basis == "historical_snapshot_evidence"))
  and (.missing_canonical_source_ids | index("hepta_systems_canonical_gate")) != null
  and (.missing_canonical_source_ids | index("hepta_systems_capability_matrix_gate")) != null
  and (.missing_canonical_source_ids | index("hepta_systems_canonical_gate_matrix_doc")) != null
  and .historical_compact_capability_matrix_patch_call_count >= 1
  and .historical_compact_capability_matrix_missing_path_count >= 1
  and (.selected_reconstruction_candidate.call_id // "") != ""
  and (.selected_reconstruction_candidate.touched_paths | index("scripts/hepta-systems-canonical-gate.sh")) != null
  and (.selected_reconstruction_candidate.touched_paths | index("docs/architecture/HEPTA_SYSTEMS_CANONICAL_GATE_MATRIX_2026-06-12.md")) != null
  and .selected_reconstruction_candidate.patch_body_emitted == false
  and .selected_reconstruction_candidate.replay_applied == false
  and .attach_to_existing_canonical_summary_allowed == false
  and .canonical_summary_mutation_allowed == false
  and .tool_execution_canonical_summary_attachment_index_ready == true
  and .tool_execution_live_cutover_allowed == false
  and .tool_execution_public_ga_allowed == false
  and .next_migration_step == "migrate_compact_restore_preflight_to_snapshot_evidence_source_before_wrapper_creation"
  and (.attachment_blockers | index("historical_snapshot_canonical_summary_entrypoint_missing")) != null
  and (.attachment_blockers | index("manual_operator_live_cutover_approval_required")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$BRIDGE_GATE" >/dev/null
"$PATCH_QUEUE_GATE" >/dev/null
"$SNAPSHOT_GATE" >/dev/null

printf 'hepta-systems-tool-execution-canonical-summary-attachment-index-gate: PASS: canonical attachment index captures missing current summary without replay or invocation\n'
