#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-final-index.report"
READBACK_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-readback.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_AUDIT_EVIDENCE_FINAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-final-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable audit evidence final index report: $REPORT"
[[ -x "$READBACK_GATE" ]] || fail "missing executable audit evidence readback gate: $READBACK_GATE"
[[ -f "$DOC" ]] || fail "missing audit evidence final index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the audit evidence final index report"
fi

grep -q 'Terminal Public Claim Delivery Receipt Audit Evidence Final Index' "$DOC" \
  || fail "architecture note must document terminal public claim delivery receipt audit evidence final index"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that final index does not invoke target gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_final_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_readback_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_readback_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_final_index_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_denial_gate_invoked == false
  and .artifact_signing_terminal_public_claim_delivery_receipt_cancellation_supersession_denial_gate_invoked == false
  and .long_soak_started == false
  and .public_ga_claimed == false
  and .terminal_public_claim_delivery_receipt_audit_evidence_recorded == false
  and .terminal_public_claim_delivery_receipt_audit_trail_recorded == false
  and .terminal_public_claim_delivery_receipt_immutable_evidence_recorded == false
  and .terminal_public_claim_delivery_receipt_hash_chain_recorded == false
  and .terminal_public_claim_delivery_receipt_attestation_recorded == false
  and .terminal_public_claim_delivery_receipt_ledger_recorded == false
  and .terminal_public_claim_delivery_receipt_index_recorded == false
  and .terminal_public_claim_delivery_receipt_observability_evidence_recorded == false
  and .operator_approval_from_delivery_receipt_audit_evidence_derived == false
  and .release_publication_authority_from_delivery_receipt_audit_evidence_derived == false
  and .activation_authority_from_delivery_receipt_audit_evidence_derived == false
  and .install_from_delivery_receipt_audit_evidence_executed == false
  and .service_restart_from_delivery_receipt_audit_evidence_performed == false
  and .active_binary_from_delivery_receipt_audit_evidence_mutated == false
  and .provider_invoked == false
  and .model_invoked == false
  and .credential_read == false
  and .secret_file_read == false
  and .final_blocker_count == 100
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "attach_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_final_index_to_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_retention_expiry_gc_without_audit_evidence"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$READBACK_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-final-index-gate: PASS: artifact signing terminal public claim delivery receipt audit evidence final index is ready but blocked\n'
