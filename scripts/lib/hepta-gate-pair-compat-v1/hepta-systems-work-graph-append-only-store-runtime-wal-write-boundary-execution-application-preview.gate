#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-append-only-store-runtime-wal-write-boundary-execution-application-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-append-only-store-runtime-wal-write-boundary-execution-application-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_append_only_store_runtime_wal_write_boundary_execution_application_preview_gate"
  and .schema_version == "work_graph_append_only_store_runtime_wal_write_boundary_execution_application_preview_v1"
  and .preview_mode == "read_only_append_only_store_runtime_wal_write_boundary_execution_application_no_index_mutation"
  and .readback_plan_count == 12
  and .application_plan_count == 12
  and .source_outcome_count == 12
  and .wal_write_boundary_execution_contract_ready_preview_count == 12
  and .stage_application_count == 5
  and .evidence_field_application_count == 12
  and .guard_application_count == 8
  and .blocker_application_count == 3
  and .application_guard_count == 10
  and .blocker_count == 4
  and .required_prior_gate_count == 70
  and .stage_source_ref_count == 60
  and .stage_contract_ref_count == 28
  and .plan_stage_ref_count == 60
  and .evidence_field_ref_count == 108
  and .blocker_mapping_source_ref_count == 36
  and .blocker_mapping_stage_ref_count == 13
' >/dev/null <<<"$report"

jq -e '
  (.application_plans | all(
    .application_scope == "wal_write_boundary_execution_application_binding"
    and .application_state == "preview_application_defined_wal_write_boundary_execution_not_enabled"
    and .readback_verified_by_preview == true
    and .wal_write_boundary_execution_policy_contract_ready_preview == true
    and .collision_replay_evidence_contract_ready_preview == true
    and .applies_to_runtime == false
    and .writes_wal == false
    and .writes_checkpoint == false
    and .mutates_idempotency_index == false
    and .executes_replay == false
    and .executes_readback == false
    and .executes_rollback == false
    and .mutates_runtime == false
    and (.required_wal_write_boundary_execution_stage_ids | length) == 5
    and (.expected_evidence_field_ids | length) == 9
  ))
  and (.source_outcomes | all(
    .post_application_wal_write_boundary_execution_state == "wal_write_boundary_execution_contract_ready_preview_after_application"
    and .wal_write_boundary_execution_policy_contract_ready_preview == true
    and .collision_replay_evidence_contract_ready_preview == true
    and .ready_for_unified_projection_enforcement_readiness_runtime_wal_write_boundary_execution_rerun_preview == true
    and .ready_for_wal_write == false
    and .applies_to_runtime == false
  ))
  and (.stage_applications | all(
    .expected_stage_state == "stage_contract_ready_preview_after_application_runtime_disabled"
    and .stage_contract_ready_preview == true
    and .readback_verified_by_preview == true
    and .enables_runtime_after_application == false
    and .writes_wal == false
    and .writes_checkpoint == false
    and .executes_readback == false
    and .executes_rollback == false
    and .mutates_runtime == false
  ))
' >/dev/null <<<"$report"

jq -e '
  (.blocker_applications | map({id: .blocker_id, count: (.affected_source_surface_ids | length), plans: (.affected_application_plan_ids | length)}) == [
    {"id": "wal_write_boundary_not_enabled", "count": 12, "plans": 12},
    {"id": "wal_write_boundary_execution_readback_missing", "count": 12, "plans": 12},
    {"id": "wal_write_boundary_execution_application_missing", "count": 12, "plans": 12}
  ])
  and (.blockers | map({id, count: (.affected_source_surface_ids | length), plans: (.affected_application_plan_ids | length)}) == [
    {"id": "wal_write_boundary_not_enabled", "count": 12, "plans": 12},
    {"id": "wal_write_boundary_execution_readback_missing", "count": 12, "plans": 12},
    {"id": "wal_write_boundary_execution_application_missing", "count": 12, "plans": 12},
    {"id": "wal_write_boundary_execution_readiness_rerun_missing", "count": 12, "plans": 12}
  ])
  and (.blockers | all(.required_before_wal_write_boundary_execution == true))
  and (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_append_only_store_runtime_wal_write_boundary_execution_readback_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_unified_projection_enforcement_readiness_runtime_wal_write_boundary_execution_rerun_preview_gate"
  and .ready_for_unified_projection_enforcement_readiness_runtime_wal_write_boundary_execution_rerun_preview == true
  and .ready_for_wal_write == false
  and .ready_for_checkpoint_write == false
  and .ready_for_readback_execution == false
  and .ready_for_replay_execution == false
  and .ready_for_rollback_execution == false
  and .ready_for_live_execution == false
  and .source_probes.wal_write_boundary_execution_application.rust_module_present == true
  and .source_probes.wal_write_boundary_execution_application.report_script_present == true
  and .source_probes.wal_write_boundary_execution_application.gate_script_present == true
  and .source_probes.wal_write_boundary_execution_readback.upstream_gate == true
  and .source_probes.wal_write_boundary_execution_readback.gate_script_present == true
  and .source_probes.wal_write_boundary_execution_readback.recommended_next_matches == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_append_only_store_runtime_wal_write_boundary_execution_application --lib

echo "Hepta WorkGraph append-only store runtime WAL write-boundary execution application preview gate passed"
