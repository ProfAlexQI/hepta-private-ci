#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-runtime-rollback-readback-execution-rerun-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-unified-projection-enforcement-readiness-runtime-rollback-readback-execution-rerun-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "blocked"
  and .gate == "hepta_work_graph_unified_projection_enforcement_readiness_runtime_rollback_readback_execution_rerun_preview_gate"
  and .schema_version == "work_graph_unified_projection_enforcement_readiness_runtime_rollback_readback_execution_rerun_preview_v1"
  and .preview_mode == "read_only_projection_enforcement_readiness_runtime_rollback_readback_execution_rerun_no_enforcement"
  and .source_surface_count == 12
  and .rollback_readback_execution_outcome_count == 12
  and .rollback_readback_execution_application_covered_source_count == 12
  and .previous_contract_ready_surface_count == 12
  and .runtime_rollback_readback_execution_rerun_contract_ready_surface_count == 12
  and .previous_rollback_readback_primary_blocked_surface_count == 12
  and .rollback_readback_primary_blocked_surface_count_after == 0
  and .wal_write_primary_blocked_surface_count == 12
  and .rollback_readback_execution_contract_ready_source_count == 12
  and .wal_write_enabled_source_count == 0
  and .durable_store_switch_enabled_source_count == 0
  and .rollback_readback_execution_enabled_source_count == 0
  and .rerun_ready_surface_count == 0
  and .rerun_blocked_surface_count == 12
  and .decision_delta_count == 12
  and .cleared_blocker_count == 1
  and .residual_blocker_count == 1
  and .enforcement_stage_count == 5
  and .required_prior_gate_count == 67
' >/dev/null <<<"$report"

jq -e '
  (.decision_deltas | all(
    .covered_by_rollback_readback_execution_application_preview == true
    and .rollback_readback_execution_primary_gap_closed_by_application_preview == true
    and .runtime_rollback_readback_execution_rerun_enforcement_decision == "deny_runtime_wal_write_boundary_not_enabled"
    and .rollback_readback_execution_contract_ready == true
    and .rollback_readback_execution_applied == false
    and .wal_write_enabled == false
    and .checkpoint_write_enabled == false
    and .readback_execution_enabled == false
    and .rollback_execution_enabled == false
    and .runtime_append_only_store_enabled == false
    and (.residual_source_blocker_ids | index("readback_execution_disabled") | not)
    and (.residual_source_blocker_ids | index("rollback_readback_not_executed") | not)
    and (.residual_source_blocker_ids | index("rollback_readback_execution_readback_missing") | not)
    and (.residual_source_blocker_ids | index("rollback_readback_execution_application_missing") | not)
    and (.residual_source_blocker_ids | index("rollback_readback_execution_readiness_rerun_missing") | not)
    and (.residual_source_blocker_ids | index("wal_write_boundary_not_enabled"))
    and .next_required_gate == "hepta_work_graph_append_only_store_runtime_wal_write_boundary_execution_preview_gate"
  ))
' >/dev/null <<<"$report"

jq -e '
  (.cleared_blockers[0].id == "rollback_readback_execution_required_for_enforcement")
  and (.cleared_blockers[0].source_count_before == 12)
  and (.cleared_blockers[0].source_count_after == 0)
  and (.cleared_blockers[0].closure_gate_id == "hepta_work_graph_append_only_store_runtime_rollback_readback_execution_application_preview_gate")
  and (.residual_blockers | map({id, category, count: (.affected_source_surface_ids | length)}) == [
    {"id": "wal_write_boundary_not_enabled", "category": "wal_replay_prerequisite", "count": 12}
  ])
  and (.residual_blockers | all(.required_before_projection_enforcement == true))
  and (.enforcement_stages | map(.id) == [
    "rollback_readback_execution_contracts",
    "wal_write_boundary_execution",
    "rollback_readback_execution_gate",
    "append_only_store_enablement_dry_run",
    "projection_enforcement_dry_run"
  ])
  and (.enforcement_stages | all(.enforcement_enabled == false and .next_gate == "hepta_work_graph_append_only_store_runtime_wal_write_boundary_execution_preview_gate"))
' >/dev/null <<<"$report"

jq -e '
  (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_append_only_store_runtime_rollback_readback_execution_application_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_append_only_store_runtime_wal_write_boundary_execution_preview_gate"
  and .ready_for_runtime_rollback_readback_execution_preview == true
  and .ready_for_wal_write == false
  and .ready_for_checkpoint_write == false
  and .ready_for_readback_execution == false
  and .ready_for_rollback_execution == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_projection_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.runtime_rollback_readback_execution_readiness_rerun.rust_module_present == true
  and .source_probes.runtime_rollback_readback_execution_readiness_rerun.report_script_present == true
  and .source_probes.runtime_rollback_readback_execution_readiness_rerun.gate_script_present == true
  and .source_probes.runtime_rollback_readback_execution_application.rust_module_present == true
  and .source_probes.runtime_rollback_readback_execution_application.gate_script_present == true
  and .source_probes.runtime_rollback_readback_execution_application.upstream_gate == true
  and .source_probes.runtime_idempotency_mutation_readiness_rerun.upstream_gate == true
  and .source_probes.runtime_idempotency_mutation_readiness_rerun.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_unified_projection_enforcement_readiness_runtime_rollback_readback_execution_rerun --lib

echo "Hepta WorkGraph unified projection enforcement readiness runtime rollback/readback execution rerun preview gate passed"
