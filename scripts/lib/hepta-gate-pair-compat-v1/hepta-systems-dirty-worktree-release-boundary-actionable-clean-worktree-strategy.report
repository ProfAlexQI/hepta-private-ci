#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
GROUPING_FREEZE_OPERATOR_READBACK_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-grouping-freeze-operator-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/dirty_worktree_release_boundary_actionable_clean_worktree_strategy.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_ACTIONABLE_CLEAN_WORKTREE_STRATEGY_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-actionable-clean-worktree-strategy-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$GROUPING_FREEZE_OPERATOR_READBACK_REPORT" ]] || fail "missing executable Phase 13 grouping-freeze operator readback report: $GROUPING_FREEZE_OPERATOR_READBACK_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 14 Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 14 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 14 dirty-worktree clean-worktree strategy report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$GROUPING_FREEZE_OPERATOR_READBACK_REPORT" >"$tmpdir/grouping_freeze_operator_readback.json" \
  || fail "failed to render Phase 13 dirty-worktree grouping-freeze operator readback report"
jq -e . "$tmpdir/grouping_freeze_operator_readback.json" >/dev/null \
  || fail "invalid JSON rendered by Phase 13 dirty-worktree grouping-freeze operator readback report"

lib_export_present=false
if grep -q 'dirty_worktree_release_boundary_actionable_clean_worktree_strategy_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile readback "$tmpdir/grouping_freeze_operator_readback.json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-actionable-clean-worktree-strategy.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_ACTIONABLE_CLEAN_WORKTREE_STRATEGY_2026-06-27.md" \
  '
  def key_safe($value): ($value | gsub("[^A-Za-z0-9._-]"; "_"));
  def route_safe($value): ($value | gsub("[^A-Za-z0-9._-]"; "-"));
  def route_prefix($group_type):
    if $group_type == "top_level" then "top-level"
    elif $group_type == "scope" then "scope"
    else $group_type
    end;
  def recommended_strategy($lane):
    if $lane == "hepta-systems" then "hepta_systems_owned_batch_review"
    elif $lane == "cross-lane-review" or $lane == "external-or-cross-lane" then "cross_lane_owner_review_required"
    elif $lane == "mixed" or $lane == "mixed-hepta-and-cross-lane" then "split_owned_and_cross_lane_review"
    else "operator_classification_required"
    end;
  def operator_action($lane):
    if $lane == "hepta-systems" then "prepare_hepta_systems_clean_plan_for_operator_review"
    elif $lane == "cross-lane-review" or $lane == "external-or-cross-lane" then "request_owner_classification_before_cleanup"
    elif $lane == "mixed" or $lane == "mixed-hepta-and-cross-lane" then "split_group_into_owned_and_cross_lane_subsets"
    else "classify_group_before_any_cleanup"
    end;
  def strategy_entry:
    . as $entry
    | {
      source_readback_key:$entry.readback_key,
      source_readback_route:$entry.readback_route,
      source_diff_key:$entry.diff_key,
      strategy_key:("dirty_worktree.strategy." + $entry.group_type + "." + key_safe($entry.source_bucket)),
      strategy_route:("readback://release-boundary/dirty-worktree/strategy/" + route_prefix($entry.group_type) + "/" + route_safe($entry.source_bucket)),
      group_type:$entry.group_type,
      source_bucket:$entry.source_bucket,
      source_entry_count:$entry.source_entry_count,
      tracked_count:$entry.tracked_count,
      untracked_count:$entry.untracked_count,
      hepta_systems_owned_count:$entry.hepta_systems_owned_count,
      cross_lane_or_unowned_count:$entry.cross_lane_or_unowned_count,
      owner_hint:$entry.owner_hint,
      review_lane:$entry.review_lane,
      recommended_strategy:recommended_strategy($entry.review_lane),
      operator_action:operator_action($entry.review_lane),
      evidence_requirement:"clean_worktree_decision_record_required_before_release",
      execution_mode:"strategy_only_no_git_mutation",
      decision_state:"pending_operator_decision",
      operator_visible:true,
      queryable:true,
      diffable:true,
      strategy_ready:true,
      operator_decision_required:true,
      strategy_applied:false,
      git_mutation_allowed:false,
      cleanup_allowed:false,
      delete_allowed:false,
      evidence_recording_allowed:false,
      release_cutover_allowed:false,
      live_execution_allowed:false
    };
  ($readback[0]) as $readback |
  ($readback.entries | map(strategy_entry)) as $entries |
  ($entries | length) as $strategy_entry_count |
  ($entries | map(.strategy_key) | unique | length) as $stable_strategy_key_count |
  ($entries | map(.strategy_route) | unique | length) as $strategy_route_count |
  ($entries | map(select(.strategy_ready == true)) | length) as $ready_strategy_count |
  ($entries | map(select(.operator_decision_required == true)) | length) as $operator_decision_required_count |
  ($entries | map(select(.git_mutation_allowed == false)) | length) as $no_git_mutation_strategy_count |
  ($entries | map(select(.review_lane == "hepta-systems")) | length) as $hepta_systems_strategy_count |
  ($entries | map(select(.review_lane == "cross-lane-review" or .review_lane == "external-or-cross-lane")) | length) as $cross_lane_strategy_count |
  ($entries | map(select(.review_lane == "mixed" or .review_lane == "mixed-hepta-and-cross-lane")) | length) as $mixed_lane_strategy_count |
  ($entries | map(select(.evidence_recording_allowed == true)) | length) as $evidence_recorded_count |
  ($readback.operator_readback_ready == true
    and $readback.freeze_applied == false
    and $readback.readback_entry_count == $strategy_entry_count
    and $stable_strategy_key_count == $strategy_entry_count
    and $strategy_route_count == $strategy_entry_count
    and $ready_strategy_count == $strategy_entry_count
    and $operator_decision_required_count == $strategy_entry_count
    and $no_git_mutation_strategy_count == $strategy_entry_count
    and $evidence_recorded_count == 0
    and $lib_export_present == true
    and ($entries | all(.operator_visible == true
      and .queryable == true
      and .diffable == true
      and .strategy_ready == true
      and .operator_decision_required == true
      and .strategy_applied == false
      and .git_mutation_allowed == false
      and .cleanup_allowed == false
      and .delete_allowed == false
      and .evidence_recording_allowed == false
      and .release_cutover_allowed == false
      and .live_execution_allowed == false))) as $strategy_ready |
  {
    runtime:"hepta",
    surface:"dirty_worktree_release_boundary_actionable_clean_worktree_strategy",
    status:(if $strategy_ready then "ready_blocked" else "blocked" end),
    gate:"dirty_worktree_release_boundary_actionable_clean_worktree_strategy_gate",
    schema_version:"dirty_worktree_release_boundary_actionable_clean_worktree_strategy_v1",
    plugin_id:$readback.plugin_id,
    source_operator_readback_gate:$readback.gate,
    source_operator_readback_ready:$readback.operator_readback_ready,
    source_freeze_applied:$readback.freeze_applied,
    source_readback_entry_count:$readback.readback_entry_count,
    lib_export_present:$lib_export_present,
    inventory_entry_count:$readback.inventory_entry_count,
    tracked_change_count:$readback.tracked_change_count,
    untracked_change_count:$readback.untracked_change_count,
    strategy_scope:{
      strategy_id:"dirty-worktree.release-boundary.actionable-clean-worktree-strategy.v1",
      strategy_route:"readback://release-boundary/dirty-worktree/actionable-clean-worktree-strategy/v1",
      source_readback_route:$readback.readback_scope.readback_route,
      strategy_mode:"operator_strategy_only",
      action_mode:"no_git_mutation_no_cleanup_no_evidence_recording",
      mutation_boundary:"closed"
    },
    strategy_entry_count:$strategy_entry_count,
    stable_strategy_key_count:$stable_strategy_key_count,
    strategy_route_count:$strategy_route_count,
    ready_strategy_count:$ready_strategy_count,
    operator_decision_required_count:$operator_decision_required_count,
    no_git_mutation_strategy_count:$no_git_mutation_strategy_count,
    hepta_systems_strategy_count:$hepta_systems_strategy_count,
    cross_lane_strategy_count:$cross_lane_strategy_count,
    mixed_lane_strategy_count:$mixed_lane_strategy_count,
    evidence_recorded_count:$evidence_recorded_count,
    strategy_ready:$strategy_ready,
    strategy_applied:false,
    release_cutover_allowed:false,
    git_add_allowed:false,
    git_index_mutated:false,
    git_commit_allowed:false,
    git_push_allowed:false,
    git_reset_allowed:false,
    git_checkout_allowed:false,
    git_revert_allowed:false,
    cleanup_allowed:false,
    delete_allowed:false,
    evidence_recording_allowed:false,
    evidence_persistence_allowed:false,
    approval_acceptance_allowed:false,
    blocker_waiver_allowed:false,
    package_or_release_allowed:false,
    public_ga_allowed:false,
    canary_activation_allowed:false,
    live_activation_allowed:false,
    live_execution_allowed:false,
    entries:$entries,
    blockers:[
      "clean_worktree_strategy_requires_operator_decision",
      "strategy_application_blocked",
      "git_mutation_blocked",
      "cleanup_and_delete_blocked",
      "evidence_recording_blocked",
      "release_cutover_blocked",
      "canary_activation_blocked",
      "live_activation_blocked"
    ],
    next_actions:[
      "phase15_dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_without_git_mutation"
    ],
    next_migration_step:"phase15_dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_without_git_mutation",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      git_commit_created:false,
      git_push_performed:false,
      git_reset_performed:false,
      git_checkout_performed:false,
      git_revert_performed:false,
      cleanup_performed:false,
      unrelated_file_deleted:false,
      strategy_applied:false,
      evidence_recorded:false,
      evidence_persisted:false,
      approval_accepted:false,
      blocker_waived:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      canary_activation_started:false,
      live_activation_started:false,
      live_execution_started:false
    }
  }'
