    sqlite_write_allowed:false,
    sqlite_written:false,
    credential_read_allowed:false,
    live_mutation_allowed:false
  })) as $entries |
  (count_true($entries; "terminal_closeout_projected")) as $terminal_closeout_projected_count |
  (count_true($entries; "terminal_no_persistence_confirmed")) as $terminal_no_persistence_confirmed_count |
  (count_true($entries; "terminal_closeout_key_projected")) as $terminal_closeout_key_projected_count |
  ($entries | map(.terminal_closeout_key) | unique | length) as $terminal_closeout_key_unique_count |
  (count_true($entries; "terminal_readback_route_projected")) as $terminal_readback_route_projected_count |
  (count_true($entries; "source_retention_replay_attached")) as $source_retention_replay_attached_count |
  (count_true($entries; "source_persistence_denial_attached")) as $source_persistence_denial_attached_count |
