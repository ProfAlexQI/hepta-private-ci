#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-live-cutover-operator-packet.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-live-cutover-preflight.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_LIVE_CUTOVER_OPERATOR_PACKET_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-live-cutover-operator-packet-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution live cutover operator packet report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable execution live cutover preflight gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution live cutover operator packet architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution live cutover operator packet report"
fi

grep -q 'Live Cutover Operator Packet' "$DOC" \
  || fail "architecture note must document Live Cutover Operator Packet"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'remaining blocker readback' "$DOC" \
  || fail "architecture note must document remaining blocker readback"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_live_cutover_operator_packet"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_live_cutover_preflight_surface == "tool_execution_live_cutover_preflight"
  and .source_live_cutover_preflight_ready == true
  and .source_live_cutover_allowed == false
  and .operator_packet_template_present == true
  and .operator_session_binding_present == true
  and .operator_packet_rendered == false
  and .approval_request_sent == false
  and .operator_cutover_approval_record_written == false
  and .operator_cutover_acceptance_present == false
  and .live_cutover_switch_enabled == false
  and .candidate_count == 2
  and .live_cutover_operator_packet_ready_count == 2
  and .live_cutover_operator_packet_blocked_count == 0
  and .operator_review_required_count == 1
  and .remaining_blocker_readback_required_count == 1
  and .approval_request_blocked_count == 1
  and .selected_status_canary_count == 1
  and .preflight_only_non_selected_count == 1
  and .all_live_cutover_preflight_entries_bound_to_operator_packet == true
  and .all_live_cutover_operator_packets_keep_no_invocation_guard == true
  and .tool_execution_live_cutover_operator_packet_ready == true
  and .tool_execution_live_cutover_approval_request_allowed == false
  and .tool_execution_live_cutover_allowed == false
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .execution_adapter_dispatched == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_live_cutover_operator_receipt_projection_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .selected_for_status_canary == true and .preflight_only_non_selected_candidate == false and .source_live_cutover_preflight_route == "live_cutover_preflight_ready_pending_approval" and .registry_guard_route == "require_approval_ledger" and .live_cutover_operator_packet_route == "live_cutover_operator_packet_ready_for_review" and .live_cutover_operator_packet_ready == true and .operator_review_required == true and .remaining_blocker_readback_required == true and .approval_request_blocked == true and .explicit_live_cutover_approval_required == true and .explicit_live_cutover_approval_present == false and .operator_packet_template_present == true and .operator_session_binding_present == true and .operator_packet_rendered == false and .approval_request_sent == false and .operator_cutover_approval_record_written == false and .operator_cutover_acceptance_present == false and .live_cutover_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_execution_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .selected_for_status_canary == false and .preflight_only_non_selected_candidate == true and .source_live_cutover_preflight_route == "preflight_only_non_selected_candidate" and .registry_guard_route == "require_approval_ledger" and .live_cutover_operator_packet_route == "preflight_only_non_selected_candidate" and .live_cutover_operator_packet_ready == true and .operator_review_required == false and .remaining_blocker_readback_required == false and .approval_request_blocked == false and .explicit_live_cutover_approval_required == false and .explicit_live_cutover_approval_present == false and .operator_packet_template_present == true and .operator_session_binding_present == true and .operator_packet_rendered == false and .approval_request_sent == false and .operator_cutover_approval_record_written == false and .operator_cutover_acceptance_present == false and .live_cutover_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_execution_switch_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("operator_packet_not_rendered")) != null
  and (.blockers | index("approval_request_not_sent")) != null
  and (.next_actions | index("restore_tool_execution_live_cutover_operator_receipt_projection_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_live_cutover_operator_packet --quiet
)

printf 'hepta-systems-tool-execution-live-cutover-operator-packet-gate: PASS: live cutover operator packets are ready while approval request, dispatch, invocation, and mutation stay disabled\n'
