  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_distribution_artifact_manifest_status_final_index_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_distribution_artifact_manifest_status_readback_attached == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_distribution_artifact_manifest_status_denial_gate_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_distribution_artifact_manifest_status_denial_doc_present == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_signing_receipt_signing_receipt_distribution_artifact_manifest_status_denial_gate_invoked == false
  and .distribution_artifact_manifest_status_recorded == false
  and .distribution_artifact_manifest_status_persisted == false
  and .distribution_artifact_status_exposed == false
  and .manifest_status_exposed == false
  and .package_manifest_materialized == false
  and .release_manifest_published == false
  and .external_status_sent == false
  and .telegram_status_sent == false
  and .operator_approval_from_manifest_status_derived == false
  and .release_publication_authority_from_manifest_status_derived == false
  and .activation_authority_from_manifest_status_derived == false
  and .install_from_manifest_status_executed == false
  and .active_binary_from_manifest_status_mutated == false
