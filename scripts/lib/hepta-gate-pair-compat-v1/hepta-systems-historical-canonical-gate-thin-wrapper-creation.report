#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
IMPACT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-post-claim-impact-preflight.report"
IMPACT_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-post-claim-impact-preflight.gate"
CANONICAL_GATE="$ROOT/scripts/hepta-systems-canonical-gate.sh"
WRAPPER_TARGET="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_THIN_WRAPPER_CREATION_2026-06-21.md"

fail() {
  printf 'hepta-systems-historical-canonical-gate-thin-wrapper-creation-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$IMPACT_REPORT" ]] || fail "missing executable post-claim impact preflight report: $IMPACT_REPORT"
[[ -x "$IMPACT_GATE" ]] || fail "missing executable post-claim impact preflight gate: $IMPACT_GATE"
[[ -x "$CANONICAL_GATE" ]] || fail "missing executable historical canonical gate thin wrapper: $CANONICAL_GATE"
[[ -x "$WRAPPER_TARGET" ]] || fail "missing executable current canonical wrapper target: $WRAPPER_TARGET"
[[ -f "$DOC" ]] || fail "missing historical canonical gate thin wrapper creation architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the historical canonical gate thin wrapper creation report"
fi

wrapper_exec_count=0
if grep -Eq '^[[:space:]]*exec[[:space:]]+"\$TARGET"[[:space:]]+"\$@"[[:space:]]*$' "$CANONICAL_GATE"; then
  wrapper_exec_count=1
fi

jq -n \
  --slurpfile impact <("$IMPACT_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_THIN_WRAPPER_CREATION_2026-06-21.md" \
  --argjson wrapper_exec_count "$wrapper_exec_count" \
  '
  ($impact[0]) as $impact |
  ($impact.historical_canonical_gate_name_creation_allowed_now == true
    and $impact.post_claim_live_absence_probe_consumer_count == 0
    and $impact.post_claim_blocking_consumer_count == 0
    and $impact.snapshot_decoupling_complete == true
    and $impact.wrapper_creation_deferred == false
    and $impact.execution_enabled_count == 0
    and $impact.public_ga_enabled_count == 0
    and $wrapper_exec_count == 1
    and ($impact.side_effects | to_entries | all(.value == false))) as $creation_ready |
  {
    runtime:"hepta",
    surface:"historical_canonical_gate_thin_wrapper_creation",
    plugin_id:$impact.plugin_id,
    status:(if $creation_ready then "ready" else "blocked" end),
    source_post_claim_impact_surface:$impact.surface,
    source_post_claim_impact_ready:$impact.post_claim_impact_preflight_ready,
    source_snapshot_decoupling_complete:$impact.snapshot_decoupling_complete,
    source_live_absence_probe_consumer_count:$impact.post_claim_live_absence_probe_consumer_count,
    source_blocking_consumer_count:$impact.post_claim_blocking_consumer_count,
    source_creation_allowed_now:$impact.historical_canonical_gate_name_creation_allowed_now,
    historical_canonical_gate_path:"scripts/hepta-systems-canonical-gate.sh",
    historical_canonical_gate_created:true,
    historical_canonical_gate_executable:true,
    historical_canonical_gate_wrapper_kind:"thin_local_exec_wrapper",
    historical_canonical_gate_wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
    historical_canonical_gate_wrapper_exec_count:$wrapper_exec_count,
    wrapper_body_emitted_by_report:false,
    wrapper_target_invoked:false,
    canonical_gate_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    historical_canonical_gate_thin_wrapper_creation_ready:$creation_ready,
    next_migration_step:"validate_historical_canonical_gate_thin_wrapper_without_live_invocation",
    creation_blockers:[
      "manual_operator_live_cutover_approval_required",
      "tool_execution_live_cutover_allowed_false",
      "tool_execution_public_ga_allowed_false",
      "wrapper_target_not_invoked_by_creation_report"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      post_claim_impact_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-post-claim-impact-preflight.report",
      post_claim_impact_preflight_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-post-claim-impact-preflight.gate",
      historical_canonical_gate:"scripts/hepta-systems-canonical-gate.sh",
      wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
