#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
READBACK_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-source-probe-adapter-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_SOURCE_PROBE_ADAPTER_FINAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-readiness-non-live-source-probe-adapter-final-index-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$READBACK_REPORT" ]] || fail "missing executable Public GA readiness non-live source-probe adapter readback report: $READBACK_REPORT"
[[ -f "$DOC" ]] || fail "missing Public GA readiness non-live source-probe adapter final index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Public GA readiness non-live source-probe adapter final index report"
fi

jq -n \
  --slurpfile readback <("$READBACK_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-source-probe-adapter-final-index.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_SOURCE_PROBE_ADAPTER_FINAL_INDEX_2026-06-21.md" \
  '
  ($readback[0]) as $readback |
  ($readback.public_ga_readiness_non_live_source_probe_adapter_readback_ready == true
    and $readback.public_ga_readiness_non_live_source_probe_adapter_readback_blocked == true
    and $readback.public_ga_readiness_non_live_endpoint_inventory_ready == true
    and $readback.public_ga_readiness_target_endpoint_count == 9
    and $readback.public_ga_readiness_script_invoked == false
    and $readback.public_ga_readiness_live_endpoint_read_performed == false
    and $readback.public_ga_readiness_endpoint_curl_performed == false
    and $readback.public_ga_readiness_report_materialized == false
    and $readback.public_ga_readiness_attachment_allowed == false
    and $readback.public_ga_claim_allowed == false
    and $readback.public_ga_claimed == false
    and $readback.terminal_live_gates_invoked == false
    and $readback.canonical_gate_wrapper_invoked == false
    and $readback.wrapper_target_invoked == false
    and ($readback.side_effects | to_entries | all(.value == false))) as $final_index_ready |
  {
    runtime:"hepta",
    surface:"public_ga_readiness_non_live_source_probe_adapter_final_index",
    plugin_id:$readback.plugin_id,
    status:(if $final_index_ready then "ready_blocked" else "blocked" end),
    source_public_ga_readiness_non_live_source_probe_adapter_readback_surface:$readback.surface,
    source_public_ga_readiness_non_live_source_probe_adapter_readback_ready:$readback.public_ga_readiness_non_live_source_probe_adapter_readback_ready,
    source_public_ga_readiness_non_live_source_probe_adapter_readback_blocked:$readback.public_ga_readiness_non_live_source_probe_adapter_readback_blocked,
    public_ga_readiness_non_live_source_probe_adapter_final_index_ready:$final_index_ready,
    public_ga_readiness_non_live_source_probe_adapter_final_index_blocked:true,
    public_ga_readiness_non_live_source_probe_adapter_readback_attached:true,
    public_ga_readiness_non_live_endpoint_inventory_ready:true,
    public_ga_readiness_target_endpoint_count:9,
    public_ga_readiness_script_present:true,
    public_ga_readiness_existing_doc_present:false,
    public_ga_readiness_dedicated_architecture_note_required:true,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    public_ga_readiness_attachment_allowed:false,
    non_live_readback_adapter_available:true,
    terminal_publication_evidence_non_persistence_summary_gate_invoked:false,
    hepta_watchdog_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_denial_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    final_blocker_count:$readback.adapter_blocker_count,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    public_distribution_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    public_ga_claim_allowed:false,
    public_release_published:false,
    public_ga_claimed:false,
    publication_evidence_summary_recorded:false,
    publication_evidence_summary_persisted:false,
    publication_evidence_receipt_persisted:false,
    publication_evidence_ledger_persisted:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    next_migration_step:"migrate_public_ga_readiness_preflight_to_non_live_adapter_without_public_ga_readiness_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      public_ga_readiness_non_live_source_probe_adapter_readback_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-source-probe-adapter-readback.report"
    },
    side_effect_free:true,
    side_effects:$readback.side_effects
  }'
