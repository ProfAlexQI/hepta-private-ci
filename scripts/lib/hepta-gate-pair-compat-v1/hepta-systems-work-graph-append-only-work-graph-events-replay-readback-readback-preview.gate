#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-append-only-work-graph-events-replay-readback-readback-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-append-only-work-graph-events-replay-readback-readback-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_append_only_work_graph_events_replay_readback_readback_preview_gate"
  and .schema_version == "work_graph_append_only_work_graph_events_replay_readback_readback_preview_v1"
  and .preview_mode == "read_only_append_only_work_graph_events_replay_readback_readback_preview_no_execution"
  and .upstream_replay_readback_preview_gate == "hepta_work_graph_append_only_work_graph_events_replay_readback_preview_gate"
  and .source_surface_count == 12
  and .preview_plan_count == 12
  and .readback_plan_count == 12
  and .stage_assertion_count == 8
  and .evidence_field_assertion_count == 12
  and .guard_assertion_count == 11
  and .blocker_mapping_assertion_count == 5
  and .drift_detector_count == 7
  and .blocker_count == 6
  and .required_prior_gate_count == 18
' >/dev/null <<<"$report"

jq -e '
  (.readback_plans | all(
    .readback_status == "readback_plan_ready"
    and .expected_stage_count == 8
    and .expected_evidence_field_count == 10
    and .readback_execution_enabled == false
    and .replay_execution_enabled == false
    and .rollback_execution_enabled == false
    and .persists_work_graph_events == false
    and .next_required_gate == "hepta_work_graph_append_only_work_graph_events_replay_readback_application_preview_gate"
  ))
  and (.stage_assertions | all(
    .contract_ready_preview == true
    and .execution_enabled_after_readback == false
    and .persistence_enabled_after_readback == false
  ))
  and (.evidence_field_assertions | all(
    .evidence_contract_ready_preview == true
    and .persists_evidence_after_readback == false
  ))
  and (.guard_assertions | all(
    .required_before_replay_readback_execution == true
    and .satisfied_by_preview == false
  ))
  and (.blocker_mapping_assertions | all(.blocks_replay_readback_execution == true))
  and (.drift_detectors | all(.drift_budget == 0))
' >/dev/null <<<"$report"

jq -e '
  (.drift_detectors | map(.id) == [
    "replay_cursor_contract_drift",
    "readback_probe_contract_drift",
    "duplicate_suppression_contract_drift",
    "timeline_ordering_contract_drift",
    "rollback_anchor_contract_drift",
    "event_integrity_digest_contract_drift",
    "no_execution_guard_drift"
  ])
  and (.blockers | map(.id) == [
    "append_only_work_graph_events_replay_readback_readback_not_executed",
    "append_only_work_graph_events_replay_readback_application_missing",
    "append_only_work_graph_events_disabled",
    "replay_readback_execution_disabled",
    "runtime_canonical_adapter_enforcement_disabled",
    "canonical_adapter_projection_partial_or_gap"
  ])
  and (.blockers | map(select(.id == "canonical_adapter_projection_partial_or_gap"))[0].affected_source_surface_ids | length) == 7
  and (.blockers | map(select(.id != "canonical_adapter_projection_partial_or_gap")) | all((.affected_source_surface_ids | length) == 12))
' >/dev/null <<<"$report"

jq -e '
  (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_append_only_work_graph_events_replay_readback_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_append_only_work_graph_events_replay_readback_application_preview_gate"
  and .ready_for_replay_readback_application_preview == true
  and .ready_for_append_only_work_graph_events == false
  and .ready_for_replay_readback_execution == false
  and .ready_for_runtime_adapter_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.append_only_work_graph_events_replay_readback_readback.rust_module_present == true
  and .source_probes.append_only_work_graph_events_replay_readback_readback.report_script_present == true
  and .source_probes.append_only_work_graph_events_replay_readback_readback.gate_script_present == true
  and .source_probes.append_only_work_graph_events_replay_readback_preview.rust_module_present == true
  and .source_probes.append_only_work_graph_events_replay_readback_preview.gate_script_present == true
  and .source_probes.append_only_work_graph_events_replay_readback_preview.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_append_only_work_graph_events_replay_readback_readback --lib

echo "Hepta WorkGraph append-only WorkGraph events replay/readback readback preview gate passed"
