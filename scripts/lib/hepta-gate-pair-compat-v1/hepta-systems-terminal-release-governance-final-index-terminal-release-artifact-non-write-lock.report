#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
RELEASE_GOVERNANCE_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-attachment-final-index.report"
RELEASE_GOVERNANCE_FINAL_INDEX_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-attachment-final-index.gate"
RELEASE_ARTIFACT_NON_WRITE_LOCK_GATE="$ROOT/scripts/hepta-terminal-release-artifact-non-write-lock-gate.sh"
RELEASE_ARTIFACT_NON_WRITE_LOCK_DOC="$ROOT/docs/architecture/HEPTA_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_GATE.md"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_GOVERNANCE_FINAL_INDEX_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-release-governance-final-index-terminal-release-artifact-non-write-lock-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$RELEASE_GOVERNANCE_FINAL_INDEX_REPORT" ]] || fail "missing executable terminal release governance attachment final index report: $RELEASE_GOVERNANCE_FINAL_INDEX_REPORT"
[[ -x "$RELEASE_GOVERNANCE_FINAL_INDEX_GATE" ]] || fail "missing executable terminal release governance attachment final index gate: $RELEASE_GOVERNANCE_FINAL_INDEX_GATE"
[[ -x "$RELEASE_ARTIFACT_NON_WRITE_LOCK_GATE" ]] || fail "missing executable terminal release artifact non-write lock gate: $RELEASE_ARTIFACT_NON_WRITE_LOCK_GATE"
[[ -f "$RELEASE_ARTIFACT_NON_WRITE_LOCK_DOC" ]] || fail "missing terminal release artifact non-write lock doc: $RELEASE_ARTIFACT_NON_WRITE_LOCK_DOC"
[[ -f "$DOC" ]] || fail "missing terminal release artifact non-write lock attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the terminal release artifact non-write lock attachment report"
fi

jq -n \
  --slurpfile release_final_index <("$RELEASE_GOVERNANCE_FINAL_INDEX_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-final-index-terminal-release-artifact-non-write-lock.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_GOVERNANCE_FINAL_INDEX_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_2026-06-21.md" \
  '
  ($release_final_index[0]) as $release |
  [
    "manual_operator_live_cutover_approval_required",
    "terminal_release_artifact_non_write_lock_source_probed_not_invoked",
    "terminal_release_governance_final_audit_not_invoked",
    "terminal_summary_gates_not_invoked",
    "terminal_live_gates_not_invoked",
    "canonical_successor_consumer_cutover_disallowed",
    "current_canonical_consumer_rollback_anchor_retained",
    "canonical_gate_not_invoked",
    "wrapper_target_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "public_ga_disabled",
    "release_publication_disabled",
    "release_artifact_write_disabled",
    "public_release_claim_disabled",
    "package_or_release_write_disabled"
  ] as $attachment_blockers |
  ($release.terminal_release_governance_attachment_final_index_ready == true
    and $release.terminal_release_governance_attachment_final_index_blocked == true
    and $release.terminal_release_governance_final_audit_gate_invoked == false
    and $release.terminal_summary_gates_invoked == false
    and $release.terminal_live_gates_invoked == false
    and $release.canonical_gate_wrapper_invoked == false
    and $release.wrapper_target_invoked == false
    and $release.source_successor_consumer_cutover_allowed == false
    and $release.source_canonical_governance_rollback_anchor == "current_canonical_consumer"
    and $release.tool_execution_live_cutover_allowed == false
    and $release.tool_execution_public_ga_allowed == false
    and $release.release_publication_allowed == false
    and $release.release_artifact_write_allowed == false
    and $release.public_release_claim_allowed == false
    and $release.source_canonical_governance_tool_execution_closure_backfeed_ready == true
    and $release.source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
    and $release.source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
    and $release.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
    and $release.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
    and $release.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
    and ($release.side_effects | to_entries | all(.value == false))) as $attachment_ready |
  {
    runtime:"hepta",
    surface:"terminal_release_governance_final_index_terminal_release_artifact_non_write_lock",
    plugin_id:$release.plugin_id,
    status:(if $attachment_ready then "ready_blocked" else "blocked" end),
    source_terminal_release_governance_attachment_final_index_surface:$release.surface,
    source_terminal_release_governance_attachment_final_index_ready:$release.terminal_release_governance_attachment_final_index_ready,
    source_terminal_release_governance_attachment_final_index_blocked:$release.terminal_release_governance_attachment_final_index_blocked,
    terminal_release_artifact_non_write_lock_attachment_ready:$attachment_ready,
    terminal_release_artifact_non_write_lock_attachment_blocked:true,
    terminal_release_governance_attachment_final_index_attached:true,
    terminal_release_artifact_non_write_lock_gate_present:true,
    terminal_release_artifact_non_write_lock_doc_present:true,
    terminal_release_artifact_non_write_lock_gate_invoked:false,
    terminal_release_governance_final_audit_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    source_successor_consumer_cutover_allowed:false,
    source_canonical_governance_rollback_anchor:$release.source_canonical_governance_rollback_anchor,
    source_canonical_governance_tool_execution_closure_backfeed_ready:$release.source_canonical_governance_tool_execution_closure_backfeed_ready,
    source_canonical_governance_tool_execution_closure_backfeed_blocker_count:$release.source_canonical_governance_tool_execution_closure_backfeed_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_count:$release.source_canonical_governance_tool_execution_closure_backfeed_category_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_ready_count:$release.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count:$release.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_categorization_ready:$release.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready,
    source_canonical_governance_tool_execution_closure_backfeed_categories:$release.source_canonical_governance_tool_execution_closure_backfeed_categories,
    attachment_blocker_count:($attachment_blockers | length),
    attachment_blockers:$attachment_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    release_publication_allowed:false,
    release_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    package_or_release_write_allowed:false,
    next_migration_step:"derive_terminal_release_artifact_non_write_lock_attachment_readback_without_artifact_gate_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      terminal_release_governance_attachment_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-attachment-final-index.report",
      terminal_release_governance_attachment_final_index_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-attachment-final-index.gate",
      terminal_release_artifact_non_write_lock_gate:"scripts/hepta-terminal-release-artifact-non-write-lock-gate.sh",
      terminal_release_artifact_non_write_lock_doc:"docs/architecture/HEPTA_TERMINAL_RELEASE_ARTIFACT_NON_WRITE_LOCK_GATE.md"
    },
    side_effect_free:true,
    side_effects:$release.side_effects
  }'
