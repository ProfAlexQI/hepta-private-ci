#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-readback-preview.report"

report="$(capture_json_report "hepta-work-graph-projection-adapter-gap-closure-readback-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_projection_adapter_gap_closure_readback_preview_gate"
  and .schema_version == "work_graph_projection_adapter_gap_closure_readback_preview_v1"
  and .preview_mode == "read_only_projection_adapter_gap_closure_readback_preview_no_execution"
  and .source_gap_count == 7
  and .closure_action_count == 11
  and .readback_plan_count == 11
  and (.readback_plans | length) == .readback_plan_count
  and (.readback_plans | all(.required_before_closure_application == true and .performs_readback == false and .mutates_runtime == false))
  and (.readback_plans | map(.closure_action_id) | index("close_update_plan_timeline_projection")) != null
  and (.readback_plans | map(.closure_action_id) | index("close_task_board_unified_store_projection")) != null
  and (.readback_plans | map(.closure_action_id) | index("close_approval_broker_timeline_projection")) != null
' >/dev/null <<<"$report"

jq -e '
  .fixture_readback_assertion_count == 0
  and (.fixture_readback_assertions | length) == .fixture_readback_assertion_count
  and (.fixture_readback_assertions | all(.expected_fixture_state == "fixture_shape_defined_runtime_not_attached" and .performs_readback == false and .mutates_fixture == false))
  and (.fixture_readback_assertions | map(select(.closure_action_id == "close_mailbox_wait_adapter_projection_fixture")) | length) == 0
  and .store_readback_assertion_count == 6
  and (.store_readback_assertions | length) == .store_readback_assertion_count
  and .projected_collection_reference_count == 18
  and (.store_readback_assertions | all(.idempotency_guard_required == true and .expected_projection_state == "store_projection_shape_defined_store_write_disabled" and .performs_readback == false and .mutates_store == false))
  and (.store_readback_assertions | map(select(.closure_action_id == "close_task_board_unified_store_projection" and .projected_collection_ids == ["nodes", "taskResults", "artifacts", "timelineEvents"])) | length) == 1
  and .timeline_readback_assertion_count == 5
  and (.timeline_readback_assertions | length) == .timeline_readback_assertion_count
  and .timeline_event_type_reference_count == 5
  and (.timeline_readback_assertions | all(.expected_event_state == "timeline_event_shape_defined_timeline_persistence_disabled" and .performs_readback == false and .persists_timeline == false))
  and (.timeline_readback_assertions | map(select(.closure_action_id == "close_approval_broker_timeline_projection" and .timeline_event_type_ids == ["approval_decision_observed"])) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .drift_detector_count == 5
  and (.drift_detectors | map(.id) == [
    "detect_closure_action_source_drift",
    "detect_store_projection_collection_drift",
    "detect_timeline_event_type_drift",
    "detect_fixture_redaction_drift",
    "detect_closure_plan_coverage_drift"
  ])
  and (.drift_detectors | all(.blocks_closure_application == true and .performs_readback == false))
  and (.drift_detectors | map(select(.severity == "critical")) | length) == 3
  and .blocker_count == 6
  and (.blockers | map(.id) == [
    "gap_closure_readback_is_preview_only",
    "adapter_fixture_readback_not_executed",
    "unified_store_projection_readback_not_executed",
    "timeline_projection_readback_not_executed",
    "closure_application_preview_not_run",
    "post_readback_enforcement_readiness_not_rerun"
  ])
  and (.blockers | map(select(.severity == "high")) | length) == 4
  and (.blockers | all(.required_before_projection_enforcement == true))
  and (.blockers | map(select(.id == "adapter_fixture_readback_not_executed" and (.affected_closure_action_ids | length == 0))) | length) == 1
  and (.blockers | map(select(.id == "unified_store_projection_readback_not_executed" and (.affected_closure_action_ids | length == 6))) | length) == 1
  and (.blockers | map(select(.id == "timeline_projection_readback_not_executed" and (.affected_closure_action_ids | length == 5))) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .required_prior_gate_count == 14
  and (.required_prior_gates[-1] == "hepta_work_graph_projection_adapter_gap_closure_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_projection_adapter_gap_closure_application_preview_gate"
  and .ready_for_projection_adapter_gap_closure_application_preview == true
  and .ready_for_projection_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.gap_closure_readback.rust_module_present == true
  and .source_probes.gap_closure_readback.report_script_present == true
  and .source_probes.gap_closure_readback.gate_script_present == true
  and .source_probes.gap_closure_preview.rust_module_present == true
  and .source_probes.gap_closure_preview.gate_script_present == true
  and .source_probes.gap_closure_preview.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_projection_adapter_gap_closure_readback --lib

echo "Hepta WorkGraph projection adapter gap closure readback preview gate passed"
