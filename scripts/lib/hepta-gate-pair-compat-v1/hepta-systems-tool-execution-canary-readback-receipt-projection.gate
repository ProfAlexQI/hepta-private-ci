#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-readback-receipt-projection.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-cutover-plan.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_CANARY_READBACK_RECEIPT_PROJECTION_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-canary-readback-receipt-projection-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution canary readback receipt projection report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable execution canary cutover plan gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution canary readback receipt projection architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution canary readback receipt projection report"
fi

grep -q 'Canary Readback Receipt Projection' "$DOC" \
  || fail "architecture note must document Canary Readback Receipt Projection"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'readback' "$DOC" \
  || fail "architecture note must document readback"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_canary_readback_receipt_projection"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_canary_cutover_plan_surface == "tool_execution_canary_cutover_plan"
  and .source_canary_cutover_plan_ready == true
  and .source_canary_cutover_start_allowed == false
  and .source_canary_result_receipt_write_allowed == false
  and .source_live_cutover_allowed == false
  and .canary_readback_channel_declared == true
  and .canary_result_receipt_digest_required == true
  and .canary_trace_correlation_required == true
  and .rollback_readback_required == true
  and .operator_summary_required == true
  and .canary_cutover_switch_enabled == false
  and .live_cutover_switch_enabled == false
  and .canary_execution_started == false
  and .canary_result_receipt_written == false
  and .canary_readback_projection_written == false
  and .rollback_executed == false
  and .candidate_count == 2
  and .canary_readback_receipt_projection_ready_count == 2
  and .canary_readback_receipt_projection_blocked_count == 0
  and .canary_readback_channel_declared_count == 2
  and .canary_result_receipt_digest_required_count == 2
  and .canary_trace_correlation_required_count == 2
  and .rollback_readback_required_count == 2
  and .operator_summary_required_count == 2
  and .canary_result_receipt_write_blocked_count == 1
  and .selected_status_canary_count == 1
  and .preflight_only_non_selected_count == 1
  and .all_canary_plan_entries_bound_to_readback_projection == true
  and .all_canary_readback_entries_keep_no_invocation_guard == true
  and .tool_execution_canary_readback_receipt_projection_ready == true
  and .tool_execution_canary_result_receipt_write_allowed == false
  and .tool_execution_canary_result_acceptance_allowed == false
  and .tool_execution_live_cutover_allowed == false
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .execution_adapter_dispatched == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .operator_decision_record_written == false
  and .operator_decision_receipt_written == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_canary_result_acceptance_preflight_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .selected_for_status_canary == true and .preflight_only_non_selected_candidate == false and .source_canary_cutover_plan_route == "canary_cutover_plan_ready" and .registry_guard_route == "require_approval_ledger" and .canary_readback_receipt_projection_route == "canary_readback_receipt_projection_ready" and .canary_readback_receipt_projection_ready == true and .canary_readback_channel_declared == true and .canary_result_receipt_digest_required == true and .canary_trace_correlation_required == true and .rollback_readback_required == true and .operator_summary_required == true and .canary_result_receipt_write_blocked == true and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .canary_execution_started == false and .canary_result_receipt_written == false and .canary_readback_projection_written == false and .rollback_executed == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .selected_for_status_canary == false and .preflight_only_non_selected_candidate == true and .source_canary_cutover_plan_route == "preflight_only_non_selected_candidate" and .registry_guard_route == "require_approval_ledger" and .canary_readback_receipt_projection_route == "preflight_only_non_selected_candidate" and .canary_readback_receipt_projection_ready == true and .canary_readback_channel_declared == true and .canary_result_receipt_digest_required == true and .canary_trace_correlation_required == true and .rollback_readback_required == true and .operator_summary_required == true and .canary_result_receipt_write_blocked == false and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .canary_execution_started == false and .canary_result_receipt_written == false and .canary_readback_projection_written == false and .rollback_executed == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("canary_readback_projection_not_written")) != null
  and (.blockers | index("canary_result_acceptance_disabled")) != null
  and (.next_actions | index("restore_tool_execution_canary_result_acceptance_preflight_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_canary_readback_receipt_projection --quiet
)

printf 'hepta-systems-tool-execution-canary-readback-receipt-projection-gate: PASS: canary readback receipts are projected while receipt writes and invocation stay disabled\n'
