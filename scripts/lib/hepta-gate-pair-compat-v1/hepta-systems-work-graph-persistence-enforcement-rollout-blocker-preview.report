#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

rollout_blocker_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_enforcement_rollout_blocker_preview.rs
)"
rollout_blocker_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-enforcement-rollout-blocker-preview.report
)"
rollout_blocker_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-enforcement-rollout-blocker-preview.gate
)"
shadow_live_comparison_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_shadow_live_readback_comparison_preview.rs
)"
shadow_live_comparison_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-shadow-live-readback-comparison-preview.gate
)"
durable_identity_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_durable_identity_preview.rs
)"
durable_identity_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report
)"
durable_identity_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.gate
)"

durable_identity_report="$(
  capture_json_report \
    "hepta-work-graph-durable-identity-preview-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report"
)"

jq -n \
  --argjson rollout_blocker_rust_module_present "$rollout_blocker_rust_module_present" \
  --argjson rollout_blocker_report_script_present "$rollout_blocker_report_script_present" \
  --argjson rollout_blocker_gate_script_present "$rollout_blocker_gate_script_present" \
  --argjson shadow_live_comparison_rust_module_present "$shadow_live_comparison_rust_module_present" \
  --argjson shadow_live_comparison_gate_script_present "$shadow_live_comparison_gate_script_present" \
  --argjson durable_identity_rust_module_present "$durable_identity_rust_module_present" \
  --argjson durable_identity_report_script_present "$durable_identity_report_script_present" \
  --argjson durable_identity_gate_script_present "$durable_identity_gate_script_present" \
  --argjson durable_identity_report "$durable_identity_report" \
  '
  def durable_fields: [
    "workflow_id",
    "run_id",
    "step_id",
    "checkpoint",
    "replay_key",
    "rollback_anchor",
    "receipt_hash"
  ];
  def prior_gates: [
    "hepta_work_graph_contract_preview_gate",
    "hepta_work_graph_task_result_contract_preview_gate",
    "hepta_work_graph_scheduler_admission_controller_preview_gate",
    "hepta_work_graph_observability_timeline_preview_gate",
    "hepta_work_graph_role_manifest_contract_preview_gate",
    "hepta_work_graph_unified_state_store_preview_gate",
    "hepta_work_graph_adapter_projection_fixture_gate",
    "hepta_work_graph_state_store_persistence_preview_gate",
    "hepta_work_graph_replay_readback_preview_gate",
    "hepta_work_graph_promotion_precondition_preview_gate",
    "hepta_work_graph_activation_enforcement_blocker_preview_gate",
    "hepta_work_graph_shadow_adapter_readback_preview_gate",
    "hepta_work_graph_persistence_feature_flag_preview_gate",
    "hepta_work_graph_persistence_canary_dry_run_preview_gate",
    "hepta_work_graph_persistence_canary_readback_receipt_preview_gate",
    "hepta_work_graph_persistence_promotion_blocker_preview_gate",
    "hepta_work_graph_persistence_shadow_live_readback_comparison_preview_gate",
    "hepta_work_graph_durable_identity_preview_gate"
  ];
  def stages: [
    "store_persistence_enforcement_rollout",
    "wal_append_enforcement_rollout",
    "checkpoint_write_enforcement_rollout",
    "readback_receipt_enforcement_rollout",
    "replay_execution_enforcement_rollout",
    "external_publication_enforcement_rollout"
  ];
  def persistent_stages: [
    "store_persistence_enforcement_rollout",
    "wal_append_enforcement_rollout",
    "checkpoint_write_enforcement_rollout",
    "readback_receipt_enforcement_rollout",
    "replay_execution_enforcement_rollout"
  ];
  def stage($id; $surface; $fields): {
    id: $id,
    target_surface_id: $surface,
    required_evidence_fields: $fields,
    max_traffic_ppm: 0,
    enforcement_enabled: false,
    blocks_release: true
  };
  def ramp($id; $stages; $trigger): {
    id: $id,
    applies_to_stage_ids: $stages,
    trigger: $trigger,
    max_allowed_traffic_ppm: 0,
    blocks_ramp: true
  };
  def kill($id; $stages; $trigger; $owner): {
    id: $id,
    target_stage_ids: $stages,
    trigger: $trigger,
    rollback_owner_id: $owner,
    armed_in_preview: true
  };
  def enablement($id; $stages; $fields): {
    id: $id,
    required_for_stage_ids: $stages,
    required_fields: $fields,
    currently_satisfied: false,
    approval_recorded: false
  };
  def owner($id; $stages; $scope): {
    id: $id,
    owns_stage_ids: $stages,
    quarantine_scope: $scope,
    required_receipt_fields: (durable_fields + ["rollbackOwnerId", "quarantineScope", "killSwitchId", "recoveryOwnerHash"]),
    currently_satisfied: false
  };
  def denial($id; $surface; $reason; $clearances): {
    id: $id,
    target_surface_id: $surface,
    reason: $reason,
    required_clearance_ids: $clearances,
    blocks_release: true,
    blocks_publication: true
  };
  def invariant($id; $reason): {
    id: $id,
    required: true,
    reason: $reason
  };
  [
    stage("store_persistence_enforcement_rollout"; "durable_work_graph_store"; durable_fields + ["featureFlagDefaultOff", "shadowLiveDigestMatch", "operatorEnablementPacketHash", "rollbackOwnerHash"]),
    stage("wal_append_enforcement_rollout"; "work_graph_wal"; durable_fields + ["walSchemaDigest", "idempotencyGuardHash", "trafficRampBlockerIds", "killSwitchId"]),
    stage("checkpoint_write_enforcement_rollout"; "work_graph_checkpoint"; durable_fields + ["checkpointSchemaDigest", "diskBudgetHash", "rollbackOwnerHash", "releaseDenialId"]),
    stage("readback_receipt_enforcement_rollout"; "readback_receipt_store"; durable_fields + ["receiptSchemaHash", "redactionState", "operatorEnablementPacketHash", "quarantineScope"]),
    stage("replay_execution_enforcement_rollout"; "work_graph_replay_executor"; durable_fields + ["driftBudgetHash", "replayIdempotencyHash", "laneLeaseHash", "killSwitchId"]),
    stage("external_publication_enforcement_rollout"; "external_delivery"; durable_fields + ["externalPolicyHash", "deliveryReadbackGate", "operatorScopeHash", "publicationDenialId"])
  ] as $rollout_stages
  | [
    ramp("ramp_blocked_without_operator_packet"; stages; "operator enablement packet is missing or unsatisfied"),
    ramp("ramp_blocked_without_durable_identity"; stages; "durable identity evidence packet is missing or unsatisfied"),
    ramp("ramp_blocked_without_shadow_live_match"; persistent_stages; "shadow/live readback comparison is missing or mismatched"),
    ramp("ramp_blocked_without_kill_switch"; stages; "kill switch is not armed before rollout"),
    ramp("ramp_blocked_without_rollback_owner"; persistent_stages; "rollback/quarantine owner is missing"),
    ramp("ramp_blocked_without_release_denial_matrix"; stages; "release and publication denial matrix is missing"),
    ramp("ramp_blocked_for_external_publication"; ["external_publication_enforcement_rollout"]; "external publication remains blocked in persistence rollout preview")
  ] as $traffic_ramp_blockers
  | [
    kill("kill_store_persistence_rollout"; ["store_persistence_enforcement_rollout"]; "store readback, schema, or idempotency evidence fails"; "rollback_owner_store_persistence"),
    kill("kill_wal_checkpoint_rollout"; ["wal_append_enforcement_rollout", "checkpoint_write_enforcement_rollout"]; "WAL or checkpoint digest diverges"; "rollback_owner_wal_checkpoint"),
    kill("kill_readback_receipt_rollout"; ["readback_receipt_enforcement_rollout"]; "receipt redaction or persistence evidence fails"; "rollback_owner_receipts"),
    kill("kill_replay_execution_rollout"; ["replay_execution_enforcement_rollout"]; "replay drift, idempotency, or lane lease evidence fails"; "rollback_owner_replay"),
    kill("kill_external_publication_rollout"; ["external_publication_enforcement_rollout"]; "external delivery policy, readback, or operator scope fails"; "rollback_owner_external_publication")
  ] as $kill_switches
  | [
    enablement("operator_enable_store_persistence_rollout"; ["store_persistence_enforcement_rollout"]; durable_fields + ["operatorScopeHash", "featureFlagName", "shadowLiveDigestHash", "rollbackOwnerHash"]),
    enablement("operator_enable_wal_checkpoint_rollout"; ["wal_append_enforcement_rollout", "checkpoint_write_enforcement_rollout"]; durable_fields + ["walSchemaDigest", "checkpointSchemaDigest", "diskBudgetHash", "killSwitchId"]),
    enablement("operator_enable_readback_receipt_rollout"; ["readback_receipt_enforcement_rollout"]; durable_fields + ["receiptSchemaHash", "redactionState", "receiptRetentionPolicyHash", "quarantineScope"]),
    enablement("operator_enable_replay_execution_rollout"; ["replay_execution_enforcement_rollout"]; durable_fields + ["driftBudgetHash", "laneLeaseHash", "replayIdempotencyHash", "rollbackOwnerHash"]),
    enablement("operator_enable_external_publication_rollout"; ["external_publication_enforcement_rollout"]; durable_fields + ["deliveryPolicyHash", "externalTargetScope", "deliveryReadbackGate", "publicationDenialId"]),
    enablement("operator_enable_full_rollout_abort_packet"; stages; durable_fields + ["abortReasonHash", "killSwitchIds", "rollbackOwnerIds", "quarantineScopes"])
  ] as $operator_enablements
  | [
    owner("rollback_owner_store_persistence"; ["store_persistence_enforcement_rollout"]; "durable_work_graph_store"),
    owner("rollback_owner_wal_checkpoint"; ["wal_append_enforcement_rollout", "checkpoint_write_enforcement_rollout"]; "wal_and_checkpoint_writers"),
    owner("rollback_owner_receipts"; ["readback_receipt_enforcement_rollout"]; "readback_receipt_store"),
    owner("rollback_owner_replay"; ["replay_execution_enforcement_rollout"]; "replay_executor"),
    owner("rollback_owner_external_publication"; ["external_publication_enforcement_rollout"]; "external_delivery_pipeline")
  ] as $rollback_owners
  | [
    denial("deny_store_persistence_enforcement_release"; "durable_work_graph_store"; "store persistence enforcement cannot release before operator enablement, shadow/live match, and rollback ownership are satisfied"; ["operator_enable_store_persistence_rollout", "ramp_blocked_without_durable_identity", "ramp_blocked_without_shadow_live_match", "rollback_owner_store_persistence"]),
    denial("deny_wal_checkpoint_enforcement_release"; "wal_and_checkpoint_writers"; "WAL/checkpoint enforcement cannot release before schema digest, disk budget, and kill switch evidence are satisfied"; ["operator_enable_wal_checkpoint_rollout", "ramp_blocked_without_durable_identity", "kill_wal_checkpoint_rollout", "rollback_owner_wal_checkpoint"]),
    denial("deny_readback_receipt_enforcement_release"; "readback_receipt_store"; "readback receipt enforcement cannot release while receipt persistence remains preview-only"; ["operator_enable_readback_receipt_rollout", "ramp_blocked_without_durable_identity", "kill_readback_receipt_rollout", "rollback_owner_receipts"]),
    denial("deny_replay_execution_enforcement_release"; "work_graph_replay_executor"; "replay execution enforcement cannot release before drift budget, lane lease, and rollback ownership are satisfied"; ["operator_enable_replay_execution_rollout", "ramp_blocked_without_durable_identity", "kill_replay_execution_rollout", "rollback_owner_replay"]),
    denial("deny_external_publication_enforcement_release"; "external_delivery"; "external publication enforcement cannot release without separate delivery policy and readback gate"; ["operator_enable_external_publication_rollout", "ramp_blocked_without_durable_identity", "kill_external_publication_rollout", "ramp_blocked_for_external_publication"]),
    denial("deny_full_rollout_public_claim"; "operator_publication"; "full rollout status cannot become a public claim from a preview gate"; ["operator_enable_full_rollout_abort_packet", "ramp_blocked_without_durable_identity", "ramp_blocked_without_release_denial_matrix", "ramp_blocked_without_operator_packet"])
  ] as $release_denials
  | [
    invariant("enforcement_rollout_requires_durable_identity_evidence"; "rollout stages require workflow, run, step, checkpoint, replay, rollback, and receipt evidence"),
    invariant("enforcement_rollout_is_blocked_by_default"; "every persistence enforcement stage has max traffic 0 and enforcement disabled"),
    invariant("traffic_ramp_requires_operator_packet_and_shadow_live_match"; "traffic cannot ramp without operator enablement and shadow/live readback evidence"),
    invariant("kill_switches_precede_any_rollout_stage"; "each rollout stage maps to an armed kill switch before future activation"),
    invariant("rollback_owners_are_explicit_and_unsatisfied"; "rollback and quarantine ownership is declared but not accepted in preview"),
    invariant("release_and_publication_denied_independently"; "release and external/publication paths have separate denial records"),
    invariant("enforcement_rollout_blocker_preview_has_no_side_effects"; "this gate cannot enable enforcement, route traffic, write state, record approvals, publish releases, or send externally")
  ] as $invariants
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_persistence_enforcement_rollout_blocker_preview_gate",
      schema_version: "work_graph_persistence_enforcement_rollout_blocker_preview_v1",
      preview_mode: "read_only_persistence_enforcement_rollout_blocker_preview_no_rollout",
      rollout_stage_count: ($rollout_stages | length),
      traffic_ramp_blocker_count: ($traffic_ramp_blockers | length),
      kill_switch_count: ($kill_switches | length),
      operator_enablement_count: ($operator_enablements | length),
      rollback_owner_count: ($rollback_owners | length),
      release_denial_count: ($release_denials | length),
      invariant_count: ($invariants | length),
      required_prior_gates: prior_gates,
      rollout_stages: $rollout_stages,
      traffic_ramp_blockers: $traffic_ramp_blockers,
      kill_switches: $kill_switches,
      operator_enablements: $operator_enablements,
      rollback_owners: $rollback_owners,
      release_denials: $release_denials,
      durable_identity_evidence: {
        schema_version: $durable_identity_report.schema_version,
        required_prior_gate: "hepta_work_graph_durable_identity_preview_gate",
        required_field_ids: durable_fields,
        required_for_rollout_stage_ids: stages,
        durable_field_count: $durable_identity_report.durable_field_count,
        preview_binding_count: $durable_identity_report.preview_binding_count,
        invariant_count: $durable_identity_report.invariant_count,
        currently_satisfied: false
      },
      invariants: $invariants,
      recommended_next_gate: "hepta_work_graph_persistence_operator_readiness_packet_preview_gate",
      ready_for_operator_readiness_packet_preview: true,
      ready_for_enforcement_rollout: false,
      ready_for_live_persistence: false,
      source_probes: {
        persistence_enforcement_rollout_blocker: {
          rust_module_present: $rollout_blocker_rust_module_present,
          report_script_present: $rollout_blocker_report_script_present,
          gate_script_present: $rollout_blocker_gate_script_present
        },
        persistence_shadow_live_readback_comparison: {
          rust_module_present: $shadow_live_comparison_rust_module_present,
          gate_script_present: $shadow_live_comparison_gate_script_present
        },
        durable_identity: {
          rust_module_present: $durable_identity_rust_module_present,
          report_script_present: $durable_identity_report_script_present,
          gate_script_present: $durable_identity_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        enforcement_enabled: false,
        rollout_started: false,
        traffic_routed: false,
        live_readback_executed: false,
        promotion_performed: false,
        release_published: false,
        operator_approval_recorded: false,
        rollback_performed: false,
        quarantine_performed: false,
        wal_written: false,
        checkpoint_written: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
