#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-ledger-approval-preflight.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-router-lookup-shadow.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_INVOCATION_LEDGER_APPROVAL_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-invocation-ledger-approval-preflight-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable ledger approval preflight report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable router lookup shadow gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing ledger approval preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the ledger approval preflight report"
fi

grep -q 'Ledger Approval Preflight' "$DOC" \
  || fail "architecture note must document Ledger Approval Preflight"
grep -q 'ApprovalBroker' "$DOC" \
  || fail "architecture note must document ApprovalBroker"
grep -q 'without execution' "$DOC" \
  || fail "architecture note must document without execution"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_invocation_ledger_approval_preflight"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_router_lookup_shadow_surface == "tool_registry_router_lookup_shadow"
  and .source_router_lookup_shadow_ready == true
  and .tool_invocation_ledger_binding_present == true
  and .approval_broker_preflight_binding_present == true
  and .ledger_write_switch_enabled == false
  and .approval_request_switch_enabled == false
  and .candidate_count == 2
  and .ledger_approval_preflight_ready_count == 2
  and .ledger_approval_preflight_blocked_count == 0
  and .approval_ledger_preflight_required_count == 2
  and .all_shadow_entries_bound_to_ledger_approval_preflight == true
  and .all_ledger_approval_entries_keep_approval_guard == true
  and .tool_invocation_ledger_approval_preflight_ready == true
  and .ledger_approval_preflight_allowed == true
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_adapter_preflight_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .source_shadow_route == "disabled_approval_ledger_lookup_shadow" and .registry_guard_route == "require_approval_ledger" and .preflight_route == "approval_ledger_preflight_required" and .ledger_preflight_ready == true and .approval_preflight_required == true and .tool_invocation_ledger_binding_present == true and .approval_broker_preflight_binding_present == true and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .source_shadow_route == "disabled_approval_ledger_lookup_shadow" and .registry_guard_route == "require_approval_ledger" and .preflight_route == "approval_ledger_preflight_required" and .ledger_preflight_ready == true and .approval_preflight_required == true and .tool_invocation_ledger_binding_present == true and .approval_broker_preflight_binding_present == true and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false)
  and (.blockers | index("tool_invocation_ledger_write_disabled")) != null
  and (.blockers | index("approval_broker_request_disabled")) != null
  and (.next_actions | index("restore_tool_execution_adapter_preflight_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_invocation_ledger_approval_preflight --quiet
)

printf 'hepta-systems-tool-invocation-ledger-approval-preflight-gate: PASS: shadowed plugin tool lookup paths are bound to ledger and ApprovalBroker preflight while registration, invocation, writes, and requests remain disabled\n'
