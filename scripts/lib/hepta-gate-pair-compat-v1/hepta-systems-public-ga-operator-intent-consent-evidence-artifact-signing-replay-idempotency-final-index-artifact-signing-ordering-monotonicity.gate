#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-replay-idempotency-final-index-artifact-signing-ordering-monotonicity.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-replay-idempotency-final-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_REPLAY_IDEMPOTENCY_FINAL_INDEX_ARTIFACT_SIGNING_ORDERING_MONOTONICITY_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-replay-idempotency-final-index-artifact-signing-ordering-monotonicity-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Public GA operator identity/session intent consent evidence artifact signing ordering/monotonicity attachment report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable Public GA operator identity/session intent consent evidence artifact signing replay/idempotency final index gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing Public GA operator identity/session intent consent evidence artifact signing ordering/monotonicity attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Public GA operator identity/session intent consent evidence artifact signing ordering/monotonicity attachment report"
fi

grep -q 'Public GA Operator Identity/Session Intent/Consent Evidence Artifact Signing Ordering/Monotonicity Attachment' "$DOC" \
  || fail "architecture note must document Public GA Operator Identity/Session Intent/Consent Evidence Artifact Signing Ordering/Monotonicity Attachment"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that attachment does not invoke artifact signing ordering/monotonicity gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_attachment"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_final_index_surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_final_index"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_final_index_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_final_index_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_final_index_attached == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_attachment_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_attachment_blocked == true
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_denial_gate_present == true
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_denial_doc_present == true
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_static_mention_count >= 40
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_denial_gate_invoked == false
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_replay_idempotency_denial_gate_invoked == false
  and .long_soak_started == false
  and .public_ga_claimed == false
  and .artifact_distribution_signing_notarization_receipt_ordering_monotonicity_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordering_monotonicity_recorded == false
  and .artifact_distribution_signing_notarization_receipt_sequence_cursor_recorded == false
  and .artifact_distribution_signing_notarization_receipt_monotonicity_state_recorded == false
  and .artifact_distribution_signing_notarization_receipt_latest_wins_overwrite_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordered_query_export_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordered_observability_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordered_delivery_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordered_status_accepted == false
  and .artifact_distribution_signing_notarization_receipt_ordered_hash_status_accepted == false
  and .artifact_signing_receipt_ordering_accepted == false
  and .package_signing_receipt_ordering_accepted == false
  and .operator_approval_from_signing_receipt_ordering_derived == false
  and .release_publication_authority_from_signing_receipt_ordering_derived == false
  and .activation_authority_from_signing_receipt_ordering_derived == false
  and .install_from_signing_receipt_ordering_executed == false
  and .service_restart_from_signing_receipt_ordering_performed == false
  and .active_binary_from_signing_receipt_ordering_mutated == false
  and .provider_invoked == false
  and .model_invoked == false
  and .credential_read == false
  and .secret_file_read == false
  and .attachment_blocker_count == 72
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_ordering_monotonicity_readback_without_receipt_replay"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-replay-idempotency-final-index-artifact-signing-ordering-monotonicity-gate: PASS: Public GA operator identity/session intent consent evidence artifact signing ordering/monotonicity attachment is ready but blocked without receipt replay ordering\n'
