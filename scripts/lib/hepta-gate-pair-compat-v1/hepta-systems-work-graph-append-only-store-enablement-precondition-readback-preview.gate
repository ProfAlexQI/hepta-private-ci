#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-append-only-store-enablement-precondition-readback-preview.report"

report="$(capture_json_report "hepta-work-graph-append-only-store-enablement-precondition-readback-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_append_only_store_enablement_precondition_readback_preview_gate"
  and .schema_version == "work_graph_append_only_store_enablement_precondition_readback_preview_v1"
  and .preview_mode == "read_only_append_only_store_enablement_precondition_readback_preview_no_execution"
  and .precondition_count == 7
  and .source_precondition_decision_count == 12
  and .readback_plan_count == 7
  and .contract_ref_assertion_count == 7
  and .source_coverage_assertion_count == 7
  and .blocker_mapping_assertion_count == 8
  and .readback_evidence_field_ref_count == 36
  and .contract_ref_count == 49
  and .precondition_source_ref_count == 63
  and .drift_detector_count == 6
  and .blocker_count == 9
' >/dev/null <<<"$report"

jq -e '
  (.readback_plans | map({id: .precondition_id, refs: (.expected_contract_ref_ids | length), sources: (.affected_source_surface_ids | length), evidence: (.required_evidence_fields | length)}) == [
    {"id": "durable_store_enablement_switch", "refs": 9, "sources": 12, "evidence": 5},
    {"id": "wal_append_boundary_contract", "refs": 6, "sources": 12, "evidence": 5},
    {"id": "idempotency_mutation_policy", "refs": 12, "sources": 12, "evidence": 5},
    {"id": "rollback_readback_gate", "refs": 10, "sources": 12, "evidence": 5},
    {"id": "operator_review_and_side_effect_lock", "refs": 3, "sources": 6, "evidence": 5},
    {"id": "scheduler_admission_enforcement_precondition", "refs": 5, "sources": 5, "evidence": 6},
    {"id": "role_manifest_enforcement_precondition", "refs": 4, "sources": 4, "evidence": 5}
  ])
  and (.readback_plans | all(.required_before_precondition_application == true and .performs_readback == false and .mutates_store == false and .enables_append_only_store == false))
  and (.contract_ref_assertions | all(.performs_readback == false and .mutates_store == false))
  and (.source_coverage_assertions | all(.performs_readback == false and .mutates_store == false))
' >/dev/null <<<"$report"

jq -e '
  (.blockers | map({id, count: (.affected_source_surface_ids | length)}) == [
    {"id": "readback_execution_disabled", "count": 12},
    {"id": "durable_store_enablement_disabled", "count": 12},
    {"id": "wal_write_boundary_not_enabled", "count": 12},
    {"id": "idempotency_index_mutation_disabled", "count": 12},
    {"id": "rollback_readback_not_executed", "count": 12},
    {"id": "operator_review_required", "count": 6},
    {"id": "scheduler_admission_not_enforced", "count": 5},
    {"id": "role_manifest_not_enforced", "count": 4},
    {"id": "runtime_application_residuals_not_promoted", "count": 7}
  ])
  and (.blockers | all(.required_before_precondition_application == true))
  and (.blocker_mapping_assertions | length) == 8
  and (.blocker_mapping_assertions | all(.required_before_append_only_store_enablement == true and .performs_readback == false and .mutates_store == false))
' >/dev/null <<<"$report"

jq -e '
  (.drift_detectors | map(.id) == [
    "append_only_precondition_source_coverage_drift",
    "append_only_precondition_contract_ref_drift",
    "append_only_precondition_blocker_mapping_drift",
    "append_only_precondition_side_effect_lock_drift",
    "append_only_precondition_decision_distribution_drift",
    "append_only_precondition_prior_gate_drift"
  ])
  and (.drift_detectors | all(.blocks_precondition_application == true and .performs_readback == false))
  and .required_prior_gate_count == 29
  and (.required_prior_gates[-1] == "hepta_work_graph_append_only_store_enablement_precondition_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_append_only_store_enablement_precondition_application_preview_gate"
  and .ready_for_precondition_application_preview == true
  and .ready_for_append_only_store_enablement == false
  and .ready_for_projection_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.append_only_store_enablement_precondition_readback.rust_module_present == true
  and .source_probes.append_only_store_enablement_precondition_readback.report_script_present == true
  and .source_probes.append_only_store_enablement_precondition_readback.gate_script_present == true
  and .source_probes.append_only_store_enablement_precondition.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_append_only_store_enablement_precondition_readback --lib

echo "Hepta WorkGraph append-only store enablement precondition readback preview gate passed"
