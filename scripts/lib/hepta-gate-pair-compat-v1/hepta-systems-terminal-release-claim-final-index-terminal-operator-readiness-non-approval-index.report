#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
RELEASE_CLAIM_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-non-activation-release-claim-index-attachment-final-index.report"
RELEASE_CLAIM_FINAL_INDEX_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-non-activation-release-claim-index-attachment-final-index.gate"
OPERATOR_READINESS_GATE="$ROOT/scripts/hepta-terminal-operator-readiness-non-approval-index-gate.sh"
OPERATOR_READINESS_DOC="$ROOT/docs/architecture/HEPTA_TERMINAL_OPERATOR_READINESS_NON_APPROVAL_INDEX_GATE.md"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_CLAIM_FINAL_INDEX_TERMINAL_OPERATOR_READINESS_NON_APPROVAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-release-claim-final-index-terminal-operator-readiness-non-approval-index-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$RELEASE_CLAIM_FINAL_INDEX_REPORT" ]] || fail "missing executable terminal non-activation release claim attachment final index report: $RELEASE_CLAIM_FINAL_INDEX_REPORT"
[[ -x "$RELEASE_CLAIM_FINAL_INDEX_GATE" ]] || fail "missing executable terminal non-activation release claim attachment final index gate: $RELEASE_CLAIM_FINAL_INDEX_GATE"
[[ -x "$OPERATOR_READINESS_GATE" ]] || fail "missing executable terminal operator readiness non-approval index gate: $OPERATOR_READINESS_GATE"
[[ -f "$OPERATOR_READINESS_DOC" ]] || fail "missing terminal operator readiness non-approval index doc: $OPERATOR_READINESS_DOC"
[[ -f "$DOC" ]] || fail "missing terminal operator readiness non-approval attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the terminal operator readiness non-approval attachment report"
fi

jq -n \
  --slurpfile release_claim_final_index <("$RELEASE_CLAIM_FINAL_INDEX_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-claim-final-index-terminal-operator-readiness-non-approval-index.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TERMINAL_RELEASE_CLAIM_FINAL_INDEX_TERMINAL_OPERATOR_READINESS_NON_APPROVAL_INDEX_2026-06-21.md" \
  '
  ($release_claim_final_index[0]) as $release |
  [
    "manual_operator_live_cutover_approval_required",
    "terminal_operator_readiness_non_approval_index_source_probed_not_invoked",
    "terminal_non_activation_release_claim_index_not_invoked",
    "terminal_public_distribution_non_publication_lock_not_invoked",
    "terminal_release_artifact_non_write_lock_not_invoked",
    "terminal_release_governance_final_audit_not_invoked",
    "terminal_summary_gates_not_invoked",
    "terminal_live_gates_not_invoked",
    "canonical_successor_consumer_cutover_disallowed",
    "current_canonical_consumer_rollback_anchor_retained",
    "canonical_gate_not_invoked",
    "wrapper_target_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "public_ga_disabled",
    "operator_approval_not_recorded",
    "operator_identity_not_accepted",
    "rollback_execution_disabled",
    "public_distribution_publication_disabled",
    "release_publication_disabled",
    "release_artifact_write_disabled",
    "public_release_claim_disabled",
    "package_or_release_write_disabled",
    "operator_readiness_index_persistence_disabled"
  ] as $attachment_blockers |
  ($release.terminal_non_activation_release_claim_index_attachment_final_index_ready == true
    and $release.terminal_non_activation_release_claim_index_attachment_final_index_blocked == true
    and $release.terminal_non_activation_release_claim_index_gate_invoked == false
    and $release.terminal_public_distribution_non_publication_lock_gate_invoked == false
    and $release.terminal_release_artifact_non_write_lock_gate_invoked == false
    and $release.terminal_release_governance_final_audit_gate_invoked == false
    and $release.terminal_summary_gates_invoked == false
    and $release.terminal_live_gates_invoked == false
    and $release.canonical_gate_wrapper_invoked == false
    and $release.wrapper_target_invoked == false
    and $release.source_successor_consumer_cutover_allowed == false
    and $release.source_canonical_governance_rollback_anchor == "current_canonical_consumer"
    and $release.tool_execution_live_cutover_allowed == false
    and $release.tool_execution_public_ga_allowed == false
    and $release.public_distribution_publication_allowed == false
    and $release.release_publication_allowed == false
    and $release.release_artifact_write_allowed == false
    and $release.public_release_claim_allowed == false
    and $release.release_claim_index_persistence_allowed == false
    and $release.package_or_release_write_allowed == false
    and ($release.side_effects | to_entries | all(.value == false))) as $attachment_ready |
  {
    runtime:"hepta",
    surface:"terminal_release_claim_final_index_terminal_operator_readiness_non_approval_index",
    plugin_id:$release.plugin_id,
    status:(if $attachment_ready then "ready_blocked" else "blocked" end),
    source_terminal_non_activation_release_claim_index_attachment_final_index_surface:$release.surface,
    source_terminal_non_activation_release_claim_index_attachment_final_index_ready:$release.terminal_non_activation_release_claim_index_attachment_final_index_ready,
    source_terminal_non_activation_release_claim_index_attachment_final_index_blocked:$release.terminal_non_activation_release_claim_index_attachment_final_index_blocked,
    terminal_operator_readiness_non_approval_index_attachment_ready:$attachment_ready,
    terminal_operator_readiness_non_approval_index_attachment_blocked:true,
    terminal_non_activation_release_claim_index_attachment_final_index_attached:true,
    terminal_operator_readiness_non_approval_index_gate_present:true,
    terminal_operator_readiness_non_approval_index_doc_present:true,
    terminal_operator_readiness_non_approval_index_gate_invoked:false,
    terminal_non_activation_release_claim_index_gate_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_release_artifact_non_write_lock_gate_invoked:false,
    terminal_release_governance_final_audit_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    source_successor_consumer_cutover_allowed:false,
    source_canonical_governance_rollback_anchor:$release.source_canonical_governance_rollback_anchor,
    attachment_blocker_count:($attachment_blockers | length),
    attachment_blockers:$attachment_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    release_publication_allowed:false,
    release_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    release_claim_index_persistence_allowed:false,
    package_or_release_write_allowed:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    operator_readiness_index_persistence_allowed:false,
    next_migration_step:"derive_terminal_operator_readiness_non_approval_index_attachment_readback_without_operator_gate_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      terminal_non_activation_release_claim_index_attachment_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-non-activation-release-claim-index-attachment-final-index.report",
      terminal_non_activation_release_claim_index_attachment_final_index_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-non-activation-release-claim-index-attachment-final-index.gate",
      terminal_operator_readiness_non_approval_index_gate:"scripts/hepta-terminal-operator-readiness-non-approval-index-gate.sh",
      terminal_operator_readiness_non_approval_index_doc:"docs/architecture/HEPTA_TERMINAL_OPERATOR_READINESS_NON_APPROVAL_INDEX_GATE.md"
    },
    side_effect_free:true,
    side_effects:$release.side_effects
  }'
