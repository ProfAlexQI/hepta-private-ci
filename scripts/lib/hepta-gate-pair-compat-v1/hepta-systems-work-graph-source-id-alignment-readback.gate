#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-source-id-alignment-readback.report"

report="$(
  capture_json_report \
    "hepta-work-graph-source-id-alignment-readback-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_source_id_alignment_readback_gate"
  and .schema_version == "work_graph_source_id_alignment_readback_v1"
  and .preview_mode == "read_only_source_id_alignment_readback_no_live_enforcement"
  and .current_state_source_surface_count == 12
  and .canonical_adapter_source_surface_count == 12
  and .alignment_entry_count == 13
  and .direct_alignment_count == 10
  and .current_state_alias_alignment_count == 2
  and .canonical_shadow_only_alignment_count == 1
  and .unresolved_current_state_source_count == 0
  and .unresolved_canonical_adapter_source_count == 0
  and (.unresolved_current_state_source_ids | length) == 0
  and (.unresolved_canonical_adapter_source_ids | length) == 0
  and .terminal_envelope_readback_consistent_source_count == 6
  and .task_result_contract_required_field_gap_count == 0
  and .task_result_contract_terminal_field_gap_count == 0
  and (.alignments | all(.drift_resolved == true and .live_enforcement_enabled == false))
' >/dev/null <<<"$report"

jq -e '
  (.alignments[] | select(.current_state_source_id == "plan_mode_proposed_plan")
    | .canonical_adapter_source_id == "plan_mode_proposed_plan_blocks"
      and .alignment_kind == "renamed_alias"
      and .current_state_present == true
      and .canonical_adapter_present == true)
  and
  (.alignments[] | select(.current_state_source_id == "codex_agent_graph_store")
    | .canonical_adapter_source_id == "multi_agent_v2_thread_spawn"
      and .alignment_kind == "covered_by_canonical_surface"
      and .current_state_present == true
      and .canonical_adapter_present == true)
  and
  (.alignments[] | select(.canonical_adapter_source_id == "hepta_runtime_approval_broker")
    | .current_state_source_id == null
      and .alignment_kind == "canonical_shadow_only"
      and .current_state_present == false
      and .canonical_adapter_present == true)
' >/dev/null <<<"$report"

jq -e '
  ((.blockers | map(.id) | index("source_id_alignment_unresolved")) | not)
  and (.blockers | map(.id) | index("canonical_approval_broker_shadow_only"))
  and ((.blockers | map(.id) | index("task_result_contract_required_fields_partial")) | not)
  and (.blockers | map(.id) | index("source_id_alignment_live_enforcement_disabled"))
  and (.blockers | all(.blocks_live_execution == true))
  and (.required_prior_gates == [
    "hepta_work_graph_current_state_inventory_gate",
    "hepta_work_graph_adapter_task_result_index_gate",
    "hepta_work_graph_terminal_envelope_readback_gate"
  ])
  and .recommended_next_gate == "hepta_work_graph_task_result_contract_field_gap_readback_gate"
  and .source_id_alignment_readback_complete == true
  and .ready_for_task_result_contract_field_gap_readback == true
  and .ready_for_append_only_event_store_shadow_path == false
  and .ready_for_live_execution == false
' >/dev/null <<<"$report"

jq -e '
  .source_probes.source_id_alignment_readback.rust_module_present == true
  and .source_probes.source_id_alignment_readback.report_script_present == true
  and .source_probes.source_id_alignment_readback.gate_script_present == true
  and .source_probes.priors.current_state_inventory_gate == "hepta_work_graph_current_state_inventory_gate"
  and .source_probes.priors.adapter_task_result_index_gate == "hepta_work_graph_adapter_task_result_index_gate"
  and .source_probes.priors.terminal_envelope_readback_gate == "hepta_work_graph_terminal_envelope_readback_gate"
  and .source_probes.scheduler_admission_dry_run.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_source_id_alignment_readback --lib

echo "Hepta WorkGraph source-id alignment readback gate passed"
