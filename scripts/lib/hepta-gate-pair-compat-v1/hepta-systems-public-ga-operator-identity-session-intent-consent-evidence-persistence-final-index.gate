#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-persistence-final-index.report"
READBACK_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-persistence-readback.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_INTENT_CONSENT_EVIDENCE_PERSISTENCE_FINAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-persistence-final-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Public GA operator identity/session intent consent evidence final index report: $REPORT"
[[ -x "$READBACK_GATE" ]] || fail "missing executable Public GA operator identity/session intent consent evidence readback gate: $READBACK_GATE"
[[ -f "$DOC" ]] || fail "missing Public GA operator identity/session intent consent evidence final index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Public GA operator identity/session intent consent evidence final index report"
fi

grep -q 'Public GA Operator Identity/Session Operator Intent/Consent Evidence Persistence Final Index' "$DOC" \
  || fail "architecture note must document Public GA Operator Identity/Session Operator Intent/Consent Evidence Persistence Final Index"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that final index does not invoke evidence persistence gates"
grep -q '17 release/live blockers' "$DOC" \
  || fail "architecture note must document canonical terminal closure backfeed blocker count"
grep -q 'runner_selector=2' "$DOC" \
  || fail "architecture note must document runner selector backfeed category"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_final_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_readback_surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_readback"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_readback_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_readback_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_final_index_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_readback_attached == true
  and .public_ga_operator_identity_session_operator_intent_consent_reconfirmation_final_index_attached == true
  and .source_canonical_governance_tool_execution_closure_backfeed_ready == true
  and .source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
  and (.source_canonical_governance_tool_execution_closure_backfeed_categories | map(select(.id == "runner_selector" and .blocker_count == 2 and .queryable == true)) | length) == 1
  and (.source_canonical_governance_tool_execution_closure_backfeed_categories | map(select(.id == "dirty_worktree_owner_freeze" and .blocker_count == 2 and .queryable == true)) | length) == 1
  and .operator_identity_session_operator_intent_consent_evidence_persistence_denial_gate_present == true
  and .operator_identity_session_operator_intent_consent_evidence_persistence_denial_doc_present == true
  and .operator_identity_session_operator_intent_consent_evidence_persistence_denial_gate_invoked == false
  and .operator_identity_session_operator_intent_consent_reconfirmation_denial_gate_invoked == false
  and .long_soak_started == false
  and .operator_intent_evidence_recorded == false
  and .operator_consent_evidence_recorded == false
  and .intent_consent_evidence_recorded == false
  and .intent_consent_evidence_persisted == false
  and .evidence_receipt_recorded == false
  and .evidence_receipt_persisted == false
  and .evidence_materialized == false
  and .evidence_filesystem_written == false
  and .evidence_ledger_written == false
  and .evidence_index_recorded == false
  and .evidence_export_recorded == false
  and .evidence_query_recorded == false
  and .evidence_observability_recorded == false
  and .evidence_readback_recorded == false
  and .identity_session_binding_from_evidence_recorded == false
  and .operator_approval_from_evidence_derived == false
  and .acceptance_from_evidence_recorded == false
  and .release_publication_authority_from_evidence_derived == false
  and .activation_authority_from_evidence_derived == false
  and .install_from_evidence_executed == false
  and .service_restart_from_evidence_performed == false
  and .active_binary_from_evidence_mutated == false
  and .final_blocker_count == 50
  and .manual_operator_live_cutover_approval_required == true
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_ga_claimed == false
  and .public_release_published == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "attach_public_ga_operator_identity_session_operator_intent_consent_evidence_persistence_final_index_to_public_ga_operator_identity_session_operator_intent_consent_evidence_export_query_observability_without_evidence"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$READBACK_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-persistence-final-index-gate: PASS: Public GA operator identity/session intent consent evidence final index is ready but blocked\n'
