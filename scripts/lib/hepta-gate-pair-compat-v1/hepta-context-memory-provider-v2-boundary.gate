#!/usr/bin/env bash
set -euo pipefail

repo_root="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
manifest="$repo_root/codex-rs/Cargo.toml"
contracts="$repo_root/codex-rs/CONTEXT_DEBUG_CONTRACTS.md"
debug_gate="$repo_root/scripts/hepta-context-debug-gate.sh"
preflight_script="$repo_root/scripts/hepta-context-preflight.sh"
release_manifest="$repo_root/codex-rs/CONTEXT_LANE_RELEASE_MANIFEST.tsv"
report_script="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-provider-v2-boundary.report"
gate_script="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-provider-v2-boundary.gate"
provider_plane_v2="$repo_root/codex-rs/hepta-core/src/memory/provider_plane_v2.rs"
hepta_core_memory="$repo_root/codex-rs/hepta-core/src/memory.rs"
hepta_core_store_tests="$repo_root/codex-rs/hepta-core/src/memory/tests/store.rs"
hepta_memory="$repo_root/codex-rs/hepta-memory/src/lib.rs"
hepta_memory_tests="$repo_root/codex-rs/hepta-memory/src/tests/context_memory.rs"
lane="${HEPTA_CARGO_LANE:-${HEPTA_LANE:-hepta-context}}"
target_root="${HEPTA_CARGO_TARGET_ROOT:-$HOME/.openclaw/tmp/cargo-targets}"
target_leaf="$lane"
if [[ "$target_leaf" != hepta-* ]]; then
  target_leaf="hepta-$target_leaf"
fi
export CARGO_TARGET_DIR="${HEPTA_CARGO_TARGET_DIR:-$target_root/$target_leaf}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
report_output="$(mktemp -t hepta-context-memory-provider-v2-boundary-report.XXXXXX)"

cleanup() {
  rm -f "$report_output"
}
trap cleanup EXIT

fail() {
  echo "hepta-context-memory-provider-v2-boundary-gate: $*" >&2
  if [ -s "$report_output" ]; then
    echo "memory provider v2 boundary report output:" >&2
    cat "$report_output" >&2
  fi
  exit 1
}

assert_file_contains() {
  local file_path="$1"
  local needle="$2"
  local label="$3"

  if ! grep -F "$needle" "$file_path" >/dev/null; then
    fail "$label must contain: $needle"
  fi
}

assert_report_line() {
  local expected="$1"
  if ! grep -F -x "$expected" "$report_output" >/dev/null; then
    fail "memory provider v2 boundary report must contain line: $expected"
  fi
}

line_number_of() {
  local file_path="$1"
  local needle="$2"
  local line

  line="$(grep -n -F "$needle" "$file_path" | head -n 1 | cut -d: -f1 || true)"
  if [ -z "$line" ]; then
    fail "$file_path is missing required text: $needle"
  fi
  printf '%s\n' "$line"
}

assert_line_before() {
  local file_path="$1"
  local before_needle="$2"
  local after_needle="$3"
  local label="$4"
  local before_line
  local after_line

  before_line="$(line_number_of "$file_path" "$before_needle")"
  after_line="$(line_number_of "$file_path" "$after_needle")"
  if [ "$before_line" -ge "$after_line" ]; then
    fail "$label expected '$before_needle' before '$after_needle'"
  fi
}

bash "$report_script" >"$report_output"

assert_report_line "memory-provider-v2-boundary=pass"
assert_report_line "memory-provider-v2-boundary.payload-light=pass"
assert_report_line "memory-provider-v2-boundary.mode=shadow-only"
assert_report_line "memory-provider-v2-boundary.lifecycle=query+update_context+propose_write+add+clear+close"
assert_report_line "memory-provider-v2-boundary.propose-write=shadow-proposal"
assert_report_line "memory-provider-v2-boundary.add=dry-run-or-blocked"
assert_report_line "memory-provider-v2-boundary.clear=dry-run-or-blocked"
assert_report_line "memory-provider-v2-boundary.close=noop-close-report"
assert_report_line "memory-provider-v2-boundary.operator-approval=required"
assert_report_line "memory-provider-v2-boundary.production-route=disabled"
assert_report_line "memory-provider-v2-boundary.write=disabled"
assert_report_line "memory-provider-v2-boundary.graph-write=disabled"
assert_report_line "memory-provider-v2-boundary.runtime-activation=disabled"

for term in \
  "MemoryProviderV2 boundary" \
  "query / update_context / propose_write / add / clear / close" \
  "MemoryProviderWriteProposalReport" \
  "MemoryProviderAddReport" \
  "MemoryProviderCloseReport" \
  "MemoryProviderV2AuditReport" \
  "candidate_payload_exported=false" \
  "source_payload_exported=false" \
  "write_performed=false" \
  "graph_write_performed=false" \
  "runtime_activation=false"; do
  assert_file_contains "$contracts" "$term" "memory provider v2 boundary contract"
done

for term in \
  "pub trait MemoryProviderV2" \
  "MemoryProviderWriteProposalReport" \
  "MemoryProviderAddRequest" \
  "MemoryProviderAddReport" \
  "MemoryProviderCloseReport" \
  "MemoryProviderV2AuditReport" \
  "pub fn has_shadow_boundary_integrity" \
  "pub fn has_no_side_effects"; do
  assert_file_contains "$provider_plane_v2" "$term" "memory provider v2 rust boundary"
done

for term in \
  "pub use provider_plane_v2::MemoryProviderV2" \
  "pub use provider_plane_v2::MemoryProviderWriteProposalReport" \
  "pub use provider_plane_v2::MemoryProviderAddReport" \
  "pub use provider_plane_v2::MemoryProviderCloseReport" \
  "pub use provider_plane_v2::MemoryProviderV2AuditReport"; do
  assert_file_contains "$hepta_core_memory" "$term" "memory provider v2 public re-export"
done

assert_file_contains "$hepta_core_store_tests" \
  "memory_provider_v2_trait_supports_shadow_write_lifecycle_boundaries" \
  "memory provider v2 hepta-core test"
assert_file_contains "$hepta_memory" \
  "impl hepta_core::MemoryProviderV2 for InMemoryStore" \
  "memory provider v2 hepta-memory implementation"
assert_file_contains "$hepta_memory_tests" \
  "store_memory_provider_v2_write_lifecycle_is_shadow_only_without_store_mutation" \
  "memory provider v2 hepta-memory lifecycle test"

assert_file_contains "$debug_gate" "hepta-context-memory-provider-v2-boundary-gate.sh" \
  "memory provider v2 debug gate"
assert_file_contains "$preflight_script" "context memory provider v2 boundary gate" \
  "memory provider v2 preflight stage"
assert_file_contains "$release_manifest" "scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-provider-v2-boundary.report" \
  "memory provider v2 report release manifest"
assert_file_contains "$release_manifest" "scripts/lib/hepta-gate-pair-compat-v1/hepta-context-memory-provider-v2-boundary.gate" \
  "memory provider v2 gate release manifest"

assert_line_before \
  "$debug_gate" \
  "hepta-context-memory-provider-boundary-gate.sh" \
  "hepta-context-memory-provider-v2-boundary-gate.sh" \
  "memory provider v2 debug order"
assert_line_before \
  "$debug_gate" \
  "hepta-context-memory-provider-v2-boundary-gate.sh" \
  "hepta-context-memory-shadow-regression-dashboard-gate.sh" \
  "memory provider v2 dashboard debug order"
assert_line_before \
  "$preflight_script" \
  "context memory provider boundary gate" \
  "context memory provider v2 boundary gate" \
  "memory provider v2 preflight order"
assert_line_before \
  "$preflight_script" \
  "context memory provider v2 boundary gate" \
  "context memory shadow regression dashboard gate" \
  "memory provider v2 dashboard preflight order"

leak_pattern='(prompt_text|transcript_text|memory_text|answer_text|session_id|memory_id|source_id|trace_id|query_text|candidate_text|tool_args|tool_outputs|raw_payload|ranked_payload=|candidate_payload=|runtime-activation=enabled|production-route=enabled|operator-activation=enabled|write=enabled|graph-write=enabled)'
if grep -E "$leak_pattern" "$report_output" >/dev/null; then
  fail "memory provider v2 boundary report leaked payload or activation state"
fi

bash -n "$report_script"
bash -n "$gate_script"

cargo test --manifest-path "$manifest" -p hepta-core \
  memory_provider_v2 \
  --lib --message-format=short

cargo test --manifest-path "$manifest" -p hepta-memory \
  memory_provider_v2 \
  --lib --message-format=short

echo "memory-provider-v2-boundary=pass"
echo "memory-provider-v2-boundary.payload-light=pass"
echo "memory-provider-v2-boundary.propose-write=shadow-proposal"
echo "memory-provider-v2-boundary.add=dry-run-or-blocked"
echo "memory-provider-v2-boundary.close=noop-close-report"
echo "memory-provider-v2-boundary.runtime-activation=disabled"
