#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-append-only-store-runtime-write-boundary-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-append-only-store-runtime-write-boundary-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "blocked"
  and .gate == "hepta_work_graph_append_only_store_runtime_write_boundary_preview_gate"
  and .schema_version == "work_graph_append_only_store_runtime_write_boundary_preview_v1"
  and .preview_mode == "read_only_append_only_store_runtime_write_boundary_preview_no_wal_or_store_mutation"
  and .upstream_operator_review_side_effect_lock_rerun_gate == "hepta_work_graph_unified_projection_enforcement_readiness_operator_review_side_effect_lock_rerun_preview_gate"
  and .source_surface_count == 12
  and .runtime_write_boundary_source_count == 12
  and .runtime_write_boundary_plan_count == 12
  and .runtime_write_boundary_stage_count == 5
  and .runtime_write_boundary_stage_source_ref_count == 60
  and .runtime_write_boundary_stage_contract_ref_count == 27
  and .runtime_write_boundary_plan_stage_ref_count == 60
  and .runtime_write_boundary_plan_evidence_field_ref_count == 108
  and .wal_boundary_residual_source_count == 12
  and .durable_store_residual_source_count == 12
  and .idempotency_residual_source_count == 12
  and .rollback_readback_residual_source_count == 12
  and .guard_count == 8
  and .blocker_count == 6
  and .required_prior_gate_count == 52
' >/dev/null <<<"$report"

jq -e '
  (.runtime_write_boundary_plans | map(.source_surface_id) == [
    "update_plan_tool",
    "plan_mode_proposed_plan_blocks",
    "app_server_turn_plan_notification",
    "multi_agent_v2_thread_spawn",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "agent_jobs_batch_workers",
    "hepta_runtime_task_board",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_approval_broker",
    "hepta_runtime_agent_harness"
  ])
  and (.runtime_write_boundary_plans | all(
    .previous_enforcement_decision == "deny_runtime_append_only_store_write_boundary_disabled"
    and .write_boundary_state == "runtime_write_boundary_contract_defined_preview_only"
    and .required_write_boundary_stage_ids == [
      "wal_write_boundary",
      "durable_store_runtime_switch_guard",
      "idempotency_mutation_policy",
      "rollback_readback_execution_boundary",
      "no_mutation_guard"
    ]
    and .expected_evidence_field_ids == [
      "source_surface_id",
      "source_category",
      "operator_review_side_effect_lock_rerun_decision_ref",
      "wal_write_boundary_contract_id",
      "durable_store_switch_guard_id",
      "idempotency_mutation_policy_id",
      "rollback_readback_boundary_id",
      "residual_source_blocker_ids",
      "no_mutation_guard_ref"
    ]
    and .write_boundary_contract_ready_preview == true
    and .applies_to_runtime == false
    and .writes_wal == false
    and .writes_checkpoint == false
    and .switches_durable_store == false
    and .mutates_idempotency_index == false
    and .executes_readback == false
    and .executes_rollback == false
    and .records_approval == false
    and .mutates_runtime == false
  ))
  and (.runtime_write_boundary_plans | map(select(.residual_source_blocker_ids | index("wal_write_boundary_not_enabled"))) | length) == 12
  and (.runtime_write_boundary_plans | map(select(.residual_source_blocker_ids | index("operator_review_required"))) | length) == 0
  and (.runtime_write_boundary_plans | map(select(.residual_source_blocker_ids | index("side_effect_lock_not_established"))) | length) == 0
' >/dev/null <<<"$report"

jq -e '
  (.runtime_write_boundary_stage_plans | map({id, count: (.affected_source_surface_ids | length), contracts: (.required_contract_ref_ids | length)}) == [
    {"id": "wal_write_boundary", "count": 12, "contracts": 6},
    {"id": "durable_store_runtime_switch_guard", "count": 12, "contracts": 5},
    {"id": "idempotency_mutation_policy", "count": 12, "contracts": 5},
    {"id": "rollback_readback_execution_boundary", "count": 12, "contracts": 5},
    {"id": "no_mutation_guard", "count": 12, "contracts": 6}
  ])
  and (.runtime_write_boundary_stage_plans | all(
    .priority == "p0"
    and .expected_runtime_state == "contract_ready_preview_runtime_disabled"
    and .contract_ready_preview == true
    and .runtime_enabled_after_preview == false
    and (.prerequisite_gate_ids[-1] == "hepta_work_graph_unified_projection_enforcement_readiness_operator_review_side_effect_lock_rerun_preview_gate")
  ))
  and (.runtime_write_boundary_stage_plans | map(select(.id == "wal_write_boundary" and .writes_wal == true and .writes_checkpoint == true)) | length) == 1
  and (.runtime_write_boundary_stage_plans | map(select(.id == "durable_store_runtime_switch_guard" and .switches_durable_store == true)) | length) == 1
  and (.runtime_write_boundary_stage_plans | map(select(.id == "idempotency_mutation_policy" and .mutates_idempotency_index == true)) | length) == 1
  and (.runtime_write_boundary_stage_plans | map(select(.id == "rollback_readback_execution_boundary" and .executes_readback == true and .executes_rollback == true and .writes_checkpoint == true)) | length) == 1
  and (.runtime_write_boundary_stage_plans | map(select(.id == "no_mutation_guard" and .writes_wal == false and .writes_checkpoint == false and .switches_durable_store == false and .mutates_idempotency_index == false and .executes_readback == false and .executes_rollback == false)) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  (.guards | map(.id) == [
    "runtime_write_boundary_preview_only",
    "wal_write_boundary_disabled",
    "durable_store_runtime_switch_disabled",
    "idempotency_index_mutation_disabled",
    "rollback_readback_execution_disabled",
    "readback_execution_disabled",
    "checkpoint_write_disabled",
    "runtime_mutation_disabled"
  ])
  and (.guards | all(.required_before_runtime_write_boundary == true and .satisfied_by_preview == false))
  and (.blockers | map({id, count: (.affected_source_surface_ids | length), stages: .affected_runtime_write_boundary_stage_ids}) == [
    {"id": "readback_execution_disabled", "count": 12, "stages": ["rollback_readback_execution_boundary"]},
    {"id": "durable_store_runtime_switch_disabled", "count": 12, "stages": ["durable_store_runtime_switch_guard"]},
    {"id": "wal_write_boundary_not_enabled", "count": 12, "stages": ["wal_write_boundary"]},
    {"id": "idempotency_index_mutation_disabled", "count": 12, "stages": ["idempotency_mutation_policy"]},
    {"id": "rollback_readback_not_executed", "count": 12, "stages": ["rollback_readback_execution_boundary"]},
    {"id": "runtime_write_boundary_readback_missing", "count": 12, "stages": [
      "wal_write_boundary",
      "durable_store_runtime_switch_guard",
      "idempotency_mutation_policy",
      "rollback_readback_execution_boundary",
      "no_mutation_guard"
    ]}
  ])
  and (.blockers | all(.required_before_runtime_write_boundary == true))
  and (.blockers | all((.affected_runtime_write_boundary_plan_ids | length) == (.affected_source_surface_ids | length)))
' >/dev/null <<<"$report"

jq -e '
  (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_unified_projection_enforcement_readiness_operator_review_side_effect_lock_rerun_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_append_only_store_runtime_write_boundary_readback_preview_gate"
  and .ready_for_runtime_write_boundary_readback_preview == true
  and .ready_for_runtime_write_boundary_application_preview == false
  and .ready_for_wal_write == false
  and .ready_for_durable_store_switch == false
  and .ready_for_idempotency_mutation == false
  and .ready_for_rollback_readback_execution == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_projection_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.runtime_write_boundary_preview.rust_module_present == true
  and .source_probes.runtime_write_boundary_preview.report_script_present == true
  and .source_probes.runtime_write_boundary_preview.gate_script_present == true
  and .source_probes.operator_review_side_effect_lock_rerun.upstream_gate == true
  and .source_probes.operator_review_side_effect_lock_rerun.gate_script_present == true
  and .source_probes.operator_review_side_effect_lock_rerun.recommended_next_matches == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_append_only_store_runtime_write_boundary --lib

echo "Hepta WorkGraph append-only store runtime write-boundary preview gate passed"
