#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

adapter_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_idempotency_readback_adapter_preview.rs
)"
adapter_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-idempotency-readback-adapter-preview.report
)"
adapter_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-idempotency-readback-adapter-preview.gate
)"
replay_readback_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_replay_readback_preview.rs
)"
replay_readback_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-replay-readback-preview.report
)"
replay_readback_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-replay-readback-preview.gate
)"
append_only_event_intake_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_append_only_event_intake_preview.rs
)"
append_only_event_intake_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-append-only-event-intake-preview.gate
)"

jq -n \
  --argjson adapter_rust_module_present "$adapter_rust_module_present" \
  --argjson adapter_report_script_present "$adapter_report_script_present" \
  --argjson adapter_gate_script_present "$adapter_gate_script_present" \
  --argjson replay_readback_rust_module_present "$replay_readback_rust_module_present" \
  --argjson replay_readback_report_script_present "$replay_readback_report_script_present" \
  --argjson replay_readback_gate_script_present "$replay_readback_gate_script_present" \
  --argjson append_only_event_intake_rust_module_present "$append_only_event_intake_rust_module_present" \
  --argjson append_only_event_intake_gate_script_present "$append_only_event_intake_gate_script_present" \
  '
  def prior_gates: [
    "hepta_work_graph_contract_preview_gate",
    "hepta_work_graph_task_result_contract_preview_gate",
    "hepta_work_graph_scheduler_admission_controller_preview_gate",
    "hepta_work_graph_observability_timeline_preview_gate",
    "hepta_work_graph_role_manifest_contract_preview_gate",
    "hepta_work_graph_unified_state_store_preview_gate",
    "hepta_work_graph_adapter_projection_fixture_gate",
    "hepta_work_graph_unified_projection_audit_preview_gate",
    "hepta_work_graph_state_store_persistence_preview_gate",
    "hepta_work_graph_append_only_event_intake_preview_gate",
    "hepta_work_graph_replay_readback_preview_gate"
  ];
  def adapter($id; $source; $category; $events; $key; $probes; $collections; $gap; $task_result; $redaction): {
    id: $id,
    source_surface_id: $source,
    source_category: $category,
    emitted_event_contract_ids: $events,
    replay_key_contract_id: $key,
    readback_probe_contract_ids: $probes,
    expected_collection_ids: $collections,
    closes_source_gap_id: $gap,
    adapter_state: "preview_contract_ready_runtime_attachment_disabled",
    redaction_policy: $redaction,
    requires_task_result_wrapper: $task_result,
    attaches_runtime_adapter: false,
    performs_readback: false,
    mutates_store: false
  };
  def replay_key($id; $source; $fields; $formula; $collision; $scope; $redaction): {
    id: $id,
    source_surface_id: $source,
    key_fields: $fields,
    key_formula: $formula,
    collision_policy: $collision,
    replay_scope: $scope,
    redaction_policy: $redaction,
    mutates_idempotency_index: false
  };
  def probe($id; $source; $collection; $inputs; $evidence): {
    id: $id,
    source_surface_id: $source,
    collection_id: $collection,
    required_inputs: $inputs,
    evidence_fields: $evidence,
    drift_detector_ids: ["detect_identity_drift", "detect_ordering_drift", "detect_hash_drift"],
    performs_readback: false,
    mutates_store: false
  };
  def closure($id; $source; $gap; $adapter): {
    id: $id,
    source_surface_id: $source,
    closes_replay_readback_gap_id: $gap,
    adapter_id: $adapter,
    closure_state: "preview_contract_defined_runtime_not_attached",
    required_before_replay_execution: true
  };
  def blocker($id; $severity; $sources; $fix): {
    id: $id,
    severity: $severity,
    affected_source_surface_ids: $sources,
    required_before_replay_execution: true,
    recommended_fix: $fix
  };
  [
    adapter("plan_mode_proposed_plan_blocks_idempotency_readback_adapter"; "plan_mode_proposed_plan_blocks"; "planning"; ["plan_step_event_intake"]; "plan_mode_plan_step_replay_key"; ["plan_mode_nodes_readback_probe", "plan_mode_edges_readback_probe", "plan_mode_timeline_readback_probe"]; ["nodes", "edges", "timelineEvents"]; "gap_plan_mode_proposed_plan_blocks_replay_key"; false; "hash raw proposed plan text and expose only trace, step, proposal hash, and redacted refs"),
    adapter("app_server_turn_plan_notification_idempotency_readback_adapter"; "app_server_turn_plan_notification"; "planning"; ["plan_step_event_intake"]; "app_server_turn_plan_notification_replay_key"; ["app_server_plan_nodes_readback_probe", "app_server_plan_edges_readback_probe", "app_server_plan_timeline_readback_probe"]; ["nodes", "edges", "timelineEvents"]; "gap_app_server_turn_plan_notification_replay_key"; false; "store notification sequence and proposal hash only, never raw plan payload"),
    adapter("multi_agent_mailbox_delivery_idempotency_readback_adapter"; "multi_agent_v2_mailbox_wait"; "multi_agent"; ["mailbox_delivery_event_intake"]; "multi_agent_mailbox_delivery_replay_key"; ["mailbox_edges_readback_probe", "mailbox_timeline_readback_probe"]; ["edges", "timelineEvents"]; "gap_multi_agent_mailbox_delivery_replay_key"; false; "hash inter-agent message content and expose mailbox seq, agent path, and delivery state refs"),
    adapter("multi_agent_reducer_task_result_idempotency_readback_adapter"; "hepta_runtime_multi_agent_reducer"; "multi_agent"; ["task_result_event_intake"]; "multi_agent_reducer_task_result_replay_key"; ["multi_agent_reducer_task_result_readback_probe", "multi_agent_reducer_timeline_readback_probe"]; ["taskResults", "timelineEvents"]; "gap_multi_agent_reducer_task_result_replay_key"; true; "store reducer strategy, status, and evidence hash without raw subagent payload"),
    adapter("task_board_worker_task_idempotency_readback_adapter"; "hepta_runtime_task_board"; "runtime_scheduler"; ["worker_task_event_intake"]; "task_board_worker_task_replay_key"; ["task_board_nodes_readback_probe", "task_board_task_results_readback_probe", "task_board_artifacts_readback_probe", "task_board_timeline_readback_probe"]; ["nodes", "taskResults", "artifacts", "timelineEvents"]; "gap_task_board_worker_task_replay_key"; true; "store lane, lease state, attempt, and artifact hashes without command payload")
  ] as $source_adapters
  | [
    replay_key("plan_mode_plan_step_replay_key"; "plan_mode_proposed_plan_blocks"; ["traceId", "turnId", "stepIndex", "proposalHash"]; "sha256(traceId || turnId || stepIndex || proposalHash)"; "collision_blocks_plan_node_materialization"; "turn_plan_step"; "proposalHash replaces raw proposed plan text"),
    replay_key("app_server_turn_plan_notification_replay_key"; "app_server_turn_plan_notification"; ["traceId", "turnId", "notificationSeq", "proposalHash"]; "sha256(traceId || turnId || notificationSeq || proposalHash)"; "collision_blocks_app_server_plan_notification_materialization"; "turn_plan_notification"; "proposalHash and notificationSeq replace raw notification payload"),
    replay_key("multi_agent_mailbox_delivery_replay_key"; "multi_agent_v2_mailbox_wait"; ["traceId", "agentPath", "mailboxSeq", "deliveryState"]; "sha256(traceId || agentPath || mailboxSeq || deliveryState)"; "collision_blocks_mailbox_delivery_materialization"; "agent_mailbox_delivery"; "message content is hashed and delivery refs are redacted"),
    replay_key("multi_agent_reducer_task_result_replay_key"; "hepta_runtime_multi_agent_reducer"; ["traceId", "taskId", "reducerStrategy", "status", "evidenceHash"]; "sha256(traceId || taskId || reducerStrategy || status || evidenceHash)"; "collision_blocks_reducer_task_result_materialization"; "multi_agent_reducer_task_result"; "evidenceHash and verifier refs replace raw subagent output"),
    replay_key("task_board_worker_task_replay_key"; "hepta_runtime_task_board"; ["workerTaskId", "attempt", "lane", "leaseState", "artifactHash"]; "sha256(workerTaskId || attempt || lane || leaseState || artifactHash)"; "collision_blocks_task_board_worker_task_materialization"; "scheduler_worker_task"; "artifactHash and lease state replace command payload")
  ] as $replay_key_contracts
  | [
    probe("plan_mode_nodes_readback_probe"; "plan_mode_proposed_plan_blocks"; "nodes"; ["traceId", "planStepId", "proposalHash"]; ["nodeHash", "status", "redactionState"]),
    probe("plan_mode_edges_readback_probe"; "plan_mode_proposed_plan_blocks"; "edges"; ["traceId", "planStepId", "dependencyRefs"]; ["edgeHash", "dependencyCount", "missingEdgeIds"]),
    probe("plan_mode_timeline_readback_probe"; "plan_mode_proposed_plan_blocks"; "timelineEvents"; ["traceId", "eventKind", "proposalHash"]; ["timelineHash", "eventCount", "redactionState"]),
    probe("app_server_plan_nodes_readback_probe"; "app_server_turn_plan_notification"; "nodes"; ["traceId", "turnId", "notificationSeq"]; ["nodeHash", "notificationStatus", "redactionState"]),
    probe("app_server_plan_edges_readback_probe"; "app_server_turn_plan_notification"; "edges"; ["traceId", "turnId", "notificationSeq"]; ["edgeHash", "dependencyCount", "missingEdgeIds"]),
    probe("app_server_plan_timeline_readback_probe"; "app_server_turn_plan_notification"; "timelineEvents"; ["traceId", "turnId", "notificationSeq"]; ["timelineHash", "eventCount", "redactionState"]),
    probe("mailbox_edges_readback_probe"; "multi_agent_v2_mailbox_wait"; "edges"; ["traceId", "agentPath", "mailboxSeq"]; ["edgeHash", "deliveryState", "missingEdgeIds"]),
    probe("mailbox_timeline_readback_probe"; "multi_agent_v2_mailbox_wait"; "timelineEvents"; ["traceId", "agentPath", "mailboxSeq"]; ["timelineHash", "eventCount", "redactionState"]),
    probe("multi_agent_reducer_task_result_readback_probe"; "hepta_runtime_multi_agent_reducer"; "taskResults"; ["traceId", "taskId", "reducerStrategy", "evidenceHash"]; ["taskResultHash", "terminalStatusObserved", "evidenceRefs"]),
    probe("multi_agent_reducer_timeline_readback_probe"; "hepta_runtime_multi_agent_reducer"; "timelineEvents"; ["traceId", "taskId", "reducerStrategy"]; ["timelineHash", "eventCount", "redactionState"]),
    probe("task_board_nodes_readback_probe"; "hepta_runtime_task_board"; "nodes"; ["workerTaskId", "attempt", "lane"]; ["nodeHash", "leaseState", "status"]),
    probe("task_board_task_results_readback_probe"; "hepta_runtime_task_board"; "taskResults"; ["workerTaskId", "attempt", "artifactHash"]; ["taskResultHash", "terminalStatusObserved", "evidenceRefs"]),
    probe("task_board_artifacts_readback_probe"; "hepta_runtime_task_board"; "artifacts"; ["workerTaskId", "artifactHash", "producerNodeId"]; ["artifactCount", "artifactHash", "redactionState"]),
    probe("task_board_timeline_readback_probe"; "hepta_runtime_task_board"; "timelineEvents"; ["workerTaskId", "attempt", "lane"]; ["timelineHash", "eventCount", "redactionState"])
  ] as $readback_probe_contracts
  | [
    closure("close_plan_mode_proposed_plan_blocks_replay_key_gap"; "plan_mode_proposed_plan_blocks"; "gap_plan_mode_proposed_plan_blocks_replay_key"; "plan_mode_proposed_plan_blocks_idempotency_readback_adapter"),
    closure("close_app_server_turn_plan_notification_replay_key_gap"; "app_server_turn_plan_notification"; "gap_app_server_turn_plan_notification_replay_key"; "app_server_turn_plan_notification_idempotency_readback_adapter"),
    closure("close_multi_agent_mailbox_delivery_replay_key_gap"; "multi_agent_v2_mailbox_wait"; "gap_multi_agent_mailbox_delivery_replay_key"; "multi_agent_mailbox_delivery_idempotency_readback_adapter"),
    closure("close_multi_agent_reducer_task_result_replay_key_gap"; "hepta_runtime_multi_agent_reducer"; "gap_multi_agent_reducer_task_result_replay_key"; "multi_agent_reducer_task_result_idempotency_readback_adapter"),
    closure("close_task_board_worker_task_replay_key_gap"; "hepta_runtime_task_board"; "gap_task_board_worker_task_replay_key"; "task_board_worker_task_idempotency_readback_adapter")
  ] as $gap_closures
  | [
    blocker("runtime_adapter_attachment_disabled"; "high"; ($source_adapters | map(.source_surface_id)); "wire these contracts to source adapters only after replay fixtures pass"),
    blocker("terminal_task_result_wrapper_not_enforced"; "high"; ["hepta_runtime_multi_agent_reducer", "hepta_runtime_task_board"]; "wrap reducer and task_board terminal outputs in TaskResult before execution"),
    blocker("append_only_store_still_disabled"; "medium"; ($source_adapters | map(.source_surface_id)); "keep store writes disabled until replay/readback evidence is deterministic"),
    blocker("replay_execution_disabled_by_design"; "medium"; ($source_adapters | map(.source_surface_id)); "run fixture-only replay verification before any WAL replay execution")
  ] as $blockers
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_idempotency_readback_adapter_preview_gate",
      schema_version: "work_graph_idempotency_readback_adapter_preview_v1",
      preview_mode: "read_only_idempotency_readback_adapter_preview_no_attachment",
      source_adapter_count: ($source_adapters | length),
      replay_key_contract_count: ($replay_key_contracts | length),
      readback_probe_contract_count: ($readback_probe_contracts | length),
      gap_closure_count: ($gap_closures | length),
      blocker_count: ($blockers | length),
      required_prior_gate_count: (prior_gates | length),
      source_adapters: $source_adapters,
      replay_key_contracts: $replay_key_contracts,
      readback_probe_contracts: $readback_probe_contracts,
      gap_closures: $gap_closures,
      blockers: $blockers,
      required_prior_gates: prior_gates,
      recommended_next_gate: "hepta_work_graph_terminal_task_result_wrapper_preview_gate",
      ready_for_task_result_wrapper_preview: true,
      ready_for_replay_execution: false,
      ready_for_store_enablement: false,
      ready_for_live_execution: false,
      source_probes: {
        idempotency_readback_adapter: {
          rust_module_present: $adapter_rust_module_present,
          report_script_present: $adapter_report_script_present,
          gate_script_present: $adapter_gate_script_present
        },
        replay_readback: {
          rust_module_present: $replay_readback_rust_module_present,
          report_script_present: $replay_readback_report_script_present,
          gate_script_present: $replay_readback_gate_script_present
        },
        append_only_event_intake: {
          rust_module_present: $append_only_event_intake_rust_module_present,
          gate_script_present: $append_only_event_intake_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        event_record_persisted: false,
        graph_state_persisted: false,
        wal_written: false,
        checkpoint_written: false,
        idempotency_index_mutated: false,
        readback_performed: false,
        runtime_adapter_attached: false,
        replay_executed: false,
        scheduler_admission_enforced: false,
        task_result_enforcement_enabled: false,
        approval_recorded: false,
        agent_spawn_performed: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
