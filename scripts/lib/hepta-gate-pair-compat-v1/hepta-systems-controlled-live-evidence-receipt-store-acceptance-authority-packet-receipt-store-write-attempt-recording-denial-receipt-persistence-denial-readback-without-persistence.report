  ($entries | map(select(.source_positive_precondition_set_projected == true)) | length) as $source_positive_preconditions_attached_count |
  ($entries | map(select(.denial_receipt_persistence_denied == true)) | length) as $denial_receipt_persistence_denied_count |
  ($entries | map(select(.denial_receipt_persistence_disabled == true)) | length) as $denial_receipt_persistence_disabled_count |
