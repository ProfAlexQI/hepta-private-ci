  ($entries | map(select(.denial_receipt_persisted == true)) | length) as $denial_receipt_persisted_count |
  ($entries | map(select(.persistence_authority_required == true and .persistence_authority_present == false)) | length) as $persistence_authority_missing_count |
  ($entries | map(select(.operator_persistence_approval_required == true and .operator_persistence_approval_present == false)) | length) as $operator_persistence_approval_missing_count |
  ($entries | map(select(.evidence_acceptance_required == true and .evidence_acceptance_present == false)) | length) as $evidence_acceptance_missing_count |
  ($entries | map(select(.denial_receipt_persistence_grant_required == true and .denial_receipt_persistence_grant_present == false)) | length) as $denial_receipt_persistence_grant_missing_count |
  ($entries | map(select(.atomic_append_required == true and .atomic_append_enabled == false)) | length) as $atomic_append_disabled_count |
