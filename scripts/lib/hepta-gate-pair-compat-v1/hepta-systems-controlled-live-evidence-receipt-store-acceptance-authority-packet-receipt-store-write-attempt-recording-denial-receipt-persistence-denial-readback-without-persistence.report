    source_denial_reason:.source_denial_reason,
    persistence_denial_id:("write-attempt-recording-denial-receipt-persistence-denial:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    persistence_denial_route:($route + "/" + hyphen_id(.source_blocker_id)),
    persistence_denial_reason:$denial_reason,
