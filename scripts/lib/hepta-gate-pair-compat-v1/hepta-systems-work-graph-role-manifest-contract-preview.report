#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

role_manifest_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_role_manifest_contract.rs
)"
role_manifest_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-role-manifest-contract-preview.report
)"
role_manifest_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-role-manifest-contract-preview.gate
)"
observability_timeline_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_observability_timeline.rs
)"
observability_timeline_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-observability-timeline-preview.report
)"
observability_timeline_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-observability-timeline-preview.gate
)"

jq -n \
  --argjson role_manifest_rust_module_present "$role_manifest_rust_module_present" \
  --argjson role_manifest_report_script_present "$role_manifest_report_script_present" \
  --argjson role_manifest_gate_script_present "$role_manifest_gate_script_present" \
  --argjson observability_timeline_rust_module_present "$observability_timeline_rust_module_present" \
  --argjson observability_timeline_report_script_present "$observability_timeline_report_script_present" \
  --argjson observability_timeline_gate_script_present "$observability_timeline_gate_script_present" \
  '
  def field($wire; $purpose): {
    wire_name: $wire,
    required: true,
    purpose: $purpose
  };
  def capability($id; $tool; $verifier; $purpose): {
    id: $id,
    requires_tool_permission: $tool,
    requires_verifier: $verifier,
    purpose: $purpose
  };
  def permission($id; $mutates; $approval; $purpose): {
    id: $id,
    can_mutate_runtime: $mutates,
    requires_approval: $approval,
    purpose: $purpose
  };
  def invariant($id; $reason): {
    id: $id,
    required: true,
    reason: $reason
  };
  def adapter($source; $role_kind; $fields; $blockers): {
    source_surface_id: $source,
    projected_role_kind: $role_kind,
    covered_wire_fields: $fields,
    enforcement_enabled: false,
    blocker_ids: $blockers
  };
  [
    field("roleId"; "stable role identity for task admission and audit"),
    field("roleKind"; "planner, builder, reviewer, verifier, operator, or handoff role category"),
    field("agentPath"; "canonical agent path or role binding target"),
    field("capabilities"; "declared capabilities that the role may exercise"),
    field("toolPermissions"; "tool families, scopes, and permission modes"),
    field("outputSchemaRef"; "TaskResult or domain output schema expected from the role"),
    field("verifierRef"; "gate, reducer, or reviewer that can accept the role output"),
    field("budget"; "token, wall-clock, attempt, and command budget envelope"),
    field("concurrency"; "max concurrent tasks, child agents, and tool slots"),
    field("lane"; "lane ownership and workspace routing boundary"),
    field("approvalPolicy"; "operator approval and escalation rules"),
    field("tracePolicy"; "trace, redaction, and evidence requirements")
  ] as $required_fields
  | [
    capability("planning"; false; true; "may create or update plan_step nodes without executing work"),
    capability("agent_delegation"; true; true; "may propose or spawn agent_task nodes under bounded role rules"),
    capability("code_editing"; true; true; "may produce patches or artifacts in a scoped workspace"),
    capability("verification"; true; true; "may run local gates and produce verification_gate evidence"),
    capability("research"; true; true; "may gather read-only evidence from approved tools or sources"),
    capability("scheduler_control"; true; true; "may propose scheduler_run admission or retry decisions"),
    capability("external_handoff_proposal"; true; true; "may prepare external_handoff previews without delivery authority")
  ] as $capabilities
  | [
    permission("deny"; false; false; "capability or tool family is unavailable"),
    permission("preview"; false; false; "role may produce a side-effect-free preview"),
    permission("read_only"; false; false; "role may inspect local state without mutation"),
    permission("write_scoped"; true; true; "role may mutate only after scoped approval and admission checks"),
    permission("approval_required"; false; true; "role must pause for explicit operator approval before execution")
  ] as $permission_modes
  | [
    invariant("capability_requires_permission_mode"; "every declared capability must map to an explicit tool permission mode"),
    invariant("mutation_requires_approval_and_lane"; "runtime mutation authority cannot exist without approval policy and lane binding"),
    invariant("terminal_output_requires_schema_and_verifier"; "roles that complete work must declare output schema and verifier references"),
    invariant("budget_and_concurrency_are_required"; "roles cannot be admitted without bounded budget and concurrency limits"),
    invariant("trace_policy_is_required"; "role outputs must be joinable to WorkGraph trace and redacted evidence"),
    invariant("preview_gate_does_not_change_permissions"; "this preview cannot enable role enforcement or alter tool permissions")
  ] as $invariants
  | [
    adapter("multi_agent_v2_thread_spawn"; "agent_task_role"; ["roleId", "agentPath", "capabilities", "toolPermissions", "budget", "concurrency", "lane", "tracePolicy"]; ["multi_agent_v2_role_manifest_not_enforced"]),
    adapter("agent_jobs_batch_workers"; "batch_worker_role"; ["roleId", "capabilities", "outputSchemaRef", "verifierRef", "budget", "tracePolicy"]; ["agent_jobs_role_manifest_not_enforced"]),
    adapter("hepta_runtime_worker_tasks"; "runtime_worker_role"; ["roleId", "toolPermissions", "outputSchemaRef", "verifierRef", "budget", "concurrency", "lane"]; ["worker_task_role_manifest_not_enforced"]),
    adapter("hepta_runtime_agent_harness"; "external_handoff_role"; ["roleId", "capabilities", "approvalPolicy", "verifierRef", "budget", "tracePolicy"]; ["agent_harness_role_manifest_not_enforced"])
  ] as $adapter_previews
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_role_manifest_contract_preview_gate",
      schema_version: "work_graph_role_manifest_contract_preview_v1",
      preview_mode: "read_only_role_manifest_contract_preview_no_enforcement",
      required_field_count: ($required_fields | length),
      capability_count: ($capabilities | length),
      permission_mode_count: ($permission_modes | length),
      invariant_count: ($invariants | length),
      adapter_preview_count: ($adapter_previews | length),
      required_fields: $required_fields,
      capabilities: $capabilities,
      permission_modes: $permission_modes,
      invariants: $invariants,
      adapter_previews: $adapter_previews,
      recommended_next_gate: "hepta_work_graph_unified_state_store_preview_gate",
      ready_for_unified_state_store_preview: true,
      ready_for_role_enforcement: false,
      ready_for_live_execution: false,
      source_probes: {
        role_manifest_contract: {
          rust_module_present: $role_manifest_rust_module_present,
          report_script_present: $role_manifest_report_script_present,
          gate_script_present: $role_manifest_gate_script_present
        },
        observability_timeline: {
          rust_module_present: $observability_timeline_rust_module_present,
          report_script_present: $observability_timeline_report_script_present,
          gate_script_present: $observability_timeline_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        runtime_mutation_performed: false,
        scheduler_cutover_performed: false,
        role_enforcement_enabled: false,
        tool_permission_changed: false,
        agent_spawn_performed: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
