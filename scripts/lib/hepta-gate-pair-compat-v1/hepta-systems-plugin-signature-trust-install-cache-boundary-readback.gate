#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-signature-trust-install-cache-boundary-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_SIGNATURE_TRUST_INSTALL_CACHE_BOUNDARY_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-plugin-signature-trust-install-cache-boundary-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable signature/trust/install-cache boundary report: $REPORT"
[[ -f "$DOC" ]] || fail "missing signature/trust/install-cache architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the signature/trust/install-cache boundary report"
fi

rg -q 'Hepta Systems Plugin Signature Trust Install Cache Boundary Readback' "$DOC" \
  || fail "architecture note must document the signature/trust/install-cache boundary readback"
rg -q 'signature artifact, trust root, install cache, operator evidence, and operator acceptance boundaries' "$DOC" \
  || fail "architecture note must document signature artifact, trust root, install cache, operator evidence, and operator acceptance boundaries"
rg -q 'no plugin install, cache mutation, install-cache materialization, manifest rewrite, manifest schema write, dynamic activation, permission grant, signature verification, signature acceptance, trust-root acceptance, operator evidence recording, operator acceptance recording, MCP server start, app connector start, ToolRegistry registration, tool invocation, ledger write, approval request, receipt persistence, runtime event-log write, SQLite write, credential read, external network, Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, channel send, package/release, canary activation, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed side-effect boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "hepta_systems_plugin_signature_trust_install_cache_boundary_readback"
  and .status == "ready_blocked"
  and .gate == "hepta_systems_plugin_signature_trust_install_cache_boundary_readback_gate"
  and .schema_version == "hepta_systems_plugin_signature_trust_install_cache_boundary_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .manifest_name == "hepta-system"
  and .manifest_version == "0.0.0-fixture"
  and .source_canonical_manifest_contract_ready == true
  and .source_signature_boundary_checked_count == 2
  and .source_trust_boundary_checked_count == 2
  and .source_install_blocked_count == 2
  and .lib_export_present == true
  and .candidate_count == 2
  and .signature_boundary_ready_count == 2
  and .trust_boundary_ready_count == 2
  and .install_cache_boundary_ready_count == 2
  and .operator_evidence_required_count == 2
  and .operator_acceptance_required_count == 2
  and .explicit_non_acceptance_receipt_projected_count == 2
  and .signature_artifact_present_count == 0
  and .signature_verified_count == 0
  and .trust_root_present_count == 0
  and .trust_root_accepted_count == 0
  and .install_cache_materialized_count == 0
  and .install_cache_mutated_count == 0
  and .evidence_recorded_count == 0
  and .acceptance_recorded_count == 0
  and .plugin_install_allowed_count == 0
  and .dynamic_activation_allowed_count == 0
  and .signature_trust_install_cache_boundary_readback_ready == true
  and .signature_acceptance_allowed == false
  and .trust_root_acceptance_allowed == false
  and .operator_evidence_recording_allowed == false
  and .operator_acceptance_recording_allowed == false
  and .plugin_install_allowed == false
  and .plugin_cache_mutation_allowed == false
  and .install_cache_materialization_allowed == false
  and .dynamic_activation_allowed == false
  and .permission_grant_allowed == false
  and .mcp_server_start_allowed == false
  and .app_connector_start_allowed == false
  and .tool_registry_registration_allowed == false
  and .tool_invocation_allowed == false
  and .ledger_write_allowed == false
  and .approval_request_allowed == false
  and .receipt_persistence_allowed == false
  and .runtime_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .live_execution_allowed == false
  and (.entries | length) == 2
  and any(.entries[]; .candidate_tool_id == "preview:mcp:hepta-system@hepta-local:hepta_system_local_mcp" and .contribution_kind == "mcp_server" and .boundary_route == "plugin-boundary://hepta-system/mcp/signature-trust-install-cache")
  and any(.entries[]; .candidate_tool_id == "preview:connector:hepta-system@hepta-local:hepta_system_local_app" and .contribution_kind == "app_connector" and .boundary_route == "plugin-boundary://hepta-system/app/signature-trust-install-cache")
  and (.entries | all(.signature_boundary_ready == true and .signature_artifact_present == false and .signature_digest_projected == true and .signature_verified == false and .signature_required_before_install == true and .signature_acceptance_allowed == false and .trust_boundary_ready == true and .trust_root_present == false and .trust_root_digest_projected == true and .trust_root_accepted == false and .trust_required_before_install == true and .trust_root_acceptance_allowed == false and .install_cache_boundary_ready == true and .install_cache_route_projected == true and .install_cache_materialized == false and .install_cache_mutated == false and .install_cache_materialization_allowed == false and .operator_evidence_required == true and .operator_evidence_recorded == false and .operator_evidence_recording_allowed == false and .operator_acceptance_required == true and .operator_acceptance_recorded == false and .operator_acceptance_recording_allowed == false and .explicit_non_acceptance_receipt_projected == true and .plugin_install_allowed == false and .dynamic_activation_allowed == false and .permission_granted == false and .mcp_server_started == false and .app_connector_started == false and .tool_registered == false and .tool_invoked == false and .ledger_written == false and .approval_requested == false and .receipt_persisted == false and .runtime_event_log_written == false and .sqlite_written == false and .live_execution_started == false))
  and (.blockers | index("signature_artifact_missing")) != null
  and (.blockers | index("trust_root_missing")) != null
  and (.blockers | index("operator_evidence_missing")) != null
  and (.blockers | index("operator_acceptance_missing")) != null
  and (.blockers | index("plugin_install_disabled")) != null
  and (.blockers | index("plugin_cache_mutation_disabled")) != null
  and (.blockers | index("install_cache_materialization_disabled")) != null
  and (.blockers | index("dynamic_activation_disabled")) != null
  and (.blockers | index("permission_grant_disabled")) != null
  and (.blockers | index("mcp_server_start_disabled")) != null
  and (.blockers | index("app_connector_start_disabled")) != null
  and (.blockers | index("tool_registry_registration_disabled")) != null
  and (.blockers | index("tool_invocation_disabled")) != null
  and (.blockers | index("ledger_write_disabled")) != null
  and (.blockers | index("approval_request_disabled")) != null
  and (.blockers | index("receipt_persistence_disabled")) != null
  and (.blockers | index("runtime_event_log_write_disabled")) != null
  and (.blockers | index("sqlite_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.next_actions | index("hepta_systems_plugin_operator_evidence_acceptance_packet_readback")) != null
  and .recommended_next_gate == "hepta_systems_plugin_operator_evidence_acceptance_packet_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime hepta_systems_plugin_signature_trust_install_cache_boundary_readback --lib
)

printf 'hepta-systems-plugin-signature-trust-install-cache-boundary-readback-gate: PASS: signature/trust/install-cache boundaries are read back without install, cache mutation, acceptance, or live activation\n'
