#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workgraph-legacy-gate-recursion-inventory-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_WORKGRAPH_LEGACY_GATE_RECURSION_INVENTORY_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-workgraph-legacy-gate-recursion-inventory-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable WorkGraph legacy recursion inventory report: $REPORT"
[[ -f "$DOC" ]] || fail "missing WorkGraph legacy recursion inventory architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the WorkGraph legacy recursion inventory report"
fi

rg -q 'Hepta Systems WorkGraph Legacy Gate Recursion Inventory Readback' "$DOC" \
  || fail "architecture note must document Hepta Systems WorkGraph Legacy Gate Recursion Inventory Readback"
rg -q 'source-report smoke plus targeted Rust test' "$DOC" \
  || fail "architecture note must document the source-report smoke plus targeted Rust test migration contract"
rg -q 'no runtime writes, event-log writes, SQLite writes, workflow execution, replay execution, source report semantic changes, matrix cache writes, compact cache persistence, provider/model invocation, Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, channel send, package/release, canary activation, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed side-effect boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "hepta_systems_workgraph_legacy_gate_recursion_inventory_readback"
  and .status == "ready_blocked"
  and .gate == "hepta_systems_workgraph_legacy_gate_recursion_inventory_readback_gate"
  and .schema_version == "hepta_systems_workgraph_legacy_gate_recursion_inventory_readback_v1"
  and .source_lean_contract_ready == true
  and .source_legacy_inventory_target_count == 2
  and .lib_export_present == true
  and .inventory_scope == "legacy_workgraph_rerun_preview_gate_chains_with_required_prior_gate_count"
  and .inventory_entry_count == 8
  and .route_present_count == 8
  and .route_executable_count == 8
  and .legacy_full_upstream_gate_chain_count == 8
  and .full_upstream_gate_chain_allowed_count == 0
  and .source_report_smoke_migration_target_count == 8
  and .targeted_rust_test_contract_target_count == 8
  and .terminal_no_cutover_receipt_chain_count == 1
  and .replay_idempotency_chain_count == 1
  and .closeout_chain_count == 2
  and .runtime_write_boundary_chain_count == 3
  and .operator_review_packet_chain_count == 1
  and .required_prior_gate_count_total == 663
  and .required_prior_gate_count_max == 116
  and .source_report_semantics_change_allowed == false
  and .matrix_cache_write_allowed == false
  and .compact_cache_persistence_allowed == false
  and .workflow_execution_allowed == false
  and .replay_execution_allowed == false
  and .event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .live_execution_allowed == false
  and .workgraph_legacy_gate_recursion_inventory_ready == true
  and (.entries | length) == 8
  and (.entries | all(.projected_in_memory == true and .route_present == true and .route_executable == true and .legacy_full_upstream_gate_chain_present == true and .migrate_to_source_report_smoke == true and .targeted_rust_test_contract_required == true and .full_upstream_gate_chain_allowed == false and .source_report_semantics_changed == false and .matrix_cache_written == false and .compact_cache_persisted == false and .workflow_execution_started == false and .replay_executed == false and .event_log_written == false and .sqlite_written == false and .live_execution_started == false))
  and any(.entries[]; .entry_id == "terminal_no_cutover_receipt_acknowledgement_rerun_preview" and .required_prior_gate_count == 96)
  and any(.entries[]; .entry_id == "terminal_no_cutover_receipt_acknowledgement_replay_idempotency_rerun_preview" and .required_prior_gate_count == 100)
  and any(.entries[]; .entry_id == "terminal_no_cutover_receipt_acknowledgement_replay_idempotency_closeout_rerun_preview" and .required_prior_gate_count == 104)
  and any(.entries[]; .entry_id == "terminal_no_cutover_receipt_acknowledgement_replay_idempotency_closeout_receipt_acknowledgement_replay_idempotency_rerun_preview" and .required_prior_gate_count == 116)
  and any(.entries[]; .entry_id == "event_store_cutover_runtime_adapter_enforcement_closure_rerun_preview" and .required_prior_gate_count == 64)
  and any(.entries[]; .entry_id == "event_store_cutover_replay_readback_execution_closure_rerun_preview" and .required_prior_gate_count == 68)
  and any(.entries[]; .entry_id == "runtime_wal_write_boundary_execution_rerun_preview" and .required_prior_gate_count == 71)
  and any(.entries[]; .entry_id == "event_store_cutover_operator_review_packet_rerun_preview" and .required_prior_gate_count == 44)
  and (.blockers | index("legacy_workgraph_full_upstream_gate_chain_inventory_required")) != null
  and (.blockers | index("source_report_smoke_migration_required")) != null
  and (.blockers | index("targeted_rust_test_contract_required")) != null
  and (.blockers | index("source_report_semantics_change_disabled")) != null
  and (.blockers | index("matrix_cache_write_disabled")) != null
  and (.blockers | index("compact_cache_persistence_disabled")) != null
  and (.blockers | index("workflow_execution_disabled")) != null
  and (.blockers | index("replay_execution_disabled")) != null
  and (.blockers | index("event_log_write_disabled")) != null
  and (.blockers | index("sqlite_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.next_actions | index("hepta_systems_tool_registry_minimal_read_only_invocation_ledger_receipt_readback")) != null
  and .recommended_next_gate == "hepta_systems_tool_registry_minimal_read_only_invocation_ledger_receipt_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime hepta_systems_workgraph_legacy_gate_recursion_inventory_readback --lib
)

printf 'hepta-systems-workgraph-legacy-gate-recursion-inventory-readback-gate: PASS: legacy WorkGraph recursive gate chains are inventoried and next tool invocation closure remains read-only\n'
