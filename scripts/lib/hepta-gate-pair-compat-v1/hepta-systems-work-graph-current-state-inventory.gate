#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-current-state-inventory.report"

report="$(capture_json_report "hepta-work-graph-current-state-inventory-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .system_status == "attention"
  and .gate == "hepta_work_graph_current_state_inventory_gate"
  and .schema_version == "work_graph_current_state_inventory_v1"
  and .inventory_mode == "read_only_current_head_contract_inventory"
  and .source_surface_count == 12
  and (.source_surfaces | length) == .source_surface_count
  and (.source_surfaces | all(.present_in_current_head == true))
  and (.source_surfaces | map(.id) == [
    "update_plan_tool",
    "plan_mode_proposed_plan",
    "app_server_turn_plan_notification",
    "multi_agent_v2_thread_spawn",
    "multi_agent_v2_mailbox_wait",
    "codex_agent_graph_store",
    "agent_jobs_batch_workers",
    "hepta_runtime_task_board",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_agent_harness",
    "hepta_runtime_multi_agent_reducer"
  ])
  and (.source_surfaces[] | select(.id == "codex_agent_graph_store") | .partial_graph_edge_store_present == true)
  and (.source_surfaces[] | select(.id == "multi_agent_v2_thread_spawn") | .partial_graph_edge_store_present == true)
  and (.source_surfaces[] | select(.id == "agent_jobs_batch_workers") | .task_result_adapter_present == false)
  and .active_p0_gap_count == 5
  and (.active_p0_gaps | length) == .active_p0_gap_count
  and (.active_p0_gaps | map(.id) == [
    "unified_work_graph_state_store_not_enforced",
    "task_result_contract_not_enforced",
    "scheduler_admission_controller_not_enforced",
    "work_graph_observability_timeline_not_enforced",
    "role_manifest_contract_not_enforced"
  ])
  and .recommended_next_gate == "hepta_work_graph_contract_preview_gate"
  and .ready_for_work_graph_contract_preview == true
  and .ready_for_scheduler_cutover == false
  and .source_probes.current_inventory_contract.rust_module_present == true
  and .source_probes.current_inventory_contract.report_script_present == true
  and .source_probes.current_inventory_contract.gate_script_present == true
  and .source_probes.future_work_graph_contracts.unified_state_store_present == true
  and .source_probes.future_work_graph_contracts.task_result_contract_present == true
  and .source_probes.future_work_graph_contracts.scheduler_admission_controller_present == true
  and .source_probes.future_work_graph_contracts.observability_timeline_present == true
  and .source_probes.future_work_graph_contracts.role_manifest_contract_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_current_state_inventory --lib

echo "Hepta WorkGraph current-state inventory gate passed"
