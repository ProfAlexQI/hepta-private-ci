#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-readback-final-index.report"
TARGET_AVAILABILITY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-readback-final-index-artifact-signing-terminal-public-claim-delivery-receipt-target-availability.report"
DELIVERY_RECEIPT_NON_PERSISTENCE_GATE="$ROOT/scripts/hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-non-persistence-denial-gate.sh"
DELIVERY_RECEIPT_NON_PERSISTENCE_DOC="$ROOT/docs/architecture/HEPTA_MEMORY_INTELLIGENCE_KG_FULL_LIVE_ACTIVATION_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_NON_PERSISTENCE_DENIAL_GATE.md"

[[ -x "$SOURCE_REPORT" ]] || {
  echo "missing executable artifact signing terminal public claim delivery/readback final index report: $SOURCE_REPORT" >&2
  exit 1
}
[[ -x "$TARGET_AVAILABILITY_REPORT" ]] || {
  echo "missing executable artifact signing terminal public claim delivery receipt target availability report: $TARGET_AVAILABILITY_REPORT" >&2
  exit 1
}
[[ -x "$DELIVERY_RECEIPT_NON_PERSISTENCE_GATE" ]] || {
  echo "missing executable artifact signing terminal public claim delivery receipt non-persistence denial gate: $DELIVERY_RECEIPT_NON_PERSISTENCE_GATE" >&2
  exit 1
}
[[ -f "$DELIVERY_RECEIPT_NON_PERSISTENCE_DOC" ]] || {
  echo "missing artifact signing terminal public claim delivery receipt non-persistence denial doc: $DELIVERY_RECEIPT_NON_PERSISTENCE_DOC" >&2
  exit 1
}

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to build the artifact signing terminal public claim delivery receipt non-persistence attachment report" >&2
  exit 1
fi

source_json="$("$SOURCE_REPORT")"
availability_json="$("$TARGET_AVAILABILITY_REPORT")"

jq -e '
  .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_blocked == true
  and .public_claim_delivery_recorded == false
  and .status_readback_recorded == false
  and .delivery_receipt_recorded == false
  and .operator_approval_from_delivery_readback_derived == false
' <<<"$source_json" >/dev/null

jq -e '
  .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_ready == true
  and .target_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate_present == true
  and .target_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_doc_present == true
  and .target_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate_invoked == false
  and .artifact_signing_terminal_public_claim_delivery_receipt_attachment_allowed == true
' <<<"$availability_json" >/dev/null

delivery_receipt_non_persistence_static_mention_count="$(
  grep -Ec 'delivery|receipt|persist|material|ledger|index|query|export|observability|status|acknowledgement|authority|install|restart|active-binary|memory|provider|credential|telegram|external' "$DELIVERY_RECEIPT_NON_PERSISTENCE_GATE" || true
)"

jq -n \
  --argjson source "$source_json" \
  --argjson availability "$availability_json" \
  --argjson delivery_receipt_non_persistence_static_mention_count "$delivery_receipt_non_persistence_static_mention_count" \
  '{
    runtime: "hepta",
    surface: "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_attachment",
    plugin_id: "hepta-system@hepta-local",
    status: "ready_blocked",
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_surface: $source.surface,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_ready: $source.public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_ready,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_blocked: $source.public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_blocked,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_surface: $availability.surface,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_ready: $availability.public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_ready,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_attached: true,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_attached: true,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_attachment_ready: true,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_attachment_blocked: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate_present: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_doc_present: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_static_mention_count: $delivery_receipt_non_persistence_static_mention_count,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate_invoked: false,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_denial_gate_invoked: false,
    target_availability_gate_invoked_target_denial_gate: false,
    long_soak_started: false,
    public_claim_delivery_recorded: false,
    public_claim_delivery_persisted: false,
    status_readback_recorded: false,
    status_readback_persisted: false,
    channel_delivery_recorded: false,
    channel_delivery_persisted: false,
    external_delivery_readback_sent: false,
    telegram_delivery_readback_sent: false,
    delivery_receipt_recorded: false,
    delivery_receipt_persisted: false,
    delivery_receipt_materialized: false,
    delivery_receipt_filesystem_written: false,
    delivery_receipt_ledger_written: false,
    delivery_receipt_index_written: false,
    delivery_receipt_query_registered: false,
    delivery_receipt_exported: false,
    delivery_receipt_observability_recorded: false,
    delivery_receipt_status_exposed: false,
    delivery_receipt_acknowledgement_accepted: false,
    readback_receipt_recorded: false,
    readback_receipt_persisted: false,
    readback_receipt_backfilled: false,
    operator_approval_from_delivery_receipt_derived: false,
    release_publication_authority_from_delivery_receipt_derived: false,
    activation_authority_from_delivery_receipt_derived: false,
    download_link_from_delivery_receipt_rendered: false,
    install_command_from_delivery_receipt_emitted: false,
    install_from_delivery_receipt_executed: false,
    service_restart_from_delivery_receipt_performed: false,
    active_binary_from_delivery_receipt_mutated: false,
    memory_store_write_performed: false,
    live_kg_write_performed: false,
    telegram_send_performed: false,
    external_send_performed: false,
    public_ga_readiness_script_invoked: false,
    terminal_live_gates_invoked: false,
    attachment_blocker_count: 92,
    manual_operator_live_cutover_approval_required: true,
    terminal_live_url_required: false,
    long_soak_required: false,
    public_ga_claim_allowed: false,
    public_ga_claimed: false,
    public_release_published: false,
    rollback_execution_allowed: false,
    next_migration_step: "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_readback_without_receipt",
    local_gate: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-readback-final-index-artifact-signing-terminal-public-claim-delivery-receipt-non-persistence.gate",
    architecture_note: "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_READBACK_FINAL_INDEX_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_NON_PERSISTENCE_2026-06-21.md",
    source_files: {
      public_ga_operator_identity_session_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_readback_final_index_report: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-readback-final-index.report",
      public_ga_operator_identity_session_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_target_availability_report: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-readback-final-index-artifact-signing-terminal-public-claim-delivery-receipt-target-availability.report",
      operator_identity_session_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate: "scripts/hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-non-persistence-denial-gate.sh",
      operator_identity_session_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_doc: "docs/architecture/HEPTA_MEMORY_INTELLIGENCE_KG_FULL_LIVE_ACTIVATION_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_NON_PERSISTENCE_DENIAL_GATE.md"
    },
    side_effect_free: true,
    side_effects: ($source.side_effects + $availability.side_effects + {
      operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_non_persistence_denial_gate_invoked: false,
      delivery_receipt_recorded: false,
      delivery_receipt_persisted: false,
      delivery_receipt_materialized: false,
      delivery_receipt_filesystem_written: false,
      delivery_receipt_ledger_written: false,
      delivery_receipt_index_written: false,
      delivery_receipt_query_registered: false,
      delivery_receipt_exported: false,
      delivery_receipt_observability_recorded: false,
      delivery_receipt_status_exposed: false,
      delivery_receipt_acknowledgement_accepted: false,
      readback_receipt_backfilled: false,
      operator_approval_from_delivery_receipt_derived: false,
      release_publication_authority_from_delivery_receipt_derived: false,
      activation_authority_from_delivery_receipt_derived: false,
      install_from_delivery_receipt_executed: false,
      service_restart_from_delivery_receipt_performed: false,
      active_binary_from_delivery_receipt_mutated: false
    })
  }'
