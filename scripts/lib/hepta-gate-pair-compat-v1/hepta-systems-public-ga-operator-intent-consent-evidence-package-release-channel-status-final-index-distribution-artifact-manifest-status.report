    terminal_live_gates_invoked: false,
    attachment_blocker_count: 64,
    manual_operator_live_cutover_approval_required: true,
    public_ga_claim_allowed: false,
    public_release_published: false,
    rollback_execution_allowed: false,
    next_migration_step: "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_distribution_artifact_manifest_status_readback_without_package_channel",
    local_gate: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-package-release-channel-status-final-index-distribution-artifact-manifest-status.gate",
    architecture_note: "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_INTENT_CONSENT_EVIDENCE_PACKAGE_RELEASE_CHANNEL_STATUS_FINAL_INDEX_DISTRIBUTION_ARTIFACT_MANIFEST_STATUS_2026-06-21.md",
    source_files: {
