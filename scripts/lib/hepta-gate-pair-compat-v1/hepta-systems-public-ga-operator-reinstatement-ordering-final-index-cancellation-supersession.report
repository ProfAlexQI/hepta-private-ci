    local_gate: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-reinstatement-ordering-final-index-cancellation-supersession.gate",
    architecture_note: "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_REINSTATEMENT_ORDERING_FINAL_INDEX_CANCELLATION_SUPERSESSION_2026-06-21.md",
    source_files: {
      public_ga_operator_identity_session_reinstatement_ordering_final_index_report: "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-reinstatement-ordering-final-index.report",
      operator_identity_session_reinstatement_cancellation_supersession_denial_gate: "scripts/hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-identity-session-revocation-logout-replay-reinstatement-cancellation-supersession-denial-gate.sh",
      operator_identity_session_reinstatement_cancellation_supersession_denial_doc: "docs/architecture/HEPTA_MEMORY_INTELLIGENCE_KG_FULL_LIVE_ACTIVATION_ARTIFACT_DOWNLOAD_INSTALL_AFFORDANCE_RESULT_RECEIPT_OPERATOR_IDENTITY_SESSION_REVOCATION_LOGOUT_REPLAY_REINSTATEMENT_CANCELLATION_SUPERSESSION_DENIAL_GATE.md"
