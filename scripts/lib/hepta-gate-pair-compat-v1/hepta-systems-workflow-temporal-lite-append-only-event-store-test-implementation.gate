#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-temporal-lite-append-only-event-store-test-implementation.report"
FIXTURE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-workflow-durable-store-test-only-append-fixture.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_WORKFLOW_TEMPORAL_LITE_APPEND_ONLY_EVENT_STORE_TEST_IMPLEMENTATION_2026-06-29.md"

fail() {
  printf 'hepta-systems-workflow-temporal-lite-append-only-event-store-test-implementation-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Temporal-lite append-only event store report: $REPORT"
[[ -x "$FIXTURE_GATE" ]] || fail "missing executable workflow durable store test-only append fixture gate: $FIXTURE_GATE"
[[ -f "$DOC" ]] || fail "missing Temporal-lite append-only event store architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Temporal-lite append-only event store report"
fi

grep -q 'Temporal-Lite Append-Only Event Store Test Implementation' "$DOC" \
  || fail "architecture note must document Temporal-Lite Append-Only Event Store Test Implementation"
grep -q 'test-only in-memory append-only store' "$DOC" \
  || fail "architecture note must document the test-only in-memory append-only store"
grep -q 'no runtime event-log write, SQLite write, store persistence, lease acquisition, idempotency index persistence, checkpoint write, workflow execution, replay execution, rollback execution, provider invocation, model invocation, Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, channel send, package, release, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed runtime write/live boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "workflow_temporal_lite_append_only_event_store_test_implementation"
  and .status == "ready_blocked"
  and .gate == "workflow_temporal_lite_append_only_event_store_test_implementation_gate"
  and .schema_version == "workflow_temporal_lite_append_only_event_store_test_implementation_v1"
  and .source_fixture_ready == true
  and .source_fixture_entry_count == 9
  and .lib_export_present == true
  and .test_store_scope == "test_only_in_memory_append_only_store_no_runtime_persistence"
  and .event_contract_count == 9
  and .test_event_count == 9
  and .append_attempt_count == 18
  and .accepted_append_count == 9
  and .duplicate_append_denial_count == 9
  and .append_only_sequence_count == 9
  and .idempotency_index_entry_count == 9
  and .checkpoint_anchor_count == 9
  and .replay_digest_count == 9
  and .rollback_anchor_count == 9
  and .feature_gate_required == true
  and .runtime_feature_gate_enabled == false
  and .in_memory_store_materialized == true
  and .runtime_event_log_write_allowed == false
  and .runtime_sqlite_write_allowed == false
  and .store_persistence_allowed == false
  and .workflow_execution_allowed == false
  and .replay_execution_allowed == false
  and .rollback_execution_allowed == false
  and .live_execution_allowed == false
  and .append_only_event_store_test_ready == true
  and (.entries | length) == 9
  and (.entries | all(.sequence >= 1 and .sequence <= 9 and (.event_id | startswith("temporal-lite.test-event.")) and (.aggregate_id | startswith("workflow://hepta/test-only/")) and (.idempotency_key | startswith("test-only.idempotency.")) and (.checkpoint_key | startswith("test-only.checkpoint.")) and (.replay_digest | startswith("replay-digest.v1.")) and .append_state == "accepted_in_memory" and .duplicate_append_state == "duplicate_denied" and .appended_to_in_memory_store == true and .append_only_order_validated == true and .idempotency_index_validated == true and .duplicate_append_denied == true and .checkpoint_anchor_projected == true and .replay_digest_projected == true and .rollback_anchor_projected == true and .feature_gate_required == true and .runtime_feature_gate_enabled == false and .runtime_event_log_write_allowed == false and .runtime_sqlite_write_allowed == false and .store_persistence_allowed == false and .workflow_execution_allowed == false and .replay_execution_allowed == false and .rollback_execution_allowed == false and .live_execution_allowed == false))
  and any(.entries[]; .event_contract_id == "plan_step_event_intake" and .sequence == 1)
  and any(.entries[]; .event_contract_id == "worker_task_event_intake" and .rollback_anchor == "rollback_to_prior_worker_task_attempt_anchor")
  and any(.entries[]; .event_contract_id == "approval_event_intake" and (.checkpoint_key | contains("checkpoint_metadata_only_no_checkpoint_write")))
  and (.blockers | index("runtime_feature_gate_closed")) != null
  and (.blockers | index("runtime_event_log_write_disabled")) != null
  and (.blockers | index("runtime_sqlite_write_disabled")) != null
  and (.blockers | index("store_persistence_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.next_actions | index("temporal_lite_deterministic_replay_validator_feature_gated_readback")) != null
  and .recommended_next_gate == "temporal_lite_deterministic_replay_validator_feature_gated_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$FIXTURE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime workflow_temporal_lite_append_only_event_store_test_implementation --lib
)

printf 'hepta-systems-workflow-temporal-lite-append-only-event-store-test-implementation-gate: PASS: Temporal-lite append-only event store test implementation is in-memory, idempotent, replay-ready, and runtime-write/live blocked\n'
