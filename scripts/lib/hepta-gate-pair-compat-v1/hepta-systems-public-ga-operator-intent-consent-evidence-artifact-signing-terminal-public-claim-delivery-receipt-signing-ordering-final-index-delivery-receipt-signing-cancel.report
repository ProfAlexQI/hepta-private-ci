    artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_cancellation_supersession_denial_doc_present: true,
    artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_cancellation_supersession_static_mention_count: $signing_cancel_static_mention_count,
