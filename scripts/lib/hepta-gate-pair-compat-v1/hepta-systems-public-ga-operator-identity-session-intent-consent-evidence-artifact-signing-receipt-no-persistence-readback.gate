  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_readback"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_attachment_surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_attachment"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_attachment_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_attachment_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_readback_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_readback_blocked == true
  and .readback_mode == "static_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_snapshot_only"
  and .readback_check_count == 68
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_denial_gate_present == true
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_denial_doc_present == true
  and .operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_denial_gate_invoked == false
  and .long_soak_started == false
  and .artifact_distribution_signing_notarization_result_receipt_surface_recorded == false
  and .artifact_distribution_signing_notarization_result_receipt_surface_persisted == false
  and .artifact_distribution_signing_notarization_result_receipt_surface_materialized == false
  and .artifact_distribution_signing_notarization_result_receipt_surface_filesystem_written == false
  and .artifact_distribution_signing_notarization_result_receipt_surface_status_exposed == false
  and .artifact_signing_receipt_accepted == false
  and .package_signing_receipt_accepted == false
  and .signature_manifest_receipt_recorded == false
  and .notarization_submission_receipt_persisted == false
  and .notarization_ticket_receipt_materialized == false
  and .stapling_receipt_filesystem_written == false
  and .installer_signing_receipt_delivered == false
  and .provenance_attestation_receipt_indexed == false
  and .sbom_manifest_receipt_exported == false
  and .release_asset_bundle_receipt_query_registered == false
  and .cdn_update_feed_receipt_observability_recorded == false
  and .package_registry_receipt_status_exposed == false
  and .dashboard_endpoint_receipt_status_exposed == false
  and .external_signing_receipt_delivered == false
  and .telegram_signing_receipt_delivered == false
  and .operator_approval_from_signing_receipt_derived == false
  and .release_publication_authority_from_signing_receipt_derived == false
  and .activation_authority_from_signing_receipt_derived == false
  and .install_from_signing_receipt_executed == false
  and .service_restart_from_signing_receipt_performed == false
  and .active_binary_from_signing_receipt_mutated == false
  and .provider_invoked == false
  and .model_invoked == false
  and .credential_read == false
  and .secret_file_read == false
  and .readback_blocker_count == 68
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "derive_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_final_index_without_signing"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$ATTACHMENT_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-receipt-no-persistence-readback-gate: PASS: Public GA operator identity/session intent consent evidence artifact signing receipt no-persistence readback is ready but blocked\n'
