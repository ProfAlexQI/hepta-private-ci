#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-inventory.report"
CANARY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-canary-readiness-plan.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_INVENTORY_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-inventory-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 11 report: $REPORT"
[[ -x "$CANARY_REPORT" ]] || fail "missing executable Phase 10 controlled canary report: $CANARY_REPORT"
[[ -f "$DOC" ]] || fail "missing Phase 11 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 11 dirty-worktree release-boundary inventory report"
fi

grep -q 'Dirty Worktree Release Boundary Inventory' "$DOC" \
  || fail "architecture note must document Dirty Worktree Release Boundary Inventory"
grep -q 'read_only_inventory_no_git_mutation' "$DOC" \
  || fail "architecture note must document read_only_inventory_no_git_mutation"
grep -q 'no git add, commit, push, reset, checkout, revert, cleanup, delete, evidence recording, evidence persistence, package, release, Public GA, canary activation, live activation, or live execution' "$DOC" \
  || fail "architecture note must document the closed git/release boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "dirty_worktree_release_boundary_inventory"
  and .status == "ready_blocked"
  and .gate == "dirty_worktree_release_boundary_inventory_gate"
  and .schema_version == "dirty_worktree_release_boundary_inventory_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_canary_ready == true
  and .source_canary_activation_ready == false
  and .lib_export_present == true
  and .inventory_scope.inventory_id == "dirty-worktree.release-boundary.inventory.v1"
  and .inventory_scope.collection_mode == "read_only_inventory_no_git_mutation"
  and .inventory_scope.mutation_boundary == "closed"
  and .inventory_scope.release_boundary_state == "blocked_dirty_worktree"
  and .inventory_entry_count > 0
  and .inventory_entry_count == (.tracked_change_count + .untracked_change_count)
  and .inventory_entry_count == (.hepta_systems_owned_count + .cross_lane_or_unowned_count)
  and .tracked_change_count > 0
  and .untracked_change_count > 0
  and .top_level_bucket_count > 0
  and .scope_bucket_count > 0
  and .inventory_sample_limit == 80
  and .inventory_sample_count <= .inventory_sample_limit
  and .inventory_sample_count == (.entries_sample | length)
  and (if .inventory_truncated then .inventory_entry_count > .inventory_sample_limit else .inventory_entry_count <= .inventory_sample_limit end)
  and .inventory_counts.inventory_entry_count == .inventory_entry_count
  and .inventory_counts.tracked_change_count == .tracked_change_count
  and .inventory_counts.untracked_change_count == .untracked_change_count
  and .inventory_counts.hepta_systems_owned_count == .hepta_systems_owned_count
  and .inventory_counts.cross_lane_or_unowned_count == .cross_lane_or_unowned_count
  and .inventory_counts.top_level_bucket_count == .top_level_bucket_count
  and .inventory_counts.sample_entry_count == .inventory_sample_count
  and (.top_level_buckets | map(.count) | add) == .inventory_entry_count
  and (.scope_buckets | map(.count) | add) == .inventory_entry_count
  and (.scope_buckets | any(.scope_bucket == "hepta_systems_owned"))
  and (.scope_buckets | any(.scope_bucket == "cross_lane_or_unowned"))
  and (.entries_sample | all(.operator_visible == true and .queryable == true and .git_mutation_allowed == false and .cleanup_allowed == false and .release_cutover_allowed == false and (.release_boundary_route | startswith("readback://release-boundary/dirty-worktree/path/"))))
  and .dirty_worktree_release_boundary_open == true
  and .dirty_worktree_release_boundary_resolved == false
  and .release_boundary_inventory_ready == true
  and .operator_visible == true
  and .queryable == true
  and .diffable == true
  and .release_cutover_allowed == false
  and .git_add_allowed == false
  and .git_index_mutated == false
  and .git_commit_allowed == false
  and .git_push_allowed == false
  and .git_reset_allowed == false
  and .git_checkout_allowed == false
  and .git_revert_allowed == false
  and .cleanup_allowed == false
  and .delete_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persistence_allowed == false
  and .package_or_release_allowed == false
  and .public_ga_allowed == false
  and .canary_activation_allowed == false
  and .live_activation_allowed == false
  and .live_execution_allowed == false
  and (.blockers | index("dirty_worktree_release_boundary_open")) != null
  and (.blockers | index("git_mutation_blocked")) != null
  and (.blockers | index("cleanup_and_delete_blocked")) != null
  and (.blockers | index("canary_activation_blocked")) != null
  and (.blockers | index("live_activation_blocked")) != null
  and (.next_actions | index("phase12_dirty_worktree_release_boundary_grouping_freeze_plan_without_git_mutation")) != null
  and .next_migration_step == "phase12_dirty_worktree_release_boundary_grouping_freeze_plan_without_git_mutation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$CANARY_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_canary_readiness_plan"
  and .controlled_canary_readiness_plan_ready == true
  and .controlled_canary_activation_ready == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime dirty_worktree_release_boundary_inventory --lib
)

printf 'hepta-systems-dirty-worktree-release-boundary-inventory-gate: PASS: dirty worktree release boundary is inventoried without git mutation, cleanup, release, canary activation, or live execution\n'
