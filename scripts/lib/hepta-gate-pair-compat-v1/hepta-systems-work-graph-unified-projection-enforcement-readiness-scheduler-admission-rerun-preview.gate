#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-scheduler-admission-rerun-preview.report"

report="$(capture_json_report "hepta-work-graph-unified-projection-enforcement-readiness-scheduler-admission-rerun-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "blocked"
  and .gate == "hepta_work_graph_unified_projection_enforcement_readiness_scheduler_admission_rerun_preview_gate"
  and .schema_version == "work_graph_unified_projection_enforcement_readiness_scheduler_admission_rerun_preview_v1"
  and .preview_mode == "read_only_projection_enforcement_readiness_scheduler_admission_rerun_no_enforcement"
  and .source_surface_count == 12
  and .scheduler_admission_application_outcome_count == 5
  and .previous_contract_ready_surface_count == 12
  and .scheduler_admission_rerun_contract_ready_surface_count == 12
  and .previous_scheduler_admission_primary_blocked_surface_count == 5
  and .scheduler_admission_primary_blocked_surface_count_after == 0
  and .scheduler_admission_application_source_count == 5
  and .scheduler_admission_contract_ready_surface_count == 12
  and .scheduler_admission_runtime_residual_source_count == 5
  and .runtime_append_only_residual_source_count == 12
  and .rerun_ready_surface_count == 0
  and .rerun_blocked_surface_count == 12
  and .decision_delta_count == 12
  and (.decision_deltas | length) == .decision_delta_count
  and (.decision_deltas | all(.projection_contract_ready == true and .store_idempotency_guard_ready == true and .terminal_task_result_contract_ready == true and .append_only_store_precondition_ready == true and .scheduler_admission_contract_ready == true))
' >/dev/null <<<"$report"

jq -e '
  (.decision_deltas | map(select(.covered_by_scheduler_admission_application_preview == true)) | length) == 5
  and (.decision_deltas | map(select(.scheduler_admission_primary_gap_closed_by_application_preview == true)) | length) == 5
  and (.decision_deltas | map(select(.scheduler_admission_rerun_enforcement_decision == "deny_scheduler_admission_not_enforced")) | length) == 0
  and (.decision_deltas | map(select(.scheduler_admission_rerun_enforcement_decision == "deny_runtime_append_only_store_enablement_disabled")) | length) == 8
  and (.decision_deltas | map(select(.scheduler_admission_rerun_enforcement_decision == "deny_role_manifest_not_enforced")) | length) == 4
  and (.decision_deltas | map(select(.source_surface_id == "multi_agent_v2_thread_spawn" and .previous_enforcement_decision == "deny_scheduler_admission_not_enforced" and .scheduler_admission_rerun_enforcement_decision == "deny_role_manifest_not_enforced" and .scheduler_admission_rerun_state == "scheduler_admission_contract_ready_preview_after_application")) | length) == 1
  and (.decision_deltas | map(select(.source_surface_id == "hepta_runtime_task_board" and .scheduler_admission_rerun_enforcement_decision == "deny_runtime_append_only_store_enablement_disabled")) | length) == 1
  and (.decision_deltas | all([.residual_source_blocker_ids[]? | endswith("_admission_not_enforced")] | any | not))
  and (.decision_deltas | all(.runtime_append_only_store_enabled == false and .scheduler_admission_enforcement_ready == false and .role_manifest_enforcement_ready == false))
' >/dev/null <<<"$report"

jq -e '
  .cleared_blocker_count == 1
  and (.cleared_blockers[0].id == "scheduler_admission_not_enforced_for_enforcement")
  and (.cleared_blockers[0].source_count_before == 5)
  and (.cleared_blockers[0].source_count_after == 0)
  and (.cleared_blockers[0].closure_gate_id == "hepta_work_graph_scheduler_admission_enforcement_gap_closure_application_preview_gate")
  and (.cleared_blockers[0].cleared_source_surface_ids == [
    "multi_agent_v2_thread_spawn",
    "agent_jobs_batch_workers",
    "hepta_runtime_task_board",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store"
  ])
  and .residual_blocker_count == 17
  and (.residual_blockers | map({id, count: (.affected_source_surface_ids | length)}) == [
    {"id": "projection_adapter_runtime_closure_application_disabled", "count": 7},
    {"id": "store_guard_runtime_application_disabled", "count": 5},
    {"id": "idempotency_index_mutation_disabled", "count": 12},
    {"id": "state_store_guard_persistence_disabled", "count": 5},
    {"id": "terminal_task_result_runtime_application_disabled", "count": 6},
    {"id": "task_result_persistence_disabled", "count": 6},
    {"id": "append_only_store_runtime_enablement_disabled", "count": 12},
    {"id": "wal_write_boundary_not_enabled", "count": 12},
    {"id": "rollback_readback_not_executed", "count": 12},
    {"id": "scheduler_admission_runtime_application_disabled", "count": 5},
    {"id": "lane_lease_acquisition_disabled", "count": 5},
    {"id": "dependency_readback_not_executed", "count": 5},
    {"id": "approval_recording_disabled", "count": 5},
    {"id": "budget_consumption_disabled", "count": 5},
    {"id": "role_manifest_not_enforced", "count": 4},
    {"id": "operator_review_required", "count": 7},
    {"id": "runtime_application_residuals_not_promoted", "count": 7}
  ])
  and (.residual_blockers | all(.required_before_projection_enforcement == true))
' >/dev/null <<<"$report"

jq -e '
  .enforcement_stage_count == 8
  and (.enforcement_stages | map(.id) == [
    "unified_projection_contracts",
    "store_idempotency_guard_contracts",
    "terminal_task_result_contracts",
    "append_only_store_preconditions",
    "append_only_store_runtime_enablement",
    "scheduler_admission_contracts",
    "scheduler_admission_runtime_application",
    "role_manifest_contracts"
  ])
  and (.enforcement_stages | all(.enforcement_enabled == false))
  and (.enforcement_stages | map(select(.id == "scheduler_admission_contracts" and .observed_contract_count == 5 and .ready_contract_count_before == 0 and .ready_contract_count_after == 5)) | length) == 1
  and (.enforcement_stages | map(select(.id == "scheduler_admission_runtime_application" and .observed_contract_count == 5 and .ready_contract_count_before == 0 and .ready_contract_count_after == 0)) | length) == 1
  and (.enforcement_stages | map(select(.id == "append_only_store_runtime_enablement" and .observed_contract_count == 12 and .ready_contract_count_after == 0)) | length) == 1
  and (.enforcement_stages | map(select(.id == "role_manifest_contracts" and .observed_contract_count == 4 and .ready_contract_count_after == 0)) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .required_prior_gate_count == 35
  and (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_scheduler_admission_enforcement_gap_closure_application_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_role_manifest_enforcement_gap_closure_preview_gate"
  and .ready_for_role_manifest_enforcement_gap_closure_preview == true
  and .ready_for_projection_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.scheduler_admission_readiness_rerun.rust_module_present == true
  and .source_probes.scheduler_admission_readiness_rerun.report_script_present == true
  and .source_probes.scheduler_admission_readiness_rerun.gate_script_present == true
  and .source_probes.scheduler_admission_application.rust_module_present == true
  and .source_probes.scheduler_admission_application.gate_script_present == true
  and .source_probes.scheduler_admission_application.upstream_gate == true
  and .source_probes.append_only_store_readiness_rerun.upstream_gate == true
  and .source_probes.append_only_store_readiness_rerun.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_unified_projection_enforcement_readiness_scheduler_admission_rerun --lib

echo "Hepta WorkGraph unified projection enforcement readiness scheduler admission rerun preview gate passed"
