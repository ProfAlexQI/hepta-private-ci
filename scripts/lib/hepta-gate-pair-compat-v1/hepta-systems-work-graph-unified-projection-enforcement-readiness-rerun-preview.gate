#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-unified-projection-enforcement-readiness-rerun-preview.report"

report="$(capture_json_report "hepta-work-graph-unified-projection-enforcement-readiness-rerun-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "blocked"
  and .gate == "hepta_work_graph_unified_projection_enforcement_readiness_rerun_preview_gate"
  and .schema_version == "work_graph_unified_projection_enforcement_readiness_rerun_preview_v1"
  and .preview_mode == "read_only_projection_enforcement_readiness_rerun_no_enforcement"
  and .source_surface_count == 12
  and .application_outcome_count == 7
  and .original_contract_ready_surface_count == 5
  and .rerun_contract_ready_surface_count == 12
  and .rerun_ready_surface_count == 0
  and .rerun_blocked_surface_count == 12
  and .projection_gap_source_count_before == 7
  and .projection_gap_source_count_after == 0
  and .decision_delta_count == 12
  and (.decision_deltas | length) == .decision_delta_count
  and (.decision_deltas | all(.projection_contract_ready == true and .unified_store_projection_ready == true and .timeline_projection_ready == true))
' >/dev/null <<<"$report"

jq -e '
  (.decision_deltas | map(select(.covered_by_application_preview == true)) | length) == 7
  and (.decision_deltas | map(select(.projection_gap_closed_by_application_preview == true)) | length) == 7
  and (.decision_deltas | map(select(.source_surface_id == "hepta_runtime_task_board" and .original_enforcement_decision == "deny_missing_unified_store_projection" and .rerun_enforcement_decision == "deny_missing_store_idempotency_guard" and .rerun_coverage_state == "contract_ready_preview_after_application")) | length) == 1
  and (.decision_deltas | map(select(.source_surface_id == "plan_mode_proposed_plan_blocks" and .rerun_enforcement_decision == "deny_missing_store_idempotency_guard")) | length) == 1
  and (.decision_deltas | map(select(.source_surface_id == "hepta_runtime_approval_broker" and .rerun_enforcement_decision == "deny_append_only_store_disabled")) | length) == 1
  and (.decision_deltas | map(select(.rerun_enforcement_decision == "deny_missing_store_idempotency_guard")) | length) == 5
  and (.decision_deltas | map(select(.rerun_enforcement_decision == "deny_terminal_task_result_enforcement_disabled")) | length) == 5
  and (.decision_deltas | map(select(.rerun_enforcement_decision == "deny_append_only_store_disabled")) | length) == 2
  and (.decision_deltas | map(select(.rerun_enforcement_decision | startswith("deny_missing_unified_store_projection") or startswith("deny_missing_timeline_projection") or startswith("deny_missing_task_result_projection"))) | length) == 0
' >/dev/null <<<"$report"

jq -e '
  .cleared_blocker_count == 1
  and (.cleared_blockers[0].id == "projection_adapters_missing_for_enforcement")
  and (.cleared_blockers[0].source_count_before == 7)
  and (.cleared_blockers[0].source_count_after == 0)
  and (.cleared_blockers[0].closure_gate_id == "hepta_work_graph_projection_adapter_gap_closure_application_preview_gate")
  and (.cleared_blockers[0].cleared_source_surface_ids == [
    "update_plan_tool",
    "plan_mode_proposed_plan_blocks",
    "app_server_turn_plan_notification",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "hepta_runtime_task_board",
    "hepta_runtime_approval_broker"
  ])
  and .residual_blocker_count == 6
  and (.residual_blockers | map({id, count: (.affected_source_surface_ids | length)}) == [
    {"id": "runtime_closure_application_disabled", "count": 7},
    {"id": "store_idempotency_guards_missing_for_enforcement", "count": 5},
    {"id": "terminal_task_result_enforcement_disabled", "count": 6},
    {"id": "scheduler_admission_not_enforced", "count": 5},
    {"id": "role_manifest_not_enforced", "count": 4},
    {"id": "append_only_store_enablement_disabled", "count": 12}
  ])
  and (.residual_blockers | all(.required_before_projection_enforcement == true))
' >/dev/null <<<"$report"

jq -e '
  .enforcement_stage_count == 7
  and (.enforcement_stages | map(.id) == [
    "unified_projection_contracts",
    "projection_adapter_gap_closure_application",
    "store_idempotency_guards",
    "terminal_task_result_contracts",
    "scheduler_admission_contracts",
    "role_manifest_contracts",
    "append_only_store_enablement"
  ])
  and (.enforcement_stages | all(.enforcement_enabled == false))
  and (.enforcement_stages | map(select(.id == "unified_projection_contracts" and .ready_contract_count_before == 5 and .ready_contract_count_after == 12)) | length) == 1
  and (.enforcement_stages | map(select(.id == "projection_adapter_gap_closure_application" and .observed_contract_count == 7 and .ready_contract_count_before == 0 and .ready_contract_count_after == 7)) | length) == 1
  and (.enforcement_stages | map(select(.id == "store_idempotency_guards" and .ready_contract_count_before == 7 and .ready_contract_count_after == 7)) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .required_prior_gate_count == 16
  and (.required_prior_gates[-1] == "hepta_work_graph_projection_adapter_gap_closure_application_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_store_idempotency_guard_gap_closure_preview_gate"
  and .ready_for_store_idempotency_guard_gap_closure_preview == true
  and .ready_for_projection_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.readiness_rerun.rust_module_present == true
  and .source_probes.readiness_rerun.report_script_present == true
  and .source_probes.readiness_rerun.gate_script_present == true
  and .source_probes.gap_closure_application.rust_module_present == true
  and .source_probes.gap_closure_application.gate_script_present == true
  and .source_probes.gap_closure_application.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_unified_projection_enforcement_readiness_rerun --lib

echo "Hepta WorkGraph unified projection enforcement readiness rerun preview gate passed"
