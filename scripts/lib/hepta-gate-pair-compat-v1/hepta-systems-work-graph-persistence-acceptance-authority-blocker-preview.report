#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

authority_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_acceptance_authority_blocker_preview.rs
)"
authority_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-acceptance-authority-blocker-preview.report
)"
authority_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-acceptance-authority-blocker-preview.gate
)"
ack_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_operator_readiness_receipt_acknowledgement_preview.rs
)"
ack_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-operator-readiness-receipt-acknowledgement-preview.gate
)"
durable_identity_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_durable_identity_preview.rs
)"
durable_identity_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report
)"
durable_identity_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.gate
)"

durable_identity_report="$(
  capture_json_report \
    "hepta-work-graph-durable-identity-preview-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report"
)"

jq -n \
  --argjson authority_rust_module_present "$authority_rust_module_present" \
  --argjson authority_report_script_present "$authority_report_script_present" \
  --argjson authority_gate_script_present "$authority_gate_script_present" \
  --argjson ack_rust_module_present "$ack_rust_module_present" \
  --argjson ack_gate_script_present "$ack_gate_script_present" \
  --argjson durable_identity_rust_module_present "$durable_identity_rust_module_present" \
  --argjson durable_identity_report_script_present "$durable_identity_report_script_present" \
  --argjson durable_identity_gate_script_present "$durable_identity_gate_script_present" \
  --argjson durable_identity_report "$durable_identity_report" \
  '
  def durable_fields: [
    "workflow_id",
    "run_id",
    "step_id",
    "checkpoint",
    "replay_key",
    "rollback_anchor",
    "receipt_hash"
  ];
  def prior_gates: [
    "hepta_work_graph_contract_preview_gate",
    "hepta_work_graph_task_result_contract_preview_gate",
    "hepta_work_graph_scheduler_admission_controller_preview_gate",
    "hepta_work_graph_observability_timeline_preview_gate",
    "hepta_work_graph_role_manifest_contract_preview_gate",
    "hepta_work_graph_unified_state_store_preview_gate",
    "hepta_work_graph_adapter_projection_fixture_gate",
    "hepta_work_graph_state_store_persistence_preview_gate",
    "hepta_work_graph_replay_readback_preview_gate",
    "hepta_work_graph_promotion_precondition_preview_gate",
    "hepta_work_graph_activation_enforcement_blocker_preview_gate",
    "hepta_work_graph_shadow_adapter_readback_preview_gate",
    "hepta_work_graph_persistence_feature_flag_preview_gate",
    "hepta_work_graph_persistence_canary_dry_run_preview_gate",
    "hepta_work_graph_persistence_canary_readback_receipt_preview_gate",
    "hepta_work_graph_persistence_promotion_blocker_preview_gate",
    "hepta_work_graph_persistence_shadow_live_readback_comparison_preview_gate",
    "hepta_work_graph_persistence_enforcement_rollout_blocker_preview_gate",
    "hepta_work_graph_persistence_operator_readiness_packet_preview_gate",
    "hepta_work_graph_persistence_operator_readiness_receipt_preview_gate",
    "hepta_work_graph_persistence_operator_readiness_receipt_acknowledgement_preview_gate",
    "hepta_work_graph_durable_identity_preview_gate"
  ];
  def surface_ids: [
    "operator_acceptance_authority",
    "approval_recording_authority",
    "live_persistence_authority",
    "wal_checkpoint_authority",
    "enforcement_rollout_authority",
    "release_publication_authority",
    "external_delivery_authority"
  ];
  def surface($id; $capability; $fields): {
    id: $id,
    requested_capability: $capability,
    required_fields: (durable_fields + $fields),
    authority_granted: false,
    approval_recording_enabled: false,
    live_execution_enabled: false,
    external_delivery_enabled: false
  };
  def denial($id; $ids; $reason): {
    id: $id,
    applies_to_surface_ids: $ids,
    reason: $reason,
    blocks_authority: true
  };
  def guard($id; $from; $to; $fields): {
    id: $id,
    from_signal: $from,
    to_blocked_capability: $to,
    required_denial_fields: (durable_fields + $fields),
    blocks_escalation: true
  };
  def record($id; $surface_ids; $fields): {
    id: $id,
    required_for_surface_ids: $surface_ids,
    required_fields: (durable_fields + $fields),
    present_in_preview: false,
    accepted_in_preview: false,
    recording_enabled: false
  };
  def view($id; $audience; $fields): {
    id: $id,
    audience: $audience,
    required_fields: (durable_fields + $fields),
    external_delivery_enabled: false
  };
  def invariant($id; $reason): {
    id: $id,
    required: true,
    reason: $reason
  };
  [
    surface("operator_acceptance_authority"; "record trusted operator acceptance for WorkGraph persistence"; ["trustedOperatorIdHash", "operatorScopeHash", "acceptanceRecordHash", "authorityDenialIds"]),
    surface("approval_recording_authority"; "write approval or readiness acceptance into the WorkGraph ledger"; ["approvalLedgerId", "approvalRecordHash", "readinessReceiptHash", "recordingDenialIds"]),
    surface("live_persistence_authority"; "enable state store persistence for WorkGraph collections"; ["featureFlagId", "enablementPacketHash", "zeroWriteProofHash", "killSwitchId"]),
    surface("wal_checkpoint_authority"; "enable WAL append or checkpoint write execution"; ["walScopeHash", "checkpointScopeHash", "idempotencyGuardHash", "rollbackOwnerHash"]),
    surface("enforcement_rollout_authority"; "turn enforcement rollout or traffic ramp beyond zero"; ["rolloutStageId", "trafficRampId", "operatorEnablementHash", "quarantineOwnerHash"]),
    surface("release_publication_authority"; "publish release status or external artifact availability"; ["releaseOwnerHash", "publicationPolicyHash", "publicClaimDenialIds", "artifactManifestHash"]),
    surface("external_delivery_authority"; "send readiness, rollout, or release receipts outside the local preview"; ["deliveryChannelId", "recipientScopeHash", "externalPolicyHash", "deliveryDenialIds"])
  ] as $authority_surfaces
  | [
    denial("durable_identity_evidence_missing"; surface_ids; "authority blocker cannot clear while durable identity evidence is missing"),
    denial("readiness_packet_is_not_acceptance_authority"; surface_ids; "a completed readiness packet is still a preview input and cannot grant authority"),
    denial("readiness_receipt_is_hash_only_evidence"; surface_ids; "a hash-only readiness receipt proves local evidence only and cannot grant authority"),
    denial("acknowledgement_visibility_is_not_acceptance"; surface_ids; "operator acknowledgement visibility cannot become acceptance or approval recording"),
    denial("signature_hash_is_not_live_signature"; surface_ids; "redacted signature hashes are not executable live authorization"),
    denial("approval_ledger_write_is_blocked"; ["approval_recording_authority", "operator_acceptance_authority", "live_persistence_authority"]; "approval and acceptance ledger writes are disabled in preview"),
    denial("live_persistence_enablement_is_blocked"; ["live_persistence_authority", "wal_checkpoint_authority", "enforcement_rollout_authority"]; "feature flags, WAL, checkpoints, enforcement, and traffic remain disabled"),
    denial("release_publication_policy_is_incomplete"; ["release_publication_authority", "external_delivery_authority"]; "release publication and external delivery policy are not accepted"),
    denial("operator_scope_expired_or_revoked_blocks_authority"; surface_ids; "expired, superseded, revoked, or digest-mismatched operator scope blocks authority")
  ] as $authority_denials
  | [
    guard("receipt_to_acceptance_guard"; "hash_only_readiness_receipt"; "operator_acceptance_authority"; ["receiptHash", "nonAcceptanceReasonIds", "authorityDenied"]),
    guard("acknowledgement_to_approval_guard"; "receipt_acknowledgement_visibility"; "approval_recording_authority"; ["acknowledgementHash", "recordingDenialIds", "approvalRecorded"]),
    guard("approval_to_live_persistence_guard"; "approval_or_acceptance_attempt"; "live_persistence_authority"; ["approvalLedgerWriteDenied", "featureFlagStillOff", "zeroWriteProofHash"]),
    guard("persistence_to_rollout_guard"; "persistence_enablement_attempt"; "enforcement_rollout_authority"; ["rolloutStageZeroTraffic", "enforcementDisabled", "killSwitchId"]),
    guard("rollout_to_release_guard"; "rollout_or_traffic_attempt"; "release_publication_authority"; ["releaseDenied", "publicationDenied", "publicClaimDenied"]),
    guard("release_to_external_delivery_guard"; "release_publication_attempt"; "external_delivery_authority"; ["externalDeliveryDenied", "recipientScopeDenied", "channelSendDenied"])
  ] as $escalation_guards
  | [
    record("trusted_operator_acceptance_record"; ["operator_acceptance_authority", "approval_recording_authority"]; ["trustedOperatorIdHash", "operatorScopeHash", "acceptedCapabilityIds", "explicitAuthorityGrant", "expiresAtUnixMs"]),
    record("approval_decision_record"; ["approval_recording_authority", "live_persistence_authority"]; ["approvalLedgerId", "decisionHash", "approverScopeHash", "recordedAtUnixMs", "rollbackBindingHash"]),
    record("live_persistence_enablement_record"; ["live_persistence_authority", "wal_checkpoint_authority"]; ["featureFlagState", "enablementPacketHash", "zeroTrafficProofHash", "zeroWriteProofHash", "killSwitchId"]),
    record("rollback_quarantine_owner_attestation"; ["wal_checkpoint_authority", "enforcement_rollout_authority"]; ["rollbackOwnerHash", "quarantineOwnerHash", "killSwitchId", "revertPlanHash", "ownerSignatureHash"]),
    record("release_publication_owner_attestation"; ["release_publication_authority"]; ["releaseOwnerHash", "publicationPolicyHash", "artifactManifestHash", "publicClaimScopeHash", "releaseDenialOverrideHash"]),
    record("external_delivery_consent_record"; ["external_delivery_authority"]; ["deliveryOwnerHash", "recipientScopeHash", "channelPolicyHash", "externalSendConsentHash", "redactionPolicyHash"])
  ] as $required_records
  | [
    view("operator_authority_denial_view"; "operator"; ["authorityDenied", "nonAcceptanceReasonIds", "requiredRecordIds", "nextGate"]),
    view("auditor_authority_evidence_view"; "auditor"; ["readinessReceiptHash", "acknowledgementHash", "authorityDenialIds", "sideEffectHash"]),
    view("release_owner_authority_blocker_view"; "release_owner"; ["releaseDenied", "publicationDenied", "externalDeliveryDenied", "requiredRecordIds"]),
    view("runtime_authority_zero_effect_view"; "system"; ["authorityGranted", "approvalRecorded", "livePersistenceEnabled", "externalSendPerformed"])
  ] as $authority_views
  | [
    invariant("acceptance_authority_requires_durable_identity_evidence"; "authority blocker surfaces require workflow, run, step, checkpoint, replay, rollback, and receipt evidence"),
    invariant("receipt_and_acknowledgement_cannot_grant_authority"; "readiness receipt and acknowledgement visibility are evidence only"),
    invariant("authority_requires_explicit_record_intake"; "every authority surface requires missing explicit trusted records"),
    invariant("approval_recording_is_blocked"; "approval and operator acceptance recording remain disabled"),
    invariant("live_persistence_and_rollout_are_blocked"; "persistence, WAL, checkpoints, enforcement, rollout, and traffic remain disabled"),
    invariant("release_and_external_delivery_are_blocked"; "release publication and external delivery remain denied"),
    invariant("acceptance_authority_blocker_preview_has_no_side_effects"; "this gate cannot write state, record authority, enable live execution, publish, or send externally")
  ] as $invariants
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_persistence_acceptance_authority_blocker_preview_gate",
      schema_version: "work_graph_persistence_acceptance_authority_blocker_preview_v1",
      preview_mode: "read_only_persistence_acceptance_authority_blocker_preview_no_authority",
      authority_surface_count: ($authority_surfaces | length),
      authority_denial_count: ($authority_denials | length),
      escalation_guard_count: ($escalation_guards | length),
      required_record_count: ($required_records | length),
      authority_view_count: ($authority_views | length),
      invariant_count: ($invariants | length),
      required_prior_gates: prior_gates,
      authority_surfaces: $authority_surfaces,
      authority_denials: $authority_denials,
      escalation_guards: $escalation_guards,
      required_records: $required_records,
      authority_views: $authority_views,
      durable_identity_evidence: {
        schema_version: $durable_identity_report.schema_version,
        required_prior_gate: "hepta_work_graph_durable_identity_preview_gate",
        required_field_ids: durable_fields,
        required_for_surface_ids: surface_ids,
        durable_field_count: $durable_identity_report.durable_field_count,
        preview_binding_count: $durable_identity_report.preview_binding_count,
        invariant_count: $durable_identity_report.invariant_count,
        currently_satisfied: false
      },
      invariants: $invariants,
      recommended_next_gate: "hepta_work_graph_persistence_acceptance_record_intake_preview_gate",
      ready_for_acceptance_record_intake_preview: true,
      ready_for_operator_acceptance: false,
      ready_for_live_persistence: false,
      source_probes: {
        persistence_acceptance_authority_blocker: {
          rust_module_present: $authority_rust_module_present,
          report_script_present: $authority_report_script_present,
          gate_script_present: $authority_gate_script_present
        },
        persistence_operator_readiness_receipt_acknowledgement: {
          rust_module_present: $ack_rust_module_present,
          gate_script_present: $ack_gate_script_present
        },
        durable_identity: {
          rust_module_present: $durable_identity_rust_module_present,
          report_script_present: $durable_identity_report_script_present,
          gate_script_present: $durable_identity_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        readiness_receipt_persisted: false,
        acknowledgement_recorded: false,
        operator_acceptance_recorded: false,
        approval_recorded: false,
        authority_granted: false,
        live_persistence_enabled: false,
        wal_written: false,
        checkpoint_written: false,
        enforcement_enabled: false,
        rollout_started: false,
        traffic_routed: false,
        release_published: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
