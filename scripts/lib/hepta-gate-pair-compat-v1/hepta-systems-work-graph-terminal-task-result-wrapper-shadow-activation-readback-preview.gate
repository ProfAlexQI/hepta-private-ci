#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-task-result-wrapper-shadow-activation-readback-preview.report"

report="$(capture_json_report "hepta-work-graph-terminal-task-result-wrapper-shadow-activation-readback-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_readback_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_shadow_activation_readback_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_shadow_activation_readback_preview_no_execution"
  and .shadow_readback_plan_count == 7
  and (.shadow_readback_plans | length) == .shadow_readback_plan_count
  and (.shadow_readback_plans | map(.activation_surface_id) == [
    "wrapper_execution_activation",
    "readback_execution_activation",
    "promotion_execution_activation",
    "task_result_enforcement_activation",
    "store_enablement_activation",
    "live_execution_activation",
    "external_delivery_activation"
  ])
  and (.shadow_readback_plans | all(
    .expected_activation_state == "blocked_preview_only"
    and .shadow_readback_state == "preview_contract_defined_shadow_readback_execution_disabled"
    and (.expected_blocker_ids | length) == 4
    and (.required_assertion_ids | length) == 6
    and (.drift_detector_ids | length) == 5
    and .performs_shadow_activation == false
    and .performs_readback == false
    and .mutates_activation_state == false
    and .mutates_store == false
    and .enables_runtime_mutation == false
  ))
  and .activation_surface_assertion_count == 6
  and (.activation_surface_assertions | length) == .activation_surface_assertion_count
  and (.activation_surface_assertions | map(.id) == [
    "assert_shadow_surface_stays_blocked",
    "assert_shadow_blocker_set_matches_activation_gate",
    "assert_shadow_enablements_remain_unsatisfied",
    "assert_shadow_kill_switches_remain_preview_only",
    "assert_shadow_side_effect_lock_remains_false",
    "assert_shadow_prior_gate_chain_matches"
  ])
  and (.activation_surface_assertions | all(
    .blocks_activation == true
    and .performs_readback == false
    and .mutates_store == false
    and (.required_inputs | length) >= 3
    and (.evidence_fields | length) >= 3
  ))
  and .drift_detector_count == 5
  and (.drift_detectors | length) == .drift_detector_count
  and (.drift_detectors | map(.id) == [
    "detect_shadow_activation_surface_state_drift",
    "detect_shadow_activation_blocker_binding_drift",
    "detect_shadow_enablement_satisfaction_drift",
    "detect_shadow_kill_switch_armament_drift",
    "detect_shadow_side_effect_lock_drift"
  ])
  and (.drift_detectors | all(.severity == "critical" and .blocks_activation == true and .persists_drift == false))
  and .operator_summary_count == 5
  and (.operator_summaries | length) == .operator_summary_count
  and (.operator_summaries | map(.id) == [
    "shadow_activation_denial_summary",
    "shadow_enablement_gap_summary",
    "shadow_kill_switch_summary",
    "shadow_external_delivery_denial_summary",
    "shadow_store_enforcement_denial_summary"
  ])
  and (.operator_summaries | all(.redacted == true and .persists_summary == false and (.required_fields | length) >= 3))
  and .blocker_count == 4
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "shadow_readback_execution_disabled",
    "activation_state_persistence_disabled",
    "operator_review_missing",
    "shadow_activation_drift_budget_missing"
  ])
  and (.blockers | map(select(.severity == "critical")) | length) == 1
  and (.blockers | map(select(.severity == "high")) | length) == 3
  and (.blockers | all(.required_before_shadow_readback_execution == true and (.affected_activation_surface_ids | length) >= 1))
  and .required_prior_gate_count == 18
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_activation_blocker_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_drift_budget_preview_gate"
  and .ready_for_shadow_activation_drift_budget_preview == true
  and .ready_for_shadow_readback_execution == false
  and .ready_for_activation == false
  and .ready_for_promotion_execution == false
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_shadow_activation_readback.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_readback.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_readback.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper_activation_blocker.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_activation_blocker.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_terminal_task_result_wrapper_shadow_activation_readback --lib

echo "Hepta WorkGraph terminal TaskResult wrapper shadow activation readback preview gate passed"
