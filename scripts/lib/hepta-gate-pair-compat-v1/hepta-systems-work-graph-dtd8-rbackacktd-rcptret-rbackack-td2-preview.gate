#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-dtd8-rbackacktd-rcptret-rbackack-td2-preview.report"
report="$(capture_json_report "hepta-systems-work-graph-dtd8-rbackacktd-rcptret-rbackack-td2-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and (.gate | endswith("_terminal_decision_non_promotion_preview_gate"))
  and .terminal_decision_surface_count == 6
  and (.terminal_decision_surfaces | all(.blocks_terminal_decision_recording == true and .blocks_persistence_promotion == true and .blocks_external_delivery == true))
  and .non_promotion_denial_count == 8
  and (.non_promotion_denials | all(.blocks_persistence_promotion == true and .blocks_authority_grant == true and .blocks_rollout == true and .blocks_release_publication == true and .blocks_public_claim == true and .blocks_external_delivery == true))
  and .authority_guard_count == 6
  and .release_delivery_guard_count == 6
  and (.authority_guards + .release_delivery_guards | all(.blocks_authority_grant == true and .blocks_external_delivery == true))
  and .local_view_count == 4
  and .invariant_count == 6
  and (.required_prior_gates[-1] | endswith("_receipt_retention_expiry_readback_acknowledgement_replay_idempotency_preview_gate"))
  and (.recommended_next_gate | endswith("_terminal_decision_non_promotion_receipt_preview_gate"))
  and .ready_for_terminal_decision_receipt_preview == true
  and .ready_for_operator_acceptance == false
  and .ready_for_live_persistence == false
  and .source_probes.latest_terminal_decision.rust_module_present == true
  and .source_probes.prior_receipt_retention_readback_ack_replay.report_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  wg_deep_td8_ret_ack_td_rback_ack_td_receipt_retention_readback_ack_td_receipt_retention_readback_ack_td_receipt_retention_readback_ack_td_receipt_retention_readback_ack_td_preview --lib

echo "Hepta WorkGraph deep td8 latest terminal decision non-promotion preview gate passed"
