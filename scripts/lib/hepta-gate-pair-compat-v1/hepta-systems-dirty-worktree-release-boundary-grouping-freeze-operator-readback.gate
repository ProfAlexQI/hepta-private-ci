#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-grouping-freeze-operator-readback.report"
GROUPING_FREEZE_PLAN_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-grouping-freeze-plan.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_GROUPING_FREEZE_OPERATOR_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-grouping-freeze-operator-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 13 report: $REPORT"
[[ -x "$GROUPING_FREEZE_PLAN_REPORT" ]] || fail "missing executable Phase 12 grouping freeze-plan report: $GROUPING_FREEZE_PLAN_REPORT"
[[ -f "$DOC" ]] || fail "missing Phase 13 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 13 dirty-worktree grouping freeze operator readback report"
fi

grep -q 'Dirty Worktree Release Boundary Grouping Freeze Operator Readback' "$DOC" \
  || fail "architecture note must document Dirty Worktree Release Boundary Grouping Freeze Operator Readback"
grep -q 'operator_readback_diff_only' "$DOC" \
  || fail "architecture note must document operator_readback_diff_only"
grep -q 'stable_key_state_delta' "$DOC" \
  || fail "architecture note must document stable_key_state_delta"
grep -q 'no git add, commit, push, reset, checkout, revert, cleanup, delete, freeze application, evidence recording, evidence persistence, approval acceptance, blocker waiver, package, release, Public GA, canary activation, live activation, or live execution' "$DOC" \
  || fail "architecture note must document the closed operator readback boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "dirty_worktree_release_boundary_grouping_freeze_operator_readback"
  and .status == "ready_blocked"
  and .gate == "dirty_worktree_release_boundary_grouping_freeze_operator_readback_gate"
  and .schema_version == "dirty_worktree_release_boundary_grouping_freeze_operator_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_grouping_freeze_plan_ready == true
  and .source_freeze_applied == false
  and .source_group_entry_count > 0
  and .source_planned_not_applied_count == .source_group_entry_count
  and .lib_export_present == true
  and .inventory_entry_count > 0
  and .inventory_entry_count == (.tracked_change_count + .untracked_change_count)
  and .readback_scope.readback_id == "dirty-worktree.release-boundary.grouping-freeze.operator-readback.v1"
  and .readback_scope.readback_route == "readback://release-boundary/dirty-worktree/grouping-freeze/operator-readback/v1"
  and .readback_scope.readback_mode == "operator_readback_diff_only"
  and .readback_scope.diff_mode == "stable_key_state_delta"
  and .readback_scope.mutation_boundary == "closed"
  and .readback_entry_count == .source_group_entry_count
  and .stable_readback_key_count == .readback_entry_count
  and .diff_key_count == .readback_entry_count
  and .comparison_anchor_count == .readback_entry_count
  and .planned_not_applied_readback_count == .readback_entry_count
  and .unchanged_freeze_state_count == .readback_entry_count
  and .unchanged_evidence_state_count == .readback_entry_count
  and .evidence_recorded_count == 0
  and .operator_readback_ready == true
  and .freeze_applied == false
  and .release_cutover_allowed == false
  and .git_add_allowed == false
  and .git_index_mutated == false
  and .git_commit_allowed == false
  and .git_push_allowed == false
  and .git_reset_allowed == false
  and .git_checkout_allowed == false
  and .git_revert_allowed == false
  and .cleanup_allowed == false
  and .delete_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persistence_allowed == false
  and .approval_acceptance_allowed == false
  and .blocker_waiver_allowed == false
  and .package_or_release_allowed == false
  and .public_ga_allowed == false
  and .canary_activation_allowed == false
  and .live_activation_allowed == false
  and .live_execution_allowed == false
  and (.entries | length) == .readback_entry_count
  and (.entries | any(.group_type == "top_level"))
  and (.entries | any(.group_type == "scope" and .source_bucket == "hepta_systems_owned"))
  and (.entries | any(.group_type == "scope" and .source_bucket == "cross_lane_or_unowned"))
  and (.entries | all(
    (.source_group_key | length) > 0
    and (.source_group_route | startswith("readback://release-boundary/dirty-worktree/group/"))
    and (.readback_key | startswith("dirty_worktree.readback."))
    and (.readback_route | startswith("readback://release-boundary/dirty-worktree/grouping-freeze/operator/"))
    and (.diff_key | startswith("dirty_worktree.diff."))
    and (.comparison_anchor | startswith("dirty_worktree.anchor."))
    and .source_entry_count > 0
    and .source_entry_count == (.tracked_count + .untracked_count)
    and .source_entry_count == (.hepta_systems_owned_count + .cross_lane_or_unowned_count)
    and .operator_status == "blocked_pending_clean_worktree_strategy"
    and .previous_freeze_state == "planned_not_applied"
    and .current_freeze_state == "planned_not_applied"
    and .freeze_state_delta == "unchanged_planned_not_applied"
    and .previous_evidence_state == "not_recorded"
    and .current_evidence_state == "not_recorded"
    and .evidence_state_delta == "unchanged_not_recorded"
    and .operator_visible == true
    and .queryable == true
    and .diffable == true
    and .readback_ready == true
    and .freeze_applied == false
    and .git_mutation_allowed == false
    and .cleanup_allowed == false
    and .evidence_recording_allowed == false
    and .release_cutover_allowed == false
    and .live_execution_allowed == false
  ))
  and (.blockers | index("dirty_worktree_release_boundary_operator_readback_not_clean")) != null
  and (.blockers | index("freeze_application_blocked")) != null
  and (.blockers | index("git_mutation_blocked")) != null
  and (.blockers | index("cleanup_and_delete_blocked")) != null
  and (.blockers | index("evidence_recording_blocked")) != null
  and (.blockers | index("release_cutover_blocked")) != null
  and (.blockers | index("canary_activation_blocked")) != null
  and (.blockers | index("live_activation_blocked")) != null
  and (.next_actions | index("phase14_dirty_worktree_release_boundary_actionable_clean_worktree_strategy_without_git_mutation")) != null
  and .next_migration_step == "phase14_dirty_worktree_release_boundary_actionable_clean_worktree_strategy_without_git_mutation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$GROUPING_FREEZE_PLAN_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "dirty_worktree_release_boundary_grouping_freeze_plan"
  and .grouping_freeze_plan_ready == true
  and .freeze_applied == false
  and .release_cutover_allowed == false
  and .git_index_mutated == false
  and .cleanup_allowed == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime dirty_worktree_release_boundary_grouping_freeze_operator_readback --lib
)

printf 'hepta-systems-dirty-worktree-release-boundary-grouping-freeze-operator-readback-gate: PASS: dirty worktree grouping freeze plan is operator-readable and diffable without git mutation, evidence recording, release, canary activation, or live execution\n'
