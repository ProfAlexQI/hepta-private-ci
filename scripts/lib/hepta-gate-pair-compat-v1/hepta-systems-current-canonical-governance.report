#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
CURRENT_CONSUMER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
SUCCESSOR_FINAL_GATE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-consumer-cutover-final-gate.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CURRENT_CANONICAL_GOVERNANCE_2026-06-21.md"

fail() {
  printf 'hepta-systems-current-canonical-governance-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$CURRENT_CONSUMER_REPORT" ]] || fail "missing executable current canonical consumer report: $CURRENT_CONSUMER_REPORT"
[[ -x "$SUCCESSOR_FINAL_GATE_REPORT" ]] || fail "missing executable promoted current canonical consumer cutover final gate report: $SUCCESSOR_FINAL_GATE_REPORT"
[[ -f "$DOC" ]] || fail "missing current canonical governance architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the current canonical governance report"
fi

jq -n \
  --slurpfile current <("$CURRENT_CONSUMER_REPORT") \
  --slurpfile final_gate <("$SUCCESSOR_FINAL_GATE_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-governance.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CURRENT_CANONICAL_GOVERNANCE_2026-06-21.md" \
  '
  ($current[0]) as $current |
  ($final_gate[0]) as $final |
  [
    {
      id:"active_current_canonical_consumer",
      surface:$current.surface,
      source_ready:$current.current_canonical_consumer_ready,
      governance_role:"active_rollback_anchor",
      invoked_by_report:false
    },
    {
      id:"terminal_successor_cutover_final_gate",
      surface:$final.surface,
      source_ready:$final.terminal_successor_canonical_consumer_cutover_final_gate_ready,
      governance_role:"successor_cutover_blocker",
      invoked_by_report:false
    }
  ] as $governance_inputs |
  [
    "manual_operator_live_cutover_approval_required",
    "explicit_live_cutover_approval_missing",
    "cutover_packet_not_recorded",
    "cutover_packet_not_accepted",
    "successor_consumer_cutover_disallowed",
    "current_canonical_consumer_rollback_anchor_retained",
    "canonical_gate_not_invoked",
    "wrapper_target_not_invoked",
    "terminal_live_gate_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "execution_disabled",
    "public_ga_disabled"
  ] as $governance_blockers |
  ($current.current_canonical_consumer_ready == true
    and $current.current_canonical_consumer_surface == "post_canonical_closure_compact_capability_summary"
    and $current.canonical_consumer_promotion_kind == "successor_report_only"
    and $final.terminal_successor_canonical_consumer_cutover_final_gate_ready == true
    and $final.terminal_successor_canonical_consumer_cutover_final_gate_blocked == true
    and $final.rollback_anchor == "current_canonical_consumer"
    and $final.successor_consumer_cutover_allowed == false
    and $final.cutover_packet_recorded == false
    and $final.cutover_packet_accepted == false
    and $final.operator_live_cutover_approval_recorded == false
    and $current.execution_enabled_count == 0
    and $current.public_ga_enabled_count == 0
    and $final.execution_enabled_count == 0
    and $final.public_ga_enabled_count == 0
    and $current.canonical_gate_wrapper_invoked == false
    and $current.wrapper_target_invoked == false
    and $final.canonical_gate_wrapper_invoked == false
    and $final.wrapper_target_invoked == false
    and $current.terminal_live_gate_invoked == false
    and $final.terminal_live_gate_invoked == false
    and $current.tool_execution_live_cutover_allowed == false
    and $current.tool_execution_public_ga_allowed == false
    and $final.tool_execution_live_cutover_allowed == false
    and $final.tool_execution_public_ga_allowed == false
    and ($governance_inputs | all(.source_ready == true and .invoked_by_report == false))
    and ($current.side_effects | to_entries | all(.value == false))
    and ($final.side_effects | to_entries | all(.value == false))) as $governance_ready |
  {
    runtime:"hepta",
    surface:"current_canonical_governance",
    plugin_id:$current.plugin_id,
    status:(if $governance_ready then "ready_blocked" else "blocked" end),
    source_current_canonical_consumer_surface:$current.surface,
    source_current_canonical_consumer_ready:$current.current_canonical_consumer_ready,
    source_successor_cutover_final_gate_surface:$final.surface,
    source_successor_cutover_final_gate_ready:$final.terminal_successor_canonical_consumer_cutover_final_gate_ready,
    source_successor_cutover_final_gate_blocked:$final.terminal_successor_canonical_consumer_cutover_final_gate_blocked,
    current_canonical_governance_ready:$governance_ready,
    current_canonical_governance_blocked:true,
    governance_input_count:($governance_inputs | length),
    governance_inputs:$governance_inputs,
    active_current_canonical_consumer_surface:$current.surface,
    active_current_canonical_consumer_report:$current.current_canonical_consumer_report,
    active_current_canonical_consumer_replaced_in_place:false,
    successor_canonical_consumer_surface:"promoted_current_canonical_consumer",
    successor_cutover_final_gate_attached:true,
    successor_cutover_final_gate_status:$final.status,
    successor_consumer_cutover_allowed:false,
    rollback_anchor:$final.rollback_anchor,
    manual_operator_live_cutover_approval_required:true,
    explicit_live_cutover_approval_present:false,
    operator_live_cutover_approval_recorded:false,
    cutover_packet_recorded:false,
    cutover_packet_accepted:false,
    final_blocker_count:$final.final_blocker_count,
    governance_blocker_count:($governance_blockers | length),
    governance_blockers:$governance_blockers,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"derive_current_canonical_governance_readback_without_live_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      current_canonical_consumer_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report",
      promoted_current_canonical_consumer_cutover_final_gate_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-consumer-cutover-final-gate.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      current_canonical_consumer_mutated:false,
      promoted_current_canonical_consumer_mutated:false,
      cutover_packet_recorded:false,
      cutover_packet_accepted:false,
      current_canonical_wrapper_mutated:false,
      promoted_current_canonical_wrapper_mutated:false,
      current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_mutated:false,
      promoted_current_canonical_closure_index_mutated:false,
      historical_canonical_gate_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
