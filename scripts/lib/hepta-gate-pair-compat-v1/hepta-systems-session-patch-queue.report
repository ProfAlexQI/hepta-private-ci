#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${HEPTA_RECONSTRUCTION_REPO_ROOT:-${HEPTA_REPO_ROOT:-$(cd "$(dirname "$0")/.." && pwd -P)}}"
SESSION_ROOT="${HEPTA_AGENT_SESSION_ROOT:-$HOME/.openclaw/agents/hepta/agent/codex-home/sessions}"
REPO_PREFIX="$REPO_ROOT/"
INCLUDE_FULL_QUEUE_RAW="${HEPTA_SESSION_PATCH_QUEUE_FULL:-false}"
ANCHOR_FILTER="${HEPTA_SESSION_PATCH_QUEUE_ANCHOR_FILTER:-}"

include_full_queue=false
case "$INCLUDE_FULL_QUEUE_RAW" in
  1|true|TRUE|yes|YES) include_full_queue=true ;;
esac

case "$ANCHOR_FILTER" in
  ""|compact_capability_matrix) ;;
  *)
    echo "unsupported HEPTA_SESSION_PATCH_QUEUE_ANCHOR_FILTER: $ANCHOR_FILTER" >&2
    exit 2
    ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required for the Hepta session patch queue report" >&2
  exit 127
fi

if [[ ! -d "$SESSION_ROOT" ]]; then
  jq -n \
    --arg runtime "hepta" \
    --arg repo_root "$REPO_ROOT" \
    --arg session_root "$SESSION_ROOT" \
    '{
      runtime:$runtime,
      surface:"hepta_systems_session_patch_queue",
      status:"blocked",
      repo_root:$repo_root,
      session_root:$session_root,
      anchor_filter:null,
      side_effect_free:true,
      report_only:true,
      replay_applied:false,
      patch_body_emitted:false,
      blocker:"missing_agent_session_root"
    }'
  exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

records_jsonl="$tmpdir/records.jsonl"
calls_jsonl="$tmpdir/calls.jsonl"
entries_jsonl="$tmpdir/entries.jsonl"
statuses_jsonl="$tmpdir/statuses.jsonl"
: >"$records_jsonl"
: >"$calls_jsonl"
: >"$entries_jsonl"
: >"$statuses_jsonl"

session_file_count="$(
  find "$SESSION_ROOT" -type f -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' '
)"

while IFS= read -r -d '' session_file; do
  jq -c \
    --arg repo_prefix "$REPO_PREFIX" \
    --arg session_root "$SESSION_ROOT" \
    --arg anchor_filter "$ANCHOR_FILTER" \
    '
      def anchor_filter_match($patch):
        if $anchor_filter == "" then
          true
        elif $anchor_filter == "compact_capability_matrix" then
          (($patch | ascii_downcase | contains("hepta-systems-capability-matrix"))
            or ($patch | contains("HEPTA_SYSTEMS_CAPABILITY_MATRIX"))
            or ($patch | ascii_downcase | contains("hepta-systems-canonical-gate")))
        else
          false
        end;

      def file_entry:
        if test("^\\*\\*\\* Add File: ") then
          {operation:"add", path:(sub("^\\*\\*\\* Add File: "; ""))}
        elif test("^\\*\\*\\* Update File: ") then
          {operation:"update", path:(sub("^\\*\\*\\* Update File: "; ""))}
        elif test("^\\*\\*\\* Delete File: ") then
          {operation:"delete", path:(sub("^\\*\\*\\* Delete File: "; ""))}
        else
          empty
        end;

      select(
        .type == "response_item"
        and .payload.type == "custom_tool_call"
        and .payload.name == "apply_patch"
        and ((.payload.input // "") | contains($repo_prefix))
        and anchor_filter_match(.payload.input // "")
      ) as $event
      | ($event.payload.input // "") as $patch
      | (
        {
          kind:"call",
          timestamp:$event.timestamp,
          session:(input_filename | ltrimstr($session_root + "/")),
          call_id:$event.payload.call_id,
          queue_key:((input_filename | ltrimstr($session_root + "/")) + "|" + ($event.payload.call_id // "")),
          patch_line_count:($patch | split("\n") | length),
          touched_file_count:(
            $patch | split("\n")
            | map(select(test("^\\*\\*\\* (Add|Update|Delete) File: ")))
            | length
          )
        },
        (
          $patch
          | split("\n")[]
          | select(test("^\\*\\*\\* (Add|Update|Delete) File: "))
          | file_entry
          | select(.path | startswith($repo_prefix))
          | {
          kind:"entry",
          timestamp:$event.timestamp,
          session:(input_filename | ltrimstr($session_root + "/")),
          call_id:$event.payload.call_id,
          queue_key:((input_filename | ltrimstr($session_root + "/")) + "|" + ($event.payload.call_id // "")),
          operation:.operation,
          repo_relative_path:(.path | ltrimstr($repo_prefix))
        })
      )
    ' "$session_file" >>"$records_jsonl"
done < <(find "$SESSION_ROOT" -type f -name '*.jsonl' -print0 2>/dev/null)

jq -c 'select(.kind == "call") | del(.kind)' "$records_jsonl" >"$calls_jsonl"
jq -c 'select(.kind == "entry") | del(.kind)' "$records_jsonl" >"$entries_jsonl"

while IFS= read -r rel_path; do
  [[ -n "$rel_path" ]] || continue
  present=false
  tracked=false
  current_status="missing"

  if [[ -e "$REPO_ROOT/$rel_path" ]]; then
    present=true
  fi
  if git -C "$REPO_ROOT" ls-files --error-unmatch -- "$rel_path" >/dev/null 2>&1; then
    tracked=true
  fi

  if [[ "$present" == "true" && "$tracked" == "true" ]]; then
    current_status="present_tracked"
  elif [[ "$present" == "true" ]]; then
    current_status="present_untracked"
  fi

  jq -cn \
    --arg path "$rel_path" \
    --arg current_status "$current_status" \
    --argjson present "$present" \
    --argjson tracked "$tracked" \
    '{path:$path, current_status:$current_status, present:$present, tracked:$tracked}'
done < <(jq -r '.repo_relative_path' "$entries_jsonl" | LC_ALL=C sort -u) >"$statuses_jsonl"

jq -n \
  --arg runtime "hepta" \
  --arg surface "hepta_systems_session_patch_queue" \
  --arg repo_root "$REPO_ROOT" \
  --arg session_root "$SESSION_ROOT" \
  --arg anchor_filter "$ANCHOR_FILTER" \
  --argjson include_full_queue "$include_full_queue" \
  --argjson session_file_count "$session_file_count" \
  --slurpfile calls "$calls_jsonl" \
  --slurpfile entries "$entries_jsonl" \
  --slurpfile statuses "$statuses_jsonl" \
  '
    def anchor_ids($paths):
      [
        if any($paths[]; (ascii_downcase | contains("contribution_point_abi")) or (ascii_downcase | contains("plugin-contribution-point"))) then
          "plugin_contribution_point_abi"
        else empty end,
        if any($paths[]; (ascii_downcase | contains("tool_registry_router_lookup_shadow")) or (ascii_downcase | contains("tool-registry-router-lookup-shadow"))) then
          "tool_registry_router_lookup_shadow"
        else empty end,
        if any($paths[]; (ascii_downcase | contains("workflow_durable_store_replay_proof")) or (ascii_downcase | contains("workflow-durable-store-replay-proof")) or (ascii_downcase | contains("durable-store-replay-proof"))) then
          "workflow_durable_store_replay_proof"
        else empty end,
        if any($paths[]; (ascii_downcase | contains("hepta-systems-capability-matrix")) or contains("HEPTA_SYSTEMS_CAPABILITY_MATRIX") or (ascii_downcase | contains("hepta-systems-canonical-gate"))) then
          "compact_capability_matrix"
        else empty end,
        if any($paths[]; (ascii_downcase | contains("work_graph_scheduler")) or (ascii_downcase | contains("work-graph-scheduler")) or (ascii_downcase | contains("scheduler_cutover")) or (ascii_downcase | contains("scheduler-cutover"))) then
          "scheduler_cutover_preview_chain"
        else empty end
      ] | unique | sort;

    def current_counts($files):
      $files
      | group_by(.current.current_status)
      | map({key:.[0].current.current_status, value:length})
      | from_entries;

    def replay_risk($files):
      if any($files[]; .current.current_status == "present_tracked") then
        "manual_review_existing_tracked_paths"
      elif any($files[]; (.operation != "add") and .current.current_status == "missing") then
        "requires_missing_base_path_reconstruction"
      elif all($files[]; .current.current_status == "missing") then
        "candidate_missing_paths_only"
      else
        "mixed_review_required"
      end;

    ($statuses | map({key:.path, value:.}) | from_entries) as $status_by_path
    | (
        $entries
        | group_by(.queue_key)
        | map({
            key:.[0].queue_key,
            value:(
              map(. + {current:($status_by_path[.repo_relative_path] // {current_status:"unknown", present:false, tracked:false})})
              | sort_by(.repo_relative_path, .operation)
            )
          })
        | from_entries
      ) as $entries_by_key
    | (
        $calls
        | sort_by(.timestamp, .session, .call_id)
        | map(
            . as $call
            | ($entries_by_key[$call.queue_key] // []) as $files
            | ($files | map(.repo_relative_path) | unique | sort) as $paths
            | (anchor_ids($paths)) as $anchors
            | $call + {
                touched_paths:$paths,
                touched_files:$files,
                operations:($files | map(.operation) | unique | sort),
                anchor_ids:$anchors,
                phase:(
                  if ($anchors | length) > 0 then "phase0_anchor_recovery"
                  elif any($paths[]; startswith("scripts/hepta-systems-") or startswith("docs/architecture/HEPTA_SYSTEMS_")) then "hepta_systems_recovery"
                  else "other_hepta_history"
                  end
                ),
                current_status_counts:current_counts($files),
                replay_risk:replay_risk($files)
              }
          )
      ) as $queue
    | ($queue | map(select((.anchor_ids | length) > 0))) as $phase0_queue
    | ($phase0_queue | map(.anchor_ids[]) | unique | sort) as $phase0_anchor_ids
    | {
        runtime:$runtime,
        surface:$surface,
        status:(if ($queue | length) > 0 then "ready" else "blocked" end),
        repo_root:$repo_root,
        session_root:$session_root,
        anchor_filter:(if $anchor_filter == "" then null else $anchor_filter end),
        session_file_count:$session_file_count,
        ordered_patch_call_count:($queue | length),
        patch_file_entry_count:($entries | length),
        touched_path_count:($statuses | length),
        present_path_count:($statuses | map(select(.present == true)) | length),
        missing_path_count:($statuses | map(select(.present == false)) | length),
        phase0_anchor_patch_call_count:($phase0_queue | length),
        phase0_anchor_id_count:($phase0_anchor_ids | length),
        phase0_anchor_ids:$phase0_anchor_ids,
        phase0_anchor_summary:(
          $phase0_anchor_ids
          | map(. as $id | {
              id:$id,
              patch_call_count:($phase0_queue | map(select(.anchor_ids | index($id))) | length),
              missing_path_count:(
                $phase0_queue
                | map(select(.anchor_ids | index($id)) | .touched_files[])
                | unique_by(.repo_relative_path)
                | map(select(.current.present == false))
                | length
              ),
              first_timestamp:($phase0_queue | map(select(.anchor_ids | index($id)) | .timestamp) | min),
              last_timestamp:($phase0_queue | map(select(.anchor_ids | index($id)) | .timestamp) | max)
            })
        ),
        side_effect_free:true,
        report_only:true,
        replay_applied:false,
        patch_replay_enabled:false,
        patch_body_emitted:false,
        full_queue_included:$include_full_queue,
        recommended_next_local_step:"extract_selected_anchor_patch_bodies_for_manual_apply_check",
        ordered_patch_queue:(if $include_full_queue then $queue else [] end),
        ordered_patch_queue_head:($queue[0:40]),
        ordered_patch_queue_tail:($queue[-20:]),
        phase0_anchor_patch_queue:$phase0_queue
      }
  '
