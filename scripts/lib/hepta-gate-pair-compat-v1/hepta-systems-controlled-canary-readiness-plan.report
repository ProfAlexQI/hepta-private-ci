#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
APPROVAL_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-hepta-system-status-operator-approval-protocol.report"
BOUNDARY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-kill-switch-rehearsal-boundary-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_canary_readiness_plan.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_CANARY_READINESS_PLAN_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-canary-readiness-plan-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$APPROVAL_REPORT" ]] || fail "missing executable Phase 9 approval protocol report: $APPROVAL_REPORT"
[[ -x "$BOUNDARY_REPORT" ]] || fail "missing executable Phase 5n kill-switch boundary report: $BOUNDARY_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing Phase 10 Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing Phase 10 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Phase 10 controlled canary readiness plan report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

approval_cache="${HEPTA_CONTROLLED_CANARY_APPROVAL_JSON:-}"
boundary_cache="${HEPTA_CONTROLLED_CANARY_BOUNDARY_JSON:-}"
approval_json="$tmpdir/approval.json"
boundary_json="$tmpdir/boundary.json"
approval_cache_consumed=false
boundary_cache_consumed=false

if [[ -n "$approval_cache" ]]; then
  [[ -f "$approval_cache" ]] || fail "missing cached Phase 9 approval protocol report: $approval_cache"
  approval_json="$approval_cache"
  approval_cache_consumed=true
else
  "$APPROVAL_REPORT" >"$approval_json" \
    || fail "failed to render Phase 9 approval protocol report"
fi

if [[ -n "$boundary_cache" ]]; then
  [[ -f "$boundary_cache" ]] || fail "missing cached Phase 5n kill-switch boundary report: $boundary_cache"
  boundary_json="$boundary_cache"
  boundary_cache_consumed=true
else
  "$BOUNDARY_REPORT" >"$boundary_json" \
    || fail "failed to render Phase 5n kill-switch boundary report"
fi

jq -e . "$approval_json" >/dev/null \
  || fail "invalid JSON rendered by Phase 9 approval protocol report"
jq -e . "$boundary_json" >/dev/null \
  || fail "invalid JSON rendered by Phase 5n kill-switch boundary report"

lib_export_present=false
if grep -q 'controlled_canary_readiness_plan_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

start_guard_bound_present=false
if grep -q 'status_canary_start_guard_bound' "$RUST_SOURCE" \
  && grep -q 'STATUS_CANARY_START_GUARD_ID' "$RUST_SOURCE" \
  && grep -q 'status_canary_start_guard()' "$RUST_SOURCE"; then
  start_guard_bound_present=true
fi

start_guard_lib_export_present=false
if grep -q 'status_canary_start_guard' "$LIB_SOURCE" \
  && grep -q 'controlled_canary_readiness_plan_report_from_sources_and_start_guard' "$LIB_SOURCE"; then
  start_guard_lib_export_present=true
fi

jq -n \
  --slurpfile approval "$approval_json" \
  --slurpfile boundary "$boundary_json" \
  --argjson lib_export_present "$lib_export_present" \
  --argjson start_guard_bound_present "$start_guard_bound_present" \
  --argjson start_guard_lib_export_present "$start_guard_lib_export_present" \
  --argjson approval_cache_consumed "$approval_cache_consumed" \
  --argjson boundary_cache_consumed "$boundary_cache_consumed" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-canary-readiness-plan.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_CANARY_READINESS_PLAN_2026-06-27.md" \
  '
  def plan_key($id): "controlled_canary.plan." + $id;
  def plan_route($id): "canary://hepta-system/status/readiness/" + ($id | gsub("_"; "-"));
  ($approval[0]) as $approval |
  ($boundary[0]) as $boundary |
  ($boundary.entries | map({
    source_blocker_id,
    plan_key:plan_key(.source_blocker_id),
    plan_route:plan_route(.source_blocker_id),
    source_boundary_route:.kill_switch_rehearsal_boundary_route,
    owner,
    risk_bucket,
    operator_status,
    evidence_state:.kill_switch_rehearsal_evidence_state,
    required_canary_evidence:.required_evidence,
    readiness_state:"missing_required_evidence",
    operator_visible,
    queryable:.kill_switch_rehearsal_boundary_readback_visible,
    canary_plan_ready:(.operator_visible == true and .kill_switch_rehearsal_boundary_readback_visible == true),
    blocks_canary_activation:true,
    evidence_recording_allowed:false,
    approval_acceptance_allowed:false,
    waiver_allowed:false,
    credential_read_allowed:false,
    transport_mutation_allowed:false,
    persistence_allowed:false,
    live_activation_allowed:false
  })) as $entries |
  ($entries | map(select(.canary_plan_ready == true)) | length) as $canary_plan_ready_count |
  ($entries | map(select(.evidence_state == "missing")) | length) as $missing_blocker_count |
  ($entries | any(.source_blocker_id == "dirty_worktree_boundary")) as $dirty_worktree_blocker_preserved |
  ($entries | any(.source_blocker_id == "fresh_soak_readback_missing")) as $soak_readback_required |
  ($entries | any(.source_blocker_id == "rollback_rehearsal_missing")) as $rollback_rehearsal_required |
  ($entries | any(.source_blocker_id == "kill_switch_rehearsal_missing")) as $kill_switch_rehearsal_required |
  (($entries | any(.source_blocker_id == "gateway_native_telegram_post_boundary_approval_missing")) and $boundary.transport_mutation_allowed == false) as $gateway_native_telegram_boundary_closed |
  (($entries | any(.source_blocker_id == "credential_boundary_attestation_missing")) and $boundary.credential_read_allowed == false) as $credential_boundary_closed |
  ($boundary.packet_persisted == false and $boundary.attachment_persisted == false and $boundary.readback_persisted == false) as $persistence_boundary_closed |
  ($approval.approval_protocol_ready == true
    and $approval.approval_packet_count == 1
    and $approval.explicit_accept_required == true
    and $approval.non_acceptance_receipt_projected == true
    and $approval.approval_request_sent == false
    and $approval.approval_accepted == false
    and $approval.approval_recorded == false
    and $approval.approval_broker_write_allowed == false
    and $approval.receipt_persisted == false
    and $approval.credential_read_allowed == false
    and $approval.external_network_allowed == false
    and $approval.ledger_write_allowed == false
    and $approval.transport_mutation_allowed == false
    and $approval.live_execution_allowed == false
    and $boundary.kill_switch_rehearsal_boundary_readback_ready == true
    and $boundary.kill_switch_rehearsal_boundary_entry_count == 7
    and $boundary.kill_switch_rehearsal_boundary_ready_count == 7
    and $boundary.kill_switch_rehearsal_evidence_missing_count == 7
    and $boundary.approval_request_sent == false
    and $boundary.approval_accepted == false
    and $boundary.blocker_waived_count == 0
    and $boundary.evidence_recorded_count == 0
    and $lib_export_present == true
    and ($entries | length) == 7
    and $canary_plan_ready_count == 7
    and $missing_blocker_count == 7
    and $dirty_worktree_blocker_preserved == true
    and $soak_readback_required == true
    and $rollback_rehearsal_required == true
    and $kill_switch_rehearsal_required == true
    and $gateway_native_telegram_boundary_closed == true
    and $credential_boundary_closed == true
    and $persistence_boundary_closed == true
    and $start_guard_bound_present == true
    and $start_guard_lib_export_present == true
    and ($entries | all(.operator_visible == true
      and .queryable == true
      and .blocks_canary_activation == true
      and .evidence_recording_allowed == false
      and .approval_acceptance_allowed == false
      and .waiver_allowed == false
      and .credential_read_allowed == false
      and .transport_mutation_allowed == false
      and .persistence_allowed == false
      and .live_activation_allowed == false))) as $plan_ready |
  {
    runtime:"hepta",
    surface:"controlled_canary_readiness_plan",
    status:(if $plan_ready then "ready_blocked" else "blocked" end),
    gate:"controlled_canary_readiness_plan_gate",
    schema_version:"controlled_canary_readiness_plan_v1",
    plugin_id:$approval.plugin_id,
    source_approval_protocol_gate:$approval.gate,
    source_approval_protocol_ready:$approval.approval_protocol_ready,
    source_approval_packet_count:$approval.approval_packet_count,
    source_approval_request_sent:$approval.approval_request_sent,
    source_approval_accepted:$approval.approval_accepted,
    source_approval_recorded:$approval.approval_recorded,
    source_approval_cache_consumed:$approval_cache_consumed,
    source_boundary_gate:$boundary.gate,
    source_boundary_ready:$boundary.kill_switch_rehearsal_boundary_readback_ready,
    source_boundary_entry_count:$boundary.kill_switch_rehearsal_boundary_entry_count,
    source_boundary_ready_count:$boundary.kill_switch_rehearsal_boundary_ready_count,
    source_boundary_missing_evidence_count:$boundary.kill_switch_rehearsal_evidence_missing_count,
    source_boundary_cache_consumed:$boundary_cache_consumed,
    lib_export_present:$lib_export_present,
    status_canary_start_guard_rust_bound_present:$start_guard_bound_present,
    status_canary_start_guard_lib_export_present:$start_guard_lib_export_present,
    canary_scope:{
      canary_id:"controlled-canary.hepta-system-status.internal-read-only.v1",
      scope_route:"canary://hepta-system/status/internal-read-only/readiness-plan",
      approval_subject:$approval.approval_subject,
      source_packet_id:$approval.packet.packet_id,
      selected_candidate_tool_id:$approval.selected_candidate_tool_id,
      allowed_surface:"internal_read_only_status_payload",
      activation_mode:"plan_only_no_activation",
      gateway_auth_boundary:"closed",
      native_post_boundary:"closed",
      telegram_transport_boundary:"closed",
      channel_send_boundary:"closed",
      credential_boundary:"closed",
      persistence_boundary:"closed",
      live_activation_boundary:"closed"
    },
    canary_plan_entry_count:($entries | length),
    canary_plan_ready_count:$canary_plan_ready_count,
    blocker_reference_count:($entries | length),
    missing_blocker_count:$missing_blocker_count,
    approval_protocol_bound:$approval.approval_protocol_ready,
    operator_readback_bound:$boundary.kill_switch_rehearsal_boundary_readback_ready,
    dirty_worktree_blocker_preserved:$dirty_worktree_blocker_preserved,
    soak_readback_required:$soak_readback_required,
    rollback_rehearsal_required:$rollback_rehearsal_required,
    kill_switch_rehearsal_required:$kill_switch_rehearsal_required,
    gateway_native_telegram_boundary_closed:$gateway_native_telegram_boundary_closed,
    credential_boundary_closed:$credential_boundary_closed,
    persistence_boundary_closed:$persistence_boundary_closed,
    status_canary_start_guard_bound:($start_guard_bound_present and $start_guard_lib_export_present),
    status_canary_start_guard_id:"status-canary-start-guard/hepta-system-status/v1",
    status_canary_start_guard_route:"status_canary_start_blocked_missing_evidence_packet",
    status_canary_start_guard_switch_enabled:false,
    status_canary_start_guard_evidence_complete:false,
    status_canary_start_guard_missing_evidence_count:7,
    status_canary_start_guard_side_effects_closed:true,
    status_canary_start_guard_blocked:true,
    status_canary_start_guard_allowed:false,
    controlled_canary_readiness_plan_ready:$plan_ready,
    controlled_canary_activation_ready:false,
    approval_request_sent:false,
    approval_request_allowed:false,
    approval_accepted:false,
    approval_recorded:false,
    approval_broker_write_allowed:false,
    evidence_recording_allowed:false,
    credential_read_allowed:false,
    gateway_or_auth_mutation_allowed:false,
    native_post_mutation_allowed:false,
    telegram_transport_mutation_allowed:false,
    channel_send_allowed:false,
    transport_mutation_allowed:false,
    canary_persistence_allowed:false,
    canary_receipt_persisted:false,
    workflow_event_log_write_allowed:false,
    sqlite_write_allowed:false,
    provider_invocation_allowed:false,
    model_invocation_allowed:false,
    package_or_release_allowed:false,
    public_ga_allowed:false,
    live_activation_allowed:false,
    live_execution_allowed:false,
    entries:$entries,
    blockers:[
      "dirty_worktree_release_boundary_unresolved",
      "operator_live_approval_missing",
      "fresh_soak_readback_missing",
      "credential_boundary_attestation_missing",
      "gateway_native_telegram_post_boundary_approval_missing",
      "rollback_rehearsal_missing",
      "kill_switch_rehearsal_missing",
      "canary_activation_blocked",
      "gateway_native_telegram_boundaries_closed",
      "credential_boundary_closed",
      "persistence_boundary_closed",
      "status_canary_start_guard_blocked",
      "live_activation_closed"
    ],
    next_actions:[
      "phase11_dirty_worktree_release_boundary_inventory_without_git_mutation"
    ],
    next_migration_step:"phase11_dirty_worktree_release_boundary_inventory_without_git_mutation",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      approval_requested:false,
      approval_accepted:false,
      approval_recorded:false,
      approval_broker_written:false,
      evidence_recorded:false,
      evidence_persisted:false,
      blocker_waived:false,
      credential_read:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      packet_persisted:false,
      canary_receipt_persisted:false,
      workflow_event_log_written:false,
      sqlite_written:false,
      provider_invoked:false,
      model_invoked:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_activation_started:false,
      live_execution_started:false
    }
  }'
