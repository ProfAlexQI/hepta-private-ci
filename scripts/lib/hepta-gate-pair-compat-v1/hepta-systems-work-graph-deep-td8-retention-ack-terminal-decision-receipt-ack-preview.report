#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

path_exists() { [[ -e "$1" ]]; }
bool_for() {
  if "$@"; then printf 'true\n'; else printf 'false\n'; fi
}

prior_report_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-retention-ack-terminal-decision-receipt-preview.report"
prior_gate_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-retention-ack-terminal-decision-receipt-preview.gate"
prior_report="$("$ROOT/$prior_report_script")"
GATE="$(jq -r '.recommended_next_gate' <<<"$prior_report")"
BASE="${GATE%_receipt_acknowledgement_preview_gate}"
SCHEMA="${GATE#hepta_}"
SCHEMA="${SCHEMA%_gate}_v1"
NEXT="${BASE}_receipt_acknowledgement_replay_idempotency_preview_gate"
required_prior_gates="$(jq -c '.required_prior_gates + [.gate]' <<<"$prior_report")"

rust_module="codex-rs/hepta-runtime/src/wg_deep_td8_retention_ack_terminal_decision_receipt_ack_preview.rs"
report_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-retention-ack-terminal-decision-receipt-ack-preview.report"
gate_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-retention-ack-terminal-decision-receipt-ack-preview.gate"

jq -n \
  --arg gate "$GATE" \
  --arg schema "$SCHEMA" \
  --arg next "$NEXT" \
  --argjson required_prior_gates "$required_prior_gates" \
  --argjson rust_module_present "$(bool_for path_exists "$rust_module")" \
  --argjson report_script_present "$(bool_for path_exists "$report_script")" \
  --argjson gate_script_present "$(bool_for path_exists "$gate_script")" \
  --argjson prior_report_script_present "$(bool_for path_exists "$prior_report_script")" \
  --argjson prior_gate_script_present "$(bool_for path_exists "$prior_gate_script")" \
  '
  def receipt_ids: [range(0; 6) | "deep_td8_retention_ack_terminal_decision_receipt_\(.)"];
  def ack_ids: [range(0; 6) | "deep_td8_retention_ack_terminal_decision_receipt_ack_\(.)"];
  def contract($i): {
    id: "deep_td8_retention_ack_terminal_decision_receipt_ack_\($i)",
    source_receipt_ids: receipt_ids,
    acknowledgement_visibility: "local_deep_td8_receipt_acknowledgement_visibility",
    acknowledgement_recording_allowed: false,
    receipt_recording_allowed: false,
    acceptance_allowed: false,
    authority_grant_allowed: false,
    public_claim_enabled: false,
    external_delivery_enabled: false
  };
  def non_acceptance($i): {
    id: "deep_td8_receipt_ack_non_acceptance_reason_\($i)",
    applies_to_acknowledgement_ids: ack_ids,
    reason: "deep td8 receipt acknowledgement is not acceptance",
    blocks_acceptance: true,
    blocks_authority: true
  };
  def recording_denial($i): {
    id: "deep_td8_receipt_ack_recording_denial_\($i)",
    applies_to_acknowledgement_ids: ack_ids,
    target_record: "deepTd8ReceiptAcknowledgement",
    reason: "deep td8 receipt acknowledgement cannot record state",
    blocks_acknowledgement_recording: true,
    blocks_receipt_recording: true,
    blocks_acceptance: true,
    blocks_authority: true,
    blocks_release_publication: true,
    blocks_public_claim: true,
    blocks_external_delivery: true
  };
  def replay_guard($i): {
    id: "deep_td8_receipt_ack_expiry_replay_guard_\($i)",
    applies_to_acknowledgement_ids: ack_ids,
    required_fields: ["scopeId", "scopeEpoch", "zeroEffectHash"],
    blocks_acknowledgement_recording: true
  };
  def local_view($i): {
    id: "deep_td8_receipt_ack_local_view_\($i)",
    audience: (["operator", "release_owner", "auditor", "system"][$i]),
    required_fields: ["acknowledgementId", "receiptHash", "acceptanceAllowed", "nextGate"],
    external_delivery_enabled: false
  };
  def invariant($i): {
    id: "deep_td8_receipt_ack_invariant_\($i)",
    required: true,
    reason: "deep td8 receipt acknowledgement is local and zero-effect"
  };
  {
    product: "Hepta",
    runtime: "hepta",
    status: "ready",
    gate: $gate,
    schema_version: $schema,
    preview_mode: "read_only_deep_td8_retention_ack_terminal_decision_receipt_acknowledgement_preview_no_recording",
    acknowledgement_contract_count: 6,
    non_acceptance_reason_count: 7,
    recording_denial_count: 7,
    expiry_replay_guard_count: 5,
    local_view_count: 4,
    invariant_count: 6,
    required_prior_gates: $required_prior_gates,
    acknowledgement_contracts: [range(0; 6) | contract(.)],
    non_acceptance_reasons: [range(0; 7) | non_acceptance(.)],
    recording_denials: [range(0; 7) | recording_denial(.)],
    expiry_replay_guards: [range(0; 5) | replay_guard(.)],
    local_views: [range(0; 4) | local_view(.)],
    invariants: [range(0; 6) | invariant(.)],
    recommended_next_gate: $next,
    ready_for_terminal_decision_receipt_acknowledgement_replay_preview: true,
    ready_for_operator_acceptance: false,
    ready_for_live_persistence: false,
    side_effects: {
      filesystem_written: false,
      graph_state_persisted: false,
      terminal_decision_recorded: false,
      receipt_recorded: false,
      acknowledgement_recorded: false,
      operator_acceptance_recorded: false,
      approval_recorded: false,
      authority_granted: false,
      live_persistence_enabled: false,
      wal_written: false,
      checkpoint_written: false,
      rollout_started: false,
      release_published: false,
      public_claim_recorded: false,
      external_send_performed: false,
      model_invoked: false
    },
    source_probes: {
      deep_td8_retention_ack_terminal_decision_receipt_ack: {
        rust_module_present: $rust_module_present,
        report_script_present: $report_script_present,
        gate_script_present: $gate_script_present
      },
      prior_deep_td8_retention_ack_terminal_decision_receipt: {
        report_script_present: $prior_report_script_present,
        gate_script_present: $prior_gate_script_present
      }
    }
  }
'
