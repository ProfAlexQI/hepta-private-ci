#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-adapter-preflight.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-receipt-projection.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_ADAPTER_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-adapter-preflight-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable execution adapter preflight report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable receipt projection gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing execution adapter preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the execution adapter preflight report"
fi

grep -q 'Execution Adapter Preflight' "$DOC" \
  || fail "architecture note must document Execution Adapter Preflight"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'disabled execution adapter' "$DOC" \
  || fail "architecture note must document disabled execution adapter"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_adapter_preflight"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_receipt_projection_surface == "tool_invocation_receipt_projection"
  and .source_receipt_projection_ready == true
  and .execution_adapter_binding_present == true
  and .tool_invocation_execution_switch_enabled == false
  and .adapter_dispatch_switch_enabled == false
  and .candidate_count == 2
  and .execution_adapter_preflight_ready_count == 2
  and .execution_adapter_preflight_blocked_count == 0
  and .disabled_execution_adapter_preflight_count == 2
  and .mcp_tool_call_adapter_preflight_count == 1
  and .app_connector_invocation_adapter_preflight_count == 1
  and .all_receipt_projection_entries_bound_to_execution_adapter_preflight == true
  and .all_execution_adapter_entries_keep_approval_guard == true
  and .tool_execution_adapter_preflight_ready == true
  and .execution_adapter_preflight_allowed == true
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_cutover_preflight_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .execution_adapter_kind == "mcp_tool_call_adapter" and .source_receipt_projection_route == "result_receipt_projection_required" and .registry_guard_route == "require_approval_ledger" and .adapter_preflight_route == "disabled_execution_adapter_preflight" and .execution_adapter_preflight_ready == true and .receipt_projection_ready == true and .result_receipt_required == true and .readback_evidence_required == true and .tool_invocation_execution_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .execution_adapter_kind == "app_connector_invocation_adapter" and .source_receipt_projection_route == "result_receipt_projection_required" and .registry_guard_route == "require_approval_ledger" and .adapter_preflight_route == "disabled_execution_adapter_preflight" and .execution_adapter_preflight_ready == true and .receipt_projection_ready == true and .result_receipt_required == true and .readback_evidence_required == true and .tool_invocation_execution_switch_enabled == false and .adapter_dispatch_switch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("execution_adapter_dispatch_disabled")) != null
  and (.next_actions | index("restore_tool_execution_cutover_preflight_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_execution_adapter_preflight --quiet
)

printf 'hepta-systems-tool-execution-adapter-preflight-gate: PASS: receipt-projected plugin tool paths are bound to disabled execution adapters while invocation and dispatch remain disabled\n'
