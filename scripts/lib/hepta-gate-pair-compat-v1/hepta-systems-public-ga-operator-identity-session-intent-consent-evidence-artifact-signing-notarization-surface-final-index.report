    next_migration_step: "attach_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_notarization_surface_final_index_to_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_receipt_no_persistence_without_signing",
