#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)}"
export HEPTA_REPO_ROOT="$ROOT"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan-v2.report"
NON_SEND_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-operator-packet-non-send-readback-v2.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_COLLECTION_PLAN_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-collection-plan-v2-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 5d v2 report: $REPORT"
[[ -x "$NON_SEND_GATE" ]] || fail "missing executable Phase 5c v2 non-send gate: $NON_SEND_GATE"
[[ -f "$DOC" ]] || fail "missing Phase 5d architecture note: $DOC"
command -v jq >/dev/null 2>&1 || fail "jq is required to validate the Phase 5d v2 report"

grep -q 'Controlled Live Required Evidence Collection Plan' "$DOC" || fail "architecture note must document the evidence collection plan"
grep -q 'without recording evidence' "$DOC" || fail "architecture note must document no evidence recording"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_required_evidence_collection_plan"
  and .status == "ready_blocked"
  and .schema_version == "controlled_live_required_evidence_collection_plan_v2"
  and .compatibility_migration == "clean_worktree_boundary_v2_propagation"
  and .source_denial_readback_index_ready == true
  and .source_non_send_readback_ready == true
  and .lib_export_present == true
  and .plan_entry_count == 7
  and .stable_blocker_slot_count == 7
  and .queryable_plan_count == 7
  and .operator_visible_plan_count == 7
  and .required_evidence_count == .active_blocker_count
  and .evidence_recorded_count == 0
  and .evidence_collection_plan_ready == true
  and .approval_acceptance_ready == false
  and .approval_accepted == false
  and .blocker_waived_count == 0
  and .credential_read_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persisted == false
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and ((.source_worktree_boundary_state == "clean"
      and .source_dirty_worktree_boundary_tracked == false
      and .source_blocker_count == 6
      and .active_blocker_count == 6
      and .satisfied_entry_count == 1
      and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .current_state == "satisfied" and .active_blocker == false and .evidence_required == false and .blocks_cutover == false))
    or (.source_worktree_boundary_state == "dirty"
      and .source_dirty_worktree_boundary_tracked == true
      and .source_blocker_count == 7
      and .active_blocker_count == 7
      and .satisfied_entry_count == 0
      and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .current_state == "missing" and .active_blocker == true and .evidence_required == true and .blocks_cutover == true)))
  and (.entries | length) == 7
  and (.entries | all(.queryable == true and .operator_visible == true and .evidence_recorded == false and .evidence_recording_allowed == false and .credential_read_allowed == false and .approval_acceptance_allowed == false and .blocker_waiver_allowed == false and .persistence_allowed == false and .live_mutation_allowed == false))
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$NON_SEND_GATE" >/dev/null

printf 'hepta-systems-controlled-live-required-evidence-collection-plan-v2-gate: PASS: six or seven active evidence requirements remain queryable without recording, credentials, approval, or live execution\n'
