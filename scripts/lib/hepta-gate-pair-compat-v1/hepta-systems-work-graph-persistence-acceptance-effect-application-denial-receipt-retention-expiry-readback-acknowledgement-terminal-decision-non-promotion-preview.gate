#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-acceptance-effect-application-denial-receipt-retention-expiry-readback-acknowledgement-terminal-decision-non-promotion-preview.report"

report="$(capture_json_report "hepta-work-graph-persistence-acceptance-effect-application-denial-receipt-retention-expiry-readback-acknowledgement-terminal-decision-non-promotion-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  def durable_fields: [
    "workflow_id",
    "run_id",
    "step_id",
    "checkpoint",
    "replay_key",
    "rollback_anchor",
    "receipt_hash"
  ];
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview_gate"
  and .schema_version == "work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview_v1"
  and .preview_mode == "read_only_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview_no_promotion"
  and .terminal_decision_surface_count == 6
  and (.terminal_decision_surfaces | length) == .terminal_decision_surface_count
  and (.terminal_decision_surfaces | map(.id) == [
    "operator_terminal_decision_visibility",
    "release_owner_terminal_decision_visibility",
    "auditor_terminal_decision_visibility",
    "rollback_owner_terminal_decision_visibility",
    "runtime_terminal_state_summary_visibility",
    "external_delivery_terminal_decision_echo"
  ])
  and (.terminal_decision_surfaces | all(
    .decision_recording_allowed == false
    and .promotion_allowed == false
    and .external_delivery_enabled == false
    and (.source_replay_scenario_ids | length) == 6
    and (.required_fields | length) >= 11
    and (.required_fields | index("workflow_id") != null)
    and (.required_fields | index("receipt_hash") != null)
  ))
  and .non_promotion_denial_count == 9
  and (.non_promotion_denials | length) == .non_promotion_denial_count
  and (.non_promotion_denials | map(.id) == [
    "durable_identity_evidence_missing",
    "terminal_decision_visibility_cannot_promote_persistence",
    "terminal_decision_visibility_cannot_grant_acceptance_authority",
    "release_owner_terminal_decision_cannot_publish_release",
    "operator_terminal_decision_cannot_start_rollout",
    "auditor_terminal_decision_cannot_record_approval",
    "rollback_owner_terminal_decision_cannot_mutate_quarantine",
    "external_delivery_terminal_decision_echo_cannot_send",
    "terminal_decision_summary_cannot_claim_live_completion"
  ])
  and (.non_promotion_denials | all(
    .blocks_persistence_promotion == true
    and .blocks_authority_grant == true
    and .blocks_rollout == true
    and .blocks_release_publication == true
    and .blocks_external_delivery == true
    and (.applies_to_surface_ids | length) == 6
  ))
  and .authority_guard_count == 6
  and (.authority_guards | length) == .authority_guard_count
  and (.authority_guards | all(
    .authority_grant_allowed == false
    and (.required_fields | length) >= 10
    and (.required_fields | index("workflow_id") != null)
    and (.required_fields | index("receipt_hash") != null)
  ))
  and .release_delivery_guard_count == 6
  and (.release_delivery_guards | length) == .release_delivery_guard_count
  and (.release_delivery_guards | all(
    .release_publication_allowed == false
    and .delivery_allowed == false
    and (.required_fields | length) >= 10
    and (.required_fields | index("workflow_id") != null)
    and (.required_fields | index("receipt_hash") != null)
  ))
  and .local_view_count == 4
  and (.local_views | length) == .local_view_count
  and (.local_views | all(
    .external_delivery_enabled == false
    and (.required_fields | length) >= 11
    and (.required_fields | index("workflow_id") != null)
    and (.required_fields | index("receipt_hash") != null)
  ))
  and .durable_identity_evidence.schema_version == "work_graph_durable_identity_preview_v1"
  and .durable_identity_evidence.required_prior_gate == "hepta_work_graph_durable_identity_preview_gate"
  and .durable_identity_evidence.required_field_ids == durable_fields
  and .durable_identity_evidence.required_for_terminal_decision_surface_ids == [
    "operator_terminal_decision_visibility",
    "release_owner_terminal_decision_visibility",
    "auditor_terminal_decision_visibility",
    "rollback_owner_terminal_decision_visibility",
    "runtime_terminal_state_summary_visibility",
    "external_delivery_terminal_decision_echo"
  ]
  and .durable_identity_evidence.durable_field_count == 7
  and .durable_identity_evidence.preview_binding_count == 5
  and .durable_identity_evidence.invariant_count == 7
  and .durable_identity_evidence.currently_satisfied == false
  and .invariant_count == 7
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "retention_readback_ack_terminal_decision_requires_durable_identity_evidence",
    "terminal_decision_visibility_is_not_promotion",
    "terminal_decision_visibility_is_not_authority",
    "terminal_decision_requires_replay_idempotency_gate",
    "terminal_decision_keeps_release_and_rollout_denied",
    "terminal_decision_views_are_local_only",
    "terminal_decision_preview_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and (.required_prior_gates[-2] == "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_replay_idempotency_preview_gate")
  and (.required_prior_gates[-1] == "hepta_work_graph_durable_identity_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_preview_gate"
  and .ready_for_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_preview == true
  and .ready_for_operator_acceptance == false
  and .ready_for_live_persistence == false
  and .source_probes.persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion.rust_module_present == true
  and .source_probes.persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion.report_script_present == true
  and .source_probes.persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion.gate_script_present == true
  and .source_probes.persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_replay_idempotency.rust_module_present == true
  and .source_probes.persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_replay_idempotency.gate_script_present == true
  and .source_probes.durable_identity.rust_module_present == true
  and .source_probes.durable_identity.report_script_present == true
  and .source_probes.durable_identity.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview --lib

echo "Hepta WorkGraph persistence acceptance effect application denial receipt retention expiry readback acknowledgement terminal decision non-promotion preview gate passed"
