#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-readback.report"
ATTACHMENT_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-cancellation-supersession-final-index-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_INTENT_CONSENT_EVIDENCE_ARTIFACT_SIGNING_TERMINAL_PUBLIC_CLAIM_DELIVERY_RECEIPT_AUDIT_EVIDENCE_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable audit evidence readback report: $REPORT"
[[ -x "$ATTACHMENT_GATE" ]] || fail "missing executable audit evidence attachment gate: $ATTACHMENT_GATE"
[[ -f "$DOC" ]] || fail "missing audit evidence readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the audit evidence readback report"
fi

grep -q 'Terminal Public Claim Delivery Receipt Audit Evidence Readback' "$DOC" \
  || fail "architecture note must document terminal public claim delivery receipt audit evidence readback"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that readback does not invoke target gates"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_readback"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_attachment_ready == true
  and .source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_attachment_blocked == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_readback_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_readback_blocked == true
  and .artifact_signing_terminal_public_claim_delivery_receipt_audit_evidence_denial_gate_invoked == false
  and .terminal_public_claim_delivery_receipt_audit_evidence_recorded == false
  and .terminal_public_claim_delivery_receipt_hash_chain_recorded == false
  and .terminal_public_claim_delivery_receipt_attestation_recorded == false
  and .terminal_public_claim_delivery_receipt_ledger_recorded == false
  and .operator_approval_from_delivery_receipt_audit_evidence_derived == false
  and .release_publication_authority_from_delivery_receipt_audit_evidence_derived == false
  and .activation_authority_from_delivery_receipt_audit_evidence_derived == false
  and .install_from_delivery_receipt_audit_evidence_executed == false
  and .active_binary_from_delivery_receipt_audit_evidence_mutated == false
  and .readback_check_count == 100
  and .public_ga_claim_allowed == false
  and .public_release_published == false
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$ATTACHMENT_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-audit-evidence-readback-gate: PASS: artifact signing terminal public claim delivery receipt audit evidence readback is ready but blocked\n'
