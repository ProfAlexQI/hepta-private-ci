#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

path_exists() {
  local path="$1"
  [[ -e "$path" ]]
}

bool_for() {
  if "$@"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

comparison_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_shadow_live_readback_comparison_preview.rs
)"
comparison_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-shadow-live-readback-comparison-preview.report
)"
comparison_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-shadow-live-readback-comparison-preview.gate
)"
promotion_blocker_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_persistence_promotion_blocker_preview.rs
)"
promotion_blocker_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-persistence-promotion-blocker-preview.gate
)"
durable_identity_rust_module_present="$(
  bool_for path_exists codex-rs/hepta-runtime/src/work_graph_durable_identity_preview.rs
)"
durable_identity_report_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report
)"
durable_identity_gate_script_present="$(
  bool_for path_exists scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.gate
)"

durable_identity_report="$(
  capture_json_report \
    "hepta-work-graph-durable-identity-preview-report" \
    "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report"
)"

jq -n \
  --argjson comparison_rust_module_present "$comparison_rust_module_present" \
  --argjson comparison_report_script_present "$comparison_report_script_present" \
  --argjson comparison_gate_script_present "$comparison_gate_script_present" \
  --argjson promotion_blocker_rust_module_present "$promotion_blocker_rust_module_present" \
  --argjson promotion_blocker_gate_script_present "$promotion_blocker_gate_script_present" \
  --argjson durable_identity_rust_module_present "$durable_identity_rust_module_present" \
  --argjson durable_identity_report_script_present "$durable_identity_report_script_present" \
  --argjson durable_identity_gate_script_present "$durable_identity_gate_script_present" \
  --argjson durable_identity_report "$durable_identity_report" \
  '
  def durable_fields: [
    "workflow_id",
    "run_id",
    "step_id",
    "checkpoint",
    "replay_key",
    "rollback_anchor",
    "receipt_hash"
  ];
  def readback_pair_ids: [
    "compare_node_shadow_to_future_live_digest",
    "compare_edge_shadow_to_future_live_digest",
    "compare_task_result_shadow_to_future_live_digest",
    "compare_artifact_shadow_to_future_live_digest",
    "compare_approval_shadow_to_future_live_digest",
    "compare_timeline_shadow_to_future_live_digest"
  ];
  def prior_gates: [
    "hepta_work_graph_contract_preview_gate",
    "hepta_work_graph_task_result_contract_preview_gate",
    "hepta_work_graph_scheduler_admission_controller_preview_gate",
    "hepta_work_graph_observability_timeline_preview_gate",
    "hepta_work_graph_role_manifest_contract_preview_gate",
    "hepta_work_graph_unified_state_store_preview_gate",
    "hepta_work_graph_adapter_projection_fixture_gate",
    "hepta_work_graph_state_store_persistence_preview_gate",
    "hepta_work_graph_replay_readback_preview_gate",
    "hepta_work_graph_promotion_precondition_preview_gate",
    "hepta_work_graph_activation_enforcement_blocker_preview_gate",
    "hepta_work_graph_shadow_adapter_readback_preview_gate",
    "hepta_work_graph_persistence_feature_flag_preview_gate",
    "hepta_work_graph_persistence_canary_dry_run_preview_gate",
    "hepta_work_graph_persistence_canary_readback_receipt_preview_gate",
    "hepta_work_graph_persistence_promotion_blocker_preview_gate",
    "hepta_work_graph_durable_identity_preview_gate"
  ];
  def surface($id; $collection; $shadow_probe; $live_probe): {
    id: $id,
    source_collection: $collection,
    shadow_probe_id: $shadow_probe,
    future_live_probe_id: $live_probe,
    comparison_mode: "hash_only_shadow_to_future_live_digest",
    live_read_enabled: false
  };
  def pair($id; $surface; $fields): {
    id: $id,
    surface_id: $surface,
    required_digest_fields: (durable_fields + $fields),
    tolerance: "exact_digest_match_required",
    blocks_promotion_on_mismatch: true
  };
  def classifier($id; $severity; $surfaces; $trigger): {
    id: $id,
    severity: $severity,
    applies_to_surface_ids: $surfaces,
    trigger: $trigger,
    quarantine_required: true
  };
  def denial($id; $classifiers; $message): {
    id: $id,
    applies_to_classifier_ids: $classifiers,
    operator_message: $message,
    blocks_promotion: true
  };
  def view($id; $audience; $fields): {
    id: $id,
    audience: $audience,
    required_fields: (durable_fields + $fields),
    external_delivery_enabled: false
  };
  def invariant($id; $reason): {
    id: $id,
    required: true,
    reason: $reason
  };
  [
    surface("work_graph_node_collection_comparison"; "nodes"; "shadow_nodes_readback_probe"; "future_live_nodes_readback_probe"),
    surface("work_graph_edge_collection_comparison"; "edges"; "shadow_edges_readback_probe"; "future_live_edges_readback_probe"),
    surface("work_graph_task_result_collection_comparison"; "task_results"; "shadow_task_results_readback_probe"; "future_live_task_results_readback_probe"),
    surface("work_graph_artifact_collection_comparison"; "artifacts"; "shadow_artifacts_readback_probe"; "future_live_artifacts_readback_probe"),
    surface("work_graph_approval_collection_comparison"; "approvals"; "shadow_approvals_readback_probe"; "future_live_approvals_readback_probe"),
    surface("work_graph_timeline_collection_comparison"; "timeline_events"; "shadow_timeline_readback_probe"; "future_live_timeline_readback_probe")
  ] as $comparison_surfaces
  | ($comparison_surfaces | map(.id)) as $surface_ids
  | [
    pair("compare_node_shadow_to_future_live_digest"; "work_graph_node_collection_comparison"; ["nodeId", "nodeKind", "statusHash", "versionHash"]),
    pair("compare_edge_shadow_to_future_live_digest"; "work_graph_edge_collection_comparison"; ["edgeId", "fromNodeHash", "toNodeHash", "dependencyKind"]),
    pair("compare_task_result_shadow_to_future_live_digest"; "work_graph_task_result_collection_comparison"; ["taskId", "terminalStatus", "summaryHash", "evidenceHash"]),
    pair("compare_artifact_shadow_to_future_live_digest"; "work_graph_artifact_collection_comparison"; ["artifactId", "producerNodeHash", "payloadHash", "redactionState"]),
    pair("compare_approval_shadow_to_future_live_digest"; "work_graph_approval_collection_comparison"; ["approvalId", "operatorScopeHash", "expiryHash", "recordingState"]),
    pair("compare_timeline_shadow_to_future_live_digest"; "work_graph_timeline_collection_comparison"; ["eventId", "spanHash", "operatorSummaryHash", "redactionState"])
  ] as $readback_pairs
  | [
    classifier("missing_shadow_digest"; "critical"; $surface_ids; "shadow digest packet is absent"),
    classifier("durable_identity_digest_missing"; "critical"; $surface_ids; "workflow, run, step, checkpoint, replay, rollback, or receipt identity digest is absent"),
    classifier("future_live_probe_not_authorized"; "critical"; $surface_ids; "future live probe lacks feature flag and operator packet"),
    classifier("schema_version_drift"; "high"; $surface_ids; "shadow schema version differs from future live schema version"),
    classifier("collection_count_drift"; "high"; $surface_ids; "shadow and future live collection counts differ"),
    classifier("redaction_state_drift"; "critical"; ["work_graph_artifact_collection_comparison", "work_graph_approval_collection_comparison", "work_graph_timeline_collection_comparison"]; "redaction state differs across compared digests"),
    classifier("operator_scope_drift"; "critical"; ["work_graph_approval_collection_comparison"]; "operator authority scope differs across compared approval digests")
  ] as $mismatch_classifiers
  | [
    denial("deny_missing_shadow_digest"; ["missing_shadow_digest"]; "shadow digest must exist before any live readback comparison or promotion"),
    denial("deny_durable_identity_digest_missing"; ["durable_identity_digest_missing"]; "durable identity digest must exist before shadow/live comparison or promotion"),
    denial("deny_future_live_probe_without_authorization"; ["future_live_probe_not_authorized"]; "future live probe cannot run without feature flag and operator enablement"),
    denial("deny_schema_version_drift"; ["schema_version_drift"]; "schema drift blocks persistence promotion"),
    denial("deny_collection_count_drift"; ["collection_count_drift"]; "collection count drift blocks persistence promotion"),
    denial("deny_redaction_state_drift"; ["redaction_state_drift"]; "redaction drift blocks release and external publication"),
    denial("deny_operator_scope_drift"; ["operator_scope_drift"]; "operator scope drift blocks approval recording and external delivery")
  ] as $promotion_denials
  | [
    view("operator_shadow_live_comparison_summary"; "operator"; ["surfaceIds", "readbackPairIds", "mismatchClassifierIds", "promotionDenied"]),
    view("auditor_mismatch_classifier_view"; "auditor"; ["classifierId", "severity", "surfaceId", "quarantineRequired"]),
    view("rollback_quarantine_preview_view"; "rollback_owner"; ["surfaceId", "classifierId", "killSwitchId", "quarantineScope"]),
    view("enforcement_rollout_blocker_view"; "system"; ["denialIds", "nextGate", "liveReadEnabled", "sideEffectHash"])
  ] as $operator_views
  | [
    invariant("shadow_live_comparison_requires_durable_identity_evidence"; "shadow/live comparison pairs require workflow, run, step, checkpoint, replay, rollback, and receipt evidence"),
    invariant("shadow_live_comparison_is_digest_only"; "comparison surfaces describe hash-only readback pairs and never expose payloads"),
    invariant("live_readback_is_disabled_in_preview"; "future live probe ids are declared, but no live readback can execute in this gate"),
    invariant("any_mismatch_blocks_promotion"; "all mismatch classifiers have promotion denial records before future execution"),
    invariant("redaction_and_scope_drift_are_critical"; "redaction and operator-scope mismatch must block release and approval recording"),
    invariant("operator_views_are_local_only"; "operator comparison views are local preview shapes and cannot be externally delivered"),
    invariant("shadow_live_readback_comparison_preview_has_no_side_effects"; "this gate cannot run readbacks, compare live state, enable enforcement, promote, or send externally")
  ] as $invariants
  | {
      product: "Hepta",
      runtime: "hepta",
      status: "ready",
      gate: "hepta_work_graph_persistence_shadow_live_readback_comparison_preview_gate",
      schema_version: "work_graph_persistence_shadow_live_readback_comparison_preview_v1",
      preview_mode: "read_only_persistence_shadow_live_readback_comparison_preview_no_live_read",
      comparison_surface_count: ($comparison_surfaces | length),
      readback_pair_count: ($readback_pairs | length),
      mismatch_classifier_count: ($mismatch_classifiers | length),
      promotion_denial_count: ($promotion_denials | length),
      operator_view_count: ($operator_views | length),
      invariant_count: ($invariants | length),
      required_prior_gates: prior_gates,
      comparison_surfaces: $comparison_surfaces,
      readback_pairs: $readback_pairs,
      mismatch_classifiers: $mismatch_classifiers,
      promotion_denials: $promotion_denials,
      operator_views: $operator_views,
      durable_identity_evidence: {
        schema_version: $durable_identity_report.schema_version,
        required_prior_gate: "hepta_work_graph_durable_identity_preview_gate",
        required_field_ids: durable_fields,
        required_for_readback_pair_ids: readback_pair_ids,
        durable_field_count: $durable_identity_report.durable_field_count,
        preview_binding_count: $durable_identity_report.preview_binding_count,
        invariant_count: $durable_identity_report.invariant_count,
        currently_satisfied: false
      },
      invariants: $invariants,
      recommended_next_gate: "hepta_work_graph_persistence_enforcement_rollout_blocker_preview_gate",
      ready_for_enforcement_rollout_blocker_preview: true,
      ready_for_live_readback: false,
      ready_for_live_persistence: false,
      source_probes: {
        persistence_shadow_live_readback_comparison: {
          rust_module_present: $comparison_rust_module_present,
          report_script_present: $comparison_report_script_present,
          gate_script_present: $comparison_gate_script_present
        },
        persistence_promotion_blocker: {
          rust_module_present: $promotion_blocker_rust_module_present,
          gate_script_present: $promotion_blocker_gate_script_present
        },
        durable_identity: {
          rust_module_present: $durable_identity_rust_module_present,
          report_script_present: $durable_identity_report_script_present,
          gate_script_present: $durable_identity_gate_script_present
        }
      },
      side_effects: {
        filesystem_written: false,
        graph_state_persisted: false,
        shadow_readback_executed: false,
        live_readback_executed: false,
        comparison_executed: false,
        promotion_performed: false,
        enforcement_enabled: false,
        feature_flag_mutated: false,
        wal_written: false,
        checkpoint_written: false,
        approval_recorded: false,
        external_send_performed: false,
        model_invoked: false
      }
    }'
