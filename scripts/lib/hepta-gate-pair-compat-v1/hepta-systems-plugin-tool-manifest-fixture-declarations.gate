#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-fixture-declarations.report"
PARSER_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-parser-fields.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_MANIFEST_FIXTURE_DECLARATIONS_2026-06-21.md"

fail() {
  printf 'hepta-systems-plugin-tool-manifest-fixture-declarations-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable plugin tool manifest fixture declarations report: $REPORT"
[[ -x "$PARSER_GATE" ]] || fail "missing executable plugin tool manifest parser fields gate: $PARSER_GATE"
[[ -f "$DOC" ]] || fail "missing plugin tool manifest fixture declarations architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the plugin tool manifest fixture declarations report"
fi

grep -q 'Manifest Fixture Declarations' "$DOC" \
  || fail "architecture note must document Manifest Fixture Declarations"
grep -q 'manifest fixture readback' "$DOC" \
  || fail "architecture note must document manifest fixture readback"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "plugin_tool_manifest_fixture_declarations"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_manifest_parser_fields_surface == "plugin_tool_manifest_parser_fields"
  and .source_manifest_parser_fields_ready == true
  and .hepta_system_manifest_present == true
  and .declaration_source == "hepta_system_manifest_fixture_readback"
  and .current_fixture_tool_schema_count == 2
  and .current_fixture_permission_count == 2
  and .current_fixture_activation_event_count == 2
  and .current_fixture_tool_policy_count == 2
  and .current_fixture_declared_candidate_count == 2
  and .current_fixture_schema_complete_count == 2
  and .current_fixture_policy_complete_count == 2
  and .current_fixture_registration_preconditions_satisfied == true
  and .manifest_fixture_declarations_ready == true
  and .registration_cutover_allowed == false
  and .registration_execution_enabled == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .mcp_server_started == false
  and .app_connector_started == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_registry_invocation_source_of_truth_without_execution"
  and (.entries | length) == 2
  and (.entries | all(.tool_schema_declared == true and .input_schema_declared == true and .output_schema_declared == true and .permission_policy_declared == true and .activation_policy_declared == true and .approval_policy_declared == true and .ledger_policy_declared == true and .timeout_policy_declared == true and .manifest_schema_complete == true and .manifest_policy_complete == true))
  and (.next_actions | index("restore_tool_registry_invocation_source_of_truth_without_execution")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$PARSER_GATE" >/dev/null

printf 'hepta-systems-plugin-tool-manifest-fixture-declarations-gate: PASS: manifest fixture declarations are read back without registration or execution\n'
