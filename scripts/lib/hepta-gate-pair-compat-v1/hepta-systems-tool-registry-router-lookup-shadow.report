#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-registration-lookup-cutover-preflight.report"
RUST_SOURCE="$ROOT/codex-rs/tools/src/tool_registry_router_lookup_shadow.rs"
GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-router-lookup-shadow.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_REGISTRY_ROUTER_LOOKUP_SHADOW_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-registry-router-lookup-shadow-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable registration lookup preflight report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing router lookup shadow Rust source: $RUST_SOURCE"
[[ -f "$DOC" ]] || fail "missing router lookup shadow architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the router lookup shadow report"
fi

jq -n \
  --slurpfile source <("$SOURCE_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-router-lookup-shadow.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TOOL_REGISTRY_ROUTER_LOOKUP_SHADOW_2026-06-21.md" \
  '
  def shadow_entry($entry):
    ($entry.lookup_cutover_route == "approval_ledger_lookup_dry_run" and $entry.lookup_precondition_satisfied == true) as $lookup_ready |
    ($entry.registry_guard_route == "require_approval_ledger") as $approval_guard |
    {
      plugin_id:$entry.plugin_id,
      candidate_tool_id:$entry.candidate_tool_id,
      contribution_kind:$entry.contribution_kind,
      lookup_cutover_route:$entry.lookup_cutover_route,
      registry_guard_route:$entry.registry_guard_route,
      shadow_route:(if ($lookup_ready and $approval_guard) then "disabled_approval_ledger_lookup_shadow" elif $lookup_ready then "blocked_by_lookup_guard" else "blocked_by_lookup_precondition" end),
      shadow_ready:($lookup_ready and $approval_guard),
      registration_lookup_cutover_switch_enabled:false,
      router_shadow_binding_present:true,
      router_registration_lookup_enabled:false,
      registry_lookup_executed:false,
      registry_source_of_truth_enabled:false,
      tool_registration_enabled:false,
      tool_invocation_enabled:false,
      ledger_write_enabled:false,
      approval_request_enabled:false,
      side_effect_free:true
    };

  ($source[0]) as $source |
  ($source.entries | map(shadow_entry(.))) as $entries |
  ($entries | map(select(.shadow_ready == true)) | length) as $ready_count |
  ($entries | map(select(.shadow_route == "disabled_approval_ledger_lookup_shadow")) | length) as $disabled_shadow_count |
  ($source.registration_lookup_cutover_preflight_ready
    and $source.router_registration_lookup_enabled == false
    and ($entries | all(.router_shadow_binding_present == true))
    and $ready_count == ($entries | length)
    and $disabled_shadow_count == ($entries | length)
    and ($entries | all(if .shadow_route == "disabled_approval_ledger_lookup_shadow" then (.registry_guard_route == "require_approval_ledger" and .registration_lookup_cutover_switch_enabled == false and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end))) as $shadow_ready |
  {
    runtime:"hepta",
    surface:"tool_registry_router_lookup_shadow",
    plugin_id:$source.plugin_id,
    status:(if $shadow_ready then "ready" else "blocked" end),
    source_registration_lookup_preflight_surface:$source.surface,
    source_registration_lookup_preflight_ready:$source.registration_lookup_cutover_preflight_ready,
    registration_lookup_cutover_switch_enabled:false,
    router_shadow_binding_present:true,
    candidate_count:($entries | length),
    shadow_ready_count:$ready_count,
    shadow_blocked_count:(($entries | length) - $ready_count),
    disabled_lookup_shadow_count:$disabled_shadow_count,
    all_lookup_preflight_entries_shadowed:($ready_count == ($entries | length) and $disabled_shadow_count == ($entries | length) and ($entries | all(.router_shadow_binding_present == true))),
    all_shadow_entries_keep_approval_ledger_guard:($entries | all(if .shadow_route == "disabled_approval_ledger_lookup_shadow" then (.registry_guard_route == "require_approval_ledger" and .registration_lookup_cutover_switch_enabled == false and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end)),
    router_lookup_shadow_ready:$shadow_ready,
    router_registration_lookup_enabled:false,
    registry_lookup_executed:false,
    registry_source_of_truth_enabled:false,
    tool_registration_enabled:false,
    tool_invocation_enabled:false,
    ledger_written:false,
    approval_requested:false,
    live_mutation_ready:false,
    next_migration_step:"restore_tool_invocation_receipt_projection_without_execution",
    entries:$entries,
    blockers:[
      "registration_lookup_cutover_switch_disabled",
      "router_registration_lookup_disabled",
      "registry_lookup_execution_disabled",
      "registry_source_of_truth_enablement_disabled",
      "tool_registration_disabled",
      "tool_invocation_disabled",
      "ledger_write_disabled",
      "approval_request_disabled"
    ],
    next_actions:[
      "restore_tool_invocation_receipt_projection_without_execution",
      "keep_router_lookup_shadow_read_only_until_receipt_projection_is_restored",
      "keep_lookup_registration_invocation_ledger_and_approval_disabled_until_explicit_cutover"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      rust_contract:"codex-rs/tools/src/tool_registry_router_lookup_shadow.rs",
      registration_lookup_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-registry-registration-lookup-cutover-preflight.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      plugin_cache_mutated:false,
      plugin_installed:false,
      manifest_rewritten:false,
      manifest_schema_written:false,
      registry_source_of_truth_enabled:false,
      router_registration_lookup_enabled:false,
      registry_lookup_executed:false,
      registration_cutover_executed:false,
      tool_registered:false,
      tool_invoked:false,
      tool_ledger_written:false,
      approval_requested:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      local_storage_created:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
