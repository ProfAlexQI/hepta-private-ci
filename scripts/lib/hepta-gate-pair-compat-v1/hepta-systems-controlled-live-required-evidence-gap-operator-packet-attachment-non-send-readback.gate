#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-non-send-readback.report"
OPERATOR_PACKET_ATTACHMENT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_GAP_OPERATOR_PACKET_ATTACHMENT_NON_SEND_READBACK_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-non-send-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 5j report: $REPORT"
[[ -x "$OPERATOR_PACKET_ATTACHMENT_REPORT" ]] || fail "missing executable Phase 5i operator packet attachment report: $OPERATOR_PACKET_ATTACHMENT_REPORT"
[[ -f "$DOC" ]] || fail "missing Phase 5j architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 5j operator packet attachment non-send readback report"
fi

grep -q 'Controlled Live Required Evidence Gap Operator Packet Attachment Non-Send Readback' "$DOC" \
  || fail "architecture note must document Controlled Live Required Evidence Gap Operator Packet Attachment Non-Send Readback"
grep -q 'operator packet attachment non-send readback without accepting evidence' "$DOC" \
  || fail "architecture note must document packet attachment non-send readback without acceptance"
grep -q 'no approval request, approval acceptance, approval recording, evidence recording, evidence persistence, blocker waiver, credential read, packet send, attachment send, packet persistence, attachment persistence, readback persistence, ledger write, event-log write, SQLite write, Native POST mutation, Telegram transport mutation, gateway/auth mutation, channel send, replay, rollback, package, release, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed operator packet attachment non-send boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_required_evidence_gap_operator_packet_attachment_non_send_readback"
  and .status == "ready_blocked"
  and .gate == "controlled_live_required_evidence_gap_operator_packet_attachment_non_send_readback_gate"
  and .schema_version == "controlled_live_required_evidence_gap_operator_packet_attachment_non_send_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_operator_packet_attachment_ready == true
  and .source_attachment_id == "controlled-live-required-evidence-gap-operator-packet-attachment"
  and .source_attachment_key == "controlled_live.required_evidence.gap.operator_packet_attachment"
  and .source_attached_packet_id == "controlled-live-operator-packet-preview"
  and .source_attached_payload_hash == "sha256:controlled-live-operator-packet-preview-no-live-payload"
  and .source_attachment_entry_count == 7
  and .source_unchanged_missing_attachment_count == 7
  and .lib_export_present == true
  and .readback_entry_count == 7
  and .readback_ready_count == 7
  and .unchanged_missing_readback_count == 7
  and .attachment_visible_to_operator == true
  and .attachment_send_attempted == false
  and .packet_send_attempted == false
  and .approval_request_ready == false
  and .approval_request_sent == false
  and .approval_acceptance_ready == false
  and .approval_accepted == false
  and .approval_recorded == false
  and .packet_persisted == false
  and .attachment_persisted == false
  and .readback_persisted == false
  and .evidence_recorded_count == 0
  and .blocker_waived_count == 0
  and .credential_read_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persisted == false
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and .non_send_readback_ready == true
  and (.entries | length) == 7
  and (.entries | all(.operator_visible == true and .attachment_visible == true and .non_send_confirmed == true and .packet_send_blocked == true and .attachment_send_blocked == true and .approval_request_blocked == true and .persistence_blocked == true and .packet_id == "controlled-live-operator-packet-preview" and .packet_payload_hash == "sha256:controlled-live-operator-packet-preview-no-live-payload" and .operator_status == "blocked_missing_evidence" and .observed_state == "attachment_visible_unsent_unpersisted" and .previous_state == "missing" and .current_state == "missing" and .state_delta == "unchanged_missing" and (.attachment_key | length) > 0 and (.attachment_route | length) > 0 and (.non_send_readback_key | length) > 0 and (.non_send_readback_route | length) > 0 and .evidence_recorded == false and .approval_request_allowed == false and .approval_acceptance_allowed == false and .blocker_waiver_allowed == false and .credential_read_allowed == false and .evidence_recording_allowed == false and .packet_persistence_allowed == false and .attachment_persistence_allowed == false and .readback_persistence_allowed == false and .live_mutation_allowed == false))
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/dirty-worktree-boundary")
  and any(.entries[]; .source_blocker_id == "operator_live_approval_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/operator-live-approval-missing")
  and any(.entries[]; .source_blocker_id == "fresh_soak_readback_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/fresh-soak-readback-missing")
  and any(.entries[]; .source_blocker_id == "credential_boundary_attestation_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/credential-boundary-attestation-missing")
  and any(.entries[]; .source_blocker_id == "gateway_native_telegram_post_boundary_approval_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/gateway-native-telegram-post-boundary-approval-missing")
  and any(.entries[]; .source_blocker_id == "rollback_rehearsal_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/rollback-rehearsal-missing")
  and any(.entries[]; .source_blocker_id == "kill_switch_rehearsal_missing" and .non_send_readback_route == "readback://controlled-live/operator-packet/attachment/non-send/kill-switch-rehearsal-missing")
  and (.next_actions | index("phase5k_controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback_without_acceptance")) != null
  and .next_migration_step == "phase5k_controlled_live_required_evidence_gap_operator_packet_attachment_transport_boundary_readback_without_acceptance"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$OPERATOR_PACKET_ATTACHMENT_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_required_evidence_gap_operator_packet_attachment"
  and .status == "ready_blocked"
  and .operator_packet_attachment_ready == true
  and .attachment_entry_count == 7
  and .unchanged_missing_attachment_count == 7
  and .evidence_recorded_count == 0
  and .approval_request_sent == false
  and .approval_accepted == false
  and .packet_persisted == false
  and .attachment_persisted == false
  and .readback_persisted == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime controlled_live_required_evidence_gap_operator_packet_attachment_non_send_readback --lib
)

printf 'hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-non-send-readback-gate: PASS: operator packet attachment is visible, unsent, unpersisted, and not an approval request\n'
