#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback.report"
PREFLIGHT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-preflight-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_SHADOW_WRITE_REHEARSAL_READBACK_2026-07-07.md"

fail() {
  printf 'hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable receipt store shadow write rehearsal report: $REPORT"
[[ -x "$PREFLIGHT_REPORT" ]] || fail "missing executable receipt store preflight report: $PREFLIGHT_REPORT"
[[ -f "$DOC" ]] || fail "missing architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the controlled-live evidence receipt store shadow write rehearsal report"
fi

grep -q 'Controlled Live Evidence Receipt Store Shadow Write Rehearsal Readback' "$DOC" \
  || fail "architecture note must document Controlled Live Evidence Receipt Store Shadow Write Rehearsal Readback"
grep -q 'controlled live evidence receipt store shadow write rehearsal readback without persistence' "$DOC" \
  || fail "architecture note must document shadow write rehearsal without persistence"
grep -q 'no receipt store write, receipt persistence, approval request, approval acceptance, approval recording, evidence recording, evidence persistence, blocker waiver, credential read, packet send, attachment send, packet persistence, attachment persistence, readback persistence, ledger write, event-log write, SQLite write, Native POST mutation, Telegram transport mutation, gateway/auth mutation, channel send, provider call, model call, replay, rollback, kill-switch rehearsal execution, kill-switch mutation, package, release, Public GA promotion, or live execution' "$DOC" \
  || fail "architecture note must document the closed shadow write rehearsal boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback"
  and .status == "ready_blocked"
  and .gate == "controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback_gate"
  and .schema_version == "controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_receipt_store_preflight_ready == true
  and .source_store_preflight_entry_count == 7
  and .source_missing_evidence_entry_count == 7
  and .source_store_root == ".hepta/controlled-live/evidence-receipts/status-canary"
  and .source_packet_id == "controlled-live-operator-packet-preview"
  and .source_packet_payload_hash == "sha256:controlled-live-operator-packet-preview-no-live-payload"
  and .lib_export_present == true
  and .shadow_write_rehearsal_entry_count == 7
  and .shadow_write_rehearsal_ready_count == 7
  and .in_memory_shadow_receipt_rendered_count == 7
  and .append_only_sequence_projected_count == 7
  and .readback_query_bound_count == 7
  and .idempotency_dedup_projected_count == 7
  and .redacted_payload_projected_count == 7
  and .secret_payload_denial_confirmed_count == 7
  and .persistence_denial_confirmed_count == 7
  and .ledger_denial_confirmed_count == 7
  and .workflow_event_log_denial_confirmed_count == 7
  and .sqlite_denial_confirmed_count == 7
  and .live_denial_confirmed_count == 7
  and .evidence_recorded_count == 0
  and .blocker_waived_count == 0
  and .in_memory_shadow_write_rehearsal_ready == true
  and .in_memory_shadow_receipts_rendered == true
  and .approval_request_allowed == false
  and .approval_acceptance_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persisted == false
  and .receipt_persistence_allowed == false
  and .receipt_persisted == false
  and .receipt_store_write_allowed == false
  and .receipt_store_written == false
  and .ledger_write_allowed == false
  and .workflow_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .credential_read_allowed == false
  and .live_execution_allowed == false
  and (.blockers | index("evidence_missing")) != null
  and (.blockers | index("in_memory_rehearsal_only")) != null
  and (.blockers | index("store_write_disabled")) != null
  and (.blockers | index("receipt_persistence_disabled")) != null
  and (.blockers | index("approval_request_disabled")) != null
  and (.blockers | index("approval_acceptance_disabled")) != null
  and (.blockers | index("ledger_write_disabled")) != null
  and (.blockers | index("workflow_event_log_write_disabled")) != null
  and (.blockers | index("sqlite_write_disabled")) != null
  and (.blockers | index("live_execution_disabled")) != null
  and (.entries | length) == 7
  and (.entries | all(.packet_id == "controlled-live-operator-packet-preview" and .packet_payload_hash == "sha256:controlled-live-operator-packet-preview-no-live-payload" and (.receipt_path | startswith(".hepta/controlled-live/evidence-receipts/status-canary/")) and (.receipt_id | startswith("controlled-live-evidence-receipt-preflight:")) and .receipt_schema_version == "controlled_live_evidence_receipt_v1" and (.idempotency_key | startswith("controlled-live-evidence-receipt-preflight:idempotency:")) and (.readback_query_route | startswith("readback://controlled-live/evidence-receipt-store/preflight/")) and (.shadow_write_key | startswith("controlled_live.evidence_receipt_store.shadow_write_rehearsal.")) and (.shadow_write_route | startswith("readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/")) and (.shadow_receipt_id | startswith("shadow:controlled-live-evidence-receipt-preflight:")) and (.shadow_receipt_payload_fingerprint | startswith("sha256:controlled-live-evidence-receipt-shadow:")) and (.shadow_receipt_payload_fingerprint | endswith(":metadata-only")) and (.shadow_receipt_payload_fingerprint | contains("secret") | not) and (.append_only_sequence_key | startswith("shadow-sequence:")) and .previous_receipt_head == "absent" and (.projected_receipt_head | startswith("metadata-only-shadow-head:")) and .operator_status == "blocked_missing_evidence" and .observed_state == "in_memory_shadow_receipt_rehearsed_no_persistence" and .previous_state == "missing" and .current_state == "missing" and .state_delta == "unchanged_missing" and .redaction_policy == "metadata_only_no_secret_payload" and .secret_payload_state == "denied" and .shadow_payload_state == "metadata_shape_rendered_in_memory" and .readback_projection_state == "query_matches_projected_shadow_receipt" and .preflight_confirmed == true and .missing_evidence_confirmed == true and .in_memory_shadow_receipt_rendered == true and .append_only_sequence_projected == true and .readback_query_bound == true and .idempotency_dedup_projected == true and .redacted_payload_projected == true and .secret_payload_denied == true and .persistence_denied == true and .ledger_denied == true and .workflow_event_log_denied == true and .sqlite_denied == true and .live_denied == true and .approval_request_allowed == false and .approval_acceptance_allowed == false and .evidence_recording_allowed == false and .evidence_recorded == false and .blocker_waiver_allowed == false and .receipt_persistence_allowed == false and .receipt_persisted == false and .receipt_store_write_allowed == false and .receipt_store_written == false and .ledger_write_allowed == false and .workflow_event_log_write_allowed == false and .sqlite_write_allowed == false and .credential_read_allowed == false and .live_mutation_allowed == false))
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/dirty-worktree-boundary" and .append_only_sequence_key == "shadow-sequence:dirty_worktree_boundary:00000001")
  and any(.entries[]; .source_blocker_id == "operator_live_approval_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/operator-live-approval-missing" and .append_only_sequence_key == "shadow-sequence:operator_live_approval_missing:00000001")
  and any(.entries[]; .source_blocker_id == "fresh_soak_readback_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/fresh-soak-readback-missing" and .append_only_sequence_key == "shadow-sequence:fresh_soak_readback_missing:00000001")
  and any(.entries[]; .source_blocker_id == "credential_boundary_attestation_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/credential-boundary-attestation-missing" and .append_only_sequence_key == "shadow-sequence:credential_boundary_attestation_missing:00000001")
  and any(.entries[]; .source_blocker_id == "gateway_native_telegram_post_boundary_approval_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/gateway-native-telegram-post-boundary-approval-missing" and .append_only_sequence_key == "shadow-sequence:gateway_native_telegram_post_boundary_approval_missing:00000001")
  and any(.entries[]; .source_blocker_id == "rollback_rehearsal_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/rollback-rehearsal-missing" and .append_only_sequence_key == "shadow-sequence:rollback_rehearsal_missing:00000001")
  and any(.entries[]; .source_blocker_id == "kill_switch_rehearsal_missing" and .shadow_write_route == "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/kill-switch-rehearsal-missing" and .append_only_sequence_key == "shadow-sequence:kill_switch_rehearsal_missing:00000001")
  and (.next_actions | index("controlled_live_evidence_receipt_store_persistence_open_preconditions_readback")) != null
  and .next_migration_step == "controlled_live_evidence_receipt_store_persistence_open_preconditions_readback"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$PREFLIGHT_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_evidence_receipt_store_preflight_readback"
  and .status == "ready_blocked"
  and .receipt_store_preflight_ready == true
  and .store_preflight_entry_count == 7
  and .store_preflight_ready_count == 7
  and .missing_evidence_entry_count == 7
  and .receipt_store_write_allowed == false
  and .receipt_store_written == false
  and .receipt_persistence_allowed == false
  and .receipt_persisted == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback --lib
)

printf 'hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback-gate: PASS: in-memory receipt shadow write rehearsal is query-bound and closed without persistence\n'
