#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)}"
export HEPTA_REPO_ROOT="$ROOT"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-readback-index-v2.report"
PLAN_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-collection-plan-v2.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_REQUIRED_EVIDENCE_READBACK_INDEX_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-live-required-evidence-readback-index-v2-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 5e v2 report: $REPORT"
[[ -x "$PLAN_GATE" ]] || fail "missing executable Phase 5d v2 plan gate: $PLAN_GATE"
[[ -f "$DOC" ]] || fail "missing Phase 5e architecture note: $DOC"
command -v jq >/dev/null 2>&1 || fail "jq is required to validate the Phase 5e v2 report"

grep -q 'Controlled Live Required Evidence Readback Index' "$DOC" || fail "architecture note must document the evidence readback index"
grep -q 'queryable and diffable without recording evidence' "$DOC" || fail "architecture note must document queryable diffable no-recording behavior"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_required_evidence_readback_index"
  and .status == "ready_blocked"
  and .schema_version == "controlled_live_required_evidence_readback_index_v2"
  and .compatibility_migration == "clean_worktree_boundary_v2_propagation"
  and .source_evidence_collection_plan_ready == true
  and .source_plan_entry_count == 7
  and .lib_export_present == true
  and .index_entry_count == 7
  and .stable_blocker_slot_count == 7
  and .queryable_entry_count == 7
  and .operator_visible_entry_count == 7
  and .diffable_entry_count == 7
  and .fingerprint_count == 7
  and .evidence_recorded_count == 0
  and .missing_evidence_count == .active_blocker_count
  and .readback_index_ready == true
  and .approval_acceptance_ready == false
  and .approval_accepted == false
  and .blocker_waived_count == 0
  and .credential_read_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persisted == false
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and ((.source_worktree_boundary_state == "clean"
      and .source_dirty_worktree_boundary_tracked == false
      and .source_blocker_count == 6
      and .source_active_blocker_count == 6
      and .active_blocker_count == 6
      and .missing_evidence_count == 6
      and .satisfied_entry_count == 1
      and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .evidence_state == "satisfied" and .active_blocker == false and .evidence_required == false and .blocks_cutover == false))
    or (.source_worktree_boundary_state == "dirty"
      and .source_dirty_worktree_boundary_tracked == true
      and .source_blocker_count == 7
      and .source_active_blocker_count == 7
      and .active_blocker_count == 7
      and .missing_evidence_count == 7
      and .satisfied_entry_count == 0
      and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .evidence_state == "missing" and .active_blocker == true and .evidence_required == true and .blocks_cutover == true)))
  and (.entries | length) == 7
  and (.entries | all(.queryable == true and .operator_visible == true and .diffable == true and (.fingerprint | length) > 0 and .evidence_recorded == false and .evidence_recording_allowed == false and .credential_read_allowed == false and .approval_acceptance_allowed == false and .blocker_waiver_allowed == false and .persistence_allowed == false and .live_mutation_allowed == false))
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$PLAN_GATE" >/dev/null

printf 'hepta-systems-controlled-live-required-evidence-readback-index-v2-gate: PASS: seven stable evidence slots expose six or seven missing blockers without recording, approval, or live execution\n'
