#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

path_exists() { [[ -e "$1" ]]; }
bool_for() {
  if "$@"; then printf 'true\n'; else printf 'false\n'; fi
}

prior_report_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-terminal-decision-preview.report"
prior_gate_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-terminal-decision-preview.gate"
prior_report="$("$ROOT/$prior_report_script")"
GATE="$(jq -r '.recommended_next_gate' <<<"$prior_report")"
BASE="${GATE%_receipt_preview_gate}"
SCHEMA="${GATE#hepta_}"
SCHEMA="${SCHEMA%_gate}_v1"
NEXT="${BASE}_receipt_acknowledgement_preview_gate"
required_prior_gates="$(jq -c '.required_prior_gates + [.gate]' <<<"$prior_report")"

rust_module="codex-rs/hepta-runtime/src/wg_deep_td8_terminal_decision_receipt_preview.rs"
report_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-terminal-decision-receipt-preview.report"
gate_script="scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-deep-td8-terminal-decision-receipt-preview.gate"

jq -n \
  --arg gate "$GATE" \
  --arg schema "$SCHEMA" \
  --arg next "$NEXT" \
  --argjson required_prior_gates "$required_prior_gates" \
  --argjson rust_module_present "$(bool_for path_exists "$rust_module")" \
  --argjson report_script_present "$(bool_for path_exists "$report_script")" \
  --argjson gate_script_present "$(bool_for path_exists "$gate_script")" \
  --argjson prior_report_script_present "$(bool_for path_exists "$prior_report_script")" \
  --argjson prior_gate_script_present "$(bool_for path_exists "$prior_gate_script")" \
  '
  def surface_ids: [range(0; 6) | "deep_td8_terminal_decision_surface_\(.)"];
  def receipt_ids: [range(0; 6) | "deep_td8_terminal_decision_receipt_\(.)"];
  def receipt($i): {
    id: "deep_td8_terminal_decision_receipt_\($i)",
    source_surface_ids: surface_ids,
    receipt_visibility: "hash_only_deep_td8_terminal_decision_receipt",
    receipt_recording_allowed: false,
    acceptance_allowed: false,
    authority_grant_allowed: false,
    public_claim_enabled: false,
    external_delivery_enabled: false
  };
  def digest_check($i): {
    id: "deep_td8_terminal_decision_receipt_digest_check_\($i)",
    required_fields: ["receiptId", "receiptHash", "sourceGateDigest"],
    digest_must_match: true
  };
  def mismatch_denial($i): {
    id: "deep_td8_terminal_decision_receipt_mismatch_denial_\($i)",
    applies_to_receipt_ids: receipt_ids,
    reason: "deep td8 terminal decision receipt mismatch cannot mutate state",
    blocks_receipt_recording: true,
    blocks_acceptance: true,
    blocks_authority: true,
    blocks_rollout: true,
    blocks_release_publication: true,
    blocks_public_claim: true,
    blocks_external_delivery: true
  };
  def receipt_guard($i): {
    id: "deep_td8_terminal_decision_receipt_guard_\($i)",
    required_fields: ["sourceGateDigest", "receiptHash", "zeroEffectHash"],
    recording_allowed: false,
    persistence_allowed: false
  };
  def local_view($i): {
    id: "deep_td8_terminal_decision_receipt_local_view_\($i)",
    audience: (["operator", "release_owner", "auditor", "system"][$i]),
    required_fields: ["receiptId", "receiptHash", "terminalDecisionHash", "nextGate"],
    external_delivery_enabled: false
  };
  def invariant($i): {
    id: "deep_td8_terminal_decision_receipt_invariant_\($i)",
    required: true,
    reason: "deep td8 terminal decision receipt is hash-only and zero-effect"
  };
  {
    product: "Hepta",
    runtime: "hepta",
    status: "ready",
    gate: $gate,
    schema_version: $schema,
    preview_mode: "read_only_deep_td8_terminal_decision_receipt_preview_hash_only_no_recording",
    receipt_count: 6,
    digest_check_count: 6,
    mismatch_denial_count: 7,
    receipt_guard_count: 5,
    local_view_count: 4,
    invariant_count: 6,
    required_prior_gates: $required_prior_gates,
    receipts: [range(0; 6) | receipt(.)],
    digest_checks: [range(0; 6) | digest_check(.)],
    mismatch_denials: [range(0; 7) | mismatch_denial(.)],
    receipt_guards: [range(0; 5) | receipt_guard(.)],
    local_views: [range(0; 4) | local_view(.)],
    invariants: [range(0; 6) | invariant(.)],
    recommended_next_gate: $next,
    ready_for_terminal_decision_receipt_acknowledgement_preview: true,
    ready_for_operator_acceptance: false,
    ready_for_live_persistence: false,
    side_effects: {
      filesystem_written: false,
      graph_state_persisted: false,
      terminal_decision_recorded: false,
      terminal_decision_receipt_recorded: false,
      terminal_decision_receipt_persisted: false,
      acknowledgement_recorded: false,
      operator_acceptance_recorded: false,
      approval_recorded: false,
      authority_granted: false,
      live_persistence_enabled: false,
      wal_written: false,
      checkpoint_written: false,
      rollout_started: false,
      release_published: false,
      public_claim_recorded: false,
      external_send_performed: false,
      model_invoked: false
    },
    source_probes: {
      deep_td8_terminal_decision_receipt: {
        rust_module_present: $rust_module_present,
        report_script_present: $report_script_present,
        gate_script_present: $gate_script_present
      },
      prior_deep_td8_terminal_decision: {
        report_script_present: $prior_report_script_present,
        gate_script_present: $prior_gate_script_present
      }
    }
  }
'
