#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.report"
CANONICAL_GATE="$ROOT/scripts/hepta-systems-canonical-gate.sh"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_THIN_WRAPPER_CREATION_2026-06-21.md"

fail() {
  printf 'hepta-systems-historical-canonical-gate-thin-wrapper-creation-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable historical canonical gate thin wrapper creation report: $REPORT"
[[ -x "$CANONICAL_GATE" ]] || fail "missing executable historical canonical gate thin wrapper: $CANONICAL_GATE"
[[ -f "$DOC" ]] || fail "missing historical canonical gate thin wrapper creation architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the historical canonical gate thin wrapper creation report"
fi

grep -q 'Thin Wrapper Creation' "$DOC" \
  || fail "architecture note must document Thin Wrapper Creation"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that creation does not invoke the wrapper target"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "historical_canonical_gate_thin_wrapper_creation"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_post_claim_impact_surface == "historical_canonical_gate_post_claim_impact_preflight"
  and .source_post_claim_impact_ready == true
  and .source_snapshot_decoupling_complete == true
  and .source_live_absence_probe_consumer_count == 0
  and .source_blocking_consumer_count == 0
  and .source_creation_allowed_now == true
  and .historical_canonical_gate_path == "scripts/hepta-systems-canonical-gate.sh"
  and .historical_canonical_gate_created == true
  and .historical_canonical_gate_executable == true
  and .historical_canonical_gate_wrapper_kind == "thin_local_exec_wrapper"
  and .historical_canonical_gate_wrapper_target == "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
  and .historical_canonical_gate_wrapper_exec_count == 1
  and .wrapper_body_emitted_by_report == false
  and .wrapper_target_invoked == false
  and .canonical_gate_invoked == false
  and .capability_matrix_gate_invoked == false
  and .terminal_live_gate_invoked == false
  and .live_url_required == false
  and .long_soak_required == false
  and .execution_enabled_count == 0
  and .public_ga_enabled_count == 0
  and .manual_operator_live_cutover_approval_required == true
  and .tool_execution_live_cutover_allowed == false
  and .tool_execution_public_ga_allowed == false
  and .historical_canonical_gate_thin_wrapper_creation_ready == true
  and .next_migration_step == "validate_historical_canonical_gate_thin_wrapper_without_live_invocation"
  and (.creation_blockers | index("wrapper_target_not_invoked_by_creation_report")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

printf 'hepta-systems-historical-canonical-gate-thin-wrapper-creation-gate: PASS: historical canonical gate thin wrapper exists without live invocation\n'
