#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-audit-evidence-final-index.report"
READBACK_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-audit-evidence-readback.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_OPERATOR_IDENTITY_SESSION_AUDIT_EVIDENCE_FINAL_INDEX_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-operator-identity-session-audit-evidence-final-index-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Public GA operator identity/session audit evidence final index report: $REPORT"
[[ -x "$READBACK_GATE" ]] || fail "missing executable Public GA operator identity/session audit evidence readback gate: $READBACK_GATE"
[[ -f "$DOC" ]] || fail "missing Public GA operator identity/session audit evidence final index architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Public GA operator identity/session audit evidence final index report"
fi

grep -q 'Public GA Operator Identity/Session Audit Evidence Final Index' "$DOC" \
  || fail "architecture note must document Public GA Operator Identity/Session Audit Evidence Final Index"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that final index does not invoke audit/evidence gates"
grep -q 'canonical terminal closure backfeed' "$DOC" \
  || fail "architecture note must document canonical terminal closure backfeed"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_operator_identity_session_audit_evidence_final_index"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_operator_identity_session_audit_evidence_readback_surface == "public_ga_operator_identity_session_audit_evidence_readback"
  and .source_public_ga_operator_identity_session_audit_evidence_readback_ready == true
  and .source_public_ga_operator_identity_session_audit_evidence_readback_blocked == true
  and .public_ga_operator_identity_session_audit_evidence_final_index_ready == true
  and .public_ga_operator_identity_session_audit_evidence_final_index_blocked == true
  and .public_ga_operator_identity_session_audit_evidence_readback_attached == true
  and .public_ga_operator_identity_session_reinstatement_cancellation_final_index_attached == true
  and .source_canonical_governance_tool_execution_closure_backfeed_ready == true
  and .source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
  and any(.source_canonical_governance_tool_execution_closure_backfeed_categories[]; .id == "runner_selector" and .blocker_count == 2)
  and any(.source_canonical_governance_tool_execution_closure_backfeed_categories[]; .id == "dirty_worktree_owner_freeze" and .blocker_count == 2)
  and .operator_identity_session_reinstatement_audit_evidence_denial_gate_present == true
  and .operator_identity_session_reinstatement_audit_evidence_denial_doc_present == true
  and .operator_identity_session_reinstatement_audit_evidence_denial_gate_invoked == false
  and .operator_identity_session_reinstatement_cancellation_supersession_denial_gate_invoked == false
  and .long_soak_required_by_source_audit_gate == true
  and .long_soak_started == false
  and .audit_trail_recorded == false
  and .audit_trail_persisted == false
  and .immutable_evidence_recorded == false
  and .immutable_evidence_persisted == false
  and .hash_chain_recorded == false
  and .merkle_root_recorded == false
  and .attestation_recorded == false
  and .witness_recorded == false
  and .notary_recorded == false
  and .ledger_evidence_recorded == false
  and .readback_evidence_recorded == false
  and .audit_evidence_acceptance_recorded == false
  and .result_receipt_from_audit_evidence_recorded == false
  and .audit_evidence_authority_derived == false
  and .final_blocker_count == 36
  and .manual_operator_live_cutover_approval_required == true
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_ga_claimed == false
  and .public_release_published == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "attach_public_ga_operator_identity_session_audit_evidence_final_index_to_public_ga_operator_identity_session_retention_expiry_gc_without_evidence"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$READBACK_GATE" >/dev/null

printf 'hepta-systems-public-ga-operator-identity-session-audit-evidence-final-index-gate: PASS: Public GA operator identity/session audit evidence final index is ready but blocked\n'
