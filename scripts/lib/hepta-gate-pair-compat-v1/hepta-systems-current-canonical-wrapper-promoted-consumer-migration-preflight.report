#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
WRAPPER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.report"
CURRENT_CONSUMER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CURRENT_CANONICAL_WRAPPER_PROMOTED_CONSUMER_MIGRATION_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-current-canonical-wrapper-promoted-consumer-migration-preflight-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$WRAPPER_REPORT" ]] || fail "missing executable current canonical wrapper report: $WRAPPER_REPORT"
[[ -x "$CURRENT_CONSUMER_REPORT" ]] || fail "missing executable current canonical consumer report: $CURRENT_CONSUMER_REPORT"
[[ -f "$DOC" ]] || fail "missing promoted consumer migration preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the promoted consumer migration preflight report"
fi

jq -n \
  --slurpfile wrapper <("$WRAPPER_REPORT") \
  --slurpfile consumer <("$CURRENT_CONSUMER_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper-promoted-consumer-migration-preflight.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CURRENT_CANONICAL_WRAPPER_PROMOTED_CONSUMER_MIGRATION_PREFLIGHT_2026-06-21.md" \
  '
  ($wrapper[0]) as $wrapper |
  ($consumer[0]) as $consumer |
  [
    "current_canonical_wrapper",
    "current_canonical_closure",
    "current_canonical_closure_alias_readback_index",
    "post_canonical_closure_compact_capability_summary",
    "current_canonical_consumer"
  ] as $current_consumer_dependency_path |
  [
    {
      id:"replace_current_wrapper_source_with_current_consumer",
      target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.report",
      would_create_dependency_cycle:true,
      allowed:false,
      reason:"current_canonical_consumer_already_depends_on_current_canonical_wrapper_through_closure_chain"
    },
    {
      id:"create_successor_wrapper_consumer_surface",
      target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-promoted-current-canonical-wrapper.report",
      would_create_dependency_cycle:false,
      allowed:true,
      reason:"successor_can_consume_current_consumer_without_replacing_the_source_it_depends_on"
    }
  ] as $migration_options |
  [
    "current_wrapper_direct_mutation_blocked_by_dependency_cycle",
    "successor_wrapper_required_before_wrapper_source_replacement",
    "manual_operator_live_cutover_approval_required",
    "tool_execution_live_cutover_allowed_false",
    "tool_execution_public_ga_allowed_false",
    "canonical_gate_not_invoked_by_migration_preflight",
    "wrapper_target_not_invoked_by_migration_preflight",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started"
  ] as $migration_blockers |
  ($wrapper.current_canonical_wrapper_ready == true
    and $wrapper.historical_canonical_gate_name_claimed == true
    and $wrapper.canonical_gate_wrapper_invoked == false
    and $wrapper.capability_matrix_gate_invoked == false
    and $consumer.current_canonical_consumer_ready == true
    and $consumer.current_canonical_consumer_surface == "post_canonical_closure_compact_capability_summary"
    and $consumer.previous_current_summary_superseded_by_post_canonical_closure == true
    and $consumer.canonical_summary_mutation_allowed == false
    and $consumer.current_canonical_wrapper_mutation_allowed == false
    and $consumer.historical_canonical_gate_mutation_allowed == false
    and $consumer.canonical_gate_wrapper_invoked == false
    and $consumer.wrapper_target_invoked == false
    and $consumer.execution_enabled_count == 0
    and $consumer.public_ga_enabled_count == 0
    and $consumer.tool_execution_live_cutover_allowed == false
    and $consumer.tool_execution_public_ga_allowed == false
    and ($migration_options | any(.id == "replace_current_wrapper_source_with_current_consumer" and .would_create_dependency_cycle == true and .allowed == false))
    and ($migration_options | any(.id == "create_successor_wrapper_consumer_surface" and .would_create_dependency_cycle == false and .allowed == true))
    and ($wrapper.side_effects | to_entries | all(.value == false))
    and ($consumer.side_effects | to_entries | all(.value == false))) as $preflight_ready |
  {
    runtime:"hepta",
    surface:"current_canonical_wrapper_promoted_consumer_migration_preflight",
    plugin_id:$consumer.plugin_id,
    status:(if $preflight_ready then "ready" else "blocked" end),
    source_current_canonical_wrapper_surface:$wrapper.surface,
    source_current_canonical_wrapper_ready:$wrapper.current_canonical_wrapper_ready,
    source_current_canonical_consumer_surface:$consumer.surface,
    source_current_canonical_consumer_ready:$consumer.current_canonical_consumer_ready,
    source_promoted_consumer_surface:$consumer.current_canonical_consumer_surface,
    migration_preflight_ready:$preflight_ready,
    direct_current_wrapper_source_replacement_allowed:false,
    direct_current_wrapper_source_replacement_blocked:true,
    dependency_cycle_detected:true,
    dependency_cycle_path:$current_consumer_dependency_path,
    successor_wrapper_surface_required:true,
    successor_wrapper_surface_allowed:true,
    successor_wrapper_surface:"promoted_current_canonical_wrapper",
    current_canonical_wrapper_mutated:false,
    canonical_summary_mutated:false,
    historical_canonical_gate_mutated:false,
    migration_option_count:($migration_options | length),
    migration_options:$migration_options,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    migration_blocker_count:($migration_blockers | length),
    migration_blockers:$migration_blockers,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"create_non_circular_promoted_current_canonical_wrapper_without_alias_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      current_canonical_wrapper_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.report",
      current_canonical_consumer_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-consumer.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      current_canonical_wrapper_mutated:false,
      historical_canonical_gate_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
