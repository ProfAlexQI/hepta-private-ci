#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PREFLIGHT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-preflight-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_SHADOW_WRITE_REHEARSAL_READBACK_2026-07-07.md"

fail() {
  printf 'hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PREFLIGHT_REPORT" ]] || fail "missing executable receipt store preflight report: $PREFLIGHT_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing controlled-live evidence receipt store shadow write rehearsal Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the controlled-live evidence receipt store shadow write rehearsal report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if grep -q 'controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

preflight_json="${HEPTA_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_PREFLIGHT_JSON:-}"
if [[ -n "$preflight_json" ]]; then
  [[ -f "$preflight_json" ]] || fail "missing cached receipt store preflight report: $preflight_json"
else
  preflight_json="$tmpdir/preflight.json"
  "$PREFLIGHT_REPORT" >"$preflight_json" || fail "failed to render receipt store preflight report"
fi

jq -n \
  --slurpfile preflight "$preflight_json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-shadow-write-rehearsal-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_SHADOW_WRITE_REHEARSAL_READBACK_2026-07-07.md" \
  '
  def hyphen_id($id):
    $id | gsub("_"; "-");
  def shadow_write_key($id):
    "controlled_live.evidence_receipt_store.shadow_write_rehearsal." + $id;
  def shadow_write_route($id):
    "readback://controlled-live/evidence-receipt-store/shadow-write-rehearsal/" + hyphen_id($id);
  def shadow_receipt_id($receipt_id):
    "shadow:" + $receipt_id;
  def shadow_fingerprint($id):
    "sha256:controlled-live-evidence-receipt-shadow:" + $id + ":metadata-only";
  def sequence_key($id):
    "shadow-sequence:" + $id + ":00000001";
  def projected_head($id):
    "metadata-only-shadow-head:" + $id;
  ($preflight[0]) as $pre |
  ($pre.entries | map({
    id:("evidence_receipt_store_shadow_write_rehearsal_" + .source_blocker_id),
    source_blocker_id,
    packet_id,
    packet_payload_hash,
    receipt_path,
    receipt_id,
    receipt_schema_version,
    idempotency_key,
    readback_query_key,
    readback_query_route,
    shadow_write_key:shadow_write_key(.source_blocker_id),
    shadow_write_route:shadow_write_route(.source_blocker_id),
    shadow_receipt_id:shadow_receipt_id(.receipt_id),
    shadow_receipt_payload_fingerprint:shadow_fingerprint(.source_blocker_id),
    append_only_sequence_key:sequence_key(.source_blocker_id),
    previous_receipt_head:"absent",
    projected_receipt_head:projected_head(.source_blocker_id),
    operator_display_order,
    operator_status,
    observed_state:"in_memory_shadow_receipt_rehearsed_no_persistence",
    previous_state,
    current_state,
    state_delta,
    owner,
    risk_bucket,
    operator_label,
    required_evidence,
    redaction_policy,
    secret_payload_state,
    shadow_payload_state:"metadata_shape_rendered_in_memory",
    readback_projection_state:"query_matches_projected_shadow_receipt",
    preflight_confirmed:true,
    missing_evidence_confirmed:true,
    in_memory_shadow_receipt_rendered:true,
    append_only_sequence_projected:true,
    readback_query_bound:true,
    idempotency_dedup_projected:true,
    redacted_payload_projected:true,
    secret_payload_denied:true,
    persistence_denied:true,
    ledger_denied:true,
    workflow_event_log_denied:true,
    sqlite_denied:true,
    live_denied:true,
    approval_request_allowed:false,
    approval_acceptance_allowed:false,
    evidence_recording_allowed:false,
    evidence_recorded:false,
    blocker_waiver_allowed:false,
    receipt_persistence_allowed:false,
    receipt_persisted:false,
    receipt_store_write_allowed:false,
    receipt_store_written:false,
    ledger_write_allowed:false,
    workflow_event_log_write_allowed:false,
    sqlite_write_allowed:false,
    credential_read_allowed:false,
    live_mutation_allowed:false
  })) as $entries |
  ($entries | map(select(.preflight_confirmed == true
    and .missing_evidence_confirmed == true
    and .in_memory_shadow_receipt_rendered == true
    and .append_only_sequence_projected == true
    and .readback_query_bound == true
    and .idempotency_dedup_projected == true
    and .redacted_payload_projected == true
    and .secret_payload_denied == true
    and .persistence_denied == true
    and .ledger_denied == true
    and .workflow_event_log_denied == true
    and .sqlite_denied == true
    and .live_denied == true
    and .receipt_store_write_allowed == false
    and .receipt_store_written == false
    and .receipt_persistence_allowed == false
    and .receipt_persisted == false
    and .ledger_write_allowed == false
    and .workflow_event_log_write_allowed == false
    and .sqlite_write_allowed == false
    and .live_mutation_allowed == false)) | length) as $shadow_write_rehearsal_ready_count |
  ($entries | map(select(.in_memory_shadow_receipt_rendered == true)) | length) as $in_memory_shadow_receipt_rendered_count |
  ($entries | map(select(.append_only_sequence_projected == true)) | length) as $append_only_sequence_projected_count |
  ($entries | map(select(.readback_query_bound == true)) | length) as $readback_query_bound_count |
  ($entries | map(select(.idempotency_dedup_projected == true)) | length) as $idempotency_dedup_projected_count |
  ($entries | map(select(.redacted_payload_projected == true)) | length) as $redacted_payload_projected_count |
  ($entries | map(select(.secret_payload_denied == true)) | length) as $secret_payload_denial_confirmed_count |
  ($entries | map(select(.persistence_denied == true)) | length) as $persistence_denial_confirmed_count |
  ($entries | map(select(.ledger_denied == true)) | length) as $ledger_denial_confirmed_count |
  ($entries | map(select(.workflow_event_log_denied == true)) | length) as $workflow_event_log_denial_confirmed_count |
  ($entries | map(select(.sqlite_denied == true)) | length) as $sqlite_denial_confirmed_count |
  ($entries | map(select(.live_denied == true)) | length) as $live_denial_confirmed_count |
  ($entries | map(select(.evidence_recorded == true)) | length) as $evidence_recorded_count |
  ($entries | map(select(.blocker_waiver_allowed == true)) | length) as $blocker_waived_count |
  ($pre.receipt_store_preflight_ready == true
    and $pre.store_preflight_entry_count == 7
    and $pre.store_preflight_ready_count == 7
    and $pre.missing_evidence_entry_count == 7
    and $pre.approval_request_allowed == false
    and $pre.approval_acceptance_allowed == false
    and $pre.evidence_recording_allowed == false
    and $pre.evidence_persisted == false
    and $pre.receipt_persistence_allowed == false
    and $pre.receipt_persisted == false
    and $pre.receipt_store_write_allowed == false
    and $pre.receipt_store_written == false
    and $pre.ledger_write_allowed == false
    and $pre.workflow_event_log_write_allowed == false
    and $pre.sqlite_write_allowed == false
    and $pre.credential_read_allowed == false
    and $pre.live_execution_allowed == false
    and $lib_export_present == true
    and ($entries | length) == 7
    and $shadow_write_rehearsal_ready_count == 7
    and $in_memory_shadow_receipt_rendered_count == 7
    and $append_only_sequence_projected_count == 7
    and $readback_query_bound_count == 7
    and $idempotency_dedup_projected_count == 7
    and $redacted_payload_projected_count == 7
    and $secret_payload_denial_confirmed_count == 7
    and $persistence_denial_confirmed_count == 7
    and $ledger_denial_confirmed_count == 7
    and $workflow_event_log_denial_confirmed_count == 7
    and $sqlite_denial_confirmed_count == 7
    and $live_denial_confirmed_count == 7
    and $evidence_recorded_count == 0
    and $blocker_waived_count == 0
    and ($entries | all(.packet_id == $pre.source_packet_id
      and .packet_payload_hash == $pre.source_packet_payload_hash
      and .observed_state == "in_memory_shadow_receipt_rehearsed_no_persistence"
      and .previous_state == "missing"
      and .current_state == "missing"
      and .state_delta == "unchanged_missing"
      and .secret_payload_state == "denied"
      and .shadow_payload_state == "metadata_shape_rendered_in_memory"
      and .readback_projection_state == "query_matches_projected_shadow_receipt"
      and .approval_request_allowed == false
      and .approval_acceptance_allowed == false
      and .evidence_recording_allowed == false
      and .receipt_persistence_allowed == false
      and .receipt_persisted == false
      and .receipt_store_write_allowed == false
      and .receipt_store_written == false
      and .ledger_write_allowed == false
      and .workflow_event_log_write_allowed == false
      and .sqlite_write_allowed == false
      and .credential_read_allowed == false
      and .live_mutation_allowed == false))) as $in_memory_shadow_write_rehearsal_ready |
  {
    runtime:"hepta",
    surface:"controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback",
    status:(if $in_memory_shadow_write_rehearsal_ready then "ready_blocked" else "blocked" end),
    gate:"controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback_gate",
    schema_version:"controlled_live_evidence_receipt_store_shadow_write_rehearsal_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    source_receipt_store_preflight_ready:$pre.receipt_store_preflight_ready,
    source_store_preflight_entry_count:$pre.store_preflight_entry_count,
    source_missing_evidence_entry_count:$pre.missing_evidence_entry_count,
    source_store_root:$pre.store_root,
    source_packet_id:$pre.source_packet_id,
    source_packet_payload_hash:$pre.source_packet_payload_hash,
    lib_export_present:$lib_export_present,
    shadow_write_rehearsal_entry_count:($entries | length),
    shadow_write_rehearsal_ready_count:$shadow_write_rehearsal_ready_count,
    in_memory_shadow_receipt_rendered_count:$in_memory_shadow_receipt_rendered_count,
    append_only_sequence_projected_count:$append_only_sequence_projected_count,
    readback_query_bound_count:$readback_query_bound_count,
    idempotency_dedup_projected_count:$idempotency_dedup_projected_count,
    redacted_payload_projected_count:$redacted_payload_projected_count,
    secret_payload_denial_confirmed_count:$secret_payload_denial_confirmed_count,
    persistence_denial_confirmed_count:$persistence_denial_confirmed_count,
    ledger_denial_confirmed_count:$ledger_denial_confirmed_count,
    workflow_event_log_denial_confirmed_count:$workflow_event_log_denial_confirmed_count,
    sqlite_denial_confirmed_count:$sqlite_denial_confirmed_count,
    live_denial_confirmed_count:$live_denial_confirmed_count,
    evidence_recorded_count:$evidence_recorded_count,
    blocker_waived_count:$blocker_waived_count,
    in_memory_shadow_write_rehearsal_ready:$in_memory_shadow_write_rehearsal_ready,
    in_memory_shadow_receipts_rendered:($in_memory_shadow_receipt_rendered_count == 7),
    approval_request_allowed:false,
    approval_acceptance_allowed:false,
    evidence_recording_allowed:false,
    evidence_persisted:false,
    receipt_persistence_allowed:false,
    receipt_persisted:false,
    receipt_store_write_allowed:false,
    receipt_store_written:false,
    ledger_write_allowed:false,
    workflow_event_log_write_allowed:false,
    sqlite_write_allowed:false,
    credential_read_allowed:false,
    live_execution_allowed:false,
    blockers:[
      "evidence_missing",
      "in_memory_rehearsal_only",
      "store_write_disabled",
      "receipt_persistence_disabled",
      "approval_request_disabled",
      "approval_acceptance_disabled",
      "ledger_write_disabled",
      "workflow_event_log_write_disabled",
      "sqlite_write_disabled",
      "live_execution_disabled"
    ],
    entries:$entries,
    next_actions:[
      "controlled_live_evidence_receipt_store_persistence_open_preconditions_readback",
      "keep_shadow_receipts_in_memory_until_operator_evidence_and_persistence_approval_exist"
    ],
    next_migration_step:"controlled_live_evidence_receipt_store_persistence_open_preconditions_readback",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      approval_requested:false,
      approval_accepted:false,
      approval_recorded:false,
      evidence_recorded:false,
      evidence_persisted:false,
      receipt_persisted:false,
      receipt_store_written:false,
      blocker_waived:false,
      credential_read:false,
      packet_sent:false,
      attachment_sent:false,
      packet_persisted:false,
      attachment_persisted:false,
      readback_persisted:false,
      ledger_written:false,
      workflow_event_log_written:false,
      sqlite_written:false,
      native_post_mutation_performed:false,
      gateway_or_auth_mutated:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      replay_executed:false,
      rollback_executed:false,
      kill_switch_rehearsal_executed:false,
      kill_switch_mutated:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }'
