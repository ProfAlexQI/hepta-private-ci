#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ATTACHMENT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_ATTACHMENT_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-readiness-non-live-attachment-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$ATTACHMENT_REPORT" ]] || fail "missing executable Public GA readiness non-live attachment report: $ATTACHMENT_REPORT"
[[ -f "$DOC" ]] || fail "missing Public GA readiness non-live attachment readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the Public GA readiness non-live attachment readback report"
fi

jq -n \
  --slurpfile attachment <("$ATTACHMENT_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-attachment-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_ATTACHMENT_READBACK_2026-06-21.md" \
  '
  ($attachment[0]) as $attachment |
  ($attachment.public_ga_readiness_attachment_ready == true
    and $attachment.public_ga_readiness_attachment_blocked == true
    and $attachment.public_ga_readiness_attachment_basis == "preflight_non_live_adapter_migration_final_index"
    and $attachment.public_ga_readiness_preflight_non_live_adapter_migration_final_index_attached == true
    and $attachment.public_ga_readiness_endpoint_inventory_from_adapter == true
    and $attachment.public_ga_readiness_target_endpoint_count == 9
    and $attachment.public_ga_readiness_live_endpoint_read_required_by_attachment == false
    and $attachment.public_ga_readiness_script_invoked == false
    and $attachment.public_ga_readiness_live_endpoint_read_performed == false
    and $attachment.public_ga_readiness_endpoint_curl_performed == false
    and $attachment.public_ga_readiness_report_materialized == false
    and $attachment.public_ga_readiness_attachment_recorded == false
    and $attachment.public_ga_readiness_attachment_allowed == false
    and $attachment.public_ga_claim_allowed == false
    and $attachment.public_ga_claimed == false
    and $attachment.terminal_live_gates_invoked == false
    and $attachment.canonical_gate_wrapper_invoked == false
    and $attachment.wrapper_target_invoked == false
    and ($attachment.side_effects | to_entries | all(.value == false))) as $readback_ready |
  {
    runtime:"hepta",
    surface:"public_ga_readiness_non_live_attachment_readback",
    plugin_id:$attachment.plugin_id,
    status:(if $readback_ready then "ready_blocked" else "blocked" end),
    source_public_ga_readiness_non_live_attachment_surface:$attachment.surface,
    source_public_ga_readiness_non_live_attachment_ready:$attachment.public_ga_readiness_attachment_ready,
    source_public_ga_readiness_non_live_attachment_blocked:$attachment.public_ga_readiness_attachment_blocked,
    public_ga_readiness_non_live_attachment_readback_ready:$readback_ready,
    public_ga_readiness_non_live_attachment_readback_blocked:true,
    public_ga_readiness_non_live_attachment_attached:true,
    readback_mode:"static_public_ga_readiness_non_live_attachment_snapshot_only",
    readback_check_count:18,
    public_ga_readiness_attachment_basis:$attachment.public_ga_readiness_attachment_basis,
    public_ga_readiness_preflight_non_live_adapter_migration_final_index_attached:true,
    public_ga_readiness_script_present:true,
    public_ga_readiness_release_gate_doc_present:true,
    public_ga_readiness_existing_doc_present:$attachment.public_ga_readiness_existing_doc_present,
    public_ga_readiness_dedicated_architecture_note_required:$attachment.public_ga_readiness_dedicated_architecture_note_required,
    public_ga_readiness_endpoint_inventory_from_adapter:true,
    public_ga_readiness_non_live_endpoint_inventory_ready:true,
    public_ga_readiness_target_endpoint_count:$attachment.public_ga_readiness_target_endpoint_count,
    public_ga_readiness_live_endpoint_read_required_by_original_target:true,
    public_ga_readiness_live_endpoint_read_required_by_attachment:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    public_ga_readiness_attachment_allowed:false,
    terminal_publication_evidence_non_persistence_summary_gate_invoked:false,
    hepta_watchdog_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_denial_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    attachment_blocker_count:$attachment.attachment_blocker_count,
    attachment_blockers:$attachment.attachment_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    public_distribution_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    public_ga_claim_allowed:false,
    public_release_published:false,
    public_ga_claimed:false,
    publication_evidence_summary_recorded:false,
    publication_evidence_summary_persisted:false,
    publication_evidence_receipt_persisted:false,
    publication_evidence_ledger_persisted:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    next_migration_step:"derive_public_ga_readiness_non_live_attachment_final_index_without_readiness_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      public_ga_readiness_non_live_attachment_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment.report"
    },
    side_effect_free:true,
    side_effects:$attachment.side_effects
  }'
