#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-canary-readiness-plan.report"
APPROVAL_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-hepta-system-status-operator-approval-protocol.gate"
BOUNDARY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-gap-operator-packet-attachment-kill-switch-rehearsal-boundary-readback.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_CANARY_READINESS_PLAN_2026-06-27.md"

fail() {
  printf 'hepta-systems-controlled-canary-readiness-plan-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 10 report: $REPORT"
[[ -x "$APPROVAL_GATE" ]] || fail "missing executable Phase 9 approval protocol gate: $APPROVAL_GATE"
[[ -x "$BOUNDARY_REPORT" ]] || fail "missing executable Phase 5n kill-switch boundary report: $BOUNDARY_REPORT"
[[ -f "$DOC" ]] || fail "missing Phase 10 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 10 controlled canary readiness plan report"
fi

grep -q 'Controlled Canary Readiness Plan' "$DOC" \
  || fail "architecture note must document Controlled Canary Readiness Plan"
grep -q 'plan_only_no_activation' "$DOC" \
  || fail "architecture note must document plan_only_no_activation"
grep -q 'no Gateway/Auth mutation, Native POST mutation, Telegram transport mutation, channel send, credential read, persistence, Public GA, or live activation' "$DOC" \
  || fail "architecture note must document the closed canary boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_canary_readiness_plan"
  and .status == "ready_blocked"
  and .gate == "controlled_canary_readiness_plan_gate"
  and .schema_version == "controlled_canary_readiness_plan_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_approval_protocol_ready == true
  and .source_approval_packet_count == 1
  and .source_approval_request_sent == false
  and .source_approval_accepted == false
  and .source_approval_recorded == false
  and .source_boundary_ready == true
  and .source_boundary_entry_count == 7
  and .source_boundary_ready_count == 7
  and .source_boundary_missing_evidence_count == 7
  and .lib_export_present == true
  and .status_canary_start_guard_rust_bound_present == true
  and .status_canary_start_guard_lib_export_present == true
  and .canary_scope.canary_id == "controlled-canary.hepta-system-status.internal-read-only.v1"
  and .canary_scope.activation_mode == "plan_only_no_activation"
  and .canary_scope.gateway_auth_boundary == "closed"
  and .canary_scope.native_post_boundary == "closed"
  and .canary_scope.telegram_transport_boundary == "closed"
  and .canary_scope.channel_send_boundary == "closed"
  and .canary_scope.credential_boundary == "closed"
  and .canary_scope.persistence_boundary == "closed"
  and .canary_scope.live_activation_boundary == "closed"
  and .canary_plan_entry_count == 7
  and .canary_plan_ready_count == 7
  and .blocker_reference_count == 7
  and .missing_blocker_count == 7
  and .approval_protocol_bound == true
  and .operator_readback_bound == true
  and .dirty_worktree_blocker_preserved == true
  and .soak_readback_required == true
  and .rollback_rehearsal_required == true
  and .kill_switch_rehearsal_required == true
  and .gateway_native_telegram_boundary_closed == true
  and .credential_boundary_closed == true
  and .persistence_boundary_closed == true
  and .status_canary_start_guard_bound == true
  and .status_canary_start_guard_id == "status-canary-start-guard/hepta-system-status/v1"
  and .status_canary_start_guard_route == "status_canary_start_blocked_missing_evidence_packet"
  and .status_canary_start_guard_switch_enabled == false
  and .status_canary_start_guard_evidence_complete == false
  and .status_canary_start_guard_missing_evidence_count == 7
  and .status_canary_start_guard_side_effects_closed == true
  and .status_canary_start_guard_blocked == true
  and .status_canary_start_guard_allowed == false
  and .controlled_canary_readiness_plan_ready == true
  and .controlled_canary_activation_ready == false
  and .approval_request_sent == false
  and .approval_request_allowed == false
  and .approval_accepted == false
  and .approval_recorded == false
  and .approval_broker_write_allowed == false
  and .evidence_recording_allowed == false
  and .credential_read_allowed == false
  and .gateway_or_auth_mutation_allowed == false
  and .native_post_mutation_allowed == false
  and .telegram_transport_mutation_allowed == false
  and .channel_send_allowed == false
  and .transport_mutation_allowed == false
  and .canary_persistence_allowed == false
  and .canary_receipt_persisted == false
  and .workflow_event_log_write_allowed == false
  and .sqlite_write_allowed == false
  and .provider_invocation_allowed == false
  and .model_invocation_allowed == false
  and .package_or_release_allowed == false
  and .public_ga_allowed == false
  and .live_activation_allowed == false
  and .live_execution_allowed == false
  and (.entries | length) == 7
  and (.entries | all(.operator_visible == true
    and .queryable == true
    and .canary_plan_ready == true
    and .blocks_canary_activation == true
    and .readiness_state == "missing_required_evidence"
    and .evidence_state == "missing"
    and .evidence_recording_allowed == false
    and .approval_acceptance_allowed == false
    and .waiver_allowed == false
    and .credential_read_allowed == false
    and .transport_mutation_allowed == false
    and .persistence_allowed == false
    and .live_activation_allowed == false))
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary")
  and any(.entries[]; .source_blocker_id == "operator_live_approval_missing")
  and any(.entries[]; .source_blocker_id == "fresh_soak_readback_missing")
  and any(.entries[]; .source_blocker_id == "credential_boundary_attestation_missing")
  and any(.entries[]; .source_blocker_id == "gateway_native_telegram_post_boundary_approval_missing")
  and any(.entries[]; .source_blocker_id == "rollback_rehearsal_missing")
  and any(.entries[]; .source_blocker_id == "kill_switch_rehearsal_missing")
  and (.blockers | index("dirty_worktree_release_boundary_unresolved")) != null
  and (.blockers | index("canary_activation_blocked")) != null
  and (.blockers | index("status_canary_start_guard_blocked")) != null
  and (.blockers | index("live_activation_closed")) != null
  and (.next_actions | index("phase11_dirty_worktree_release_boundary_inventory_without_git_mutation")) != null
  and .next_migration_step == "phase11_dirty_worktree_release_boundary_inventory_without_git_mutation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$BOUNDARY_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "controlled_live_required_evidence_gap_operator_packet_attachment_kill_switch_rehearsal_boundary_readback"
  and .status == "ready_blocked"
  and .kill_switch_rehearsal_boundary_readback_ready == true
  and .kill_switch_rehearsal_boundary_entry_count == 7
  and .kill_switch_rehearsal_boundary_ready_count == 7
  and .kill_switch_rehearsal_boundary_closed_count == 7
  and .kill_switch_rehearsal_evidence_missing_count == 7
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$APPROVAL_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime controlled_canary_readiness_plan --lib
)

printf 'hepta-systems-controlled-canary-readiness-plan-gate: PASS: controlled canary readiness is planned while Gateway/Auth, Native POST, Telegram/channel, credentials, persistence, Public GA, and live activation stay closed\n'
