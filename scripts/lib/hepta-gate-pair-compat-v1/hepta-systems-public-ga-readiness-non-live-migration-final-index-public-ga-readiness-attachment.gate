#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment.report"
MIGRATION_FINAL_INDEX_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-preflight-non-live-adapter-migration-final-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_NON_LIVE_MIGRATION_FINAL_INDEX_PUBLIC_GA_READINESS_ATTACHMENT_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Public GA readiness attachment report: $REPORT"
[[ -x "$MIGRATION_FINAL_INDEX_GATE" ]] || fail "missing executable Public GA readiness non-live migration final index gate: $MIGRATION_FINAL_INDEX_GATE"
[[ -f "$DOC" ]] || fail "missing Public GA readiness attachment architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Public GA readiness attachment report"
fi

grep -q 'Public GA Readiness Non-Live Migration Final Index Public GA Readiness Attachment' "$DOC" \
  || fail "architecture note must document Public GA Readiness Non-Live Migration Final Index Public GA Readiness Attachment"
grep -q 'ready-but-blocked' "$DOC" \
  || fail "architecture note must document ready-but-blocked status"
grep -q 'does not invoke' "$DOC" \
  || fail "architecture note must document that attachment does not invoke Public GA readiness"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "public_ga_readiness_non_live_migration_final_index_public_ga_readiness_attachment"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready_blocked"
  and .source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_surface == "public_ga_readiness_preflight_non_live_adapter_migration_final_index"
  and .source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_ready == true
  and .source_public_ga_readiness_preflight_non_live_adapter_migration_final_index_blocked == true
  and .public_ga_readiness_attachment_ready == true
  and .public_ga_readiness_attachment_blocked == true
  and .public_ga_readiness_attachment_basis == "preflight_non_live_adapter_migration_final_index"
  and .public_ga_readiness_preflight_non_live_adapter_migration_final_index_attached == true
  and .public_ga_readiness_script_present == true
  and .public_ga_readiness_release_gate_doc_present == true
  and .public_ga_readiness_existing_doc_present == false
  and .public_ga_readiness_dedicated_architecture_note_required == true
  and .public_ga_readiness_endpoint_inventory_from_adapter == true
  and .public_ga_readiness_target_endpoint_count == 9
  and .public_ga_readiness_target_curl_count == 9
  and .public_ga_readiness_target_live_endpoint_count == 9
  and .public_ga_readiness_live_endpoint_read_required_by_original_target == true
  and .public_ga_readiness_live_endpoint_read_required_by_attachment == false
  and .public_ga_readiness_script_invoked == false
  and .public_ga_readiness_live_endpoint_read_performed == false
  and .public_ga_readiness_endpoint_curl_performed == false
  and .public_ga_readiness_report_materialized == false
  and .public_ga_readiness_attachment_recorded == false
  and .public_ga_readiness_attachment_allowed == false
  and .terminal_publication_evidence_non_persistence_summary_gate_invoked == false
  and .hepta_watchdog_invoked == false
  and .terminal_public_distribution_non_publication_lock_gate_invoked == false
  and .terminal_denial_index_gate_invoked == false
  and .terminal_summary_gates_invoked == false
  and .terminal_live_gates_invoked == false
  and .canonical_gate_wrapper_invoked == false
  and .wrapper_target_invoked == false
  and .attachment_blocker_count == 18
  and (.attachment_blockers | index("public_ga_readiness_attachment_non_live_only")) != null
  and (.attachment_blockers | index("public_ga_readiness_script_invocation_blocked")) != null
  and .manual_operator_live_cutover_approval_required == true
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .public_ga_claim_allowed == false
  and .public_ga_claimed == false
  and .operator_approval_recorded == false
  and .operator_identity_accepted == false
  and .rollback_execution_allowed == false
  and .next_migration_step == "derive_public_ga_readiness_non_live_attachment_readback_without_readiness_invocation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$MIGRATION_FINAL_INDEX_GATE" >/dev/null

printf 'hepta-systems-public-ga-readiness-non-live-migration-final-index-public-ga-readiness-attachment-gate: PASS: Public GA readiness attachment consumes non-live migration final index without readiness invocation\n'
