#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-canonical-adapter-inventory-preview.report"

report="$(
  capture_json_report \
    "hepta-work-graph-canonical-adapter-inventory-preview-report" \
    "$REPORT_SCRIPT"
)"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_canonical_adapter_inventory_preview_gate"
  and .schema_version == "work_graph_canonical_adapter_inventory_preview_v1"
  and .preview_mode == "read_only_canonical_adapter_inventory_no_persistence"
  and .source_surface_count == 12
  and .canonical_adapter_count == 12
  and (.adapters | length) == .canonical_adapter_count
  and .source_category_count == 6
  and .canonical_node_kind_count == 6
  and .canonical_edge_kind_count == 20
  and .canonical_collection_count == 6
  and .canonical_collection_binding_count == 36
  and .canonical_timeline_event_binding_count == 12
  and .terminal_task_result_required_count == 6
' >/dev/null <<<"$report"

jq -e '
  .store_adapter_present_count == 6
  and .task_result_adapter_present_count == 6
  and .timeline_adapter_present_count == 7
  and .scheduler_admission_adapter_present_count == 5
  and .role_manifest_adapter_present_count == 4
  and .contract_ready_adapter_count == 5
  and .partial_or_gap_adapter_count == 7
  and (.adapters | map(.source_surface_id) == [
    "update_plan_tool",
    "plan_mode_proposed_plan_blocks",
    "app_server_turn_plan_notification",
    "multi_agent_v2_thread_spawn",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "agent_jobs_batch_workers",
    "hepta_runtime_task_board",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_approval_broker",
    "hepta_runtime_agent_harness"
  ])
  and (.adapters | map(select(.terminal_task_result_required == true)) | length) == 6
  and (.adapters | map(select(.canonical_inventory_state == "canonical_contract_ready_preview")) | length) == 5
  and (.adapters | map(select(.next_inventory_step == "readback_canonical_adapter_inventory_projection")) | length) == 5
' >/dev/null <<<"$report"

jq -e '
  (.adapters | map(select(
    .source_surface_id == "multi_agent_v2_thread_spawn"
    and .canonical_node_kind == "agent_task"
    and (.canonical_edge_kinds | index("spawned_by"))
    and .task_result_adapter_state == "present_preview"
    and .role_manifest_adapter_state == "present_preview"
  )) | length) == 1
  and (.adapters | map(select(
    .source_surface_id == "hepta_runtime_task_board"
    and .canonical_inventory_state == "canonical_partial_preview"
    and (.inventory_blocker_ids | index("canonical_adapter_projection_incomplete"))
    and .scheduler_admission_adapter_state == "present_preview"
  )) | length) == 1
  and (.adapters | map(select(
    .source_surface_id == "plan_mode_proposed_plan_blocks"
    and .store_adapter_state == "missing"
    and .task_result_adapter_state == "not_required"
    and .next_inventory_step == "add_unified_store_adapter_projection"
  )) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .inventory_blocker_count == 8
  and (.inventory_blockers | map(.id) == [
    "canonical_adapter_inventory_readback_missing",
    "append_only_work_graph_events_disabled",
    "runtime_canonical_adapter_enforcement_disabled",
    "planning_identity_is_split_between_update_plan_and_plan_mode",
    "mailbox_wait_lacks_structured_task_result_join",
    "task_board_has_admission_shape_without_unified_store_projection",
    "batch_and_worker_results_are_not_enforced_task_results",
    "role_manifest_and_scheduler_admission_remain_preview_only"
  ])
  and (.inventory_blockers | all(.blocks_append_only_fact_source == true))
  and .required_prior_gate_count == 9
  and (.required_prior_gates[-2:] == [
    "hepta_work_graph_unified_projection_audit_preview_gate",
    "hepta_work_graph_unified_projection_enforcement_readiness_runtime_wal_write_boundary_execution_rerun_preview_gate"
  ])
  and .recommended_next_gate == "hepta_work_graph_canonical_adapter_inventory_readback_preview_gate"
  and .ready_for_canonical_adapter_inventory_readback_preview == true
  and .ready_for_append_only_work_graph_events == false
  and .ready_for_runtime_adapter_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_live_execution == false
' >/dev/null <<<"$report"

jq -e '
  .source_probes.canonical_adapter_inventory.rust_module_present == true
  and .source_probes.canonical_adapter_inventory.report_script_present == true
  and .source_probes.canonical_adapter_inventory.gate_script_present == true
  and .source_probes.unified_projection_audit.status == "ready"
  and .source_probes.wal_write_boundary_execution_rerun.status == "ready"
  and .source_probes.wal_write_boundary_execution_rerun.residual_blocker_count == 0
  and .source_probes.wal_write_boundary_execution_rerun.recommended_next_gate == "hepta_work_graph_canonical_adapter_inventory_preview_gate"
  and (.source_probes.source_surfaces | to_entries | all(.value == true))
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_canonical_adapter_inventory --lib

echo "Hepta WorkGraph canonical adapter inventory preview gate passed"
