#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
CREATION_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.report"
CREATION_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.gate"
CANONICAL_GATE="$ROOT/scripts/hepta-systems-canonical-gate.sh"
WRAPPER_TARGET="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_THIN_WRAPPER_VALIDATION_2026-06-21.md"

fail() {
  printf 'hepta-systems-historical-canonical-gate-thin-wrapper-validation-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$CREATION_REPORT" ]] || fail "missing executable thin wrapper creation report: $CREATION_REPORT"
[[ -x "$CREATION_GATE" ]] || fail "missing executable thin wrapper creation gate: $CREATION_GATE"
[[ -x "$CANONICAL_GATE" ]] || fail "missing executable historical canonical gate thin wrapper: $CANONICAL_GATE"
[[ -x "$WRAPPER_TARGET" ]] || fail "missing executable current canonical wrapper target: $WRAPPER_TARGET"
[[ -f "$DOC" ]] || fail "missing historical canonical gate thin wrapper validation architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the historical canonical gate thin wrapper validation report"
fi

wrapper_target_count="$(grep -c 'TARGET="\$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"' "$CANONICAL_GATE" || true)"
wrapper_exec_count=0
if grep -Eq '^[[:space:]]*exec[[:space:]]+"\$TARGET"[[:space:]]+"\$@"[[:space:]]*$' "$CANONICAL_GATE"; then
  wrapper_exec_count=1
fi

syntax_valid=false
if bash -n "$CANONICAL_GATE"; then
  syntax_valid=true
fi

jq -n \
  --slurpfile creation <("$CREATION_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-validation.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_THIN_WRAPPER_VALIDATION_2026-06-21.md" \
  --argjson wrapper_target_count "$wrapper_target_count" \
  --argjson wrapper_exec_count "$wrapper_exec_count" \
  --argjson syntax_valid "$syntax_valid" \
  '
  ($creation[0]) as $creation |
  ($creation.historical_canonical_gate_thin_wrapper_creation_ready == true
    and $creation.historical_canonical_gate_created == true
    and $creation.historical_canonical_gate_executable == true
    and $creation.historical_canonical_gate_wrapper_kind == "thin_local_exec_wrapper"
    and $creation.historical_canonical_gate_wrapper_target == "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    and $creation.historical_canonical_gate_wrapper_exec_count == 1
    and $creation.wrapper_target_invoked == false
    and $creation.canonical_gate_invoked == false
    and $wrapper_target_count == 1
    and $wrapper_exec_count == 1
    and $syntax_valid == true
    and $creation.execution_enabled_count == 0
    and $creation.public_ga_enabled_count == 0
    and $creation.tool_execution_live_cutover_allowed == false
    and $creation.tool_execution_public_ga_allowed == false
    and ($creation.side_effects | to_entries | all(.value == false))) as $validation_ready |
  {
    runtime:"hepta",
    surface:"historical_canonical_gate_thin_wrapper_validation",
    plugin_id:$creation.plugin_id,
    status:(if $validation_ready then "ready" else "blocked" end),
    source_creation_surface:$creation.surface,
    source_creation_ready:$creation.historical_canonical_gate_thin_wrapper_creation_ready,
    source_wrapper_target_invoked:$creation.wrapper_target_invoked,
    source_canonical_gate_invoked:$creation.canonical_gate_invoked,
    historical_canonical_gate_path:"scripts/hepta-systems-canonical-gate.sh",
    historical_canonical_gate_created:true,
    historical_canonical_gate_executable:true,
    historical_canonical_gate_wrapper_kind:"thin_local_exec_wrapper",
    historical_canonical_gate_wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
    historical_canonical_gate_wrapper_target_count:$wrapper_target_count,
    historical_canonical_gate_wrapper_exec_count:$wrapper_exec_count,
    historical_canonical_gate_bash_syntax_checked:true,
    historical_canonical_gate_bash_syntax_valid:$syntax_valid,
    wrapper_target_exists:true,
    wrapper_target_executable:true,
    wrapper_target_invoked:false,
    canonical_gate_invoked:false,
    capability_matrix_gate_invoked:false,
    terminal_live_gate_invoked:false,
    live_url_required:false,
    long_soak_required:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    historical_canonical_gate_thin_wrapper_validation_ready:$validation_ready,
    next_migration_step:"attach_historical_canonical_gate_thin_wrapper_validation_to_current_canonical_closure_without_live_invocation",
    validation_blockers:[
      "manual_operator_live_cutover_approval_required",
      "tool_execution_live_cutover_allowed_false",
      "tool_execution_public_ga_allowed_false",
      "canonical_gate_not_invoked_by_validation_report",
      "wrapper_target_not_invoked_by_validation_report"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      thin_wrapper_creation_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.report",
      thin_wrapper_creation_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-thin-wrapper-creation.gate",
      historical_canonical_gate:"scripts/hepta-systems-canonical-gate.sh",
      wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_snapshot_evidence_written:false,
      wrapper_body_emitted_by_report:false,
      canonical_gate_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
