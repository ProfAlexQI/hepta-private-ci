#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PHASE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.report"
PHASE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_NAME_REINTRODUCTION_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-historical-canonical-gate-name-reintroduction-preflight-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PHASE_REPORT" ]] || fail "missing executable canonical summary attachment phase index report: $PHASE_REPORT"
[[ -x "$PHASE_GATE" ]] || fail "missing executable canonical summary attachment phase index gate: $PHASE_GATE"
[[ -f "$DOC" ]] || fail "missing historical canonical gate name reintroduction preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the historical canonical gate name reintroduction preflight report"
fi

jq -n \
  --slurpfile phase <("$PHASE_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-name-reintroduction-preflight.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_HISTORICAL_CANONICAL_GATE_NAME_REINTRODUCTION_PREFLIGHT_2026-06-21.md" \
  '
  ($phase[0]) as $phase |
  [
    {
      id:"canonical_summary_attachment_index_gate",
      path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-index.gate",
      strict_missing_dependency:true,
      migrated_to_phase_index:true,
      would_break_if_historical_name_claimed:false
    },
    {
      id:"compact_capability_restore_preflight_gate",
      path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-compact-capability-matrix-restore-preflight.gate",
      strict_missing_dependency:true,
      migrated_to_phase_index:true,
      would_break_if_historical_name_claimed:false
    },
    {
      id:"current_canonical_wrapper_gate",
      path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
      strict_missing_dependency:false,
      migrated_to_phase_index:true,
      would_break_if_historical_name_claimed:false
    }
  ] as $dependent_consumers |
  ($dependent_consumers | map(select(.would_break_if_historical_name_claimed == true)) | length) as $blocking_consumer_count |
  ($phase.phase_aware_attachment_index_ready
    and $phase.historical_missing_path_evidence_preserved == true
    and $phase.source_attachment_probe_basis == "historical_snapshot_evidence"
    and $phase.source_attachment_current_filesystem_probe_used == false
    and $phase.source_attachment_historical_snapshot_missing_canonical_summary == true
    and $phase.source_attachment_snapshot_evidence_consumable_after_wrapper_creation == true
    and $phase.current_wrapper_phase_available == true
    and $phase.current_wrapper_active_summary_source == true
    and $phase.phase_split_present == true
    and $phase.phase_split_required_before_name_claim == false
    and $phase.phase_split_completed_before_name_claim == true
    and $phase.historical_canonical_gate_name_claimed == true
    and $phase.historical_canonical_gate_created == true
    and $phase.historical_canonical_gate_executable == true
    and $phase.historical_canonical_gate_wrapper_kind == "thin_local_exec_wrapper"
    and $phase.historical_canonical_gate_wrapper_target == "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    and $phase.historical_canonical_gate_wrapper_exec_count == 1
    and $phase.historical_canonical_gate_mutated == true
    and $phase.historical_canonical_gate_mutated_by_report == false
    and $phase.canonical_gate_wrapper_invoked == false
    and $phase.execution_enabled_count == 0
    and $phase.public_ga_enabled_count == 0
    and $blocking_consumer_count == 0
    and ($phase.side_effects | to_entries | all(.value == false))) as $preflight_ready |
  {
    runtime:"hepta",
    surface:"historical_canonical_gate_name_reintroduction_preflight",
    plugin_id:$phase.plugin_id,
    status:(if $preflight_ready then "ready" else "blocked" end),
    source_phase_index_surface:$phase.surface,
    source_phase_index_ready:$phase.phase_aware_attachment_index_ready,
    source_historical_missing_path_evidence_preserved:$phase.historical_missing_path_evidence_preserved,
    source_historical_missing_path_evidence_basis:$phase.source_attachment_probe_basis,
    source_historical_missing_path_current_filesystem_probe_used:$phase.source_attachment_current_filesystem_probe_used,
    source_historical_snapshot_missing_canonical_summary:$phase.source_attachment_historical_snapshot_missing_canonical_summary,
    source_historical_snapshot_evidence_consumable_after_wrapper_creation:$phase.source_attachment_snapshot_evidence_consumable_after_wrapper_creation,
    source_current_wrapper_phase_available:$phase.current_wrapper_phase_available,
    source_current_wrapper_active_summary_source:$phase.current_wrapper_active_summary_source,
    source_phase_split_present:$phase.phase_split_present,
    source_phase_split_required_before_name_claim:$phase.phase_split_required_before_name_claim,
    source_phase_split_completed_before_name_claim:$phase.phase_split_completed_before_name_claim,
    proposed_historical_canonical_gate_path:"scripts/hepta-systems-canonical-gate.sh",
    proposed_alias_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
    proposed_alias_kind:"thin_local_wrapper",
    proposed_alias_would_invoke_live_gates:false,
    dependent_consumer_count:($dependent_consumers | length),
    dependent_strict_missing_consumer_count:($dependent_consumers | map(select(.strict_missing_dependency == true)) | length),
    dependent_blocking_consumer_count:$blocking_consumer_count,
    dependent_consumers:$dependent_consumers,
    dependent_gate_migration_required:false,
    historical_canonical_gate_name_reintroduction_preflight_ready:$preflight_ready,
    historical_canonical_gate_name_reintroduction_allowed:true,
    historical_canonical_gate_name_claimed:true,
    historical_canonical_gate_created:true,
    historical_canonical_gate_executable:true,
    historical_canonical_gate_wrapper_kind:"thin_local_exec_wrapper",
    historical_canonical_gate_wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
    historical_canonical_gate_wrapper_exec_count:1,
    historical_canonical_gate_mutated:true,
    historical_canonical_gate_mutated_by_report:false,
    canonical_gate_wrapper_invoked:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"validate_historical_canonical_gate_thin_wrapper_without_live_invocation",
    preflight_blockers:[
      "historical_canonical_gate_thin_wrapper_validation_pending",
      "manual_operator_live_cutover_approval_required",
      "tool_execution_live_cutover_allowed_false",
      "tool_execution_public_ga_allowed_false"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      canonical_summary_attachment_phase_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.report",
      canonical_summary_attachment_phase_index_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.gate"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      historical_canonical_gate_mutated:false,
      historical_canonical_gate_name_claimed:false,
      canonical_gate_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
