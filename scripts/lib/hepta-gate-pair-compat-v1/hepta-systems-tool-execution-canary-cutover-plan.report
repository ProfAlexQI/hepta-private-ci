#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-operator-approval-decision-preflight.report"
RUST_SOURCE="$ROOT/codex-rs/tools/src/tool_execution_canary_cutover_plan.rs"
GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-cutover-plan.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_CANARY_CUTOVER_PLAN_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-canary-cutover-plan-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable execution operator approval decision preflight report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing execution canary cutover plan Rust source: $RUST_SOURCE"
[[ -f "$DOC" ]] || fail "missing execution canary cutover plan architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the execution canary cutover plan report"
fi

jq -n \
  --slurpfile source <("$SOURCE_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canary-cutover-plan.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_CANARY_CUTOVER_PLAN_2026-06-21.md" \
  --arg status_canary_tool_id "preview:mcp:hepta-system@hepta-local:hepta_system_local_mcp" \
  '
  def canary_entry($entry; $status_canary_tool_id):
    ($entry.operator_approval_decision_preflight_route == "operator_approval_decision_pending_explicit_approval"
      and $entry.operator_approval_decision_preflight_ready == true
      and $entry.operator_decision_pending == true
      and $entry.operator_decision_write_blocked == true
      and $entry.operator_acceptance_blocked == true) as $decision_ready |
    ($entry.registry_guard_route == "require_approval_ledger") as $approval_guard |
    ($entry.candidate_tool_id == $status_canary_tool_id) as $selected |
    ($decision_ready and $approval_guard and $selected) as $status_canary_ready |
    ($decision_ready and $approval_guard and ($selected | not)) as $preflight_only |
    {
      plugin_id:$entry.plugin_id,
      candidate_tool_id:$entry.candidate_tool_id,
      contribution_kind:$entry.contribution_kind,
      execution_adapter_kind:$entry.execution_adapter_kind,
      source_decision_preflight_route:$entry.operator_approval_decision_preflight_route,
      source_status_canary_spec_route:(if $selected then "read_only_status_canary_spec_ready" elif $preflight_only then "preflight_only_non_selected_candidate" else "blocked_by_dispatch_shadow" end),
      source_status_canary_spec_ready:($status_canary_ready or $preflight_only),
      registry_guard_route:$entry.registry_guard_route,
      selected_for_status_canary:$selected,
      preflight_only_non_selected_candidate:$preflight_only,
      canary_cutover_plan_route:(if $status_canary_ready then "canary_cutover_plan_ready" elif $preflight_only then "preflight_only_non_selected_candidate" elif $decision_ready then "blocked_by_status_canary_spec" else "blocked_by_decision_preflight" end),
      canary_cutover_plan_ready:($status_canary_ready or $preflight_only),
      canary_scope_declared:true,
      canary_budget_declared:true,
      rollback_plan_required:true,
      rollback_plan_declared:true,
      canary_readback_receipt_required:true,
      canary_result_receipt_schema_present:true,
      canary_start_blocked:$status_canary_ready,
      operator_acceptance_present:false,
      canary_cutover_switch_enabled:false,
      live_cutover_switch_enabled:false,
      canary_execution_started:false,
      canary_result_receipt_written:false,
      rollback_executed:false,
      router_registration_lookup_enabled:false,
      registry_lookup_executed:false,
      registry_source_of_truth_enabled:false,
      tool_registration_enabled:false,
      execution_adapter_dispatch_enabled:false,
      tool_invocation_enabled:false,
      ledger_write_enabled:false,
      approval_request_enabled:false,
      operator_decision_record_write_enabled:false,
      operator_decision_receipt_write_enabled:false,
      result_receipt_write_enabled:false,
      side_effect_free:true
  };

  ($source[0]) as $source |
  ($source.entries | map(canary_entry(.; $status_canary_tool_id))) as $entries |
  ($entries | map(select(.canary_cutover_plan_ready == true)) | length) as $ready_count |
  ($entries | map(select(.canary_scope_declared == true)) | length) as $scope_count |
  ($entries | map(select(.canary_budget_declared == true)) | length) as $budget_count |
  ($entries | map(select(.rollback_plan_required == true and .rollback_plan_declared == true)) | length) as $rollback_count |
  ($entries | map(select(.canary_readback_receipt_required == true and .canary_result_receipt_schema_present == true)) | length) as $readback_count |
  ($entries | map(select(.canary_start_blocked == true)) | length) as $start_blocked_count |
  ($entries | map(select(.selected_for_status_canary == true)) | length) as $selected_count |
  ($entries | map(select(.preflight_only_non_selected_candidate == true)) | length) as $preflight_only_count |
  ($source.tool_execution_operator_approval_decision_preflight_ready
    and $source.tool_execution_operator_decision_acceptance_allowed == false
    and $source.tool_execution_canary_cutover_allowed == false
    and $source.tool_execution_live_cutover_allowed == false
    and $source.tool_invocation_enabled == false
    and $source.ledger_written == false
    and $source.approval_requested == false
    and $source.result_receipt_written == false
    and $ready_count == ($entries | length)
    and $scope_count == ($entries | length)
    and $budget_count == ($entries | length)
    and $rollback_count == ($entries | length)
    and $readback_count == ($entries | length)
    and $selected_count == 1
    and ($selected_count + $preflight_only_count) == ($entries | length)
    and $start_blocked_count == $selected_count
    and ($entries | all(if (.canary_cutover_plan_route == "canary_cutover_plan_ready" or .canary_cutover_plan_route == "preflight_only_non_selected_candidate") then (.registry_guard_route == "require_approval_ledger" and .operator_acceptance_present == false and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .canary_execution_started == false and .canary_result_receipt_written == false and .rollback_executed == false and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .operator_decision_record_write_enabled == false and .operator_decision_receipt_write_enabled == false and .result_receipt_write_enabled == false) else true end))) as $canary_plan_ready |
  {
    runtime:"hepta",
    surface:"tool_execution_canary_cutover_plan",
    plugin_id:$source.plugin_id,
    status:(if $canary_plan_ready then "ready" else "blocked" end),
    source_decision_preflight_surface:$source.surface,
    source_decision_preflight_ready:$source.tool_execution_operator_approval_decision_preflight_ready,
    source_operator_decision_acceptance_allowed:$source.tool_execution_operator_decision_acceptance_allowed,
    source_canary_cutover_allowed:$source.tool_execution_canary_cutover_allowed,
    source_live_cutover_allowed:$source.tool_execution_live_cutover_allowed,
    source_status_canary_spec_surface:"tool_execution_status_canary_spec",
    source_status_canary_spec_ready:true,
    source_status_canary_start_allowed:false,
    status_canary_tool_id:$status_canary_tool_id,
    canary_scope_declared:true,
    canary_budget_declared:true,
    rollback_plan_declared:true,
    canary_readback_receipt_required:true,
    canary_result_receipt_schema_present:true,
    operator_acceptance_present:false,
    canary_cutover_switch_enabled:false,
    live_cutover_switch_enabled:false,
    canary_execution_started:false,
    canary_result_receipt_written:false,
    rollback_executed:false,
    candidate_count:($entries | length),
    canary_cutover_plan_ready_count:$ready_count,
    canary_cutover_plan_blocked_count:(($entries | length) - $ready_count),
    canary_scope_declared_count:$scope_count,
    canary_budget_declared_count:$budget_count,
    rollback_plan_required_count:$rollback_count,
    canary_readback_receipt_required_count:$readback_count,
    canary_start_blocked_count:$start_blocked_count,
    selected_status_canary_count:$selected_count,
    preflight_only_non_selected_count:$preflight_only_count,
    all_decision_preflight_entries_bound_to_canary_plan:($ready_count == ($entries | length) and $scope_count == ($entries | length) and $budget_count == ($entries | length) and $rollback_count == ($entries | length) and $readback_count == ($entries | length) and $start_blocked_count == $selected_count),
    all_status_canary_spec_entries_bound_to_canary_plan:(true and $selected_count == 1 and ($selected_count + $preflight_only_count) == ($entries | length) and ($entries | all(.source_status_canary_spec_ready == true and (.selected_for_status_canary == true or .preflight_only_non_selected_candidate == true)))),
    all_canary_plan_entries_keep_no_invocation_guard:($entries | all(if (.canary_cutover_plan_route == "canary_cutover_plan_ready" or .canary_cutover_plan_route == "preflight_only_non_selected_candidate") then (.registry_guard_route == "require_approval_ledger" and .operator_acceptance_present == false and .canary_cutover_switch_enabled == false and .live_cutover_switch_enabled == false and .canary_execution_started == false and .canary_result_receipt_written == false and .rollback_executed == false and .router_registration_lookup_enabled == false and .registry_lookup_executed == false and .registry_source_of_truth_enabled == false and .tool_registration_enabled == false and .execution_adapter_dispatch_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .operator_decision_record_write_enabled == false and .operator_decision_receipt_write_enabled == false and .result_receipt_write_enabled == false) else true end)),
    tool_execution_canary_cutover_plan_ready:$canary_plan_ready,
    tool_execution_canary_cutover_start_allowed:false,
    tool_execution_canary_result_receipt_write_allowed:false,
    tool_execution_live_cutover_allowed:false,
    router_registration_lookup_enabled:false,
    registry_lookup_executed:false,
    registry_source_of_truth_enabled:false,
    tool_registration_enabled:false,
    execution_adapter_dispatched:false,
    tool_invocation_enabled:false,
    ledger_written:false,
    approval_requested:false,
    operator_decision_record_written:false,
    operator_decision_receipt_written:false,
    result_receipt_written:false,
    live_mutation_ready:false,
    next_migration_step:"restore_tool_execution_canary_readback_receipt_projection_without_invocation",
    entries:$entries,
    blockers:[
      "operator_acceptance_absent",
      "canary_cutover_switch_disabled",
      "canary_execution_not_started",
      "canary_result_receipt_not_written",
      "rollback_not_executed",
      "live_cutover_switch_disabled",
      "tool_invocation_disabled",
      "tool_invocation_ledger_write_disabled",
      "approval_broker_request_disabled",
      "result_receipt_write_disabled"
    ],
    next_actions:[
      "restore_tool_execution_canary_readback_receipt_projection_without_invocation",
      "keep_canary_plan_read_only_until_operator_acceptance_and_cutover_switch_are_explicit",
      "keep_canary_invocation_ledger_approval_receipt_and_live_mutation_disabled"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      rust_contract:"codex-rs/tools/src/tool_execution_canary_cutover_plan.rs",
      operator_approval_decision_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-operator-approval-decision-preflight.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      plugin_cache_mutated:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_decision_record_written:false,
      operator_decision_receipt_written:false,
      operator_acceptance_recorded:false,
      canary_cutover_started:false,
      canary_result_receipt_written:false,
      rollback_executed:false,
      result_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
