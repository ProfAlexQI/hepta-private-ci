#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-receipt-projection.report"
SOURCE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-invocation-ledger-approval-preflight.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_INVOCATION_RECEIPT_PROJECTION_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-invocation-receipt-projection-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable receipt projection report: $REPORT"
[[ -x "$SOURCE_GATE" ]] || fail "missing executable ledger approval preflight gate: $SOURCE_GATE"
[[ -f "$DOC" ]] || fail "missing receipt projection architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the receipt projection report"
fi

grep -q 'Receipt Projection' "$DOC" \
  || fail "architecture note must document Receipt Projection"
grep -q 'readback evidence' "$DOC" \
  || fail "architecture note must document readback evidence"
grep -q 'without execution' "$DOC" \
  || fail "architecture note must document without execution"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_invocation_receipt_projection"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_ledger_approval_preflight_surface == "tool_invocation_ledger_approval_preflight"
  and .source_ledger_approval_preflight_ready == true
  and .receipt_projection_binding_present == true
  and .readback_evidence_binding_present == true
  and .tool_invocation_execution_switch_enabled == false
  and .result_receipt_write_switch_enabled == false
  and .candidate_count == 2
  and .receipt_projection_ready_count == 2
  and .receipt_projection_blocked_count == 0
  and .result_receipt_projection_required_count == 2
  and .readback_evidence_required_count == 2
  and .all_ledger_approval_entries_bound_to_receipt_projection == true
  and .all_receipt_projection_entries_keep_approval_guard == true
  and .tool_invocation_receipt_projection_ready == true
  and .result_receipt_projection_allowed == true
  and .router_registration_lookup_enabled == false
  and .registry_lookup_executed == false
  and .registry_source_of_truth_enabled == false
  and .tool_registration_enabled == false
  and .tool_invocation_enabled == false
  and .ledger_written == false
  and .approval_requested == false
  and .result_receipt_written == false
  and .live_mutation_ready == false
  and .next_migration_step == "restore_tool_execution_dispatch_shadow_without_invocation"
  and (.entries | length) == 2
  and any(.entries[]; .contribution_kind == "mcp_server" and .source_preflight_route == "approval_ledger_preflight_required" and .registry_guard_route == "require_approval_ledger" and .receipt_projection_route == "result_receipt_projection_required" and .receipt_projection_ready == true and .result_receipt_required == true and .readback_evidence_required == true and .receipt_projection_binding_present == true and .readback_evidence_binding_present == true and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and any(.entries[]; .contribution_kind == "app_connector" and .source_preflight_route == "approval_ledger_preflight_required" and .registry_guard_route == "require_approval_ledger" and .receipt_projection_route == "result_receipt_projection_required" and .receipt_projection_ready == true and .result_receipt_required == true and .readback_evidence_required == true and .receipt_projection_binding_present == true and .readback_evidence_binding_present == true and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false and .result_receipt_write_enabled == false)
  and (.blockers | index("result_receipt_write_disabled")) != null
  and (.next_actions | index("restore_tool_execution_dispatch_shadow_without_invocation")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_GATE" >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p codex-tools tool_invocation_receipt_projection --quiet
)

printf 'hepta-systems-tool-invocation-receipt-projection-gate: PASS: ledger-approved plugin tool paths have readback/receipt projection while invocation and receipt writes remain disabled\n'
