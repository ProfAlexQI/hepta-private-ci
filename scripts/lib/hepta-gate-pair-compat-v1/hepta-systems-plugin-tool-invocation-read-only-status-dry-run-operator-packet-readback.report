    ],
    next_actions:[
      "hepta_systems_plugin_tool_invocation_read_only_status_dry_run_acceptance_recording_boundary_readback"
    ],
    recommended_next_gate:"hepta_systems_plugin_tool_invocation_read_only_status_dry_run_acceptance_recording_boundary_readback",
    side_effect_free:true,
    side_effects:{
      report_written:false,
      filesystem_written:false,
      feature_gate_opened:false,
      dry_run_executed:false,
      operator_packet_sent:false,
