#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-dry-run-receipt-ledger-preview-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_packet_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_INVOCATION_READ_ONLY_STATUS_DRY_RUN_OPERATOR_PACKET_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-plugin-tool-invocation-read-only-status-dry-run-operator-packet-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable dry-run receipt ledger preview report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing read-only status dry-run operator packet Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing read-only status dry-run operator packet architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the read-only status dry-run operator packet report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$SOURCE_REPORT" >"$tmpdir/source.json" || fail "failed to render dry-run receipt ledger preview report"
jq -e . "$tmpdir/source.json" >/dev/null || fail "dry-run receipt ledger preview report did not render valid JSON"

lib_export_present=false
if grep -q 'hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_packet_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile source "$tmpdir/source.json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-read-only-status-dry-run-operator-packet-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_INVOCATION_READ_ONLY_STATUS_DRY_RUN_OPERATOR_PACKET_READBACK_2026-06-30.md" \
  '
  def suffix($kind):
    if $kind == "mcp_server" then "local-mcp"
    elif $kind == "app_connector" then "local-app"
    else "unknown"
    end;
  def selected($kind): $kind == "mcp_server";
  def selected_suffix($kind):
    if selected($kind) then "read-only-status-dry-run"
    else "not-selected"
    end;
  def operator_packet_id($kind):
    "operator-packet:hepta-system:" + suffix($kind) + ":" + selected_suffix($kind);
  def operator_checklist_id($kind):
    "operator-checklist:hepta-system:" + suffix($kind) + ":" + selected_suffix($kind);
  def non_acceptance_receipt_id($kind):
    "operator-non-acceptance-receipt:hepta-system:" + suffix($kind) + ":" + selected_suffix($kind);
  def ledger_preview_link_id($kind):
    if selected($kind) then "ledger-preview-link:hepta-system:local-mcp:dry-run-read-only-denied"
    else "ledger-preview-link:hepta-system:" + suffix($kind) + ":not-selected"
    end;
  def receipt_preview_link_id($kind):
    if selected($kind) then "receipt-preview-link:hepta-system:local-mcp:read-only-denied"
    else "receipt-preview-link:hepta-system:" + suffix($kind) + ":not-selected"
    end;
  def policy_denial_anchor_link_id($kind):
    "policy-denial-anchor-link:hepta-system:" + suffix($kind) + ":deny-no-invocation";
  def approval_denial_anchor_link_id($kind):
    "approval-denial-anchor-link:hepta-system:" + suffix($kind) + ":no-request";
  def operator_packet_idempotency_key($kind):
    "operator-packet-idempotency:hepta-system:" + suffix($kind) + ":" + selected_suffix($kind);
  def checklist_items:
    [
      "confirm_feature_gate_remains_closed",
      "confirm_dry_run_execution_remains_disabled",
      "confirm_tool_registry_registration_remains_disabled",
      "confirm_ledger_and_receipt_persistence_remain_disabled",
      "confirm_operator_acceptance_is_absent"
    ];
  def entry($source_entry):
    ($source_entry.contribution_kind) as $kind |
    {
      candidate_tool_id:$source_entry.candidate_tool_id,
      contribution_kind:$kind,
      dry_run_path_selected:$source_entry.dry_run_path_selected,
      source_dry_run_receipt_preview_id:$source_entry.dry_run_receipt_preview_id,
      source_ledger_preview_id:$source_entry.ledger_preview_id,
      source_policy_denial_anchor_id:$source_entry.policy_denial_anchor_id,
      source_approval_denial_anchor_id:$source_entry.approval_denial_anchor_id,
      source_receipt_projection_anchor_id:$source_entry.receipt_projection_anchor_id,
      source_dry_run_idempotency_anchor_id:$source_entry.dry_run_idempotency_anchor_id,
      operator_packet_id:operator_packet_id($kind),
      operator_checklist_id:operator_checklist_id($kind),
      operator_checklist_items:checklist_items,
      non_acceptance_receipt_id:non_acceptance_receipt_id($kind),
      ledger_preview_link_id:ledger_preview_link_id($kind),
      receipt_preview_link_id:receipt_preview_link_id($kind),
      policy_denial_anchor_link_id:policy_denial_anchor_link_id($kind),
      approval_denial_anchor_link_id:approval_denial_anchor_link_id($kind),
      operator_packet_idempotency_key:operator_packet_idempotency_key($kind),
      first_operator_packet_id:operator_packet_id($kind),
      second_operator_packet_id:operator_packet_id($kind),
      first_non_acceptance_receipt_id:non_acceptance_receipt_id($kind),
      second_non_acceptance_receipt_id:non_acceptance_receipt_id($kind),
      first_operator_packet_idempotency_key:operator_packet_idempotency_key($kind),
      second_operator_packet_idempotency_key:operator_packet_idempotency_key($kind),
      operator_packet_id_projected:true,
      operator_checklist_projected:true,
      non_acceptance_receipt_projected:true,
      ledger_preview_link_projected:true,
      receipt_preview_link_projected:true,
      policy_denial_anchor_link_projected:true,
      approval_denial_anchor_link_projected:true,
      idempotency_key_projected:true,
      stable_operator_packet:true,
      unique_operator_packet:true,
      stable_non_acceptance_receipt:true,
      unique_non_acceptance_receipt:true,
      stable_operator_packet_idempotency_key:true,
      unique_operator_packet_idempotency_key:true,
      feature_gate_opened:$source_entry.feature_gate_opened,
      dry_run_executed:$source_entry.dry_run_executed,
      operator_packet_sent:false,
      operator_packet_persisted:false,
      operator_checklist_persisted:false,
      non_acceptance_receipt_persisted:false,
      operator_acceptance_recorded:false,
      dry_run_receipt_preview_persisted:$source_entry.dry_run_receipt_preview_persisted,
      ledger_preview_persisted:$source_entry.ledger_preview_persisted,
      policy_decision_persisted:$source_entry.policy_decision_persisted,
      approval_preflight_executed:$source_entry.approval_preflight_executed,
      ledger_write_attempted:$source_entry.ledger_write_attempted,
      receipt_projection_persisted:$source_entry.receipt_projection_persisted,
      tool_registered:$source_entry.tool_registered,
      tool_registry_mutated:$source_entry.tool_registry_mutated,
      registry_lookup_executed:$source_entry.registry_lookup_executed,
      tool_invoked:$source_entry.tool_invoked,
      noop_result_persisted:$source_entry.noop_result_persisted,
      ledger_written:$source_entry.ledger_written,
      approval_requested:$source_entry.approval_requested,
      receipt_persisted:$source_entry.receipt_persisted,
      dynamic_activation_started:$source_entry.dynamic_activation_started,
      permission_granted:$source_entry.permission_granted,
      mcp_server_started:$source_entry.mcp_server_started,
      app_connector_started:$source_entry.app_connector_started,
      plugin_installed:$source_entry.plugin_installed,
      cache_materialized:$source_entry.cache_materialized,
      cache_mutated:$source_entry.cache_mutated,
      runtime_event_log_written:$source_entry.runtime_event_log_written,
      sqlite_written:$source_entry.sqlite_written,
      live_execution_started:$source_entry.live_execution_started
    };
  ($source[0]) as $source_report |
  ($source_report.entries | map(entry(.))) as $entries |
  ($entries | length) as $packet_entry_count |
  ($entries | map(select(.dry_run_path_selected == true)) | length) as $selected_read_only_status_tool_count |
  ($entries | map(select(.dry_run_path_selected == false)) | length) as $non_selected_preflight_boundary_count |
  ($entries | map(select(.operator_packet_id_projected == true)) | length) as $operator_packet_id_projected_count |
  ($entries | map(select(.operator_checklist_projected == true)) | length) as $operator_checklist_projected_count |
  ($entries | map(.operator_checklist_items | length) | add) as $operator_checklist_item_count |
  ($entries | map(select(.non_acceptance_receipt_projected == true)) | length) as $non_acceptance_receipt_projected_count |
  ($entries | map(select(.ledger_preview_link_projected == true)) | length) as $ledger_preview_link_projected_count |
  ($entries | map(select(.receipt_preview_link_projected == true)) | length) as $receipt_preview_link_projected_count |
  ($entries | map(select(.policy_denial_anchor_link_projected == true)) | length) as $policy_denial_anchor_link_projected_count |
  ($entries | map(select(.approval_denial_anchor_link_projected == true)) | length) as $approval_denial_anchor_link_projected_count |
  ($entries | map(select(.idempotency_key_projected == true)) | length) as $idempotency_key_projected_count |
  ($entries | map(select(.stable_operator_packet == true)) | length) as $stable_operator_packet_count |
  ($entries | map(.first_operator_packet_id) | unique | length) as $unique_operator_packet_count |
  ($entries | map(select(.stable_non_acceptance_receipt == true)) | length) as $stable_non_acceptance_receipt_count |
  ($entries | map(.first_non_acceptance_receipt_id) | unique | length) as $unique_non_acceptance_receipt_count |
  ($entries | map(select(.stable_operator_packet_idempotency_key == true)) | length) as $stable_operator_packet_idempotency_key_count |
  ($entries | map(.first_operator_packet_idempotency_key) | unique | length) as $unique_operator_packet_idempotency_key_count |
  ($entries | map(select(.stable_operator_packet == false)) | length) as $operator_packet_mismatch_count |
  ($packet_entry_count - $unique_operator_packet_count) as $duplicate_operator_packet_count |
  ($entries | map(select(.stable_non_acceptance_receipt == false)) | length) as $non_acceptance_receipt_mismatch_count |
  ($packet_entry_count - $unique_non_acceptance_receipt_count) as $duplicate_non_acceptance_receipt_count |
  ($entries | map(select(.stable_operator_packet_idempotency_key == false)) | length) as $operator_packet_idempotency_mismatch_count |
  ($packet_entry_count - $unique_operator_packet_idempotency_key_count) as $duplicate_operator_packet_idempotency_key_count |
  ($entries | map(select(.feature_gate_opened == true)) | length) as $feature_gate_opened_count |
  ($entries | map(select(.dry_run_executed == true)) | length) as $dry_run_executed_count |
  ($entries | map(select(.operator_packet_sent == true)) | length) as $operator_packet_sent_count |
  ($entries | map(select(.operator_packet_persisted == true)) | length) as $operator_packet_persisted_count |
  ($entries | map(select(.operator_checklist_persisted == true)) | length) as $operator_checklist_persisted_count |
  ($entries | map(select(.non_acceptance_receipt_persisted == true)) | length) as $non_acceptance_receipt_persisted_count |
  ($entries | map(select(.operator_acceptance_recorded == true)) | length) as $operator_acceptance_recorded_count |
  ($entries | map(select(.dry_run_receipt_preview_persisted == true)) | length) as $dry_run_receipt_preview_persisted_count |
  ($entries | map(select(.ledger_preview_persisted == true)) | length) as $ledger_preview_persisted_count |
  ($entries | map(select(.policy_decision_persisted == true)) | length) as $policy_decision_persisted_count |
  ($entries | map(select(.approval_preflight_executed == true)) | length) as $approval_preflight_executed_count |
  ($entries | map(select(.ledger_write_attempted == true)) | length) as $ledger_write_attempted_count |
  ($entries | map(select(.receipt_projection_persisted == true)) | length) as $receipt_projection_persisted_count |
  ($entries | map(select(.tool_registered == true)) | length) as $tool_registered_count |
  ($entries | map(select(.tool_registry_mutated == true)) | length) as $tool_registry_mutated_count |
  ($entries | map(select(.registry_lookup_executed == true)) | length) as $registry_lookup_executed_count |
  ($entries | map(select(.tool_invoked == true)) | length) as $tool_invoked_count |
  ($entries | map(select(.noop_result_persisted == true)) | length) as $noop_result_persisted_count |
  ($entries | map(select(.ledger_written == true)) | length) as $ledger_written_count |
  ($entries | map(select(.approval_requested == true)) | length) as $approval_requested_count |
  ($entries | map(select(.receipt_persisted == true)) | length) as $receipt_persisted_count |
  ($entries | map(select(.dynamic_activation_started == true)) | length) as $dynamic_activation_started_count |
  ($entries | map(select(.permission_granted == true)) | length) as $permission_granted_count |
  ($entries | map(select(.mcp_server_started == true)) | length) as $mcp_server_started_count |
  ($entries | map(select(.app_connector_started == true)) | length) as $app_connector_started_count |
  ($entries | map(select(.plugin_installed == true)) | length) as $plugin_installed_count |
  ($entries | map(select(.cache_materialized == true)) | length) as $cache_materialized_count |
  ($entries | map(select(.cache_mutated == true)) | length) as $cache_mutated_count |
  ($entries | map(select(.runtime_event_log_written == true)) | length) as $runtime_event_log_written_count |
  ($entries | map(select(.sqlite_written == true)) | length) as $sqlite_written_count |
  ($entries | map(select(.live_execution_started == true)) | length) as $live_execution_started_count |
  ($source_report.dry_run_receipt_ledger_preview_readback_ready == true
    and $source_report.candidate_count == 2
    and $source_report.selected_read_only_status_tool_count == 1
    and $source_report.non_selected_preflight_boundary_count == 1
    and $source_report.dry_run_receipt_preview_id_projected_count == 2
    and $source_report.ledger_preview_id_projected_count == 2
    and $source_report.stable_preview_receipt_count == 2
    and $source_report.unique_preview_receipt_count == 2
    and $source_report.stable_preview_idempotency_key_count == 2
    and $source_report.unique_preview_idempotency_key_count == 2
    and $source_report.feature_gate_opened_count == 0
    and $source_report.dry_run_executed_count == 0
    and $source_report.tool_invoked_count == 0
    and $source_report.ledger_written_count == 0
    and $source_report.receipt_persisted_count == 0
    and $source_report.live_execution_started_count == 0
    and $lib_export_present == true
    and $packet_entry_count == 2
    and $selected_read_only_status_tool_count == 1
    and $non_selected_preflight_boundary_count == 1
    and $operator_packet_id_projected_count == 2
    and $operator_checklist_projected_count == 2
    and $operator_checklist_item_count == 10
    and $non_acceptance_receipt_projected_count == 2
    and $ledger_preview_link_projected_count == 2
    and $receipt_preview_link_projected_count == 2
    and $policy_denial_anchor_link_projected_count == 2
    and $approval_denial_anchor_link_projected_count == 2
    and $idempotency_key_projected_count == 2
    and $stable_operator_packet_count == 2
    and $unique_operator_packet_count == 2
    and $stable_non_acceptance_receipt_count == 2
    and $unique_non_acceptance_receipt_count == 2
    and $stable_operator_packet_idempotency_key_count == 2
    and $unique_operator_packet_idempotency_key_count == 2
    and $operator_packet_mismatch_count == 0
    and $duplicate_operator_packet_count == 0
    and $non_acceptance_receipt_mismatch_count == 0
    and $duplicate_non_acceptance_receipt_count == 0
    and $operator_packet_idempotency_mismatch_count == 0
    and $duplicate_operator_packet_idempotency_key_count == 0
    and $feature_gate_opened_count == 0
    and $dry_run_executed_count == 0
    and $operator_packet_sent_count == 0
    and $operator_packet_persisted_count == 0
    and $operator_checklist_persisted_count == 0
    and $non_acceptance_receipt_persisted_count == 0
    and $operator_acceptance_recorded_count == 0
    and $ledger_written_count == 0
    and $approval_requested_count == 0
    and $receipt_persisted_count == 0
    and $runtime_event_log_written_count == 0
    and $sqlite_written_count == 0
    and $live_execution_started_count == 0) as $ready |
  {
    runtime:"hepta",
    surface:"hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_packet_readback",
    status:(if $ready then "ready_blocked" else "blocked" end),
    gate:"hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_packet_readback_gate",
    schema_version:"hepta_systems_plugin_tool_invocation_read_only_status_dry_run_operator_packet_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    manifest_name:$source_report.manifest_name,
    manifest_version:$source_report.manifest_version,
    source_dry_run_receipt_ledger_preview_ready:$source_report.dry_run_receipt_ledger_preview_readback_ready,
    lib_export_present:$lib_export_present,
    local_gate:$gate,
    architecture_note:$doc,
    candidate_count:$source_report.candidate_count,
    packet_entry_count:$packet_entry_count,
    selected_read_only_status_tool_count:$selected_read_only_status_tool_count,
    non_selected_preflight_boundary_count:$non_selected_preflight_boundary_count,
    operator_packet_id_projected_count:$operator_packet_id_projected_count,
    operator_checklist_projected_count:$operator_checklist_projected_count,
    operator_checklist_item_count:$operator_checklist_item_count,
    non_acceptance_receipt_projected_count:$non_acceptance_receipt_projected_count,
    ledger_preview_link_projected_count:$ledger_preview_link_projected_count,
    receipt_preview_link_projected_count:$receipt_preview_link_projected_count,
    policy_denial_anchor_link_projected_count:$policy_denial_anchor_link_projected_count,
    approval_denial_anchor_link_projected_count:$approval_denial_anchor_link_projected_count,
    idempotency_key_projected_count:$idempotency_key_projected_count,
    stable_operator_packet_count:$stable_operator_packet_count,
    unique_operator_packet_count:$unique_operator_packet_count,
    stable_non_acceptance_receipt_count:$stable_non_acceptance_receipt_count,
    unique_non_acceptance_receipt_count:$unique_non_acceptance_receipt_count,
    stable_operator_packet_idempotency_key_count:$stable_operator_packet_idempotency_key_count,
    unique_operator_packet_idempotency_key_count:$unique_operator_packet_idempotency_key_count,
    operator_packet_mismatch_count:$operator_packet_mismatch_count,
    duplicate_operator_packet_count:$duplicate_operator_packet_count,
    non_acceptance_receipt_mismatch_count:$non_acceptance_receipt_mismatch_count,
    duplicate_non_acceptance_receipt_count:$duplicate_non_acceptance_receipt_count,
    operator_packet_idempotency_mismatch_count:$operator_packet_idempotency_mismatch_count,
    duplicate_operator_packet_idempotency_key_count:$duplicate_operator_packet_idempotency_key_count,
    feature_gate_opened_count:$feature_gate_opened_count,
    dry_run_executed_count:$dry_run_executed_count,
    operator_packet_sent_count:$operator_packet_sent_count,
    operator_packet_persisted_count:$operator_packet_persisted_count,
    operator_checklist_persisted_count:$operator_checklist_persisted_count,
    non_acceptance_receipt_persisted_count:$non_acceptance_receipt_persisted_count,
    operator_acceptance_recorded_count:$operator_acceptance_recorded_count,
    dry_run_receipt_preview_persisted_count:$dry_run_receipt_preview_persisted_count,
    ledger_preview_persisted_count:$ledger_preview_persisted_count,
    policy_decision_persisted_count:$policy_decision_persisted_count,
    approval_preflight_executed_count:$approval_preflight_executed_count,
    ledger_write_attempted_count:$ledger_write_attempted_count,
    receipt_projection_persisted_count:$receipt_projection_persisted_count,
    tool_registered_count:$tool_registered_count,
    tool_registry_mutated_count:$tool_registry_mutated_count,
    registry_lookup_executed_count:$registry_lookup_executed_count,
    tool_invoked_count:$tool_invoked_count,
    noop_result_persisted_count:$noop_result_persisted_count,
    ledger_written_count:$ledger_written_count,
    approval_requested_count:$approval_requested_count,
    receipt_persisted_count:$receipt_persisted_count,
    dynamic_activation_started_count:$dynamic_activation_started_count,
    permission_granted_count:$permission_granted_count,
    mcp_server_started_count:$mcp_server_started_count,
    app_connector_started_count:$app_connector_started_count,
    plugin_installed_count:$plugin_installed_count,
    cache_materialized_count:$cache_materialized_count,
    cache_mutated_count:$cache_mutated_count,
    runtime_event_log_written_count:$runtime_event_log_written_count,
    sqlite_written_count:$sqlite_written_count,
    live_execution_started_count:$live_execution_started_count,
    operator_packet_readback_ready:$ready,
    feature_gate_open_allowed:false,
    dry_run_execution_allowed:false,
    operator_packet_send_allowed:false,
    operator_packet_persistence_allowed:false,
    operator_checklist_persistence_allowed:false,
    non_acceptance_receipt_persistence_allowed:false,
    operator_acceptance_recording_allowed:false,
    dry_run_receipt_preview_persistence_allowed:false,
    ledger_preview_persistence_allowed:false,
    policy_decision_persistence_allowed:false,
    approval_preflight_execution_allowed:false,
    ledger_write_allowed:false,
    receipt_projection_persistence_allowed:false,
    tool_registry_registration_allowed:false,
    tool_registry_mutation_allowed:false,
    registry_lookup_execution_allowed:false,
    tool_invocation_allowed:false,
    noop_result_persistence_allowed:false,
