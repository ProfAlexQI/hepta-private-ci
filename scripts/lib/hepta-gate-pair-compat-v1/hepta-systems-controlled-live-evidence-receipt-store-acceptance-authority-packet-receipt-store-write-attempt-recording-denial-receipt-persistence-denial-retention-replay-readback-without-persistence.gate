HEPTA_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_WRITE_ATTEMPT_RECORDING_DENIAL_RECEIPT_PERSISTENCE_DENIAL_JSON="$source_json" \
  "$REPORT" >"$target_json" || fail "failed to render write-attempt recording denial receipt persistence denial retention/replay report from cached source"
