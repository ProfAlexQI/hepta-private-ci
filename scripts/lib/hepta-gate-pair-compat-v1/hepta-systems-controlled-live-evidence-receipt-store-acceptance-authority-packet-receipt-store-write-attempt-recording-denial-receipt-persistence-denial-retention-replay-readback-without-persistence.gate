rg -q 'controlled live evidence receipt store acceptance authority packet receipt-store write attempt recording denial receipt persistence denial retention/replay readback without persistence' "$DOC" \
  || fail "architecture note must document write attempt recording denial receipt persistence denial retention/replay readback without persistence"
