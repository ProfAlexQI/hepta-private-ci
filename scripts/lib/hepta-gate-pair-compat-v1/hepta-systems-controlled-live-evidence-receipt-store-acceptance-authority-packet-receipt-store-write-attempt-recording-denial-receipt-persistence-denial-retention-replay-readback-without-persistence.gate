    and (.retention_readback_route | startswith("readback://controlled-live/evidence-receipt-store/acceptance-authority-packet/receipt-store-write-attempt-recording-denial-receipts/persistence-denial/retention-replay/readback/"))
    and (.garbage_collection_denial_id | startswith("write-attempt-recording-denial-persistence-denial-gc-denial:controlled-live-evidence-receipt-store:"))
