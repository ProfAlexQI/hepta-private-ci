#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-acceptance-authority-packet-receipt-store-write-attempt-recording-denial-receipt-persistence-denial-terminal-no-persistence-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/controlled_live_evidence_receipt_store_local_evidence_receipt_store_open_preconditions_readback_without_write.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_LOCAL_EVIDENCE_RECEIPT_STORE_OPEN_PRECONDITIONS_READBACK_WITHOUT_WRITE_2026-07-07.md"

fail() {
  printf 'hepta-systems-controlled-live-evidence-receipt-store-local-evidence-receipt-store-open-preconditions-readback-without-write-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable terminal no-persistence source report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing local evidence receipt-store open-preconditions Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the local evidence receipt-store open-preconditions report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

lib_export_present=false
if grep -q 'controlled_live_evidence_receipt_store_local_evidence_receipt_store_open_preconditions_readback_without_write_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

source_json="${HEPTA_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_TERMINAL_NO_PERSISTENCE_JSON:-}"
source_cache_input_present=false
source_report_render_count=0
if [[ -n "$source_json" ]]; then
  [[ -f "$source_json" ]] || fail "missing cached terminal no-persistence report: $source_json"
  source_cache_input_present=true
else
  source_json="$tmpdir/terminal-no-persistence.json"
  "$SOURCE_REPORT" >"$source_json" || fail "failed to render terminal no-persistence report"
  source_report_render_count=1
fi
jq -e . "$source_json" >/dev/null || fail "terminal no-persistence report did not render valid JSON"

jq -n \
  --slurpfile source "$source_json" \
  --argjson lib_export_present "$lib_export_present" \
  --argjson source_cache_input_present "$source_cache_input_present" \
  --argjson source_report_render_count "$source_report_render_count" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-evidence-receipt-store-local-evidence-receipt-store-open-preconditions-readback-without-write.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_CONTROLLED_LIVE_EVIDENCE_RECEIPT_STORE_LOCAL_EVIDENCE_RECEIPT_STORE_OPEN_PRECONDITIONS_READBACK_WITHOUT_WRITE_2026-07-07.md" \
  --arg precondition_route "readback://controlled-live/evidence-receipt-store/local-open-preconditions" \
  '
  def hyphen_id($id):
    $id | gsub("_"; "-");
  ($source[0]) as $src |
  ($src.entries | map({
    id:("evidence_receipt_store_local_evidence_receipt_store_open_preconditions_without_write_" + .source_blocker_id),
    source_blocker_id,
    source_terminal_closeout_id:.terminal_closeout_id,
    source_terminal_closeout_key:.terminal_closeout_key,
    source_terminal_closeout_route:.terminal_closeout_route,
    source_terminal_reason:.terminal_reason,
    source_persistence_denial_id,
    local_open_precondition_set_id:("local-evidence-receipt-store-open-preconditions:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    local_open_precondition_route:($precondition_route + "/" + hyphen_id(.source_blocker_id)),
    operator_local_store_approval_id:("operator-local-store-approval:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    dev_evidence_acceptance_source_id:("dev-evidence-acceptance-source:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    evidence_acceptance_key:("controlled_live.local_evidence_acceptance.required." + .source_blocker_id),
    local_receipt_store_feature_gate:("feature-gate:controlled-live-local-evidence-receipt-store:" + .source_blocker_id),
    append_only_store_path_grant_key:("append-only-store-path-grant:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    atomic_append_plan_id:("atomic-append-plan:controlled-live-local-evidence-receipt-store:" + .source_blocker_id),
    post_append_readback_route:("readback://controlled-live/evidence-receipt-store/local-open-preconditions/post-append/" + hyphen_id(.source_blocker_id)),
    rollback_anchor_route:("readback://controlled-live/evidence-receipt-store/local-open-preconditions/rollback-anchor/" + hyphen_id(.source_blocker_id)),
    retention_policy_id:("retention-policy:controlled-live-local-evidence-receipt-store:" + .source_blocker_id),
