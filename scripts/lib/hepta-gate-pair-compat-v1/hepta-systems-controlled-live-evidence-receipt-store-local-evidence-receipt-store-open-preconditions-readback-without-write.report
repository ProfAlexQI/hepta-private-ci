    receipt_store_write_attempt_recorded:false,
    receipt_store_write_allowed:false,
    receipt_store_written:false,
    receipt_persistence_allowed:false,
    receipt_persisted:false,
    ledger_write_allowed:false,
    ledger_written:false,
    workflow_event_log_write_allowed:false,
    workflow_event_log_written:false,
    sqlite_write_allowed:false,
    sqlite_written:false,
    credential_read_allowed:false,
    live_mutation_allowed:false
  })) as $entries |
  ($entries | map(select(.source_terminal_closeout_attached == true)) | length) as $source_terminal_closeout_attached_count |
  ($entries | map(select(.operator_local_store_approval_required == true)) | length) as $operator_local_store_approval_required_count |
  ($entries | map(select(.operator_local_store_approval_present == true)) | length) as $operator_local_store_approval_present_count |
  ($entries | map(select(.dev_evidence_acceptance_source_required == true)) | length) as $dev_evidence_acceptance_source_required_count |
  ($entries | map(select(.dev_evidence_acceptance_source_present == true)) | length) as $dev_evidence_acceptance_source_present_count |
  ($entries | map(select(.evidence_acceptance_required == true)) | length) as $evidence_acceptance_required_count |
  ($entries | map(select(.evidence_acceptance_present == true)) | length) as $evidence_acceptance_present_count |
  ($entries | map(select(.local_receipt_store_feature_gate_required == true)) | length) as $local_receipt_store_feature_gate_required_count |
  ($entries | map(select(.local_receipt_store_feature_gate_enabled == true)) | length) as $local_receipt_store_feature_gate_enabled_count |
