#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ATTACHMENT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-safe-chain-final-index-terminal-denial-index.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TERMINAL_DENIAL_INDEX_ATTACHMENT_READBACK_2026-06-21.md"

fail() {
  printf 'hepta-systems-terminal-denial-index-attachment-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$ATTACHMENT_REPORT" ]] || fail "missing executable terminal denial index attachment report: $ATTACHMENT_REPORT"
[[ -f "$DOC" ]] || fail "missing terminal denial index attachment readback architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the terminal denial index attachment readback report"
fi

jq -n \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-denial-index-attachment-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_TERMINAL_DENIAL_INDEX_ATTACHMENT_READBACK_2026-06-21.md" \
  '
  [
    {id:"approval_control", blocker_count:4, queryable:true, operator_visible:true, side_effect_free:true},
    {id:"execution_and_receipts", blocker_count:9, queryable:true, operator_visible:true, side_effect_free:true},
    {id:"runner_selector", blocker_count:2, queryable:true, operator_visible:true, side_effect_free:true},
    {id:"dirty_worktree_owner_freeze", blocker_count:2, queryable:true, operator_visible:true, side_effect_free:true}
  ] as $backfeed_categories |
  [
    {id:"terminal_denial_index_attachment_ready", observed:true, expected:true},
    {id:"terminal_denial_index_gate_present", observed:true, expected:true},
    {id:"terminal_denial_index_gate_invoked", observed:false, expected:false},
    {id:"terminal_denial_index_recorded", observed:false, expected:false},
    {id:"terminal_denial_index_persisted", observed:false, expected:false},
    {id:"terminal_denial_index_materialized", observed:false, expected:false},
    {id:"terminal_denial_index_filesystem_written", observed:false, expected:false},
    {id:"terminal_release_governance_final_audit_gate_invoked", observed:false, expected:false},
    {id:"terminal_release_artifact_non_write_lock_gate_invoked", observed:false, expected:false},
    {id:"terminal_public_distribution_non_publication_lock_gate_invoked", observed:false, expected:false},
    {id:"terminal_non_activation_release_claim_index_gate_invoked", observed:false, expected:false},
    {id:"terminal_operator_readiness_non_approval_index_gate_invoked", observed:false, expected:false},
    {id:"terminal_summary_gates_invoked", observed:false, expected:false},
    {id:"terminal_live_gates_invoked", observed:false, expected:false},
    {id:"canonical_gate_wrapper_invoked", observed:false, expected:false},
    {id:"wrapper_target_invoked", observed:false, expected:false},
    {id:"public_release_claim_allowed", observed:false, expected:false},
    {id:"operator_approval_recorded", observed:false, expected:false},
    {id:"operator_identity_accepted", observed:false, expected:false},
    {id:"rollback_execution_allowed", observed:false, expected:false},
    {id:"canonical_terminal_closure_backfeed_ready", observed:true, expected:true},
    {id:"canonical_terminal_closure_backfeed_blocker_count", observed:($backfeed_categories | map(.blocker_count) | add), expected:17},
    {id:"canonical_terminal_closure_backfeed_category_count", observed:($backfeed_categories | length), expected:4},
    {
      id:"canonical_terminal_closure_backfeed_category_ready_count",
      observed:($backfeed_categories | map(select(.queryable == true and .operator_visible == true and .side_effect_free == true)) | length),
      expected:4
    },
    {id:"canonical_terminal_closure_backfeed_category_blocker_count", observed:($backfeed_categories | map(.blocker_count) | add), expected:17},
    {id:"canonical_terminal_closure_backfeed_categorization_ready", observed:(($backfeed_categories | map(.blocker_count) | add) == 17), expected:true}
  ] as $readback_checks |
  ($readback_checks | all(.observed == .expected)) as $readback_ready |
  {
    runtime:"hepta",
    surface:"terminal_denial_index_attachment_readback",
    plugin_id:"hepta-system@hepta-local",
    status:(if $readback_ready then "ready_blocked" else "blocked" end),
    readback_mode:"static_terminal_denial_index_attachment_snapshot_only",
    source_terminal_denial_index_attachment_surface:"terminal_release_governance_safe_chain_final_index_terminal_denial_index",
    source_terminal_denial_index_attachment_basis:"verified_terminal_denial_index_attachment_snapshot",
    source_terminal_denial_index_attachment_report_reexecuted:false,
    source_terminal_denial_index_attachment_ready:true,
    source_terminal_denial_index_attachment_blocked:true,
    terminal_denial_index_attachment_readback_ready:$readback_ready,
    terminal_denial_index_attachment_readback_blocked:true,
    readback_check_count:($readback_checks | length),
    readback_checks:$readback_checks,
    terminal_release_governance_safe_chain_closure_final_index_attached:true,
    terminal_denial_index_gate_present:true,
    terminal_denial_index_doc_present:true,
    terminal_denial_index_gate_invoked:false,
    terminal_denial_index_recorded:false,
    terminal_denial_index_persisted:false,
    terminal_denial_index_materialized:false,
    terminal_denial_index_filesystem_written:false,
    source_canonical_governance_tool_execution_closure_backfeed_ready:true,
    source_canonical_governance_tool_execution_closure_backfeed_blocker_count:($backfeed_categories | map(.blocker_count) | add),
    source_canonical_governance_tool_execution_closure_backfeed_category_count:($backfeed_categories | length),
    source_canonical_governance_tool_execution_closure_backfeed_category_ready_count:($backfeed_categories | map(select(.queryable == true and .operator_visible == true and .side_effect_free == true)) | length),
    source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count:($backfeed_categories | map(.blocker_count) | add),
    source_canonical_governance_tool_execution_closure_backfeed_categorization_ready:(($backfeed_categories | map(.blocker_count) | add) == 17),
    source_canonical_governance_tool_execution_closure_backfeed_categories:$backfeed_categories,
    terminal_release_governance_final_audit_gate_invoked:false,
    terminal_release_artifact_non_write_lock_gate_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_non_activation_release_claim_index_gate_invoked:false,
    terminal_operator_readiness_non_approval_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    attachment_blocker_count:30,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_release_claim_allowed:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    next_migration_step:"derive_terminal_denial_index_attachment_final_index_without_terminal_denial_gate_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      terminal_denial_index_attachment_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-release-governance-safe-chain-final-index-terminal-denial-index.report"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      terminal_denial_index_gate_invoked:false,
      terminal_denial_index_recorded:false,
      terminal_denial_index_persisted:false,
      terminal_denial_index_materialized:false,
      terminal_denial_index_filesystem_written:false,
      terminal_operator_readiness_non_approval_index_gate_invoked:false,
      operator_readiness_index_recorded:false,
      operator_readiness_index_persisted:false,
      operator_approval_recorded:false,
      operator_identity_accepted:false,
      rollback_executed:false,
      terminal_non_activation_release_claim_index_gate_invoked:false,
      release_claim_index_recorded:false,
      release_claim_index_persisted:false,
      public_release_claim_recorded:false,
      terminal_public_distribution_non_publication_lock_gate_invoked:false,
      public_distribution_published:false,
      terminal_release_artifact_non_write_lock_gate_invoked:false,
      terminal_release_governance_gate_invoked:false,
      release_artifact_written:false,
      terminal_summary_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      canonical_gate_invoked:false,
      wrapper_target_invoked:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
