#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-role-manifest-enforcement-gap-closure-application-preview.report"

report="$(capture_json_report "hepta-work-graph-role-manifest-enforcement-gap-closure-application-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_role_manifest_enforcement_gap_closure_application_preview_gate"
  and .schema_version == "work_graph_role_manifest_enforcement_gap_closure_application_preview_v1"
  and .preview_mode == "read_only_role_manifest_gap_closure_application_preview_no_runtime_mutation"
  and .readback_plan_count == 4
  and .application_plan_count == 4
  and .source_outcome_count == 4
  and .role_manifest_contract_ready_preview_count == 4
  and .blocker_application_count == 10
  and .application_group_count == 5
  and .role_binding_ref_count == 24
  and .capability_ref_count == 13
  and .permission_mode_ref_count == 12
  and .manifest_field_ref_count == 27
  and .application_guard_count == 12
  and .blocker_count == 12
  and (.application_plans | length) == .application_plan_count
  and (.source_outcomes | length) == .source_outcome_count
  and (.blocker_applications | length) == .blocker_application_count
  and (.application_groups | length) == .application_group_count
  and (.application_guards | length) == .application_guard_count
  and (.blockers | length) == .blocker_count
' >/dev/null <<<"$report"

jq -e '
  (.application_plans | map(.source_surface_id) == [
    "multi_agent_v2_thread_spawn",
    "agent_jobs_batch_workers",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_agent_harness"
  ])
  and (.application_plans | all(
    .application_scope == "role_manifest_runtime_enforcement_binding"
    and .application_state == "preview_application_defined_role_manifest_not_attached"
    and .readback_verified_by_preview == true
    and .applies_to_runtime == false
    and .enforces_role_manifest == false
    and .changes_tool_permissions == false
    and .consumes_budget == false
    and .mutates_lane_binding == false
    and .starts_work == false
    and .spawns_agent == false
    and .writes_store == false
    and .enables_append_only_store == false
    and .enforces_scheduler_admission == false
    and (.role_binding_ids | length) == 6
  ))
  and (.application_plans | map(select(
    .source_surface_id == "hepta_runtime_agent_harness"
    and .projected_role_kind == "external_handoff_role"
    and .role_blocker_id == "agent_harness_role_manifest_not_enforced"
    and .readback_probe_id == "role_manifest_readback_probe:hepta_runtime_agent_harness"
  )) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  (.source_outcomes | all(
    .post_application_role_manifest_state == "role_manifest_contract_ready_preview_after_application"
    and .role_manifest_contract_ready_preview == true
    and .ready_for_unified_projection_enforcement_readiness_role_manifest_rerun_preview == true
    and .ready_for_role_manifest_enforcement == false
    and .applies_to_runtime == false
  ))
  and (.blocker_applications | all(
    .expected_blocker_state == "blocker_mapping_contract_ready_preview_after_application_runtime_still_blocked"
    and .blocker_contract_ready_preview == true
    and .readback_verified_by_preview == true
    and .clears_runtime_blocker == false
    and .mutates_runtime == false
  ))
' >/dev/null <<<"$report"

jq -e '
  (.application_groups | map({id, count: (.application_plan_ids | length)}) == [
    {"id": "role_capability_binding_application", "count": 4},
    {"id": "role_tool_permission_binding_application", "count": 4},
    {"id": "role_budget_lane_binding_application", "count": 4},
    {"id": "role_termination_output_schema_application", "count": 4},
    {"id": "role_source_adapter_binding_application", "count": 4}
  ])
  and (.application_groups | all(
    .priority == "p0"
    and .expected_role_manifest_ready_source_count_after_application == 4
    and .mutates_runtime == false
    and .enforces_role_manifest == false
    and .starts_work == false
    and .spawns_agent == false
  ))
' >/dev/null <<<"$report"

jq -e '
  (.application_guards | map(.id) == [
    "role_manifest_application_is_preview_only",
    "readback_execution_disabled",
    "role_manifest_enforcement_disabled",
    "role_capability_binding_not_enforced",
    "tool_permission_binding_not_enforced",
    "budget_lane_concurrency_not_enforced",
    "termination_output_schema_not_enforced",
    "scheduler_admission_runtime_application_disabled",
    "projection_timeline_runtime_residuals_not_promoted",
    "append_only_store_runtime_enablement_disabled",
    "operator_review_required",
    "enforcement_readiness_role_manifest_rerun_required"
  ])
  and (.application_guards | all(
    .required_before_role_manifest_enforcement == true
    and .satisfied_by_preview == false
  ))
  and (.blockers | map({id, count: (.affected_source_surface_ids | length)}) == [
    {"id": "role_manifest_application_is_preview_only", "count": 4},
    {"id": "readback_execution_disabled", "count": 4},
    {"id": "role_manifest_enforcement_disabled", "count": 4},
    {"id": "role_capability_binding_not_enforced", "count": 4},
    {"id": "tool_permission_binding_not_enforced", "count": 4},
    {"id": "budget_lane_concurrency_not_enforced", "count": 4},
    {"id": "termination_output_schema_not_enforced", "count": 4},
    {"id": "scheduler_admission_runtime_application_disabled", "count": 3},
    {"id": "projection_timeline_runtime_residuals_not_promoted", "count": 4},
    {"id": "append_only_store_runtime_enablement_disabled", "count": 4},
    {"id": "operator_review_required", "count": 4},
    {"id": "role_manifest_readiness_rerun_missing", "count": 4}
  ])
  and (.blockers | all(.required_before_role_manifest_enforcement == true))
' >/dev/null <<<"$report"

jq -e '
  .required_prior_gate_count == 38
  and (.required_prior_gates | length == (unique | length))
  and (.required_prior_gates[-1] == "hepta_work_graph_role_manifest_enforcement_gap_closure_readback_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_unified_projection_enforcement_readiness_role_manifest_rerun_preview_gate"
  and .ready_for_unified_projection_enforcement_readiness_role_manifest_rerun_preview == true
  and .ready_for_role_manifest_enforcement == false
  and .ready_for_scheduler_admission_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_projection_enforcement == false
  and .ready_for_live_execution == false
  and .source_probes.role_manifest_gap_closure_application.rust_module_present == true
  and .source_probes.role_manifest_gap_closure_application.report_script_present == true
  and .source_probes.role_manifest_gap_closure_application.gate_script_present == true
  and .source_probes.role_manifest_gap_closure_readback.upstream_gate == true
  and .source_probes.role_manifest_gap_closure_readback.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_role_manifest_enforcement_gap_closure_application --lib

echo "Hepta WorkGraph role manifest enforcement gap closure application preview gate passed"
