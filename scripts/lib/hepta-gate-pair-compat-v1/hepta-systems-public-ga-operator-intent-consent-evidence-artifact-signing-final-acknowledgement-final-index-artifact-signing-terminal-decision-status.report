#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-operator-identity-session-intent-consent-evidence-artifact-signing-final-acknowledgement-final-index.report"
TERMINAL_DECISION_GATE="$ROOT/scripts/hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-status-promotion-denial-gate.sh"
TERMINAL_DECISION_DOC="$ROOT/docs/architecture/HEPTA_MEMORY_INTELLIGENCE_KG_FULL_LIVE_ACTIVATION_ARTIFACT_SIGNING_TERMINAL_STATUS_PROMOTION_DENIAL_GATE.md"

[[ -x "$SOURCE_REPORT" ]] || {
  echo "missing executable Public GA operator identity/session intent consent evidence artifact signing final acknowledgement final index report: $SOURCE_REPORT" >&2
  exit 1
}
[[ -f "$TERMINAL_DECISION_GATE" ]] || {
  echo "missing operator identity/session intent consent evidence artifact signing terminal decision/status promotion denial gate: $TERMINAL_DECISION_GATE" >&2
  exit 1
}
[[ -f "$TERMINAL_DECISION_DOC" ]] || {
  echo "missing operator identity/session intent consent evidence artifact signing terminal decision/status promotion denial doc: $TERMINAL_DECISION_DOC" >&2
  exit 1
}

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to build the Public GA operator identity/session intent consent evidence artifact signing terminal decision/status report" >&2
  exit 1
fi

source_json="$("$SOURCE_REPORT")"

jq -e '
  .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_blocked == true
  and .final_operator_acknowledgement_accepted == false
  and .acknowledgement_acceptance_recorded == false
  and .operator_approval_from_acknowledgement_derived == false
  and .activation_authority_from_acknowledgement_derived == false
' <<<"$source_json" >/dev/null

terminal_decision_status_static_mention_count="$(
  grep -Ec 'terminal|decision|status|promotion|accepted|approval|authority|download|install|restart|active-binary|telegram|external|live' "$TERMINAL_DECISION_GATE" || true
)"

jq -n \
  --argjson source "$source_json" \
  --argjson terminal_decision_status_static_mention_count "$terminal_decision_status_static_mention_count" \
  '{
    runtime: "hepta",
    surface: "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_attachment",
    plugin_id: "hepta-system@hepta-local",
    status: "ready_blocked",
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_surface: $source.surface,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_ready: $source.public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_ready,
    source_public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_blocked: $source.public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_blocked,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_final_index_attached: true,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_attachment_ready: true,
    public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_attachment_blocked: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_denial_gate_present: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_denial_doc_present: true,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_static_mention_count: $terminal_decision_status_static_mention_count,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_decision_status_promotion_denial_gate_invoked: false,
    operator_identity_session_operator_intent_consent_evidence_artifact_signing_final_acknowledgement_non_acceptance_gate_invoked: false,
    long_soak_required_by_source_artifact_signing_terminal_decision_status_gate: true,
    long_soak_started: false,
    final_operator_acknowledgement_accepted: false,
    acknowledgement_acceptance_recorded: false,
    terminal_decision_requested: false,
    status_promotion_requested: false,
    terminal_decision_allowed: false,
    status_promotion_allowed: false,
    terminal_decision_accepted: false,
    terminal_decision_recorded: false,
    terminal_decision_persisted: false,
    terminal_decision_materialized: false,
