    retention_policy_route:($collection_route + "/retention/" + hyphen_id(.source_blocker_id)),
    expiry_guard_id:("local-evidence-acceptance-authority-decision-recording-positive-preconditions-recording-denial-receipt-expiry-guard:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    replay_key:("local-evidence-acceptance-authority-decision-recording-positive-preconditions-recording-denial-receipt-replay-key:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    replay_idempotency_key:("local-evidence-acceptance-authority-decision-recording-positive-preconditions-recording-denial-receipt-replay-idempotency:controlled-live-evidence-receipt-store:" + .source_blocker_id),
    replay_readback_route:($collection_route + "/replay/" + hyphen_id(.source_blocker_id)),
