#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PREFLIGHT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-name-reintroduction-preflight.report"
PREFLIGHT_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-name-reintroduction-preflight.gate"
PHASE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.gate"
WRAPPER_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_STRICT_MISSING_CONSUMER_PHASE_MIGRATION_2026-06-21.md"

fail() {
  printf 'hepta-systems-strict-missing-consumer-phase-migration-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PREFLIGHT_REPORT" ]] || fail "missing executable historical canonical gate name preflight report: $PREFLIGHT_REPORT"
[[ -x "$PREFLIGHT_GATE" ]] || fail "missing executable historical canonical gate name preflight gate: $PREFLIGHT_GATE"
[[ -x "$PHASE_GATE" ]] || fail "missing executable canonical summary attachment phase index gate: $PHASE_GATE"
[[ -x "$WRAPPER_GATE" ]] || fail "missing executable current canonical wrapper gate: $WRAPPER_GATE"
[[ -f "$DOC" ]] || fail "missing strict-missing consumer phase migration architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the strict-missing consumer phase migration report"
fi

jq -n \
  --slurpfile preflight <("$PREFLIGHT_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-strict-missing-consumer-phase-migration.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_STRICT_MISSING_CONSUMER_PHASE_MIGRATION_2026-06-21.md" \
  '
  ($preflight[0]) as $preflight |
  [
    {
      id:"canonical_summary_attachment_index_gate",
      source_consumer_path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-index.gate",
      source_strict_missing_dependency_preserved:true,
      source_consumer_mutated:false,
      phase_successor_id:"canonical_summary_attachment_phase_index_gate",
      phase_successor_path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.gate",
      phase_successor_kind:"phase_aware_attachment_index",
      phase_successor_available:true,
      phase_migration_mode:"successor_available_no_mutation",
      phase_migration_ready:true,
      would_break_if_historical_name_claimed_before_migration:true,
      would_block_next_name_claim_preflight:false
    },
    {
      id:"compact_capability_restore_preflight_gate",
      source_consumer_path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-compact-capability-matrix-restore-preflight.gate",
      source_strict_missing_dependency_preserved:true,
      source_consumer_mutated:false,
      phase_successor_id:"current_canonical_wrapper_gate",
      phase_successor_path:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
      phase_successor_kind:"current_wrapper_active_summary_source",
      phase_successor_available:true,
      phase_migration_mode:"successor_available_no_mutation",
      phase_migration_ready:true,
      would_break_if_historical_name_claimed_before_migration:true,
      would_block_next_name_claim_preflight:false
    }
  ] as $migrated_consumers |
  ($migrated_consumers | map(select(.source_strict_missing_dependency_preserved == true)) | length) as $strict_missing_consumer_count |
  ($migrated_consumers | map(select(.phase_successor_available == true)) | length) as $phase_successor_available_count |
  ($migrated_consumers | map(select(.phase_migration_ready == true)) | length) as $phase_migration_ready_count |
  ($migrated_consumers | map(select(.would_block_next_name_claim_preflight == true)) | length) as $blocking_after_migration_count |
  ($preflight.historical_canonical_gate_name_reintroduction_preflight_ready == true
    and $preflight.source_phase_index_ready == true
    and $preflight.source_historical_missing_path_evidence_preserved == true
    and $preflight.source_historical_missing_path_evidence_basis == "historical_snapshot_evidence"
    and $preflight.source_historical_missing_path_current_filesystem_probe_used == false
    and $preflight.source_historical_snapshot_missing_canonical_summary == true
    and $preflight.source_historical_snapshot_evidence_consumable_after_wrapper_creation == true
    and $preflight.source_current_wrapper_phase_available == true
    and $preflight.source_current_wrapper_active_summary_source == true
    and $preflight.dependent_strict_missing_consumer_count == 2
    and $preflight.dependent_blocking_consumer_count == 0
    and $strict_missing_consumer_count == 2
    and $phase_successor_available_count == 2
    and $phase_migration_ready_count == 2
    and $blocking_after_migration_count == 0
    and $preflight.historical_canonical_gate_name_reintroduction_allowed == true
    and $preflight.historical_canonical_gate_name_claimed == true
    and $preflight.historical_canonical_gate_created == true
    and $preflight.historical_canonical_gate_executable == true
    and $preflight.historical_canonical_gate_wrapper_kind == "thin_local_exec_wrapper"
    and $preflight.historical_canonical_gate_wrapper_target == "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    and $preflight.historical_canonical_gate_wrapper_exec_count == 1
    and $preflight.historical_canonical_gate_mutated == true
    and $preflight.historical_canonical_gate_mutated_by_report == false
    and $preflight.canonical_gate_wrapper_invoked == false
    and $preflight.execution_enabled_count == 0
    and $preflight.public_ga_enabled_count == 0
    and ($preflight.side_effects | to_entries | all(.value == false))) as $migration_ready |
  {
    runtime:"hepta",
    surface:"strict_missing_consumer_phase_migration",
    plugin_id:$preflight.plugin_id,
    status:(if $migration_ready then "ready" else "blocked" end),
    source_preflight_surface:$preflight.surface,
    source_preflight_ready:$preflight.historical_canonical_gate_name_reintroduction_preflight_ready,
    source_phase_index_ready:$preflight.source_phase_index_ready,
    source_historical_missing_path_evidence_preserved:$preflight.source_historical_missing_path_evidence_preserved,
    source_historical_missing_path_evidence_basis:$preflight.source_historical_missing_path_evidence_basis,
    source_historical_missing_path_current_filesystem_probe_used:$preflight.source_historical_missing_path_current_filesystem_probe_used,
    source_historical_snapshot_missing_canonical_summary:$preflight.source_historical_snapshot_missing_canonical_summary,
    source_historical_snapshot_evidence_consumable_after_wrapper_creation:$preflight.source_historical_snapshot_evidence_consumable_after_wrapper_creation,
    source_current_wrapper_phase_available:$preflight.source_current_wrapper_phase_available,
    source_current_wrapper_active_summary_source:$preflight.source_current_wrapper_active_summary_source,
    source_dependent_consumer_count:$preflight.dependent_consumer_count,
    source_dependent_strict_missing_consumer_count:$preflight.dependent_strict_missing_consumer_count,
    source_dependent_blocking_consumer_count:$preflight.dependent_blocking_consumer_count,
    migrated_strict_missing_consumers:$migrated_consumers,
    strict_missing_consumer_count:$strict_missing_consumer_count,
    phase_successor_available_count:$phase_successor_available_count,
    phase_migration_ready_count:$phase_migration_ready_count,
    phase_successor_missing_count:(2 - $phase_successor_available_count),
    strict_missing_evidence_preserved_count:$strict_missing_consumer_count,
    blocking_consumer_count_before_phase_migration:$preflight.dependent_blocking_consumer_count,
    blocking_consumer_count_after_phase_migration:$blocking_after_migration_count,
    strict_missing_consumer_phase_migration_ready:$migration_ready,
    strict_missing_consumer_mutation_allowed:false,
    strict_missing_consumers_mutated:false,
    historical_missing_path_evidence_preserved:true,
    current_wrapper_active_summary_source:true,
    ready_to_prepare_historical_name_claim_preflight:$migration_ready,
    historical_canonical_gate_name_reintroduction_allowed:true,
    historical_canonical_gate_name_claimed:true,
    historical_canonical_gate_created:true,
    historical_canonical_gate_executable:true,
    historical_canonical_gate_wrapper_kind:"thin_local_exec_wrapper",
    historical_canonical_gate_wrapper_target:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate",
    historical_canonical_gate_wrapper_exec_count:1,
    historical_canonical_gate_mutated:true,
    historical_canonical_gate_mutated_by_report:false,
    canonical_gate_wrapper_invoked:false,
    proposed_historical_canonical_gate_path:$preflight.proposed_historical_canonical_gate_path,
    proposed_alias_target:$preflight.proposed_alias_target,
    proposed_alias_kind:$preflight.proposed_alias_kind,
    proposed_alias_would_invoke_live_gates:false,
    execution_enabled_count:0,
    public_ga_enabled_count:0,
    manual_operator_live_cutover_approval_required:true,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    next_migration_step:"validate_historical_canonical_gate_thin_wrapper_without_live_invocation",
    migration_blockers:[
      "historical_canonical_gate_thin_wrapper_validation_pending",
      "manual_operator_live_cutover_approval_required",
      "tool_execution_live_cutover_allowed_false",
      "tool_execution_public_ga_allowed_false"
    ],
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      historical_canonical_gate_name_preflight_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-name-reintroduction-preflight.report",
      historical_canonical_gate_name_preflight_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-historical-canonical-gate-name-reintroduction-preflight.gate",
      canonical_summary_attachment_phase_index_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-canonical-summary-attachment-phase-index.gate",
      current_canonical_wrapper_gate:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-wrapper.gate"
    },
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      historical_patch_replayed:false,
      patch_body_emitted:false,
      plugin_fixture_fabricated:false,
      canonical_summary_mutated:false,
      strict_missing_consumer_mutated:false,
      historical_canonical_gate_mutated:false,
      historical_canonical_gate_name_claimed:false,
      canonical_gate_invoked:false,
      capability_matrix_gate_invoked:false,
      terminal_live_gate_invoked:false,
      terminal_live_url_contacted:false,
      long_soak_started:false,
      tool_registered:false,
      execution_adapter_dispatched:false,
      tool_invoked:false,
      tool_invocation_ledger_written:false,
      approval_broker_mutated:false,
      approval_requested:false,
      operator_cutover_acceptance_recorded:false,
      live_cutover_started:false,
      result_receipt_written:false,
      rollback_executed:false,
      rollback_receipt_written:false,
      mcp_server_started:false,
      app_connector_started:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
