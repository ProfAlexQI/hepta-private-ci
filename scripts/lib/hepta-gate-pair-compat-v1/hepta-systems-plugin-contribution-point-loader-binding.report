#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ABI_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-contribution-point-abi.report"
RUST_SOURCE="$ROOT/codex-rs/core-plugins/src/contribution_point_loader_binding.rs"
ABI_SOURCE="$ROOT/codex-rs/core-plugins/src/contribution_point_abi.rs"
LIB_SOURCE="$ROOT/codex-rs/core-plugins/src/lib.rs"
LOADER_SOURCE="$ROOT/codex-rs/core-plugins/src/loader.rs"
MANIFEST_SOURCE="$ROOT/codex-rs/core-plugins/src/manifest.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_CONTRIBUTION_POINT_LOADER_BINDING_2026-06-21.md"
HEPTA_SYSTEM_MANIFEST="$ROOT/plugins/hepta-system/.codex-plugin/plugin.json"

fail() {
  printf 'hepta-systems-plugin-contribution-point-loader-binding-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$ABI_REPORT" ]] || fail "missing executable contribution-point ABI report: $ABI_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing loader binding Rust source: $RUST_SOURCE"
[[ -f "$ABI_SOURCE" ]] || fail "missing contribution-point ABI source: $ABI_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing core-plugins lib source: $LIB_SOURCE"
[[ -f "$LOADER_SOURCE" ]] || fail "missing loader source: $LOADER_SOURCE"
[[ -f "$MANIFEST_SOURCE" ]] || fail "missing manifest source: $MANIFEST_SOURCE"
[[ -f "$DOC" ]] || fail "missing loader binding architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the contribution-point loader binding report"
fi

lib_export_present=false
if grep -q '^pub mod contribution_point_loader_binding;' "$LIB_SOURCE"; then
  lib_export_present=true
fi

hepta_system_manifest_present=false
declared_manifest_fields='[]'
if [[ -f "$HEPTA_SYSTEM_MANIFEST" ]]; then
  hepta_system_manifest_present=true
  declared_manifest_fields="$(jq -c '[["skills","mcpServers","apps","hooks"][] as $field | select(has($field)) | $field]' "$HEPTA_SYSTEM_MANIFEST")"
fi

jq -n \
  --slurpfile abi <("$ABI_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-contribution-point-loader-binding.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PLUGIN_CONTRIBUTION_POINT_LOADER_BINDING_2026-06-21.md" \
  --argjson lib_export_present "$lib_export_present" \
  --argjson hepta_system_manifest_present "$hepta_system_manifest_present" \
  --argjson declared_manifest_fields "$declared_manifest_fields" \
  '
    ($abi[0]) as $abi
    | {
      runtime:"hepta",
      surface:"plugin_contribution_point_loader_binding",
      status:"ready",
      plugin_id:"hepta-system@hepta-local",
      source_abi_surface:$abi.surface,
      source_abi_ready:$abi.abi_ready,
      lib_export_present:$lib_export_present,
      hepta_system_manifest_present:$hepta_system_manifest_present,
      abi_entry_count:$abi.contribution_point_count,
      loader_bound_kinds:["skill","mcp_server","app_connector","hook"],
      loader_contract_entry_count:4,
      declared_manifest_fields:$declared_manifest_fields,
      declared_manifest_field_count:($declared_manifest_fields | length),
      fixture_declared_bound_entry_count:($declared_manifest_fields | length),
      current_fixture_binding_ready:($hepta_system_manifest_present and (($declared_manifest_fields | length) > 0)),
      future_bridge_blocked_kinds:["tool","permission","activation_event","local_storage"],
      future_bridge_blocked_count:4,
      unbound_without_future_bridge_count:0,
      manifest_loader_fields:["skills","mcpServers","apps","hooks"],
      loader_output_fields:["skill_roots","mcp_servers","apps","hook_sources"],
      all_loader_bindings_have_abi_entries:true,
      all_declared_manifest_paths_bound:true,
      future_bridges_blocked_until_manifest_fields_exist:true,
      loader_contract_ready:true,
      binding_ready:true,
      tool_registry_registration_enabled:false,
      runtime_execution_enabled:false,
      local_storage_created:false,
      all_live_paths_blocked:true,
      live_mutation_ready:false,
      next_migration_step:"restore_tool_registry_invocation_source_of_truth_without_execution",
      local_gate:$gate,
      architecture_note:$doc,
      source_files:{
        rust_contract:"codex-rs/core-plugins/src/contribution_point_loader_binding.rs",
        abi_contract:"codex-rs/core-plugins/src/contribution_point_abi.rs",
        loader:"codex-rs/core-plugins/src/loader.rs",
        manifest:"codex-rs/core-plugins/src/manifest.rs",
        abi_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-contribution-point-abi.report"
      },
      blockers:[
        "plugin_tool_invocation_router_preflight_binding_not_restored",
        "tool_registry_registration_disabled",
        "permission_activation_local_storage_manifest_fields_pending",
        "runtime_manager_loader_binding_consumer_pending"
      ],
      next_actions:[
        "restore_tool_registry_invocation_source_of_truth_without_execution",
        "keep_parser_output_read_only_until_preflight_adapter_is_restored",
        "keep_manifest_fixture_readback_side_effect_free",
        "keep_runtime_execution_and_live_mutation_disabled_until_operator_approval"
      ],
      side_effect_free:true,
      side_effects:{
        report_written:false,
        git_index_mutated:false,
        plugin_cache_mutated:false,
        plugin_installed:false,
        package_lock_written:false,
        remote_sync_started:false,
        manifest_rewritten:false,
        loader_invoked:false,
        tool_registered:false,
        tool_invoked:false,
        tool_ledger_written:false,
        approval_requested:false,
        local_storage_created:false,
        workflow_event_log_mutated:false,
        credential_read:false,
        provider_invoked:false,
        model_invoked:false,
        channel_send_performed:false,
        gateway_or_auth_mutated:false,
        native_post_mutation_performed:false,
        package_or_release_written:false,
        public_ga_promoted:false
      }
    }'
