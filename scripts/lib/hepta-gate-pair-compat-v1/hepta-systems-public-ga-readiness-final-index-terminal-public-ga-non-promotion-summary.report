#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
PUBLIC_GA_READINESS_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-attachment-final-index.report"
TERMINAL_DENIAL_FINAL_INDEX_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-denial-index-attachment-final-index.report"
PUBLIC_CLAIM_NON_PROMOTION_GATE="$ROOT/scripts/hepta-memory-live-mutation-operator-write-execution-activation-command-result-receipt-terminal-operator-decision-public-claim-non-promotion-denial-gate.sh"
PUBLIC_CLAIM_NON_PROMOTION_DOC="$ROOT/docs/architecture/HEPTA_MEMORY_LIVE_MUTATION_OPERATOR_WRITE_EXECUTION_ACTIVATION_COMMAND_RESULT_RECEIPT_TERMINAL_OPERATOR_DECISION_PUBLIC_CLAIM_NON_PROMOTION_DENIAL_GATE.md"
PUBLIC_GA_OPERATOR_PACKET="$ROOT/scripts/hepta-public-ga-operator-approval-packet.sh"
PUBLIC_GA_OPERATOR_PACKET_DOC="$ROOT/docs/release/HEPTA_PUBLIC_GA_OPERATOR_APPROVAL_PACKET_2026-05-20.md"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_FINAL_INDEX_TERMINAL_PUBLIC_GA_NON_PROMOTION_SUMMARY_2026-06-21.md"

fail() {
  printf 'hepta-systems-public-ga-readiness-final-index-terminal-public-ga-non-promotion-summary-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$PUBLIC_GA_READINESS_FINAL_INDEX_REPORT" ]] || fail "missing executable Public GA readiness non-live attachment final index report: $PUBLIC_GA_READINESS_FINAL_INDEX_REPORT"
[[ -x "$TERMINAL_DENIAL_FINAL_INDEX_REPORT" ]] || fail "missing executable terminal denial index attachment final index report: $TERMINAL_DENIAL_FINAL_INDEX_REPORT"
[[ -x "$PUBLIC_CLAIM_NON_PROMOTION_GATE" ]] || fail "missing executable public-claim non-promotion denial gate: $PUBLIC_CLAIM_NON_PROMOTION_GATE"
[[ -f "$PUBLIC_CLAIM_NON_PROMOTION_DOC" ]] || fail "missing public-claim non-promotion denial architecture note: $PUBLIC_CLAIM_NON_PROMOTION_DOC"
[[ -x "$PUBLIC_GA_OPERATOR_PACKET" ]] || fail "missing executable Public GA operator approval packet script: $PUBLIC_GA_OPERATOR_PACKET"
[[ -f "$PUBLIC_GA_OPERATOR_PACKET_DOC" ]] || fail "missing Public GA operator approval packet release note: $PUBLIC_GA_OPERATOR_PACKET_DOC"
[[ -f "$DOC" ]] || fail "missing terminal Public GA non-promotion summary architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the terminal Public GA non-promotion summary report"
fi

OPERATOR_PACKET_CURL_COUNT="$(grep -c 'curl -fsS' "$PUBLIC_GA_OPERATOR_PACKET" || true)"

jq -n \
  --slurpfile readiness <("$PUBLIC_GA_READINESS_FINAL_INDEX_REPORT") \
  --slurpfile terminal_denial <("$TERMINAL_DENIAL_FINAL_INDEX_REPORT") \
  --argjson operator_packet_curl_count "$OPERATOR_PACKET_CURL_COUNT" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-final-index-terminal-public-ga-non-promotion-summary.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PUBLIC_GA_READINESS_FINAL_INDEX_TERMINAL_PUBLIC_GA_NON_PROMOTION_SUMMARY_2026-06-21.md" \
  '
  ($readiness[0]) as $source |
  ($terminal_denial[0]) as $terminal_denial |
  ($source.side_effects + {
    terminal_public_ga_non_promotion_summary_written:false,
    public_claim_non_promotion_denial_gate_invoked:false,
    public_ga_operator_approval_packet_invoked:false,
    public_ga_operator_packet_live_endpoint_read_performed:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    external_network_read:false,
    public_ga_claim_recorded:false
  }) as $side_effects |
  [
    "public_ga_readiness_non_live_attachment_final_index_ready_but_blocked",
    "public_claim_non_promotion_denial_gate_source_probe_only",
    "public_ga_operator_packet_source_probe_only",
    "public_ga_operator_packet_live_endpoint_read_blocked",
    "public_ga_readiness_script_invocation_blocked",
    "public_ga_readiness_live_endpoint_read_blocked",
    "public_ga_readiness_attachment_recording_blocked",
    "public_ga_claim_disabled",
    "public_release_claim_disabled",
    "public_distribution_publication_disabled",
    "release_artifact_write_disabled",
    "publication_evidence_recording_disabled",
    "terminal_publication_evidence_gate_not_invoked",
    "watchdog_not_invoked",
    "terminal_live_gates_not_invoked",
    "live_url_not_contacted",
    "long_soak_not_started",
    "operator_approval_not_recorded",
    "operator_identity_not_accepted",
    "rollback_execution_blocked",
    "gateway_native_post_sqlite_workgraph_mutation_blocked",
    "public_ga_promotion_blocked"
  ] as $summary_blockers |
  ($source.public_ga_readiness_non_live_attachment_final_index_ready == true
    and $source.public_ga_readiness_non_live_attachment_final_index_blocked == true
    and $source.public_ga_readiness_attachment_allowed == false
    and $source.public_ga_claim_allowed == false
    and $source.public_ga_claimed == false
    and $source.public_release_claim_allowed == false
    and $source.public_release_published == false
    and $source.public_ga_readiness_script_invoked == false
    and $source.public_ga_readiness_live_endpoint_read_performed == false
    and $source.public_ga_readiness_endpoint_curl_performed == false
    and $source.terminal_live_gates_invoked == false
    and $source.canonical_gate_wrapper_invoked == false
    and $source.wrapper_target_invoked == false
    and $terminal_denial.terminal_denial_index_attachment_final_index_ready == true
    and $terminal_denial.terminal_denial_index_attachment_final_index_blocked == true
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_ready == true
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
    and $terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
    and $operator_packet_curl_count >= 1
    and ($side_effects | to_entries | all(.value == false))) as $summary_ready |
  {
    runtime:"hepta",
    surface:"terminal_public_ga_non_promotion_summary",
    plugin_id:$source.plugin_id,
    status:(if $summary_ready then "ready_blocked" else "blocked" end),
    source_public_ga_readiness_non_live_attachment_final_index_surface:$source.surface,
    source_public_ga_readiness_non_live_attachment_final_index_ready:$source.public_ga_readiness_non_live_attachment_final_index_ready,
    source_public_ga_readiness_non_live_attachment_final_index_blocked:$source.public_ga_readiness_non_live_attachment_final_index_blocked,
    source_terminal_denial_index_attachment_final_index_surface:$terminal_denial.surface,
    source_terminal_denial_index_attachment_final_index_ready:$terminal_denial.terminal_denial_index_attachment_final_index_ready,
    source_terminal_denial_index_attachment_final_index_blocked:$terminal_denial.terminal_denial_index_attachment_final_index_blocked,
    source_canonical_governance_tool_execution_closure_backfeed_ready:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_ready,
    source_canonical_governance_tool_execution_closure_backfeed_blocker_count:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_count:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_ready_count:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_ready_count,
    source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count,
    source_canonical_governance_tool_execution_closure_backfeed_categorization_ready:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_categorization_ready,
    source_canonical_governance_tool_execution_closure_backfeed_categories:$terminal_denial.source_canonical_governance_tool_execution_closure_backfeed_categories,
    terminal_public_ga_non_promotion_summary_ready:$summary_ready,
    terminal_public_ga_non_promotion_summary_blocked:true,
    public_ga_readiness_non_live_attachment_final_index_attached:true,
    public_claim_non_promotion_denial_gate_present:true,
    public_claim_non_promotion_denial_doc_present:true,
    public_claim_non_promotion_denial_gate_invoked:false,
    public_ga_operator_approval_packet_present:true,
    public_ga_operator_approval_packet_doc_present:true,
    public_ga_operator_approval_packet_invoked:false,
    public_ga_operator_packet_target_curl_count:$operator_packet_curl_count,
    public_ga_operator_packet_live_endpoint_read_performed:false,
    public_ga_readiness_script_invoked:false,
    public_ga_readiness_live_endpoint_read_performed:false,
    public_ga_readiness_endpoint_curl_performed:false,
    public_ga_readiness_report_materialized:false,
    public_ga_readiness_attachment_recorded:false,
    public_ga_readiness_attachment_allowed:false,
    terminal_publication_evidence_non_persistence_summary_gate_invoked:false,
    hepta_watchdog_invoked:false,
    terminal_public_distribution_non_publication_lock_gate_invoked:false,
    terminal_denial_index_gate_invoked:false,
    terminal_summary_gates_invoked:false,
    terminal_live_gates_invoked:false,
    canonical_gate_wrapper_invoked:false,
    wrapper_target_invoked:false,
    summary_blocker_count:($summary_blockers | length),
    summary_blockers:$summary_blockers,
    manual_operator_live_cutover_approval_required:true,
    terminal_live_url_required:false,
    long_soak_required:false,
    tool_execution_live_cutover_allowed:false,
    tool_execution_public_ga_allowed:false,
    public_distribution_publication_allowed:false,
    public_distribution_artifact_write_allowed:false,
    public_release_claim_allowed:false,
    public_ga_claim_allowed:false,
    public_release_published:false,
    public_ga_claimed:false,
    publication_evidence_summary_recorded:false,
    publication_evidence_summary_persisted:false,
    publication_evidence_receipt_persisted:false,
    publication_evidence_ledger_persisted:false,
    operator_approval_recorded:false,
    operator_identity_accepted:false,
    rollback_execution_allowed:false,
    next_migration_step:"derive_terminal_public_ga_non_promotion_summary_readback_without_public_ga_readiness_invocation",
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      public_ga_readiness_non_live_attachment_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-public-ga-readiness-non-live-attachment-final-index.report",
      terminal_denial_index_attachment_final_index_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-terminal-denial-index-attachment-final-index.report",
      public_claim_non_promotion_denial_gate:"scripts/hepta-memory-live-mutation-operator-write-execution-activation-command-result-receipt-terminal-operator-decision-public-claim-non-promotion-denial-gate.sh",
      public_claim_non_promotion_denial_doc:"docs/architecture/HEPTA_MEMORY_LIVE_MUTATION_OPERATOR_WRITE_EXECUTION_ACTIVATION_COMMAND_RESULT_RECEIPT_TERMINAL_OPERATOR_DECISION_PUBLIC_CLAIM_NON_PROMOTION_DENIAL_GATE.md",
      public_ga_operator_approval_packet:"scripts/hepta-public-ga-operator-approval-packet.sh",
      public_ga_operator_approval_packet_doc:"docs/release/HEPTA_PUBLIC_GA_OPERATOR_APPROVAL_PACKET_2026-05-20.md"
    },
    side_effect_free:true,
    side_effects:$side_effects
  }'
