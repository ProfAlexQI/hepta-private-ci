#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-ttrw-shadow-activation-layer14-blocker-preview.report"

report="$(capture_json_report "hepta-work-graph-ttrw-shadow-activation-layer14-blocker-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview_no_activation"
  and .activation_surface_count == 7
  and (.activation_surfaces | length) == .activation_surface_count
  and (.activation_surfaces | map(.id) == [
    "wrapper_execution_activation",
    "readback_execution_activation",
    "promotion_execution_activation",
    "task_result_enforcement_activation",
    "store_enablement_activation",
    "live_execution_activation",
    "external_delivery_activation"
  ])
  and (.activation_surfaces | all(
    .blocked_by_default == true
    and .activation_state == "blocked_preview_only"
    and .enables_runtime_mutation == false
    and .enables_external_side_effect == false
    and (.required_blocker_ids | length) == 4
    and (.required_enablement_ids | length) == 3
  ))
  and .blocker_count == 16
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "shadow_activation_blocker_activation_blocker_promotion_preconditions_unsatisfied",
    "shadow_activation_blocker_activation_blocker_drift_budgets_not_executed",
    "shadow_activation_blocker_activation_blocker_operator_review_missing",
    "shadow_activation_blocker_activation_blocker_audit_receipts_non_persistent",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_not_proven",
    "shadow_activation_blocker_activation_blocker_wrapper_execution_disabled",
    "shadow_activation_blocker_activation_blocker_readback_execution_disabled",
    "shadow_activation_blocker_activation_blocker_promotion_execution_disabled",
    "shadow_activation_blocker_activation_blocker_task_result_enforcement_disabled",
    "shadow_activation_blocker_activation_blocker_store_enablement_disabled",
    "shadow_activation_blocker_activation_blocker_live_execution_disabled",
    "shadow_activation_blocker_activation_blocker_external_delivery_disabled",
    "shadow_activation_blocker_activation_blocker_runtime_attachment_disabled",
    "shadow_activation_blocker_activation_blocker_kill_switches_preview_only",
    "shadow_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_persistence_disabled",
    "shadow_activation_blocker_activation_blocker_explicit_operator_approval_absent"
  ])
  and (.blockers | map(select(.severity == "critical")) | length) == 5
  and (.blockers | map(select(.severity == "high")) | length) == 3
  and (.blockers | all(
    (.applies_to_surface_ids | length) >= 1
    and .source_gate_id == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_preview_gate"
    and .blocks_shadow_activation_blocker_activation_blocker_readback == true
    and .blocks_shadow_activation_blocker_activation_blocker_activation == true
    and .blocks_shadow_activation_blocker_activation_blocker_promotion == true
  ))
  and .required_enablement_count == 6
  and (.required_enablements | length) == .required_enablement_count
  and (.required_enablements | map(.id) == [
    "shadow_activation_blocker_activation_blocker_promotion_precondition_report",
    "shadow_activation_blocker_activation_blocker_zero_tolerance_drift_budget_report",
    "shadow_activation_blocker_activation_blocker_operator_review_packet",
    "shadow_activation_blocker_activation_blocker_non_persistent_audit_receipt_readback",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_proof",
    "shadow_activation_blocker_activation_blocker_runtime_attachment_plan"
  ])
  and (.required_enablements | all(
    .currently_satisfied == false
    and (.required_for_surface_ids | length) >= 2
    and (.required_evidence_fields | length) >= 3
  ))
  and .kill_switch_count == 6
  and (.kill_switches | length) == .kill_switch_count
  and (.kill_switches | map(.id) == [
    "kill_all_shadow_activation_blocker_activation_blocker_activation",
    "kill_shadow_activation_blocker_activation_blocker_wrapper_execution_activation",
    "kill_shadow_activation_blocker_activation_blocker_task_result_enforcement_activation",
    "kill_shadow_activation_blocker_activation_blocker_store_enablement_activation",
    "kill_shadow_activation_blocker_activation_blocker_live_execution_activation",
    "kill_shadow_activation_blocker_activation_blocker_external_delivery_activation"
  ])
  and (.kill_switches | all(
    .armed_in_preview == true
    and .persists_switch_state == false
    and (.target_surface_ids | length) >= 1
  ))
  and .invariant_count == 6
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "shadow_activation_blocker_activation_blocker_activation_surfaces_blocked_by_default",
    "shadow_activation_blocker_activation_blocker_promotion_preconditions_do_not_authorize_activation",
    "zero_tolerance_shadow_activation_blocker_activation_blocker_drift_must_be_executed_before_activation",
    "shadow_activation_blocker_activation_blocker_audit_receipts_are_not_persistence_authority",
    "shadow_activation_blocker_activation_blocker_side_effect_lock_blocks_live_store_and_external_surfaces",
    "shadow_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_preview_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and .required_prior_gate_count == 73
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_readback_preview_gate"
  and .ready_for_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_readback_preview == true
  and .ready_for_shadow_activation_blocker_activation_blocker_readback_execution == false
  and .ready_for_shadow_activation_blocker_activation_blocker_activation_execution == false
  and .ready_for_shadow_activation_blocker_activation_blocker_promotion_execution == false
  and .ready_for_shadow_activation_execution == false
  and .ready_for_activation == false
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_shadow_activation_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_activation_blocker_promotion_precondition.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_ttrw_shadow_activation_layer14_blocker_preview --lib

echo "Hepta WorkGraph terminal TaskResult wrapper shadow activation 14-layer activation-blocker preview gate passed"
