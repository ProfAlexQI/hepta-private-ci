#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
BRIDGE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-preflight-adapter-bridge.report"
PARSER_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-parser-fields.report"
DECLARATIONS_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-fixture-declarations.report"
SOURCE_OF_TRUTH_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-registry-source-of-truth-dry-run.report"
RUST_SOURCE="$ROOT/codex-rs/tools/src/plugin_tool_manifest_schema_cutover_preflight.rs"
GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-schema-cutover-preflight.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_MANIFEST_SCHEMA_CUTOVER_PREFLIGHT_2026-06-21.md"

fail() {
  printf 'hepta-systems-plugin-tool-manifest-schema-cutover-preflight-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$BRIDGE_REPORT" ]] || fail "missing executable manifest preflight adapter bridge report: $BRIDGE_REPORT"
[[ -x "$PARSER_REPORT" ]] || fail "missing executable plugin tool manifest parser fields report: $PARSER_REPORT"
[[ -x "$DECLARATIONS_REPORT" ]] || fail "missing executable plugin tool manifest fixture declarations report: $DECLARATIONS_REPORT"
[[ -x "$SOURCE_OF_TRUTH_REPORT" ]] || fail "missing executable source-of-truth dry-run report: $SOURCE_OF_TRUTH_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing manifest schema cutover preflight source: $RUST_SOURCE"
[[ -f "$DOC" ]] || fail "missing manifest schema cutover preflight architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the plugin tool manifest schema cutover preflight report"
fi

jq -n \
  --slurpfile bridge <("$BRIDGE_REPORT") \
  --slurpfile parser <("$PARSER_REPORT") \
  --slurpfile declarations <("$DECLARATIONS_REPORT") \
  --slurpfile source <("$SOURCE_OF_TRUTH_REPORT") \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-schema-cutover-preflight.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_MANIFEST_SCHEMA_CUTOVER_PREFLIGHT_2026-06-21.md" \
  '
  def has_id($ids; $id): ($ids | index($id)) != null;
  def preflight_entry($source_ready; $parser; $candidate):
    ($candidate.candidate_tool_id) as $id |
    (has_id($parser.current_fixture_schema_complete_candidate_ids; $id)) as $schema_complete |
    (has_id($parser.current_fixture_policy_complete_candidate_ids; $id)) as $policy_complete |
    (($schema_complete and $policy_complete)) as $preconditions_satisfied |
    (if ($source_ready | not) then "block_source_registry"
     elif $preconditions_satisfied then "forward_require_approval_ledger_dry_run"
     else "block_manifest_preconditions" end) as $decision_route |
    {
      plugin_id:$candidate.plugin_id,
      candidate_tool_id:$id,
      contribution_kind:$candidate.contribution_kind,
      source_registry_dry_run_ready:$source_ready,
      registry_guard_route:$candidate.guard_route,
      tool_schema_declared:has_id($parser.current_fixture_tool_schema_candidate_ids; $id),
      permission_declared:has_id($parser.current_fixture_permission_candidate_ids; $id),
      activation_event_declared:has_id($parser.current_fixture_activation_event_candidate_ids; $id),
      tool_policy_declared:has_id($parser.current_fixture_tool_policy_candidate_ids; $id),
      manifest_schema_complete:$schema_complete,
      manifest_policy_complete:$policy_complete,
      registration_preconditions_satisfied:$preconditions_satisfied,
      decision_route:$decision_route,
      blocked:($decision_route != "forward_require_approval_ledger_dry_run"),
      blocked_reason:(if $decision_route == "forward_require_approval_ledger_dry_run" then null
        elif $decision_route == "block_source_registry" then "source_registry_dry_run_not_ready"
        else "manifest_schema_or_policy_preconditions_missing" end),
      registration_cutover_allowed:false,
      registration_execution_enabled:false,
      tool_invocation_enabled:false,
      ledger_write_enabled:false,
      approval_request_enabled:false,
      side_effect_free:true
    };

  ($bridge[0]) as $bridge |
  ($parser[0]) as $parser |
  ($declarations[0]) as $declarations |
  ($source[0]) as $source |
  ($source.registry_source_of_truth_dry_run_ready) as $source_ready |
  ($source.entries | map(preflight_entry($source_ready; $declarations; .))) as $entries |
  ($entries | map(select(.registration_preconditions_satisfied == true)) | length) as $satisfied_count |
  ($entries | map(select(.registration_preconditions_satisfied == false)) | length) as $missing_count |
  ($source.entries | map(.candidate_tool_id)) as $planned_ids |
  ($declarations.current_fixture_declared_candidate_ids | map(select(($planned_ids | index(.)) == null))) as $unbound_manifest_ids |
  (($unbound_manifest_ids | length) == 0) as $all_manifest_declarations_bound |
  ($entries | all(if .registration_preconditions_satisfied then true else (.blocked == true and .decision_route == "block_manifest_preconditions") end)) as $all_missing_blocked |
  ($entries | all(if .decision_route == "forward_require_approval_ledger_dry_run" then (.registry_guard_route == "require_approval_ledger" and .registration_execution_enabled == false and .tool_invocation_enabled == false and .ledger_write_enabled == false and .approval_request_enabled == false) else true end)) as $all_forwarded_keep_ledger |
  {
    runtime:"hepta",
    surface:"plugin_tool_manifest_schema_cutover_preflight",
    plugin_id:$source.plugin_id,
    status:(if ($source_ready and $all_manifest_declarations_bound and $all_missing_blocked and $all_forwarded_keep_ledger) then "ready" else "blocked" end),
    source_registry_dry_run_surface:$source.surface,
    source_registry_dry_run_ready:$source_ready,
    source_manifest_parser_fields_surface:$parser.surface,
    source_manifest_parser_fields_ready:$parser.parser_fields_ready,
    source_preflight_adapter_bridge_surface:$bridge.surface,
    source_preflight_adapter_bridge_ready:$bridge.preflight_adapter_bridge_ready,
    source_manifest_fixture_declarations_surface:$declarations.surface,
    source_manifest_fixture_declarations_ready:$declarations.manifest_fixture_declarations_ready,
    declaration_source:$declarations.declaration_source,
    planned_candidate_count:($source.entries | length),
    parsed_manifest_declared_candidate_count:$declarations.current_fixture_declared_candidate_count,
    parsed_manifest_schema_complete_count:$declarations.current_fixture_schema_complete_count,
    parsed_manifest_policy_complete_count:$declarations.current_fixture_policy_complete_count,
    registration_precondition_satisfied_count:$satisfied_count,
    missing_manifest_precondition_count:$missing_count,
    unbound_manifest_declaration_ids:$unbound_manifest_ids,
    all_manifest_declarations_bound_to_planned_candidates:$all_manifest_declarations_bound,
    all_missing_manifest_preconditions_blocked:$all_missing_blocked,
    all_forwarded_candidates_keep_approval_ledger:$all_forwarded_keep_ledger,
    manifest_schema_cutover_preflight_ready:($source_ready and $all_manifest_declarations_bound and $all_missing_blocked and $all_forwarded_keep_ledger),
    registration_cutover_allowed:($source_ready and $all_manifest_declarations_bound and $satisfied_count == ($source.entries | length) and ($entries | all(.decision_route == "forward_require_approval_ledger_dry_run"))),
    registration_execution_enabled:false,
    tool_invocation_enabled:false,
    ledger_written:false,
    approval_requested:false,
    mcp_server_started:false,
    app_connector_started:false,
    live_mutation_ready:false,
    next_migration_step:"restore_tool_registry_invocation_source_of_truth_without_execution",
    entries:$entries,
    local_gate:$gate,
    architecture_note:$doc,
    source_files:{
      rust_adapter:"codex-rs/tools/src/plugin_tool_manifest_schema_cutover_preflight.rs",
      preflight_adapter_bridge_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-preflight-adapter-bridge.report",
      parser_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-parser-fields.report",
      fixture_declarations_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-manifest-fixture-declarations.report",
      source_registry_dry_run_report:"scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-registry-source-of-truth-dry-run.report"
    },
    blockers:[
      "registration_execution_disabled",
      "tool_registry_registration_disabled",
      "tool_invocation_disabled",
      "ledger_write_disabled",
      "approval_request_disabled"
    ],
    next_actions:[
      "restore_tool_registry_invocation_source_of_truth_without_execution",
      "keep_manifest_fixture_readback_side_effect_free",
      "keep_registration_invocation_ledger_and_approval_disabled_until_operator_approval"
    ],
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      plugin_cache_mutated:false,
      plugin_installed:false,
      package_lock_written:false,
      remote_sync_started:false,
      manifest_rewritten:false,
      manifest_schema_written:false,
      loader_invoked:false,
      registry_source_of_truth_enabled:false,
      registration_cutover_executed:false,
      tool_registered:false,
      tool_invoked:false,
      tool_ledger_written:false,
      approval_requested:false,
      mcp_server_started:false,
      app_connector_started:false,
      local_storage_created:false,
      workflow_event_log_mutated:false,
      credential_read:false,
      provider_invoked:false,
      model_invoked:false,
      channel_send_performed:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      package_or_release_written:false,
      public_ga_promoted:false
    }
  }'
