#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-projection-adapter-gap-closure-application-preview.report"

report="$(capture_json_report "hepta-work-graph-projection-adapter-gap-closure-application-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_projection_adapter_gap_closure_application_preview_gate"
  and .schema_version == "work_graph_projection_adapter_gap_closure_application_preview_v1"
  and .preview_mode == "read_only_projection_adapter_gap_closure_application_preview_no_runtime_mutation"
  and .source_gap_count == 7
  and .readback_plan_count == 11
  and .application_plan_count == 11
  and (.application_plans | length) == .application_plan_count
  and (.application_plans | all(.application_state == "preview_application_defined_runtime_not_mutated" and .readback_verified_by_preview == true and .applies_to_runtime == false and .mutates_store == false and .persists_timeline == false and .enforces_projection == false))
  and (.application_plans | map(.application_plan_id) | index("close_update_plan_timeline_projection")) != null
  and (.application_plans | map(.application_plan_id) | index("close_task_board_unified_store_projection")) != null
  and (.application_plans | map(.application_plan_id) | index("close_approval_broker_timeline_projection")) != null
' >/dev/null <<<"$report"

jq -e '
  .fixture_application_count == 0
  and .store_projection_application_count == 6
  and .timeline_projection_application_count == 5
  and .projected_collection_reference_count == 18
  and .timeline_event_type_reference_count == 5
  and .source_outcome_count == 7
  and (.source_outcomes | length) == .source_outcome_count
  and .source_contract_ready_preview_count == 7
  and (.source_outcomes | all(.post_application_coverage_state == "contract_ready_preview_after_application" and .ready_for_enforcement_readiness_rerun == true and .ready_for_projection_enforcement == false and .applies_to_runtime == false))
  and (.source_outcomes | map(.source_surface_id) == [
    "update_plan_tool",
    "plan_mode_proposed_plan_blocks",
    "app_server_turn_plan_notification",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "hepta_runtime_task_board",
    "hepta_runtime_approval_broker"
  ])
  and (.source_outcomes | map(select(.source_surface_id == "hepta_runtime_task_board" and .projected_collection_ids == ["nodes", "taskResults", "artifacts", "timelineEvents"] and .timeline_event_type_ids == ["scheduler_admission_decision_observed"])) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .application_group_count == 5
  and (.application_groups | map(.id) == [
    "planning_projection_adapter_gap_closure_application",
    "multi_agent_mailbox_projection_adapter_gap_closure_application",
    "multi_agent_reducer_projection_adapter_gap_closure_application",
    "task_board_projection_adapter_gap_closure_application",
    "approval_broker_projection_adapter_gap_closure_application"
  ])
  and (.application_groups | all(.mutates_runtime == false and .enforces_projection == false))
  and (.application_groups | map(select(.id == "planning_projection_adapter_gap_closure_application" and (.application_plan_ids | length == 4) and .expected_contract_ready_source_count_after_application == 3)) | length) == 1
  and .application_guard_count == 6
  and (.application_guards | map(.id) == [
    "runtime_attachment_disabled",
    "store_mutation_disabled",
    "timeline_persistence_disabled",
    "projection_enforcement_disabled",
    "task_result_enforcement_disabled",
    "enforcement_readiness_rerun_required"
  ])
  and (.application_guards | all(.required_before_projection_enforcement == true and .satisfied_by_preview == false))
' >/dev/null <<<"$report"

jq -e '
  .blocker_count == 6
  and (.blockers | map(.id) == [
    "gap_closure_application_is_preview_only",
    "runtime_closure_application_disabled",
    "append_only_store_enablement_disabled",
    "timeline_persistence_disabled",
    "terminal_task_result_enforcement_disabled",
    "enforcement_readiness_rerun_missing"
  ])
  and (.blockers | map(select(.severity == "high")) | length) == 5
  and (.blockers | all(.required_before_projection_enforcement == true))
  and (.blockers | map(select(.id == "append_only_store_enablement_disabled" and (.affected_application_plan_ids | length == 6))) | length) == 1
  and (.blockers | map(select(.id == "timeline_persistence_disabled" and (.affected_application_plan_ids | length == 5))) | length) == 1
  and (.blockers | map(select(.id == "terminal_task_result_enforcement_disabled" and (.affected_source_surface_ids | length == 2) and (.affected_application_plan_ids | length == 4))) | length) == 1
' >/dev/null <<<"$report"

jq -e '
  .required_prior_gate_count == 15
  and (.required_prior_gates[-1] == "hepta_work_graph_projection_adapter_gap_closure_readback_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_unified_projection_enforcement_readiness_rerun_preview_gate"
  and .ready_for_unified_projection_enforcement_readiness_rerun_preview == true
  and .ready_for_projection_enforcement == false
  and .ready_for_append_only_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.gap_closure_application.rust_module_present == true
  and .source_probes.gap_closure_application.report_script_present == true
  and .source_probes.gap_closure_application.gate_script_present == true
  and .source_probes.gap_closure_readback.rust_module_present == true
  and .source_probes.gap_closure_readback.gate_script_present == true
  and .source_probes.gap_closure_readback.upstream_gate == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_projection_adapter_gap_closure_application --lib

echo "Hepta WorkGraph projection adapter gap closure application preview gate passed"
