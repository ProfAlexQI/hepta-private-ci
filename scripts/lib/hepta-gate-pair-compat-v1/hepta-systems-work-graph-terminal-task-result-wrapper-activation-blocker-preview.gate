#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-task-result-wrapper-activation-blocker-preview.report"

report="$(capture_json_report "hepta-work-graph-terminal-task-result-wrapper-activation-blocker-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_activation_blocker_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_activation_blocker_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_activation_blocker_preview_no_activation"
  and .activation_surface_count == 7
  and (.activation_surfaces | length) == .activation_surface_count
  and (.activation_surfaces | map(.id) == [
    "wrapper_execution_activation",
    "readback_execution_activation",
    "promotion_execution_activation",
    "task_result_enforcement_activation",
    "store_enablement_activation",
    "live_execution_activation",
    "external_delivery_activation"
  ])
  and (.activation_surfaces | all(
    .blocked_by_default == true
    and .activation_state == "blocked_preview_only"
    and .enables_runtime_mutation == false
    and (.required_blocker_ids | length) == 4
    and (.required_blocker_ids | index("promotion_preconditions_unsatisfied"))
  ))
  and .blocker_count == 14
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "promotion_preconditions_unsatisfied",
    "zero_tolerance_drift_not_executed",
    "operator_review_missing",
    "audit_receipt_persistence_disabled",
    "wrapper_execution_disabled",
    "readback_execution_disabled",
    "promotion_execution_disabled",
    "task_result_enforcement_disabled",
    "store_enablement_disabled",
    "live_execution_disabled",
    "external_delivery_disabled",
    "redaction_precondition_unsatisfied",
    "runtime_attachment_disabled",
    "kill_switches_preview_only"
  ])
  and (.blockers | map(select(.severity == "critical")) | length) == 5
  and (.blockers | map(select(.severity == "high")) | length) == 2
  and (.blockers | all(.blocks_activation == true and (.applies_to_surface_ids | length) >= 1))
  and .required_enablement_count == 5
  and (.required_enablements | length) == .required_enablement_count
  and (.required_enablements | map(.id) == [
    "promotion_precondition_report",
    "zero_tolerance_drift_budget_report",
    "operator_review_packet",
    "non_persistent_audit_receipt_readback",
    "runtime_attachment_plan"
  ])
  and (.required_enablements | all(.currently_satisfied == false and (.required_evidence_fields | length) >= 3))
  and .kill_switch_count == 5
  and (.kill_switches | length) == .kill_switch_count
  and (.kill_switches | map(.id) == [
    "kill_all_terminal_wrapper_activation",
    "kill_wrapper_execution_activation",
    "kill_task_result_enforcement_activation",
    "kill_store_enablement_activation",
    "kill_external_delivery_activation"
  ])
  and (.kill_switches | all(.armed_in_preview == true and (.target_surface_ids | length) >= 1))
  and .invariant_count == 6
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "activation_surfaces_blocked_by_default",
    "promotion_preconditions_do_not_authorize_execution",
    "zero_tolerance_drift_must_be_proven_before_enforcement",
    "audit_receipts_are_not_persistence_authority",
    "external_delivery_stays_disabled",
    "activation_blocker_preview_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and .required_prior_gate_count == 17
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_promotion_precondition_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_shadow_activation_readback_preview_gate"
  and .ready_for_shadow_activation_readback_preview == true
  and .ready_for_activation == false
  and .ready_for_promotion_execution == false
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_activation_blocker.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_activation_blocker.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_activation_blocker.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper_promotion_precondition.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_terminal_task_result_wrapper_activation_blocker --lib

echo "Hepta WorkGraph terminal TaskResult wrapper activation blocker preview gate passed"
