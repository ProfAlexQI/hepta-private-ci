#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-packet.report"
SOURCE_STRATEGY_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-dirty-worktree-release-boundary-actionable-clean-worktree-strategy.report"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_DIRTY_WORKTREE_RELEASE_BOUNDARY_CLEAN_WORKTREE_STRATEGY_OPERATOR_PACKET_2026-06-27.md"

fail() {
  printf 'hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-packet-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable Phase 15 operator packet report: $REPORT"
[[ -x "$SOURCE_STRATEGY_REPORT" ]] || fail "missing executable Phase 14 clean-worktree strategy report: $SOURCE_STRATEGY_REPORT"
[[ -f "$DOC" ]] || fail "missing Phase 15 architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the Phase 15 clean-worktree strategy operator packet report"
fi

grep -q 'Dirty Worktree Release Boundary Clean Worktree Strategy Operator Packet' "$DOC" \
  || fail "architecture note must document Dirty Worktree Release Boundary Clean Worktree Strategy Operator Packet"
grep -q 'operator_packet_preview_only' "$DOC" \
  || fail "architecture note must document operator_packet_preview_only"
grep -q 'not_sent_not_persisted' "$DOC" \
  || fail "architecture note must document not_sent_not_persisted"
grep -q 'no git add, commit, push, reset, checkout, revert, cleanup, delete, strategy application, packet send, packet persistence, evidence recording, evidence persistence, approval request, approval acceptance, blocker waiver, package, release, Public GA, canary activation, live activation, or live execution' "$DOC" \
  || fail "architecture note must document the closed Phase 15 boundary"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet"
  and .status == "ready_blocked"
  and .gate == "dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_gate"
  and .schema_version == "dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_v1"
  and .plugin_id == "hepta-system@hepta-local"
  and .source_strategy_ready == true
  and .source_strategy_applied == false
  and .source_strategy_entry_count > 0
  and .lib_export_present == true
  and .inventory_entry_count == (.tracked_change_count + .untracked_change_count)
  and .packet_scope.packet_id == "dirty-worktree.release-boundary.clean-worktree-strategy.operator-packet.v1"
  and .packet_scope.packet_route == "operator-packet://release-boundary/dirty-worktree/clean-worktree-strategy/v1"
  and .packet_scope.source_strategy_route == "readback://release-boundary/dirty-worktree/actionable-clean-worktree-strategy/v1"
  and .packet_scope.packet_mode == "operator_packet_preview_only"
  and .packet_scope.send_mode == "not_sent_not_persisted"
  and .packet_scope.mutation_boundary == "closed"
  and .packet_section_count == 6
  and .packet_entry_count == .source_strategy_entry_count
  and .stable_packet_key_count == .packet_entry_count
  and .packet_route_count == .packet_entry_count
  and .attached_strategy_count == .packet_entry_count
  and .operator_decision_required_count == .packet_entry_count
  and .no_git_mutation_packet_count == .packet_entry_count
  and .hepta_systems_packet_count > 0
  and .cross_lane_packet_count > 0
  and .mixed_lane_packet_count > 0
  and .evidence_recorded_count == 0
  and .operator_packet_ready == true
  and .operator_packet_sent == false
  and .operator_packet_persisted == false
  and .strategy_applied == false
  and .release_cutover_allowed == false
  and .git_add_allowed == false
  and .git_index_mutated == false
  and .git_commit_allowed == false
  and .git_push_allowed == false
  and .git_reset_allowed == false
  and .git_checkout_allowed == false
  and .git_revert_allowed == false
  and .cleanup_allowed == false
  and .delete_allowed == false
  and .evidence_recording_allowed == false
  and .evidence_persistence_allowed == false
  and .approval_request_sent == false
  and .approval_acceptance_allowed == false
  and .blocker_waiver_allowed == false
  and .package_or_release_allowed == false
  and .public_ga_allowed == false
  and .canary_activation_allowed == false
  and .live_activation_allowed == false
  and .live_execution_allowed == false
  and (.sections | length) == 6
  and (.sections | all(.preview_ready == true and .mutation_enabled == false))
  and (.entries | length) == .packet_entry_count
  and any(.entries[]; .group_type == "top_level")
  and any(.entries[]; .group_type == "scope")
  and any(.entries[]; .review_lane == "hepta-systems")
  and any(.entries[]; .review_lane == "cross-lane-review" or .review_lane == "external-or-cross-lane")
  and any(.entries[]; .review_lane == "mixed" or .review_lane == "mixed-hepta-and-cross-lane")
  and (.entries | all(
    (.source_strategy_key | startswith("dirty_worktree.strategy."))
    and (.source_strategy_route | startswith("readback://release-boundary/dirty-worktree/strategy/"))
    and (.packet_key | startswith("dirty_worktree.packet."))
    and (.packet_route | startswith("operator-packet://release-boundary/dirty-worktree/clean-worktree-strategy/"))
    and .source_entry_count > 0
    and .source_entry_count == (.tracked_count + .untracked_count)
    and .source_entry_count == (.hepta_systems_owned_count + .cross_lane_or_unowned_count)
    and (.recommended_strategy == "hepta_systems_owned_batch_review"
      or .recommended_strategy == "cross_lane_owner_review_required"
      or .recommended_strategy == "split_owned_and_cross_lane_review"
      or .recommended_strategy == "operator_classification_required")
    and (.operator_action == "prepare_hepta_systems_clean_plan_for_operator_review"
      or .operator_action == "request_owner_classification_before_cleanup"
      or .operator_action == "split_group_into_owned_and_cross_lane_subsets"
      or .operator_action == "classify_group_before_any_cleanup")
    and .evidence_requirement == "clean_worktree_decision_record_required_before_release"
    and .packet_section == "strategy_entries"
    and .decision_state == "pending_operator_decision"
    and .attached_to_packet == true
    and .operator_visible == true
    and .queryable == true
    and .diffable == true
    and .operator_decision_required == true
    and .packet_sent == false
    and .packet_persisted == false
    and .strategy_applied == false
    and .git_mutation_allowed == false
    and .cleanup_allowed == false
    and .delete_allowed == false
    and .evidence_recording_allowed == false
    and .release_cutover_allowed == false
    and .live_execution_allowed == false))
  and (.blockers | index("operator_packet_not_sent")) != null
  and (.blockers | index("operator_packet_not_persisted")) != null
  and (.blockers | index("strategy_application_blocked")) != null
  and (.blockers | index("git_mutation_blocked")) != null
  and (.blockers | index("cleanup_and_delete_blocked")) != null
  and (.blockers | index("evidence_recording_blocked")) != null
  and (.blockers | index("release_cutover_blocked")) != null
  and (.blockers | index("canary_activation_blocked")) != null
  and (.blockers | index("live_activation_blocked")) != null
  and (.next_actions | index("phase16_dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_non_send_readback_without_git_mutation")) != null
  and .next_migration_step == "phase16_dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet_non_send_readback_without_git_mutation"
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$SOURCE_STRATEGY_REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "dirty_worktree_release_boundary_actionable_clean_worktree_strategy"
  and .status == "ready_blocked"
  and .strategy_ready == true
  and .strategy_applied == false
  and .strategy_entry_count > 0
  and .git_index_mutated == false
  and .cleanup_allowed == false
  and .delete_allowed == false
  and .release_cutover_allowed == false
  and .live_execution_allowed == false
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

(
  cd "$ROOT/codex-rs"
  cargo test -p hepta-runtime dirty_worktree_release_boundary_clean_worktree_strategy_operator_packet --lib
)

printf 'hepta-systems-dirty-worktree-release-boundary-clean-worktree-strategy-operator-packet-gate: PASS: clean-worktree strategy operator packet is preview-only without send, persistence, git mutation, or live activation\n'
