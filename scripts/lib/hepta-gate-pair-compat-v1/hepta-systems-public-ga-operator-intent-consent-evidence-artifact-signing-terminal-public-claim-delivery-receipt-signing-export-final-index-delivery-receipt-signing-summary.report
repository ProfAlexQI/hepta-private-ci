[[ -x "$SOURCE_REPORT" ]] || {
  echo "missing executable terminal public claim delivery receipt artifact signing receipt export/query/observability final index report: $SOURCE_REPORT" >&2
  exit 1
}
[[ -f "$SUMMARY_GATE" ]] || {
  echo "missing terminal public claim delivery receipt artifact signing receipt summary/briefing denial gate: $SUMMARY_GATE" >&2
  exit 1
}
[[ -f "$SUMMARY_DOC" ]] || {
  echo "missing terminal public claim delivery receipt artifact signing receipt summary/briefing denial doc: $SUMMARY_DOC" >&2
  exit 1
}

source_json="$("$SOURCE_REPORT")"

jq -e '
  .surface == "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_export_query_observability_final_index"
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_export_query_observability_final_index_ready == true
  and .public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_export_query_observability_final_index_blocked == true
  and .final_blocker_count == 132
  and .signing_receipt_query_registered == false
  and .signing_receipt_export_file_written == false
  and .signing_receipt_observability_metric_recorded == false
  and .release_publication_authority_from_signing_receipt_export_query_observability_derived == false
  and .activation_authority_from_signing_receipt_export_query_observability_derived == false
  and .public_ga_claimed == false
' <<<"$source_json" >/dev/null

signing_summary_static_mention_count="$(
  grep -Eci 'summary|briefing|readback|digest|status|banner|card|timeline|narrative|memo|completion|channel|telegram|external|authority|install|restart|active-binary|credential|secret|provider|model|public|release|ga|receipt|ack' "$SUMMARY_GATE" || true
)"

