  --argjson source "$source_json" \
  --argjson signing_summary_static_mention_count "$signing_summary_static_mention_count" \
  '{
    runtime: "hepta",
    surface: "public_ga_operator_identity_session_operator_intent_consent_evidence_artifact_signing_terminal_public_claim_delivery_receipt_artifact_signing_receipt_summary_briefing_attachment",
