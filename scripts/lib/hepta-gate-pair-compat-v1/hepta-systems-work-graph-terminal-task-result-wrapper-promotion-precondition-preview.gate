#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

source "$ROOT/scripts/lib/hepta-json-report-capture.sh"

REPORT_SCRIPT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-terminal-task-result-wrapper-promotion-precondition-preview.report"

report="$(capture_json_report "hepta-work-graph-terminal-task-result-wrapper-promotion-precondition-preview-report" "$REPORT_SCRIPT")"
printf '%s\n' "$report"

jq -e '
  .product == "Hepta"
  and .runtime == "hepta"
  and .status == "ready"
  and .gate == "hepta_work_graph_terminal_task_result_wrapper_promotion_precondition_preview_gate"
  and .schema_version == "work_graph_terminal_task_result_wrapper_promotion_precondition_preview_v1"
  and .preview_mode == "read_only_terminal_task_result_wrapper_promotion_precondition_preview_no_promotion"
  and .promotion_target_count == 8
  and (.promotion_targets | length) == .promotion_target_count
  and (.promotion_targets | map(.source_surface_id) == [
    "multi_agent_v2_thread_spawn",
    "multi_agent_v2_mailbox_wait",
    "hepta_runtime_multi_agent_reducer",
    "agent_jobs_batch_workers",
    "hepta_runtime_worker_tasks",
    "hepta_runtime_task_board",
    "hepta_runtime_scheduler_store",
    "hepta_runtime_agent_harness"
  ])
  and (.promotion_targets | all(
    .target_collection_id == "taskResults"
    and (.required_precondition_ids | length) == 4
    and (.required_budget_ids | length) == 5
    and (.required_operator_summary_ids | length) == 5
    and .promotion_state == "blocked_preview_only"
    and .blocks_task_result_enforcement == true
    and .promotes_state == false
  ))
  and .precondition_binding_count == 4
  and (.precondition_bindings | length) == .precondition_binding_count
  and (.precondition_bindings | map(.id) == [
    "all_critical_drift_budgets_zero_tolerance",
    "operator_summaries_reviewed",
    "redaction_drift_zero_leak_required",
    "execution_remains_disabled_until_budget_review"
  ])
  and (.precondition_bindings | all(
    .source_gate_id == "hepta_work_graph_terminal_task_result_wrapper_drift_budget_preview_gate"
    and .blocks_promotion == true
    and .currently_satisfied == false
  ))
  and .blocker_count == 4
  and (.blockers | length) == .blocker_count
  and (.blockers | map(.id) == [
    "critical_drift_budget_not_executed",
    "operator_review_not_performed",
    "redaction_precondition_unsatisfied",
    "runtime_promotion_attachment_disabled"
  ])
  and (.blockers | map(select(.severity == "high")) | length) == 2
  and (.blockers | map(select(.severity == "critical")) | length) == 1
  and (.blockers | all(.required_before_promotion == true and (.blocks_target_ids | length) == 8))
  and .audit_receipt_count == 8
  and (.audit_receipts | length) == .audit_receipt_count
  and (.audit_receipts | all(
    .persistence_enabled == false
    and .external_delivery_enabled == false
    and (.required_fields | index("receiptHash"))
    and (.required_fields | index("redactedEvidenceRefs"))
    and (.required_fields | index("preconditionIds"))
    and (.required_fields | index("blockerIds"))
  ))
  and .invariant_count == 5
  and (.invariants | length) == .invariant_count
  and (.invariants | map(.id) == [
    "every_wrapper_target_requires_zero_tolerance_drift_budget",
    "promotion_preconditions_block_without_operator_summaries",
    "redaction_drift_blocks_all_live_surfaces",
    "audit_receipts_are_preview_only",
    "promotion_precondition_preview_has_no_side_effects"
  ])
  and (.invariants | all(.required == true))
  and .required_prior_gate_count == 16
  and (.required_prior_gates[-1] == "hepta_work_graph_terminal_task_result_wrapper_drift_budget_preview_gate")
  and .recommended_next_gate == "hepta_work_graph_terminal_task_result_wrapper_activation_blocker_preview_gate"
  and .ready_for_activation_blocker_preview == true
  and .ready_for_promotion_execution == false
  and .ready_for_wrapper_execution == false
  and .ready_for_task_result_enforcement == false
  and .ready_for_store_enablement == false
  and .ready_for_live_execution == false
  and .source_probes.terminal_task_result_wrapper_promotion_precondition.rust_module_present == true
  and .source_probes.terminal_task_result_wrapper_promotion_precondition.report_script_present == true
  and .source_probes.terminal_task_result_wrapper_promotion_precondition.gate_script_present == true
  and .source_probes.terminal_task_result_wrapper_drift_budget.gate_script_present == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$report"

cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
  work_graph_terminal_task_result_wrapper_promotion_precondition --lib

echo "Hepta WorkGraph terminal TaskResult wrapper promotion precondition preview gate passed"
