#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SOURCE_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-registry-registration-denial-receipt-readback.report"
RUST_SOURCE="$ROOT/codex-rs/hepta-runtime/src/hepta_systems_plugin_tool_invocation_noop_denial_receipt_readback.rs"
LIB_SOURCE="$ROOT/codex-rs/hepta-runtime/src/lib.rs"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_INVOCATION_NOOP_DENIAL_RECEIPT_READBACK_2026-06-30.md"

fail() {
  printf 'hepta-systems-plugin-tool-invocation-noop-denial-receipt-readback-report: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$SOURCE_REPORT" ]] || fail "missing executable ToolRegistry registration denial receipt report: $SOURCE_REPORT"
[[ -f "$RUST_SOURCE" ]] || fail "missing plugin tool invocation noop denial receipt Rust source: $RUST_SOURCE"
[[ -f "$LIB_SOURCE" ]] || fail "missing hepta-runtime lib source: $LIB_SOURCE"
[[ -f "$DOC" ]] || fail "missing plugin tool invocation noop denial receipt architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to render the plugin tool invocation noop denial receipt readback report"
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$SOURCE_REPORT" >"$tmpdir/source.json" || fail "failed to render ToolRegistry registration denial receipt report"
jq -e . "$tmpdir/source.json" >/dev/null || fail "ToolRegistry registration denial receipt report did not render valid JSON"

lib_export_present=false
if grep -q 'hepta_systems_plugin_tool_invocation_noop_denial_receipt_readback_report' "$LIB_SOURCE"; then
  lib_export_present=true
fi

jq -n \
  --slurpfile source "$tmpdir/source.json" \
  --argjson lib_export_present "$lib_export_present" \
  --arg gate "scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-plugin-tool-invocation-noop-denial-receipt-readback.gate" \
  --arg doc "docs/architecture/HEPTA_SYSTEMS_PLUGIN_TOOL_INVOCATION_NOOP_DENIAL_RECEIPT_READBACK_2026-06-30.md" \
  '
  def noop_result_projection_id($kind):
    if $kind == "mcp_server" then
      "noop-result:hepta-system:local-mcp:denied-no-invocation"
    elif $kind == "app_connector" then
      "noop-result:hepta-system:local-app:denied-no-invocation"
    else
      "noop-result:hepta-system:unknown:denied-no-invocation"
    end;
  def noop_result_digest($kind):
    if $kind == "mcp_server" then
      "noop-result-digest:hepta-system:local-mcp:denied-v0"
    elif $kind == "app_connector" then
      "noop-result-digest:hepta-system:local-app:denied-v0"
    else
      "noop-result-digest:hepta-system:unknown:denied-v0"
    end;
  def invocation_denial_receipt_id($kind):
    if $kind == "mcp_server" then
      "tool-invocation-denial-receipt:hepta-system:local-mcp:no-invocation"
    elif $kind == "app_connector" then
      "tool-invocation-denial-receipt:hepta-system:local-app:no-invocation"
    else
      "tool-invocation-denial-receipt:hepta-system:unknown:no-invocation"
    end;
  def ledger_denial_anchor_id($kind):
    if $kind == "mcp_server" then
      "ledger-denial-anchor:hepta-system:local-mcp:no-write"
    elif $kind == "app_connector" then
      "ledger-denial-anchor:hepta-system:local-app:no-write"
    else
      "ledger-denial-anchor:hepta-system:unknown:no-write"
    end;
  def approval_denial_anchor_id($kind):
    if $kind == "mcp_server" then
      "approval-denial-anchor:hepta-system:local-mcp:no-request"
    elif $kind == "app_connector" then
      "approval-denial-anchor:hepta-system:local-app:no-request"
    else
      "approval-denial-anchor:hepta-system:unknown:no-request"
    end;
  def receipt_denial_anchor_id($kind):
    if $kind == "mcp_server" then
      "receipt-denial-anchor:hepta-system:local-mcp:no-persistence"
    elif $kind == "app_connector" then
      "receipt-denial-anchor:hepta-system:local-app:no-persistence"
    else
      "receipt-denial-anchor:hepta-system:unknown:no-persistence"
    end;
  def invocation_idempotency_key($kind):
    if $kind == "mcp_server" then
      "tool-invocation-idempotency:hepta-system:local-mcp:no-invocation"
    elif $kind == "app_connector" then
      "tool-invocation-idempotency:hepta-system:local-app:no-invocation"
    else
      "tool-invocation-idempotency:hepta-system:unknown:no-invocation"
    end;
  def entry($source_entry): {
    candidate_tool_id:$source_entry.candidate_tool_id,
    contribution_kind:$source_entry.contribution_kind,
    source_preflight_route:$source_entry.source_preflight_route,
    tool_schema_digest:$source_entry.tool_schema_digest,
    tool_registry_registration_denial_id:$source_entry.tool_registry_registration_denial_id,
    source_registration_denial_receipt_id:$source_entry.first_registration_denial_receipt_id,
    tool_invocation_denial_id:$source_entry.invocation_denial_id,
    noop_result_projection_id:noop_result_projection_id($source_entry.contribution_kind),
    noop_result_digest:noop_result_digest($source_entry.contribution_kind),
    first_invocation_denial_receipt_id:invocation_denial_receipt_id($source_entry.contribution_kind),
    second_invocation_denial_receipt_id:invocation_denial_receipt_id($source_entry.contribution_kind),
    stable_invocation_denial_receipt:true,
    unique_invocation_denial_receipt:true,
    ledger_denial_anchor_id:ledger_denial_anchor_id($source_entry.contribution_kind),
    approval_denial_anchor_id:approval_denial_anchor_id($source_entry.contribution_kind),
    receipt_denial_anchor_id:receipt_denial_anchor_id($source_entry.contribution_kind),
    first_invocation_idempotency_key:invocation_idempotency_key($source_entry.contribution_kind),
    second_invocation_idempotency_key:invocation_idempotency_key($source_entry.contribution_kind),
    stable_idempotency_key:true,
    unique_idempotency_key:true,
    invocation_denial_id_projected:true,
    noop_result_projected:true,
    noop_result_digest_projected:true,
    invocation_denial_receipt_projected:true,
    ledger_denial_anchor_projected:true,
    approval_denial_anchor_projected:true,
    receipt_denial_anchor_projected:true,
    idempotency_key_projected:true,
    tool_registered:$source_entry.tool_registered,
    tool_registry_mutated:$source_entry.tool_registry_mutated,
    registry_lookup_executed:$source_entry.registry_lookup_executed,
    tool_invoked:$source_entry.tool_invoked,
    noop_result_persisted:false,
    ledger_written:$source_entry.ledger_written,
    approval_requested:$source_entry.approval_requested,
    receipt_persisted:$source_entry.receipt_persisted,
    dynamic_activation_started:$source_entry.dynamic_activation_started,
    permission_granted:$source_entry.permission_granted,
    mcp_server_started:$source_entry.mcp_server_started,
    app_connector_started:$source_entry.app_connector_started,
    plugin_installed:$source_entry.plugin_installed,
    cache_materialized:$source_entry.cache_materialized,
    cache_mutated:$source_entry.cache_mutated,
    runtime_event_log_written:$source_entry.runtime_event_log_written,
    sqlite_written:$source_entry.sqlite_written,
    live_execution_started:$source_entry.live_execution_started
  };
  ($source[0]) as $source_report |
  ($source_report.entries | map(entry(.))) as $entries |
  ($entries | length) as $invocation_entry_count |
  ($entries | map(select(.invocation_denial_id_projected == true)) | length) as $invocation_denial_id_projected_count |
  ($entries | map(select(.noop_result_projected == true)) | length) as $noop_result_projected_count |
  ($entries | map(select(.noop_result_digest_projected == true)) | length) as $noop_result_digest_projected_count |
  ($entries | map(select(.stable_invocation_denial_receipt == true)) | length) as $stable_invocation_denial_receipt_count |
  ($entries | map(.first_invocation_denial_receipt_id) | unique | length) as $unique_invocation_denial_receipt_count |
  ($entries | map(select(.invocation_denial_receipt_projected == true)) | length) as $invocation_denial_receipt_projected_count |
  ($entries | map(select(.ledger_denial_anchor_projected == true)) | length) as $ledger_denial_anchor_projected_count |
  ($entries | map(select(.approval_denial_anchor_projected == true)) | length) as $approval_denial_anchor_projected_count |
  ($entries | map(select(.receipt_denial_anchor_projected == true)) | length) as $receipt_denial_anchor_projected_count |
  ($entries | map(select(.idempotency_key_projected == true)) | length) as $idempotency_key_projected_count |
  ($entries | map(select(.stable_idempotency_key == true)) | length) as $stable_idempotency_key_count |
  ($entries | map(.first_invocation_idempotency_key) | unique | length) as $unique_idempotency_key_count |
  ($entries | map(select(.stable_invocation_denial_receipt == false)) | length) as $invocation_denial_receipt_mismatch_count |
  ($invocation_entry_count - $unique_invocation_denial_receipt_count) as $duplicate_invocation_denial_receipt_count |
  ($entries | map(select(.stable_idempotency_key == false)) | length) as $idempotency_key_mismatch_count |
  ($invocation_entry_count - $unique_idempotency_key_count) as $duplicate_idempotency_key_count |
  ($entries | map(select(.tool_registered == true)) | length) as $tool_registered_count |
  ($entries | map(select(.tool_registry_mutated == true)) | length) as $tool_registry_mutated_count |
  ($entries | map(select(.registry_lookup_executed == true)) | length) as $registry_lookup_executed_count |
  ($entries | map(select(.tool_invoked == true)) | length) as $tool_invoked_count |
  ($entries | map(select(.noop_result_persisted == true)) | length) as $noop_result_persisted_count |
  ($entries | map(select(.ledger_written == true)) | length) as $ledger_written_count |
  ($entries | map(select(.approval_requested == true)) | length) as $approval_requested_count |
  ($entries | map(select(.receipt_persisted == true)) | length) as $receipt_persisted_count |
  ($entries | map(select(.dynamic_activation_started == true)) | length) as $dynamic_activation_started_count |
  ($entries | map(select(.permission_granted == true)) | length) as $permission_granted_count |
  ($entries | map(select(.mcp_server_started == true)) | length) as $mcp_server_started_count |
  ($entries | map(select(.app_connector_started == true)) | length) as $app_connector_started_count |
  ($entries | map(select(.plugin_installed == true)) | length) as $plugin_installed_count |
  ($entries | map(select(.cache_materialized == true)) | length) as $cache_materialized_count |
  ($entries | map(select(.cache_mutated == true)) | length) as $cache_mutated_count |
  ($entries | map(select(.runtime_event_log_written == true)) | length) as $runtime_event_log_written_count |
  ($entries | map(select(.sqlite_written == true)) | length) as $sqlite_written_count |
  ($entries | map(select(.live_execution_started == true)) | length) as $live_execution_started_count |
  ($source_report.tool_registry_registration_denial_receipt_readback_ready == true
    and $source_report.candidate_count == 2
    and $source_report.invocation_denial_projected_count == 2
    and $lib_export_present == true
    and $invocation_entry_count == 2
    and $invocation_denial_id_projected_count == 2
    and $noop_result_projected_count == 2
    and $noop_result_digest_projected_count == 2
    and $stable_invocation_denial_receipt_count == 2
    and $unique_invocation_denial_receipt_count == 2
    and $invocation_denial_receipt_projected_count == 2
    and $ledger_denial_anchor_projected_count == 2
    and $approval_denial_anchor_projected_count == 2
    and $receipt_denial_anchor_projected_count == 2
    and $idempotency_key_projected_count == 2
    and $stable_idempotency_key_count == 2
    and $unique_idempotency_key_count == 2
    and $invocation_denial_receipt_mismatch_count == 0
    and $duplicate_invocation_denial_receipt_count == 0
    and $idempotency_key_mismatch_count == 0
    and $duplicate_idempotency_key_count == 0
    and $tool_registered_count == 0
    and $tool_registry_mutated_count == 0
    and $registry_lookup_executed_count == 0
    and $tool_invoked_count == 0
    and $noop_result_persisted_count == 0
    and $ledger_written_count == 0
    and $approval_requested_count == 0
    and $receipt_persisted_count == 0
    and $dynamic_activation_started_count == 0
    and $permission_granted_count == 0
    and $mcp_server_started_count == 0
    and $app_connector_started_count == 0
    and $plugin_installed_count == 0
    and $cache_materialized_count == 0
    and $cache_mutated_count == 0
    and $runtime_event_log_written_count == 0
    and $sqlite_written_count == 0
    and $live_execution_started_count == 0
    and ($entries | all(.invocation_denial_id_projected == true
      and .noop_result_projected == true
      and .noop_result_digest_projected == true
      and .invocation_denial_receipt_projected == true
      and .stable_invocation_denial_receipt == true
      and .unique_invocation_denial_receipt == true
      and .ledger_denial_anchor_projected == true
      and .approval_denial_anchor_projected == true
      and .receipt_denial_anchor_projected == true
      and .idempotency_key_projected == true
      and .stable_idempotency_key == true
      and .unique_idempotency_key == true
      and .tool_registered == false
      and .tool_registry_mutated == false
      and .registry_lookup_executed == false
      and .tool_invoked == false
      and .noop_result_persisted == false
      and .ledger_written == false
      and .approval_requested == false
      and .receipt_persisted == false
      and .dynamic_activation_started == false
      and .permission_granted == false
      and .mcp_server_started == false
      and .app_connector_started == false
      and .plugin_installed == false
      and .cache_materialized == false
      and .cache_mutated == false
      and .runtime_event_log_written == false
      and .sqlite_written == false
      and .live_execution_started == false))) as $ready |
  {
    runtime:"hepta",
    surface:"hepta_systems_plugin_tool_invocation_noop_denial_receipt_readback",
    status:(if $ready then "ready_blocked" else "blocked" end),
    gate:"hepta_systems_plugin_tool_invocation_noop_denial_receipt_readback_gate",
    schema_version:"hepta_systems_plugin_tool_invocation_noop_denial_receipt_readback_v1",
    plugin_id:"hepta-system@hepta-local",
    manifest_name:$source_report.manifest_name,
    manifest_version:$source_report.manifest_version,
    source_tool_registry_registration_denial_receipt_ready:$source_report.tool_registry_registration_denial_receipt_readback_ready,
    lib_export_present:$lib_export_present,
    candidate_count:$source_report.candidate_count,
    invocation_entry_count:$invocation_entry_count,
    invocation_denial_id_projected_count:$invocation_denial_id_projected_count,
    noop_result_projected_count:$noop_result_projected_count,
    noop_result_digest_projected_count:$noop_result_digest_projected_count,
    stable_invocation_denial_receipt_count:$stable_invocation_denial_receipt_count,
    unique_invocation_denial_receipt_count:$unique_invocation_denial_receipt_count,
    invocation_denial_receipt_projected_count:$invocation_denial_receipt_projected_count,
    ledger_denial_anchor_projected_count:$ledger_denial_anchor_projected_count,
    approval_denial_anchor_projected_count:$approval_denial_anchor_projected_count,
    receipt_denial_anchor_projected_count:$receipt_denial_anchor_projected_count,
    idempotency_key_projected_count:$idempotency_key_projected_count,
    stable_idempotency_key_count:$stable_idempotency_key_count,
    unique_idempotency_key_count:$unique_idempotency_key_count,
    invocation_denial_receipt_mismatch_count:$invocation_denial_receipt_mismatch_count,
    duplicate_invocation_denial_receipt_count:$duplicate_invocation_denial_receipt_count,
    idempotency_key_mismatch_count:$idempotency_key_mismatch_count,
    duplicate_idempotency_key_count:$duplicate_idempotency_key_count,
    tool_registered_count:$tool_registered_count,
    tool_registry_mutated_count:$tool_registry_mutated_count,
    registry_lookup_executed_count:$registry_lookup_executed_count,
    tool_invoked_count:$tool_invoked_count,
    noop_result_persisted_count:$noop_result_persisted_count,
    ledger_written_count:$ledger_written_count,
    approval_requested_count:$approval_requested_count,
    receipt_persisted_count:$receipt_persisted_count,
    dynamic_activation_started_count:$dynamic_activation_started_count,
    permission_granted_count:$permission_granted_count,
    mcp_server_started_count:$mcp_server_started_count,
    app_connector_started_count:$app_connector_started_count,
    plugin_installed_count:$plugin_installed_count,
    cache_materialized_count:$cache_materialized_count,
    cache_mutated_count:$cache_mutated_count,
    runtime_event_log_written_count:$runtime_event_log_written_count,
    sqlite_written_count:$sqlite_written_count,
    live_execution_started_count:$live_execution_started_count,
    tool_invocation_noop_denial_receipt_readback_ready:$ready,
    tool_registry_registration_allowed:false,
    tool_registry_mutation_allowed:false,
    registry_lookup_execution_allowed:false,
    tool_invocation_allowed:false,
    noop_result_persistence_allowed:false,
    ledger_write_allowed:false,
    approval_request_allowed:false,
    receipt_persistence_allowed:false,
    dynamic_activation_allowed:false,
    permission_grant_allowed:false,
    mcp_server_start_allowed:false,
    app_connector_start_allowed:false,
    plugin_install_allowed:false,
    plugin_cache_mutation_allowed:false,
    install_cache_materialization_allowed:false,
    runtime_event_log_write_allowed:false,
    sqlite_write_allowed:false,
    live_execution_allowed:false,
    entries:$entries,
    blockers:[
      "tool_registry_registration_disabled",
      "tool_registry_mutation_disabled",
      "registry_lookup_execution_disabled",
      "tool_invocation_disabled",
      "noop_result_persistence_disabled",
      "ledger_write_disabled",
      "approval_request_disabled",
      "receipt_persistence_disabled",
      "dynamic_activation_disabled",
      "permission_grant_disabled",
      "mcp_server_start_disabled",
      "app_connector_start_disabled",
      "plugin_install_disabled",
      "plugin_cache_mutation_disabled",
      "install_cache_materialization_disabled",
      "runtime_event_log_write_disabled",
      "sqlite_write_disabled",
      "live_execution_disabled"
    ],
    next_actions:[
      "hepta_systems_plugin_tool_invocation_policy_approval_ledger_boundary_readback"
    ],
    recommended_next_gate:"hepta_systems_plugin_tool_invocation_policy_approval_ledger_boundary_readback",
    local_gate:$gate,
    architecture_note:$doc,
    side_effect_free:true,
    side_effects:{
      report_written:false,
      git_index_mutated:false,
      filesystem_written:false,
      plugin_installed:false,
      plugin_cache_mutated:false,
      install_cache_materialized:false,
      dynamic_activation_started:false,
      permission_granted:false,
      mcp_server_started:false,
      app_connector_started:false,
      tool_registry_mutated:false,
      tool_registered:false,
      registry_lookup_executed:false,
      tool_invoked:false,
      noop_result_persisted:false,
      ledger_written:false,
      approval_requested:false,
      receipt_persisted:false,
      runtime_event_log_written:false,
      sqlite_written:false,
      credential_read:false,
      external_network_used:false,
      gateway_or_auth_mutated:false,
      native_post_mutation_performed:false,
      telegram_transport_mutated:false,
      channel_send_performed:false,
      provider_invoked:false,
      model_invoked:false,
      package_or_release_written:false,
      public_ga_promoted:false,
      live_execution_started:false
    }
  }
  '
