#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-terminal-governance-bridge.report"
CLOSURE_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-tool-execution-live-cutover-closure-index.gate"
CANONICAL_TERMINAL_INDEX_GATE="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-current-canonical-governance-terminal-index.gate"
DOC="$ROOT/docs/architecture/HEPTA_SYSTEMS_TOOL_EXECUTION_TERMINAL_GOVERNANCE_BRIDGE_2026-06-21.md"

fail() {
  printf 'hepta-systems-tool-execution-terminal-governance-bridge-gate: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$REPORT" ]] || fail "missing executable terminal governance bridge report: $REPORT"
[[ -x "$CLOSURE_GATE" ]] || fail "missing executable tool execution closure index gate: $CLOSURE_GATE"
[[ -x "$CANONICAL_TERMINAL_INDEX_GATE" ]] || fail "missing executable current canonical governance terminal index gate: $CANONICAL_TERMINAL_INDEX_GATE"
[[ -f "$DOC" ]] || fail "missing terminal governance bridge architecture note: $DOC"

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to validate the terminal governance bridge report"
fi

grep -q 'Terminal Governance Bridge' "$DOC" \
  || fail "architecture note must document Terminal Governance Bridge"
grep -q 'without invocation' "$DOC" \
  || fail "architecture note must document without invocation"
grep -q 'does not invoke terminal live gates' "$DOC" \
  || fail "architecture note must document non-invocation of terminal live gates"
grep -q 'current canonical governance terminal index' "$DOC" \
  || fail "architecture note must document current canonical governance terminal index attachment"
grep -q '17-blocker closure categories' "$DOC" \
  || fail "architecture note must document 17-blocker closure categories"
grep -q 'canonical terminal backfeed' "$DOC" \
  || fail "architecture note must document canonical terminal backfeed"

"$REPORT" | jq -e '
  .runtime == "hepta"
  and .surface == "tool_execution_terminal_governance_bridge"
  and .plugin_id == "hepta-system@hepta-local"
  and .status == "ready"
  and .source_closure_surface == "tool_execution_live_cutover_closure_index"
  and .source_closure_ready == true
  and .source_manual_operator_live_cutover_approval_required == true
  and .source_live_cutover_allowed == false
  and .source_public_ga_allowed == false
  and .source_closure_blocker_count == 17
  and .source_closure_blocker_category_count == 4
  and .source_closure_blocker_category_ready_count == 4
  and .source_closure_blocker_category_blocker_count == 17
  and .source_closure_blocker_categorization_ready == true
  and (.source_closure_blocker_categories | length) == 4
  and any(.source_closure_blocker_categories[]; .id == "approval_control" and .blocker_count == 4)
  and any(.source_closure_blocker_categories[]; .id == "execution_and_receipts" and .blocker_count == 9)
  and any(.source_closure_blocker_categories[]; .id == "runner_selector" and .blocker_count == 2)
  and any(.source_closure_blocker_categories[]; .id == "dirty_worktree_owner_freeze" and .blocker_count == 2)
  and .source_current_canonical_governance_terminal_index_surface == "current_canonical_governance_terminal_index"
  and .source_current_canonical_governance_terminal_index_ready == true
  and .source_current_canonical_governance_terminal_index_blocked == true
  and .source_active_current_canonical_consumer_surface == "current_canonical_consumer"
  and .source_successor_cutover_final_gate_attached == true
  and .source_successor_consumer_cutover_allowed == false
  and .source_canonical_governance_terminal_blocker_count == 13
  and .source_canonical_governance_tool_execution_closure_backfeed_ready == true
  and .source_canonical_governance_tool_execution_closure_backfeed_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_category_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_ready_count == 4
  and .source_canonical_governance_tool_execution_closure_backfeed_category_blocker_count == 17
  and .source_canonical_governance_tool_execution_closure_backfeed_categorization_ready == true
  and (.source_canonical_governance_tool_execution_closure_backfeed_categories | length) == 4
  and any(.source_canonical_governance_tool_execution_closure_backfeed_categories[]; .id == "runner_selector" and .blocker_count == 2)
  and any(.source_canonical_governance_tool_execution_closure_backfeed_categories[]; .id == "dirty_worktree_owner_freeze" and .blocker_count == 2)
  and .source_canonical_governance_rollback_anchor == "current_canonical_consumer"
  and .bridge_source_count == 2
  and .canonical_governance_terminal_index_attached == true
  and .terminal_source_probe_count == 4
  and .terminal_source_probe_ready_count == 4
  and (.terminal_source_probes | length) == 4
  and (.terminal_source_probes | all(.script_present == true and .doc_present == true and .invoked == false))
  and .terminal_live_gates_invoked == false
  and .canonical_gate_wrapper_invoked == false
  and .wrapper_target_invoked == false
  and .terminal_live_url_required == false
  and .long_soak_required == false
  and .tool_execution_terminal_governance_bridge_ready == true
  and .tool_execution_live_cutover_allowed == false
  and .tool_execution_public_ga_allowed == false
  and .next_migration_step == "derive_tool_execution_terminal_governance_bridge_canonical_attachment_readback_without_live_gate_invocation"
  and (.bridge_blockers | index("manual_operator_live_cutover_approval_required")) != null
  and (.bridge_blockers | index("canonical_successor_consumer_cutover_disallowed")) != null
  and (.bridge_blockers | index("current_canonical_consumer_rollback_anchor_retained")) != null
  and (.bridge_blockers | index("terminal_live_gates_not_invoked_by_bridge")) != null
  and .side_effect_free == true
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null

"$CLOSURE_GATE" >/dev/null
"$CANONICAL_TERMINAL_INDEX_GATE" >/dev/null

printf 'hepta-systems-tool-execution-terminal-governance-bridge-gate: PASS: terminal governance bridge sees tool execution closure and current canonical governance without invoking live gates\n'
