#!/usr/bin/env bash
set -euo pipefail

repo_root="${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
report_script="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-source-aware-compression-readiness-export.report"
context_contracts="$repo_root/codex-rs/CONTEXT_DEBUG_CONTRACTS.md"
debug_gate="$repo_root/scripts/hepta-context-debug-gate.sh"
preflight_script="$repo_root/scripts/hepta-context-preflight.sh"
front_door_gate="$repo_root/scripts/lib/hepta-gate-pair-compat-v1/hepta-context-source-aware-compression-front-door.gate"
release_manifest="$repo_root/codex-rs/CONTEXT_LANE_RELEASE_MANIFEST.tsv"
report_output="$(mktemp -t hepta-context-source-aware-readiness-export-report.XXXXXX)"
expected_output="$(mktemp -t hepta-context-source-aware-readiness-export-expected.XXXXXX)"

cleanup() {
  rm -f "$report_output" "$expected_output"
}
trap cleanup EXIT

fail() {
  echo "hepta-context-source-aware-compression-readiness-export-gate: $*" >&2
  if [ -s "$report_output" ]; then
    echo "readiness export report output:" >&2
    cat "$report_output" >&2
  fi
  exit 1
}

assert_file_contains() {
  local file_path="$1"
  local needle="$2"
  local label="$3"

  if ! grep -F "$needle" "$file_path" >/dev/null; then
    fail "$label must contain: $needle"
  fi
}

line_number_of() {
  local file_path="$1"
  local needle="$2"
  local line

  line="$(grep -n -F "$needle" "$file_path" | head -n 1 | cut -d: -f1 || true)"
  if [ -z "$line" ]; then
    fail "$file_path is missing required text: $needle"
  fi
  printf '%s\n' "$line"
}

assert_line_before() {
  local file_path="$1"
  local before_needle="$2"
  local after_needle="$3"
  local label="$4"
  local before_line
  local after_line

  before_line="$(line_number_of "$file_path" "$before_needle")"
  after_line="$(line_number_of "$file_path" "$after_needle")"
  if [ "$before_line" -ge "$after_line" ]; then
    fail "$label expected '$before_needle' before '$after_needle'"
  fi
}

required_contract_terms=(
  "Source-aware compression readiness export surface"
  "source-aware-readiness-export=pass"
  "source-aware-readiness-export.runtime-activation=disabled"
  "source-aware-readiness-export.operator-approval-evidence=contract-only"
  "source-aware-readiness-export.positive-route=unimplemented"
  "source-aware-readiness-export.no-production-consumption=pass"
  "source-aware-readiness-export.no-debug-export-leak=pass"
  "payload-light fixed status block"
  "run after the operator approval evidence gate"
  "before the activation"
  "scripts/lib/hepta-context-gates-v1/hepta-context-source-aware-compression-readiness-export.report"
  "scripts/lib/hepta-context-gates-v1/hepta-context-source-aware-compression-readiness-export.gate"
)

for term in "${required_contract_terms[@]}"; do
  assert_file_contains \
    "$context_contracts" \
    "$term" \
    "source-aware compression readiness export surface contract"
done

assert_file_contains \
  "$debug_gate" \
  "hepta-context-source-aware-compression-readiness-export-gate.sh" \
  "source-aware compression readiness export debug gate"

assert_file_contains \
  "$preflight_script" \
  "source-aware compression readiness export surface gate" \
  "source-aware compression readiness export preflight stage"

assert_line_before \
  "$preflight_script" \
  "source-aware compression operator approval evidence contract gate" \
  "source-aware compression readiness export surface gate" \
  "source-aware compression readiness export preflight stage order"

assert_line_before \
  "$preflight_script" \
  "source-aware compression readiness export surface gate" \
  "source-aware compression activation negative matrix contract gate" \
  "source-aware compression readiness export preflight stage order"

assert_file_contains \
  "$front_door_gate" \
  "hepta-context-source-aware-compression-readiness-export-gate.sh" \
  "source-aware compression readiness export front-door gate"

assert_line_before \
  "$front_door_gate" \
  '  "operator approval evidence" \' \
  '  "readiness export surface" \' \
  "source-aware compression readiness export front-door order"

assert_line_before \
  "$front_door_gate" \
  '  "readiness export surface" \' \
  '  "activation negative matrix" \' \
  "source-aware compression readiness export front-door order"

assert_file_contains \
  "$release_manifest" \
  "scripts/lib/hepta-context-gates-v1/hepta-context-source-aware-compression-readiness-export.report" \
  "source-aware compression readiness export release manifest"

assert_file_contains \
  "$release_manifest" \
  "scripts/lib/hepta-context-gates-v1/hepta-context-source-aware-compression-readiness-export.gate" \
  "source-aware compression readiness export release manifest"

cat >"$expected_output" <<'EOF'
source-aware-readiness-export=pass
source-aware-readiness-export.schema=1
source-aware-readiness-export.runtime-activation=disabled
source-aware-readiness-export.reserved-route=disabled
source-aware-readiness-export.operator-approval-evidence=contract-only
source-aware-readiness-export.positive-route=unimplemented
source-aware-readiness-export.canary=under-development
source-aware-readiness-export.helper-marker=required
source-aware-readiness-export.no-production-consumption=pass
source-aware-readiness-export.no-debug-export-leak=pass
EOF

if ! bash "$report_script" >"$report_output" 2>&1; then
  fail "readiness export report failed"
fi

if ! diff -u "$expected_output" "$report_output"; then
  fail "readiness export report output changed"
fi

leak_pattern='(prompt_text|transcript_text|memory_text|answer_text|source_id|session_id|memory_id|trace_id|query_text|tool_args|raw_payload|operator@example|source_aware_compression_operator_approval_id|source_aware_compression_operator_identity_hash|source_aware_compression_activation_request_id|source_aware_compression_operator_approval_nonce|source_aware_compression_operator_approval_expires_at|runtime-activation=enabled|reserved-route=enabled|operator-approval-evidence=(enabled|present|accepted)|positive-route=implemented|production-write=enabled|graph-write=enabled|operator-activation=enabled)'
if grep -E "$leak_pattern" "$report_output" >/dev/null; then
  fail "readiness export report leaked payload or activation state"
fi

echo "source-aware-readiness-export=pass"
echo "source-aware-readiness-export.payload-light=pass"
echo "source-aware-readiness-export.runtime-activation=disabled"
echo "Hepta context source-aware compression readiness export gate passed"
