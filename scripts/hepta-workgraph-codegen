#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"

ROOT = File.expand_path("..", __dir__)
SOURCE_ROOT = File.join(ROOT, "codex-rs/hepta-runtime/src")
CODEGEN_ROOT = File.join(ROOT, "codex-rs/hepta-runtime/codegen/workgraph-v1")
SCHEMA = "hepta_workgraph_codegen_v1"
MIN_GROUP_SIZE = 3
GENERATED_INCLUDE_MARKER = "/hepta_workgraph_codegen/"
KEYWORDS = %w[
  as async await break const continue crate dyn else enum extern false fn for if impl in let loop
  match mod move mut pub ref return self Self static struct super trait true type union unsafe use
  where while
].freeze

Token = Struct.new(:kind, :text)

def usage
  warn "usage: scripts/hepta-workgraph-codegen [pack|verify|unpack]"
  exit 2
end

def candidate_files
  Dir.glob(File.join(SOURCE_ROOT, "wg_*.rs")).sort
end

def identifier_start?(byte)
  byte == 95 || byte&.between?(65, 90) || byte&.between?(97, 122)
end

def identifier_continue?(byte)
  identifier_start?(byte) || byte&.between?(48, 57)
end

def tokenize(source)
  tokens = []
  index = 0
  while index < source.bytesize
    byte = source.getbyte(index)
    if byte&.chr&.match?(/\s/)
      finish = index + 1
      finish += 1 while finish < source.bytesize && source.getbyte(finish).chr.match?(/\s/)
      tokens << Token.new(:space, source.byteslice(index...finish))
      index = finish
    elsif source.byteslice(index, 2) == "//"
      finish = source.index("\n", index) || source.bytesize
      finish += 1 if finish < source.bytesize
      tokens << Token.new(:comment, source.byteslice(index...finish))
      index = finish
    elsif source.byteslice(index, 2) == "/*"
      finish = source.index("*/", index + 2)
      raise "unterminated block comment" unless finish
      finish += 2
      tokens << Token.new(:comment, source.byteslice(index...finish))
      index = finish
    elsif (raw = raw_string_at(source, index))
      tokens << Token.new(:literal, raw)
      index += raw.bytesize
    elsif source.byteslice(index, 2) == 'b"' || byte == 34
      finish = quoted_end(source, index + (byte == 98 ? 1 : 0), 34)
      tokens << Token.new(:literal, source.byteslice(index...finish))
      index = finish
    elsif source.byteslice(index, 2) == "b'" || byte == 39
      literal_index = byte == 98 ? index + 1 : index
      finish = lifetime_or_char_end(source, literal_index)
      kind = source.getbyte(finish - 1) == 39 ? :literal : :identifier
      tokens << Token.new(kind, source.byteslice(index...finish))
      index = finish
    elsif source.byteslice(index, 2) == "r#" && identifier_start?(source.getbyte(index + 2))
      finish = index + 3
      finish += 1 while identifier_continue?(source.getbyte(finish))
      tokens << Token.new(:identifier, source.byteslice(index...finish))
      index = finish
    elsif identifier_start?(byte)
      finish = index + 1
      finish += 1 while identifier_continue?(source.getbyte(finish))
      text = source.byteslice(index...finish)
      tokens << Token.new(KEYWORDS.include?(text) ? :fixed : :identifier, text)
      index = finish
    elsif byte&.between?(48, 57)
      finish = index + 1
      finish += 1 while source.getbyte(finish)&.chr&.match?(/[A-Za-z0-9_.]/)
      tokens << Token.new(:number, source.byteslice(index...finish))
      index = finish
    else
      tokens << Token.new(:fixed, source.byteslice(index, 1))
      index += 1
    end
  end
  tokens
end

def raw_string_at(source, index)
  prefix = if source.byteslice(index, 2) == 'br'
             "br"
           elsif source.getbyte(index) == 114
             "r"
           end
  return nil unless prefix
  cursor = index + prefix.bytesize
  hashes = 0
  while source.getbyte(cursor) == 35
    hashes += 1
    cursor += 1
  end
  return nil unless source.getbyte(cursor) == 34
  terminator = '"' + ("#" * hashes)
  finish = source.index(terminator, cursor + 1)
  raise "unterminated raw string" unless finish
  source.byteslice(index...(finish + terminator.bytesize))
end

def quoted_end(source, quote_index, quote)
  cursor = quote_index + 1
  escaped = false
  while cursor < source.bytesize
    byte = source.getbyte(cursor)
    if escaped
      escaped = false
    elsif byte == 92
      escaped = true
    elsif byte == quote
      return cursor + 1
    end
    cursor += 1
  end
  raise "unterminated quoted literal"
end

def lifetime_or_char_end(source, index)
  cursor = index + 1
  if identifier_start?(source.getbyte(cursor))
    cursor += 1 while identifier_continue?(source.getbyte(cursor))
    return cursor unless source.getbyte(cursor) == 39
  end
  quoted_end(source, index, 39)
end

def signature(tokens)
  tokens.map do |token|
    token.kind == :fixed ? "fixed:#{token.text}" : token.kind.to_s
  end.join("\0")
end

def encode_hex(value)
  value.unpack1("H*")
end

def decode_hex(value)
  [value].pack("H*")
end

def atomic_write(path, content, mode = nil)
  staging = File.join(
    File.dirname(path),
    ".hepta-workgraph-codegen-#{Digest::SHA256.hexdigest(path)[0, 12]}-#{$$}.tmp"
  )
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end

def generated_stub(module_name, expanded)
  attributes = expanded.lines.take_while { |line| line.start_with?("#![") }.join
  attributes + <<~RUST
    include!(concat!(
        env!("OUT_DIR"),
        "/hepta_workgraph_codegen/#{module_name}.rs"
    ));
  RUST
end

def build_family(files, token_sets)
  vectors = {}
  placeholder_vectors = []
  template = +""
  token_sets.first.each_index do |index|
    values = token_sets.map { |tokens| tokens.fetch(index).text }
    if values.uniq.one?
      template << values.first
      next
    end
    key = [token_sets.first.fetch(index).kind, values]
    placeholder = vectors[key]
    unless placeholder
      placeholder = placeholder_vectors.length
      vectors[key] = placeholder
      placeholder_vectors << values
    end
    template << format("@@HEPTA_WORKGRAPH_TOKEN_%04d@@", placeholder)
  end
  rows = files.each_index.map do |file_index|
    module_name = File.basename(files.fetch(file_index), ".rs")
    source = File.binread(files.fetch(file_index))
    replacements = placeholder_vectors.map { |values| encode_hex(values.fetch(file_index)) }
    [
      module_name,
      Digest::SHA256.hexdigest(source),
      replacements.length,
      *replacements
    ].join("\t")
  end
  [template, rows]
end

def pack
  files = candidate_files
  if File.file?(File.join(CODEGEN_ROOT, "registry.tsv")) &&
      files.any? { |file| File.binread(file).include?(GENERATED_INCLUDE_MARKER) }
    rewrite_stubs
    verify
    return
  end
  token_sets = files.to_h { |file| [file, tokenize(File.binread(file))] }
  groups = files.group_by { |file| signature(token_sets.fetch(file)) }
    .values
    .select { |group| group.length >= MIN_GROUP_SIZE }
    .sort_by { |group| [-group.length, group.first] }
  raise "no WorkGraph clone families selected" if groups.empty?
  FileUtils.mkdir_p(CODEGEN_ROOT)
  Dir.glob(File.join(CODEGEN_ROOT, "*")).each { |path| FileUtils.rm_f(path) }
  registry = [SCHEMA]
  groups.each do |group|
    family = Digest::SHA256.hexdigest(signature(token_sets.fetch(group.first)))[0, 16]
    template, rows = build_family(group, group.map { |file| token_sets.fetch(file) })
    original_lines = group.sum { |file| File.foreach(file).count }
    template_lines = template.lines.count
    atomic_write(File.join(CODEGEN_ROOT, "#{family}.tmpl"), template)
    atomic_write(
      File.join(CODEGEN_ROOT, "#{family}.tsv"),
      ([SCHEMA] + rows).join("\n") + "\n"
    )
    stub_lines = group.sum do |file|
      generated_stub(File.basename(file, ".rs"), File.binread(file)).lines.count
    end
    registry << [
      family,
      group.length,
      original_lines,
      template_lines,
      original_lines - template_lines - stub_lines
    ].join("\t")
    group.each do |file|
      module_name = File.basename(file, ".rs")
      source = File.binread(file)
      atomic_write(file, generated_stub(module_name, source), File.stat(file).mode & 0o777)
    end
  end
  atomic_write(File.join(CODEGEN_ROOT, "registry.tsv"), registry.join("\n") + "\n")
  verify
end

def each_manifest
  Dir.glob(File.join(CODEGEN_ROOT, "*.tsv"))
    .reject { |path| File.basename(path) == "registry.tsv" }
    .sort
    .each { |path| yield path }
end

def expanded_rows(manifest_path)
  family = File.basename(manifest_path, ".tsv")
  template = File.binread(File.join(CODEGEN_ROOT, "#{family}.tmpl"))
  lines = File.binread(manifest_path).lines(chomp: true)
  raise "invalid WorkGraph manifest schema" unless lines.shift == SCHEMA
  lines.map do |line|
    fields = line.split("\t", -1)
    module_name, expected_sha, count_text, *encoded = fields
    count = Integer(count_text, 10)
    raise "replacement count mismatch for #{module_name}" unless count == encoded.length
    expanded = template.dup
    encoded.each_with_index do |value, index|
      expanded.gsub!(format("@@HEPTA_WORKGRAPH_TOKEN_%04d@@", index), decode_hex(value))
    end
    raise "unexpanded placeholder for #{module_name}" if expanded.include?("@@HEPTA_WORKGRAPH_TOKEN_")
    [module_name, expected_sha, expanded]
  end
end

def rewrite_stubs
  registry = [SCHEMA]
  each_manifest do |manifest|
    family = File.basename(manifest, ".tsv")
    expanded = expanded_rows(manifest)
    original_lines = 0
    stub_lines = 0
    expanded.each do |module_name, expected_sha, source_body|
      raise "WorkGraph SHA mismatch for #{module_name}" unless Digest::SHA256.hexdigest(source_body) == expected_sha
      source = File.join(SOURCE_ROOT, "#{module_name}.rs")
      stub = generated_stub(module_name, source_body)
      atomic_write(source, stub, File.stat(source).mode & 0o777)
      original_lines += source_body.lines.count
      stub_lines += stub.lines.count
    end
    template_lines = File.foreach(File.join(CODEGEN_ROOT, "#{family}.tmpl")).count
    registry << [
      family,
      expanded.length,
      original_lines,
      template_lines,
      original_lines - template_lines - stub_lines
    ].join("\t")
  end
  atomic_write(File.join(CODEGEN_ROOT, "registry.tsv"), registry.join("\n") + "\n")
end

def verify
  registry = File.binread(File.join(CODEGEN_ROOT, "registry.tsv")).lines(chomp: true)
  raise "invalid WorkGraph registry schema" unless registry.shift == SCHEMA
  expected_modules = 0
  total_savings = 0
  registry.each do |line|
    _family, count, _original, _template, savings = line.split("\t")
    expected_modules += Integer(count, 10)
    total_savings += Integer(savings, 10)
  end
  actual_modules = 0
  each_manifest do |manifest|
    expanded_rows(manifest).each do |module_name, expected_sha, expanded|
      raise "WorkGraph SHA mismatch for #{module_name}" unless Digest::SHA256.hexdigest(expanded) == expected_sha
      source = File.join(SOURCE_ROOT, "#{module_name}.rs")
      expected_stub = generated_stub(module_name, expanded)
      raise "WorkGraph generated stub drifted for #{module_name}" unless File.binread(source) == expected_stub
      actual_modules += 1
    end
  end
  raise "WorkGraph generated module count mismatch" unless actual_modules == expected_modules
  raise "WorkGraph generated compression is below 3% headroom target" unless total_savings >= 36_000
  puts "hepta-workgraph-codegen: PASS: #{actual_modules} modules, #{total_savings} source lines removed"
end

def unpack
  each_manifest do |manifest|
    expanded_rows(manifest).each do |module_name, expected_sha, expanded|
      raise "WorkGraph SHA mismatch for #{module_name}" unless Digest::SHA256.hexdigest(expanded) == expected_sha
      source = File.join(SOURCE_ROOT, "#{module_name}.rs")
      atomic_write(source, expanded, File.stat(source).mode & 0o777)
    end
  end
end

usage unless ARGV.length == 1
case ARGV.fetch(0)
when "pack" then pack
when "verify" then verify
when "unpack" then unpack
else usage
end
