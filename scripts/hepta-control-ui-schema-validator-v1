#!/usr/bin/env bash
set -euo pipefail

VERSION="0.37.4"
BOOTSTRAP=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bootstrap) BOOTSTRAP=1; shift ;;
    --help|-h)
      cat <<'EOF'
usage: scripts/hepta-control-ui-schema-validator-v1 [--bootstrap]

Print the executable path for check-jsonschema 0.37.4. With --bootstrap, an
exact-version virtual environment is created under HEPTA_CHECK_JSONSCHEMA_VENV
or a disposable temporary root when no valid executable is already available.
EOF
      exit 0
      ;;
    *) echo "unknown argument: $1" >&2; exit 64 ;;
  esac
done

validator_ready() {
  local candidate="$1"
  [[ -n "$candidate" && -x "$candidate" \
    && "$("$candidate" --version 2>/dev/null)" == "check-jsonschema, version $VERSION" ]]
}

canonical_executable() {
  local candidate="$1"
  local parent
  parent="$(cd "$(dirname "$candidate")" && pwd -P)"
  printf '%s/%s\n' "$parent" "$(basename "$candidate")"
}

candidate="${HEPTA_CHECK_JSONSCHEMA_BIN:-}"
explicit_candidate=false
if [[ -z "$candidate" ]]; then
  candidate="$(command -v check-jsonschema 2>/dev/null || true)"
else
  explicit_candidate=true
  if [[ "$candidate" != */* ]]; then
    candidate="$(command -v "$candidate" 2>/dev/null || true)"
  fi
fi
if validator_ready "$candidate"; then
  canonical_executable "$candidate"
  exit 0
fi
if [[ "$explicit_candidate" == true ]]; then
  echo "explicit schema validator is not check-jsonschema $VERSION" >&2
  exit 1
fi

VENV="${HEPTA_CHECK_JSONSCHEMA_VENV:-${TMPDIR:-/tmp}/hepta-check-jsonschema-$VERSION}"
if [[ "$VENV" != /* ]]; then VENV="$PWD/$VENV"; fi
if [[ -L "$VENV" || ( -e "$VENV" && ! -d "$VENV" ) ]]; then
  echo "schema validator venv must be a real directory: $VENV" >&2
  exit 64
fi

candidate="$VENV/bin/check-jsonschema"
if validator_ready "$candidate"; then
  canonical_executable "$candidate"
  exit 0
fi

if [[ "$BOOTSTRAP" != "1" ]]; then
  echo "Control UI requires check-jsonschema $VERSION; rerun with --bootstrap" >&2
  exit 1
fi

command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 2; }
if [[ ! -d "$VENV" ]]; then
  python3 -m venv "$VENV"
elif [[ ! -x "$VENV/bin/python" ]]; then
  echo "existing schema validator venv is incomplete: $VENV" >&2
  exit 1
fi

"$VENV/bin/python" -m pip install \
  --disable-pip-version-check \
  --no-input \
  "check-jsonschema==$VERSION" >&2

if ! validator_ready "$candidate"; then
  echo "failed to provision check-jsonschema $VERSION under $VENV" >&2
  exit 1
fi
canonical_executable "$candidate"
