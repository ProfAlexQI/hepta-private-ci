"
EXPORT_BLOCK = 'pub use checked_model_invocation::{\n    AuthorizedModelInvocation, B1_MODEL_BOUNDARY_EXTERNAL_EFFECT,\n    B1_MODEL_BOUNDARY_MODEL_INVOCATION, B1_MODEL_BOUNDARY_OPERATOR_ACCEPTANCE,\n    B1_MODEL_BOUNDARY_PRODUCTION_CALLER, B1_MODEL_BOUNDARY_PRODUCTION_WRITER,\n    B1_MODEL_BOUNDARY_PROMOTION, B1_MODEL_BOUNDARY_PROVIDER_DISPATCH,\n    B1_MODEL_BOUNDARY_RELEASE, B1_MODEL_BOUNDARY_RUNTIME_REGISTERED,\n    B1_MODEL_BOUNDARY_TOOL_EFFECT_AUTHORITY, ClaimedModelInvocation,\n    ModelInvocationAdapter, ModelInvocationAdapterRequest, ModelInvocationBinding,\n    ModelInvocationBoundaryError, ModelInvocationCoordinator, ModelInvocationFuture,\n    ModelInvocationPurpose, ModelInvocationReceipt, ModelInvocationRecoveryDisposition,\n    ModelInvocationRequest, ModelInvocationRequestError, ModelInvocationTransport,\n    ModelInvocationWitnessPersistenceRequest, ModelInvocationWitnessStore,\n};\n'


def write_files() -> None:
    decoded = zlib.decompress(base64.b64decode(PAYLOAD))
    files: dict[str, str] = json.loads(decoded)
    for relative, content in files.items():
        path = ROOT / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


def patch_lib() -> None:
    path = ROOT / "codex-rs/hepta-contracts/src/lib.rs"
    text = path.read_text(encoding="utf-8")
    module_anchor = "mod canonical;\nmod checked_provider_operation;\n"
    module_replacement = "mod canonical;\nmod checked_model_invocation;\nmod checked_provider_operation;\n"
    if module_anchor not in text:
        raise SystemExit("lib.rs module anchor missing")
    text = text.replace(module_anchor, module_replacement, 1)
    export_anchor = "pub use checked_provider_operation::ProviderOperationCoordinator;\n"
    if export_anchor not in text:
        raise SystemExit("lib.rs export anchor missing")
    text = text.replace(export_anchor, EXPORT_BLOCK + export_anchor, 1)
    path.write_text(text, encoding="utf-8")


