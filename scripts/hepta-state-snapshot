#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-state-snapshot --source-state-root DIR --destination-state-root DIR [--legacy-label LABEL] [--receipt PATH] [--materialize]
  hepta-state-snapshot verify --receipt PATH
  hepta-state-snapshot verify-source --receipt PATH
  hepta-state-snapshot self-test

The default is a read-only full-root v2 plan. --materialize requires the legacy
writer to have no open files anywhere under the state root, rejects every
nonempty WAL, copies every top-level entry into a new separate state root, and
writes a receipt after source identity and portable payload inventories agree.
Existing runtime-v2-only v1 receipts remain verifiable. The command never
stops or starts a service.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }

absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    return 1
  }
}

inventory_tree() {
  local tree_root="$1" output="$2"
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

payload_inventory() {
  local tree_root="$1" output="$2"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")"
      fi
    done
  ) >"$output"
}

acl_sha256() {
  local item="$1"
  /bin/ls -lden "$item" | sed '1d' | shasum -a 256 | awk '{print $1}'
}

xattr_sha256() {
  local item="$1" name names
  names="$(/usr/bin/xattr "$item" 2>/dev/null || true)"
  if [[ -n "$names" ]]; then
    while IFS= read -r name; do
      [[ "$name" != *$'\r'* && "$name" != *'|'* ]] || {
        echo "state snapshot rejects carriage-return or pipe in xattr names" >&2
        return 1
      }
    done <<<"$names"
  fi
  {
    if [[ -n "$names" ]]; then
      printf '%s\n' "$names" | LC_ALL=C sort | while IFS= read -r name; do
        printf '%s|%s\n' "$name" "$(/usr/bin/xattr -p "$name" "$item" | shasum -a 256 | awk '{print $1}')"
      done
    fi
  } | shasum -a 256 | awk '{print $1}'
}

# A source identity inventory intentionally includes APFS identity fields that
# must remain stable while the writer is stopped. It is never compared across
# the copy boundary.
identity_inventory_v2() {
  local tree_root="$1" output="$2"
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i|%f' "$item")" \
          "$(acl_sha256 "$item")" "$(xattr_sha256 "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%m|%c|%d|%i|%f' "$item")" \
          "$(acl_sha256 "$item")" "$(xattr_sha256 "$item")"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

# A portable payload inventory excludes device/inode/ctime, but binds every
# byte and every property that must survive materialization.
portable_inventory_v2() {
  local tree_root="$1" output="$2"
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  validate_tree_names "$tree_root" || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%z|%m|%f' "$item")" \
          "$(acl_sha256 "$item")" "$(xattr_sha256 "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s|%s|%s\n' "$item" \
          "$(stat -f '%Lp|%u|%g|%m|%f' "$item")" \
          "$(acl_sha256 "$item")" "$(xattr_sha256 "$item")"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

inventory_subset_sha256() {
  local inventory="$1" pattern="$2"
  awk -F '|' -v pattern="$pattern" '$1 ~ pattern { print }' "$inventory" | shasum -a 256 | awk '{print $1}'
}

top_level_inventory_sha256() {
  local inventory="$1"
  awk -F '|' '$1 != "." && $1 !~ /^\.\/[^\/]+\// { print }' "$inventory" | shasum -a 256 | awk '{print $1}'
}

validate_tree_names() {
  local tree_root="$1" item relative
  while IFS= read -r -d '' item; do
    relative="${item#"$tree_root"/}"
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *'|'* ]] || {
      echo "state snapshot rejects newline, carriage-return, or pipe in paths" >&2
      return 1
    }
  done < <(find "$tree_root" -print0)
}

validate_source() {
  local source_runtime="$1" legacy_label="$2"
  [[ -d "$source_runtime" && ! -L "$source_runtime" ]] || {
    echo "source runtime-v2 is missing or unsafe" >&2
    return 1
  }
  validate_tree_names "$source_runtime" || return 1
  if find "$source_runtime" -type l -print -quit | grep -q .; then
    echo "source runtime-v2 contains a symlink" >&2
    return 1
  fi
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  local launch_output
  if launch_output="$(/bin/launchctl print "gui/$(id -u)/$legacy_label" 2>&1)"; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  elif [[ "$launch_output" != *"Could not find service"* ]]; then
    echo "could not prove legacy launchd job is unloaded: $launch_output" >&2
    return 1
  fi
  if find "$source_runtime" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "source has a nonempty SQLite WAL; stop the writer and checkpoint a private copy first" >&2
    return 1
  fi
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item")"
    if (( (8#$mode & 077) != 0 )); then
      echo "source state grants group/world permissions: $item" >&2
      return 1
    fi
  done < <(find "$source_runtime" -print)
  local lsof_output lsof_rc
  if lsof_output="$(lsof -nP +D "$source_runtime" 2>&1)"; then
    echo "legacy writer or reader still has runtime-v2 open; stop it before snapshotting" >&2
    return 1
  else
    lsof_rc=$?
    if [[ "$lsof_rc" -ne 1 || -n "$lsof_output" ]]; then
      echo "could not prove runtime-v2 has no open files: $lsof_output" >&2
      return 1
    fi
  fi
}

validate_full_tree_v2() {
  local tree_root="$1" require_quiescent="$2" legacy_label="$3" launch_output item mode
  [[ -d "$tree_root" && ! -L "$tree_root" && -d "$tree_root/runtime-v2" && ! -L "$tree_root/runtime-v2" ]] || {
    echo "full state root or required runtime-v2 payload is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$tree_root" && pwd -P)" == "$tree_root" ]] || {
    echo "full state root must be a physical canonical directory" >&2
    return 1
  }
  validate_tree_names "$tree_root" || return 1
  if find "$tree_root" -type l -print -quit | grep -q .; then
    echo "full state root contains a symlink" >&2
    return 1
  fi
  if find "$tree_root" ! -type f ! -type d -print -quit | grep -q .; then
    echo "full state root contains a special filesystem entry" >&2
    return 1
  fi
  if find "$tree_root" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "full state root contains a nonempty SQLite WAL" >&2
    return 1
  fi
  while IFS= read -r item; do
    mode="$(stat -f '%Lp' "$item")"
    (( (8#$mode & 077) == 0 )) || {
      echo "full state root grants group/world permissions: $item" >&2
      return 1
    }
  done < <(find "$tree_root" -print)
  [[ "$require_quiescent" == true ]] || return 0
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  if launch_output="$(/bin/launchctl print "gui/$(id -u)/$legacy_label" 2>&1)"; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  elif [[ "$launch_output" != *"Could not find service"* ]]; then
    echo "could not prove legacy launchd job is unloaded: $launch_output" >&2
    return 1
  fi
  local lsof_output lsof_rc
  if lsof_output="$(lsof -nP +D "$tree_root" 2>&1)"; then
    echo "legacy writer or reader still has the full state root open; stop it before snapshotting" >&2
    return 1
  else
    lsof_rc=$?
    if [[ "$lsof_rc" -ne 1 || -n "$lsof_output" ]]; then
      echo "could not prove the full state root has no open files: $lsof_output" >&2
      return 1
    fi
  fi
}

write_private_new() {
  local destination="$1" source="$2" parent staged
  [[ ! -e "$destination" && ! -L "$destination" ]] || { echo "receipt already exists: $destination" >&2; return 1; }
  parent="$(dirname "$destination")"; mkdir -p "$parent"; chmod 0700 "$parent"
  [[ "$(cd "$parent" && pwd -P)" == "$parent" ]] || {
    echo "receipt parent must be a physical canonical directory" >&2
    return 1
  }
  staged="$(mktemp "$parent/.hepta-state-snapshot-receipt.XXXXXX")"
  cp "$source" "$staged"; chmod 0400 "$staged"; mv "$staged" "$destination"
}

replace_private_reserved() {
  local destination="$1" expected_sha="$2" source="$3" parent staged source_sha
  [[ -f "$destination" && ! -L "$destination" && "$(sha256_file "$destination")" == "$expected_sha" ]] || {
    echo "snapshot receipt reservation changed before finalization" >&2
    return 1
  }
  parent="$(dirname "$destination")"
  source_sha="$(sha256_file "$source")" || return 1
  staged="$(mktemp "$parent/.hepta-state-snapshot-final.XXXXXX")"
  cp "$source" "$staged" || { rm -f "$staged"; return 1; }
  chmod 0400 "$staged" || { rm -f "$staged"; return 1; }
  [[ "$(sha256_file "$staged")" == "$source_sha" ]] || { rm -f "$staged"; return 1; }
  mv -f "$staged" "$destination" || { rm -f "$staged"; return 1; }
}

snapshot_v1() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local source_runtime destination_parent destination_name stage temp_root
  local source_before source_after source_payload destination_payload receipt_tmp pending_tmp pending_sha
  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ "$(realpath "$source_root")" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" ]] || { echo "snapshot destination must be separate from legacy state" >&2; return 1; }
  [[ "$destination_root" != "$source_root/"* && "$source_root" != "$destination_root/"* ]] || {
    echo "snapshot source and destination must not be nested" >&2
    return 1
  }
  source_runtime="$source_root/runtime-v2"
  validate_source "$source_runtime" "$legacy_label" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || { echo "snapshot destination already exists" >&2; return 1; }
  if [[ "$materialize" != "true" ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      '{schema:"hepta_vnext_state_snapshot_plan_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,materialized:false,service_changed:false}'
    return
  fi
  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  [[ "$receipt" != "$source_root" && "$receipt" != "$source_root/"* \
    && "$receipt" != "$destination_root" && "$receipt" != "$destination_root/"* ]] || {
    echo "snapshot receipt must remain outside source and destination state roots" >&2
    return 1
  }
  temp_root="${TMPDIR:-/tmp}"
  source_before="$(mktemp "${temp_root%/}/hepta-state-source-before.XXXXXX")"
  source_after="$(mktemp "${temp_root%/}/hepta-state-source-after.XXXXXX")"
  source_payload="$(mktemp "${temp_root%/}/hepta-state-source-payload.XXXXXX")"
  destination_payload="$(mktemp "${temp_root%/}/hepta-state-destination-payload.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-snapshot.XXXXXX")"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-state-snapshot-pending.XXXXXX")"
  trap 'rm -f "${source_before:-}" "${source_after:-}" "${source_payload:-}" "${destination_payload:-}" "${receipt_tmp:-}" "${pending_tmp:-}"; trap - RETURN' RETURN
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_pending_v1",status:"pending",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,created_at:$created_at,materialized:false,service_changed:false}' >"$pending_tmp"
  write_private_new "$receipt" "$pending_tmp"
  pending_sha="$(sha256_file "$receipt")"
  inventory_tree "$source_runtime" "$source_before"
  payload_inventory "$source_runtime" "$source_payload"
  destination_parent="$(dirname "$destination_root")"; destination_name="$(basename "$destination_root")"
  mkdir -p "$destination_parent"; chmod 0700 "$destination_parent"
  [[ "$(cd "$destination_parent" && pwd -P)" == "$destination_parent" ]] || {
    echo "snapshot destination parent must be a physical canonical directory" >&2
    return 1
  }
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot.XXXXXX")"
  chmod 0700 "$stage"
  cp -pR "$source_runtime" "$stage/runtime-v2"
  if ! validate_source "$stage/runtime-v2" "ai.hepta.snapshot.private-copy"; then
    chmod -R u+w "$stage" 2>/dev/null || true
    rm -rf "$stage"
    return 1
  fi
  inventory_tree "$source_runtime" "$source_after"
  diff -u "$source_before" "$source_after" >/dev/null || {
    echo "source state changed while snapshotting" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  payload_inventory "$stage/runtime-v2" "$destination_payload"
  diff -u "$source_payload" "$destination_payload" >/dev/null || {
    echo "snapshot bytes or preserved metadata differ from source" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  mv "$stage" "$destination_parent/$destination_name"
  destination_root="$destination_parent/$destination_name"
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg source_inventory_sha256 "$(sha256_file "$source_before")" \
    --arg payload_inventory_sha256 "$(sha256_file "$destination_payload")" \
    --argjson file_count "$(find "$destination_root/runtime-v2" -type f | wc -l | tr -d ' ')" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,source_inventory_sha256:$source_inventory_sha256,payload_inventory_sha256:$payload_inventory_sha256,file_count:$file_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,modes_and_sidecars_preserved:true,service_changed:false}' >"$receipt_tmp"
  replace_private_reserved "$receipt" "$pending_sha" "$receipt_tmp"
  trap - RETURN
  rm -f "$source_before" "$source_after" "$source_payload" "$destination_payload" "$receipt_tmp" "$pending_tmp"
  cat "$receipt"
}

snapshot() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local destination_parent destination_name stage payload_root temp_root snapshot_id
  local source_identity_before source_identity_after source_portable destination_portable
  local receipt_tmp pending_tmp binding_tmp pending_sha source_identity_sha portable_sha top_level_sha
  local sidecar_sha key_sha file_count entry_count top_level_count sidecar_count key_count
  local binding binding_sha
  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ -d "$source_root" && ! -L "$source_root" && "$(cd "$source_root" && pwd -P)" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" ]] || {
    echo "snapshot destination must be separate from legacy state" >&2
    return 1
  }
  [[ "$destination_root" != "$source_root/"* && "$source_root" != "$destination_root/"* ]] || {
    echo "snapshot source and destination must not be nested" >&2
    return 1
  }
  validate_full_tree_v2 "$source_root" true "$legacy_label" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || {
    echo "snapshot destination already exists" >&2
    return 1
  }
  if [[ "$materialize" != true ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      '{schema:"hepta_vnext_state_snapshot_plan_v2",status:"ready",scope:"full-state-root",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,all_top_level_entries_required:true,identity_inventory_separate:true,portable_payload_inventory_required:true,materialized:false,service_changed:false}'
    return
  fi
  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  [[ "$receipt" != "$source_root" && "$receipt" != "$source_root/"* \
    && "$receipt" != "$destination_root" && "$receipt" != "$destination_root/"* ]] || {
    echo "snapshot receipt must remain outside source and destination state roots" >&2
    return 1
  }
  destination_parent="$(dirname "$destination_root")"
  destination_name="$(basename "$destination_root")"
  binding="$destination_parent/.$destination_name.hepta-state-snapshot-v2.binding"
  [[ ! -e "$binding" && ! -L "$binding" ]] || {
    echo "snapshot destination binding already exists" >&2
    return 1
  }
  mkdir -p "$destination_parent"; chmod 0700 "$destination_parent"
  [[ "$(cd "$destination_parent" && pwd -P)" == "$destination_parent" ]] || {
    echo "snapshot destination parent must be a physical canonical directory" >&2
    return 1
  }
  temp_root="${TMPDIR:-/tmp}"
  source_identity_before="$(mktemp "${temp_root%/}/hepta-state-v2-identity-before.XXXXXX")"
  source_identity_after="$(mktemp "${temp_root%/}/hepta-state-v2-identity-after.XXXXXX")"
  source_portable="$(mktemp "${temp_root%/}/hepta-state-v2-portable-source.XXXXXX")"
  destination_portable="$(mktemp "${temp_root%/}/hepta-state-v2-portable-destination.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-v2-receipt.XXXXXX")"
  pending_tmp="$(mktemp "${temp_root%/}/hepta-state-v2-pending.XXXXXX")"
  binding_tmp="$(mktemp "${temp_root%/}/hepta-state-v2-binding.XXXXXX")"
  stage=""
  trap '
    rm -f "${source_identity_before:-}" "${source_identity_after:-}" "${source_portable:-}" "${destination_portable:-}" "${receipt_tmp:-}" "${pending_tmp:-}" "${binding_tmp:-}"
    if [[ -n "${stage:-}" && -d "$stage" ]]; then
      chflags -R nouchg,noschg "$stage" 2>/dev/null || true
      chmod -RN "$stage" 2>/dev/null || true
      chmod -R u+w "$stage" 2>/dev/null || true
      rm -rf "$stage"
    fi
    trap - RETURN
  ' RETURN
  snapshot_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  jq -n --arg source "$source_root" --arg destination "$destination_root" \
    --arg legacy_label "$legacy_label" --arg snapshot_id "$snapshot_id" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_pending_v2",status:"pending",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,created_at:$created_at,materialized:false,service_changed:false}' >"$pending_tmp"
  write_private_new "$receipt" "$pending_tmp"
  pending_sha="$(sha256_file "$receipt")"

  identity_inventory_v2 "$source_root" "$source_identity_before"
  portable_inventory_v2 "$source_root" "$source_portable"
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot-v2.XXXXXX")"
  chmod 0700 "$stage"
  payload_root="$stage/payload"
  cp -pR "$source_root" "$payload_root"
  validate_full_tree_v2 "$payload_root" false "$legacy_label"
  identity_inventory_v2 "$source_root" "$source_identity_after"
  diff -u "$source_identity_before" "$source_identity_after" >/dev/null || {
    echo "full source identity changed while snapshotting" >&2
    return 1
  }
  portable_inventory_v2 "$payload_root" "$destination_portable"
  diff -u "$source_portable" "$destination_portable" >/dev/null || {
    echo "full snapshot bytes or portable metadata differ from source" >&2
    return 1
  }

  source_identity_sha="$(sha256_file "$source_identity_before")"
  portable_sha="$(sha256_file "$source_portable")"
  top_level_sha="$(top_level_inventory_sha256 "$source_portable")"
  sidecar_sha="$(inventory_subset_sha256 "$source_portable" '\\-(wal|shm)$')"
  key_sha="$(inventory_subset_sha256 "$source_portable" '(^|/)keys/|\\.key$')"
  entry_count="$(find "$source_root" -print | wc -l | tr -d ' ')"
  file_count="$(find "$source_root" -type f | wc -l | tr -d ' ')"
  top_level_count="$(find "$source_root" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  sidecar_count="$(find "$source_root" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  key_count="$(find "$source_root" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  mv "$payload_root" "$destination_parent/$destination_name"
  rmdir "$stage"
  stage=""
  destination_root="$destination_parent/$destination_name"
  jq -n --arg snapshot_id "$snapshot_id" --arg destination "$destination_root" \
    --arg portable_payload_sha256 "$portable_sha" \
    '{schema:"hepta_vnext_state_snapshot_binding_v2",snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable_payload_sha256}' >"$binding_tmp"
  write_private_new "$binding" "$binding_tmp"
  binding_sha="$(sha256_file "$binding")"
  jq -n --arg snapshot_id "$snapshot_id" --arg source "$source_root" --arg destination "$destination_root" \
    --arg legacy_label "$legacy_label" --arg source_identity_sha256 "$source_identity_sha" \
    --arg portable_payload_sha256 "$portable_sha" --arg top_level_inventory_sha256 "$top_level_sha" \
    --arg sqlite_sidecar_inventory_sha256 "$sidecar_sha" --arg key_inventory_sha256 "$key_sha" \
    --arg binding "$binding" --arg binding_sha256 "$binding_sha" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson entry_count "$entry_count" \
    --argjson file_count "$file_count" --argjson top_level_entry_count "$top_level_count" \
    --argjson sqlite_sidecar_count "$sidecar_count" --argjson key_file_count "$key_count" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v2",status:"ready",scope:"full-state-root",snapshot_id:$snapshot_id,source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,source_identity_inventory_sha256:$source_identity_sha256,portable_payload_inventory_sha256:$portable_payload_sha256,top_level_inventory_sha256:$top_level_inventory_sha256,sqlite_sidecar_inventory_sha256:$sqlite_sidecar_inventory_sha256,key_inventory_sha256:$key_inventory_sha256,destination_binding:$binding,destination_binding_sha256:$binding_sha256,entry_count:$entry_count,file_count:$file_count,top_level_entry_count:$top_level_entry_count,sqlite_sidecar_count:$sqlite_sidecar_count,key_file_count:$key_file_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,all_top_level_entries_covered:true,modes_uid_gid_mtime_flags_acl_xattr_preserved:true,wal_shm_and_keys_covered:true,identity_inventory_separate:true,replay_protected_by_destination_binding:true,service_changed:false}' >"$receipt_tmp"
  replace_private_reserved "$receipt" "$pending_sha" "$receipt_tmp"
  trap - RETURN
  rm -f "$source_identity_before" "$source_identity_after" "$source_portable" "$destination_portable" "$receipt_tmp" "$pending_tmp" "$binding_tmp"
  cat "$receipt"
}

verify_snapshot_receipt_v1() {
  local receipt="$1" destination payload expected_payload expected_count actual_count temp_root
  absolute_non_root "$receipt" || return 1
  [[ -f "$receipt" && ! -L "$receipt" ]] || { echo "snapshot receipt is missing or unsafe" >&2; return 1; }
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v1"
    and .status == "ready"
    and (.source_state_root | startswith("/"))
    and (.destination_state_root | startswith("/"))
    and .source_state_root != .destination_state_root
    and (.legacy_launchd_label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .legacy_launchd_unloaded == true
    and (.payload_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.source_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.file_count >= 1)
    and .writer_stopped == true
    and .wal_empty == true
    and .source_unchanged == true
    and .destination_exact_copy == true
    and .modes_and_sidecars_preserved == true
    and .service_changed == false
  ' "$receipt" >/dev/null || { echo "invalid state snapshot receipt" >&2; return 1; }
  destination="$(jq -r '.destination_state_root' "$receipt")"
  absolute_non_root "$destination" || return 1
  [[ -d "$destination/runtime-v2" && ! -L "$destination" && ! -L "$destination/runtime-v2" ]] || {
    echo "snapshot destination is missing or unsafe" >&2
    return 1
  }
  [[ "$(cd "$destination" && pwd -P)" == "$destination" ]] || {
    echo "snapshot destination is not a physical canonical directory" >&2
    return 1
  }
  validate_tree_names "$destination/runtime-v2" || return 1
  if find "$destination/runtime-v2" -type l -print -quit | grep -q .; then
    echo "snapshot destination contains a symlink" >&2
    return 1
  fi
  if find "$destination/runtime-v2" ! -type f ! -type d -print -quit | grep -q .; then
    echo "snapshot destination contains a special filesystem entry" >&2
    return 1
  fi
  if find "$destination/runtime-v2" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "snapshot destination contains a nonempty SQLite WAL" >&2
    return 1
  fi
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item")"
    (( (8#$mode & 077) == 0 )) || { echo "snapshot destination grants group/world permissions: $item" >&2; return 1; }
  done < <(find "$destination/runtime-v2" -print)
  temp_root="${TMPDIR:-/tmp}"; payload="$(mktemp "${temp_root%/}/hepta-state-verify.XXXXXX")"
  trap 'rm -f "${payload:-}"; trap - RETURN' RETURN
  payload_inventory "$destination/runtime-v2" "$payload"
  expected_payload="$(jq -r '.payload_inventory_sha256' "$receipt")"
  [[ "$(sha256_file "$payload")" == "$expected_payload" ]] || {
    echo "snapshot destination inventory differs from receipt" >&2
    return 1
  }
  expected_count="$(jq -r '.file_count' "$receipt")"
  actual_count="$(find "$destination/runtime-v2" -type f | wc -l | tr -d ' ')"
  [[ "$actual_count" == "$expected_count" ]] || { echo "snapshot file count differs from receipt" >&2; return 1; }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg destination_state_root "$destination" --arg payload_inventory_sha256 "$expected_payload" \
    '{schema:"hepta_vnext_state_snapshot_verification_v1",status:"ready",receipt:$receipt,receipt_sha256:$receipt_sha256,destination_state_root:$destination_state_root,payload_inventory_sha256:$payload_inventory_sha256,destination_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$payload"
}

verify_snapshot_source_v1() {
  local receipt="$1" source legacy_label expected_inventory current_inventory temp_root
  verify_snapshot_receipt_v1 "$receipt" >/dev/null || return 1
  receipt="$(realpath "$receipt")" || return 1
  source="$(jq -r '.source_state_root' "$receipt")" || return 1
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")" || return 1
  expected_inventory="$(jq -r '.source_inventory_sha256' "$receipt")" || return 1
  absolute_non_root "$source" || return 1
  [[ -d "$source" && ! -L "$source" && "$(cd "$source" && pwd -P)" == "$source" ]] || {
    echo "snapshot source is missing or no longer physical/canonical" >&2
    return 1
  }
  validate_source "$source/runtime-v2" "$legacy_label" || return 1
  temp_root="${TMPDIR:-/tmp}"
  current_inventory="$(mktemp "${temp_root%/}/hepta-state-source-verify.XXXXXX")" || return 1
  trap 'rm -f "${current_inventory:-}"; trap - RETURN' RETURN
  inventory_tree "$source/runtime-v2" "$current_inventory" || return 1
  [[ "$(sha256_file "$current_inventory")" == "$expected_inventory" ]] || {
    echo "snapshot source changed after materialization" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg source_state_root "$source" --arg source_inventory_sha256 "$expected_inventory" \
    '{schema:"hepta_vnext_state_snapshot_source_verification_v1",status:"ready",receipt:$receipt,receipt_sha256:$receipt_sha256,source_state_root:$source_state_root,source_inventory_sha256:$source_inventory_sha256,legacy_launchd_unloaded:true,no_open_runtime_files:true,source_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$current_inventory"
}

verify_snapshot_receipt_v2() {
  local receipt="$1" destination binding portable expected_portable expected_top expected_sidecar expected_key
  local actual_count actual_files actual_top actual_sidecars actual_keys temp_root
  absolute_non_root "$receipt" || return 1
  [[ -f "$receipt" && ! -L "$receipt" ]] || {
    echo "snapshot receipt is missing or unsafe" >&2
    return 1
  }
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v2"
    and .status == "ready"
    and .scope == "full-state-root"
    and (.snapshot_id | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))
    and (.source_state_root | startswith("/"))
    and (.destination_state_root | startswith("/"))
    and .source_state_root != .destination_state_root
    and (.legacy_launchd_label | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and .legacy_launchd_unloaded == true
    and (.source_identity_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.portable_payload_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.top_level_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.sqlite_sidecar_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.key_inventory_sha256 | test("^[0-9a-f]{64}$"))
    and (.destination_binding | startswith("/"))
    and (.destination_binding_sha256 | test("^[0-9a-f]{64}$"))
    and (.entry_count >= 2) and (.file_count >= 1) and (.top_level_entry_count >= 1)
    and (.sqlite_sidecar_count >= 0) and (.key_file_count >= 0)
    and .writer_stopped == true and .wal_empty == true
    and .source_unchanged == true and .destination_exact_copy == true
    and .all_top_level_entries_covered == true
    and .modes_uid_gid_mtime_flags_acl_xattr_preserved == true
    and .wal_shm_and_keys_covered == true and .identity_inventory_separate == true
    and .replay_protected_by_destination_binding == true
    and .service_changed == false
  ' "$receipt" >/dev/null || {
    echo "invalid full-root state snapshot receipt" >&2
    return 1
  }
  destination="$(jq -r '.destination_state_root' "$receipt")"
  binding="$(jq -r '.destination_binding' "$receipt")"
  absolute_non_root "$destination" || return 1
  absolute_non_root "$binding" || return 1
  [[ "$binding" == "$(dirname "$destination")/.$(basename "$destination").hepta-state-snapshot-v2.binding" ]] || {
    echo "snapshot destination binding path is not destination-derived" >&2
    return 1
  }
  [[ -f "$binding" && ! -L "$binding" \
    && "$(sha256_file "$binding")" == "$(jq -r '.destination_binding_sha256' "$receipt")" ]] || {
    echo "snapshot destination binding is missing or changed" >&2
    return 1
  }
  jq -e --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" \
    --arg destination "$destination" --arg portable "$(jq -r '.portable_payload_inventory_sha256' "$receipt")" '
    .schema == "hepta_vnext_state_snapshot_binding_v2"
    and .snapshot_id == $snapshot_id
    and .destination_state_root == $destination
    and .portable_payload_inventory_sha256 == $portable
  ' "$binding" >/dev/null || {
    echo "snapshot destination binding does not match the receipt" >&2
    return 1
  }
  validate_full_tree_v2 "$destination" false "$(jq -r '.legacy_launchd_label' "$receipt")" || return 1
  temp_root="${TMPDIR:-/tmp}"
  portable="$(mktemp "${temp_root%/}/hepta-state-v2-verify.XXXXXX")"
  trap 'rm -f "${portable:-}"; trap - RETURN' RETURN
  portable_inventory_v2 "$destination" "$portable"
  expected_portable="$(jq -r '.portable_payload_inventory_sha256' "$receipt")"
  expected_top="$(jq -r '.top_level_inventory_sha256' "$receipt")"
  expected_sidecar="$(jq -r '.sqlite_sidecar_inventory_sha256' "$receipt")"
  expected_key="$(jq -r '.key_inventory_sha256' "$receipt")"
  [[ "$(sha256_file "$portable")" == "$expected_portable" \
    && "$(top_level_inventory_sha256 "$portable")" == "$expected_top" \
    && "$(inventory_subset_sha256 "$portable" '\\-(wal|shm)$')" == "$expected_sidecar" \
    && "$(inventory_subset_sha256 "$portable" '(^|/)keys/|\\.key$')" == "$expected_key" ]] || {
    echo "full snapshot portable, top-level, sidecar, or key inventory differs from receipt" >&2
    return 1
  }
  actual_count="$(find "$destination" -print | wc -l | tr -d ' ')"
  actual_files="$(find "$destination" -type f | wc -l | tr -d ' ')"
  actual_top="$(find "$destination" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  actual_sidecars="$(find "$destination" -type f \( -name '*-wal' -o -name '*-shm' \) | wc -l | tr -d ' ')"
  actual_keys="$(find "$destination" -type f \( -path '*/keys/*' -o -name '*.key' \) | wc -l | tr -d ' ')"
  [[ "$actual_count" == "$(jq -r '.entry_count' "$receipt")" \
    && "$actual_files" == "$(jq -r '.file_count' "$receipt")" \
    && "$actual_top" == "$(jq -r '.top_level_entry_count' "$receipt")" \
    && "$actual_sidecars" == "$(jq -r '.sqlite_sidecar_count' "$receipt")" \
    && "$actual_keys" == "$(jq -r '.key_file_count' "$receipt")" ]] || {
    echo "full snapshot entry counters differ from receipt" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg destination "$destination" \
    --arg portable "$expected_portable" --arg top "$expected_top" \
    '{schema:"hepta_vnext_state_snapshot_verification_v2",status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,destination_state_root:$destination,portable_payload_inventory_sha256:$portable,top_level_inventory_sha256:$top,all_top_level_entries_covered:true,destination_unchanged:true,replay_binding_verified:true,service_changed:false}'
  trap - RETURN
  rm -f "$portable"
}

verify_snapshot_source_v2() {
  local receipt="$1" source legacy_label expected_identity current_identity temp_root
  verify_snapshot_receipt_v2 "$receipt" >/dev/null || return 1
  receipt="$(realpath "$receipt")" || return 1
  source="$(jq -r '.source_state_root' "$receipt")"
  legacy_label="$(jq -r '.legacy_launchd_label' "$receipt")"
  expected_identity="$(jq -r '.source_identity_inventory_sha256' "$receipt")"
  absolute_non_root "$source" || return 1
  validate_full_tree_v2 "$source" true "$legacy_label" || return 1
  temp_root="${TMPDIR:-/tmp}"
  current_identity="$(mktemp "${temp_root%/}/hepta-state-v2-source-verify.XXXXXX")"
  trap 'rm -f "${current_identity:-}"; trap - RETURN' RETURN
  identity_inventory_v2 "$source" "$current_identity"
  [[ "$(sha256_file "$current_identity")" == "$expected_identity" ]] || {
    echo "full snapshot source identity changed after materialization" >&2
    return 1
  }
  jq -cn --arg receipt "$receipt" --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg snapshot_id "$(jq -r '.snapshot_id' "$receipt")" --arg source "$source" \
    --arg identity "$expected_identity" \
    '{schema:"hepta_vnext_state_snapshot_source_verification_v2",status:"ready",scope:"full-state-root",receipt:$receipt,receipt_sha256:$receipt_sha256,snapshot_id:$snapshot_id,source_state_root:$source,source_identity_inventory_sha256:$identity,legacy_launchd_unloaded:true,no_open_state_files:true,source_unchanged:true,service_changed:false}'
  trap - RETURN
  rm -f "$current_identity"
}

verify_snapshot_receipt() {
  local schema
  schema="$(jq -r '.schema // empty' "$1" 2>/dev/null || true)"
  case "$schema" in
    hepta_vnext_state_snapshot_receipt_v1) verify_snapshot_receipt_v1 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v2) verify_snapshot_receipt_v2 "$1" ;;
    *) echo "unsupported state snapshot receipt schema" >&2; return 1 ;;
  esac
}

verify_snapshot_source() {
  local schema
  schema="$(jq -r '.schema // empty' "$1" 2>/dev/null || true)"
  case "$schema" in
    hepta_vnext_state_snapshot_receipt_v1) verify_snapshot_source_v1 "$1" ;;
    hepta_vnext_state_snapshot_receipt_v2) verify_snapshot_source_v2 "$1" ;;
    *) echo "unsupported state snapshot receipt schema" >&2; return 1 ;;
  esac
}

self_test() {
  local temp_root root source destination receipt bad_source bad_symlink bad_special bad_delimiter
  local replay_destination replay_receipt v1_source v1_destination v1_receipt
  temp_root="${TMPDIR:-/tmp}"; root="$(mktemp -d "${temp_root%/}/hepta-state-snapshot-self-test.XXXXXX")"
  HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root"
  trap 'chflags -R nouchg,noschg "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; chmod -RN "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; chmod -R u+w "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT"' EXIT
  source="$root/legacy"; destination="$root/vnext/live-snapshot"; receipt="$root/receipts/snapshot.json"
  mkdir -p "$source/runtime-v2/keys" "$source/archive" "$source/release-runs/20260812"
  chmod 0700 "$source" "$source/runtime-v2" "$source/runtime-v2/keys" "$source/archive" "$source/release-runs" "$source/release-runs/20260812"
  printf 'fixture\n' >"$source/runtime-v2/runtime-state.json"; chmod 0600 "$source/runtime-v2/runtime-state.json"
  : >"$source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$source/runtime-v2/outcomes.sqlite3-wal"
  printf 'shared-memory-sidecar\n' >"$source/runtime-v2/outcomes.sqlite3-shm"; chmod 0600 "$source/runtime-v2/outcomes.sqlite3-shm"
  printf 'key-material\n' >"$source/runtime-v2/keys/runtime-integrity.key"; chmod 0600 "$source/runtime-v2/keys/runtime-integrity.key"
  printf 'archive-payload\n' >"$source/archive/record.json"; chmod 0600 "$source/archive/record.json"
  printf 'run-payload\n' >"$source/release-runs/20260812/run.json"; chmod 0600 "$source/release-runs/20260812/run.json"
  /usr/bin/xattr -w com.hepta.snapshot.selftest 'xattr-payload' "$source/archive/record.json"
  chmod +a 'everyone deny delete' "$source/archive/record.json"
  chflags hidden "$source/release-runs/20260812/run.json"
  snapshot "$source" "$destination" "$receipt" true ai.hepta.snapshot.selftest >/dev/null
  verify_snapshot_receipt "$receipt" >/dev/null
  verify_snapshot_source "$receipt" >/dev/null
  jq -e '
    .schema == "hepta_vnext_state_snapshot_receipt_v2"
    and .scope == "full-state-root"
    and .status == "ready"
    and .destination_exact_copy == true and .source_unchanged == true
    and .all_top_level_entries_covered == true
    and .modes_uid_gid_mtime_flags_acl_xattr_preserved == true
    and .wal_shm_and_keys_covered == true
    and .top_level_entry_count == 3
    and .sqlite_sidecar_count == 2
    and .key_file_count == 1
    and .replay_protected_by_destination_binding == true
  ' "$receipt" >/dev/null
  [[ "$(/usr/bin/xattr -p com.hepta.snapshot.selftest "$destination/archive/record.json")" == xattr-payload \
    && "$(stat -f '%f' "$destination/release-runs/20260812/run.json")" == "$(stat -f '%f' "$source/release-runs/20260812/run.json")" \
    && -s "$destination/runtime-v2/outcomes.sqlite3-shm" \
    && -s "$destination/runtime-v2/keys/runtime-integrity.key" ]] || {
    echo "full-root metadata, sidecar, or key payload was not preserved" >&2
    exit 1
  }
  bad_source="$root/legacy-nonempty-wal"
  mkdir -p "$bad_source/runtime-v2"; chmod 0700 "$bad_source" "$bad_source/runtime-v2"
  printf 'not-empty\n' >"$bad_source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$bad_source/runtime-v2/outcomes.sqlite3-wal"
  if snapshot "$bad_source" "$root/rejected" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "nonempty WAL was accepted" >&2
    exit 1
  fi
  if snapshot "$source" "$root/rejected-nested" "$source/receipt.json" true ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "receipt inside source state was accepted" >&2
    exit 1
  fi
  bad_symlink="$root/legacy-symlink"; mkdir -p "$bad_symlink/runtime-v2"; chmod 0700 "$bad_symlink" "$bad_symlink/runtime-v2"
  ln -s "$root" "$bad_symlink/archive"
  if snapshot "$bad_symlink" "$root/rejected-symlink" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root symlink was accepted" >&2
    exit 1
  fi
  bad_special="$root/legacy-special"; mkdir -p "$bad_special/runtime-v2"; chmod 0700 "$bad_special" "$bad_special/runtime-v2"
  mkfifo "$bad_special/runtime-v2/fifo"; chmod 0600 "$bad_special/runtime-v2/fifo"
  if snapshot "$bad_special" "$root/rejected-special" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root special filesystem entry was accepted" >&2
    exit 1
  fi
  bad_delimiter="$root/legacy-delimiter"; mkdir -p "$bad_delimiter/runtime-v2"; chmod 0700 "$bad_delimiter" "$bad_delimiter/runtime-v2"
  printf 'bad\n' >"$bad_delimiter/bad|name"; chmod 0600 "$bad_delimiter/bad|name"
  if snapshot "$bad_delimiter" "$root/rejected-delimiter" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "full-root delimiter path was accepted" >&2
    exit 1
  fi
  replay_destination="$root/replayed-state"
  cp -pR "$destination" "$replay_destination"
  replay_receipt="$root/receipts/replayed.json"
  jq --arg destination "$replay_destination" \
    --arg binding "$root/.replayed-state.hepta-state-snapshot-v2.binding" \
    '.destination_state_root=$destination | .destination_binding=$binding' "$receipt" >"$replay_receipt"
  chmod 0400 "$replay_receipt"
  if verify_snapshot_receipt "$replay_receipt" >/dev/null 2>&1; then
    echo "snapshot receipt replay against an unbound destination was accepted" >&2
    exit 1
  fi
  printf 'unexpected-top-level\n' >"$destination/unexpected-top-level"; chmod 0600 "$destination/unexpected-top-level"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot top-level inventory drift was accepted" >&2
    exit 1
  fi
  rm "$destination/unexpected-top-level"
  touch -r "$source" "$destination"
  /usr/bin/xattr -w com.hepta.snapshot.selftest 'tampered-xattr' "$destination/archive/record.json"
  if verify_snapshot_receipt "$receipt" >/dev/null 2>&1; then
    echo "full snapshot xattr tamper was accepted" >&2
    exit 1
  fi
  printf 'changed-after-snapshot\n' >>"$source/runtime-v2/runtime-state.json"
  if verify_snapshot_source "$receipt" >/dev/null 2>&1; then
    echo "source freshness verification accepted post-snapshot mutation" >&2
    exit 1
  fi
  v1_source="$root/v1-legacy"; v1_destination="$root/v1-destination"; v1_receipt="$root/receipts/v1.json"
  mkdir -p "$v1_source/runtime-v2"; chmod 0700 "$v1_source" "$v1_source/runtime-v2"
  printf 'v1-fixture\n' >"$v1_source/runtime-v2/runtime-state.json"; chmod 0600 "$v1_source/runtime-v2/runtime-state.json"
  snapshot_v1 "$v1_source" "$v1_destination" "$v1_receipt" true ai.hepta.snapshot.v1.selftest >/dev/null
  verify_snapshot_receipt "$v1_receipt" >/dev/null
  verify_snapshot_source "$v1_receipt" >/dev/null
  jq -cn --arg receipt_sha256 "$(sha256_file "$receipt")" \
    --arg v1_receipt_sha256 "$(sha256_file "$v1_receipt")" \
    '{schema:"hepta_vnext_state_snapshot_self_test_v2",status:"ready",receipt_sha256:$receipt_sha256,v1_receipt_sha256:$v1_receipt_sha256,full_root_v2:true,all_top_level_entries_covered:true,identity_and_portable_inventories_separate:true,modes_uid_gid_mtime_flags_acl_xattr_preserved:true,wal_shm_and_keys_covered:true,nonempty_wal_rejected:true,symlink_rejected:true,special_entry_rejected:true,path_delimiter_rejected:true,nested_receipt_rejected:true,receipt_replay_rejected:true,top_level_drift_rejected:true,xattr_tamper_rejected:true,source_freshness_reverified:true,post_snapshot_mutation_rejected:true,v1_receipt_compatible:true,source_unchanged:true,destination_exact_copy:true,production_changed:false}'
}

if [[ "${1:-}" == "self-test" ]]; then
  [[ $# -eq 1 ]] || usage
  self_test
  exit 0
fi
if [[ "${1:-}" == "verify" || "${1:-}" == "verify-source" ]]; then
  verify_command="$1"
  shift
  [[ "${1:-}" == "--receipt" && -n "${2:-}" && $# -eq 2 ]] || usage
  if [[ "$verify_command" == verify-source ]]; then
    verify_snapshot_source "$2"
  else
    verify_snapshot_receipt "$2"
  fi
  exit 0
fi
source_root=""; destination_root=""; receipt=""; materialize=false; legacy_label=ai.hepta.gateway
while (( $# > 0 )); do
  case "$1" in
    --source-state-root) shift; [[ $# -gt 0 ]] || usage; source_root="$1" ;;
    --destination-state-root) shift; [[ $# -gt 0 ]] || usage; destination_root="$1" ;;
    --legacy-label) shift; [[ $# -gt 0 ]] || usage; legacy_label="$1" ;;
    --receipt) shift; [[ $# -gt 0 ]] || usage; receipt="$1" ;;
    --materialize) materialize=true ;;
    *) usage ;;
  esac
  shift
done
[[ -n "$source_root" && -n "$destination_root" ]] || usage
snapshot "$source_root" "$destination_root" "$receipt" "$materialize" "$legacy_label"
