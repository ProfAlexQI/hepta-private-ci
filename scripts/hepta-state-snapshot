#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-state-snapshot --source-state-root DIR --destination-state-root DIR [--legacy-label LABEL] [--receipt PATH] [--materialize]
  hepta-state-snapshot self-test

The default is a read-only plan. --materialize requires the legacy writer to
have no open files under runtime-v2, rejects every nonempty WAL, copies into a
new separate state root, and writes a receipt after source/destination
metadata and SHA-256 inventories agree. It never stops or starts a service.
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }

absolute_non_root() {
  [[ "$1" == /* \
    && "$1" != "/" \
    && "$1" != */ \
    && "$1" != *"//"* \
    && "$1" != *"/../"* \
    && "$1" != *"/./"* \
    && "$1" != */.. \
    && "$1" != */. ]] || {
    echo "path must be absolute, normalized, and non-root: $1" >&2
    return 1
  }
}

inventory_tree() {
  local tree_root="$1" output="$2"
  [[ -d "$tree_root" && ! -L "$tree_root" ]] || return 1
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      [[ ! -L "$item" ]] || { echo "state snapshot rejects symlink: $item" >&2; exit 1; }
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m|%c|%d|%i' "$item")"
      else
        echo "state snapshot rejects special entry: $item" >&2
        exit 1
      fi
    done
  ) >"$output"
}

payload_inventory() {
  local tree_root="$1" output="$2"
  (
    cd "$tree_root"
    find . -print | LC_ALL=C sort | while IFS= read -r item; do
      if [[ -f "$item" ]]; then
        printf '%s|file|%s|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")" "$(sha256_file "$item")"
      elif [[ -d "$item" ]]; then
        printf '%s|directory|%s\n' "$item" "$(stat -f '%Lp|%u|%g|%z|%m' "$item")"
      fi
    done
  ) >"$output"
}

validate_source() {
  local source_runtime="$1" legacy_label="$2"
  [[ -d "$source_runtime" && ! -L "$source_runtime" ]] || {
    echo "source runtime-v2 is missing or unsafe" >&2
    return 1
  }
  if find "$source_runtime" -type l -print -quit | grep -q .; then
    echo "source runtime-v2 contains a symlink" >&2
    return 1
  fi
  [[ "$legacy_label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "invalid legacy launchd label: $legacy_label" >&2
    return 1
  }
  if /bin/launchctl print "gui/$(id -u)/$legacy_label" >/dev/null 2>&1; then
    echo "legacy launchd job is still loaded: $legacy_label" >&2
    return 1
  fi
  if find "$source_runtime" -type f -name '*-wal' -size +0c -print -quit | grep -q .; then
    echo "source has a nonempty SQLite WAL; stop the writer and checkpoint a private copy first" >&2
    return 1
  fi
  while IFS= read -r item; do
    local mode
    mode="$(stat -f '%Lp' "$item")"
    if (( (8#$mode & 077) != 0 )); then
      echo "source state grants group/world permissions: $item" >&2
      return 1
    fi
  done < <(find "$source_runtime" -print)
  if lsof -nP +D "$source_runtime" 2>/dev/null | sed '1d' | grep -q .; then
    echo "legacy writer or reader still has runtime-v2 open; stop it before snapshotting" >&2
    return 1
  fi
}

write_private_new() {
  local destination="$1" source="$2" parent staged
  [[ ! -e "$destination" && ! -L "$destination" ]] || { echo "receipt already exists: $destination" >&2; return 1; }
  parent="$(dirname "$destination")"; mkdir -p "$parent"; chmod 0700 "$parent"
  staged="$(mktemp "$parent/.hepta-state-snapshot-receipt.XXXXXX")"
  trap 'rm -f "$staged"' RETURN
  cp "$source" "$staged"; chmod 0400 "$staged"; mv "$staged" "$destination"
  trap - RETURN
}

snapshot() {
  local source_root="$1" destination_root="$2" receipt="$3" materialize="$4" legacy_label="$5"
  local source_runtime destination_parent destination_name stage temp_root
  local source_before source_after source_payload destination_payload receipt_tmp
  absolute_non_root "$source_root" || return 1
  absolute_non_root "$destination_root" || return 1
  [[ "$(realpath "$source_root")" == "$source_root" ]] || {
    echo "source state root must be a physical canonical directory" >&2
    return 1
  }
  [[ "$source_root" != "$destination_root" ]] || { echo "snapshot destination must be separate from legacy state" >&2; return 1; }
  source_runtime="$source_root/runtime-v2"
  validate_source "$source_runtime" "$legacy_label" || return 1
  [[ ! -e "$destination_root" && ! -L "$destination_root" ]] || { echo "snapshot destination already exists" >&2; return 1; }
  if [[ "$materialize" != "true" ]]; then
    jq -cn --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
      '{schema:"hepta_vnext_state_snapshot_plan_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,writer_stopped:true,wal_empty:true,materialized:false,service_changed:false}'
    return
  fi
  [[ -n "$receipt" ]] || usage
  absolute_non_root "$receipt" || return 1
  temp_root="${TMPDIR:-/tmp}"
  source_before="$(mktemp "${temp_root%/}/hepta-state-source-before.XXXXXX")"
  source_after="$(mktemp "${temp_root%/}/hepta-state-source-after.XXXXXX")"
  source_payload="$(mktemp "${temp_root%/}/hepta-state-source-payload.XXXXXX")"
  destination_payload="$(mktemp "${temp_root%/}/hepta-state-destination-payload.XXXXXX")"
  receipt_tmp="$(mktemp "${temp_root%/}/hepta-state-snapshot.XXXXXX")"
  trap 'rm -f "$source_before" "$source_after" "$source_payload" "$destination_payload" "$receipt_tmp"' RETURN
  inventory_tree "$source_runtime" "$source_before"
  payload_inventory "$source_runtime" "$source_payload"
  destination_parent="$(dirname "$destination_root")"; destination_name="$(basename "$destination_root")"
  mkdir -p "$destination_parent"; chmod 0700 "$destination_parent"
  destination_parent="$(cd "$destination_parent" && pwd -P)"
  stage="$(mktemp -d "$destination_parent/.hepta-state-snapshot.XXXXXX")"
  chmod 0700 "$stage"
  cp -pR "$source_runtime" "$stage/runtime-v2"
  if ! validate_source "$stage/runtime-v2" "ai.hepta.snapshot.private-copy"; then
    chmod -R u+w "$stage" 2>/dev/null || true
    rm -rf "$stage"
    return 1
  fi
  inventory_tree "$source_runtime" "$source_after"
  diff -u "$source_before" "$source_after" >/dev/null || {
    echo "source state changed while snapshotting" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  payload_inventory "$stage/runtime-v2" "$destination_payload"
  diff -u "$source_payload" "$destination_payload" >/dev/null || {
    echo "snapshot bytes or preserved metadata differ from source" >&2
    chmod -R u+w "$stage" 2>/dev/null || true; rm -rf "$stage"; return 1
  }
  mv "$stage" "$destination_parent/$destination_name"
  destination_root="$destination_parent/$destination_name"
  jq -n --arg source "$source_root" --arg destination "$destination_root" --arg legacy_label "$legacy_label" \
    --arg source_inventory_sha256 "$(sha256_file "$source_before")" \
    --arg payload_inventory_sha256 "$(sha256_file "$destination_payload")" \
    --argjson file_count "$(find "$destination_root/runtime-v2" -type f | wc -l | tr -d ' ')" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:"hepta_vnext_state_snapshot_receipt_v1",status:"ready",source_state_root:$source,destination_state_root:$destination,legacy_launchd_label:$legacy_label,legacy_launchd_unloaded:true,source_inventory_sha256:$source_inventory_sha256,payload_inventory_sha256:$payload_inventory_sha256,file_count:$file_count,created_at:$created_at,writer_stopped:true,wal_empty:true,source_unchanged:true,destination_exact_copy:true,modes_and_sidecars_preserved:true,service_changed:false}' >"$receipt_tmp"
  write_private_new "$receipt" "$receipt_tmp"
  trap - RETURN
  rm -f "$source_before" "$source_after" "$source_payload" "$destination_payload" "$receipt_tmp"
  cat "$receipt"
}

self_test() {
  local temp_root root source destination receipt bad_source
  temp_root="${TMPDIR:-/tmp}"; root="$(mktemp -d "${temp_root%/}/hepta-state-snapshot-self-test.XXXXXX")"
  HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT="$root"
  trap 'chmod -R u+w "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT" 2>/dev/null || true; rm -rf "$HEPTA_STATE_SNAPSHOT_SELF_TEST_ROOT"' EXIT
  source="$root/legacy"; destination="$root/vnext/live-snapshot"; receipt="$root/receipts/snapshot.json"
  mkdir -p "$source/runtime-v2/keys"; chmod 0700 "$source" "$source/runtime-v2" "$source/runtime-v2/keys"
  printf 'fixture\n' >"$source/runtime-v2/runtime-state.json"; chmod 0600 "$source/runtime-v2/runtime-state.json"
  : >"$source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$source/runtime-v2/outcomes.sqlite3-wal"
  snapshot "$source" "$destination" "$receipt" true ai.hepta.snapshot.selftest >/dev/null
  jq -e '.status == "ready" and .destination_exact_copy == true and .source_unchanged == true' "$receipt" >/dev/null
  bad_source="$root/legacy-nonempty-wal"
  mkdir -p "$bad_source/runtime-v2"; chmod 0700 "$bad_source" "$bad_source/runtime-v2"
  printf 'not-empty\n' >"$bad_source/runtime-v2/outcomes.sqlite3-wal"; chmod 0600 "$bad_source/runtime-v2/outcomes.sqlite3-wal"
  if snapshot "$bad_source" "$root/rejected" "" false ai.hepta.snapshot.selftest >/dev/null 2>&1; then
    echo "nonempty WAL was accepted" >&2
    exit 1
  fi
  jq -cn --arg receipt_sha256 "$(sha256_file "$receipt")" \
    '{schema:"hepta_vnext_state_snapshot_self_test_v1",status:"ready",receipt_sha256:$receipt_sha256,nonempty_wal_rejected:true,source_unchanged:true,destination_exact_copy:true,production_changed:false}'
}

if [[ "${1:-}" == "self-test" ]]; then
  [[ $# -eq 1 ]] || usage
  self_test
  exit 0
fi
source_root=""; destination_root=""; receipt=""; materialize=false; legacy_label=ai.hepta.gateway
while (( $# > 0 )); do
  case "$1" in
    --source-state-root) shift; [[ $# -gt 0 ]] || usage; source_root="$1" ;;
    --destination-state-root) shift; [[ $# -gt 0 ]] || usage; destination_root="$1" ;;
    --legacy-label) shift; [[ $# -gt 0 ]] || usage; legacy_label="$1" ;;
    --receipt) shift; [[ $# -gt 0 ]] || usage; receipt="$1" ;;
    --materialize) materialize=true ;;
    *) usage ;;
  esac
  shift
done
[[ -n "$source_root" && -n "$destination_root" ]] || usage
snapshot "$source_root" "$destination_root" "$receipt" "$materialize" "$legacy_label"
