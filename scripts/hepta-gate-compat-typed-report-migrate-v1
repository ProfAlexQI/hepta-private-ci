  raise "stale WorkGraph protected reclassification drifted" unless reclassified_protected.sort == [
    "hepta-systems-work-graph-durable-identity-preview",
    "hepta-systems-work-graph-terminal-receipt-retention-readback-ack-terminal-decision-receipt-retention-readback-ack-terminal-decision-receipt-retention-expiry-readback-receipt-preview"
