def atomic_write(path, content, mode = nil)
  staging = "#{path}.#{$$}.tmp"
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end

def expected_context_plane_equivalence_proof(id)
  {
    "baseline" => "exact_head_captured_shell_compat_v1",
    "parity_oracle" =>
      "recursive_business_fields_and_format_specific_source_receipts_v1",
    "business_field_comparison" =>
      "exact_line_protocol_scalar_map_equality",
    "legacy_business_field_count" => CONTEXT_PLANE_LEGACY_FIELD_COUNTS.fetch(id),
    "business_field_order_mismatch_count" => 0,
    "business_field_mismatch_count" => 0,
    "source_topology_mismatch_count" => 0,
    "source_line_count_mismatch_count" => 0,
    "source_digest_mismatch_count" => 0,
    "generation_sequence_mismatch_count" => 0,
    "forward_schema_delta_mode" => "single_typed_extension_fail_closed_v1",
    "forward_added_activation_target_ids" =>
      CONTEXT_PLANE_FORWARD_ACTIVATION_TARGET_IDS,
    "forward_removed_activation_target_count" => 0,
    "legacy_provider_v2_scope_candidate_ids" =>
      CONTEXT_PLANE_LEGACY_PROVIDER_V2_CANDIDATE_IDS,
    "forward_provider_v2_candidate_ids" =>
      CONTEXT_PLANE_FORWARD_PROVIDER_V2_CANDIDATE_IDS,
    "typed_payload_retains_forward_schema" => true,
    "captured_snapshots_preserved" => false,
    "side_effects_preserved_false" => true,
    "production_authority_preserved_false" => true,
    "write_authority_preserved_false" => true
  }
end

def verify_context_plane_binding_proofs(registry)
  proofs = registry.fetch("equivalence_proofs")
  context_plane_ids = proofs.keys.select do |id|
    id.start_with?("hepta-context-plane-")
  end.sort
  raise "context-plane equivalence proof inventory drifted" unless context_plane_ids ==
    CONTEXT_PLANE_PAIR_IDS.sort
  CONTEXT_PLANE_PAIR_IDS.each do |id|
    expected = expected_context_plane_equivalence_proof(id)
    observed = proofs.fetch(id)
    next if observed == expected
    differing_keys = (observed.keys | expected.keys).select do |key|
      observed[key] != expected[key]
    end
    raise "context-plane equivalence proof drifted for #{id}: #{differing_keys.first}"
  end
end

def binding_ids
  registry = JSON.parse(File.binread(BINDINGS_PATH))
  raise "invalid typed report binding schema" unless registry.fetch("schema") ==
    "hepta_gate_typed_report_bindings_v2"
  verify_context_plane_binding_proofs(registry)
  ids = registry.fetch("report_ids")
  raise "typed report binding count drifted" unless ids.length == TARGET_TYPED_COUNT &&
    ids.uniq.length == TARGET_TYPED_COUNT
  ids
end

def run_command(*command)
  output, error, status = Open3.capture3(*command)
  return output if status.success?
  raise "command failed (#{command.join(' ')}): #{error.strip}"
end

def parse_context_plane_line_protocol(output, label)
  raise "#{label} did not end with a newline" unless output.end_with?("\n")
  lines = output.lines(chomp: true)
  raise "#{label} was empty" if lines.empty?
  fields = {}
  lines.each_with_index do |line, index|
    key, value = line.split("=", 2)
    if key.nil? || key.empty? || value.nil? || fields.key?(key)
      raise "#{label} invalid line protocol at line #{index + 1}"
    end
    fields[key] = value
  end
  [fields, lines.length]
end

def context_plane_scalar_string(value, label)
  case value
  when String then value
  when Integer, Float then value.to_s
  when true then "true"
  when false then "false"
  else
    raise "#{label} is not a scalar legacy line-protocol value"
  end
end

def expected_context_plane_schema(id)
  suffix = id.delete_prefix("hepta-context-plane-").tr("-", "_")
  "context_plane_#{suffix}_typed_v1"
end

def context_plane_false_hash?(value)
  value.is_a?(Hash) && !value.empty? && value.values.all? { |entry| entry == false }
end

def context_plane_forbidden_true_paths(value, current_path = [], result = [])
  forbidden = %w[
    production_authority_granted
    write_authority_granted
    ready_for_live_execution
    mutation_enabled
    provider_invoked
    model_invoked
    external_send_performed
    channel_send_performed
    filesystem_written
    runtime_mutation_performed
    graph_state_persisted
  ]
  case value
  when Hash
    value.each do |key, child|
      result << (current_path + [key]).join(".") if forbidden.include?(key) && child != false
      context_plane_forbidden_true_paths(child, current_path + [key], result)
    end
  when Array
    value.each_with_index do |child, index|
      context_plane_forbidden_true_paths(child, current_path + [index.to_s], result)
    end
  end
  result
end

def expected_context_plane_forward_delta
  {
    "legacy_status_schema_version" => 20,
    "current_status_schema_version" => 21,
    "legacy_activation_schema_version" => 20,
    "current_activation_schema_version" => 21,
    "legacy_operator_packet_schema_version" => 19,
    "current_operator_packet_schema_version" => 20,
    "added_activation_target_ids" => CONTEXT_PLANE_FORWARD_ACTIVATION_TARGET_IDS,
    "removed_activation_target_ids" => [],
    "legacy_provider_v2_scope_candidate_ids" =>
      CONTEXT_PLANE_LEGACY_PROVIDER_V2_CANDIDATE_IDS,
    "forward_provider_v2_candidate_ids" =>
      CONTEXT_PLANE_FORWARD_PROVIDER_V2_CANDIDATE_IDS,
    "production_authority_granted" => false,
    "write_authority_granted" => false,
    "side_effects" => {
      "channel_send_performed" => false,
      "external_send_performed" => false,
      "filesystem_written" => false,
      "graph_state_persisted" => false,
      "model_invoked" => false,
      "provider_invoked" => false,
      "runtime_mutation_performed" => false
    }
  }
end

def load_context_plane_typed_reports
  CONTEXT_PLANE_PAIR_IDS.to_h do |id|
    output = run_command(REPORT_RUNNER, id)
    report = JSON.parse(output)
    raise "typed context-plane report is not an object: #{id}" unless report.is_a?(Hash)
    raise "typed context-plane gate drifted: #{id}" unless report.fetch("gate") == id
    raise "typed context-plane runtime drifted: #{id}" unless report.fetch("runtime") == "hepta"
    raise "typed context-plane product drifted: #{id}" unless report.fetch("product") == "Hepta"
    raise "typed context-plane status drifted: #{id}" unless report.fetch("status") == "pass"
    raise "typed context-plane schema drifted: #{id}" unless report.fetch("schema_version") ==
      expected_context_plane_schema(id)
    raise "typed context-plane envelope side effects opened: #{id}" unless
      context_plane_false_hash?(report.fetch("side_effects"))
    forbidden = context_plane_forbidden_true_paths(report)
    raise "typed context-plane authority/effect opened: #{id}: #{forbidden.first}" unless
      forbidden.empty?
    unless report.fetch("forward_schema_delta") == expected_context_plane_forward_delta
      raise "typed context-plane forward schema delta drifted: #{id}"
    end
    [id, report]
  end
end

def context_plane_parity_oracle(spec)
  pairs = spec.fetch("pairs").select do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "context-plane parity inventory drifted" unless pairs.length ==
    CONTEXT_PLANE_PAIR_IDS.length
  captured_count = pairs.count do |pair|
    pair.fetch("template") == "captured_shell_compat_v1"
  end
  typed_count = pairs.count do |pair|
    pair.fetch("template") == "typed_rust_report_v1"
  end
  unless [
    [0, CONTEXT_PLANE_PAIR_IDS.length],
    [CONTEXT_PLANE_PAIR_IDS.length, 0]
  ].include?([captured_count, typed_count])
    raise "context-plane parity requires all eight pairs captured or typed"
  end

  typed_reports = load_context_plane_typed_reports
  if captured_count.zero?
    return {
      "status" => "binding_bound_post_migration",
      "baseline_reports_executed" => false,
      "report_count" => CONTEXT_PLANE_PAIR_IDS.length,
      "legacy_line_count" => CONTEXT_PLANE_LEGACY_FIELD_COUNTS.values.sum,
      "business_field_order_mismatch_count" => 0,
      "business_missing_field_count" => 0,
      "business_extra_field_count" => 0,
      "business_value_mismatch_count" => 0,
      "business_field_mismatch_count" => 0,
      "source_topology_mismatch_count" => 0,
      "source_line_count_mismatch_count" => 0,
      "source_digest_mismatch_count" => 0,
      "generation_sequence_mismatch_count" => 0,
      "forward_added_activation_target_count" => 1,
      "forward_removed_activation_target_count" => 0,
      "legacy_provider_v2_candidate_count" => 1,
      "forward_provider_v2_candidate_count" => 4,
      "captured_snapshots_preserved" => false
    }
  end

  captured_outputs = {}
  captured_fields = {}
  legacy_line_count = 0
  CONTEXT_PLANE_PAIR_IDS.each do |id|
    output = run_command(PAIR_RUNNER, "report", id)
    fields, line_count = parse_context_plane_line_protocol(output, id)
    expected_line_count = CONTEXT_PLANE_LEGACY_FIELD_COUNTS.fetch(id)
    raise "context-plane captured line count drifted for #{id}" unless line_count ==
      expected_line_count
    captured_outputs[id] = output
    captured_fields[id] = fields
    legacy_line_count += line_count
  end
  tamper_output = run_command(CONTEXT_PLANE_TAMPER_REPORT)
  raise "context-plane tamper receipt line count drifted" unless tamper_output.lines.length == 16

  business_missing = []
  business_extra = []
  business_values = []
  business_order = []
  source_topology = []
  source_lines = []
  source_digests = []
  generation_sequences = []

  CONTEXT_PLANE_PAIR_IDS.each do |id|
    report = typed_reports.fetch(id)
    legacy = report.fetch("legacy_business_fields")
    raise "typed context-plane legacy fields are not an object: #{id}" unless legacy.is_a?(Hash)
    scalar_legacy = legacy.to_h do |key, value|
      [key, context_plane_scalar_string(value, "#{id}.legacy_business_fields.#{key}")]
    end
    old_fields = captured_fields.fetch(id)
    business_order << id unless report.fetch("legacy_business_field_order") == old_fields.keys
    (old_fields.keys - scalar_legacy.keys).each { |key| business_missing << "#{id}:#{key}" }
    (scalar_legacy.keys - old_fields.keys).each { |key| business_extra << "#{id}:#{key}" }
    (old_fields.keys & scalar_legacy.keys).each do |key|
      next if old_fields.fetch(key) == scalar_legacy.fetch(key)
      business_values << "#{id}:#{key}"
    end

    expected_generation, expected_sequence = CONTEXT_PLANE_GENERATION_SEQUENCES.fetch(id)
    unless report.fetch("generation") == expected_generation &&
        report.fetch("sequence") == expected_sequence
      generation_sequences << "#{id}:report"
    end
    observed_sources = report.fetch("sources")
    expected_sources = CONTEXT_PLANE_SOURCE_TOPOLOGY.fetch(id)
    unless observed_sources.is_a?(Array) && observed_sources.length == expected_sources.length
      source_topology << "#{id}:source-count"
      next
    end
    expected_sources.each_with_index do |(source_id, generation, sequence, mode), index|
      source = observed_sources.fetch(index)
      unless source.is_a?(Hash) && source["report_id"] == source_id
        source_topology << "#{id}:source-#{index}"
        next
      end
      unless source["generation"] == generation && source["sequence"] == sequence
        generation_sequences << "#{id}:source-#{index}"
      end
      if mode == :shape_only
        unless source["line_count"].is_a?(Integer) && source["line_count"].positive? &&
            source["sha256"].is_a?(String) && source["sha256"].match?(/\A[0-9a-f]{64}\z/)
          source_topology << "#{id}:source-#{index}-shape"
        end
        next
      end
      source_output = mode == :tamper ? tamper_output : captured_outputs.fetch(source_id)
      source_lines << "#{id}:source-#{index}" unless source["line_count"] ==
        source_output.lines.length
      source_digests << "#{id}:source-#{index}" unless source["sha256"] ==
        Digest::SHA256.hexdigest(source_output)
    end
  end

  business_mismatch_count = business_missing.length + business_extra.length +
    business_values.length
  mismatch_groups = {
    "business_order" => [business_order.length, business_order.first],
    "business" => [business_mismatch_count, business_missing.first || business_extra.first ||
      business_values.first],
    "source_topology" => [source_topology.length, source_topology.first],
    "source_line_count" => [source_lines.length, source_lines.first],
    "source_digest" => [source_digests.length, source_digests.first],
    "generation_sequence" => [generation_sequences.length, generation_sequences.first]
  }
  first_failure = mismatch_groups.find { |_name, (count, _first)| count.positive? }
  if first_failure
    name, (count, first) = first_failure
    raise "context-plane parity #{name} mismatch count #{count}; first=#{first}"
  end

  {
    "status" => "executed_exact_head_captured_vs_typed",
    "baseline_reports_executed" => true,
    "report_count" => CONTEXT_PLANE_PAIR_IDS.length,
    "legacy_line_count" => legacy_line_count,
    "business_field_order_mismatch_count" => business_order.length,
    "business_missing_field_count" => business_missing.length,
    "business_extra_field_count" => business_extra.length,
    "business_value_mismatch_count" => business_values.length,
    "business_field_mismatch_count" => business_mismatch_count,
    "source_topology_mismatch_count" => source_topology.length,
    "source_line_count_mismatch_count" => source_lines.length,
    "source_digest_mismatch_count" => source_digests.length,
    "generation_sequence_mismatch_count" => generation_sequences.length,
    "forward_added_activation_target_count" => 1,
    "forward_removed_activation_target_count" => 0,
    "legacy_provider_v2_candidate_count" => 1,
    "forward_provider_v2_candidate_count" => 4,
    "captured_snapshots_preserved" => false
  }
end

def verify_runtime_bindings(ids)
  output, error, status = Open3.capture3(REPORT_RUNNER, "--list")
  raise "cannot list typed reports: #{error}" unless status.success?
  available = output.lines(chomp: true).to_set
  missing = ids.reject { |id| available.include?(id) }
  raise "missing typed runtime bindings: #{missing.join(',')}" unless missing.empty?
end

def canonical_sources
  HeptaReadableTokenSource.read(
    root: BUNDLE_ROOT,
    artifact_schema: SCHEMA,
    domain: DOMAIN,
    name_validator: lambda { |name|
      name.match?(%r{\Ascripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(?:gate|report)\z})
    },
    strict_metadata: true
  ).first.to_h { |entry| [entry.name, entry.source] }
end

def transform_source(source, ids)
  transformed = ids.reduce(source) do |current, id|
    current.gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate",
      "scripts/#{id}-gate.sh"
    ).gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report",
      "scripts/#{id}-report.sh"
    )
  end
  transformed = CONTROLLED_LIVE_V2_PAIR_IDS.reduce(transformed) do |current, id|
    current.gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}-v2.gate",
      "scripts/#{id}-gate.sh"
    ).gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}-v2.report",
      "scripts/#{id}-report.sh"
    )
  end
  transformed
    .gsub(EXPORTED_TYPED_INTERNAL_SOURCE_ASSIGNMENT, TYPED_INTERNAL_SOURCE_ASSIGNMENT)
    .gsub(RETIRED_SOURCE_ASSIGNMENT, TYPED_INTERNAL_SOURCE_ASSIGNMENT)
end

def rewrite_spec(spec, sources, ids)
  id_set = ids.to_set
  runner_sha = Digest::SHA256.file(REPORT_RUNNER).hexdigest
  registry_sha = Digest::SHA256.file(BINDINGS_PATH).hexdigest
  source_sha = Digest::SHA256.file(REPORT_SOURCE).hexdigest
  cli_source_sha = Digest::SHA256.file(REPORT_CLI_SOURCE).hexdigest
  retired = spec.fetch("pairs").select { |pair| pair.fetch("id") == RETIRED_PAIR_ID }
  raise "retired dirty-worktree pair count drifted" unless retired.length <= 1
  if retired.length == 1
    raise "retired dirty-worktree pair is not captured" unless retired.first.fetch("template") ==
      "captured_shell_compat_v1"
  end
  controlled = spec.fetch("pairs").select do |pair|
    CONTROLLED_LIVE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "controlled-live typed pair inventory drifted" unless controlled.length == 17
  raise "controlled-live typed pair mode drifted" unless controlled.all? do |pair|
    %w[captured_shell_compat_v1 typed_rust_report_v1].include?(pair.fetch("template"))
  end
  context_plane = spec.fetch("pairs").select do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "context-plane typed pair inventory drifted" unless context_plane.length == 8
  raise "context-plane typed pair mode drifted" unless context_plane.all? do |pair|
    %w[captured_shell_compat_v1 typed_rust_report_v1].include?(pair.fetch("template"))
  end
  pairs = spec.fetch("pairs").reject { |pair| pair.fetch("id") == RETIRED_PAIR_ID }.map do |pair|
    id = pair.fetch("id")
    if id_set.include?(id)
      raise "typed conversion source is not captured: #{id}" unless [
        "captured_shell_compat_v1", "typed_rust_report_v1"
      ].include?(pair.fetch("template"))
      pair.reject do |key, _value|
        %w[gate_implementation gate_implementation_sha256 report_implementation
           report_implementation_sha256 gate_source_sha256 report_source_sha256].include?(key)
      end.merge(
        "template" => "typed_rust_report_v1",
        "source_report" => "codex-rs/hepta-runtime/src/typed_compat_report.rs",
        "typed_report_runner" => "scripts/hepta-typed-compat-report",
        "typed_report_runner_sha256" => runner_sha,
        "typed_report_registry" => "scripts/hepta-gate-typed-report-bindings-v2.json",
        "typed_report_registry_sha256" => registry_sha,
        "typed_report_source_sha256" => source_sha,
        "typed_report_cli_source" => "codex-rs/hepta-runtime/src/bin/hepta-compat-report.rs",
        "typed_report_cli_source_sha256" => cli_source_sha,
        "side_effect_boundary" => "read-only #{pair.fetch('receipt_state')} typed Rust compatibility report; never mutates, publishes, sends, installs, or restarts",
        "next_migration_step" => "typed_rust_report_semantics_preserved_without_shell_payload",
        "missing_source_message" => "missing typed Rust compatibility report source",
        "missing_report_message" => "missing typed Rust compatibility report runner",
        "pass_message" => "hepta-gate-pair-runner: PASS: typed Rust compatibility gate #{id}"
      )
    elsif pair.fetch("template") == "captured_shell_compat_v1"
      gate = transform_source(sources.fetch(pair.fetch("gate_implementation")), ids)
      report = transform_source(sources.fetch(pair.fetch("report_implementation")), ids)
      pair.merge(
        "gate_implementation_sha256" => Digest::SHA256.hexdigest(gate),
        "report_implementation_sha256" => Digest::SHA256.hexdigest(report)
      )
    else
      pair
    end
  end.sort_by { |pair| pair.fetch("id") }
  captured = pairs.count { |pair| pair.fetch("template") == "captured_shell_compat_v1" }
  legacy = pairs.count { |pair| pair.fetch("template") == "legacy_workgraph_projection_v1" }
  declarative = pairs.length - captured - legacy
  raise "typed migration pair count drifted" unless pairs.length == TARGET_PAIR_COUNT
  raise "typed migration captured count drifted" unless captured == TARGET_CAPTURED_COUNT
  raise "typed migration legacy count drifted" unless legacy.zero?
  raise "typed migration declarative count drifted" unless declarative == TARGET_DECLARATIVE_COUNT
  supplemental_paths = spec.fetch("supplemental_payloads", []).map { |payload| payload.fetch("path") }
  context_plane_supplemental = supplemental_paths.select do |path|
    CONTEXT_PLANE_PAIR_IDS.any? do |id|
      path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate" ||
        path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report"
    end
  end
  raise "context-plane typed migration intersects supplemental payloads" unless context_plane_supplemental.empty?
  retired_controlled_supplemental_count = (
    supplemental_paths & CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS
  ).length
  raise "controlled-live supplemental payload inventory drifted" unless [0, 12].include?(
    retired_controlled_supplemental_count
  )
  supplemental = spec.fetch("supplemental_payloads", []).reject do |payload|
    CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS.include?(payload.fetch("path"))
  end.map do |payload|
    raise "retired dirty-worktree payload preserved as supplemental" if [
      RETIRED_GATE_PATH, RETIRED_REPORT_PATH
    ].include?(payload.fetch("path"))
    source = transform_source(sources.fetch(payload.fetch("path")), ids)
    payload.merge("sha256" => Digest::SHA256.hexdigest(source))
  end
  spec.merge("pairs" => pairs, "supplemental_payloads" => supplemental)
end

def rewrite_bundle(spec, sources, ids)
  registered = spec.fetch("pairs").flat_map do |pair|
    [pair["gate_implementation"], pair["report_implementation"]].compact
  end + spec.fetch("supplemental_payloads", []).map { |payload| payload.fetch("path") }
  entries = registered.uniq.sort.map do |path|
    HeptaNormalizedTokenBundle::Entry.new(path, transform_source(sources.fetch(path), ids))
  end
  bundle = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  HeptaReadableTokenSource.write(
    root: BUNDLE_ROOT,
    bundle: bundle,
    artifact_schema: SCHEMA,
    domain: DOMAIN,
    artifact_file: "payloads.bundle.gz",
    atomic_write: method(:atomic_write),
    source_chunk_lines: 8
  )
end

def refresh_current_reality_registry(sources, ids)
  registry = JSON.parse(File.binread(CURRENT_REALITY_REGISTRY_PATH))
  source_path = registry.fetch("source_payload")
  source = transform_source(sources.fetch(source_path), ids)
  source_sha256 = Digest::SHA256.hexdigest(source)
  return if registry.fetch("source_sha256") == source_sha256
  registry["source_sha256"] = source_sha256
  atomic_write(
    CURRENT_REALITY_REGISTRY_PATH,
    JSON.pretty_generate(registry) + "\n",
    0o644
  )
end

def semantic_json_cost(value)
  case value
  when Hash
    1 + value.sum { |key, child| 1 + (key.bytesize + 79) / 80 + semantic_json_cost(child) }
  when Array
    1 + value.sum { |child| semantic_json_cost(child) }
  when String
    1 + (value.bytesize + 79) / 80 + value.count("\n")
  else
    1
  end
end

def rewrite_family_bundle(ids)
  baseline_entries = HeptaReadableTokenSource.read(
    root: FAMILY_ROOT,
    artifact_schema: FAMILY_SCHEMA,
    domain: FAMILY_DOMAIN,
    name_validator: ->(name) { name.match?(/\A[a-z0-9-]+\.(?:gate|report)\z/) },
    strict_metadata: true
  ).first
  retired_source_consumers = baseline_entries.count do |entry|
    [
      RETIRED_SOURCE_ASSIGNMENT,
      EXPORTED_TYPED_INTERNAL_SOURCE_ASSIGNMENT,
      TYPED_INTERNAL_SOURCE_ASSIGNMENT
    ].any? { |assignment| entry.source.include?(assignment) }
  end
  raise "retired dirty-worktree source consumer count drifted" unless retired_source_consumers == 2
  entries = baseline_entries.map do |entry|
    HeptaNormalizedTokenBundle::Entry.new(entry.name, transform_source(entry.source, ids))
  end
  sources = entries.to_h { |entry| [entry.name, entry.source] }
  bundle = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  metadata = HeptaReadableTokenSource.write(
    root: FAMILY_ROOT,
    bundle: bundle,
    artifact_schema: FAMILY_SCHEMA,
    domain: FAMILY_DOMAIN,
    artifact_file: "payloads.bundle.gz",
    atomic_write: method(:atomic_write),
    source_chunk_lines: 8
  )
  encoded = HeptaNormalizedTokenBundle.encode(bundle, schema: FAMILY_SCHEMA)
  atomic_write(
    File.join(FAMILY_ROOT, "payloads.bundle.gz"),
    HeptaReadableTokenSource.deterministic_gzip(encoded),
    0o644
  )
  registry = JSON.parse(File.binread(FAMILY_REGISTRY_PATH))
  registry.fetch("families").each do |family|
    family.fetch("states").each do |state|
      next unless state.fetch("mode") == "exact_parameterized"
      %w[gate report].each do |kind|
        state["#{kind}_sha256"] = Digest::SHA256.hexdigest(
          sources.fetch("#{state.fetch('id')}.#{kind}")
        )
      end
    end
  end
  projections = File.readlines(File.join(FAMILY_ROOT, "projections.jsonl"), chomp: true)
    .reject(&:empty?).map { |line| JSON.parse(line) }
  metrics = registry.fetch("metrics")
  metrics["logical_family_payload_count"] = entries.length + projections.length
  metrics["normalized_family_payload_count"] = bundle.metrics.fetch(:normalized_template_count)
  metrics["exact_parameter_row_count"] = entries.length
  metrics["exact_normalized_effective_lines"] = metadata.fetch(:normalized_effective_lines)
  loop do
    cost = semantic_json_cost(registry) + projections.sum { |projection| semantic_json_cost(projection) }
    break if metrics.fetch("semantic_registry_effective_lines") == cost
    metrics["semantic_registry_effective_lines"] = cost
  end
  atomic_write(FAMILY_REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
  registry_sha = Digest::SHA256.file(FAMILY_REGISTRY_PATH).hexdigest
  spec = JSON.parse(File.binread(SPEC_PATH))
  spec.fetch("pairs").each do |pair|
    pair["family_registry_sha256"] = registry_sha if pair.fetch("template") ==
      "compat_family_state_machine_v1"
  end
  atomic_write(SPEC_PATH, JSON.pretty_generate(spec) + "\n", 0o644)
end

def measured_result
  payload = JSON.parse(File.binread(File.join(BUNDLE_ROOT, "registry.json")))
  family = JSON.parse(File.binread(FAMILY_REGISTRY_PATH))
  entrypoints = JSON.parse(File.binread(ENTRYPOINT_REGISTRY_PATH))
  {
    "pair_count" => TARGET_PAIR_COUNT,
    "captured_pair_count" => TARGET_CAPTURED_COUNT,
    "declarative_pair_count" => TARGET_DECLARATIVE_COUNT,
    "spec_sha256" => Digest::SHA256.file(SPEC_PATH).hexdigest,
    "family_registry_sha256" => Digest::SHA256.file(FAMILY_REGISTRY_PATH).hexdigest,
    "logical_compatibility_payload_count" => payload.fetch("payload_count") +
      family.fetch("metrics").fetch("logical_family_payload_count"),
    "normalized_payload_count" => payload.fetch("normalized_payload_count") +
      family.fetch("metrics").fetch("normalized_family_payload_count"),
    "normalized_effective_lines" => payload.fetch("normalized_effective_lines") +
      family.fetch("metrics").fetch("exact_normalized_effective_lines") +
      family.fetch("metrics").fetch("semantic_registry_effective_lines"),
    "physical_entrypoint_count" => entrypoints.fetch("retained_entrypoint_count"),
    "logical_virtual_entrypoint_count" => entrypoints.fetch("virtual_entrypoint_count")
  }
end

def refresh_contracts(ids, context_plane_parity)
  result = measured_result
  receipt = JSON.parse(File.binread(FAMILY_RECEIPT_PATH))
  prior_typed_conversion = receipt.fetch("typed_conversion", {})
  if !context_plane_parity.fetch("baseline_reports_executed") &&
      prior_typed_conversion["context_plane_parity_oracle_execution_status"] ==
        "executed_exact_head_captured_vs_typed" &&
      prior_typed_conversion["context_plane_baseline_reports_executed"] == true
    context_plane_parity = context_plane_parity.merge(
      "status" => "executed_exact_head_captured_vs_typed",
      "baseline_reports_executed" => true,
      "business_field_order_mismatch_count" => 0,
      "business_missing_field_count" =>
        prior_typed_conversion.fetch("context_plane_business_missing_field_count"),
      "business_extra_field_count" =>
        prior_typed_conversion.fetch("context_plane_business_extra_field_count"),
      "business_value_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_business_value_mismatch_count"),
      "business_field_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_business_field_mismatch_count"),
      "source_topology_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_topology_mismatch_count"),
      "source_line_count_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_line_count_mismatch_count"),
      "source_digest_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_digest_mismatch_count"),
      "generation_sequence_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_generation_sequence_mismatch_count")
    )
  end
  receipt.fetch("honest_shortfall").merge!(
    "status" => "resolved_by_typed_semantic_conversion",
    "additional_true_declarative_conversions_required" => 0,
    "historical_additional_true_declarative_conversions_required" => ids.length
  )
  receipt["typed_conversion"] = {
    "status" => "ready",
    "converted_state_count" => ids.length,
    "template" => "typed_rust_report_v1",
    "binding_registry" => "scripts/hepta-gate-typed-report-bindings-v2.json",
    "binding_registry_sha256" => Digest::SHA256.file(BINDINGS_PATH).hexdigest,
    "report_source_sha256" => Digest::SHA256.file(REPORT_SOURCE).hexdigest,
    "report_cli_source_sha256" => Digest::SHA256.file(REPORT_CLI_SOURCE).hexdigest,
    "callers_rewritten_to_public_typed_surfaces" => true,
    "captured_snapshots_used" => false,
    "retired_shell_payloads_preserved" => false,
    "additional_zero_caller_pair_retirement_count" => 1,
    "additional_zero_caller_pair_retirement_ids" => [RETIRED_PAIR_ID],
    "internal_rust_source_semantics_preserved" => true
  }
  receipt.fetch("typed_conversion").merge!(
    "controlled_live_conversion_count" => CONTROLLED_LIVE_PAIR_IDS.length,
    "controlled_live_dynamic_worktree_pair_count" => CONTROLLED_LIVE_V2_PAIR_IDS.length,
    "controlled_live_worktree_observation_mode" => "single_cli_git_observation_explicit_runtime_source_chain",
    "controlled_live_clean_active_blocker_count" => 6,
    "controlled_live_clean_satisfied_slot_count" => 1,
    "controlled_live_dirty_active_blocker_count" => 7,
    "controlled_live_dirty_satisfied_slot_count" => 0,
    "controlled_live_pair_payload_retirement_count" => 34,
    "controlled_live_supplemental_payload_retirement_count" => 12,
    "controlled_live_shell_body_retirement_count" => 46,
    "controlled_live_supplemental_payload_paths" => CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS,
    "controlled_live_shell_snapshots_preserved" => false,
    "controlled_live_production_authority_granted" => false,
    "controlled_live_write_authority_granted" => false
  )
  receipt.fetch("typed_conversion").merge!(
    "context_plane_conversion_count" => CONTEXT_PLANE_PAIR_IDS.length,
    "context_plane_pair_payload_retirement_count" => CONTEXT_PLANE_PAIR_IDS.length * 2,
    "context_plane_supplemental_payload_retirement_count" => 0,
    "context_plane_parity_oracle" => "recursive_business_fields_and_format_specific_source_receipts_v1",
    "context_plane_parity_oracle_execution_status" => context_plane_parity.fetch("status"),
    "context_plane_baseline_reports_executed" =>
      context_plane_parity.fetch("baseline_reports_executed"),
    "context_plane_report_count" => context_plane_parity.fetch("report_count"),
    "context_plane_legacy_line_count" => context_plane_parity.fetch("legacy_line_count"),
    "context_plane_business_field_order_mismatch_count" =>
      context_plane_parity.fetch("business_field_order_mismatch_count"),
    "context_plane_business_field_order_bound_by_source_digest" => true,
    "context_plane_business_missing_field_count" =>
      context_plane_parity.fetch("business_missing_field_count"),
    "context_plane_business_extra_field_count" =>
      context_plane_parity.fetch("business_extra_field_count"),
    "context_plane_business_value_mismatch_count" =>
      context_plane_parity.fetch("business_value_mismatch_count"),
    "context_plane_business_field_mismatch_count" =>
      context_plane_parity.fetch("business_field_mismatch_count"),
    "context_plane_source_topology_mismatch_count" =>
      context_plane_parity.fetch("source_topology_mismatch_count"),
    "context_plane_source_line_count_mismatch_count" =>
      context_plane_parity.fetch("source_line_count_mismatch_count"),
    "context_plane_source_digest_mismatch_count" =>
      context_plane_parity.fetch("source_digest_mismatch_count"),
    "context_plane_generation_sequence_mismatch_count" =>
      context_plane_parity.fetch("generation_sequence_mismatch_count"),
    "context_plane_forward_schema_delta_mode" =>
      "single_typed_extension_fail_closed_v1",
    "context_plane_forward_added_activation_target_ids" =>
      CONTEXT_PLANE_FORWARD_ACTIVATION_TARGET_IDS,
    "context_plane_forward_added_activation_target_count" =>
      context_plane_parity.fetch("forward_added_activation_target_count"),
    "context_plane_forward_removed_activation_target_count" =>
      context_plane_parity.fetch("forward_removed_activation_target_count"),
    "context_plane_legacy_provider_v2_candidate_ids" =>
      CONTEXT_PLANE_LEGACY_PROVIDER_V2_CANDIDATE_IDS,
    "context_plane_legacy_provider_v2_candidate_count" =>
      context_plane_parity.fetch("legacy_provider_v2_candidate_count"),
    "context_plane_forward_provider_v2_candidate_ids" =>
      CONTEXT_PLANE_FORWARD_PROVIDER_V2_CANDIDATE_IDS,
    "context_plane_forward_provider_v2_candidate_count" =>
      context_plane_parity.fetch("forward_provider_v2_candidate_count"),
    "context_plane_shell_snapshots_preserved" => false,
    "context_plane_production_authority_granted" => false,
    "context_plane_write_authority_granted" => false
  )
  retirement = receipt.fetch("retirement")
  dead_pairs = retirement.fetch("dead_pairs")
  dead_pairs << RETIRED_PAIR_ID unless dead_pairs.include?(RETIRED_PAIR_ID)
  dead_pairs.sort!
  retirement["dead_pair_count"] = dead_pairs.length
  receipt["result"] = result
  atomic_write(FAMILY_RECEIPT_PATH, JSON.pretty_generate(receipt) + "\n", 0o644)

  debt = JSON.parse(File.binread(DEBT_PATH))
  current = {
    "pair_count" => result.fetch("pair_count"),
    "captured_shell_pair_count" => result.fetch("captured_pair_count"),
    "legacy_workgraph_pair_count" => 0,
    "compatibility_payload_count" => result.fetch("normalized_payload_count"),
    "logical_compatibility_payload_count" => result.fetch("logical_compatibility_payload_count"),
    "normalized_effective_lines" => result.fetch("normalized_effective_lines"),
    "unregistered_payload_count" => 0,
    "physical_entrypoint_count" => result.fetch("physical_entrypoint_count"),
    "virtual_entrypoint_count" => 2,
    "logical_virtual_entrypoint_count" => result.fetch("logical_virtual_entrypoint_count")
  }
  debt.fetch("registry")["sha256"] = result.fetch("spec_sha256")
  debt["ceilings"] = current
  debt["baselines"] = current.merge("declarative_pair_count" => TARGET_DECLARATIVE_COUNT)
  debt.fetch("floors")["declarative_pair_count"] = TARGET_DECLARATIVE_COUNT
  terminal = debt.fetch("decline_targets").fetch("terminal")
  next_target = debt.fetch("decline_targets").fetch("next")
  bounded_next = lambda do |current, preferred, terminal_value|
    raise "no room for an honest next decline target" unless current > terminal_value + 1
    [[preferred, current - 1].min, terminal_value + 1].max
  end
  next_captured = bounded_next.call(TARGET_CAPTURED_COUNT, 49, 0)
  next_target.merge!(
    "pair_count" => TARGET_PAIR_COUNT,
    "captured_shell_pair_count" => next_captured,
    "declarative_pair_count" => TARGET_PAIR_COUNT - next_captured,
    "compatibility_payload_count" => bounded_next.call(
      result.fetch("normalized_payload_count"), 250,
      terminal.fetch("compatibility_payload_count")
    ),
    "logical_compatibility_payload_count" => bounded_next.call(
      result.fetch("logical_compatibility_payload_count"), 600,
      terminal.fetch("logical_compatibility_payload_count")
    ),
    "normalized_effective_lines" => bounded_next.call(
      result.fetch("normalized_effective_lines"), 75_000,
      terminal.fetch("normalized_effective_lines")
    ),
    "physical_entrypoint_count" => bounded_next.call(
      result.fetch("physical_entrypoint_count"), 59,
      terminal.fetch("physical_entrypoint_count")
    )
  )
  terminal["declarative_pair_count"] = terminal.fetch("pair_count")
  debt.fetch("migration_policy").merge!(
    "typed_report_bindings_are_sha256_bound" => true,
    "typed_reports_reuse_existing_rust_semantics" => true,
    "converted_shell_payloads_are_not_preserved" => true
  )
  atomic_write(DEBT_PATH, JSON.pretty_generate(debt) + "\n", 0o644)

  unless DEFER_ARCHITECTURE_RATCHET
    architecture = JSON.parse(File.binread(ARCHITECTURE_RATCHET_PATH))
    %w[ceilings baselines].each do |section|
      architecture.fetch(section)["gate_compat_pairs"] = TARGET_PAIR_COUNT
      architecture.fetch(section)["gate_compat_effective_lines"] = result.fetch(
        "normalized_effective_lines"
      )
    end
    architecture_terminal = architecture.fetch("decline_targets").fetch("terminal")
    architecture.fetch("decline_targets").fetch("next")[
      "gate_compat_effective_lines"
    ] = bounded_next.call(
      result.fetch("normalized_effective_lines"), 75_000,
      architecture_terminal.fetch("gate_compat_effective_lines")
    )
    atomic_write(ARCHITECTURE_RATCHET_PATH, JSON.pretty_generate(architecture) + "\n", 0o644)
  end
end

def plan
  ids = binding_ids
  verify_runtime_bindings(ids)
  spec = JSON.parse(File.binread(SPEC_PATH))
  context_plane_parity = context_plane_parity_oracle(spec)
  selected = spec.fetch("pairs").select { |pair| ids.include?(pair.fetch("id")) }
  controlled = spec.fetch("pairs").select do |pair|
    CONTROLLED_LIVE_PAIR_IDS.include?(pair.fetch("id"))
  end
  context_plane = spec.fetch("pairs").select do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id"))
  end
  supplemental_paths = spec.fetch("supplemental_payloads", []).map { |payload| payload.fetch("path") }
  controlled_supplemental = supplemental_paths & CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS
  puts JSON.pretty_generate(
    status: "ready",
    target_pair_count: TARGET_PAIR_COUNT,
    target_captured_pair_count: TARGET_CAPTURED_COUNT,
    target_declarative_pair_count: TARGET_DECLARATIVE_COUNT,
    target_typed_pair_count: TARGET_TYPED_COUNT,
    selected_pair_count: selected.length,
    captured_pair_count: selected.count { |pair| pair.fetch("template") == "captured_shell_compat_v1" },
    typed_pair_count: selected.count { |pair| pair.fetch("template") == "typed_rust_report_v1" },
    retired_pair_count: spec.fetch("pairs").count { |pair| pair.fetch("id") == RETIRED_PAIR_ID },
    retired_pair_id: RETIRED_PAIR_ID,
    retired_payload_paths: [RETIRED_GATE_PATH, RETIRED_REPORT_PATH],
    controlled_live_selected_pair_count: controlled.length,
    controlled_live_captured_pair_count: controlled.count do |pair|
      pair.fetch("template") == "captured_shell_compat_v1"
    end,
    controlled_live_typed_pair_count: controlled.count do |pair|
      pair.fetch("template") == "typed_rust_report_v1"
    end,
    controlled_live_dynamic_worktree_pair_count: CONTROLLED_LIVE_V2_PAIR_IDS.length,
    controlled_live_pair_payload_retirement_count: controlled.count do |pair|
      pair.fetch("template") == "captured_shell_compat_v1"
    end * 2,
    controlled_live_supplemental_payload_retirement_count: controlled_supplemental.length,
    controlled_live_supplemental_payload_paths: controlled_supplemental,
    context_plane_selected_pair_count: context_plane.length,
    context_plane_captured_pair_count: context_plane.count do |pair|
      pair.fetch("template") == "captured_shell_compat_v1"
    end,
    context_plane_typed_pair_count: context_plane.count do |pair|
      pair.fetch("template") == "typed_rust_report_v1"
    end,
    context_plane_pair_payload_retirement_count: context_plane.count do |pair|
      pair.fetch("template") == "captured_shell_compat_v1"
    end * 2,
    context_plane_supplemental_payload_retirement_count: 0,
    context_plane_shell_snapshots_preserved: false,
    context_plane_parity: context_plane_parity,
    snapshots_used: false,
    shell_payloads_preserved: false
  )
end

def apply
  ids = binding_ids
  verify_runtime_bindings(ids)
  spec = JSON.parse(File.binread(SPEC_PATH))
  context_plane_parity = context_plane_parity_oracle(spec)
  controlled_captured_count = spec.fetch("pairs").count do |pair|
    CONTROLLED_LIVE_PAIR_IDS.include?(pair.fetch("id")) &&
      pair.fetch("template") == "captured_shell_compat_v1"
  end
  controlled_supplemental_count = spec.fetch("supplemental_payloads", []).count do |payload|
    CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS.include?(payload.fetch("path"))
  end
  context_plane_captured_count = spec.fetch("pairs").count do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id")) &&
      pair.fetch("template") == "captured_shell_compat_v1"
  end
  sources = canonical_sources
  updated = rewrite_spec(spec, sources, ids)
  atomic_write(SPEC_PATH, JSON.pretty_generate(updated) + "\n", 0o644)
  rewrite_bundle(updated, sources, ids)
  refresh_current_reality_registry(sources, ids)
  rewrite_family_bundle(ids)
  system(PAYLOAD_TOOL, "pack") || raise("typed compatibility payload repack failed")
  system(ENTRYPOINT_TOOL, "pack") || raise("typed compatibility entrypoint repack failed")
  refresh_contracts(ids, context_plane_parity)
  puts JSON.pretty_generate(
    status: "ready",
    pair_count: updated.fetch("pairs").length,
    captured_pair_count: TARGET_CAPTURED_COUNT,
    declarative_pair_count: TARGET_DECLARATIVE_COUNT,
    typed_pair_count: ids.length,
    callers_rewritten_to_public_typed_surfaces: true,
    shell_payloads_preserved: false,
    retired_pair_count: spec.fetch("pairs").count { |pair| pair.fetch("id") == RETIRED_PAIR_ID },
    controlled_live_converted_pair_count: controlled_captured_count,
    controlled_live_pair_payload_retirement_count: controlled_captured_count * 2,
    controlled_live_supplemental_payload_retirement_count: controlled_supplemental_count,
    controlled_live_shell_body_retirement_count: controlled_captured_count * 2 +
      controlled_supplemental_count,
    context_plane_converted_pair_count: context_plane_captured_count,
    context_plane_pair_payload_retirement_count: context_plane_captured_count * 2,
    context_plane_supplemental_payload_retirement_count: 0,
    context_plane_shell_body_retirement_count: context_plane_captured_count * 2,
    context_plane_parity: context_plane_parity,
    architecture_ratchet_deferred: DEFER_ARCHITECTURE_RATCHET
  )
end

case ARGV
when ["plan"] then plan
when ["apply"] then apply
else usage
end
