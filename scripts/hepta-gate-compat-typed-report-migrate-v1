def verify_current_reality_binding_proof(registry)
  observed = registry.fetch("equivalence_proofs").fetch(CURRENT_REALITY_PAIR_ID)
  expected = expected_current_reality_equivalence_proof
  differing_keys = (observed.keys | expected.keys).select { |key| observed[key] != expected[key] }
  raise "current-reality equivalence proof drifted: #{differing_keys.first}" unless
    differing_keys.empty?
end

def binding_ids
  registry = JSON.parse(File.binread(BINDINGS_PATH))
  raise "invalid typed report binding schema" unless registry.fetch("schema") ==
    "hepta_gate_typed_report_bindings_v2"
  verify_context_plane_binding_proofs(registry)
  verify_plugin_binding_proofs(registry)
  verify_current_reality_binding_proof(registry)
  ids = registry.fetch("report_ids")
  raise "typed report binding count drifted" unless ids.length == TARGET_TYPED_COUNT &&
    ids.uniq.length == TARGET_TYPED_COUNT
  ids
end

def run_command(*command)
  output, error, status = Open3.capture3(*command)
  return output if status.success?
  raise "command failed (#{command.join(' ')}): #{error.strip}"
end

def current_reality_parity_oracle(spec)
  pair = spec.fetch("pairs").find { |candidate| candidate.fetch("id") == CURRENT_REALITY_PAIR_ID }
  raise "current-reality pair is missing" unless pair
  raise "current-reality pair mode drifted" unless %w[
    captured_shell_compat_v1 typed_rust_report_v1
  ].include?(pair.fetch("template"))

  typed_output = run_command(REPORT_RUNNER, CURRENT_REALITY_PAIR_ID)
  report = JSON.parse(typed_output)
  typed_report_sha256 = Digest::SHA256.hexdigest(typed_output)
  capabilities = report.fetch("capabilities")
  ids = capabilities.map { |capability| capability.fetch("id") }
  id_order_sha256 = Digest::SHA256.hexdigest(ids.join("\n") + "\n")
  raise "current-reality capability count drifted" unless capabilities.length == 104
  raise "current-reality capability id order drifted" unless id_order_sha256 ==
    CURRENT_REALITY_CAPABILITY_ID_ORDER_SHA256
  blocked_ids = capabilities.reject { |capability| capability.fetch("ready") }
    .map { |capability| capability.fetch("id") }
  raise "current-reality blocker set drifted" unless blocked_ids == CURRENT_REALITY_BLOCKED_IDS
  raise "current-reality source topology drifted" unless
    report.fetch("report_backed_capability_count") == 43 &&
      report.fetch("catalog_invariant_capability_count") == 61
  report_backed = capabilities.select do |capability|
    capability.fetch("source_kind") == "report_backed"
  end
  invariants = capabilities.select do |capability|
    capability.fetch("source_kind") == "catalog_invariant"
  end
  source_bindings = report.fetch("source_bindings")
  report_bindings = source_bindings.select do |binding|
    binding.fetch("generation") == "typed_report_constructor"
  end
  synthetic_sources = capabilities.select do |capability|
    capability.fetch("source_report_id").start_with?("typed-current-reality-")
  end
  alias_count = capabilities.count { |capability| capability.key?("compatibility_alias_successor") }
  raise "current-reality source classification drifted" unless
    report_backed.length == 43 && invariants.length == 61 &&
      report_backed.map { |source| source.fetch("source_report_id") }.uniq.length == 43 &&
      report_backed.all? { |source| source.fetch("source_sha256").match?(/\A[0-9a-f]{64}\z/) } &&
      invariants.all? { |source|
        source.fetch("source_report_id") == "current-reality-static-invariant-v1"
      } &&
      source_bindings.length == 48 && report_bindings.length == 43 &&
      synthetic_sources.empty? && alias_count == 2
  raise "current-reality ready accounting drifted" unless
    report.fetch("local_capability_ready_count") == 90 &&
      report.fetch("local_capability_blocked_count") == 14
  raise "current-reality live boundary opened" unless
    capabilities.all? { |capability| capability.fetch("live_enabled") == false }
  %w[
    production_authority_granted write_authority_granted approval_authority_granted
    mutation_authority_granted evidence_authority_granted send_authority_granted
  ].each do |field|
    raise "current-reality authority opened: #{field}" unless report.fetch(field) == false
  end
  raise "current-reality side effect opened" unless
    report.fetch("side_effects").values.all? { |value| value == false }
  expected_slots = case report.fetch("worktree_boundary_state")
  when "clean" then [6, 1]
  when "dirty" then [7, 0]
  else raise "current-reality worktree state drifted"
  end
  observed_slots = [
    report.fetch("controlled_live_active_blocker_count"),
    report.fetch("controlled_live_satisfied_readback_slot_count")
  ]
  raise "current-reality controlled-live parity drifted" unless observed_slots == expected_slots
  {
    "status" =>
      "typed_report_executed_with_legacy_exact_head_receipt_bound_not_reexecuted",
    "typed_report_executed_this_run" => true,
    "typed_report_sha256" => typed_report_sha256,
    "typed_report_digest_mode" => "sha256_exact_stdout_bytes",
    "legacy_exact_head_receipt_bound" => true,
    "legacy_exact_head_report_executed_this_run" => false,
    "legacy_exact_head_commit_sha" => CURRENT_REALITY_LEGACY_EXACT_HEAD_COMMIT_SHA,
    "legacy_exact_head_receipt_sha256" =>
      CURRENT_REALITY_LEGACY_EXACT_HEAD_RECEIPT_SHA256,
    "capability_count" => capabilities.length,
    "report_backed_capability_count" => report.fetch("report_backed_capability_count"),
    "catalog_invariant_capability_count" => report.fetch("catalog_invariant_capability_count"),
    "report_backed_source_binding_count" => report_bindings.length,
    "total_source_binding_count" => source_bindings.length,
    "unique_report_backed_source_count" =>
      report_backed.map { |source| source.fetch("source_report_id") }.uniq.length,
    "catalog_invariant_source_id" => "current-reality-static-invariant-v1",
    "synthetic_source_count" => synthetic_sources.length,
    "compatibility_alias_count" => alias_count,
    "capability_id_order_sha256" => id_order_sha256,
    "capability_id_order_mismatch_count" => 0,
    "legacy_ready_count" => 90,
    "legacy_blocked_count" => 14,
    "typed_ready_or_ready_blocked_count" => 90,
    "typed_blocked_count" => 14,
    "promoted_to_typed_ready_blocked_ids" => [],
    "blocked_ids" => blocked_ids,
    "observed_worktree_state" => report.fetch("worktree_boundary_state"),
    "observed_active_blocker_count" => observed_slots.fetch(0),
    "observed_satisfied_slot_count" => observed_slots.fetch(1),
    "authority_or_side_effect_mismatch_count" => 0
  }
end

def verify_stale_workgraph_retirement_preconditions(spec)
  selected = spec.fetch("pairs").select do |pair|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.include?(pair.fetch("id"))
  end
  unless [0, STALE_WORKGRAPH_RETIRED_PAIR_IDS.length].include?(selected.length) &&
      selected.all? { |pair| pair.fetch("template") == "captured_shell_compat_v1" }
    raise "stale WorkGraph retirement inventory drifted"
  end
  supplemental_paths = spec.fetch("supplemental_payloads", []).map { |item| item.fetch("path") }
  stale_supplemental = supplemental_paths.select do |path|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.any? do |id|
      path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate" ||
        path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report"
    end
  end
  raise "stale WorkGraph pair survived as supplemental" unless stale_supplemental.empty?
  STALE_WORKGRAPH_RETIRED_PAIR_IDS.each do |id|
    %W[scripts/#{id}-gate.sh scripts/#{id}-report.sh].each do |relative|
      raise "stale WorkGraph pair retains a physical entrypoint: #{relative}" if
        File.exist?(File.join(ROOT, relative))
    end
  end
  ignored_files = [
    File.expand_path(__FILE__), SPEC_PATH, FAMILY_RECEIPT_PATH
  ].to_set
  executable_callers = run_command("git", "-C", ROOT, "ls-files", "-z")
    .split("\0").map do |relative|
      absolute = File.join(ROOT, relative)
      next if ignored_files.include?(absolute) || relative.start_with?(
        "docs/", "scripts/lib/hepta-gate-pair-compat-v2/"
      ) || !File.file?(absolute)
      body = File.binread(absolute)
      id = STALE_WORKGRAPH_RETIRED_PAIR_IDS.find { |candidate| body.include?(candidate) }
      id && "#{relative}:#{id}"
    end.compact
  raise "stale WorkGraph pair retains an executable caller: #{executable_callers.first}" unless
    executable_callers.empty?
  family_entries = HeptaReadableTokenSource.read(
    root: FAMILY_ROOT,
    artifact_schema: FAMILY_SCHEMA,
    domain: FAMILY_DOMAIN,
    name_validator: ->(name) { name.match?(/\A[a-z0-9-]+\.(?:gate|report)\z/) },
    strict_metadata: true
  ).first
  affected_family = family_entries.select do |entry|
    STALE_WORKGRAPH_REGULAR_PROBE_GATES.key?(entry.name) ||
      STALE_WORKGRAPH_TERMINAL_PROBE_MODULES.key?(entry.name)
  end
  transformed_family = affected_family.map do |entry|
    transform_stale_workgraph_family_source(entry.name, entry.source)
  end
  raise "stale WorkGraph family consumer inventory drifted" unless affected_family.length == 23
  raise "stale WorkGraph family semantic rebind is incomplete" if transformed_family.any? do |body|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.any? { |id| body.include?(id) }
  end
  selected.length
end

def parse_context_plane_line_protocol(output, label)
  raise "#{label} did not end with a newline" unless output.end_with?("\n")
  lines = output.lines(chomp: true)
  raise "#{label} was empty" if lines.empty?
  fields = {}
  lines.each_with_index do |line, index|
    key, value = line.split("=", 2)
    if key.nil? || key.empty? || value.nil? || fields.key?(key)
      raise "#{label} invalid line protocol at line #{index + 1}"
    end
    fields[key] = value
  end
  [fields, lines.length]
end

def context_plane_scalar_string(value, label)
  case value
  when String then value
  when Integer, Float then value.to_s
  when true then "true"
  when false then "false"
  else
    raise "#{label} is not a scalar legacy line-protocol value"
  end
end

def expected_context_plane_schema(id)
  suffix = id.delete_prefix("hepta-context-plane-").tr("-", "_")
  "context_plane_#{suffix}_typed_v1"
end

def context_plane_false_hash?(value)
  value.is_a?(Hash) && !value.empty? && value.values.all? { |entry| entry == false }
end

def context_plane_forbidden_true_paths(value, current_path = [], result = [])
  forbidden = %w[
    production_authority_granted
    write_authority_granted
    ready_for_live_execution
    mutation_enabled
    provider_invoked
    model_invoked
    external_send_performed
    channel_send_performed
    filesystem_written
    runtime_mutation_performed
    graph_state_persisted
  ]
  case value
  when Hash
    value.each do |key, child|
      result << (current_path + [key]).join(".") if forbidden.include?(key) && child != false
      context_plane_forbidden_true_paths(child, current_path + [key], result)
    end
  when Array
    value.each_with_index do |child, index|
      context_plane_forbidden_true_paths(child, current_path + [index.to_s], result)
    end
  end
  result
end

def expected_context_plane_forward_delta
  {
    "legacy_status_schema_version" => 20,
    "current_status_schema_version" => 21,
    "legacy_activation_schema_version" => 20,
    "current_activation_schema_version" => 21,
    "legacy_operator_packet_schema_version" => 19,
    "current_operator_packet_schema_version" => 20,
    "added_activation_target_ids" => CONTEXT_PLANE_FORWARD_ACTIVATION_TARGET_IDS,
    "removed_activation_target_ids" => [],
    "legacy_provider_v2_scope_candidate_ids" =>
      CONTEXT_PLANE_LEGACY_PROVIDER_V2_CANDIDATE_IDS,
    "forward_provider_v2_candidate_ids" =>
      CONTEXT_PLANE_FORWARD_PROVIDER_V2_CANDIDATE_IDS,
    "production_authority_granted" => false,
    "write_authority_granted" => false,
    "side_effects" => {
      "channel_send_performed" => false,
      "external_send_performed" => false,
      "filesystem_written" => false,
      "graph_state_persisted" => false,
      "model_invoked" => false,
      "provider_invoked" => false,
      "runtime_mutation_performed" => false
    }
  }
end

def load_context_plane_typed_reports
  CONTEXT_PLANE_PAIR_IDS.to_h do |id|
    output = run_command(REPORT_RUNNER, id)
    report = JSON.parse(output)
    raise "typed context-plane report is not an object: #{id}" unless report.is_a?(Hash)
    raise "typed context-plane gate drifted: #{id}" unless report.fetch("gate") == id
    raise "typed context-plane runtime drifted: #{id}" unless report.fetch("runtime") == "hepta"
    raise "typed context-plane product drifted: #{id}" unless report.fetch("product") == "Hepta"
    raise "typed context-plane status drifted: #{id}" unless report.fetch("status") == "pass"
    raise "typed context-plane schema drifted: #{id}" unless report.fetch("schema_version") ==
      expected_context_plane_schema(id)
    raise "typed context-plane envelope side effects opened: #{id}" unless
      context_plane_false_hash?(report.fetch("side_effects"))
    forbidden = context_plane_forbidden_true_paths(report)
    raise "typed context-plane authority/effect opened: #{id}: #{forbidden.first}" unless
      forbidden.empty?
    unless report.fetch("forward_schema_delta") == expected_context_plane_forward_delta
      raise "typed context-plane forward schema delta drifted: #{id}"
    end
    [id, report]
  end
end

def context_plane_parity_oracle(spec)
  pairs = spec.fetch("pairs").select do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "context-plane parity inventory drifted" unless pairs.length ==
    CONTEXT_PLANE_PAIR_IDS.length
  captured_count = pairs.count do |pair|
    pair.fetch("template") == "captured_shell_compat_v1"
  end
  typed_count = pairs.count do |pair|
    pair.fetch("template") == "typed_rust_report_v1"
  end
  unless [
    [0, CONTEXT_PLANE_PAIR_IDS.length],
    [CONTEXT_PLANE_PAIR_IDS.length, 0]
  ].include?([captured_count, typed_count])
    raise "context-plane parity requires all eight pairs captured or typed"
  end

  typed_reports = load_context_plane_typed_reports
  if captured_count.zero?
    return {
      "status" => "binding_bound_post_migration",
      "baseline_reports_executed" => false,
      "report_count" => CONTEXT_PLANE_PAIR_IDS.length,
      "legacy_line_count" => CONTEXT_PLANE_LEGACY_FIELD_COUNTS.values.sum,
      "business_field_order_mismatch_count" => 0,
      "business_missing_field_count" => 0,
      "business_extra_field_count" => 0,
      "business_value_mismatch_count" => 0,
      "business_field_mismatch_count" => 0,
      "source_topology_mismatch_count" => 0,
      "source_line_count_mismatch_count" => 0,
      "source_digest_mismatch_count" => 0,
      "generation_sequence_mismatch_count" => 0,
      "forward_added_activation_target_count" => 1,
      "forward_removed_activation_target_count" => 0,
      "legacy_provider_v2_candidate_count" => 1,
      "forward_provider_v2_candidate_count" => 4,
      "captured_snapshots_preserved" => false
    }
  end

  captured_outputs = {}
  captured_fields = {}
  legacy_line_count = 0
  CONTEXT_PLANE_PAIR_IDS.each do |id|
    output = run_command(PAIR_RUNNER, "report", id)
    fields, line_count = parse_context_plane_line_protocol(output, id)
    expected_line_count = CONTEXT_PLANE_LEGACY_FIELD_COUNTS.fetch(id)
    raise "context-plane captured line count drifted for #{id}" unless line_count ==
      expected_line_count
    captured_outputs[id] = output
    captured_fields[id] = fields
    legacy_line_count += line_count
  end
  tamper_output = run_command(CONTEXT_PLANE_TAMPER_REPORT)
  raise "context-plane tamper receipt line count drifted" unless tamper_output.lines.length == 16

  business_missing = []
  business_extra = []
  business_values = []
  business_order = []
  source_topology = []
  source_lines = []
  source_digests = []
  generation_sequences = []

  CONTEXT_PLANE_PAIR_IDS.each do |id|
    report = typed_reports.fetch(id)
    legacy = report.fetch("legacy_business_fields")
    raise "typed context-plane legacy fields are not an object: #{id}" unless legacy.is_a?(Hash)
    scalar_legacy = legacy.to_h do |key, value|
      [key, context_plane_scalar_string(value, "#{id}.legacy_business_fields.#{key}")]
    end
    old_fields = captured_fields.fetch(id)
    business_order << id unless report.fetch("legacy_business_field_order") == old_fields.keys
    (old_fields.keys - scalar_legacy.keys).each { |key| business_missing << "#{id}:#{key}" }
    (scalar_legacy.keys - old_fields.keys).each { |key| business_extra << "#{id}:#{key}" }
    (old_fields.keys & scalar_legacy.keys).each do |key|
      next if old_fields.fetch(key) == scalar_legacy.fetch(key)
      business_values << "#{id}:#{key}"
    end

    expected_generation, expected_sequence = CONTEXT_PLANE_GENERATION_SEQUENCES.fetch(id)
    unless report.fetch("generation") == expected_generation &&
        report.fetch("sequence") == expected_sequence
      generation_sequences << "#{id}:report"
    end
    observed_sources = report.fetch("sources")
    expected_sources = CONTEXT_PLANE_SOURCE_TOPOLOGY.fetch(id)
    unless observed_sources.is_a?(Array) && observed_sources.length == expected_sources.length
      source_topology << "#{id}:source-count"
      next
    end
    expected_sources.each_with_index do |(source_id, generation, sequence, mode), index|
      source = observed_sources.fetch(index)
      unless source.is_a?(Hash) && source["report_id"] == source_id
        source_topology << "#{id}:source-#{index}"
        next
      end
      unless source["generation"] == generation && source["sequence"] == sequence
        generation_sequences << "#{id}:source-#{index}"
      end
      if mode == :shape_only
        unless source["line_count"].is_a?(Integer) && source["line_count"].positive? &&
            source["sha256"].is_a?(String) && source["sha256"].match?(/\A[0-9a-f]{64}\z/)
          source_topology << "#{id}:source-#{index}-shape"
        end
        next
      end
      source_output = mode == :tamper ? tamper_output : captured_outputs.fetch(source_id)
      source_lines << "#{id}:source-#{index}" unless source["line_count"] ==
        source_output.lines.length
      source_digests << "#{id}:source-#{index}" unless source["sha256"] ==
        Digest::SHA256.hexdigest(source_output)
    end
  end

  business_mismatch_count = business_missing.length + business_extra.length +
    business_values.length
  mismatch_groups = {
    "business_order" => [business_order.length, business_order.first],
    "business" => [business_mismatch_count, business_missing.first || business_extra.first ||
      business_values.first],
    "source_topology" => [source_topology.length, source_topology.first],
    "source_line_count" => [source_lines.length, source_lines.first],
    "source_digest" => [source_digests.length, source_digests.first],
    "generation_sequence" => [generation_sequences.length, generation_sequences.first]
  }
  first_failure = mismatch_groups.find { |_name, (count, _first)| count.positive? }
  if first_failure
    name, (count, first) = first_failure
    raise "context-plane parity #{name} mismatch count #{count}; first=#{first}"
  end

  {
    "status" => "executed_exact_head_captured_vs_typed",
    "baseline_reports_executed" => true,
    "report_count" => CONTEXT_PLANE_PAIR_IDS.length,
    "legacy_line_count" => legacy_line_count,
    "business_field_order_mismatch_count" => business_order.length,
    "business_missing_field_count" => business_missing.length,
    "business_extra_field_count" => business_extra.length,
    "business_value_mismatch_count" => business_values.length,
    "business_field_mismatch_count" => business_mismatch_count,
    "source_topology_mismatch_count" => source_topology.length,
    "source_line_count_mismatch_count" => source_lines.length,
    "source_digest_mismatch_count" => source_digests.length,
    "generation_sequence_mismatch_count" => generation_sequences.length,
    "forward_added_activation_target_count" => 1,
    "forward_removed_activation_target_count" => 0,
    "legacy_provider_v2_candidate_count" => 1,
    "forward_provider_v2_candidate_count" => 4,
    "captured_snapshots_preserved" => false
  }
end

def plugin_semantic_mapping_mismatches(id, legacy, plan)
  mismatches = []
  require_equal = lambda do |name, left, right|
    mismatches << "#{id}:#{name}" unless left == right
  end
  case id
  when "hepta-systems-plugin-contribution-point-abi"
    entries = plan.fetch("entries")
    require_equal.call("contribution_point_count", legacy.fetch("contribution_point_count"),
      plan.fetch("abi_entry_count"))
    require_equal.call("contribution_point_kinds", legacy.fetch("contribution_point_kinds"),
      entries.map { |entry| entry.fetch("kind") })
    require_equal.call("manifest_path_supported_kinds",
      legacy.fetch("manifest_path_supported_kinds"), entries.select do |entry|
        entry.fetch("manifest_path_supported")
      end.map { |entry| entry.fetch("kind") })
    require_equal.call("future_bridge_kinds", legacy.fetch("future_bridge_kinds"),
      entries.select { |entry| entry.fetch("future_bridge_required") }.map do |entry|
        entry.fetch("kind")
      end)
  when "hepta-systems-plugin-contribution-point-loader-binding"
    entries = plan.fetch("entries")
    require_equal.call("loader_bound_kinds", legacy.fetch("loader_bound_kinds"),
      entries.select { |entry| entry.fetch("manifest_loader_contract_ready") }.map do |entry|
        entry.fetch("kind")
      end)
    require_equal.call("declared_manifest_fields", legacy.fetch("declared_manifest_fields"),
      entries.select { |entry| entry.fetch("current_fixture_declared") }.map do |entry|
        entry.fetch("manifest_field")
      end)
    require_equal.call("future_bridge_blocked_kinds",
      legacy.fetch("future_bridge_blocked_kinds"), entries.select do |entry|
        entry.fetch("future_bridge_blocked")
      end.map { |entry| entry.fetch("kind") })
  when "hepta-systems-plugin-lifecycle-state-machine"
    normalized_phases = plan.fetch("phases").map do |phase|
      phase.reject { |key, _value| key == "state" }
    end
    require_equal.call("phases_without_typed_state_extension", legacy.fetch("phases"),
      normalized_phases)
  when "hepta-systems-plugin-tool-contribution-inventory-preview"
    entries = plan.fetch("entries")
    field_map = {
      "candidate_tool_ids" => "candidate_tool_id",
      "candidate_names" => "candidate_name",
      "candidate_kinds" => "contribution_kind",
      "candidate_inventory_sources" => "candidate_inventory_source",
      "candidate_loader_output_fields" => "loader_output_field",
      "candidate_side_effect_levels" => "side_effect_level",
      "candidate_approval_kinds" => "approval_kind",
      "candidate_auth_required" => "auth_required",
      "candidate_timeout_ms" => "timeout_ms",
      "candidate_ledger_required" => "ledger_required",
      "candidate_guard_routes" => "guard_route"
    }
    field_map.each do |legacy_field, typed_field|
      require_equal.call(legacy_field, legacy.fetch(legacy_field),
        entries.map { |entry| entry.fetch(typed_field) })
    end
    require_equal.call("tool_contribution_schema_complete_count",
      legacy.fetch("tool_contribution_schema_complete_count"), entries.count do |entry|
        entry.fetch("has_input_schema") && entry.fetch("has_output_schema")
      end)
    require_equal.call("tool_contribution_ledger_required_count",
      legacy.fetch("tool_contribution_ledger_required_count"), entries.count do |entry|
        entry.fetch("ledger_required")
      end)
    require_equal.call("tool_contribution_approval_required_count",
      legacy.fetch("tool_contribution_approval_required_count"), entries.count do |entry|
        %w[on_use install].include?(entry.fetch("approval_kind"))
      end)
  when "hepta-systems-plugin-tool-manifest-schema-cutover-preflight"
    require_equal.call("retired_fixture_source_ready",
      legacy.fetch("source_manifest_fixture_declarations_ready"), true)
    require_equal.call("retired_bridge_source_ready",
      legacy.fetch("source_preflight_adapter_bridge_ready"), true)
    require_equal.call("manifest_input_candidate_count",
      plan.fetch("planned_candidate_count"), plan.fetch("entries").length)
  else
    mismatches << "#{id}:unknown-mapping"
  end
  mismatches
end

def plugin_parity_oracle(spec)
  plugin_pairs = spec.fetch("pairs").select do |pair|
    PLUGIN_TYPED_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "plugin typed pair inventory drifted" unless plugin_pairs.length ==
    PLUGIN_TYPED_PAIR_IDS.length
  captured_count = plugin_pairs.count do |pair|
    pair.fetch("template") == "captured_shell_compat_v1"
  end
  typed_count = plugin_pairs.count do |pair|
    pair.fetch("template") == "typed_rust_report_v1"
  end
  unless [[captured_count, typed_count], [0, PLUGIN_TYPED_PAIR_IDS.length],
          [PLUGIN_TYPED_PAIR_IDS.length, 0]].include?([captured_count, typed_count])
    raise "plugin typed pair modes are partially migrated"
  end
  result = {
    "status" => "binding_bound_post_migration",
    "baseline_reports_executed" => false,
    "report_count" => PLUGIN_TYPED_PAIR_IDS.length,
    "legacy_top_level_field_count" => PLUGIN_LEGACY_TOP_LEVEL_FIELD_COUNTS.values.sum,
    "exact_shared_business_field_count" =>
      PLUGIN_EXACT_SHARED_BUSINESS_FIELD_COUNTS.values.sum,
    "business_field_mismatch_count" => 0,
    "semantic_mapping_mismatch_count" => 0,
    "source_binding_mismatch_count" => 0,
    "authority_or_side_effect_mismatch_count" => 0,
    "captured_snapshots_preserved" => false
  }
  return result if captured_count.zero?

  business = []
  mappings = []
  source_bindings = []
  authority = []
  PLUGIN_TYPED_PAIR_IDS.each do |id|
    legacy = JSON.parse(run_command(PAIR_RUNNER, "report", id))
    unless legacy.length == PLUGIN_LEGACY_TOP_LEVEL_FIELD_COUNTS.fetch(id)
      raise "plugin legacy top-level field count drifted for #{id}: #{legacy.length}"
    end
    typed = JSON.parse(run_command(REPORT_RUNNER, id))
    payload = typed.fetch("payload")
    plan = payload.fetch("plan")
    normalized = PLUGIN_NORMALIZED_SHARED_FIELDS.fetch(id)
    exact_shared = (legacy.keys & plan.keys) - normalized
    unless exact_shared.length == PLUGIN_EXACT_SHARED_BUSINESS_FIELD_COUNTS.fetch(id)
      raise "plugin exact shared field inventory drifted for #{id}: #{exact_shared.length}"
    end
    exact_shared.each do |field|
      business << "#{id}:#{field}" unless legacy.fetch(field) == plan.fetch(field)
    end
    mappings.concat(plugin_semantic_mapping_mismatches(id, legacy, plan))
    sources = typed.fetch("sources")
    sources_valid = sources.is_a?(Array) && !sources.empty? && sources.all? do |source|
      source.is_a?(Hash) && source.fetch("line_count").is_a?(Integer) &&
        source.fetch("line_count").positive? &&
        source.fetch("sha256").is_a?(String) &&
        source.fetch("sha256").match?(/\A[0-9a-f]{64}\z/) &&
        source.fetch("generation").is_a?(Integer) &&
        source.fetch("sequence").is_a?(Integer)
    end
    source_bindings << id unless sources_valid
    legacy_side_effects_closed = legacy.fetch("side_effects").is_a?(Hash) &&
      context_plane_false_hash?(legacy.fetch("side_effects"))
    unless typed.fetch("production_authority_granted") == false &&
        typed.fetch("write_authority_granted") == false &&
        typed.fetch("ready_for_live_execution") == false &&
        typed.fetch("mutation_enabled") == false &&
        context_plane_false_hash?(typed.fetch("side_effects")) &&
        legacy_side_effects_closed
      authority << id
    end
  end
  first = business.first || mappings.first || source_bindings.first || authority.first
  if business.any? || mappings.any? || source_bindings.any? || authority.any?
    raise "plugin parity mismatch; business=#{business.length} mapping=#{mappings.length} source=#{source_bindings.length} authority=#{authority.length}; first=#{first}"
  end
  result.merge(
    "status" => "executed_exact_head_captured_vs_typed",
    "baseline_reports_executed" => true,
    "business_field_mismatch_count" => business.length,
    "semantic_mapping_mismatch_count" => mappings.length,
    "source_binding_mismatch_count" => source_bindings.length,
    "authority_or_side_effect_mismatch_count" => authority.length
  )
end

def verify_runtime_bindings(ids)
  output, error, status = Open3.capture3(REPORT_RUNNER, "--list")
  raise "cannot list typed reports: #{error}" unless status.success?
  available = output.lines(chomp: true).to_set
  missing = ids.reject { |id| available.include?(id) }
  raise "missing typed runtime bindings: #{missing.join(',')}" unless missing.empty?
end

def canonical_sources
  HeptaReadableTokenSource.read(
    root: BUNDLE_ROOT,
    artifact_schema: SCHEMA,
    domain: DOMAIN,
    name_validator: lambda { |name|
      name.match?(%r{\Ascripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(?:gate|report)\z})
    },
    strict_metadata: true
  ).first.to_h { |entry| [entry.name, entry.source] }
end

def transform_source(source, ids)
  transformed = ids.reduce(source) do |current, id|
    current.gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate",
      "scripts/#{id}-gate.sh"
    ).gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report",
      "scripts/#{id}-report.sh"
    )
  end
  transformed = CONTROLLED_LIVE_V2_PAIR_IDS.reduce(transformed) do |current, id|
    current.gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}-v2.gate",
      "scripts/#{id}-gate.sh"
    ).gsub(
      "scripts/lib/hepta-gate-pair-compat-v1/#{id}-v2.report",
      "scripts/#{id}-report.sh"
    )
  end
  transformed
    .gsub(EXPORTED_TYPED_INTERNAL_SOURCE_ASSIGNMENT, TYPED_INTERNAL_SOURCE_ASSIGNMENT)
    .gsub(RETIRED_SOURCE_ASSIGNMENT, TYPED_INTERNAL_SOURCE_ASSIGNMENT)
end

def transform_stale_workgraph_source_probes(name, source)
  regular_probe_gates = STALE_WORKGRAPH_REGULAR_PROBE_GATES[name]
  terminal_probe_module = STALE_WORKGRAPH_TERMINAL_PROBE_MODULES[name]
  return source unless regular_probe_gates || terminal_probe_module

  bool_helper = <<~'SHELL'.strip
    bool_for() {
      if "$@"; then
        printf 'true\n'
      else
        printf 'false\n'
      fi
    }
  SHELL
  transformed = source.dup
  if regular_probe_gates
    anchor_helper = <<~SHELL.strip
      typed_workgraph_family_anchor_report="\$(
        "\$ROOT/scripts/hepta-typed-compat-report" "#{STALE_WORKGRAPH_TYPED_ANCHOR_ID}" | jq -ce \\
          --arg gate "#{STALE_WORKGRAPH_TYPED_ANCHOR_GATE}" \\
          --arg schema "#{STALE_WORKGRAPH_TYPED_ANCHOR_SCHEMA}" \\
          --arg ready "#{STALE_WORKGRAPH_TYPED_ANCHOR_READY_FIELD}" '
          if .runtime == "hepta" and .product == "Hepta" and .status == "ready"
            and .gate == \$gate and .schema_version == \$schema and .[\$ready] == true
            and .ready_for_operator_acceptance == false
            and .ready_for_live_persistence == false
            and (.required_prior_gates | type == "array" and length == 42
              and (unique | length) == 42 and all(type == "string"))
            and .durable_identity_evidence.schema_version == "work_graph_durable_identity_preview_v1"
            and .durable_identity_evidence.required_prior_gate == "hepta_work_graph_durable_identity_preview_gate"
            and .durable_identity_evidence.durable_field_count == 7
            and .durable_identity_evidence.preview_binding_count == 5
            and .durable_identity_evidence.invariant_count == 7
            and .durable_identity_evidence.currently_satisfied == false
            and (.side_effects | type == "object" and (to_entries | all(.value == false)))
          then .
          else error("typed WorkGraph family anchor failed compatibility integrity")
          end'
      )"

      typed_workgraph_gate_backed() {
        local expected_gate="\$1"
        jq -e --arg expected_gate "\$expected_gate" \\
          '.required_prior_gates | index(\$expected_gate) != null' \\
          <<<"\$typed_workgraph_family_anchor_report" >/dev/null
      }
    SHELL
    unless transformed.include?("typed_workgraph_family_anchor_report=")
      raise "missing or duplicate bool helper in #{name}" unless transformed.scan(bool_helper).length == 1
      transformed.sub!(bool_helper, "#{bool_helper}\n\n#{anchor_helper}")
    end

    generic_probe =
      "bool_for path_exists codex-rs/hepta-runtime/src/runtime_kernel/exports_workgraph.rs"
    legacy_probe = %r{bool_for path_exists codex-rs/hepta-runtime/src/(work_graph_[a-z0-9_]+)\.rs}
    generic_count = transformed.scan(generic_probe).length
    legacy_modules = transformed.scan(legacy_probe).flatten
    semantic_probe = /bool_for typed_workgraph_gate_backed ([a-z0-9_]+)/
    semantic_gates = transformed.scan(semantic_probe).flatten
    if generic_count == regular_probe_gates.length && legacy_modules.empty? && semantic_gates.empty?
      index = 0
      transformed.gsub!(generic_probe) do
        gate = regular_probe_gates.fetch(index)
        index += 1
        "bool_for typed_workgraph_gate_backed #{gate}"
      end
    elsif legacy_modules.length == regular_probe_gates.length && generic_count.zero? && semantic_gates.empty?
      legacy_gates = legacy_modules.map do |module_name|
        module_name == "work_graph_task_result_contract" ?
          "hepta_work_graph_task_result_contract_preview_gate" : "hepta_#{module_name}_gate"
      end
      raise "legacy WorkGraph probe plan drifted for #{name}" unless legacy_gates == regular_probe_gates
      transformed.gsub!(legacy_probe) do
        gate = legacy_gates.shift
        "bool_for typed_workgraph_gate_backed #{gate}"
      end
    elsif generic_count.zero? && legacy_modules.empty? && semantic_gates == regular_probe_gates
      # Already transformed; retain exact idempotent source.
    else
      raise "mixed or incomplete WorkGraph source probes for #{name}"
    end
    semantic_gates = transformed.scan(semantic_probe).flatten
    raise "typed WorkGraph gate membership plan drifted for #{name}" unless
      semantic_gates == regular_probe_gates
  else
    predecessor_helper = <<~'SHELL'.strip
      typed_prior_compatibility_backed() {
        jq -e --arg expected_gate "$prior_compatibility_gate" \
          'index($expected_gate) != null' \
          <<<"$required_prior_gates" >/dev/null
      }
    SHELL
    unless transformed.include?("typed_prior_compatibility_backed()")
      raise "missing or duplicate bool helper in #{name}" unless transformed.scan(bool_helper).length == 1
      transformed.sub!(bool_helper, "#{bool_helper}\n\n#{predecessor_helper}")
    end
    legacy_assignment =
      "rust_module=\"codex-rs/hepta-runtime/src/#{terminal_probe_module}.rs\"\n"
    generic_assignment =
      "rust_module=\"codex-rs/hepta-runtime/src/runtime_kernel/exports_workgraph.rs\"\n"
    semantic_call = 'rust_module_present="$(bool_for typed_prior_compatibility_backed)"'
    legacy_call = 'rust_module_present="$(bool_for path_exists "$rust_module")"'
    if transformed.include?(legacy_assignment) ^ transformed.include?(generic_assignment)
      transformed.sub!(legacy_assignment, "") || transformed.sub!(generic_assignment, "")
      raise "missing terminal WorkGraph module probe for #{name}" unless
        transformed.sub!(legacy_call, semantic_call)
    elsif transformed.include?(semantic_call) &&
        !transformed.include?(legacy_assignment) && !transformed.include?(generic_assignment)
      # Already transformed; retain exact idempotent source.
    else
      raise "mixed or incomplete terminal WorkGraph source probe for #{name}"
    end
    raise "typed predecessor compatibility probe drifted for #{name}" unless
      transformed.scan("bool_for typed_prior_compatibility_backed").length == 1
  end
  raise "generic WorkGraph exports probe survived for #{name}" if
    transformed.include?("runtime_kernel/exports_workgraph.rs")
  transformed
end

def transform_stale_workgraph_family_source(name, source)
  return source unless STALE_WORKGRAPH_REGULAR_PROBE_GATES.key?(name) ||
    STALE_WORKGRAPH_TERMINAL_PROBE_MODULES.key?(name)

  durable_capture = <<~'SHELL'.strip
    durable_identity_report="$(
      capture_json_report \
        "hepta-work-graph-durable-identity-preview-report" \
        "$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-work-graph-durable-identity-preview.report"
    )"
  SHELL
  typed_durable_capture = <<~'SHELL'.strip
    current_workgraph_inventory_report="$(
      capture_json_report \
        "hepta-work-graph-current-state-inventory-report" \
        "$ROOT/scripts/hepta-typed-compat-report" \
        "hepta-systems-work-graph-current-state-inventory"
    )"
    durable_identity_report="$(
      jq -c '
        if .gate == "hepta_work_graph_current_state_inventory_gate"
          and .schema_version == "work_graph_current_state_inventory_v1"
          and .ready_for_work_graph_contract_preview == true
          and .ready_for_scheduler_cutover == false
          and ([.side_effects[]] | all(. == false))
        then {
          schema_version: "work_graph_durable_identity_preview_v1",
          durable_field_count: 7,
          preview_binding_count: 5,
          invariant_count: 7,
          compatibility_successor_gate: .gate
        }
        else error("typed current WorkGraph inventory failed durable identity compatibility integrity")
        end
      ' <<<"$current_workgraph_inventory_report"
    )"
  SHELL
  transformed = source.gsub(durable_capture, typed_durable_capture)
  prior_successors = {
    "hepta-systems-work-graph-terminal-receipt-retention-readback-ack-terminal-decision-receipt-acknowledgement-preview" => {
      id: "hepta-systems-work-graph-persistence-acceptance-effect-application-denial-receipt-retention-expiry-readback-acknowledgement-terminal-decision-non-promotion-receipt-acknowledgement-preview",
      gate: "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_acknowledgement_preview_gate",
      schema: "work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_acknowledgement_preview_v1",
      ready_field: "ready_for_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_acknowledgement_replay_idempotency_preview",
      compatibility_gate: "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_acknowledgement_preview_gate"
    },
    "hepta-systems-work-graph-terminal-receipt-retention-readback-ack-terminal-decision-receipt-retention-readback-ack-terminal-decision-receipt-acknowledgement-preview" => {
      id: "hepta-systems-work-graph-persistence-acceptance-effect-application-denial-receipt-retention-expiry-readback-acknowledgement-terminal-decision-non-promotion-receipt-retention-expiry-readback-acknowledgement-terminal-decision-non-promotion-preview",
      gate: "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview_gate",
      schema: "work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_preview_v1",
      ready_field: "ready_for_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_preview",
      compatibility_gate: "hepta_work_graph_persistence_acceptance_effect_application_denial_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_retention_expiry_readback_acknowledgement_terminal_decision_non_promotion_receipt_acknowledgement_preview_gate"
    }
  }
  typed_prior_capture = <<~'SHELL'.strip
    "$ROOT/$prior_report_script" "$prior_report_id" | jq -ce \
      --arg typed_gate "$prior_typed_gate" \
      --arg typed_schema "$prior_typed_schema" \
      --arg ready_field "$prior_ready_field" \
      --arg compatibility_gate "$prior_compatibility_gate" '
        if .runtime == "hepta"
          and .product == "Hepta"
          and .status == "ready"
          and .gate == $typed_gate
          and .schema_version == $typed_schema
          and .[$ready_field] == true
          and .ready_for_live_persistence == false
          and .ready_for_operator_acceptance == false
          and (.required_prior_gates | type == "array")
          and (.required_prior_gates | all(type == "string"))
          and (.side_effects | type == "object")
          and ([.side_effects[]] | all(. == false))
        then
          (.required_prior_gates | map(select(. != "hepta_work_graph_durable_identity_preview_gate"))) +
            [$compatibility_gate, "hepta_work_graph_durable_identity_preview_gate"]
        else
          error("typed WorkGraph successor failed compatibility integrity")
        end
      '
  SHELL
  legacy_prior_capture = <<~'SHELL'.strip
    "$ROOT/$prior_report_script" | jq -c '(.required_prior_gates | map(select(. != "hepta_work_graph_durable_identity_preview_gate"))) + [.gate, "hepta_work_graph_durable_identity_preview_gate"]'
  SHELL
  migrated_prior_capture = <<~'SHELL'.strip
    "$ROOT/$prior_report_script" "$prior_report_id" | jq -c '(.required_prior_gates | map(select(. != "hepta_work_graph_durable_identity_preview_gate"))) + [.gate, "hepta_work_graph_durable_identity_preview_gate"]'
  SHELL
  prior_successors.each do |legacy_id, successor|
    legacy_assignment =
      "prior_report_script=\"scripts/lib/hepta-gate-pair-compat-v1/#{legacy_id}.report\"\n" \
      "prior_gate_script=\"scripts/lib/hepta-gate-pair-compat-v1/#{legacy_id}.gate\""
    migrated_assignment =
      "prior_report_script=\"scripts/hepta-typed-compat-report\"\n" \
      "prior_report_id=\"#{successor.fetch(:id)}\"\n" \
      "prior_gate_script=\"scripts/hepta-gate-pair-runner\""
    typed_assignment =
      "prior_report_script=\"scripts/hepta-typed-compat-report\"\n" \
      "prior_report_id=\"#{successor.fetch(:id)}\"\n" \
      "prior_typed_gate=\"#{successor.fetch(:gate)}\"\n" \
      "prior_typed_schema=\"#{successor.fetch(:schema)}\"\n" \
      "prior_ready_field=\"#{successor.fetch(:ready_field)}\"\n" \
      "prior_compatibility_gate=\"#{successor.fetch(:compatibility_gate)}\"\n" \
      "prior_gate_script=\"scripts/hepta-gate-pair-runner\""
    transformed = transformed
      .gsub(legacy_assignment, typed_assignment)
      .gsub(migrated_assignment, typed_assignment)
      .gsub(legacy_prior_capture, typed_prior_capture)
      .gsub(migrated_prior_capture, typed_prior_capture)
  end
  STALE_WORKGRAPH_RETIRED_PAIR_IDS.each do |id|
    transformed = transformed
      .gsub(
        "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report",
        "scripts/hepta-typed-compat-report"
      )
      .gsub(
        "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate",
        "scripts/hepta-gate-pair-runner"
      )
  end
  transform_stale_workgraph_source_probes(name, transformed)
end

def rewrite_spec(spec, sources, ids)
  id_set = ids.to_set
  runner_sha = Digest::SHA256.file(REPORT_RUNNER).hexdigest
  registry_sha = Digest::SHA256.file(BINDINGS_PATH).hexdigest
  source_sha = Digest::SHA256.file(REPORT_SOURCE).hexdigest
  cli_source_sha = Digest::SHA256.file(REPORT_CLI_SOURCE).hexdigest
  retired = spec.fetch("pairs").select { |pair| pair.fetch("id") == RETIRED_PAIR_ID }
  raise "retired dirty-worktree pair count drifted" unless retired.length <= 1
  if retired.length == 1
    raise "retired dirty-worktree pair is not captured" unless retired.first.fetch("template") ==
      "captured_shell_compat_v1"
  end
  controlled = spec.fetch("pairs").select do |pair|
    CONTROLLED_LIVE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "controlled-live typed pair inventory drifted" unless controlled.length == 17
  raise "controlled-live typed pair mode drifted" unless controlled.all? do |pair|
    %w[captured_shell_compat_v1 typed_rust_report_v1].include?(pair.fetch("template"))
  end
  context_plane = spec.fetch("pairs").select do |pair|
    CONTEXT_PLANE_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "context-plane typed pair inventory drifted" unless context_plane.length == 8
  raise "context-plane typed pair mode drifted" unless context_plane.all? do |pair|
    %w[captured_shell_compat_v1 typed_rust_report_v1].include?(pair.fetch("template"))
  end
  plugin_typed = spec.fetch("pairs").select do |pair|
    PLUGIN_TYPED_PAIR_IDS.include?(pair.fetch("id"))
  end
  raise "plugin retained pair inventory drifted" unless plugin_typed.length ==
    PLUGIN_TYPED_PAIR_IDS.length
  raise "plugin retained pair mode drifted" unless plugin_typed.all? do |pair|
    %w[captured_shell_compat_v1 typed_rust_report_v1].include?(pair.fetch("template"))
  end
  plugin_retired = spec.fetch("pairs").select do |pair|
    PLUGIN_RETIRED_PAIR_IDS.include?(pair.fetch("id"))
  end
  unless [0, PLUGIN_RETIRED_PAIR_IDS.length].include?(plugin_retired.length) &&
      plugin_retired.all? { |pair| pair.fetch("template") == "captured_shell_compat_v1" }
    raise "plugin retired pair inventory drifted"
  end
  current_reality = spec.fetch("pairs").select do |pair|
    pair.fetch("id") == CURRENT_REALITY_PAIR_ID
  end
  raise "current-reality typed pair inventory drifted" unless current_reality.length == 1
  raise "current-reality typed pair mode drifted" unless %w[
    captured_shell_compat_v1 typed_rust_report_v1
  ].include?(current_reality.first.fetch("template"))
  stale_workgraph = spec.fetch("pairs").select do |pair|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.include?(pair.fetch("id"))
  end
  unless [0, STALE_WORKGRAPH_RETIRED_PAIR_IDS.length].include?(stale_workgraph.length) &&
      stale_workgraph.all? { |pair| pair.fetch("template") == "captured_shell_compat_v1" }
    raise "stale WorkGraph retired pair inventory drifted"
  end
  retired_ids = (
    [RETIRED_PAIR_ID] + PLUGIN_RETIRED_PAIR_IDS + STALE_WORKGRAPH_RETIRED_PAIR_IDS
  ).to_set
  pairs = spec.fetch("pairs").reject do |pair|
    retired_ids.include?(pair.fetch("id"))
  end.map do |pair|
    id = pair.fetch("id")
    if id_set.include?(id)
      raise "typed conversion source is not captured: #{id}" unless [
        "captured_shell_compat_v1", "typed_rust_report_v1"
      ].include?(pair.fetch("template"))
      pair.reject do |key, _value|
        %w[gate_implementation gate_implementation_sha256 report_implementation
           report_implementation_sha256 gate_source_sha256 report_source_sha256].include?(key)
      end.merge(
        "template" => "typed_rust_report_v1",
        "source_report" => "codex-rs/hepta-runtime/src/typed_compat_report.rs",
        "typed_report_runner" => "scripts/hepta-typed-compat-report",
        "typed_report_runner_sha256" => runner_sha,
        "typed_report_registry" => "scripts/hepta-gate-typed-report-bindings-v2.json",
        "typed_report_registry_sha256" => registry_sha,
        "typed_report_source_sha256" => source_sha,
        "typed_report_cli_source" => "codex-rs/hepta-runtime/src/bin/hepta-compat-report.rs",
        "typed_report_cli_source_sha256" => cli_source_sha,
        "side_effect_boundary" => "read-only #{pair.fetch('receipt_state')} typed Rust compatibility report; never mutates, publishes, sends, installs, or restarts",
        "next_migration_step" => "typed_rust_report_semantics_preserved_without_shell_payload",
        "missing_source_message" => "missing typed Rust compatibility report source",
        "missing_report_message" => "missing typed Rust compatibility report runner",
        "pass_message" => "hepta-gate-pair-runner: PASS: typed Rust compatibility gate #{id}"
      )
    elsif pair.fetch("template") == "captured_shell_compat_v1"
      gate = transform_source(sources.fetch(pair.fetch("gate_implementation")), ids)
      report = transform_source(sources.fetch(pair.fetch("report_implementation")), ids)
      pair.merge(
        "gate_implementation_sha256" => Digest::SHA256.hexdigest(gate),
        "report_implementation_sha256" => Digest::SHA256.hexdigest(report)
      )
    else
      pair
    end
  end.sort_by { |pair| pair.fetch("id") }
  captured = pairs.count { |pair| pair.fetch("template") == "captured_shell_compat_v1" }
  legacy = pairs.count { |pair| pair.fetch("template") == "legacy_workgraph_projection_v1" }
  declarative = pairs.length - captured - legacy
  raise "typed migration pair count drifted" unless pairs.length == TARGET_PAIR_COUNT
  raise "typed migration captured count drifted" unless captured == TARGET_CAPTURED_COUNT
  raise "typed migration legacy count drifted" unless legacy.zero?
  raise "typed migration declarative count drifted" unless declarative == TARGET_DECLARATIVE_COUNT
  supplemental_paths = spec.fetch("supplemental_payloads", []).map { |payload| payload.fetch("path") }
  context_plane_supplemental = supplemental_paths.select do |path|
    CONTEXT_PLANE_PAIR_IDS.any? do |id|
      path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate" ||
        path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report"
    end
  end
  raise "context-plane typed migration intersects supplemental payloads" unless context_plane_supplemental.empty?
  plugin_supplemental = supplemental_paths.select do |payload_path|
    PLUGIN_PAIR_IDS.any? do |id|
      payload_path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.gate" ||
        payload_path == "scripts/lib/hepta-gate-pair-compat-v1/#{id}.report"
    end
  end
  raise "plugin typed migration intersects supplemental payloads" unless plugin_supplemental.empty?
  current_reality_supplemental_count = (
    supplemental_paths & CURRENT_REALITY_SUPPLEMENTAL_PAYLOAD_PATHS
  ).length
  raise "current-reality supplemental payload inventory drifted" unless [0, 2].include?(
    current_reality_supplemental_count
  )
  retired_controlled_supplemental_count = (
    supplemental_paths & CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS
  ).length
  raise "controlled-live supplemental payload inventory drifted" unless [0, 12].include?(
    retired_controlled_supplemental_count
  )
  supplemental = spec.fetch("supplemental_payloads", []).reject do |payload|
    CONTROLLED_LIVE_SUPPLEMENTAL_PAYLOAD_PATHS.include?(payload.fetch("path")) ||
      CURRENT_REALITY_SUPPLEMENTAL_PAYLOAD_PATHS.include?(payload.fetch("path"))
  end.map do |payload|
    raise "retired dirty-worktree payload preserved as supplemental" if [
      RETIRED_GATE_PATH, RETIRED_REPORT_PATH
    ].include?(payload.fetch("path"))
    source = transform_source(sources.fetch(payload.fetch("path")), ids)
    payload.merge("sha256" => Digest::SHA256.hexdigest(source))
  end
  spec.merge("pairs" => pairs, "supplemental_payloads" => supplemental)
end

def rewrite_bundle(spec, sources, ids)
  registered = spec.fetch("pairs").flat_map do |pair|
    [pair["gate_implementation"], pair["report_implementation"]].compact
  end + spec.fetch("supplemental_payloads", []).map { |payload| payload.fetch("path") }
  entries = registered.uniq.sort.map do |path|
    HeptaNormalizedTokenBundle::Entry.new(path, transform_source(sources.fetch(path), ids))
  end
  bundle = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  HeptaReadableTokenSource.write(
    root: BUNDLE_ROOT,
    bundle: bundle,
    artifact_schema: SCHEMA,
    domain: DOMAIN,
    artifact_file: "payloads.bundle.gz",
    atomic_write: method(:atomic_write),
    source_chunk_lines: 8
  )
end

def semantic_json_cost(value)
  case value
  when Hash
    1 + value.sum { |key, child| 1 + (key.bytesize + 79) / 80 + semantic_json_cost(child) }
  when Array
    1 + value.sum { |child| semantic_json_cost(child) }
  when String
    1 + (value.bytesize + 79) / 80 + value.count("\n")
  else
    1
  end
end

def rewrite_family_bundle(ids)
  baseline_entries = HeptaReadableTokenSource.read(
    root: FAMILY_ROOT,
    artifact_schema: FAMILY_SCHEMA,
    domain: FAMILY_DOMAIN,
    name_validator: ->(name) { name.match?(/\A[a-z0-9-]+\.(?:gate|report)\z/) },
    strict_metadata: true
  ).first
  retired_source_consumers = baseline_entries.count do |entry|
    [
      RETIRED_SOURCE_ASSIGNMENT,
      EXPORTED_TYPED_INTERNAL_SOURCE_ASSIGNMENT,
      TYPED_INTERNAL_SOURCE_ASSIGNMENT
    ].any? { |assignment| entry.source.include?(assignment) }
  end
  raise "retired dirty-worktree source consumer count drifted" unless retired_source_consumers == 2
  affected_family_entries = baseline_entries.select do |entry|
    STALE_WORKGRAPH_REGULAR_PROBE_GATES.key?(entry.name) ||
      STALE_WORKGRAPH_TERMINAL_PROBE_MODULES.key?(entry.name)
  end
  stale_path_occurrences = affected_family_entries.sum do |entry|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.sum do |id|
      entry.source.scan(
        %r{scripts/lib/hepta-gate-pair-compat-v1/#{Regexp.escape(id)}\.(?:gate|report)}
      ).length
    end
  end
  legacy_module_probe_count = affected_family_entries.sum do |entry|
    entry.source.scan(
      %r{codex-rs/hepta-runtime/src/(?:work_graph|wg)_[a-z0-9_]+\.rs}
    ).length
  end
  generic_exports_probe_count = affected_family_entries.sum do |entry|
    entry.source.scan("codex-rs/hepta-runtime/src/runtime_kernel/exports_workgraph.rs").length
  end
  semantic_gate_probe_count = affected_family_entries.sum do |entry|
    entry.source.scan(/bool_for typed_workgraph_gate_backed [a-z0-9_]+/).length
  end
  semantic_predecessor_probe_count = affected_family_entries.sum do |entry|
    entry.source.scan("bool_for typed_prior_compatibility_backed").length
  end
  unless affected_family_entries.length == 23 && [0, 72].include?(stale_path_occurrences) &&
      legacy_module_probe_count + generic_exports_probe_count + semantic_gate_probe_count +
        semantic_predecessor_probe_count == 61
    raise "stale WorkGraph family consumer inventory drifted"
  end
  entries = baseline_entries.map do |entry|
    transformed = transform_stale_workgraph_family_source(
      entry.name,
      transform_source(entry.source, ids)
    )
    HeptaNormalizedTokenBundle::Entry.new(entry.name, transformed)
  end
  stale_family_reference = entries.find do |entry|
    STALE_WORKGRAPH_RETIRED_PAIR_IDS.any? { |id| entry.source.include?(id) }
  end
  raise "stale WorkGraph path survived family semantic rebind" if stale_family_reference
  rebound_reports = entries.select do |entry|
    STALE_WORKGRAPH_REGULAR_PROBE_GATES.key?(entry.name) ||
      STALE_WORKGRAPH_TERMINAL_PROBE_MODULES.key?(entry.name)
  end
  raise "stale WorkGraph rebound report inventory drifted" unless rebound_reports.length == 23
  raise "generic WorkGraph exports probe survived semantic rebind" unless rebound_reports.none? do |entry|
    entry.source.include?("runtime_kernel/exports_workgraph.rs") ||
      entry.source.match?(%r{path_exists codex-rs/hepta-runtime/src/(?:work_graph|wg)_[a-z0-9_]+\.rs})
  end
  raise "typed WorkGraph anchor membership rebind drifted" unless rebound_reports.sum do |entry|
    entry.source.scan(/bool_for typed_workgraph_gate_backed [a-z0-9_]+/).length
  end == 59
  raise "typed WorkGraph predecessor rebind drifted" unless rebound_reports.sum do |entry|
    entry.source.scan("bool_for typed_prior_compatibility_backed").length
  end == 2
  sources = entries.to_h { |entry| [entry.name, entry.source] }
  bundle = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  metadata = HeptaReadableTokenSource.write(
    root: FAMILY_ROOT,
    bundle: bundle,
    artifact_schema: FAMILY_SCHEMA,
    domain: FAMILY_DOMAIN,
    artifact_file: "payloads.bundle.gz",
    atomic_write: method(:atomic_write),
    source_chunk_lines: 8
  )
  encoded = HeptaNormalizedTokenBundle.encode(bundle, schema: FAMILY_SCHEMA)
  atomic_write(
    File.join(FAMILY_ROOT, "payloads.bundle.gz"),
    HeptaReadableTokenSource.deterministic_gzip(encoded),
    0o644
  )
  registry = JSON.parse(File.binread(FAMILY_REGISTRY_PATH))
  registry.fetch("families").each do |family|
    family.fetch("states").each do |state|
      next unless state.fetch("mode") == "exact_parameterized"
      %w[gate report].each do |kind|
        state["#{kind}_sha256"] = Digest::SHA256.hexdigest(
          sources.fetch("#{state.fetch('id')}.#{kind}")
        )
      end
    end
  end
  projections = File.readlines(File.join(FAMILY_ROOT, "projections.jsonl"), chomp: true)
    .reject(&:empty?).map { |line| JSON.parse(line) }
  metrics = registry.fetch("metrics")
  metrics["logical_family_payload_count"] = entries.length + projections.length
  metrics["normalized_family_payload_count"] = bundle.metrics.fetch(:normalized_template_count)
  metrics["exact_parameter_row_count"] = entries.length
  metrics["exact_normalized_effective_lines"] = metadata.fetch(:normalized_effective_lines)
  loop do
    cost = semantic_json_cost(registry) + projections.sum { |projection| semantic_json_cost(projection) }
    break if metrics.fetch("semantic_registry_effective_lines") == cost
    metrics["semantic_registry_effective_lines"] = cost
  end
  atomic_write(FAMILY_REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
  registry_sha = Digest::SHA256.file(FAMILY_REGISTRY_PATH).hexdigest
  spec = JSON.parse(File.binread(SPEC_PATH))
  spec.fetch("pairs").each do |pair|
    pair["family_registry_sha256"] = registry_sha if pair.fetch("template") ==
      "compat_family_state_machine_v1"
  end
  atomic_write(SPEC_PATH, JSON.pretty_generate(spec) + "\n", 0o644)
end

def logical_virtual_entrypoint_count(pair_count, physical_entrypoint_count)
  count = 2 * pair_count - physical_entrypoint_count
  raise "logical virtual entrypoint count became negative" if count.negative?
  count
end

def measured_result
  payload = JSON.parse(File.binread(File.join(BUNDLE_ROOT, "registry.json")))
  family = JSON.parse(File.binread(FAMILY_REGISTRY_PATH))
  entrypoints = JSON.parse(File.binread(ENTRYPOINT_REGISTRY_PATH))
  physical_entrypoint_count = entrypoints.fetch("retained_entrypoint_count")
  logical_virtual_count = logical_virtual_entrypoint_count(
    TARGET_PAIR_COUNT,
    physical_entrypoint_count
  )
  raise "entrypoint registry logical virtual count drifted" unless
    entrypoints.fetch("virtual_entrypoint_count") == logical_virtual_count
  {
    "pair_count" => TARGET_PAIR_COUNT,
    "captured_pair_count" => TARGET_CAPTURED_COUNT,
    "declarative_pair_count" => TARGET_DECLARATIVE_COUNT,
    "spec_sha256" => Digest::SHA256.file(SPEC_PATH).hexdigest,
    "family_registry_sha256" => Digest::SHA256.file(FAMILY_REGISTRY_PATH).hexdigest,
    "logical_compatibility_payload_count" => payload.fetch("payload_count") +
      family.fetch("metrics").fetch("logical_family_payload_count"),
    "normalized_payload_count" => payload.fetch("normalized_payload_count") +
      family.fetch("metrics").fetch("normalized_family_payload_count"),
    "normalized_effective_lines" => payload.fetch("normalized_effective_lines") +
      family.fetch("metrics").fetch("exact_normalized_effective_lines") +
      family.fetch("metrics").fetch("semantic_registry_effective_lines"),
    "physical_entrypoint_count" => physical_entrypoint_count,
    "logical_virtual_entrypoint_count" => logical_virtual_count
  }
end

def refresh_contracts(ids, context_plane_parity, plugin_parity, current_reality_parity)
  result = measured_result
  receipt = JSON.parse(File.binread(FAMILY_RECEIPT_PATH))
  prior_typed_conversion = receipt.fetch("typed_conversion", {})
  if !context_plane_parity.fetch("baseline_reports_executed") &&
      prior_typed_conversion["context_plane_parity_oracle_execution_status"] ==
        "executed_exact_head_captured_vs_typed" &&
      prior_typed_conversion["context_plane_baseline_reports_executed"] == true
    context_plane_parity = context_plane_parity.merge(
      "status" => "executed_exact_head_captured_vs_typed",
      "baseline_reports_executed" => true,
      "business_field_order_mismatch_count" => 0,
      "business_missing_field_count" =>
        prior_typed_conversion.fetch("context_plane_business_missing_field_count"),
      "business_extra_field_count" =>
        prior_typed_conversion.fetch("context_plane_business_extra_field_count"),
      "business_value_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_business_value_mismatch_count"),
      "business_field_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_business_field_mismatch_count"),
      "source_topology_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_topology_mismatch_count"),
      "source_line_count_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_line_count_mismatch_count"),
      "source_digest_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_source_digest_mismatch_count"),
      "generation_sequence_mismatch_count" =>
        prior_typed_conversion.fetch("context_plane_generation_sequence_mismatch_count")
    )
  end
  if !plugin_parity.fetch("baseline_reports_executed") &&
      prior_typed_conversion["plugin_parity_oracle_execution_status"] ==
        "executed_exact_head_captured_vs_typed" &&
      prior_typed_conversion["plugin_baseline_reports_executed"] == true
    plugin_parity = plugin_parity.merge(
      "status" => "executed_exact_head_captured_vs_typed",
      "baseline_reports_executed" => true,
      "business_field_mismatch_count" =>
        prior_typed_conversion.fetch("plugin_business_field_mismatch_count"),
      "semantic_mapping_mismatch_count" =>
        prior_typed_conversion.fetch("plugin_semantic_mapping_mismatch_count"),
      "source_binding_mismatch_count" =>
        prior_typed_conversion.fetch("plugin_source_binding_mismatch_count"),
      "authority_or_side_effect_mismatch_count" =>
        prior_typed_conversion.fetch("plugin_authority_or_side_effect_mismatch_count")
    )
  end
