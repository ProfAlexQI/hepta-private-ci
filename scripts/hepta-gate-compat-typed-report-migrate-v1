  scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-readback-index.gate
  scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-required-evidence-readback-index.report
].freeze
RETIRED_PAIR_ID = "hepta-systems-dirty-worktree-release-boundary-owner-freeze-classification-operator-decision-recording-boundary-readback-without-recording"
RETIRED_GATE_PATH = "scripts/lib/hepta-gate-pair-compat-v1/#{RETIRED_PAIR_ID}.gate"
RETIRED_REPORT_PATH = "scripts/lib/hepta-gate-pair-compat-v1/#{RETIRED_PAIR_ID}.report"
RETIRED_SOURCE_ASSIGNMENT = %(
  SOURCE_REPORT="$ROOT/#{RETIRED_REPORT_PATH}"
).strip
EXPORTED_TYPED_INTERNAL_SOURCE_ASSIGNMENT = %(
  export HEPTA_TYPED_COMPAT_INTERNAL_REPORT_ID="#{RETIRED_PAIR_ID}"
  SOURCE_REPORT="$ROOT/scripts/hepta-typed-compat-report"
).strip
TYPED_INTERNAL_SOURCE_ASSIGNMENT = 'SOURCE_REPORT="$ROOT/scripts/hepta-typed-compat-report"'
DEFER_ARCHITECTURE_RATCHET = ENV.fetch(
  "HEPTA_COMPAT_DEFER_ARCHITECTURE_RATCHET",
