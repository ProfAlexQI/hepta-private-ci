self_test() (
  local tmp baseline_rel full_rel
  tmp="$(mktemp -d /tmp/hepta-ci-contract-self-test.XXXXXX)"
  trap 'rm -rf "$tmp"' EXIT
  baseline_rel="$(jq -er '.baseline_workflow.path' "$CONTRACT")"
  full_rel="$(jq -er '.full_workflow.path' "$CONTRACT")"
  mkdir -p \
    "$tmp/$(dirname "$baseline_rel")" \
    "$tmp/$(dirname "$full_rel")" \
    "$tmp/scripts/fixtures" \
    "$tmp/scripts/lib/hepta-browser-visual-smoke-v1" \
    "$tmp/codex-rs/hepta-core/src"
  cp "$CONTRACT" "$tmp/contract.json"
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  cp "$ROOT/scripts/hepta-ci-baseline" "$tmp/scripts/hepta-ci-baseline"
  cp "$ROOT/scripts/hepta-ci-baseline-contract" "$tmp/scripts/hepta-ci-baseline-contract"
  cp "$ROOT/scripts/hepta-ci-materialize-upstream-intake" "$tmp/scripts/hepta-ci-materialize-upstream-intake"
  cp "$ROOT/scripts/hepta-preflight.sh" "$tmp/scripts/hepta-preflight.sh"
  cp \
    "$ROOT/scripts/hepta-ui-contract-commit-closure-gate" \
    "$tmp/scripts/hepta-ui-contract-commit-closure-gate"
  cp \
    "$ROOT/scripts/hepta-ui-contract-commit-closure-gate-self-test.sh" \
    "$tmp/scripts/hepta-ui-contract-commit-closure-gate-self-test.sh"
  cp \
    "$ROOT/scripts/hepta-ui-release-consumer-forged-tuple-self-test.sh" \
    "$tmp/scripts/hepta-ui-release-consumer-forged-tuple-self-test.sh"
  cp \
    "$ROOT/scripts/fixtures/hepta-ui-release-consumer-ready-v1.tar.gz" \
    "$tmp/scripts/fixtures/hepta-ui-release-consumer-ready-v1.tar.gz"
  cp \
    "$ROOT/scripts/lib/hepta-browser-visual-smoke-v1/static-contract.sh" \
    "$tmp/scripts/lib/hepta-browser-visual-smoke-v1/static-contract.sh"
  cp "$ROOT/codex-rs/hepta-core/src/control_ui.rs" "$tmp/codex-rs/hepta-core/src/control_ui.rs"
  HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null
  jq '.ui_commit_closure.required_files |= map(select(. != "apps/hepta-native/packaging/build-macos-dmg.sh"))' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted missing release producer commit closure" >&2
    return 1
  fi
  printf '\npermissions: write-all\n' >>"$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted write-all permissions" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  printf '\n  pull_request:\n' >>"$tmp/$full_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted ordinary PR full preflight" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  jq '.upstream_intake.url = "https://example.invalid/floating.git"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake URL" >&2
    return 1
  fi
  jq '.upstream_intake.refs[1].ref = "refs/remotes/upstream/main"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake ref" >&2
    return 1
  fi
  jq '.upstream_intake.refs[6].sha = "0000000000000000000000000000000000000000"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake SHA" >&2
    return 1
  fi
  jq '.safe_lint_security_baseline.ci_execution_evidence = "verified"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted false safe lint CI evidence promotion" >&2
    return 1
  fi
  jq '.ui_product_contract.control_ui_schema_validator = "check-jsonschema"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted an unpinned Control UI schema validator" >&2
    return 1
  fi
  sed -i.bak '/check-jsonschema==0\.37\.4/d' "$tmp/$baseline_rel"
  rm -f "$tmp/$baseline_rel.bak"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted UI CI without the pinned schema validator install" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  perl -0pi -e \
    's/(  rust-backend:\n.*?)(          fetch-depth: 0\n)/$1/s' \
    "$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a shallow rust-backend checkout" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  perl -0pi -e \
    's/(  rust-backend:\n.*?)(      - name: Materialize immutable upstream intake refs for counted evidence\n        run: scripts\/hepta-ci-materialize-upstream-intake materialize\n)/$1/s' \
    "$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted rust-backend without frozen intake refs" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  sed -i.bak '/cargo install cargo-audit --version 0.22.2 --locked/d' "$tmp/$full_rel"
  rm -f "$tmp/$full_rel.bak"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted full preflight without pinned cargo-audit" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  sed -i.bak '/scripts\/hepta-dependency-security materialize-db/d' "$tmp/$full_rel"
  rm -f "$tmp/$full_rel.bak"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted full preflight without pinned RustSec DB materialization" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  perl -0pi -e \
    's/Architecture V2 provider-effect ACK" 2/Architecture V2 provider-effect ACK" 3/' \
    "$tmp/scripts/hepta-ci-baseline"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted V2 inventory drift" >&2
    return 1
  fi
  cp "$ROOT/scripts/hepta-ci-baseline" "$tmp/scripts/hepta-ci-baseline"
  printf '\n      - run: git fetch upstream main\n' >>"$tmp/$full_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a floating upstream fetch" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  local ref_fixture predecessor_ref predecessor_sha r2_ref r2_sha r3_ref r3_sha r4_ref r4_sha r5_ref r5_sha r6_ref r6_sha r7_ref r7_sha r8_ref r8_sha r9_ref r9_sha predecessor_before r2_before r3_before r4_before r5_before r6_before r7_before r8_before wrong_r4_after wrong_r5_after wrong_r6_after wrong_r7_after wrong_r8_after wrong_r9_after
  ref_fixture="$tmp/ref-fixture"
  predecessor_ref="refs/remotes/upstream/hepta-intake-20260721"
  predecessor_sha="45ac251e178416ff5c3022457ad8d2778c0d4549"
  r2_ref="refs/remotes/upstream/hepta-intake-20260721-r2"
  r2_sha="88fac6fe108237a105d3203e3508b0d531054312"
