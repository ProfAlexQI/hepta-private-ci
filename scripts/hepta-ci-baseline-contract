#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
CONTRACT="${HEPTA_CI_CONTRACT:-$ROOT/.github/hepta-ci-contract-v1.json}"
usage() {
  echo "usage: scripts/hepta-ci-baseline-contract <verify|self-test>" >&2
  exit 2
}
require_exact_literal() {
  local file="$1"
  local literal="$2"
  local label="$3"
  local count
  count="$(grep -Fxc -- "$literal" "$file" || true)"
  if [[ "$count" != "1" ]]; then
    echo "Hepta CI contract expected one $label in $file, found $count" >&2
    return 1
  fi
}
require_literal_count() {
  local file="$1"
  local literal="$2"
  local expected="$3"
  local label="$4"
  local count
  count="$(grep -Fxc -- "$literal" "$file" || true)"
  if [[ "$count" != "$expected" ]]; then
    echo "Hepta CI contract expected $expected $label entries in $file, found $count" >&2
    return 1
  fi
}
require_literal() {
  local file="$1"
  local literal="$2"
  local label="$3"
  grep -Fq -- "$literal" "$file" || {
    echo "Hepta CI contract missing $label in $file" >&2
    return 1
  }
}
reject_literal() {
  local file="$1"
  local literal="$2"
  if grep -Fq -- "$literal" "$file"; then
    echo "Hepta CI contract rejected token '$literal' in $file" >&2
    return 1
  fi
}
workflow_job_block() {
  local file="$1"
  local job="$2"
  awk -v job="$job" '
    $0 == "  " job ":" {
      in_job = 1
    }
    in_job {
      if (seen && $0 ~ /^  [[:alnum:]_-]+:$/) {
        exit
      }
      print
      seen = 1
    }
  ' "$file"
}
require_literal_order() {
  local file="$1"
  local first="$2"
  local second="$3"
  local label="$4"
  local content first_line second_line
  content="$(cat "$file")"
  first_line="$(grep -Fn -- "$first" <<<"$content" | head -n 1 | cut -d: -f1)"
  second_line="$(grep -Fn -- "$second" <<<"$content" | head -n 1 | cut -d: -f1)"
  if [[ -z "$first_line" || -z "$second_line" || "$first_line" -ge "$second_line" ]]; then
    echo "Hepta CI contract requires ordered $label in $file" >&2
    return 1
  fi
}
normalized_v2_inventory() {
  local file="$1"
  local line call
  while IFS= read -r line; do
    [[ "$line" == *'assert_test_inventory "Architecture V2 '* ]] || continue
    call="$line"
    while [[ "$line" == *'\' ]]; do
      IFS= read -r line
      call+=" $line"
    done
    printf '%s\n' "$call"
  done <"$file" \
    | sed -E 's#"\$ROOT/([^"]+)"#\1#g; s/[[:space:]]+//g'
}
verify_v2_inventory_parity() {
  local ci_inventory preflight_inventory
  ci_inventory="$(normalized_v2_inventory "$ROOT/scripts/hepta-ci-baseline")"
  preflight_inventory="$(normalized_v2_inventory "$ROOT/scripts/hepta-preflight.sh")"
  if [[ "$ci_inventory" != "$preflight_inventory" ]]; then
    echo "Hepta CI and full preflight Architecture V2 test inventories drifted" >&2
    diff -u \
      <(printf '%s\n' "$preflight_inventory") \
      <(printf '%s\n' "$ci_inventory") >&2 || true
    return 1
  fi
  [[ "$(printf '%s\n' "$ci_inventory" | grep -c '^assert_test_inventory')" == 36 ]] || {
    echo "Hepta Architecture V2 test inventory family count drifted" >&2
    return 1
  }
}
verify_contract() {
  command -v jq >/dev/null || {
    echo "missing Hepta CI contract tool: jq" >&2
    return 1
  }
  jq -e '
    .schema == "hepta_ci_baseline_contract_v1"
    and .status == "ready"
    and .permissions == {contents:"read"}
    and (.baseline_workflow.allowed_events | sort == ["pull_request","push","schedule","workflow_dispatch"])
    and (.full_workflow.allowed_events == ["workflow_dispatch"])
    and .full_workflow.dependency_security == {
      cargo_audit_install:"cargo install cargo-audit --version 0.22.2 --locked",
      cargo_deny_install:"cargo install cargo-deny --version 0.20.2 --locked",
      materialize_database:"scripts/hepta-dependency-security materialize-db"
    }
    and .full_workspace_platform_evidence == {
      capability_version:3,
      trigger:"workflow_dispatch",
      required_confirmation:"RUN_FULL_WORKSPACE_NO_LIVE",
      command:"scripts/hepta-ci-baseline full-workspace",
      receipt_schema:"hepta_full_workspace_platform_receipt_v1",
      platforms:[
        {id:"linux",runner:"ubuntu-24.04",status:"configured_not_verified"},
        {id:"macos",runner:"macos-15",status:"configured_not_verified"}
      ],
      unsupported_platforms:[
        {id:"windows",reason:"no repository-proven full-workspace toolchain and shell contract"}
      ],
      promotion:{
        configured_capability_is_execution_evidence:false,
        requires_successful_github_actions_receipt:true,
        platform_scoped:true,
        cross_platform_promotion:false
      }
    }
    and .safe_lint_security_baseline == {
      capability_version:1,
      contract:"scripts/hepta-safe-lint-security-baseline-v1.json",
      configured_capability:"supported",
      local_execution_evidence:"configured_not_verified",
      ci_execution_evidence:"configured_not_verified",
      security_findings:"not_assessed",
      ci_job:"rust-backend",
      entrypoint:"scripts/hepta-safe-lint-security-baseline run"
    }
    and .dependency_security == {
      capability_version:2,
      contract:"scripts/hepta-dependency-security-v1.json",
      configured_capability:"supported",
      tools_pinned:true,
      advisory_database_pinned:true,
      scan_network_disabled:true,
      cargo_lock_graphs:[
        "codex-rs/Cargo.lock",
        "apps/hepta-native/Cargo.lock"
      ],
      vendored_source_receipts_required:true,
      vendored_source_receipts:[
        "codex-rs/third_party/ratatui-0.30.2-hepta/HEPTA_SOURCE_RECEIPT_V1.json"
      ],
      ci_job:"rust-backend",
      entrypoint:"scripts/hepta-dependency-security scan"
    }
    and .gate_compatibility_debt == {
      capability_version:1,
      contract:"scripts/hepta-gate-compat-debt-v1.json",
      counts_may_only_improve:true,
      registered_payloads_hash_bound:true,
      ci_job:"static",
      verify_entrypoint:"scripts/hepta-gate-compat-debt verify",
      self_test_entrypoint:"scripts/hepta-gate-compat-debt self-test"
    }
    and .upstream_intake == {
      url:"https://github.com/openai/codex.git",
      materialize_command:"scripts/hepta-ci-materialize-upstream-intake materialize",
      refs:[
        {
          role:"predecessor",
          ref:"refs/remotes/upstream/hepta-intake-20260721",
          sha:"45ac251e178416ff5c3022457ad8d2778c0d4549"
        },
        {
          role:"current_r2",
          ref:"refs/remotes/upstream/hepta-intake-20260721-r2",
          sha:"88fac6fe108237a105d3203e3508b0d531054312"
        },
        {
          role:"current_r3",
          ref:"refs/remotes/upstream/hepta-intake-20260722-r3",
          sha:"9fc715c0861c956c894a91890b78dc05b304ba29"
        },
        {
          role:"current_r4",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r4",
          sha:"f61b51ddd924643514b33234816a8a2772b1aec7"
        },
        {
          role:"current_r5",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r5",
          sha:"81da9deb065d7adb283816b19b40f89bcc484276"
        },
        {
          role:"current_r6",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r6",
          sha:"6c729ef1c1dcfbcbe1bd9d0c2dddde24377ae899"
        },
        {
          role:"current_r7",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r7",
          sha:"f201c30c52a35f819262865a53df94b6f4ea7a50"
        },
        {
          role:"current_r8",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r8",
          sha:"c8957bbf0f79fa29c5e08b8c0b942c12ea3893f2"
        },
        {
          role:"current_r9",
          ref:"refs/remotes/upstream/hepta-intake-20260724-r9",
          sha:"000d2540ad73996f3589ae178bfe447bfd67cef2"
        },
        {
          role:"current_r10",
          ref:"refs/remotes/upstream/hepta-intake-20260725-r10",
          sha:"4c43465133428898aa84f0bfc02c306ed65fb66a"
        },
        {
          role:"current_r11",
          ref:"refs/remotes/upstream/hepta-intake-20260726-r11",
          sha:"61a44880a85d2fd0d8770908dea5733495e571c8"
        }
      ]
    }
    and .upstream_truth == {
      capability_version:1,
      registry:"docs/architecture/HEPTA_UPSTREAM_CODEX_SEMANTIC_ABSORPTION_REGISTRY_V1.json",
      registry_sha256:"40a6391f27ef2c58ca174c0d48481031687bcbe3458340eee5c5d83c811a4569",
      ci_job:"upstream-truth",
      semantic_command:"scripts/hepta-upstream-truth-gate verify-semantic",
      counted_evidence_command:"scripts/hepta-upstream-truth-gate verify-counted-evidence",
      counted_evidence_ci_job:"rust-backend",
      counted_evidence_requires_full_history:true,
      counted_evidence_requires_materialized_intake_refs:true,
      minimum_counted_evidence_command_count:11,
      minimum_exact_test_count:18,
      self_test_command:"scripts/hepta-upstream-truth-gate self-test",
      network_receipt_command:"scripts/hepta-upstream-truth-gate network-receipt artifacts/upstream-network-freshness-receipt.json",
      network_receipt_verify_command:"scripts/hepta-upstream-truth-gate verify-network-receipt artifacts/upstream-network-freshness-receipt.json",
      ordinary_ci_events:["pull_request","push","workflow_dispatch"],
      network_freshness_required:true,
      semantic_absorption_required:true
    }
  ' "$CONTRACT" >/dev/null
  local baseline_rel full_rel baseline full rust_backend_block
  baseline_rel="$(jq -er '.baseline_workflow.path' "$CONTRACT")"
  full_rel="$(jq -er '.full_workflow.path' "$CONTRACT")"
  baseline="$ROOT/$baseline_rel"
  full="$ROOT/$full_rel"
  [[ -f "$baseline" && -f "$full" ]] || {
    echo "Hepta CI workflow file missing" >&2
    return 1
  }
  require_exact_literal "$baseline" "  pull_request:" "pull_request trigger"
  require_exact_literal "$baseline" "  push:" "push trigger"
  require_exact_literal "$baseline" "  workflow_dispatch:" "manual trigger"
  require_exact_literal "$baseline" "  schedule:" "nightly static trigger"
  require_exact_literal "$full" "  workflow_dispatch:" "full manual-only trigger"
  reject_literal "$full" "  pull_request:"
  reject_literal "$full" "  push:"
  reject_literal "$full" "  schedule:"
  local workflow
  for workflow in "$baseline" "$full"; do
    require_exact_literal "$workflow" "permissions:" "permissions block"
    require_exact_literal "$workflow" "  contents: read" "read-only contents permission"
    require_literal "$workflow" "concurrency:" "concurrency policy"
    require_exact_literal "$workflow" "  cancel-in-progress: true" "cancellation policy"
    require_literal "$workflow" "uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683" "pinned checkout action"
    while IFS= read -r forbidden; do
      reject_literal "$workflow" "$forbidden"
    done < <(jq -er '.forbidden_workflow_tokens[]' "$CONTRACT")
  done
  local job command_name binding profile
  while IFS= read -r job; do
    require_exact_literal "$baseline" "  $job:" "baseline job $job"
  done < <(jq -er '.baseline_workflow.required_jobs[]' "$CONTRACT")
  while IFS= read -r command_name; do
    require_literal "$baseline" "run: $command_name" "baseline command $command_name"
  done < <(jq -er '.baseline_workflow.required_commands[]' "$CONTRACT")
  require_literal "$baseline" "uses: dtolnay/rust-toolchain@a0b273b48ed29de4470960879e8381ff45632f26" "pinned Rust toolchain action"
  require_literal "$baseline" "components: rustfmt, clippy" "bounded backend Clippy component"
  require_literal "$ROOT/scripts/hepta-ci-baseline" 'scripts/hepta-safe-lint-security-baseline" run' "safe lint/security baseline execution"
  require_literal "$ROOT/scripts/hepta-ci-baseline" 'scripts/hepta-dependency-security" scan' "dependency security execution"
  require_literal "$ROOT/scripts/hepta-ci-baseline" 'scripts/hepta-upstream-truth-gate" verify-counted-evidence' "exact counted upstream evidence execution"
  require_literal "$ROOT/scripts/hepta-ci-baseline" 'scripts/hepta-gate-compat-debt verify' "gate compatibility debt verification"
  require_literal "$ROOT/scripts/hepta-ci-baseline" 'scripts/hepta-gate-compat-debt self-test' "gate compatibility debt self-test"
  require_literal "$baseline" "cargo install cargo-audit --version 0.22.2 --locked" "pinned cargo-audit installation"
  require_literal "$baseline" "cargo install cargo-deny --version 0.20.2 --locked" "pinned cargo-deny installation"
  require_literal "$baseline" "run: scripts/hepta-dependency-security materialize-db" "pinned advisory database materialization"
  rust_backend_block="$(workflow_job_block "$baseline" "rust-backend")"
  require_literal <(printf '%s\n' "$rust_backend_block") "          fetch-depth: 0" "rust-backend full-history checkout"
  require_literal <(printf '%s\n' "$rust_backend_block") \
    "        run: scripts/hepta-ci-materialize-upstream-intake materialize" \
    "rust-backend frozen intake materialization"
  require_literal_order \
    <(printf '%s\n' "$rust_backend_block") \
    "        run: scripts/hepta-ci-materialize-upstream-intake materialize" \
    "        run: scripts/hepta-ci-baseline rust-backend" \
    "rust-backend frozen intake materialization before counted evidence"
  require_literal "$baseline" "uses: actions/cache@5a3ec84eff668545956fd18022155c47e93e2684" "pinned Cargo cache action"
  require_literal_count "$baseline" "          persist-credentials: false" 6 "checkout credential isolation"
  require_literal "$baseline" '${{ github.job }}' "job-bound Cargo cache key"
  while IFS= read -r binding; do
    require_literal "$baseline" "'$binding'" "Cargo cache binding $binding"
  done < <(jq -er '.cache_bindings[]' "$CONTRACT")
  require_literal "$baseline" '          - platform: linux' "Linux full-workspace platform"
  require_literal "$baseline" '            runner: ubuntu-24.04' "Linux full-workspace runner"
  require_literal "$baseline" '          - platform: macos' "macOS full-workspace platform"
  require_literal "$baseline" '            runner: macos-15' "macOS full-workspace runner"
  reject_literal "$baseline" '          - platform: windows' "unsupported Windows full-workspace platform"
  require_literal "$baseline" "if: github.event_name == 'workflow_dispatch' && inputs.confirm_full_workspace == 'RUN_FULL_WORKSPACE_NO_LIVE'" "full-workspace dispatch confirmation"
  require_literal "$baseline" 'HEPTA_CI_CONFIRM_FULL_WORKSPACE: ${{ inputs.confirm_full_workspace }}' "receipt confirmation binding"
  require_literal "$baseline" 'run: scripts/hepta-full-workspace-evidence run ${{ matrix.platform }} ${{ matrix.runner }}' "platform receipt execution"
  require_literal "$baseline" 'run: scripts/hepta-full-workspace-evidence verify-receipt ${{ matrix.platform }} ${{ matrix.runner }}' "platform receipt verification"
  require_literal "$baseline" 'run: scripts/hepta-full-workspace-evidence verify-success-receipt ${{ matrix.platform }} ${{ matrix.runner }}' "successful platform receipt promotion eligibility"
  require_literal "$full" "uses: dtolnay/rust-toolchain@a0b273b48ed29de4470960879e8381ff45632f26" "pinned Rust toolchain action"
  require_literal "$full" "components: rustfmt, clippy" "full preflight V2 Clippy component"
  require_literal "$full" "uses: actions/cache@5a3ec84eff668545956fd18022155c47e93e2684" "pinned full preflight Cargo cache action"
  require_exact_literal "$full" "          persist-credentials: false" "full checkout credential isolation"
  require_literal "$full" '${{ github.job }}' "full job-bound Cargo cache key"
  require_literal "$full" "$(jq -er '.full_workflow.required_confirmation' "$CONTRACT")" "verification-only confirmation"
  while IFS= read -r profile; do
    require_literal "$full" "          - $profile" "full profile $profile"
  done < <(jq -er '.full_workflow.required_profiles[]' "$CONTRACT")
  require_literal "$full" "run: $(jq -er '.full_workflow.required_command' "$CONTRACT")" "full preflight command"
  require_exact_literal "$full" "        run: $(jq -er '.upstream_intake.materialize_command' "$CONTRACT")" "frozen upstream intake materialization command"
  require_literal "$full" \
    "$(jq -er '.full_workflow.dependency_security.cargo_audit_install' "$CONTRACT")" \
    "full preflight pinned cargo-audit installation"
  require_literal "$full" \
    "$(jq -er '.full_workflow.dependency_security.cargo_deny_install' "$CONTRACT")" \
    "full preflight pinned cargo-deny installation"
  require_exact_literal "$full" \
    "        run: $(jq -er '.full_workflow.dependency_security.materialize_database' "$CONTRACT")" \
    "full preflight pinned advisory database materialization"
  require_literal_order \
    "$full" \
    "        run: $(jq -er '.full_workflow.dependency_security.materialize_database' "$CONTRACT")" \
    "        run: $(jq -er '.full_workflow.required_command' "$CONTRACT")" \
    "full preflight dependency database materialization before release verification"
  require_literal "$full" "HEPTA_PREFLIGHT_NATIVE=0" "backend-only native opt-out"
  require_literal "$full" "HEPTA_PREFLIGHT_RELEASE=0" "release opt-out"
  require_literal "$full" "HEPTA_PREFLIGHT_NATIVE=1" "explicit native profile"
  require_literal "$full" "HEPTA_PREFLIGHT_RELEASE=1" "explicit release profile"
  require_literal "$baseline" \
    "cargo fetch --locked --manifest-path codex-rs/Cargo.toml" \
    "rust-backend codex dependency graph fetch"
  require_literal "$baseline" \
    "cargo fetch --locked --manifest-path apps/hepta-native/Cargo.toml" \
    "rust-backend native dependency graph fetch"
  require_literal "$full" \
    "cargo fetch --locked --manifest-path codex-rs/Cargo.toml" \
    "full preflight codex dependency graph fetch"
  require_literal "$full" \
    "cargo fetch --locked --manifest-path apps/hepta-native/Cargo.toml" \
    "full preflight native dependency graph fetch"
  verify_v2_inventory_parity
  local action_ref
  while IFS= read -r action_ref; do
    if [[ ! "$action_ref" =~ ^[0-9a-f]{40}$ ]]; then
      echo "Hepta CI contract rejected an unpinned action ref: $action_ref" >&2
      return 1
    fi
  done < <(sed -nE 's/^[[:space:]]*uses:[[:space:]]*[^@[:space:]]+@([0-9A-Za-z._-]+).*/\1/p' "$baseline" "$full")
  jq -n \
    --arg schema hepta_ci_baseline_contract_verification_v1 \
    --arg status ready \
    --arg baseline_workflow "$baseline_rel" \
    --arg full_workflow "$full_rel" \
    '{schema:$schema,status:$status,baseline_workflow:$baseline_workflow,full_workflow:$full_workflow,permissions_read_only:true,ordinary_pr_full_preflight_denied:true,deploy_install_sign_publish_denied:true,cache_lock_toolchain_bound:true,frozen_upstream_intake_bound:true,full_workspace_platforms:["linux","macos"],windows_unsupported:true,receipt_promotion_requires_real_run:true,cross_platform_promotion_denied:true}'
}
self_test() (
  local tmp baseline_rel full_rel
  tmp="$(mktemp -d /tmp/hepta-ci-contract-self-test.XXXXXX)"
  trap 'rm -rf "$tmp"' EXIT
  baseline_rel="$(jq -er '.baseline_workflow.path' "$CONTRACT")"
  full_rel="$(jq -er '.full_workflow.path' "$CONTRACT")"
  mkdir -p "$tmp/$(dirname "$baseline_rel")" "$tmp/$(dirname "$full_rel")" "$tmp/scripts"
  cp "$CONTRACT" "$tmp/contract.json"
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  cp "$ROOT/scripts/hepta-ci-baseline" "$tmp/scripts/hepta-ci-baseline"
  cp "$ROOT/scripts/hepta-ci-baseline-contract" "$tmp/scripts/hepta-ci-baseline-contract"
  cp "$ROOT/scripts/hepta-ci-materialize-upstream-intake" "$tmp/scripts/hepta-ci-materialize-upstream-intake"
  cp "$ROOT/scripts/hepta-preflight.sh" "$tmp/scripts/hepta-preflight.sh"
  HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null
  printf '\npermissions: write-all\n' >>"$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted write-all permissions" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  printf '\n  pull_request:\n' >>"$tmp/$full_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted ordinary PR full preflight" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  jq '.upstream_intake.url = "https://example.invalid/floating.git"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake URL" >&2
    return 1
  fi
  jq '.upstream_intake.refs[1].ref = "refs/remotes/upstream/main"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake ref" >&2
    return 1
  fi
  jq '.upstream_intake.refs[6].sha = "0000000000000000000000000000000000000000"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a different upstream intake SHA" >&2
    return 1
  fi
  jq '.safe_lint_security_baseline.ci_execution_evidence = "verified"' \
    "$tmp/contract.json" >"$tmp/contract-mutated.json"
  if HEPTA_CI_CONTRACT="$tmp/contract-mutated.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted false safe lint CI evidence promotion" >&2
    return 1
  fi
  perl -0pi -e \
    's/(  rust-backend:\n.*?)(          fetch-depth: 0\n)/$1/s' \
    "$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted a shallow rust-backend checkout" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  perl -0pi -e \
    's/(  rust-backend:\n.*?)(      - name: Materialize immutable upstream intake refs for counted evidence\n        run: scripts\/hepta-ci-materialize-upstream-intake materialize\n)/$1/s' \
    "$tmp/$baseline_rel"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted rust-backend without frozen intake refs" >&2
    return 1
  fi
  cp "$ROOT/$baseline_rel" "$tmp/$baseline_rel"
  sed -i.bak '/cargo install cargo-audit --version 0.22.2 --locked/d' "$tmp/$full_rel"
  rm -f "$tmp/$full_rel.bak"
  if HEPTA_CI_CONTRACT="$tmp/contract.json" "$tmp/scripts/hepta-ci-baseline-contract" verify >/dev/null 2>&1; then
    echo "Hepta CI contract self-test accepted full preflight without pinned cargo-audit" >&2
    return 1
  fi
  cp "$ROOT/$full_rel" "$tmp/$full_rel"
  sed -i.bak '/scripts\/hepta-dependency-security materialize-db/d' "$tmp/$full_rel"
