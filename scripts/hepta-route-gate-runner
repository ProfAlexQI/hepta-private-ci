#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE="$ROOT/scripts/hepta-route-gate-specs-v1.json"

usage() {
  echo "usage: scripts/hepta-route-gate-runner <id|--validate>" >&2
  exit 2
}

validate_registry() {
  jq -e '
    .schema_version == "hepta_route_gate_specs_v1"
    and .executor == "scripts/hepta-route-gate-runner"
    and .receipt_state_machine == ["precondition", "denial", "receipt", "persistence", "retention", "terminal"]
    and (.families | length) == 1
    and (.families[0].id == "first_model_invocation_result_receipt_transition_v1")
    and (.families[0].common_report_fields | type == "object")
    and (.families[0].common_live_false_fields | type == "array")
    and (.families[0].common_live_zero_fields | type == "array")
    and (.families[0].common_live_array_lengths | type == "object")
    and (.families[0].specs | length) == 3
    and ((.families[0].specs | map(.id) | unique | length) == 3)
    and (.families[0].specs | all(
      (.id | test("^[a-z0-9-]+$"))
      and (.gate_spec.method == "GET")
      and (.gate_spec.pattern == ("/api/" + .id))
      and (.gate_spec.source_command == ("/" + .id + " --json"))
      and (.gate_spec.capability == .id)
      and (.gate_spec.receipt_state | IN("precondition", "denial", "receipt", "persistence", "retention", "terminal"))
      and (.route_constant | test("^[A-Z0-9_]+_ENDPOINT$"))
      and (.report_function | test("^[a-z0-9_]+_report$"))
      and (.execution_mode | length > 0)
      and (.focused_test | test("^[a-z0-9_]+$"))
      and (.test_log_stem | test("^[a-z0-9-]+$"))
      and (.next_action | test("^[a-z0-9_]+$"))
      and (.report_fields | type == "object")
      and (.live_validation | type == "object")
      and (.baseline_normalized_output_sha256 | test("^[0-9a-f]{64}$"))
      and (.pass_message | length > 0)
    ))
  ' "$SPEC_FILE" >/dev/null
}

[[ -f "$SPEC_FILE" ]] || {
  echo "missing Hepta route gate spec registry: $SPEC_FILE" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}

[[ $# == 1 ]] || usage
if [[ "$1" == "--validate" ]]; then
  validate_registry
  echo '{"schema":"hepta_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
  exit 0
fi

id="$1"
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
validate_registry

family="$(jq -cer --arg id "$id" '.families[] | select(any(.specs[]; .id == $id))' "$SPEC_FILE")" || {
  echo "unknown Hepta route gate spec id: $id" >&2
  exit 1
}
spec="$(jq -cer --arg id "$id" '.specs[] | select(.id == $id)' <<<"$family")"

BASE_URL="${HEPTA_LIVE_URL:-http://127.0.0.1:7373}"
MANIFEST="${HEPTA_MANIFEST:-codex-rs/Cargo.toml}"
REQUIRE_LIVE_ENDPOINT="${HEPTA_ROUTE_GATE_REQUIRE_LIVE_ENDPOINT:-0}"
EXPECTED_ROUTE_COUNT="${HEPTA_EXPECTED_ROUTE_COUNT:-$(bash "$ROOT/scripts/lib/hepta-native-route-count.sh")}"
NATIVE_GATEWAY_SOURCE="hepta-native-gateway-source-set-v1"
ROUTE_REGISTRY_SOURCE="codex-rs/hepta-native-gateway/src/route_registry.rs"

cd "$ROOT"
source "$ROOT/scripts/lib/hepta-source-set.sh"

route_constant="$(jq -r '.route_constant' <<<"$spec")"
report_function="$(jq -r '.report_function' <<<"$spec")"
execution_mode="$(jq -r '.execution_mode' <<<"$spec")"
focused_test="$(jq -r '.focused_test' <<<"$spec")"
test_log_stem="$(jq -r '.test_log_stem' <<<"$spec")"
next_action="$(jq -r '.next_action' <<<"$spec")"
endpoint="$(jq -r '.gate_spec.pattern' <<<"$spec")"
source_command="$(jq -r '.gate_spec.source_command' <<<"$spec")"

require_source_text "$NATIVE_GATEWAY_SOURCE" \
  "const NATIVE_GATEWAY_SOURCE_COMMAND_COUNT: usize = CONTROL_UI_ROUTE_SPECS.len();" \
  "$id route/source count"
require_source_text "$ROUTE_REGISTRY_SOURCE" "$route_constant" "$id endpoint constant"
require_source_text "$ROUTE_REGISTRY_SOURCE" "$endpoint" "$id endpoint path"
require_source_text "$ROUTE_REGISTRY_SOURCE" "$source_command" "$id source command"
require_source_text "$NATIVE_GATEWAY_SOURCE" "$report_function" "$id report function"
require_source_text "$NATIVE_GATEWAY_SOURCE" "$execution_mode" "$id execution mode"
require_source_text "$NATIVE_GATEWAY_SOURCE" "$focused_test" "$id focused test"
require_source_text "$NATIVE_GATEWAY_SOURCE" "\"action\": \"$next_action\"" "$id next action"

TEST_LOG="$(mktemp "/tmp/${test_log_stem}.XXXXXX")"
cargo test --offline --manifest-path "$MANIFEST" -q -p hepta-native-gateway --lib \
  "$focused_test" -- --nocapture >"$TEST_LOG"

live_route_status="skipped"
live_route_count=0
live_missing_route_count=0

if [[ "$REQUIRE_LIVE_ENDPOINT" == "1" ]]; then
  LIVE_JSON="$(curl -fsS "$BASE_URL$endpoint")"
  validation="$(
    jq -cn \
      --argjson common_false "$(jq -c '.common_live_false_fields' <<<"$family")" \
      --argjson common_zero "$(jq -c '.common_live_zero_fields' <<<"$family")" \
      --argjson common_lengths "$(jq -c '.common_live_array_lengths' <<<"$family")" \
      --argjson specific "$(jq -c '.live_validation' <<<"$spec")" \
      '$specific
        | .false_fields = ($common_false + .false_fields)
        | .zero_fields = ($common_zero + .zero_fields)
        | .array_lengths = ($common_lengths + .array_lengths)'
  )"
  jq -e --argjson expected "$EXPECTED_ROUTE_COUNT" --argjson validation "$validation" '
    . as $actual
    | .status == "ready"
      and .route_count == $expected
      and .implemented_route_count == $expected
      and .missing_route_count == 0
      and .route_count_source_command_accepted == true
      and ($validation.true_fields | all(. as $key | $actual[$key] == true))
      and ($validation.false_fields | all(. as $key | $actual[$key] == false))
      and ($validation.zero_fields | all(. as $key | $actual[$key] == 0))
      and ($validation.eight_fields | all(. as $key | $actual[$key] == 8))
      and ($validation.string_fields | to_entries | all(. as $item | $actual[$item.key] == $item.value))
      and ($validation.array_lengths | to_entries | all(. as $item | ($actual[$item.key] | length) == $item.value))
      and (
        $validation.fixture as $fixture
        | ($actual[$fixture.collection] | length) == $fixture.length
          and ($actual[$fixture.collection] | all(
            . as $row
            | ($row[$fixture.status_field] | startswith($fixture.status_prefix))
              and ($fixture.true_fields | all(. as $key | $row[$key] == true))
              and ($fixture.false_fields | all(. as $key | $row[$key] == false))
          ))
      )
      and (
        $actual.allowed_next_actions[0] as $next
        | ($validation.next_action_fields | to_entries | all(. as $item | $next[$item.key] == $item.value))
      )
      and (.side_effects | to_entries | all(.value == false))
  ' >/dev/null <<<"$LIVE_JSON"
  live_route_status="$(jq -r '.status' <<<"$LIVE_JSON")"
  live_route_count="$(jq -r '.route_count' <<<"$LIVE_JSON")"
  live_missing_route_count="$(jq -r '.missing_route_count' <<<"$LIVE_JSON")"
fi

report_fields="$(
  jq -cn \
    --argjson common "$(jq -c '.common_report_fields' <<<"$family")" \
    --argjson specific "$(jq -c '.report_fields' <<<"$spec")" \
    '$common + $specific'
)"
report="$(
  jq -n \
    --arg product "Hepta" \
    --arg runtime "hepta" \
    --arg base_url "$BASE_URL" \
    --arg gate "${id//-/_}_route_gate" \
    --arg endpoint "$endpoint" \
    --arg source_command "$source_command" \
    --arg native_gateway_sha256 "$(sha256_file "$NATIVE_GATEWAY_SOURCE")" \
    --arg test_log "$TEST_LOG" \
    --arg live_route_status "$live_route_status" \
    --argjson live_route_count "$live_route_count" \
    --argjson live_missing_route_count "$live_missing_route_count" \
    --argjson expected_route_count "$EXPECTED_ROUTE_COUNT" \
    --argjson live_endpoint_checked "$([[ "$REQUIRE_LIVE_ENDPOINT" == "1" ]] && echo true || echo false)" \
    --argjson fields "$report_fields" \
    '{
      product:$product,
      runtime:$runtime,
      status:"ready",
      base_url:$base_url,
      gate:$gate,
      endpoint:$endpoint,
      source_command:$source_command,
      native_gateway_sha256:$native_gateway_sha256,
      focused_test_log:$test_log,
      live_endpoint_checked:$live_endpoint_checked,
      live_route_status:$live_route_status,
      live_route_count:$live_route_count,
      live_missing_route_count:$live_missing_route_count,
      expected_route_count:$expected_route_count,
      route_gate_ready:true
    } + $fields'
)"

expected_output_sha="$(jq -r '.baseline_normalized_output_sha256' <<<"$spec")"
actual_output_sha="$(
  jq -S '
    del(
      .base_url,
      .native_gateway_sha256,
      .focused_test_log,
      .live_endpoint_checked,
      .live_route_status,
      .live_route_count,
      .live_missing_route_count,
      .expected_route_count
    )
  ' <<<"$report" | shasum -a 256 | cut -d ' ' -f1
)"
[[ "$actual_output_sha" == "$expected_output_sha" ]] || {
  echo "Hepta route gate normalized output parity mismatch for $id: $actual_output_sha != $expected_output_sha" >&2
  exit 1
}

printf '%s\n' "$report"
jq -r '.pass_message' <<<"$spec"
