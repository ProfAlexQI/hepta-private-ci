    store,
    '                    observed_at_ms: to_u64(row.try_get("observed_at_ms").map_err(unavailable)?)?,\n'
    '                })',
    '                    observed_at_ms: to_u64(row.try_get("observed_at_ms").map_err(unavailable)?)?,\n'
    '                    operation_id: row\n'
