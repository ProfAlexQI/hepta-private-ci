model_path = ROOT / "codex-rs/hepta-automation/src/model.rs"
shutil.copyfile(model_template, model_path)

store_path = ROOT / "codex-rs/hepta-automation/src/store.rs"
store = store_path.read_text(encoding="utf-8")
store = replace_once(
    store,
    "use codex_hepta_contracts::AgentId;\n",
    "use codex_hepta_contracts::AgentId;\n"
    "use codex_hepta_contracts::OperationPhase;\n"
    "use codex_hepta_contracts::OutboxEnvelope;\n"
    "use codex_hepta_contracts::Sha256Digest;\n",
    "store imports",
)
store = replace_once(
    store,
    '"SELECT o.task_id, o.occurrence, r.scheduled_for_ms,\n'
    '                    o.client_user_message_id, o.observed_at_ms\n',
    '"SELECT o.task_id, o.occurrence, r.scheduled_for_ms,\n'
