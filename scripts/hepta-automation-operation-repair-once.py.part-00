    '                        .try_get::<Option<String>, _>("operation_binding_sha256")\n'
    '                        .map_err(unavailable)?\n'
    '                        .map(Sha256Digest::parse)\n'
    '                        .transpose()\n'
    '                        .map_err(|_| AutomationError::Corrupt)?,\n'
    '                    operation_sequence: row\n'
