            Self::SetWindowVisuals(..) => write!(f, "SetWindowVisuals"),
            Self::ShowInDock(..) => write!(f, "ShowInDock"),
  RUST
  <<~'RUST'.chomp,
            Self::SetWindowVisuals(..) => write!(f, "SetWindowVisuals"),
            #[cfg(target_os = "windows")]
            Self::SetWindowVisualsCorrelated { .. } => {
                write!(f, "SetWindowVisualsCorrelated")
            }
            Self::ShowInDock(..) => write!(f, "ShowInDock"),
