run!("git", "diff", "--check", chdir: checkout)
changed_files = run!("git", "diff", "--name-only", chdir: checkout).lines.sort
raise PatchError, "changed file set drift: #{changed_files.inspect}" unless changed_files == EXPECTED_CHANGED_FILES

patched_blobs = changed_files.to_h do |relative|
  [relative, run!("git", "hash-object", relative, chdir: checkout)]
end
patch_text = run!("git", "diff", "--binary", chdir: checkout)

receipt = {
  schema: "hepta.ui.v4.vendored-makepad-windows-hook-patch.v1",
  status: "PASS_PATCH_APPLIED_TO_EXACT_WORKTREE_SOURCE_ONLY",
  makepad: {
    revision: REVISION,
    sourceBlobs: source_blob_results,
    patchedBlobs: patched_blobs,
    changedFiles: changed_files,
    diffSha256: Digest::SHA256.hexdigest(patch_text)
  },
  qualification: {
    patchAppliedInWorktree: true,
    defaultDependencySwitched: false,
    patchedMakepadCompile: false,
    heptaHookCompile: false,
    windowsRuntime: false,
    backdropReadback: false,
    transientSystemMaterial: false,
    completeProfile: false,
    systemMaterialBinding: false,
    nativeProductRuntime: false,
    deviceValidation: false
  },
  authority: {
    network: false,
    mutation: false,
    effect: false,
    liveAdapter: false,
    production: false,
    operatorAcceptance: false,
    promotion: false,
    release: false
  }
}
write_receipt(receipt_arg, receipt)
puts JSON.pretty_generate(receipt)
