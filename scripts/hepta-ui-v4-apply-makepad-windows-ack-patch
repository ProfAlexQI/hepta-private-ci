#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "open3"
require "pathname"

REVISION = "c4335cee10b22aca768510c9d072b0ca1bba15c8"
SOURCE_BLOBS = {
  "platform/src/lib.rs" => "fab92f77a3f431a7dae0098b8e304a74c69b5a85",
  "platform/src/cx_api.rs" => "87d871cd6414d67ed3da14f3a1a48f98940d0782",
  "platform/src/window.rs" => "8e6e9a9d41c34d654de6721f4956558a3eb649fe",
  "platform/src/os/windows/win32_window.rs" => "67899eceaf83e46dc8690f0e8be98ad4941abb3a",
  "platform/src/os/windows/windows.rs" => "58df661d9d84660fcca2ac960f5bcf5b36c52f3a"
}.freeze
EXPECTED_CHANGED_FILES = SOURCE_BLOBS.keys.sort.freeze

class PatchError < StandardError; end

def run!(*command, chdir:)
  stdout, stderr, status = Open3.capture3(*command, chdir: chdir.to_s)
  raise PatchError, "#{command.join(' ')} failed: #{stderr}" unless status.success?

  stdout.strip
end

def replace_once!(path, before, after, label)
  text = path.read
  count = text.scan(before).length
  raise PatchError, "#{label}: expected one exact source match, got #{count}" unless count == 1

  path.write(text.sub(before, after))
end

def write_receipt(path, payload)
  return unless path

  destination = Pathname.new(path).expand_path
  destination.dirname.mkpath
  temporary = destination.sub_ext(".tmp")
  temporary.write(JSON.pretty_generate(payload) + "\n")
  File.rename(temporary, destination)
end

checkout_arg = ARGV.shift or abort "usage: #{$PROGRAM_NAME} MAKEPAD_CHECKOUT [RECEIPT_JSON]"
receipt_arg = ARGV.shift
abort "unexpected arguments" unless ARGV.empty?

checkout = Pathname.new(checkout_arg).expand_path
raise PatchError, "checkout is not a directory" unless checkout.directory?
raise PatchError, "checkout is not a git worktree" unless checkout.join(".git").exist?

head = run!("git", "rev-parse", "HEAD", chdir: checkout)
raise PatchError, "revision drift: #{head}" unless head == REVISION

source_blob_results = {}
SOURCE_BLOBS.each do |relative, expected|
  path = checkout.join(relative)
  raise PatchError, "missing source file: #{relative}" unless path.file?

  actual = run!("git", "hash-object", relative, chdir: checkout)
  raise PatchError, "source blob drift for #{relative}: #{actual}" unless actual == expected
  source_blob_results[relative] = actual
end

