  checkout.join("platform/src/window.rs"),
  <<~'RUST'.chomp,
    impl WindowVisuals {
        pub fn normalized(mut self) -> Self {
            self.backdrop_intensity = self.backdrop_intensity.clamp(0.0, 1.0);
            self
        }
    }

    impl WindowId {
  RUST
  <<~'RUST'.chomp,
    impl WindowVisuals {
        pub fn normalized(mut self) -> Self {
            self.backdrop_intensity = self.backdrop_intensity.clamp(0.0, 1.0);
            self
        }
    }

    /// Ordered Windows UI-thread evidence emitted after a correlated window
    /// visual request is processed, or immediately before the exact native
    /// window is removed from the backend window set.
    #[derive(Clone, Copy, Debug, PartialEq)]
    pub enum WindowsWindowVisualsHookEvent {
        Processed {
            request_sequence: u64,
            window_id: WindowId,
            native_window_handle: isize,
            visuals: WindowVisuals,
            backend_apply_succeeded: bool,
            is_popup: bool,
        },
        Destroyed {
            window_id: WindowId,
            native_window_handle: isize,
        },
    }

    #[cfg(target_os = "windows")]
    const WINDOWS_WINDOW_VISUALS_HOOK_QUEUE_LIMIT: usize = 256;

    #[cfg(target_os = "windows")]
    thread_local! {
        static WINDOWS_WINDOW_VISUALS_HOOK_EVENTS: RefCell<VecDeque<WindowsWindowVisualsHookEvent>> =
            RefCell::new(VecDeque::new());
    }

    #[cfg(target_os = "windows")]
    pub(crate) fn push_windows_window_visuals_hook_event(
        event: WindowsWindowVisualsHookEvent,
    ) {
        WINDOWS_WINDOW_VISUALS_HOOK_EVENTS.with_borrow_mut(|events| {
            if events.len() >= WINDOWS_WINDOW_VISUALS_HOOK_QUEUE_LIMIT {
                events.pop_front();
            }
            events.push_back(event);
        });
    }

    /// Drains correlated Windows visual hook events in backend processing order.
    /// The queue is Windows UI-thread-local and never performs HWND discovery.
    #[cfg(target_os = "windows")]
    pub fn take_windows_window_visuals_hook_events() -> Vec<WindowsWindowVisualsHookEvent> {
        WINDOWS_WINDOW_VISUALS_HOOK_EVENTS.with_borrow_mut(|events| events.drain(..).collect())
    }

    #[cfg(not(target_os = "windows"))]
    pub fn take_windows_window_visuals_hook_events() -> Vec<WindowsWindowVisualsHookEvent> {
        Vec::new()
    }

    impl WindowId {
  RUST
  "Windows hook event queue"
)

replace_once!(
  checkout.join("platform/src/window.rs"),
  <<~'RUST'.chomp,
        pub fn set_window_visuals(&mut self, cx: &mut Cx, visuals: WindowVisuals) {
            let visuals = visuals.normalized();
            let window_id = self.window_id();
            if cx.windows[window_id].window_visuals() != visuals {
                cx.windows[window_id].transparent = visuals.transparent;
                cx.windows[window_id].backdrop = visuals.backdrop;
                cx.windows[window_id].backdrop_intensity = visuals.backdrop_intensity;
                if cx.windows[window_id].is_created {
                    cx.push_unique_platform_op(CxOsOp::SetWindowVisuals(window_id, visuals));
                }
            }
        }

        pub fn set_transparent(&mut self, cx: &mut Cx, transparent: bool) {
  RUST
  <<~'RUST'.chomp,
        pub fn set_window_visuals(&mut self, cx: &mut Cx, visuals: WindowVisuals) {
            let visuals = visuals.normalized();
            let window_id = self.window_id();
            if cx.windows[window_id].window_visuals() != visuals {
                cx.windows[window_id].transparent = visuals.transparent;
                cx.windows[window_id].backdrop = visuals.backdrop;
                cx.windows[window_id].backdrop_intensity = visuals.backdrop_intensity;
                if cx.windows[window_id].is_created {
                    cx.push_unique_platform_op(CxOsOp::SetWindowVisuals(window_id, visuals));
                }
            }
        }

        /// Queues one correlated Windows visual operation only when the
        /// normalized state actually changes on an already-created window.
        #[cfg(target_os = "windows")]
        pub fn set_window_visuals_correlated(
            &mut self,
            cx: &mut Cx,
            visuals: WindowVisuals,
            request_sequence: u64,
        ) -> bool {
            let visuals = visuals.normalized();
            let window_id = self.window_id();
            if cx.windows[window_id].window_visuals() == visuals {
                return false;
            }
            cx.windows[window_id].transparent = visuals.transparent;
            cx.windows[window_id].backdrop = visuals.backdrop;
            cx.windows[window_id].backdrop_intensity = visuals.backdrop_intensity;
            if !cx.windows[window_id].is_created {
                return false;
            }
            cx.push_unique_platform_op(CxOsOp::SetWindowVisualsCorrelated {
                window_id,
                visuals,
                request_sequence,
            });
            true
        }

        pub fn set_transparent(&mut self, cx: &mut Cx, transparent: bool) {
  RUST
  "correlated WindowHandle setter"
)

