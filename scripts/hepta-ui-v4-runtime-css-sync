#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "pathname"

ROOT = Pathname.new(__dir__).join("..").expand_path
V4 = ROOT.join("apps/hepta-control-ui/styles.v4.css")
RUNTIME = ROOT.join("apps/hepta-control-ui/styles.v4.runtime.css")
ACCESSIBILITY_BASE = ROOT.join("apps/hepta-control-ui/styles.accessibility.base.css")
OUTPUT = ROOT.join("apps/hepta-control-ui/styles.accessibility.css")
HEADER = <<~CSS.freeze
  /* @generated by scripts/hepta-ui-v4-runtime-css-sync; do not edit directly. */
  /* order: semantic v4 overlay -> executable runtime states -> system accessibility */

CSS

mode = case ARGV
       when [], ["--check"] then :check
       when ["--write"] then :write
       else
         abort("usage: #{File.basename($PROGRAM_NAME)} [--check|--write]")
       end

[V4, RUNTIME, ACCESSIBILITY_BASE].each do |path|
  abort("missing CSS input: #{path}") unless path.file?
end

v4 = V4.read.rstrip
runtime = RUNTIME.read.rstrip
accessibility = ACCESSIBILITY_BASE.read.lstrip

abort("v4 stable content must explicitly disable backdrop blur") unless v4.match?(/Stable content role.*?backdrop blur is forbidden/m)
abort("runtime sheet lock marker missing") unless runtime.include?('data-hepta-v4-sheet-open="true"')
abort("runtime read-state marker missing") unless runtime.include?("data-hepta-v4-read-state")
abort("accessibility base must retain reduced-transparency fallback") unless accessibility.include?("prefers-reduced-transparency: reduce")
abort("accessibility base must retain forced-colors fallback") unless accessibility.include?("forced-colors: active")
abort("accessibility base must retain reduced-motion fallback") unless accessibility.include?("prefers-reduced-motion: reduce")

expected = [HEADER.rstrip, v4, runtime, accessibility.rstrip, ""].join("\n\n")

if mode == :write
  OUTPUT.write(expected)
else
  abort("generated accessibility tail is stale; run --write") unless OUTPUT.file? && OUTPUT.read == expected
end

puts JSON.pretty_generate(
  schema: "hepta.ui.v4.runtime-css-binding.v1",
  status: "PASS_SOURCE_BINDING_ONLY",
  output: OUTPUT.relative_path_from(ROOT).to_s,
  inputs: [V4, RUNTIME, ACCESSIBILITY_BASE].map do |path|
    {
      path: path.relative_path_from(ROOT).to_s,
      sha256: Digest::SHA256.file(path).hexdigest,
      bytes: path.size
    }
  end,
  output_sha256: Digest::SHA256.file(OUTPUT).hexdigest,
  runtime_validation: false,
  browser_validation: false,
  device_validation: false,
  production_authority: false,
  effect_authority: false,
  promotion: false
)
