      and .public_ga_claimed == false
    ' <<<"$source_json" >/dev/null

  static_mention_count="$(
    grep -Eci 'summary|briefing|readback|digest|status|banner|card|timeline|narrative|memo|completion|channel|telegram|external|authority|install|restart|active-binary|credential|secret|provider|model|public|release|ga|receipt|ack' "$denial_gate" || true
  )"

  jq -n \
    --argjson source "$source_json" \
