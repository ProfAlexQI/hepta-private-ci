render_signing_summary_attachment() {
  local denial_gate
  local denial_doc
  denial_gate="$(resolve_repo_file "$denial_gate_rel")" || {
    echo "missing $denial_subject denial gate: $ROOT/$denial_gate_rel" >&2
    exit 1
  }
  denial_doc="$(resolve_repo_file "$denial_doc_rel")" || {
    echo "missing $denial_subject denial doc: $ROOT/$denial_doc_rel" >&2
    exit 1
  }
  [[ -f "$denial_gate" ]] || {
    echo "missing $denial_subject denial gate: $denial_gate" >&2
    exit 1
  }
  [[ -f "$denial_doc" ]] || {
    echo "missing $denial_subject denial doc: $denial_doc" >&2
    exit 1
  }

  local source_json source_blocker_count static_mention_count
  source_json="$(run_repo_executable "$source_report_rel" "$missing_source_message")"
  source_blocker_count="$((blocker_count - 2))"
  jq -e \
    --arg source_surface "$attachment_surface" \
    --arg source_ready_key "${attachment_surface}_ready" \
    --arg source_blocked_key "${attachment_surface}_blocked" \
    --argjson source_blocker_count "$source_blocker_count" \
    '
      .surface == $source_surface
      and .[$source_ready_key] == true
      and .[$source_blocked_key] == true
      and .final_blocker_count == $source_blocker_count
      and .signing_receipt_query_registered == false
      and .signing_receipt_export_file_written == false
