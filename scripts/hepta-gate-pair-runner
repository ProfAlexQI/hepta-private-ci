#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE_OVERRIDE="${HEPTA_GATE_PAIR_SPEC_FILE:-}"
SPEC_FILE="${SPEC_FILE_OVERRIDE:-$ROOT/scripts/hepta-gate-pair-specs-v1.json}"
COMPAT_EXECUTOR="$ROOT/scripts/hepta-gate-pair-compat-exec"
PAYLOAD_BUNDLE="$ROOT/scripts/hepta-gate-pair-payload-bundle"
FAMILY_STATE_MACHINE="$ROOT/scripts/hepta-gate-compat-family-state-machine"
LONG_PATH_RESOLVER="$ROOT/scripts/hepta-long-path-resolve"
source "$ROOT/scripts/lib/hepta-gate-pair-terminal-status-v1.sh"
source "$ROOT/scripts/lib/hepta-gate-pair-terminal-final-index-v1.sh"
source "$ROOT/scripts/lib/hepta-gate-pair-public-status-v1.sh"
source "$ROOT/scripts/lib/hepta-gate-pair-public-status-final-index-v1.sh"
usage() {
  printf '%s\n' 'usage: scripts/hepta-gate-pair-runner <report|gate> <id>' >&2
  exit 2
}

[[ $# == 2 ]] || usage
kind="$1"
id="$2"
[[ "$kind" == "report" || "$kind" == "gate" ]] || usage
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}
[[ -f "$SPEC_FILE" ]] || {
  echo "missing Hepta gate pair spec registry: $SPEC_FILE" >&2
  exit 1
}
if [[ -n "${HEPTA_GATE_PAIR_SPEC_FILE:-}" ]]; then
  [[ "$SPEC_FILE" == /* && "${HEPTA_GATE_PAIR_SPEC_FILE_SHA256:-}" =~ ^[0-9a-f]{64}$ ]] || {
    echo "invalid SHA-bound Hepta compatibility spec override" >&2
    exit 1
  }
  [[ "$(shasum -a 256 "$SPEC_FILE" | awk '{print $1}')" == "$HEPTA_GATE_PAIR_SPEC_FILE_SHA256" ]] || {
    echo "Hepta compatibility spec override SHA-256 drifted" >&2
    exit 1
  }
fi

resolve_repo_file() {
  local logical_path="$1"
  local relocated_path
  local compatibility_root
  if [[ -e "$ROOT/$logical_path" ]]; then
    printf '%s\n' "$ROOT/$logical_path"
    return
  fi
  relocated_path="$("$LONG_PATH_RESOLVER" "$logical_path")"
  if [[ -e "$ROOT/$relocated_path" ]]; then
    printf '%s\n' "$ROOT/$relocated_path"
    return
  fi
  compatibility_root="${HEPTA_COMPAT_OVERLAY_ROOT:-}"
  if [[ -z "$compatibility_root" ]]; then
    compatibility_root="$("$PAYLOAD_BUNDLE" materialize-overlay)"
  fi
  if [[ -e "$compatibility_root/$logical_path" ]]; then
    printf '%s\n' "$compatibility_root/$logical_path"
    return
  fi
  return 1
}

use_compatibility_overlay_root() {
  local compatibility_root="${HEPTA_COMPAT_OVERLAY_ROOT:-}"
  if [[ -z "$compatibility_root" ]]; then
    compatibility_root="$("$PAYLOAD_BUNDLE" materialize-overlay)"
    export HEPTA_COMPAT_OVERLAY_ROOT="$compatibility_root"
  fi
  [[ -d "$compatibility_root" ]] || {
    echo "missing Hepta gate-pair compatibility overlay: $compatibility_root" >&2
    exit 1
  }
  ROOT="$compatibility_root"
}

run_repo_executable() {
  local logical_path="$1"
  local missing_message="$2"
  local executable
  executable="$(resolve_repo_file "$logical_path")" || {
    echo "$missing_message: $ROOT/$logical_path" >&2
    return 1
  }
  [[ -x "$executable" ]] || {
    echo "$missing_message: $executable" >&2
    return 1
  }
  "$executable"
}

spec="$(jq -cer --arg id "$id" '.pairs[] | select(.id == $id)' "$SPEC_FILE")" || {
  echo "unknown Hepta migrated gate pair id: $id" >&2
  exit 1
}

source_report_rel="$(jq -r '.source_report' <<<"$spec")"
report_rel="$(jq -r '.report_path' <<<"$spec")"
template="$(jq -r '.template' <<<"$spec")"
receipt_state="$(jq -r '.receipt_state' <<<"$spec")"
attachment_surface="$(jq -r '.attachment_surface' <<<"$spec")"
readback_surface="$(jq -r '.readback_surface' <<<"$spec")"
acknowledgement_prefix="$(jq -r '.acknowledgement_prefix' <<<"$spec")"
summary_prefix="$(jq -r '.summary_prefix' <<<"$spec")"
observability_prefix="$(jq -r '.observability_prefix // empty' <<<"$spec")"
final_ack_denial_side_effect_key="$(jq -r '.final_ack_denial_side_effect_key // empty' <<<"$spec")"
denial_gate_rel="$(jq -r '.denial_gate // empty' <<<"$spec")"
denial_doc_rel="$(jq -r '.denial_doc // empty' <<<"$spec")"
denial_subject="$(jq -r '.denial_subject // empty' <<<"$spec")"
blocker_count="$(jq -r '.blocker_count' <<<"$spec")"
next_migration_step="$(jq -r '.next_migration_step' <<<"$spec")"
missing_source_message="$(jq -r '.missing_source_message' <<<"$spec")"
missing_report_message="$(jq -r '.missing_report_message' <<<"$spec")"
pass_message="$(jq -r '.pass_message' <<<"$spec")"
gate_implementation="$(jq -r '.gate_implementation // empty' <<<"$spec")"
gate_implementation_sha256="$(jq -r '.gate_implementation_sha256 // empty' <<<"$spec")"
report_implementation="$(jq -r '.report_implementation // empty' <<<"$spec")"
report_implementation_sha256="$(jq -r '.report_implementation_sha256 // empty' <<<"$spec")"
typed_report_runner="$(jq -r '.typed_report_runner // empty' <<<"$spec")"
typed_report_runner_sha256="$(jq -r '.typed_report_runner_sha256 // empty' <<<"$spec")"
typed_report_registry="$(jq -r '.typed_report_registry // empty' <<<"$spec")"
typed_report_registry_sha256="$(jq -r '.typed_report_registry_sha256 // empty' <<<"$spec")"
typed_report_source_sha256="$(jq -r '.typed_report_source_sha256 // empty' <<<"$spec")"
typed_report_cli_source="$(jq -r '.typed_report_cli_source // empty' <<<"$spec")"
typed_report_cli_source_sha256="$(jq -r '.typed_report_cli_source_sha256 // empty' <<<"$spec")"

[[ "$template" == "captured_shell_compat_v1" \
  || "$template" == "legacy_workgraph_projection_v1" \
  || "$template" == "typed_rust_report_v1" \
  || "$source_report_rel" == scripts/*-report.sh ]] || {
  echo "invalid Hepta migrated source report path for: $id" >&2
  exit 1
}
[[ "$report_rel" == "scripts/$id-report.sh" ]] || {
  echo "invalid Hepta migrated report path for: $id" >&2
  exit 1
}
[[ "$receipt_state" == "precondition" || "$receipt_state" == "denial" || "$receipt_state" == "receipt" || "$receipt_state" == "persistence" || "$receipt_state" == "retention" || "$receipt_state" == "terminal" ]] || {
  echo "unexpected Hepta migrated receipt state for: $id" >&2
  exit 1
}
[[ "$template" == "captured_shell_compat_v1" || "$template" == "legacy_workgraph_projection_v1" || "$template" == "compat_family_state_machine_v1" || "$template" == "typed_rust_report_v1" || "$template" == "signing_final_ack_readback" || "$template" == "signing_final_ack_final_index" || "$template" == "signing_terminal_status_attachment" || "$template" == "signing_terminal_status_final_index" || "$template" == "signing_terminal_status_readback" || "$template" == "signing_public_status_attachment" || "$template" == "signing_public_status_readback" || "$template" == "signing_public_status_final_index" || "$template" == "signing_summary_attachment" || "$template" == "signing_summary_readback" ]] || {
  echo "unexpected Hepta migrated pair template for: $id" >&2
  exit 1
}
[[ "$template" != "signing_summary_readback" || -n "$observability_prefix" ]] || {
  echo "missing Hepta migrated summary observability prefix for: $id" >&2
  exit 1
}
[[ "$template" != "signing_summary_attachment" || ( "$denial_gate_rel" == scripts/*-gate.sh && "$denial_doc_rel" == docs/architecture/*.md && -n "$denial_subject" && "$blocker_count" -ge 2 ) ]] || {
  echo "invalid Hepta migrated summary attachment contract for: $id" >&2
  exit 1
}
[[ "$template" != "signing_final_ack_final_index" || -n "$final_ack_denial_side_effect_key" ]] || {
  echo "missing Hepta migrated final-index denial side-effect key for: $id" >&2
  exit 1
}

owned_capture_cache=""
if [[ -z "${HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR:-}" && ( "$template" == "captured_shell_compat_v1" || "$template" == "legacy_workgraph_projection_v1" || "$template" == "compat_family_state_machine_v1" ) ]]; then
  owned_capture_cache="$(mktemp -d "${TMPDIR:-/tmp}/hepta-report-dag.XXXXXX")"
  export HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR="$owned_capture_cache"
  trap 'rm -rf "$owned_capture_cache"' EXIT
fi

execute_captured_shell_compat() {
  local implementation expected_sha compatibility_root compatibility_executor
  if [[ "$kind" == "gate" ]]; then
    implementation="$gate_implementation"
    expected_sha="$gate_implementation_sha256"
  else
    implementation="$report_implementation"
    expected_sha="$report_implementation_sha256"
  fi

  [[ "$implementation" == scripts/lib/hepta-gate-pair-compat-v1/*.$kind ]] || {
    echo "invalid captured Hepta $kind implementation path for: $id" >&2
    exit 1
  }
  [[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo "invalid captured Hepta $kind implementation SHA-256 for: $id" >&2
    exit 1
  }
  [[ -x "$PAYLOAD_BUNDLE" ]] || {
    echo "missing Hepta gate-pair payload bundle: $PAYLOAD_BUNDLE" >&2
    exit 1
  }
  compatibility_root="${HEPTA_COMPAT_OVERLAY_ROOT:-}"
  if [[ -z "$compatibility_root" ]]; then
    compatibility_root="$("$PAYLOAD_BUNDLE" materialize-overlay)"
    export HEPTA_COMPAT_OVERLAY_ROOT="$compatibility_root"
  fi
  [[ -d "$compatibility_root" ]] || {
    echo "missing Hepta gate-pair compatibility overlay: $compatibility_root" >&2
    exit 1
  }
  implementation="$compatibility_root/$implementation"
  compatibility_executor="$compatibility_root/scripts/hepta-gate-pair-compat-exec"
  [[ -f "$implementation" && -x "$compatibility_executor" ]] || {
    echo "incomplete Hepta gate-pair compatibility overlay: $compatibility_root" >&2
    exit 1
  }

  # Evaluate inside this stable top-level runner so legacy BASH_SOURCE-based
  # repo-root discovery still resolves to scripts/ while the old pair bodies
  # live in a content-addressed compatibility store.
  export HEPTA_REPO_ROOT="$compatibility_root"
  export HEPTA_COMPAT_SOURCE_REPO_ROOT="$ROOT"
  export HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET="$compatibility_root/scripts/lib/hepta-runtime-crate-root-source-set-v1.sh"
  [[ -x "$HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET" ]] || {
    echo "missing Hepta runtime crate-root source-set resolver: $HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET" >&2
    exit 1
  }

  # Captured reports historically treated hepta-runtime/src/lib.rs as the
  # whole crate root. The runtime now keeps crate-root exports in direct
  # include! files, so searching lib.rs alone produces false negatives. Keep
  # the content-addressed payloads immutable and adapt only the exact legacy
  # grep/rg target through a fail-closed crate-root source-set resolver.
  hepta_context_test_source_path() {
    case "$1" in
      "$HEPTA_REPO_ROOT/codex-rs/hepta-core/src/memory/tests/eval_harness.rs")
        printf '%s\n' "$HEPTA_COMPAT_SOURCE_REPO_ROOT/codex-rs/hepta-core/tests/memory_eval_harness.rs"
        ;;
      "$HEPTA_REPO_ROOT/codex-rs/hepta-core/src/memory/tests/recall_memory/taxonomy.rs")
        printf '%s\n' "$HEPTA_COMPAT_SOURCE_REPO_ROOT/codex-rs/hepta-core/tests/memory_recall_contracts/taxonomy.rs"
        ;;
      "$HEPTA_REPO_ROOT/codex-rs/hepta-core/src/memory/tests/recall_memory/temporal.rs")
        printf '%s\n' "$HEPTA_COMPAT_SOURCE_REPO_ROOT/codex-rs/hepta-core/tests/memory_recall_contracts/temporal.rs"
        ;;
      *)
        return 1
        ;;
    esac
  }
  hepta_compat_release_manifest_contains() {
    local logical_path="$1"
    [[ "$logical_path" =~ ^scripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(gate|report)$ ]] || return 1
    jq -e --arg logical_path "$logical_path" '
      any(
        .pairs[];
        ([
          .gate_implementation?,
          .report_implementation?,
          .source_report?,
          .report_path?
        ] | any(. == $logical_path))
      )
    ' "$HEPTA_COMPAT_SOURCE_REPO_ROOT/scripts/hepta-gate-pair-specs-v1.json" >/dev/null
  }
  grep() {
    local last_argument=""
    local mapped_argument=""
    local manifest_query=""
    local -a arguments=("$@")
    if [[ $# -gt 0 ]]; then
      last_argument="${!#}"
    fi
    if [[ ${#arguments[@]} -ge 2 \
      && "$last_argument" == "$HEPTA_REPO_ROOT/codex-rs/CONTEXT_LANE_RELEASE_MANIFEST.tsv" ]]; then
      manifest_query="${arguments[$((${#arguments[@]} - 2))]}"
    fi
    if [[ -n "$manifest_query" ]] && hepta_compat_release_manifest_contains "$manifest_query"; then
      printf '%s\n' "$manifest_query"
    elif [[ "$last_argument" == "$HEPTA_REPO_ROOT/codex-rs/hepta-runtime/src/lib.rs" ]]; then
      "$HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET" grep "$@"
    elif mapped_argument="$(hepta_context_test_source_path "$last_argument")"; then
      arguments[$((${#arguments[@]} - 1))]="$mapped_argument"
      command grep "${arguments[@]}"
    else
      command grep "$@"
    fi
  }
  rg() {
    local last_argument=""
    local mapped_argument=""
    local -a arguments=("$@")
    if [[ $# -gt 0 ]]; then
      last_argument="${!#}"
    fi
    if [[ "$last_argument" == "$HEPTA_REPO_ROOT/codex-rs/hepta-runtime/src/lib.rs" ]]; then
      "$HEPTA_RUNTIME_CRATE_ROOT_SOURCE_SET" rg "$@"
    elif mapped_argument="$(hepta_context_test_source_path "$last_argument")"; then
      arguments[$((${#arguments[@]} - 1))]="$mapped_argument"
      command rg "${arguments[@]}"
    else
      command rg "$@"
    fi
  }
  cargo() {
    local package=""
    local filter=""
    local integration_suite=""
    local pinned_cargo="$HEPTA_COMPAT_SOURCE_REPO_ROOT/scripts/hepta-rust-cargo"
    local lib_index="-1"
    local index
    local -a arguments=("$@")
    local -a rewritten=()

    [[ -x "$pinned_cargo" ]] || {
      echo "missing pinned Hepta Cargo entrypoint: $pinned_cargo" >&2
      return 1
    }

    for ((index = 0; index < ${#arguments[@]}; index++)); do
      if [[ "${arguments[$index]}" == "-p" && $((index + 1)) -lt ${#arguments[@]} ]]; then
        package="${arguments[$((index + 1))]}"
      elif [[ "${arguments[$index]}" == "--lib" ]]; then
        lib_index="$index"
      fi
    done
    if [[ "$package" == "hepta-core" && "$lib_index" -ge 0 ]]; then
      for filter in \
        adaptive_allocator_eval_shadow \
        memory_eval \
        ranked_recall_shadow \
        shadow_canary_promotion_negative_rehearsal \
        shadow_canary_promotion_readiness \
        shadow_quality_summary \
        shadow_regression_dashboard \
        trend_snapshot; do
        if [[ " ${arguments[*]} " == *" $filter "* ]]; then
          integration_suite="memory_eval_harness"
          break
        fi
      done
      if [[ -z "$integration_suite" ]]; then
        for filter in \
          context_memory_namespace_policy \
          context_memory_write_chain \
          memory_temporal \
          temporal_graph_shadow \
          temporal_graph_shadow_replay \
          temporal_graph_shadow_store \
          write_chain_receipt; do
          if [[ " ${arguments[*]} " == *" $filter "* ]]; then
            integration_suite="memory_recall_contracts"
            break
          fi
        done
      fi
    fi
    if [[ -z "$integration_suite" ]]; then
      "$pinned_cargo" "$@"
      return
    fi
    for ((index = 0; index < ${#arguments[@]}; index++)); do
      if [[ "$index" -eq "$lib_index" ]]; then
        rewritten+=(--test "$integration_suite")
      else
        rewritten+=("${arguments[$index]}")
      fi
    done
    "$pinned_cargo" "${rewritten[@]}"
  }
  git() {
    local working_directory=""
    local mapped_working_directory=""
    if [[ $# -ge 2 && "$1" == "-C" ]]; then
      working_directory="$2"
      if [[ "$working_directory" == "$HEPTA_REPO_ROOT" \
        || "$working_directory" == "$HEPTA_REPO_ROOT/"* ]]; then
        mapped_working_directory="$HEPTA_COMPAT_SOURCE_REPO_ROOT${working_directory#"$HEPTA_REPO_ROOT"}"
        shift 2
        command git -C "$mapped_working_directory" "$@"
        return
      fi
    fi
    command git "$@"
  }
  export -f hepta_context_test_source_path hepta_compat_release_manifest_contains grep rg cargo git
  export HEPTA_GATE_COMPAT_CALLER_ID="$id"
  unset HEPTA_GATE_PAIR_SPEC_FILE HEPTA_GATE_PAIR_SPEC_FILE_SHA256
  if [[ -n "$SPEC_FILE_OVERRIDE" ]]; then
    [[ "$(shasum -a 256 "$implementation" | awk '{print $1}')" == "$expected_sha" ]] || {
      echo "captured Hepta $kind implementation SHA-256 mismatch: $id" >&2
      exit 1
    }
    bash "$implementation"
  else
    "$compatibility_executor" "$implementation"
  fi
}

execute_compat_family_state_machine() {
  [[ -x "$FAMILY_STATE_MACHINE" ]] || {
    echo "missing Hepta compatibility family state machine: $FAMILY_STATE_MACHINE" >&2
    exit 1
  }
  "$FAMILY_STATE_MACHINE" exec "$kind" "$id"
}

typed_report_contract() {
  local suffix source_stem
  case "$id" in
    hepta-context-plane-*)
      suffix="${id#hepta-context-plane-}"
      source_stem="context_plane_${suffix//-/_}"
      printf '%s\t%s\n' "$id" "${source_stem}_typed_v1"
      ;;
    hepta-context-memory-*)
      suffix="${id#hepta-context-memory-}"
      source_stem="context_memory_${suffix//-/_}"
      printf '%s\t%s\n' "hepta_${source_stem}_gate" "${source_stem}_v1"
      ;;
    hepta-systems-controlled-*)
      suffix="${id#hepta-systems-}"
      source_stem="${suffix//-/_}"
      case "$id" in
        hepta-systems-controlled-live-readiness-audit|hepta-systems-controlled-live-readiness-denial-readback-index|hepta-systems-controlled-live-operator-packet-preview|hepta-systems-controlled-live-operator-packet-non-send-readback|hepta-systems-controlled-live-required-evidence-collection-plan|hepta-systems-controlled-live-required-evidence-readback-index)
          printf '%s\t%s\n' "${source_stem}_gate" "${source_stem}_v2"
          ;;
        *)
          printf '%s\t%s\n' "${source_stem}_gate" "${source_stem}_v1"
          ;;
      esac
      ;;
    hepta-systems-current-reality-capability-matrix)
      printf '%s\t%s\n' \
        "hepta_systems_current_reality_capability_matrix_gate" \
        "current_reality_capability_matrix_v2"
      ;;
    hepta-systems-dirty-worktree-*)
      suffix="${id#hepta-systems-}"
      source_stem="${suffix//-/_}"
      if [[ "$suffix" == "dirty-worktree-release-boundary-owner-freeze-classification-rehearsal" ]]; then
        printf '%s\t%s\n' \
          "${source_stem}_without_git_mutation_gate" \
          "${source_stem}_v1"
      else
        printf '%s\t%s\n' "${source_stem}_gate" "${source_stem}_v1"
      fi
      ;;
    hepta-systems-plugin-*)
      suffix="${id#hepta-systems-plugin-}"
      source_stem="plugin_${suffix//-/_}"
      printf '%s\t%s\n' "$id" "${source_stem}_typed_v1"
      ;;
    hepta-systems-work-graph-*)
      suffix="${id#hepta-systems-work-graph-}"
      source_stem="work_graph_${suffix//-/_}"
      printf '%s\t%s\n' "hepta_${source_stem}_gate" "${source_stem}_v1"
      ;;
    hepta-systems-workflow-temporal-lite-*)
      suffix="${id#hepta-systems-workflow-temporal-lite-}"
      source_stem="workflow_temporal_lite_${suffix//-/_}"
      printf '%s\t%s\n' "${source_stem}_gate" "${source_stem}_v1"
      ;;
    hepta-systems-workflow-durable-store-*)
      suffix="${id#hepta-systems-workflow-durable-store-}"
      source_stem="workflow_durable_store_${suffix//-/_}"
      printf '%s\t%s\n' "hepta_${source_stem}_gate" "${source_stem}_v1"
      ;;
    *)
      echo "unsupported typed Hepta report id: $id" >&2
      return 1
      ;;
  esac
}

execute_typed_rust_report() {
  local runner registry source cli_source expected_gate expected_schema json
  local actual_runner_sha actual_registry_sha actual_source_sha actual_cli_source_sha

  [[ "$source_report_rel" == "codex-rs/hepta-runtime/src/typed_compat_report.rs" \
    && "$typed_report_runner" == scripts/* \
    && "$typed_report_registry" == scripts/*.json \
    && "$typed_report_cli_source" == "codex-rs/hepta-runtime/src/bin/hepta-compat-report.rs" ]] || {
    echo "invalid typed Hepta report binding for: $id" >&2
    exit 1
  }
  runner="$ROOT/$typed_report_runner"
  registry="$ROOT/$typed_report_registry"
  source="$ROOT/$source_report_rel"
  cli_source="$ROOT/$typed_report_cli_source"
  [[ -x "$runner" && -f "$registry" && -f "$source" && -f "$cli_source" ]] || {
    echo "missing typed Hepta report binding for: $id" >&2
    exit 1
  }
  actual_runner_sha="$(shasum -a 256 "$runner" | awk '{print $1}')"
  actual_registry_sha="$(shasum -a 256 "$registry" | awk '{print $1}')"
  actual_source_sha="$(shasum -a 256 "$source" | awk '{print $1}')"
  actual_cli_source_sha="$(shasum -a 256 "$cli_source" | awk '{print $1}')"
  [[ "$actual_runner_sha" == "$typed_report_runner_sha256" \
    && "$actual_registry_sha" == "$typed_report_registry_sha256" \
    && "$actual_source_sha" == "$typed_report_source_sha256" \
    && "$actual_cli_source_sha" == "$typed_report_cli_source_sha256" ]] || {
    echo "typed Hepta report binding SHA-256 drifted for: $id" >&2
    exit 1
  }
  jq -e --arg id "$id" '
    .schema == "hepta_gate_typed_report_bindings_v2"
    and .status == "ready"
    and (.report_ids | index($id) != null)
    and (.report_ids | length == (unique | length))
  ' "$registry" >/dev/null || {
    echo "unregistered typed Hepta report binding: $id" >&2
    exit 1
  }
  IFS=$'\t' read -r expected_gate expected_schema < <(typed_report_contract)
  json="$("$runner" "$id")"
  jq -e \
    --arg expected_gate "$expected_gate" \
    --arg expected_schema "$expected_schema" \
    '
      type == "object"
      and .runtime == "hepta"
      and (.product == null or .product == "Hepta" or .product == "hepta")
      and (.status | type == "string" and length > 0)
      and .gate == $expected_gate
      and .schema_version == $expected_schema
      and (.side_effects | type == "object" and length > 0)
      and (.side_effects | to_entries | all(.value == false))
      and ([
        .. | objects | to_entries[]
        | select(.key as $key | [
            "production_authority_granted",
            "ready_for_live_execution",
            "live_execution_enabled",
            "live_execution_allowed",
            "mutation_enabled",
            "provider_invoked",
            "model_invoked",
            "credential_read",
            "external_send_performed",
            "channel_send_performed",
            "filesystem_written",
            "runtime_mutation_performed",
            "graph_state_persisted",
            "workflow_execution_allowed",
            "runtime_store_persistence_allowed",
            "runtime_sqlite_write_allowed",
            "runtime_event_log_write_allowed",
            "rollback_execution_allowed",
            "replay_execution_allowed"
          ] | index($key))
        | .value
      ] | all(. == false))
    ' <<<"$json" >/dev/null || {
    echo "typed Hepta report contract failed closed for: $id" >&2
    exit 1
  }

  if [[ "$kind" == "report" ]]; then
    printf '%s\n' "$json"
  else
    printf '%s\n' "$pass_message"
  fi
}

verify_legacy_workgraph_projection() {
  local report
  local route="${id#hepta-systems-work-graph-}"
  local source_stem="work_graph_${route//-/_}"
  local rust_source="$ROOT/codex-rs/hepta-runtime/src/$source_stem.rs"
  local expected_gate="hepta_${source_stem}_gate"
  local expected_schema="${source_stem}_v1"

  report="$(resolve_repo_file "$report_rel")" || {
    echo "$missing_report_message: $ROOT/$report_rel" >&2
    exit 1
  }
  "$ROOT/scripts/hepta-workgraph-module-bundle" contains "$source_stem" || {
    echo "missing bundled legacy WorkGraph projection source: $source_stem" >&2
    exit 1
  }

  local json
  json="$("$report")"
  printf '%s\n' "$json"
  jq -e \
    --arg expected_gate "$expected_gate" \
    --arg expected_schema "$expected_schema" \
    '
      .product == "Hepta"
      and .runtime == "hepta"
      and (.status == "ready" or .status == "blocked")
      and .gate == $expected_gate
      and .schema_version == $expected_schema
      and .required_prior_gate_count == (.required_prior_gates | length)
      and (.required_prior_gates | length == (unique | length))
      and .ready_for_live_execution == false
      and ([.source_probes | .. | select(type == "boolean")] | length > 0 and all)
      and (.side_effects | to_entries | all(.value == false))
    ' <<<"$json" >/dev/null

  cargo test --manifest-path "$ROOT/codex-rs/Cargo.toml" -p hepta-runtime \
    "$source_stem" --lib
  printf '%s\n' "$pass_message"
}

