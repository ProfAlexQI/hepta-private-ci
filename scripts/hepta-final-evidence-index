#!/usr/bin/env bash
set -euo pipefail
umask 077

action="${1:-}"
shift || true

case "$action" in
  build)
    [[ "${1:-}" == "--entries-tsv" && -n "${2:-}" \
      && "${3:-}" == "--output" && -n "${4:-}" ]] || {
      echo "usage: scripts/hepta-final-evidence-index build --entries-tsv PATH --output PATH [--required-roles-file PATH]" >&2
      exit 2
    }
    entries_tsv="$2"
    output="$4"
    required_roles_file=""
    shift 4
    if (( $# > 0 )); then
      [[ "${1:-}" == "--required-roles-file" && -n "${2:-}" && $# == 2 ]] || {
        echo "usage: scripts/hepta-final-evidence-index build --entries-tsv PATH --output PATH [--required-roles-file PATH]" >&2
        exit 2
      }
      required_roles_file="$2"
    fi
    ;;
  verify)
    [[ "${1:-}" == "--index" && -n "${2:-}" && $# == 2 ]] || {
      echo "usage: scripts/hepta-final-evidence-index verify --index PATH" >&2
      exit 2
    }
    output="$2"
    entries_tsv=""
    required_roles_file=""
    ;;
  roles)
    [[ $# == 0 ]] || {
      echo "usage: scripts/hepta-final-evidence-index roles" >&2
      exit 2
    }
    output=""
    entries_tsv=""
    required_roles_file=""
    ;;
  *)
    echo "usage: scripts/hepta-final-evidence-index {build|verify|roles} ..." >&2
    exit 2
    ;;
esac

ruby - "$action" "$entries_tsv" "$output" "$required_roles_file" <<'RUBY'
# frozen_string_literal: true

require "digest"
require "json"
require "pathname"

SCHEMA = "hepta_final_only_evidence_index_v2"
ROLE = /\A[a-z0-9][a-z0-9_-]*\z/
FORBIDDEN = /(attempt|raw|superseded|invalid|temporary|candidate_evidence)/
CANONICAL_REQUIRED_ROLES = %w[
  source_preflight_summary
  source_preflight_archive
  release_materialization
  release_verify
  architecture_budget
  dependency_security
  no_egress
  route_sweep
  pagination
  file_upload_boundary
  first_candidate_runtime
  first_candidate_install
  first_candidate_soak
  first_candidate_watchdog
  rollback_previous_runtime
  rollback_previous_install
  rollback_previous_soak
  rollback_previous_watchdog
  final_candidate_runtime
  final_candidate_install
  final_candidate_soak
  final_candidate_watchdog
  stage_identity_chain
  tree_hygiene
  off_device_restore
].freeze

def sha256(path)
  Digest::SHA256.file(path).hexdigest
end

def canonical_roles_sha256
  Digest::SHA256.hexdigest(CANONICAL_REQUIRED_ROLES.join("\n") + "\n")
end

def validate_entry(entry)
  role = entry.fetch("role")
  source = Pathname(entry.fetch("path"))
  raise "invalid final evidence role" unless ROLE.match?(role) && !FORBIDDEN.match?(role)
  raise "final evidence path must be absolute" unless source.absolute?
  raise "final evidence source must not be a symlink" if source.symlink?
  path = source.realpath
  raise "final evidence must be a regular non-symlink file" unless path.file? && !path.symlink?
  raise "final evidence path must already be canonical" unless path.to_s == source.to_s
  raise "final evidence SHA drifted" unless entry.fetch("sha256") == sha256(path)
  raise "final evidence size drifted" unless entry.fetch("size_bytes") == path.size
end

def read_entries(path)
  seen_roles = {}
  seen_paths = {}
  File.readlines(path, chomp: true).reject(&:empty?).map do |line|
    role, source, extra = line.split("\t", 3)
    raise "entry must contain exactly role and path" if extra || !role || !source
    raise "duplicate final evidence role" if seen_roles[role]
    unresolved = Pathname(source)
    raise "final evidence source must not be a symlink" if unresolved.symlink?
    absolute = unresolved.realpath.to_s
    raise "duplicate final evidence path" if seen_paths[absolute]
    seen_roles[role] = true
    seen_paths[absolute] = true
    candidate = Pathname(absolute)
    entry = {
      "role" => role,
      "path" => absolute,
      "sha256" => sha256(candidate),
      "size_bytes" => candidate.size
    }
    validate_entry(entry)
    entry
  end
end

def validate_canonical_roles(roles)
  raise "final evidence roles are not canonical" unless roles == CANONICAL_REQUIRED_ROLES
end

action, entries_path, output_path, required_roles_path = ARGV
if action == "roles"
  puts CANONICAL_REQUIRED_ROLES
  exit
end

if action == "build"
  entries = read_entries(entries_path)
  if required_roles_path && !required_roles_path.empty?
    supplied_roles = File.readlines(required_roles_path, chomp: true).reject(&:empty?)
    validate_canonical_roles(supplied_roles)
  end
  present_roles = entries.map { |entry| entry.fetch("role") }
  validate_canonical_roles(present_roles)
  payload = JSON.generate({
    "schema" => SCHEMA,
    "status" => "ready",
    "final_only" => true,
    "whitelist_only" => true,
    "entry_count" => entries.length,
    "release_hard_gate" => true,
    "canonical_required_roles_sha256" => canonical_roles_sha256,
    "required_roles" => CANONICAL_REQUIRED_ROLES,
    "entries" => entries
  }) + "\n"
  output = Pathname(output_path)
  raise "refusing to overwrite final evidence index" if output.exist?
  output.dirname.mkpath
  temporary = Pathname("#{output}.tmp.#{Process.pid}")
  File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.write(payload)
    file.flush
    file.fsync
  end
  File.chmod(0o444, temporary)
  File.rename(temporary, output)
end

index = JSON.parse(File.read(output_path))
raise "invalid final-only evidence index" unless index["schema"] == SCHEMA &&
  index["status"] == "ready" && index["final_only"] == true &&
  index["whitelist_only"] == true && index["release_hard_gate"] == true &&
  index["entry_count"] == index.fetch("entries").length &&
  index["canonical_required_roles_sha256"] == canonical_roles_sha256
validate_canonical_roles(index.fetch("required_roles"))
validate_canonical_roles(index.fetch("entries").map { |entry| entry.fetch("role") })
index.fetch("entries").each { |entry| validate_entry(entry) }
puts JSON.generate(index)
RUBY
