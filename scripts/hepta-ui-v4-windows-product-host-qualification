#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"

parts = (1..3).map do |index|
  Pathname.new(__dir__).join("hepta-ui-v4-windows-product-host-qualification.part#{index}.rb")
end
missing = parts.reject(&:file?)
abort "qualification source parts missing: #{missing.join(', ')}" unless missing.empty?
source = parts.map(&:read).join
Kernel.eval(source, TOPLEVEL_BINDING, __FILE__, 1)
