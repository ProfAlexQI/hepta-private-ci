#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ $# == 0 ]]; then
  invoked="$(basename "$0")"
  [[ "$invoked" =~ ^(hepta-context-[a-z0-9-]+)-(gate|report)\.sh$ ]] || {
    echo "invalid Hepta context gate alias: $invoked" >&2
    exit 2
  }
  set -- "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}"
fi
exec "$ROOT/scripts/hepta-context-gate-runner" "$@"
