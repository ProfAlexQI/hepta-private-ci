#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE="$ROOT/scripts/hepta-operator-canary-activation-chain-gate-specs-v1.json"

usage() {
  echo "usage: scripts/hepta-operator-canary-activation-chain-gate-runner <id|--validate>" >&2
  exit 2
}

sha256_text() {
  printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
}

validate_registry() {
  jq -e '
    .schema_version == "hepta_operator_canary_activation_chain_gate_specs_v1"
    and .executor == "scripts/hepta-operator-canary-activation-chain-gate-runner"
    and .receipt_state_machine == ["precondition", "denial", "receipt", "persistence", "retention", "terminal"]
    and .minimum_long_soak_samples == 24
    and .normalization.remove_fields == ["base_url", "minimum_required_samples"]
    and .normalization.remove_suffix == "sha256"
    and (.specs | length) == 3
    and ((.specs | map(.id) | unique | length) == 3)
    and (.specs | all(
      (.id | test("^[a-z0-9-]+$"))
      and .gate_spec.method == "LOCAL"
      and .gate_spec.pattern == ("scripts/" + .id + "-gate.sh")
      and .gate_spec.source_command == ("bash scripts/" + .id + "-gate.sh")
      and .gate_spec.capability == .id
      and .gate_spec.receipt_state == "receipt"
      and (.gate_spec.side_effect_boundary | contains("read-only"))
      and (.source.capture_label | length > 0)
      and (.source.script | test("^scripts/[a-z0-9-]+-gate\\.sh$"))
      and (.source.expected_gate | length > 0)
      and (.source.ready_field | length > 0)
      and (.source.status_field | length > 0)
      and (.source.projections | type == "object" and length > 0)
      and (.target.ready_field | length > 0)
      and (.target.status_field | length > 0)
      and (.fixture_field | length > 0)
      and (.expected_fixture_count == 10)
      and (.report_template | type == "object")
      and (. as $spec
        | $spec.report_template[$spec.fixture_field] | type == "array")
      and (. as $spec
        | ($spec.report_template[$spec.fixture_field] | length) == $spec.expected_fixture_count)
      and (.invariants.report_false_fields | type == "array" and length > 0)
      and (.invariants.fixture_false_fields | type == "array" and length > 0)
      and (.hashes.source_field | endswith("sha256"))
      and (.hashes.fixture_field | endswith("sha256"))
      and (.hashes.contract_field | endswith("sha256"))
      and (.hashes.contract_parts | type == "array" and length > 0)
      and (.hashes.contract_parts | all(
        ((keys | length) == 1)
        and (
          (.literal | type == "string")
          or .source_sha256 == true
          or .fixtures_sha256 == true
          or (.source_field | type == "string" and length > 0)
        )
      ))
      and (.hashes.policy_field | endswith("sha256"))
      and (.hashes.policy_text | length > 0)
      and (.hashes.side_effect_field | endswith("sha256"))
      and (.hashes.side_effect_text | length > 0)
      and (.baseline_normalized_output_sha256 | test("^[0-9a-f]{64}$"))
      and (.pass_message | length > 0)
    ))
  ' "$SPEC_FILE" >/dev/null
}

[[ -f "$SPEC_FILE" ]] || {
  echo "missing operator-canary activation chain gate spec registry: $SPEC_FILE" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}

[[ $# == 1 ]] || usage
if [[ "$1" == "--validate" ]]; then
  validate_registry
  echo '{"schema":"hepta_operator_canary_activation_chain_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
  exit 0
fi

id="$1"
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
validate_registry

spec="$(jq -cer --arg id "$id" '.specs[] | select(.id == $id)' "$SPEC_FILE")" || {
  echo "unknown operator-canary activation chain gate spec id: $id" >&2
  exit 1
}

BASE_URL="${HEPTA_LIVE_URL:-http://127.0.0.1:7373}"
MIN_LONG_SOAK_SAMPLES="${HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES:-24}"
RELEASE_BIN="${HEPTA_RELEASE_BIN:-${HEPTA_CODEX_RELEASE_BIN:-$HOME/.local/opt/hepta/bin/hepta}}"

[[ "$MIN_LONG_SOAK_SAMPLES" =~ ^[0-9]+$ ]] || {
  echo "minimum long-soak samples must be numeric" >&2
  exit 1
}
if (( MIN_LONG_SOAK_SAMPLES < 24 )); then
  echo "minimum long-soak samples must be at least 24" >&2
  exit 1
fi

cd "$ROOT"
source scripts/lib/hepta-json-report-capture.sh

source_spec="$(jq -c '.source' <<<"$spec")"
source_script="$(jq -r '.script' <<<"$source_spec")"
SOURCE_JSON="$(
  capture_json_report \
    "$(jq -r '.capture_label' <<<"$source_spec")" \
    env \
      HEPTA_LIVE_URL="$BASE_URL" \
      HEPTA_RELEASE_BIN="$RELEASE_BIN" \
      HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES="$MIN_LONG_SOAK_SAMPLES" \
      HEPTA_TERMINAL_SOAK_INTERVAL_SECONDS="${HEPTA_TERMINAL_SOAK_INTERVAL_SECONDS:-0}" \
      HEPTA_LONG_SOAK_OBSERVATION_INTERVAL_SECONDS="${HEPTA_LONG_SOAK_OBSERVATION_INTERVAL_SECONDS:-0}" \
      HEPTA_LONG_SOAK_FRESHNESS_OBSERVATION_INTERVAL_SECONDS="${HEPTA_LONG_SOAK_FRESHNESS_OBSERVATION_INTERVAL_SECONDS:-0}" \
      "$source_script"
)"

jq -e --argjson source_spec "$source_spec" '
  .runtime == "hepta"
  and .status == "ready"
  and .gate == $source_spec.expected_gate
  and .[$source_spec.ready_field] == true
  and .[$source_spec.status_field] == "blocked"
  and (.side_effects | type == "object")
  and (.side_effects | to_entries | all(.value == false))
' >/dev/null <<<"$SOURCE_JSON" || {
  echo "operator-canary activation chain source invariant mismatch for $id" >&2
  exit 1
}

fixture_field="$(jq -r '.fixture_field' <<<"$spec")"
FIXTURES_JSON="$(jq --arg field "$fixture_field" '.report_template[$field]' <<<"$spec")"

source_sha256="$(sha256_text "$SOURCE_JSON")"
fixtures_sha256="$(sha256_text "$FIXTURES_JSON")"
contract_text="$(
  jq -nr \
    --arg source_sha256 "$source_sha256" \
    --arg fixtures_sha256 "$fixtures_sha256" \
    --argjson source "$SOURCE_JSON" \
    --argjson parts "$(jq -c '.hashes.contract_parts' <<<"$spec")" \
    'reduce $parts[] as $part ("";
      . + (
        if $part.literal != null then $part.literal
        elif $part.source_sha256 == true then $source_sha256
        elif $part.fixtures_sha256 == true then $fixtures_sha256
        else ($source[$part.source_field] | tostring)
        end
      )
    )'
)"
contract_sha256="$(sha256_text "$contract_text")"
policy_sha256="$(sha256_text "$(jq -r '.hashes.policy_text' <<<"$spec")")"
side_effect_sha256="$(sha256_text "$(jq -r '.hashes.side_effect_text' <<<"$spec")")"

report="$(
  jq -n \
    --arg base_url "$BASE_URL" \
    --argjson min_long_soak_samples "$MIN_LONG_SOAK_SAMPLES" \
    --argjson spec "$spec" \
    --argjson source "$SOURCE_JSON" \
    --arg source_sha256 "$source_sha256" \
    --arg fixtures_sha256 "$fixtures_sha256" \
    --arg contract_sha256 "$contract_sha256" \
    --arg policy_sha256 "$policy_sha256" \
    --arg side_effect_sha256 "$side_effect_sha256" \
    '
      $spec.report_template
      | .base_url = $base_url
      | .minimum_required_samples = $min_long_soak_samples
      | .[$spec.hashes.source_field] = $source_sha256
      | .[$spec.hashes.fixture_field] = $fixtures_sha256
      | .[$spec.hashes.contract_field] = $contract_sha256
      | .[$spec.hashes.policy_field] = $policy_sha256
      | .[$spec.hashes.side_effect_field] = $side_effect_sha256
      | reduce ($spec.source.projections | to_entries[]) as $projection
          (. ; .[$projection.key] = $source[$projection.value])
    '
)"

jq -e --argjson spec "$spec" '
  . as $report
  | .runtime == "hepta"
  and .status == "ready"
  and .gate == $spec.report_template.gate
  and .[$spec.target.ready_field] == true
  and .[$spec.target.status_field] == "blocked"
  and (.[$spec.fixture_field] | length) == $spec.expected_fixture_count
  and (.[$spec.fixture_field] | all(.receipt_noop_confirmed == true))
  and (.side_effects | to_entries | all(.value == false))
  and ($spec.invariants.report_false_fields | all(. as $field | $report[$field] == false))
  and ($report[$spec.fixture_field] | all(
    . as $fixture
    | ($spec.invariants.fixture_false_fields | all(. as $field | $fixture[$field] == false))
  ))
' >/dev/null <<<"$report" || {
  echo "operator-canary activation chain report invariant mismatch for $id" >&2
  exit 1
}

actual_output_sha="$(
  jq -S '
    del(.base_url, .minimum_required_samples)
    | with_entries(select(.key | endswith("sha256") | not))
  ' <<<"$report" | shasum -a 256 | cut -d ' ' -f1
)"
expected_output_sha="$(jq -r '.baseline_normalized_output_sha256' <<<"$spec")"
[[ "$actual_output_sha" == "$expected_output_sha" ]] || {
  echo "operator-canary activation chain gate normalized output parity mismatch for $id: $actual_output_sha != $expected_output_sha" >&2
  exit 1
}

printf '%s\n' "$report" | jq .
jq -r '.pass_message' <<<"$spec"
