def topology_contract() -> tuple[dict[str, Any], bytes]:
    value: dict[str, Any] = {
        "schema": T.TOPOLOGY_SCHEMA,
        "schema_version": 1,
        "phase": "DEVELOPMENT",
        "claim_level": "MINIMAL_HEPTA_OWNED_EMBEDDER_TOPOLOGY_ONLY",
        "source": {
            "repository": T.SERVO_REPOSITORY,
            "commit": T.SERVO_COMMIT,
            "tree": T.SERVO_TREE,
            "license": "MPL-2.0",
        },
        "decision": {},
        "selected_files": [],
        "reference_only_files": [],
        "api_contract": {},
        "runtime_contract": {},
        "open_gates": ["accepted source pointer"],
        "authority": copy.deepcopy(T.AUTHORITY),
    }
    value = bound(
        value,
        "topology_id",
        "hepta-servo-worker-source-topology:v1:",
        T.TOPOLOGY_DOMAIN,
    )
    return value, T.canonical(value)


def topology_receipt(
    source: dict[str, Any], topology: dict[str, Any], topology_raw: bytes
) -> tuple[dict[str, Any], bytes]:
    selection = copy.deepcopy(T.EXPECTED_SELECTION)
    selection["file_projection_sha256"] = "c" * 64
    value: dict[str, Any] = {
        "schema": T.TOPOLOGY_RECEIPT_SCHEMA,
        "schema_version": 1,
        "phase": "DEVELOPMENT",
        "claim_level": "SOURCE_API_TOPOLOGY_VERIFIED_BUILD_NOT_AUTHORIZED",
        "captured_at_utc": "2026-08-28T16:10:00Z",
        "source": copy.deepcopy(source["servo"]),
        "bindings": {
            "topology_id": topology["topology_id"],
            "topology_sha256": T.sha256_bytes(topology_raw),
            "source_bundle_receipt_sha256": "a" * 64,
            "compressed_archive_sha256": "b" * 64,
        },
        "selection": selection,
        "verification": copy.deepcopy(T.EXPECTED_TOPOLOGY_VERIFICATION),
        "authority": copy.deepcopy(T.AUTHORITY),
        "decision": "HEPTA_OWNED_EMBEDDER_TOPOLOGY_VERIFIED_BUILD_NOT_AUTHORIZED",
    }
    value = bound(
        value,
        "receipt_id",
        "hepta-servo-worker-source-topology-verification:v1:",
        T.TOPOLOGY_RECEIPT_DOMAIN,
    )
    return value, T.canonical(value)


def policy() -> tuple[dict[str, Any], bytes]:
    value: dict[str, Any] = {
        "schema": T.POLICY_SCHEMA,
        "schema_version": 1,
        "phase": "DEVELOPMENT",
        "repository": T.REPOSITORY,
        "base_branch": T.BASE_BRANCH,
        "accepted_source_pointer_path": "docs/hepta-vnext/browser/source-acceptance/ACCEPTED_SOURCE_POINTER.json",
        "topology_contract_path": "docs/hepta-vnext/browser/SERVO_WORKER_SOURCE_TOPOLOGY_V1.json",
        "pointer_path": "docs/hepta-vnext/browser/source-topology-acceptance/ACCEPTED_WORKER_SOURCE_TOPOLOGY_POINTER.json",
        "topology_receipt_snapshot_prefix": "docs/hepta-vnext/browser/source-topology-acceptance/receipts/",
        "challenge_snapshot_prefix": "docs/hepta-vnext/browser/source-topology-acceptance/challenges/",
        "allowed_auxiliary_paths": [
            "docs/hepta-vnext/browser/C1_CURRENT_V7.json",
            "docs/hepta-vnext/browser/C1_WORKER_SOURCE_TOPOLOGY_ACCEPTANCE_POINTER_V1_STATUS.json",
            "docs/hepta-vnext/browser/CURRENT.yaml",
            "docs/hepta-vnext/browser/README.md",
        ],
        "review": {
            "minimum_approvals": 1,
            "reviewer_must_differ_from_pr_author": True,
            "require_current_head_commit": True,
            "reject_changes_requested": True,
            "allowed_author_associations": ["COLLABORATOR", "MEMBER", "OWNER"],
            "required_body_prefix": "HEPTA_WORKER_TOPOLOGY_ACCEPT_V1 ",
            "head_ref_prefix": "review/hepta-servo-worker-topology-acceptance-",
            "draft_allowed": False,
            "codeowner_review_required": False,
            "pointer_must_bind_pull_request_number": True,
            "pointer_must_bind_head_ref": True,
            "required_status_check": "Worker source/API topology accepted pointer live review",
        },
        "claims_after_acceptance": copy.deepcopy(T.ACCEPTED_TOPOLOGY_CLAIMS),
        "authority": copy.deepcopy(T.AUTHORITY),
    }
    value = bound(
        value,
        "policy_id",
        "hepta-servo-worker-source-topology-acceptance-review-policy:v1:",
        T.POLICY_DOMAIN,
    )
    return value, T.canonical(value)

