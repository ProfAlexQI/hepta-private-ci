#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE="$ROOT/scripts/hepta-artifact-signing-receipt-route-gate-specs-v1.json"
UNIFIED_RUNNER="$ROOT/scripts/hepta-route-gate-runner"

usage() {
  echo "usage: scripts/hepta-artifact-signing-receipt-route-gate-runner <id|--validate>" >&2
  exit 2
}

if [[ $# == 0 ]]; then
  invoked="$(basename "$0")"
  if [[ "$invoked" == "hepta-artifact-signing-receipt-cancellation-supersession-denial-route-gate.sh" ]]; then
    set -- hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-identity-session-revocation-logout-replay-reinstatement-operator-intent-consent-evidence-artifact-signing-receipt-cancellation-supersession-denial
  elif [[ "$invoked" =~ ^(hepta-[a-z0-9-]+)-route-gate\.sh$ ]]; then
    set -- "${BASH_REMATCH[1]}"
  fi
fi

[[ -f "$SPEC_FILE" ]] || {
  echo "missing artifact-signing receipt route registry: $SPEC_FILE" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}

[[ $# == 1 ]] || usage
if [[ "$1" == "--validate" ]]; then
  "$UNIFIED_RUNNER" --validate >/dev/null
  echo '{"schema":"hepta_artifact_signing_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
  exit 0
fi

id="$1"
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
if ! jq -e --arg id "$id" 'any(.specs[]; .id == $id)' "$SPEC_FILE" >/dev/null; then
  echo "unknown artifact-signing receipt route spec id: $id" >&2
  exit 1
fi

exec "$UNIFIED_RUNNER" "$id"
