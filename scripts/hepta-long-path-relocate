#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "set"

ROOT = File.expand_path("..", __dir__)
REGISTRY_PATH = File.join(ROOT, "scripts/lib/hepta-long-path-v1/registry.json")
SCHEMA = "hepta_long_path_relocation_v1"
MAX_TRACKED_PATH_BYTES = 240
AUDIT_BASELINE_LONG_PATH_COUNT = 496
PROTECTED_REFERENCE_PATHS = Set[
  "scripts/hepta-gate-pair-specs-v1.json",
  "docs/architecture/HEPTA_SHELL_GATE_MIGRATION_INPUT_V1.json"
].freeze

def usage
  warn "usage: scripts/hepta-long-path-relocate [pack|verify|unpack]"
  exit 2
end

def atomic_write(path, content, mode = nil)
  FileUtils.mkdir_p(File.dirname(path))
  staging = "#{path}.#{$$}.tmp"
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end

def worktree_files
  output, error, status = Open3.capture3(
    "git",
    "-C",
    ROOT,
    "ls-files",
    "-co",
    "--exclude-standard",
    "-z"
  )
  raise "failed to enumerate Hepta worktree: #{error}" unless status.success?
  output.split("\0").select { |relative| File.file?(File.join(ROOT, relative)) }.sort
end

def long_paths
  worktree_files.select { |relative| relative.bytesize > MAX_TRACKED_PATH_BYTES }
end

def relocated_path(relative)
  directory = case relative
              when %r{\Adocs/architecture/}
                "docs/architecture"
              when %r{\Ascripts/}
                "scripts"
              else
                "archive/i3"
              end
  extension = File.extname(relative)
  digest = Digest::SHA256.hexdigest(relative)[0, 24]
  "#{directory}/i3-#{digest}#{extension}"
end

def text_bytes(path)
  bytes = File.binread(path)
  return nil if bytes.include?("\0")
  text = bytes.dup.force_encoding(Encoding::UTF_8)
  text.valid_encoding? ? text : nil
end

def rewrite_references(replacements)
  rewritten = []
  worktree_files.each do |relative|
    next if File.join(ROOT, relative) == REGISTRY_PATH
    next if PROTECTED_REFERENCE_PATHS.include?(relative)
    path = File.join(ROOT, relative)
    text = text_bytes(path)
    next unless text
    updated = text
    replacements.each do |from, to|
      updated = updated.gsub(from, to)
    end
    next if updated == text
    atomic_write(path, updated.b, File.stat(path).mode & 0o777)
    rewritten << relative
  end
  rewritten
end

def pack
  if File.file?(REGISTRY_PATH)
    raise "new overlong paths require a new relocation batch" unless long_paths.empty?
    verify
    return
  end

  original_paths = long_paths
  raise "no overlong paths to relocate" if original_paths.empty?
  entries = original_paths.map do |original|
    source = File.join(ROOT, original)
    relocated = relocated_path(original)
    destination = File.join(ROOT, relocated)
    raise "relocation collision: #{relocated}" if File.exist?(destination)
    {
      "original_path" => original,
      "relocated_path" => relocated,
      "original_path_sha256" => Digest::SHA256.hexdigest(original),
      "original_content_sha256" => Digest::SHA256.file(source).hexdigest,
      "mode" => File.stat(source).mode & 0o777
    }
  end
  destinations = entries.map { |entry| entry.fetch("relocated_path") }
  raise "long-path relocation destination collision" unless destinations.uniq.length == destinations.length

  entries.each do |entry|
    source = File.join(ROOT, entry.fetch("original_path"))
    destination = File.join(ROOT, entry.fetch("relocated_path"))
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.mv(source, destination)
  end

  replacements = entries
    .map { |entry| [entry.fetch("original_path"), entry.fetch("relocated_path")] }
    .sort_by { |from, _to| -from.length }
  rewritten_paths = rewrite_references(replacements)
  entries.each do |entry|
    relocated = File.join(ROOT, entry.fetch("relocated_path"))
    entry["relocated_content_sha256"] = Digest::SHA256.file(relocated).hexdigest
  end
  registry = {
    "schema" => SCHEMA,
    "status" => "relocated",
    "audit_baseline_long_path_count" => AUDIT_BASELINE_LONG_PATH_COUNT,
    "prepack_materialized_long_path_count" => original_paths.length,
    "postpack_materialized_long_path_count" => 0,
    "max_tracked_path_bytes" => MAX_TRACKED_PATH_BYTES,
    "relocation_count" => entries.length,
    "rewritten_reference_file_count" => rewritten_paths.length,
    "rewritten_reference_paths" => rewritten_paths,
    "entries" => entries,
    "reversible_unpack" => true
  }
  atomic_write(REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
  verify
end

def verify
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  raise "invalid Hepta long-path relocation schema" unless registry["schema"] == SCHEMA
  raise "Hepta long-path relocation is not reversible" unless registry["reversible_unpack"]
  raise "Hepta long-path ceiling drifted" unless registry["max_tracked_path_bytes"] == MAX_TRACKED_PATH_BYTES
  entries = registry.fetch("entries")
  raise "Hepta long-path relocation count drifted" unless registry["relocation_count"] == entries.length
  raise "Hepta overlong paths remain materialized" unless long_paths.empty?
  destinations = Set.new
  entries.each do |entry|
    original = entry.fetch("original_path")
    relocated = entry.fetch("relocated_path")
    raise "original Hepta long path remains: #{original}" if File.exist?(File.join(ROOT, original))
    raise "relocated Hepta path is still too long: #{relocated}" if relocated.bytesize > MAX_TRACKED_PATH_BYTES
    raise "duplicate Hepta relocation destination: #{relocated}" unless destinations.add?(relocated)
    destination = File.join(ROOT, relocated)
    raise "missing relocated Hepta path: #{relocated}" unless File.file?(destination)
    unless Digest::SHA256.file(destination).hexdigest == entry.fetch("relocated_content_sha256")
      raise "relocated Hepta content drifted: #{relocated}"
    end
  end
  puts "hepta-long-path-relocate: PASS: #{entries.length} relocated, 0 overlong"
end

def unpack
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  entries = registry.fetch("entries")
  replacements = entries
    .map { |entry| [entry.fetch("relocated_path"), entry.fetch("original_path")] }
    .sort_by { |from, _to| -from.length }
  rewrite_references(replacements)
  entries.each do |entry|
    source = File.join(ROOT, entry.fetch("relocated_path"))
    destination = File.join(ROOT, entry.fetch("original_path"))
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.mv(source, destination)
    File.chmod(entry.fetch("mode"), destination)
    unless Digest::SHA256.file(destination).hexdigest == entry.fetch("original_content_sha256")
      raise "restored Hepta long-path content drifted: #{entry.fetch("original_path")}"
    end
  end
  puts "hepta-long-path-relocate: unpacked #{entries.length} paths"
end

case ARGV
when ["pack"]
  pack
when ["verify"]
  verify
when ["unpack"]
  unpack
else
  usage
end
