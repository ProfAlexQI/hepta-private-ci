#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "pathname"

ROOT = Pathname(__dir__).parent

required = [
  "scripts/hepta-ui-v4-final-gap-closure-index-v3",
  "scripts/hepta-ui-v4-executable-final-gap-closure-v3-gate",
  "scripts/hepta-ui-v4-rust-served-browser-engine.cjs",
  "docs/ui/HEPTA_UI_EXECUTABLE_FINAL_GAP_CLOSURE_V3.json",
  "docs/ui/HEPTA_UI_REMAINING_EXTERNAL_BLOCKERS_V7.json",
  "docs/ui/schemas/hepta.ui.v4.final-gap-closure-index.v3.schema.json",
  ".github/workflows/hepta-ui-v4-final-gap-closure-v3.yml",
  ".github/workflows/hepta-ui-v4-final-gap-closure-v4.yml",
  ".github/workflows/hepta-ui-v4-rust-served-cross-browser-final.yml",
  ".github/workflows/hepta-ui-v4.yml",
  "tools/hepta-ui-rust-served-browser-probe/Cargo.toml",
  "tools/hepta-ui-rust-served-browser-probe/src/main.rs",
  "tools/hepta-ui-global-platform-source-closure/Cargo.toml",
  "tools/hepta-ui-windows-product-host-safety/Cargo.toml",
  "tools/hepta-ui-windows-product-host-device-drill/Cargo.toml"
]

failures = required.reject { |path| (ROOT / path).file? }.map { |path| "missing #{path}" }

unless failures.any?
  contract = JSON.parse((ROOT / "docs/ui/HEPTA_UI_EXECUTABLE_FINAL_GAP_CLOSURE_V3.json").read)
  blockers = JSON.parse((ROOT / "docs/ui/HEPTA_UI_REMAINING_EXTERNAL_BLOCKERS_V7.json").read)
  producer = (ROOT / "scripts/hepta-ui-v4-final-gap-closure-index-v3").read
  generic = (ROOT / ".github/workflows/hepta-ui-v4.yml").read
  canonical = (ROOT / ".github/workflows/hepta-ui-v4-final-gap-closure-v4.yml").read
  browser_workflow = (ROOT / ".github/workflows/hepta-ui-v4-rust-served-cross-browser-final.yml").read
  intake = (ROOT / ".github/workflows/hepta-ui-v4-final-gap-closure-v3.yml").read
  browser_server = (ROOT / "tools/hepta-ui-rust-served-browser-probe/src/main.rs").read
  browser_probe = (ROOT / "scripts/hepta-ui-v4-rust-served-browser-engine.cjs").read

  failures << "contract source gap" unless contract["sourceControllableGapsClosed"] == true
  failures << "contract all gaps prematurely closed" unless contract["allGapsClosed"] == false
  failures << "contract toolchain drift" unless contract["rustToolchain"] == "1.95.0"
  failures << "contract runner job count" unless Array(contract["sameRunExecutableJobs"]).length == 7
  failures << "contract automated evidence slots" unless Array(contract["automatedCandidateBoundEvidenceSlots"]).sort == %w[crossBrowserRuntime runnerExecution]
  failures << "contract manual evidence slot count" unless Array(contract["manualExternalEvidenceSlots"]).length == 6
  failures << "contract slot count" unless Array(contract["requiredEvidenceSlots"]).length == 8

  failures << "blocker source gap" unless blockers["sourceControllableGapsClosed"] == true
  failures << "source implementation gaps remain" unless Array(blockers["sourceImplementationGaps"]).empty?
  failures << "evidence slot count" unless Array(blockers["externalEvidence"]).length == 8
  failures << "all gaps prematurely closed" unless blockers["allGapsClosed"] == false
  failures << "authority escaped" unless blockers.fetch("authority").values.all? { |value| value == false }

  failures << "generic merge-ref checkout remains" unless generic.include?("github.event.pull_request.head.sha || github.sha")
  failures << "generic exact checkout ref missing" unless generic.include?('ref: ${{ env.HEPTA_CANDIDATE_SHA }}')
  failures << "generic stale Rust toolchain" if generic.include?("toolchain: 1.88.0")
  failures << "generic Rust 1.95 missing" unless generic.include?("toolchain: 1.95.0")
  failures << "generic served bundle compile missing" unless generic.include?("cargo check --manifest-path codex-rs/Cargo.toml -p hepta-core")
  failures << "generic Native contract tests missing" unless generic.include?("runtime_material_resolution_is_bounded_and_fail_closed")

  failures << "canonical exact candidate binding missing" unless canonical.include?("github.event.pull_request.head.sha || github.sha")
  failures << "canonical exact checkout missing" unless canonical.include?('ref: ${{ env.HEPTA_CANDIDATE_SHA }}')
  failures << "canonical stale Rust toolchain" if canonical.include?("toolchain: 1.88.0")
  failures << "canonical Rust 1.95 missing" unless canonical.scan("toolchain: 1.95.0").length >= 3
  failures << "served bundle executable job missing" unless canonical.include?("Final gap v4 served and Native contracts")
  failures << "platform executable matrix missing" unless canonical.include?("Final gap v4 platform contracts")
  failures << "iOS target compile missing" unless canonical.include?("aarch64-apple-ios")
  failures << "Android target compile missing" unless canonical.include?("aarch64-linux-android")
  failures << "Linux Native dependencies missing" unless canonical.include?("libwayland-dev")
  failures << "Windows long path enablement missing" unless canonical.include?("core.longpaths true")
  failures << "global platform harness execution missing" unless canonical.include?("tools/hepta-ui-global-platform-source-closure/Cargo.toml")
  failures << "Windows safety harness execution missing" unless canonical.include?("tools/hepta-ui-windows-product-host-safety/Cargo.toml")
  failures << "device producer surface compile missing" unless canonical.include?("tools/hepta-ui-windows-product-host-device-drill/Cargo.toml")
  failures << "same-run jobs API missing" unless canonical.include?("/actions/runs/$GITHUB_RUN_ID/jobs")
  failures << "browser workflow exact candidate binding missing" unless browser_workflow.include?("github.event.pull_request.head.sha || github.sha")
  failures << "browser workflow event-isolated concurrency missing" unless browser_workflow.include?("github.event_name")
  failures << "browser workflow exact checkout missing" unless browser_workflow.include?('ref: ${{ env.HEPTA_CANDIDATE_SHA }}')
  failures << "browser workflow Rust 1.95 missing" unless browser_workflow.include?("toolchain: 1.95.0")
  failures << "browser workflow aggregate receipt missing" unless browser_workflow.include?("PASS_RUST_SERVED_CROSS_BROWSER_MATRIX")
  %w[chromium firefox webkitLinux edge webkitMacos].each do |engine|
    failures << "browser engine #{engine} missing" unless browser_workflow.include?("key: #{engine}")
  end
  failures << "browser workflow unsafe repository permission" if browser_workflow.match?(/contents:\s*write|actions:\s*write/)
  failures << "unsafe repository permission" if canonical.match?(/contents:\s*write|actions:\s*write/)
  failures << "deploy/release job present" if canonical.match?(/^\s{2}(?:deploy|publish|release)(?:[-_][A-Za-z0-9_-]+)?:\s*$/i)

  failures << "manual intake must not auto-trigger" if intake.match?(/^\s{2}(?:push|pull_request):/)
  failures << "manual intake workflow_dispatch missing" unless intake.include?("workflow_dispatch:")
  failures << "manual candidate SHA input missing" unless intake.include?("candidate_sha:")
  failures << "manual candidate tree input missing" unless intake.include?("candidate_tree:")
  %w[
    runner_execution_artifact_id
    windows_device_artifact_id
    operator_acceptance_artifact_id
    macos_device_artifact_id
    ios_device_artifact_id
    android_device_artifact_id
    cross_browser_runtime_artifact_id
    browser_human_acceptance_artifact_id
  ].each do |input|
    failures << "manual intake #{input} missing" unless intake.include?("#{input}:")
  end
  failures << "manual intake final PASS enforcement missing" unless intake.include?("PASS_ALL_UI_GAPS_CLOSED")
  failures << "manual intake unsafe permission" if intake.match?(/contents:\s*write|actions:\s*write/)

  failures << "browser server widened script CSP" unless browser_server.include?("script-src 'self'")
  failures << "browser server missing WebKit-safe style CSP" unless browser_server.include?("style-src 'self' 'unsafe-inline'")
  failures << "browser server widened network CSP" unless browser_server.include?("connect-src 'self'")
  failures << "browser server lost GET/HEAD boundary" unless browser_server.include?('matches!(method, "GET" | "HEAD")')
  failures << "browser probe lost page-error audit" unless browser_probe.include?("pageErrorCount")
  failures << "browser probe lost cross-origin audit" unless browser_probe.include?("crossOriginRequestCount")
  failures << "browser probe lost non-GET audit" unless browser_probe.include?("nonGetRequestCount")

  %w[
    allRequiredJobsExecuted
    allRequiredStepsSuccessful
    exactHeadCheckedOut
    servedBundleCompiled
    nativeContractsTested
    globalPlatformHarnessTested
    windowsSafetyHarnessTested
    iosTargetCompiled
    androidTargetCompiled
  ].each do |field|
    failures << "runner field #{field} missing" unless producer.include?(field)
  end
  failures << "Chrome human browser coverage missing" unless producer.include?('%w[chrome edge firefox safari]')
  %w[rootMicaExact chromeMaterialExact navigationMaterialExact dynamicColorApplied].each do |field|
    failures << "named platform semantic #{field} missing" unless producer.include?(field)
  end

  stdout, stderr, status = Open3.capture3(
    "ruby",
    ROOT.join("scripts/hepta-ui-v4-final-gap-closure-index-v3").to_s,
    "--self-test"
  )
  failures << "index self-test: #{stderr.byteslice(0, 512)}" unless status.success? && stdout.include?("PASS_FINAL_GAP_CLOSURE_INDEX_V3_SELF_TEST")
end

payload = {
  "status" => failures.empty? ? "PASS_EXECUTABLE_FINAL_GAP_CLOSURE_V3_SOURCE_ONLY" : "FAIL_EXECUTABLE_FINAL_GAP_CLOSURE_V3_SOURCE",
  "source_controllable_gaps_closed" => failures.empty?,
  "hosted_executable_validation" => false,
  "automated_browser_validation" => false,
  "external_evidence_complete" => false,
  "all_gaps_closed" => false,
  "product_wired" => false,
  "product_host_may_bind" => false,
  "system_material_bound" => false,
  "native_product_runtime" => false,
  "device_validation" => false,
  "production_authority" => false,
  "effect_authority" => false,
  "live_adapter_authority" => false,
  "operator_acceptance" => false,
  "promotion" => false,
  "release" => false,
  "failures" => failures
}

puts JSON.pretty_generate(payload)
exit(failures.empty? ? 0 : 1)
