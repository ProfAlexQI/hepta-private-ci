raw_reordered_findings yes (.gates[] | select(.id == "dependency-security") | .receipt) |= (.graphs[0].raw_vulnerabilities=([.graphs[0].raw_vulnerabilities[1],.graphs[0].raw_vulnerabilities[0]]+.graphs[0].raw_vulnerabilities[2:])|.graphs[0].vulnerability_exceptions=([.graphs[0].vulnerability_exceptions[1],.graphs[0].vulnerability_exceptions[0]]+.graphs[0].vulnerability_exceptions[2:])|.vulnerability_exceptions=([.vulnerability_exceptions[1],.vulnerability_exceptions[0]]+.vulnerability_exceptions[2:]))
