forged_dependency_aggregate .dependencies.aggregate_sha256 = ("0" * 64)
forged_native_lock_input (.dependencies.lock_inputs[] | select(.path == "apps/hepta-native/Cargo.lock") | .sha256) = ("0" * 64)
