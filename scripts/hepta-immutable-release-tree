  $tool verify --manifest "$evidence_variant_manifest" >/dev/null
  if [[ "$evidence_variant_manifest" == "$bound_manifest" \
    || "$(jq -r '.artifact.sha256' "$evidence_variant_manifest")" != "$(jq -r '.artifact.sha256' "$bound_manifest")" \
    || "$(jq -r '.source.commit' "$evidence_variant_manifest")" != "$(jq -r '.source.commit' "$bound_manifest")" \
    || "$(jq -r '.preflight.log_sha256' "$evidence_variant_manifest")" == "$(jq -r '.preflight.log_sha256' "$bound_manifest")" ]]; then
    echo "same source and artifact with different evidence did not get a distinct release identity" >&2
    exit 1
  fi
  conflicting_preflight="$tmp/conflicting-preflight.log"
  printf '%s\n' \
    "[hepta-preflight-resume] head=$short_head attempt=1 start_line=1 marker=<start> log=$conflicting_preflight" \
    '{"hepta_repo_head": "0000000000000000000000000000000000000000"}' \
    "[hepta-preflight-provenance] $provenance" \
    'Hepta preflight passed' >"$conflicting_preflight"
