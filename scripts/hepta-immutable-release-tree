legacy_compat_profile_mix yes (.gates[] | select(.id == "gate-compat-debt") | .receipt) = {schema:"hepta_gate_compat_debt_receipt_v1",status:"ready",pair_count:1282,captured_shell_pair_count:1239,legacy_workgraph_pair_count:8,declarative_pair_count:35,compatibility_payload_count:2512,unregistered_payload_count:26,counts_may_only_improve:true} | (.gates[] | select(.id == "gate-compat-debt") | .self_test_receipt.schema) = "hepta_gate_compat_debt_self_test_v1"
