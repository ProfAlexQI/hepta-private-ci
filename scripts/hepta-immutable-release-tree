#!/usr/bin/env bash
set -euo pipefail
SCHEMA_VERSION="hepta_immutable_release_manifest_v1"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$REPO_ROOT/scripts/lib/hepta-release-provenance.sh"
source "$REPO_ROOT/scripts/lib/hepta-immutable-watchdog-closure-v1.sh"
usage() {
  cat >&2 <<'EOF'
usage:
  scripts/hepta-immutable-release-tree materialize --artifact PATH --source-commit SHA|unknown --release-root DIR [--preflight-log PATH]
  scripts/hepta-immutable-release-tree verify --manifest PATH
  scripts/hepta-immutable-release-tree activate --manifest PATH --active-link PATH --expected-current-sha256 SHA
  scripts/hepta-immutable-release-tree cutover --manifest PATH --active-link PATH --expected-current-sha256 SHA
  scripts/hepta-immutable-release-tree rollback --receipt PATH --expected-current-sha256 SHA
  scripts/hepta-immutable-release-tree self-test
Activation is byte-preserving: current and target SHA-256 must match. Installing
different bytes requires the explicit cutover command. Cutover changes only the
active binary and manifest links; it never restarts services or mutates launchd.
Source-bound materialization requires a preflight provenance receipt binding
the source commit, Rust toolchains, Cargo lockfiles, artifact, and all required
backend/native/release profiles.
EOF
  exit 2
}
sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
canonical_file() {
  local target="$1"
  realpath "$target"
}
require_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || {
    echo "invalid SHA-256: $1" >&2
    exit 1
  }
}
cargo_lock_sha_from_provenance() {
  local provenance_json="$1"
  local lock_path="$2"
  local cargo_lock_sha
  cargo_lock_sha="$(
    jq -er --arg lock_path "$lock_path" '
      [
        .dependencies.lock_inputs[]
        | select(.path == $lock_path)
        | .sha256
      ]
      | if length == 1 then .[0] else error("expected exactly one Cargo.lock input") end
    ' <<<"$provenance_json"
  )" || {
    echo "build provenance must bind exactly one $lock_path input" >&2
    return 1
  }
  [[ "$cargo_lock_sha" =~ ^[0-9a-f]{64}$ ]] || {
    echo "build provenance contains an invalid $lock_path SHA-256" >&2
    return 1
  }
  printf '%s\n' "$cargo_lock_sha"
}
dependency_contract_sha_current() {
  jq -cS . "$REPO_ROOT/scripts/hepta-dependency-security-v1.json" \
    | hepta_release_sha256_text
}
extract_final_preflight_evidence() {
  local preflight_log="$1"
  python3 - "$preflight_log" <<'PY'
import hashlib
import json
from pathlib import Path
import sys
path = Path(sys.argv[1])
lines = path.read_text(encoding="utf-8").splitlines()
prefix = "[hepta-preflight-provenance] "
final_prefix = "[hepta-preflight-final] "
pass_marker = "Hepta preflight passed"
successful = []
for index, line in enumerate(lines):
    if not line.startswith(final_prefix):
        continue
    if index == 0 or index + 1 >= len(lines):
        continue
    if not lines[index - 1].startswith(prefix) or lines[index + 1] != pass_marker:
        continue
    try:
        provenance = json.loads(lines[index - 1][len(prefix):])
        final = json.loads(line[len(final_prefix):])
    except json.JSONDecodeError as error:
        raise SystemExit(f"invalid final preflight JSON: {error}")
    canonical_provenance = json.dumps(
        provenance, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    )
    provenance_sha = hashlib.sha256(canonical_provenance.encode("utf-8")).hexdigest()
    if set(final) != {
        "schema",
        "status",
        "source_commit",
        "artifact_sha256",
        "build_provenance_sha256",
    }:
        raise SystemExit("final preflight receipt has an invalid field set")
    if final.get("schema") != "hepta_preflight_final_receipt_v1":
        raise SystemExit("final preflight receipt schema is invalid")
    if final.get("status") != "passed":
        raise SystemExit("final preflight receipt is not passed")
    if final.get("build_provenance_sha256") != provenance_sha:
        raise SystemExit("final preflight receipt does not bind its provenance")
    successful.append((canonical_provenance, final))
if not successful:
    raise SystemExit("preflight log has no completed final receipt/pass pair")
baseline = successful[-1]
for candidate in successful:
    if candidate != baseline:
        raise SystemExit("preflight log contains conflicting completed final receipts")
print(baseline[0])
print(json.dumps(baseline[1], sort_keys=True, separators=(",", ":"), ensure_ascii=False))
PY
}
resolve_preflight_source_commit() {
  local preflight_log="$1"
  local provenance_json="$2"
  local provenance_head metadata_heads metadata_head source_heads unique_heads source_head_count source_head
  local resume_line_count resume_heads resume_head resume_head_count metadata_line_count metadata_head_count
  provenance_head="$(jq -r '.source.commit // empty' <<<"$provenance_json")"
  source_heads=""
  if [[ -n "$provenance_head" ]]; then
    [[ "$provenance_head" =~ ^[0-9a-f]{40}$ ]] || {
      echo "preflight provenance source commit must be a full Git SHA" >&2
      return 1
    }
    source_heads="$provenance_head"
  fi
  metadata_line_count="$(rg -c '"hepta_repo_head"' "$preflight_log" || true)"
  metadata_line_count="${metadata_line_count:-0}"
  metadata_heads="$(
    sed -n 's/.*"hepta_repo_head"[[:space:]]*:[[:space:]]*"\([0-9a-f][0-9a-f]*\)".*/\1/p' "$preflight_log" \
      | sort -u
  )"
  metadata_head_count="$(
    sed -n 's/.*"hepta_repo_head"[[:space:]]*:[[:space:]]*"\([0-9a-f][0-9a-f]*\)".*/\1/p' "$preflight_log" \
      | awk 'NF { count += 1 } END { print count + 0 }'
  )"
  [[ "$metadata_head_count" == "$metadata_line_count" ]] || {
    echo "preflight metadata contains an invalid source commit truth" >&2
    return 1
  }
  if [[ -n "$metadata_heads" ]]; then
    while IFS= read -r metadata_head; do
      [[ "$metadata_head" =~ ^[0-9a-f]{40}$ ]] || {
        echo "preflight metadata source commit must be a full Git SHA" >&2
        return 1
      }
      source_heads="${source_heads}${source_heads:+$'\n'}${metadata_head}"
    done <<<"$metadata_heads"
  fi
  unique_heads="$(printf '%s\n' "$source_heads" | awk 'NF' | sort -u)"
  source_head_count="$(printf '%s\n' "$unique_heads" | awk 'NF { count += 1 } END { print count + 0 }')"
  [[ "$source_head_count" == "1" ]] || {
    echo "preflight log must contain exactly one full source commit truth" >&2
    return 1
  }
  source_head="$unique_heads"
  resume_line_count="$(rg -c '^\[hepta-preflight-resume\] ' "$preflight_log" || true)"
  resume_line_count="${resume_line_count:-0}"
  resume_heads="$(
    sed -n 's/^\[hepta-preflight-resume\] head=\([0-9a-f][0-9a-f]*\) .*/\1/p' "$preflight_log"
  )"
  resume_head_count="$(printf '%s\n' "$resume_heads" | awk 'NF { count += 1 } END { print count + 0 }')"
  [[ "$resume_line_count" -gt 0 && "$resume_head_count" == "$resume_line_count" ]] || {
    echo "preflight resume banner must contain a valid Git SHA prefix" >&2
    return 1
  }
  while IFS= read -r resume_head; do
    [[ "$resume_head" =~ ^[0-9a-f]{7,40}$ && "$source_head" == "$resume_head"* ]] || {
      echo "preflight resume banner does not match the full source commit truth" >&2
      return 1
    }
  done <<<"$resume_heads"
  printf '%s\n' "$source_head"
}
materialize() {
  local artifact="" source_commit="" release_root="" preflight_log=""
  while (( $# > 0 )); do
    case "$1" in
      --artifact) shift; [[ $# -gt 0 ]] || usage; artifact="$1" ;;
      --source-commit) shift; [[ $# -gt 0 ]] || usage; source_commit="$1" ;;
      --release-root) shift; [[ $# -gt 0 ]] || usage; release_root="$1" ;;
      --preflight-log) shift; [[ $# -gt 0 ]] || usage; preflight_log="$1" ;;
      *) usage ;;
    esac
    shift
  done
  [[ -f "$artifact" && -x "$artifact" ]] || {
    echo "artifact must be an executable file: $artifact" >&2
    exit 1
  }
  [[ -n "$release_root" ]] || usage
  if [[ "$source_commit" != "unknown" && ! "$source_commit" =~ ^[0-9a-f]{40}$ ]]; then
    echo "source commit must be a full Git SHA or unknown" >&2
    exit 1
  fi
  if [[ "$source_commit" == "unknown" && -n "$preflight_log" ]]; then
    echo "legacy-unbound releases cannot claim preflight binding" >&2
    exit 1
  fi
  if [[ "$source_commit" != "unknown" && -z "$preflight_log" ]]; then
    echo "source-bound releases require a preflight log" >&2
    exit 1
  fi
  artifact="$(canonical_file "$artifact")"
  mkdir -p "$release_root"
  release_root="$(cd "$release_root" && pwd -P)"
  local artifact_sha artifact_size release_id release_dir manifest_path
  artifact_sha="$(sha256_file "$artifact")"
  require_sha256 "$artifact_sha"
  artifact_size="$(stat -f '%z' "$artifact")"
  local status source_commit_bound preflight_bound preflight_sha preflight_size preflight_head
  local build_provenance_json codex_cargo_lock_sha native_cargo_lock_sha
  local dependency_contract_sha bound_gate_receipts_json final_receipt_json
  local watchdog_json
  status="ready"
  source_commit_bound=true
  preflight_bound=true
  preflight_sha=""
  preflight_size=0
  preflight_head=""
  build_provenance_json="null"
  codex_cargo_lock_sha=""
  native_cargo_lock_sha=""
  dependency_contract_sha=""
  bound_gate_receipts_json="null"
  final_receipt_json="null"
  watchdog_json="null"
  if [[ "$source_commit" == "unknown" ]]; then
    status="legacy_unbound"
    source_commit_bound=false
    preflight_bound=false
  else
    git -C "$REPO_ROOT" cat-file -e "$source_commit^{commit}" 2>/dev/null || {
      echo "source-bound release commit does not exist in the Hepta repository" >&2
      exit 1
    }
    [[ "$(git -C "$REPO_ROOT" rev-parse HEAD)" == "$source_commit" ]] || {
      echo "source-bound release commit is not the current Hepta HEAD" >&2
      exit 1
    }
    [[ -z "$(git -C "$REPO_ROOT" status --porcelain=v1 --untracked-files=all)" ]] || {
      echo "source-bound release materialization requires a clean Hepta worktree" >&2
      exit 1
    }
    [[ -f "$preflight_log" ]] || {
      echo "missing preflight log: $preflight_log" >&2
      exit 1
    }
    local final_evidence
    final_evidence="$(extract_final_preflight_evidence "$preflight_log")" || exit 1
    build_provenance_json="$(sed -n '1p' <<<"$final_evidence")"
    final_receipt_json="$(sed -n '2p' <<<"$final_evidence")"
    jq -e . >/dev/null <<<"$build_provenance_json" || {
      echo "preflight build provenance receipt is not valid JSON" >&2
      exit 1
    }
    preflight_head="$(
      resolve_preflight_source_commit "$preflight_log" "$build_provenance_json"
    )" || exit 1
    [[ "$source_commit" == "$preflight_head" ]] || {
      echo "preflight log source truth does not match source commit" >&2
      exit 1
    }
    jq -e \
      --arg source_commit "$source_commit" \
      --arg artifact_sha "$artifact_sha" \
      '
        .source_commit == $source_commit
        and .artifact_sha256 == $artifact_sha
      ' <<<"$final_receipt_json" >/dev/null || {
      echo "final preflight receipt does not bind the reviewed source and artifact" >&2
      exit 1
    }
    hepta_release_validate_build_provenance_json \
      "$build_provenance_json" \
      "$source_commit" \
      "$artifact_sha" || {
      echo "preflight build provenance receipt is incomplete or does not bind the artifact" >&2
      exit 1
    }
    jq -e '
      (keys | sort) == [
        "artifact",
        "bound_gate_receipts",
        "dependencies",
        "deployment_consistency",
        "preflight_profiles",
        "schema_version",
        "source",
        "toolchain",
        "watchdog_gate_mode"
      ]
      and .preflight_profiles == {backend:true,native:true,release:true}
      and (.watchdog_gate_mode | type == "string" and length > 0)
      and .deployment_consistency == {
        checked_during_candidate_preflight:false,
        required_before_activation:true
      }
    ' >/dev/null <<<"$build_provenance_json" || {
      echo "preflight build provenance receipt does not bind all required profiles" >&2
      exit 1
    }
    codex_cargo_lock_sha="$(
      cargo_lock_sha_from_provenance "$build_provenance_json" "codex-rs/Cargo.lock"
    )" || exit 1
    native_cargo_lock_sha="$(
      cargo_lock_sha_from_provenance "$build_provenance_json" "apps/hepta-native/Cargo.lock"
    )" || exit 1
    dependency_contract_sha="$(dependency_contract_sha_current)"
    bound_gate_receipts_json="$(jq -ce '.bound_gate_receipts' <<<"$build_provenance_json")" || {
      echo "preflight build provenance is missing bound gate receipts" >&2
      exit 1
    }
    hepta_release_validate_bound_gate_receipts_json \
      "$bound_gate_receipts_json" \
      "$source_commit" \
      "$codex_cargo_lock_sha" \
      "$native_cargo_lock_sha" \
      "$dependency_contract_sha" || {
      echo "preflight bound gate receipts are incomplete or invalid" >&2
      exit 1
    }
    local current_build_provenance
    current_build_provenance="$(
      hepta_release_build_provenance_json "$REPO_ROOT" "$source_commit" "$artifact"
    )"
    jq -e \
      --argjson current "$current_build_provenance" \
      '. as $receipt | ($receipt | del(.preflight_profiles, .watchdog_gate_mode, .bound_gate_receipts, .deployment_consistency)) == $current' \
      >/dev/null <<<"$build_provenance_json" || {
      echo "preflight build provenance no longer matches source, toolchain, dependencies, or artifact" >&2
      exit 1
    }
    preflight_log="$(canonical_file "$preflight_log")"
    preflight_sha="$(sha256_file "$preflight_log")"
    preflight_size="$(stat -f '%z' "$preflight_log")"
  fi
  if [[ "$status" == "ready" ]]; then
    release_id="${source_commit}-${artifact_sha}-${preflight_sha}"
  else
    release_id="${source_commit}-${artifact_sha}"
  fi
  release_dir="$release_root/$release_id"
  manifest_path="$release_dir/manifest.json"
  if [[ -e "$release_dir" ]]; then
    [[ -f "$manifest_path" ]] || {
      echo "existing release directory has no manifest: $release_dir" >&2
      exit 1
    }
    "$0" verify --manifest "$manifest_path" >/dev/null
    jq -e \
      --arg release_id "$release_id" \
      --arg source_commit "$source_commit" \
      --arg artifact_sha "$artifact_sha" \
      --arg preflight_sha "$preflight_sha" \
      --argjson preflight_size "$preflight_size" \
      --argjson build_provenance "$build_provenance_json" '
        .release_id == $release_id
        and .source.commit == $source_commit
        and .artifact.sha256 == $artifact_sha
        and .preflight.log_sha256 == (
          if .status == "ready" then $preflight_sha else null end
        )
        and .preflight.log_size_bytes == (
          if .status == "ready" then $preflight_size else 0 end
        )
        and .preflight.relative_path == (
          if .status == "ready" then "evidence/preflight.log" else null end
        )
        and .build_provenance == $build_provenance
        and .policy.release_contract_version == 3
        and .watchdog.immutable_release_bound == true
        and .watchdog.source.commit_bound == .source.commit_bound
        and .watchdog.source.commit == (
          if .source.commit_bound then .source.commit else null end
        )
      ' "$manifest_path" >/dev/null || {
      echo "existing immutable release evidence differs from the current materialization" >&2
      exit 1
    }
    printf '%s\n' "$manifest_path"
    return 0
  fi
  local staging
  staging="$(mktemp -d "$release_root/.staging.XXXXXX")"
  trap 'chmod -R u+w "$staging" 2>/dev/null || true; rm -rf "$staging"' RETURN
  mkdir -p "$staging/bin"
  cp -p "$artifact" "$staging/bin/hepta"
  chmod 0555 "$staging/bin/hepta"
  watchdog_json="$(
    hepta_immutable_watchdog_materialize \
      "$REPO_ROOT" \
      "$staging" \
      "$source_commit" \
      "$source_commit_bound"
  )"
  if [[ "$status" == "ready" ]]; then
    mkdir -p "$staging/evidence"
    cp -p "$preflight_log" "$staging/evidence/preflight.log"
    chmod 0444 "$staging/evidence/preflight.log"
    chmod 0555 "$staging/evidence"
  fi
  jq -n \
    --arg schema_version "$SCHEMA_VERSION" \
    --arg status "$status" \
    --arg release_id "$release_id" \
    --arg source_commit "$source_commit" \
    --argjson source_commit_bound "$source_commit_bound" \
    --arg artifact_sha256 "$artifact_sha" \
    --argjson artifact_size_bytes "$artifact_size" \
    --argjson preflight_bound "$preflight_bound" \
    --arg preflight_sha256 "$preflight_sha" \
    --arg preflight_source_head "$preflight_head" \
    --argjson preflight_size_bytes "$preflight_size" \
    --argjson build_provenance "$build_provenance_json" \
    --argjson watchdog "$watchdog_json" \
    '{
      schema_version:$schema_version,
      status:$status,
      release_id:$release_id,
      source:{commit:$source_commit,commit_bound:$source_commit_bound},
      artifact:{relative_path:"bin/hepta",sha256:$artifact_sha256,size_bytes:$artifact_size_bytes,executable:true},
      build_provenance:$build_provenance,
      watchdog:$watchdog,
      preflight:{bound:$preflight_bound,relative_path:(if $preflight_bound then "evidence/preflight.log" else null end),source_head:(if $preflight_bound then $preflight_source_head else null end),candidate_source_commit:(if $preflight_bound then $source_commit else null end),candidate_artifact_sha256:(if $preflight_bound then $artifact_sha256 else null end),log_sha256:(if $preflight_bound then $preflight_sha256 else null end),log_size_bytes:(if $preflight_bound then $preflight_size_bytes else 0 end),passed:$preflight_bound},
      policy:{release_contract_version:3,immutable_tree:true,dirty_worktree_source_forbidden:true,activation_byte_change_forbidden:true,restart_performed:false},
      side_effects:{service_restarted:false,active_process_mutated:false,provider_invoked:false,credentials_read:false,memory_or_kg_written:false,channel_message_sent:false}
    }' >"$staging/manifest.json"
  chmod 0444 "$staging/manifest.json"
  chmod 0555 "$staging/bin" "$staging"
  mv "$staging" "$release_dir"
  trap - RETURN
  "$0" verify --manifest "$manifest_path" >/dev/null
  printf '%s\n' "$manifest_path"
}
verify_manifest() {
  local manifest=""
  while (( $# > 0 )); do
    case "$1" in
      --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
      *) usage ;;
    esac
    shift
  done
  [[ -f "$manifest" ]] || {
    echo "missing immutable release manifest: $manifest" >&2
    exit 1
  }
  manifest="$(canonical_file "$manifest")"
  local release_dir artifact artifact_sha expected_size actual_size
  local manifest_status release_contract_version source_commit preflight_sha
  local build_provenance_json codex_cargo_lock_sha native_cargo_lock_sha
  local dependency_contract_sha bound_gate_receipts_json expected_release_id
  local immutable_preflight final_evidence evidence_provenance final_receipt_json
  release_dir="$(dirname "$manifest")"
  jq -e --arg schema "$SCHEMA_VERSION" '
    .schema_version == $schema
    and (.status == "ready" or .status == "legacy_unbound")
    and (.release_id | type == "string" and length > 64)
    and .artifact.relative_path == "bin/hepta"
    and (.artifact.sha256 | test("^[0-9a-f]{64}$"))
    and (.artifact.size_bytes | type == "number" and . > 0)
    and .artifact.executable == true
    and .policy.immutable_tree == true
    and .policy.activation_byte_change_forbidden == true
    and .policy.restart_performed == false
    and (
      (.status == "ready"
        and .source.commit_bound == true
        and (.source.commit | test("^[0-9a-f]{40}$"))
        and .preflight.bound == true
        and .preflight.passed == true
        and (.preflight.source_head | test("^[0-9a-f]{40}$"))
        and .preflight.source_head == .source.commit
        and .preflight.candidate_source_commit == .source.commit
        and .preflight.candidate_artifact_sha256 == .artifact.sha256
        and (.preflight.log_sha256 | test("^[0-9a-f]{64}$"))
        and (.preflight.log_size_bytes | type == "number" and . > 0)
        and .build_provenance.schema_version == "hepta_build_provenance_v1"
        and .build_provenance.source.commit_bound == true
        and .build_provenance.source.commit == .source.commit
        and .build_provenance.toolchain.bound == true
        and (.build_provenance.toolchain.aggregate_sha256 | test("^[0-9a-f]{64}$"))
        and (.build_provenance.toolchain.manifest_inputs | type == "array" and length >= 2)
        and (.build_provenance.toolchain.rustc_verbose_inputs | type == "array" and length >= 2)
        and .build_provenance.dependencies.bound == true
        and (.build_provenance.dependencies.aggregate_sha256 | test("^[0-9a-f]{64}$"))
        and (.build_provenance.dependencies.lock_inputs | type == "array" and length >= 2)
        and .build_provenance.artifact.bound == true
        and .build_provenance.artifact.sha256 == .artifact.sha256
        and .build_provenance.preflight_profiles.backend == true
        and .build_provenance.preflight_profiles.native == true
        and .build_provenance.preflight_profiles.release == true)
      or
      (.status == "legacy_unbound"
        and .source.commit == "unknown"
        and .source.commit_bound == false
        and .build_provenance == null
        and .preflight.bound == false
        and .preflight.passed == false
        and .preflight.source_head == null
        and .preflight.candidate_source_commit == null
        and .preflight.candidate_artifact_sha256 == null
        and .preflight.log_sha256 == null
        and .preflight.log_size_bytes == 0)
    )
  ' "$manifest" >/dev/null
  manifest_status="$(jq -r '.status' "$manifest")"
  release_contract_version="$(jq -r '.policy.release_contract_version // 1' "$manifest")"
  if [[ "$manifest_status" == "ready" ]]; then
    source_commit="$(jq -r '.source.commit' "$manifest")"
    artifact_sha="$(jq -r '.artifact.sha256' "$manifest")"
    preflight_sha="$(jq -r '.preflight.log_sha256' "$manifest")"
    build_provenance_json="$(jq -ce '.build_provenance' "$manifest")"
    hepta_release_validate_build_provenance_json \
      "$build_provenance_json" \
      "$source_commit" \
      "$artifact_sha" || {
      echo "immutable release build provenance is invalid" >&2
      exit 1
    }
    if [[ "$release_contract_version" == "2" || "$release_contract_version" == "3" ]]; then
      jq -e '
        (.policy.release_contract_version == 2 or .policy.release_contract_version == 3)
        and .policy.dirty_worktree_source_forbidden == true
        and .preflight.relative_path == "evidence/preflight.log"
        and (.build_provenance | keys | sort) == [
          "artifact",
          "bound_gate_receipts",
          "dependencies",
          "deployment_consistency",
          "preflight_profiles",
          "schema_version",
          "source",
          "toolchain",
          "watchdog_gate_mode"
        ]
        and .build_provenance.preflight_profiles == {
          backend:true,
          native:true,
          release:true
        }
        and .build_provenance.deployment_consistency == {
          checked_during_candidate_preflight:false,
          required_before_activation:true
        }
      ' "$manifest" >/dev/null || {
        echo "immutable release v2/v3 policy or preflight path is invalid" >&2
        exit 1
      }
      codex_cargo_lock_sha="$(
        cargo_lock_sha_from_provenance "$build_provenance_json" "codex-rs/Cargo.lock"
      )" || exit 1
      native_cargo_lock_sha="$(
        cargo_lock_sha_from_provenance "$build_provenance_json" "apps/hepta-native/Cargo.lock"
      )" || exit 1
      bound_gate_receipts_json="$(jq -ce '.bound_gate_receipts' <<<"$build_provenance_json")" || {
        echo "immutable release build provenance is missing bound gate receipts" >&2
        exit 1
      }
      dependency_contract_sha="$(dependency_contract_sha_current)"
      hepta_release_validate_bound_gate_receipts_json \
        "$bound_gate_receipts_json" \
        "$source_commit" \
        "$codex_cargo_lock_sha" \
        "$native_cargo_lock_sha" \
        "$dependency_contract_sha" || {
        echo "immutable release bound gate receipts are invalid" >&2
        exit 1
      }
      immutable_preflight="$release_dir/evidence/preflight.log"
      [[ -f "$immutable_preflight" && ! -L "$immutable_preflight" ]] || {
        echo "immutable release preflight evidence is missing or not a regular file" >&2
        exit 1
      }
      [[ "$(stat -f '%Lp' "$immutable_preflight")" == "444" ]] || {
        echo "immutable release preflight evidence mode must be 0444" >&2
        exit 1
      }
      [[ "$(sha256_file "$immutable_preflight")" == "$preflight_sha" \
        && "$(stat -f '%z' "$immutable_preflight")" == "$(jq -r '.preflight.log_size_bytes' "$manifest")" ]] || {
        echo "immutable release preflight evidence bytes do not match the manifest" >&2
        exit 1
      }
      final_evidence="$(extract_final_preflight_evidence "$immutable_preflight")" || exit 1
      evidence_provenance="$(sed -n '1p' <<<"$final_evidence")"
      final_receipt_json="$(sed -n '2p' <<<"$final_evidence")"
      [[ "$(jq -cS . <<<"$build_provenance_json")" == "$evidence_provenance" ]] || {
        echo "immutable release manifest provenance differs from copied preflight evidence" >&2
        exit 1
      }
      jq -e \
        --arg source_commit "$source_commit" \
        --arg artifact_sha "$artifact_sha" \
        '
          .source_commit == $source_commit
          and .artifact_sha256 == $artifact_sha
        ' <<<"$final_receipt_json" >/dev/null || {
        echo "immutable release final receipt differs from its manifest" >&2
        exit 1
      }
      if [[ "$release_contract_version" == "3" ]]; then
        hepta_immutable_watchdog_verify \
          "$release_dir" \
          "$source_commit" \
          true \
          "$(jq -ce '.watchdog' "$manifest")" || {
          echo "immutable release watchdog closure is invalid" >&2
          exit 1
        }
      fi
    elif [[ "$release_contract_version" != "1" ]]; then
      echo "unsupported immutable release contract version: $release_contract_version" >&2
      exit 1
    fi
    if [[ "$release_contract_version" == "2" || "$release_contract_version" == "3" ]]; then
      expected_release_id="${source_commit}-${artifact_sha}-${preflight_sha}"
    else
      expected_release_id="${source_commit}-${artifact_sha}"
    fi
  else
    [[ "$release_contract_version" == "1" \
      || "$release_contract_version" == "2" \
      || "$release_contract_version" == "3" ]] || {
      echo "unsupported immutable release contract version: $release_contract_version" >&2
      exit 1
    }
    jq -e '.preflight.relative_path == null' "$manifest" >/dev/null 2>&1 || {
      [[ "$release_contract_version" == "1" ]] || {
        echo "legacy-unbound v2/v3 release must have a null preflight path" >&2
        exit 1
      }
    }
    if [[ "$release_contract_version" == "3" ]]; then
      hepta_immutable_watchdog_verify \
        "$release_dir" \
        unknown \
        false \
        "$(jq -ce '.watchdog' "$manifest")" || {
        echo "legacy immutable release watchdog closure is invalid" >&2
        exit 1
      }
    fi
    expected_release_id="unknown-$(jq -r '.artifact.sha256' "$manifest")"
  fi
  [[ "$(jq -r '.release_id' "$manifest")" == "$expected_release_id" ]] || {
    echo "immutable release ID does not bind its source, artifact, and evidence" >&2
    exit 1
  }
  artifact="$release_dir/$(jq -r '.artifact.relative_path' "$manifest")"
  [[ -f "$artifact" && -x "$artifact" ]] || {
    echo "missing immutable release artifact: $artifact" >&2
    exit 1
  }
  artifact_sha="$(sha256_file "$artifact")"
  [[ "$artifact_sha" == "$(jq -r '.artifact.sha256' "$manifest")" ]] || {
    echo "immutable release artifact SHA-256 mismatch" >&2
    exit 1
  }
  expected_size="$(jq -r '.artifact.size_bytes' "$manifest")"
  actual_size="$(stat -f '%z' "$artifact")"
  [[ "$actual_size" == "$expected_size" ]] || {
    echo "immutable release artifact size mismatch" >&2
    exit 1
  }
  [[ "$(stat -f '%Lp' "$artifact")" == "555" ]] || {
    echo "immutable release artifact mode must be 0555" >&2
    exit 1
  }
  [[ "$(stat -f '%Lp' "$manifest")" == "444" ]] || {
    echo "immutable release manifest mode must be 0444" >&2
    exit 1
  }
  jq -c '{schema_version,status,release_id,source,artifact,build_provenance,watchdog,preflight,policy}' "$manifest"
}
activate() {
  local manifest="" active_link="" expected_current_sha=""
  while (( $# > 0 )); do
    case "$1" in
      --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
      --active-link) shift; [[ $# -gt 0 ]] || usage; active_link="$1" ;;
      --expected-current-sha256) shift; [[ $# -gt 0 ]] || usage; expected_current_sha="$1" ;;
      *) usage ;;
    esac
    shift
  done
  [[ -n "$manifest" && -n "$active_link" && -n "$expected_current_sha" ]] || usage
  require_sha256 "$expected_current_sha"
  "$0" verify --manifest "$manifest" >/dev/null
  manifest="$(canonical_file "$manifest")"
  jq -e '
    .status == "ready"
    and (
      .policy.release_contract_version == 2
      or .policy.release_contract_version == 3
    )
    and .source.commit_bound == true
    and .preflight.bound == true
    and .preflight.passed == true
  ' "$manifest" >/dev/null || {
    echo "immutable activation requires a source-bound passed-preflight candidate" >&2
    exit 1
  }
  [[ -f "$active_link" && -x "$active_link" ]] || {
    echo "active binary must already exist: $active_link" >&2
    exit 1
  }
  local current_sha target_sha target release_id active_dir backup tmp_link manifest_link manifest_tmp
  current_sha="$(sha256_file "$active_link")"
  target_sha="$(jq -r '.artifact.sha256' "$manifest")"
  [[ "$current_sha" == "$expected_current_sha" ]] || {
    echo "active binary changed since review" >&2
    exit 1
  }
  [[ "$current_sha" == "$target_sha" ]] || {
    echo "immutable activation refuses to change active binary bytes" >&2
    exit 1
  }
  target="$(dirname "$manifest")/$(jq -r '.artifact.relative_path' "$manifest")"
  release_id="$(jq -r '.release_id' "$manifest")"
  active_dir="$(dirname "$active_link")"
  mkdir -p "$active_dir/backups"
  backup="$active_dir/backups/hepta.pre-immutable-${current_sha}"
  if [[ ! -e "$backup" ]]; then
    cp -p "$active_link" "$backup"
    chmod 0555 "$backup"
  fi
  tmp_link="$active_dir/.hepta-link.$$"
  ln -s "$target" "$tmp_link"
  mv -f "$tmp_link" "$active_link"
  [[ "$(sha256_file "$active_link")" == "$current_sha" ]] || {
    echo "active symlink SHA-256 changed during immutable activation" >&2
    exit 1
  }
  manifest_link="$active_link.manifest"
  manifest_tmp="$active_dir/.hepta-manifest-link.$$"
  ln -s "$manifest" "$manifest_tmp"
  mv -f "$manifest_tmp" "$manifest_link"
  jq -n --arg status ready --arg release_id "$release_id" --arg active_link "$active_link" \
    --arg target "$target" --arg manifest "$manifest" --arg sha256 "$current_sha" --arg backup "$backup" \
      '{status:$status,release_id:$release_id,active_link:$active_link,target:$target,manifest:$manifest,sha256:$sha256,backup:$backup,bytes_changed:false,service_restarted:false,active_process_mutated:false}'
}
CUTOVER_TRANSACTION_ARMED=false
CUTOVER_ACTIVE_LINK=""
CUTOVER_MANIFEST_LINK=""
CUTOVER_ACTIVE_SNAPSHOT=""
CUTOVER_MANIFEST_SNAPSHOT=""
CUTOVER_ACTIVE_TEMP=""
CUTOVER_MANIFEST_TEMP=""
CUTOVER_LOCK_DIR=""
CUTOVER_BACKUP=""
CUTOVER_BACKUP_TEMP=""
CUTOVER_BACKUP_TEMP_ROOT=""
CUTOVER_CURRENT_SHA=""
CUTOVER_CURRENT_MANIFEST_FILE_SHA=""
CUTOVER_FAILURE_SCHEMA="hepta_immutable_release_cutover_receipt_v1"
CUTOVER_OPERATION="cutover"
cleanup_cutover_backup_temp() {
  [[ -n "$CUTOVER_BACKUP_TEMP" ]] || return 0
  [[ -n "$CUTOVER_BACKUP_TEMP_ROOT" \
    && "$(dirname "$CUTOVER_BACKUP_TEMP")" == "$CUTOVER_BACKUP_TEMP_ROOT" \
    && "$(basename "$CUTOVER_BACKUP_TEMP")" == .hepta-pre-cutover.* \
    && -d "$CUTOVER_BACKUP_TEMP" \
    && ! -L "$CUTOVER_BACKUP_TEMP" ]] || {
    echo "refusing to remove unexpected cutover backup staging path: $CUTOVER_BACKUP_TEMP" >&2
    return 1
  }
  chmod -R u+w "$CUTOVER_BACKUP_TEMP" 2>/dev/null || true
  rm -R "$CUTOVER_BACKUP_TEMP"
  CUTOVER_BACKUP_TEMP=""
}
snapshot_cutover_entry() {
  local source="$1"
  local snapshot="$2"
  if [[ -L "$source" ]]; then
    ln -s "$(readlink "$source")" "$snapshot"
  else
    cp -p "$source" "$snapshot"
  fi
}
rollback_cutover_on_exit() {
  local rc=$?
  local rollback_performed=false rollback_restored=true cleanup_completed=true failure_status
  trap - EXIT
  set +e
  if [[ "$CUTOVER_TRANSACTION_ARMED" == "true" ]]; then
    rollback_performed=true
    mv -f "$CUTOVER_MANIFEST_SNAPSHOT" "$CUTOVER_MANIFEST_LINK" || rollback_restored=false
    mv -f "$CUTOVER_ACTIVE_SNAPSHOT" "$CUTOVER_ACTIVE_LINK" || rollback_restored=false
    [[ "$(sha256_file "$CUTOVER_ACTIVE_LINK" 2>/dev/null)" == "$CUTOVER_CURRENT_SHA" ]] || rollback_restored=false
    [[ "$(sha256_file "$CUTOVER_MANIFEST_LINK" 2>/dev/null)" == "$CUTOVER_CURRENT_MANIFEST_FILE_SHA" ]] || rollback_restored=false
  fi
  rm -f "$CUTOVER_ACTIVE_TEMP" "$CUTOVER_MANIFEST_TEMP" \
    "$CUTOVER_ACTIVE_SNAPSHOT" "$CUTOVER_MANIFEST_SNAPSHOT" 2>/dev/null
  cleanup_cutover_backup_temp || cleanup_completed=false
  [[ -z "$CUTOVER_LOCK_DIR" ]] || rmdir "$CUTOVER_LOCK_DIR" 2>/dev/null
  if [[ "$rollback_performed" == "true" ]]; then
    [[ "$rc" != "0" ]] || rc=1
    failure_status="rolled_back"
    [[ "$rollback_restored" == "true" ]] || failure_status="rollback_failed"
    jq -cn \
      --arg schema_version "$CUTOVER_FAILURE_SCHEMA" \
      --arg operation "$CUTOVER_OPERATION" \
      --arg status "$failure_status" \
      --arg active_link "$CUTOVER_ACTIVE_LINK" \
      --arg manifest_link "$CUTOVER_MANIFEST_LINK" \
      --arg backup "$CUTOVER_BACKUP" \
      --arg current_sha256 "$CUTOVER_CURRENT_SHA" \
      --argjson rollback_restored "$rollback_restored" \
      --argjson cleanup_completed "$cleanup_completed" \
      '{schema_version:$schema_version,operation:$operation,status:$status,active_link:$active_link,manifest_link:$manifest_link,backup:$backup,current_sha256:$current_sha256,operation_completed:false,rollback:{performed:true,restored:$rollback_restored},cleanup_completed:$cleanup_completed,service_restarted:false,launchd_mutated:false,plist_mutated:false}' >&2
  fi
  exit "$rc"
}
validate_cutover_rollback_record() {
  local record="$1" active_link="$2" manifest_link="$3"
  local previous_sha="$4" previous_manifest_sha="$5" previous_manifest_target="$6"
  local deployed_sha="$7" deployed_manifest_sha="$8" deployed_manifest="$9"
  [[ -f "$record" && ! -L "$record" ]] || {
    echo "missing cutover rollback record: $record" >&2
    return 1
  }
  [[ "$(stat -f '%Lp' "$record")" == "444" ]] || {
    echo "cutover rollback record mode must be 0444: $record" >&2
    return 1
  }
  jq -e \
    --arg active_link "$active_link" \
    --arg manifest_link "$manifest_link" \
    --arg previous_sha "$previous_sha" \
    --arg previous_manifest_sha "$previous_manifest_sha" \
    --arg previous_manifest_target "$previous_manifest_target" \
    --arg deployed_sha "$deployed_sha" \
    --arg deployed_manifest_sha "$deployed_manifest_sha" \
    --arg deployed_manifest "$deployed_manifest" '
      .schema_version == "hepta_immutable_release_cutover_rollback_v1"
      and .active_link == $active_link
      and .manifest_link == $manifest_link
      and .previous.artifact_relative_path == "bin/hepta"
      and .previous.artifact_sha256 == $previous_sha
      and .previous.manifest_relative_path == "manifest.json"
      and .previous.manifest_sha256 == $previous_manifest_sha
      and .previous.original_manifest == $previous_manifest_target
      and .deployed.artifact_sha256 == $deployed_sha
      and .deployed.manifest_sha256 == $deployed_manifest_sha
      and .deployed.manifest == $deployed_manifest
      and .policy.expected_current_sha256_required == true
      and .policy.byte_change_required == true
      and .policy.service_restart_forbidden == true
      and .policy.launchd_mutation_forbidden == true
      and .policy.plist_mutation_forbidden == true
    ' "$record" >/dev/null || {
      echo "cutover rollback record does not match the reviewed release pair: $record" >&2
      return 1
    }
}
replace_release_links_transactionally() {
  local active_link="$1" manifest_link="$2" target="$3" manifest="$4"
  local current_sha="$5" current_manifest_file_sha="$6" target_sha="$7"
  local active_dir suffix failure_point
  active_dir="$(dirname "$active_link")"
  suffix="$$.$RANDOM"
  CUTOVER_ACTIVE_TEMP="$active_dir/.hepta-cutover-active.$suffix"
  CUTOVER_MANIFEST_TEMP="$active_dir/.hepta-cutover-manifest.$suffix"
  CUTOVER_ACTIVE_SNAPSHOT="$active_dir/.hepta-cutover-active-rollback.$suffix"
  CUTOVER_MANIFEST_SNAPSHOT="$active_dir/.hepta-cutover-manifest-rollback.$suffix"
  ln -s "$target" "$CUTOVER_ACTIVE_TEMP"
  ln -s "$manifest" "$CUTOVER_MANIFEST_TEMP"
  snapshot_cutover_entry "$active_link" "$CUTOVER_ACTIVE_SNAPSHOT"
  snapshot_cutover_entry "$manifest_link" "$CUTOVER_MANIFEST_SNAPSHOT"
  [[ "$(sha256_file "$CUTOVER_ACTIVE_TEMP")" == "$target_sha" ]] || {
    echo "pre-staged release binary link SHA-256 mismatch" >&2
    exit 1
  }
  "$0" verify --manifest "$CUTOVER_MANIFEST_TEMP" >/dev/null
  [[ "$(sha256_file "$active_link")" == "$current_sha" \
    && "$(sha256_file "$manifest_link")" == "$current_manifest_file_sha" ]] || {
    echo "active release changed while replacement was being staged" >&2
    exit 1
  }
  failure_point="${HEPTA_IMMUTABLE_RELEASE_CUTOVER_TEST_FAILURE_POINT:-none}"
  [[ "$failure_point" == "none" || "$failure_point" == "after_active_swap" || "$failure_point" == "after_manifest_swap" ]] || {
    echo "invalid immutable cutover test failure point" >&2
    exit 1
  }
  CUTOVER_TRANSACTION_ARMED=true
  mv -f "$CUTOVER_ACTIVE_TEMP" "$active_link"
  [[ "$failure_point" != "after_active_swap" ]] || {
    echo "injected immutable cutover failure after active swap" >&2
    exit 1
  }
  mv -f "$CUTOVER_MANIFEST_TEMP" "$manifest_link"
  [[ "$failure_point" != "after_manifest_swap" ]] || {
    echo "injected immutable cutover failure after manifest swap" >&2
    exit 1
  }
  [[ -L "$active_link" && "$(readlink "$active_link")" == "$target" \
    && "$(sha256_file "$active_link")" == "$target_sha" ]] || {
    echo "active binary link verification failed after replacement" >&2
    exit 1
  }
  [[ -L "$manifest_link" && "$(readlink "$manifest_link")" == "$manifest" ]] || {
    echo "active manifest link verification failed after replacement" >&2
    exit 1
  }
  "$0" verify --manifest "$manifest_link" >/dev/null
  rmdir "$CUTOVER_LOCK_DIR"
  CUTOVER_LOCK_DIR=""
  CUTOVER_TRANSACTION_ARMED=false
  trap - EXIT
  rm -f "$CUTOVER_ACTIVE_SNAPSHOT" "$CUTOVER_MANIFEST_SNAPSHOT"
}
cutover() {
  local manifest="" active_link="" expected_current_sha=""
  while (( $# > 0 )); do
    case "$1" in
      --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
      --active-link) shift; [[ $# -gt 0 ]] || usage; active_link="$1" ;;
      --expected-current-sha256) shift; [[ $# -gt 0 ]] || usage; expected_current_sha="$1" ;;
      *) usage ;;
    esac
    shift
  done
  [[ -n "$manifest" && -n "$active_link" && -n "$expected_current_sha" ]] || usage
  require_sha256 "$expected_current_sha"
  "$0" verify --manifest "$manifest" >/dev/null
  manifest="$(canonical_file "$manifest")"
  jq -e '
    .status == "ready"
    and (
      .policy.release_contract_version == 2
      or .policy.release_contract_version == 3
    )
    and .source.commit_bound == true
    and .preflight.bound == true
    and .preflight.passed == true
  ' "$manifest" >/dev/null || {
    echo "immutable cutover requires a source-bound passed-preflight candidate" >&2
    exit 1
  }
  local target target_sha target_manifest_file_sha release_id active_dir manifest_link lock_dir
  target="$(canonical_file "$(dirname "$manifest")/$(jq -r '.artifact.relative_path' "$manifest")")"
  target_sha="$(jq -r '.artifact.sha256' "$manifest")"
  target_manifest_file_sha="$(sha256_file "$manifest")"
  release_id="$(jq -r '.release_id' "$manifest")"
  require_sha256 "$target_sha"
  active_dir="$(cd "$(dirname "$active_link")" && pwd -P)"
  active_link="$active_dir/$(basename "$active_link")"
  manifest_link="$active_link.manifest"
  lock_dir="$active_dir/.hepta-immutable-release-cutover.lock"
  mkdir "$lock_dir" 2>/dev/null || {
    echo "immutable cutover lock is already held: $lock_dir" >&2
    exit 1
  }
  CUTOVER_ACTIVE_LINK="$active_link"
  CUTOVER_MANIFEST_LINK="$manifest_link"
  CUTOVER_LOCK_DIR="$lock_dir"
  trap rollback_cutover_on_exit EXIT
  [[ -f "$active_link" && -x "$active_link" ]] || {
    echo "active binary must already exist: $active_link" >&2
    exit 1
  }
  [[ -f "$manifest_link" ]] || {
    echo "active manifest must already exist: $manifest_link" >&2
    exit 1
  }
  "$0" verify --manifest "$manifest_link" >/dev/null
  local current_sha current_manifest_sha current_manifest_file_sha current_manifest_target
  local backup_root backup backup_manifest rollback_record rollback_record_sha rollback_record_previous_manifest
  local backup_staging backup_created current_preflight_relative current_release_contract_version
  local current_watchdog_relative current_watchdog_mode
  current_sha="$(sha256_file "$active_link")"
  current_manifest_sha="$(jq -r '.artifact.sha256' "$manifest_link")"
  current_manifest_file_sha="$(sha256_file "$manifest_link")"
  current_manifest_target="$(canonical_file "$manifest_link")"
  [[ "$current_sha" == "$expected_current_sha" ]] || {
    echo "active binary changed since cutover review" >&2
    exit 1
  }
  [[ "$current_manifest_sha" == "$current_sha" ]] || {
    echo "active manifest does not bind the current active binary" >&2
    exit 1
  }
  [[ "$current_sha" != "$target_sha" ]] || {
    echo "immutable cutover requires different target bytes" >&2
    exit 1
  }
  mkdir -p "$active_dir/backups"
  backup_root="$active_dir/backups/hepta.pre-cutover-$current_sha-to-$target_sha"
  backup="$backup_root/bin/hepta"
  backup_manifest="$backup_root/manifest.json"
  rollback_record="$backup_root/rollback.json"
  backup_created=false
  if [[ -e "$backup_root" || -L "$backup_root" ]]; then
    [[ -d "$backup_root" && ! -L "$backup_root" \
      && "$(stat -f '%Lp' "$backup_root")" == "555" \
      && "$(stat -f '%Lp' "$backup_root/bin")" == "555" \
      && "$(stat -f '%Lp' "$backup")" == "555" \
      && "$(sha256_file "$backup")" == "$current_sha" \
      && "$(sha256_file "$backup_manifest")" == "$current_manifest_file_sha" ]] || {
      echo "existing cutover rollback bundle does not match the reviewed release pair: $backup_root" >&2
      exit 1
    }
    "$0" verify --manifest "$backup_manifest" >/dev/null
    rollback_record_previous_manifest="$(jq -r '.previous.original_manifest // empty' "$rollback_record" 2>/dev/null || true)"
  else
    backup_staging="$(mktemp -d "$active_dir/backups/.hepta-pre-cutover.XXXXXX")"
    CUTOVER_BACKUP_TEMP="$backup_staging"
    CUTOVER_BACKUP_TEMP_ROOT="$active_dir/backups"
    mkdir "$backup_staging/bin"
    cp -p "$(canonical_file "$active_link")" "$backup_staging/bin/hepta"
    cp -p "$(canonical_file "$manifest_link")" "$backup_staging/manifest.json"
    current_preflight_relative="$(
      jq -r '.preflight.relative_path // empty' "$backup_staging/manifest.json"
    )"
    if [[ -n "$current_preflight_relative" ]]; then
      [[ "$current_preflight_relative" == "evidence/preflight.log" ]] || {
        echo "current release has an unexpected preflight evidence path" >&2
        exit 1
      }
      mkdir "$backup_staging/evidence"
      cp -p \
        "$(dirname "$current_manifest_target")/$current_preflight_relative" \
        "$backup_staging/evidence/preflight.log"
      chmod 0444 "$backup_staging/evidence/preflight.log"
      chmod 0555 "$backup_staging/evidence"
    fi
    current_release_contract_version="$(
      jq -r '.policy.release_contract_version // 1' "$backup_staging/manifest.json"
    )"
    if [[ "$current_release_contract_version" == "3" ]]; then
      while IFS=$'\t' read -r current_watchdog_relative current_watchdog_mode; do
        mkdir -p "$(dirname "$backup_staging/$current_watchdog_relative")"
        cp -p \
          "$(dirname "$current_manifest_target")/$current_watchdog_relative" \
          "$backup_staging/$current_watchdog_relative"
        chmod "$current_watchdog_mode" "$backup_staging/$current_watchdog_relative"
      done < <(
        jq -r '.watchdog.files[] | [.relative_path,.mode] | @tsv' \
          "$backup_staging/manifest.json"
      )
      find "$backup_staging/scripts" "$backup_staging/docs" \
        -type d -exec chmod 0555 {} +
    fi
    chmod 0555 "$backup_staging/bin/hepta" "$backup_staging/bin"
    chmod 0444 "$backup_staging/manifest.json"
    "$0" verify --manifest "$backup_staging/manifest.json" >/dev/null
    jq -n \
      --arg schema_version "hepta_immutable_release_cutover_rollback_v1" \
      --arg active_link "$active_link" --arg manifest_link "$manifest_link" \
      --arg previous_sha256 "$current_sha" --arg previous_manifest_sha256 "$current_manifest_file_sha" \
      --arg previous_manifest_target "$current_manifest_target" \
      --arg deployed_sha256 "$target_sha" --arg deployed_manifest_sha256 "$target_manifest_file_sha" \
      --arg deployed_manifest "$manifest" \
      '{schema_version:$schema_version,active_link:$active_link,manifest_link:$manifest_link,previous:{artifact_relative_path:"bin/hepta",artifact_sha256:$previous_sha256,manifest_relative_path:"manifest.json",manifest_sha256:$previous_manifest_sha256,original_manifest:$previous_manifest_target},deployed:{artifact_sha256:$deployed_sha256,manifest_sha256:$deployed_manifest_sha256,manifest:$deployed_manifest},policy:{expected_current_sha256_required:true,byte_change_required:true,service_restart_forbidden:true,launchd_mutation_forbidden:true,plist_mutation_forbidden:true}}' >"$backup_staging/rollback.json"
    chmod 0444 "$backup_staging/rollback.json"
    chmod 0555 "$backup_staging"
    mv "$backup_staging" "$backup_root"
    CUTOVER_BACKUP_TEMP=""
    backup_created=true
    rollback_record_previous_manifest="$current_manifest_target"
  fi
  validate_cutover_rollback_record \
    "$rollback_record" "$active_link" "$manifest_link" \
    "$current_sha" "$current_manifest_file_sha" "$rollback_record_previous_manifest" \
    "$target_sha" "$target_manifest_file_sha" "$manifest"
  rollback_record_sha="$(sha256_file "$rollback_record")"
  CUTOVER_BACKUP="$backup"
  CUTOVER_CURRENT_SHA="$current_sha"
  CUTOVER_CURRENT_MANIFEST_FILE_SHA="$current_manifest_file_sha"
  local receipt
  receipt="$(jq -cn \
    --arg schema_version "hepta_immutable_release_cutover_receipt_v1" \
    --arg status "ready" \
    --arg release_id "$release_id" \
    --arg active_link "$active_link" \
    --arg target "$target" \
    --arg manifest_link "$manifest_link" \
    --arg manifest "$manifest" \
    --arg expected_current_sha256 "$expected_current_sha" \
    --arg previous_sha256 "$current_sha" \
    --arg previous_manifest "$current_manifest_target" \
    --arg previous_manifest_sha256 "$current_manifest_file_sha" \
    --arg target_sha256 "$target_sha" \
    --arg target_manifest_sha256 "$target_manifest_file_sha" \
    --arg backup_root "$backup_root" \
    --arg backup "$backup" \
    --arg backup_manifest "$backup_manifest" \
    --arg rollback_record "$rollback_record" \
    --arg rollback_record_sha256 "$rollback_record_sha" \
    --argjson backup_created "$backup_created" \
    '{schema_version:$schema_version,status:$status,release_id:$release_id,active_link:$active_link,target:$target,manifest_link:$manifest_link,manifest:$manifest,expected_current_sha256:$expected_current_sha256,previous:{artifact_sha256:$previous_sha256,manifest:$previous_manifest,manifest_sha256:$previous_manifest_sha256},target_release:{artifact_sha256:$target_sha256,manifest:$manifest,manifest_sha256:$target_manifest_sha256},backup:{bundle:$backup_root,artifact:$backup,manifest:$backup_manifest,artifact_sha256:$previous_sha256,manifest_sha256:$previous_manifest_sha256,created:$backup_created,verified:true},cas_verified:true,bytes_changed:true,links_pre_staged:true,individual_links_atomically_replaced:true,pair_transactional_with_trap:true,crash_consistent_pair:false,link_pair_consistency_verified_before_restart:true,runtime_deployment_consistency_required_after_restart:true,manifest_linked:true,rollback:{armed_during_cutover:true,performed:false,backup_available:true,record:$rollback_record,record_sha256:$rollback_record_sha256},service_restarted:false,active_process_mutated:false,launchd_mutated:false,plist_mutated:false}')"
  replace_release_links_transactionally \
    "$active_link" "$manifest_link" "$target" "$manifest" \
    "$current_sha" "$current_manifest_file_sha" "$target_sha"
  printf '%s\n' "$receipt"
}
rollback_release() {
  local receipt_path="" expected_current_sha=""
  while (( $# > 0 )); do
    case "$1" in
      --receipt) shift; [[ $# -gt 0 ]] || usage; receipt_path="$1" ;;
      --expected-current-sha256) shift; [[ $# -gt 0 ]] || usage; expected_current_sha="$1" ;;
      *) usage ;;
    esac
    shift
  done
  [[ -n "$receipt_path" && -n "$expected_current_sha" ]] || usage
  require_sha256 "$expected_current_sha"
  [[ -f "$receipt_path" && ! -L "$receipt_path" ]] || {
    echo "rollback receipt must be a regular file: $receipt_path" >&2
    exit 1
  }
  receipt_path="$(canonical_file "$receipt_path")"
  [[ "$(stat -f '%Lp' "$receipt_path")" == "444" ]] || {
    echo "rollback receipt mode must be 0444: $receipt_path" >&2
    exit 1
  }
  jq -e '
    .schema_version == "hepta_immutable_release_cutover_rollback_v1"
    and (.active_link | type == "string" and startswith("/"))
    and (.manifest_link | type == "string" and startswith("/"))
    and .previous.artifact_relative_path == "bin/hepta"
    and (.previous.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and .previous.manifest_relative_path == "manifest.json"
    and (.previous.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.previous.original_manifest | type == "string" and startswith("/"))
    and (.deployed.artifact_sha256 | test("^[0-9a-f]{64}$"))
    and (.deployed.manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.deployed.manifest | type == "string" and startswith("/"))
    and .policy.expected_current_sha256_required == true
    and .policy.byte_change_required == true
    and .policy.service_restart_forbidden == true
    and .policy.launchd_mutation_forbidden == true
    and .policy.plist_mutation_forbidden == true
  ' "$receipt_path" >/dev/null || {
    echo "invalid immutable cutover rollback receipt: $receipt_path" >&2
    exit 1
  }
  local bundle_root active_link manifest_link previous_artifact previous_manifest previous_manifest_target
  local previous_sha previous_manifest_sha deployed_sha deployed_manifest_sha deployed_manifest deployed_artifact
  local active_dir lock_dir current_sha current_manifest_sha current_manifest_file_sha rollback_receipt
  bundle_root="$(dirname "$receipt_path")"
  active_link="$(jq -r '.active_link' "$receipt_path")"
  manifest_link="$(jq -r '.manifest_link' "$receipt_path")"
  previous_artifact="$bundle_root/$(jq -r '.previous.artifact_relative_path' "$receipt_path")"
  previous_manifest="$bundle_root/$(jq -r '.previous.manifest_relative_path' "$receipt_path")"
  previous_sha="$(jq -r '.previous.artifact_sha256' "$receipt_path")"
  previous_manifest_sha="$(jq -r '.previous.manifest_sha256' "$receipt_path")"
  previous_manifest_target="$(jq -r '.previous.original_manifest' "$receipt_path")"
  deployed_sha="$(jq -r '.deployed.artifact_sha256' "$receipt_path")"
  deployed_manifest_sha="$(jq -r '.deployed.manifest_sha256' "$receipt_path")"
  deployed_manifest="$(jq -r '.deployed.manifest' "$receipt_path")"
  require_sha256 "$previous_sha"
  require_sha256 "$previous_manifest_sha"
  require_sha256 "$deployed_sha"
  require_sha256 "$deployed_manifest_sha"
  [[ "$previous_sha" != "$deployed_sha" ]] || {
    echo "immutable rollback requires different current and previous bytes" >&2
    exit 1
  }
  [[ "$expected_current_sha" == "$deployed_sha" ]] || {
    echo "rollback expected-current SHA-256 does not match the cutover receipt" >&2
    exit 1
  }
  [[ -f "$previous_artifact" && -x "$previous_artifact" \
    && "$(stat -f '%Lp' "$previous_artifact")" == "555" \
    && "$(sha256_file "$previous_artifact")" == "$previous_sha" ]] || {
    echo "durable rollback artifact does not match its receipt" >&2
    exit 1
  }
  "$0" verify --manifest "$previous_manifest" >/dev/null
  [[ "$(sha256_file "$previous_manifest")" == "$previous_manifest_sha" \
    && "$(jq -r '.artifact.sha256' "$previous_manifest")" == "$previous_sha" ]] || {
    echo "durable rollback manifest does not bind its artifact" >&2
    exit 1
  }
  "$0" verify --manifest "$deployed_manifest" >/dev/null
  [[ "$(sha256_file "$deployed_manifest")" == "$deployed_manifest_sha" \
    && "$(jq -r '.artifact.sha256' "$deployed_manifest")" == "$deployed_sha" ]] || {
    echo "deployed manifest no longer matches the rollback receipt" >&2
    exit 1
  }
  deployed_artifact="$(canonical_file "$(dirname "$deployed_manifest")/$(jq -r '.artifact.relative_path' "$deployed_manifest")")"
  validate_cutover_rollback_record \
    "$receipt_path" "$active_link" "$manifest_link" \
    "$previous_sha" "$previous_manifest_sha" "$previous_manifest_target" \
    "$deployed_sha" "$deployed_manifest_sha" "$deployed_manifest"
  active_dir="$(cd "$(dirname "$active_link")" && pwd -P)"
  active_link="$active_dir/$(basename "$active_link")"
  [[ "$manifest_link" == "$active_link.manifest" ]] || {
    echo "rollback receipt manifest link is not paired with its active link" >&2
    exit 1
  }
  lock_dir="$active_dir/.hepta-immutable-release-cutover.lock"
  mkdir "$lock_dir" 2>/dev/null || {
    echo "immutable cutover lock is already held: $lock_dir" >&2
    exit 1
  }
  CUTOVER_ACTIVE_LINK="$active_link"
  CUTOVER_MANIFEST_LINK="$manifest_link"
  CUTOVER_LOCK_DIR="$lock_dir"
  CUTOVER_BACKUP="$previous_artifact"
  CUTOVER_FAILURE_SCHEMA="hepta_immutable_release_rollback_receipt_v1"
  CUTOVER_OPERATION="rollback"
  trap rollback_cutover_on_exit EXIT
  [[ -f "$active_link" && -x "$active_link" && -f "$manifest_link" ]] || {
    echo "active release pair is missing during rollback" >&2
    exit 1
  }
  "$0" verify --manifest "$manifest_link" >/dev/null
  current_sha="$(sha256_file "$active_link")"
  current_manifest_sha="$(jq -r '.artifact.sha256' "$manifest_link")"
  current_manifest_file_sha="$(sha256_file "$manifest_link")"
  [[ "$current_sha" == "$expected_current_sha" ]] || {
    echo "active binary changed since rollback review" >&2
    exit 1
  }
  [[ "$current_manifest_sha" == "$current_sha" \
    && "$current_manifest_file_sha" == "$deployed_manifest_sha" \
    && "$(canonical_file "$active_link")" == "$deployed_artifact" \
    && "$(canonical_file "$manifest_link")" == "$deployed_manifest" ]] || {
    echo "active release pair does not match the deployed cutover receipt" >&2
    exit 1
  }
  CUTOVER_CURRENT_SHA="$current_sha"
  CUTOVER_CURRENT_MANIFEST_FILE_SHA="$current_manifest_file_sha"
  rollback_receipt="$(jq -cn \
    --arg schema_version "hepta_immutable_release_rollback_receipt_v1" \
    --arg status "ready" \
    --arg receipt "$receipt_path" \
    --arg active_link "$active_link" \
    --arg manifest_link "$manifest_link" \
    --arg expected_current_sha256 "$expected_current_sha" \
    --arg previous_sha256 "$previous_sha" \
    --arg previous_manifest "$previous_manifest" \
    --arg previous_manifest_sha256 "$previous_manifest_sha" \
    '{schema_version:$schema_version,status:$status,receipt:$receipt,active_link:$active_link,manifest_link:$manifest_link,expected_current_sha256:$expected_current_sha256,restored:{artifact_sha256:$previous_sha256,manifest:$previous_manifest,manifest_sha256:$previous_manifest_sha256},cas_verified:true,bytes_changed:true,links_pre_staged:true,individual_links_atomically_replaced:true,pair_transactional_with_trap:true,crash_consistent_pair:false,link_pair_consistency_verified_before_restart:true,runtime_deployment_consistency_required_after_restart:true,service_restarted:false,active_process_mutated:false,launchd_mutated:false,plist_mutated:false}')"
  replace_release_links_transactionally \
    "$active_link" "$manifest_link" "$previous_artifact" "$previous_manifest" \
    "$current_sha" "$current_manifest_file_sha" "$previous_sha"
  printf '%s\n' "$rollback_receipt"
}
self_test_rehash_bound_gate_receipts() {
  local receipts_json="$1"
  local gate_id field sha_field embedded_sha
  for gate_id in native-ingress-composition dependency-security gate-compat-debt; do
    for field in receipt self_test_receipt; do
      if [[ "$field" == "receipt" ]]; then
        sha_field="receipt_sha256"
      else
        sha_field="self_test_sha256"
      fi
      embedded_sha="$(
        jq -cS --arg id "$gate_id" --arg field "$field" \
          '.gates[] | select(.id == $id) | .[$field]' \
          <<<"$receipts_json" \
          | hepta_release_sha256_text
      )"
      receipts_json="$(
        jq -c \
          --arg id "$gate_id" \
          --arg field "$sha_field" \
          --arg embedded_sha "$embedded_sha" \
          '(.gates[] | select(.id == $id) | .[$field]) = $embedded_sha' \
          <<<"$receipts_json"
      )"
    done
  done
  jq -cS . <<<"$receipts_json"
}
self_test_expect_materialize_denied() {
  local label="$1"
  local tool="$2"
  local artifact="$3"
  local source_commit="$4"
  local provenance_json="$5"
  local fixture_root="$6"
  local preflight="$fixture_root/preflight.log"
  mkdir -p "$fixture_root"
  hepta_release_write_fixture_preflight_log "$preflight" "$source_commit" "$provenance_json"
  if "$tool" materialize \
    --artifact "$artifact" \
    --source-commit "$source_commit" \
    --preflight-log "$preflight" \
    --release-root "$fixture_root/releases" >/dev/null 2>&1; then
    echo "immutable release materialization accepted $label" >&2
    return 1
  fi
}
self_test() {
  [[ $# -eq 0 ]] || usage
  local source_root root tool tmp artifact source_commit preflight bound_manifest legacy_manifest
  local fixture_sha activation different different_manifest provenance invalid_manifest short_head
  local missing_preflight_rc legacy_activation_rc tampered_manifest conflicting_preflight missing_source_preflight wrong_banner_preflight
  local different_preflight different_provenance different_sha cutover_receipt cutover_rc rollback_rc rollback_active
  local rollback_record rollback_receipt rollback_manifest failure_point failure_log failure_receipt
  local receipts legacy_h_receipts mutated_receipts mutated_provenance negative_name negative_filter negative_root
  local evidence_variant_preflight evidence_variant_provenance evidence_variant_manifest tampered_release_dir
  local missing_receipts_verify_dir missing_receipts_manifest
  local dirty_source_fixture tampered_evidence_manifest tampered_evidence_file
  local canonical_preflight_artifact artifact_override_rc
  local immutable_watchdog immutable_watchdog_sha
  local watchdog_installer watchdog_plist watchdog_install_receipt source_watchdog_backup
  source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  tmp="$(mktemp -d /tmp/hepta-immutable-release-tree-self-test.XXXXXX)"
  root="$tmp/source"
  mkdir -p \
    "$root/scripts/lib" \
    "$root/docs/decisions" \
    "$root/codex-rs" \
    "$root/apps/hepta-native"
  cp "$source_root/scripts/hepta-immutable-release-tree" "$root/scripts/"
  cp "$source_root/scripts/hepta-watchdog.sh" "$root/scripts/"
  cp "$source_root/scripts/hepta-install-live-watchdog" "$root/scripts/"
  cp "$source_root/scripts/lib/hepta-release-provenance.sh" "$root/scripts/lib/"
  cp \
    "$source_root/scripts/lib/hepta-watchdog-release-evidence-v1.sh" \
    "$source_root/scripts/lib/hepta-watchdog-product-boundary-v1.sh" \
    "$source_root/scripts/lib/hepta-immutable-watchdog-closure-v1.sh" \
    "$root/scripts/lib/"
  cp "$source_root/scripts/hepta-dependency-security-v1.json" "$root/scripts/"
  cp "$source_root/scripts/hepta-dependency-exception-policy-v1.json" "$root/scripts/"
  cp \
    "$source_root/docs/decisions/hepta-product-boundary-v1.json" \
    "$root/docs/decisions/"
  cp "$source_root/codex-rs/"{Cargo.lock,rust-toolchain.toml} "$root/codex-rs/"
  cp "$source_root/apps/hepta-native/"{Cargo.lock,rust-toolchain.toml} \
    "$root/apps/hepta-native/"
  git -C "$root" init -q
  git -C "$root" add .
  git -C "$root" \
    -c user.name="Hepta Release Self-Test" \
    -c user.email="hepta-release-self-test@invalid" \
    commit -qm "fixture"
  tool="$root/scripts/hepta-immutable-release-tree"
  dirty_source_fixture="$root/.hepta-immutable-release-source-dirty-self-test.$$"
  trap 'rm -f "$dirty_source_fixture"; chmod -R u+w "$tmp" 2>/dev/null || true; rm -rf "$tmp"' RETURN
  artifact="$tmp/hepta"
  printf '%s\n' '#!/usr/bin/env bash' 'printf "hepta fixture\n"' >"$artifact"
  chmod 0755 "$artifact"
  source_commit="$(git -C "$root" rev-parse HEAD)"
  short_head="${source_commit:0:10}"
  preflight="$tmp/preflight.log"
  provenance="$(hepta_release_fixture_complete_provenance_json "$root" "$source_commit" "$artifact")"
  hepta_release_write_fixture_preflight_log "$preflight" "$source_commit" "$provenance"
  canonical_preflight_artifact="$(
    hepta_release_canonical_preflight_artifact_path "$tmp/cargo-target" ""
  )"
  [[ "$canonical_preflight_artifact" == "$tmp/cargo-target/release/hepta" ]] || {
    echo "canonical release artifact resolver did not select the Cargo target artifact" >&2
    exit 1
  }
  artifact_override_rc=0
  hepta_release_canonical_preflight_artifact_path \
    "$tmp/cargo-target" "$tmp/unreviewed-artifact" >/dev/null 2>&1 \
    || artifact_override_rc=$?
  [[ "$artifact_override_rc" == "1" ]] || {
    echo "canonical release artifact resolver accepted an override" >&2
    exit 1
  }
  bound_manifest="$($tool materialize --artifact "$artifact" --source-commit "$source_commit" --preflight-log "$preflight" --release-root "$tmp/releases")"
  $tool verify --manifest "$bound_manifest" | jq -e '
    .status == "ready"
    and .source.commit_bound == true
    and .build_provenance.toolchain.bound == true
    and .build_provenance.dependencies.bound == true
    and .build_provenance.artifact.bound == true
    and .preflight.bound == true
    and .preflight.source_head == .source.commit
    and .preflight.candidate_source_commit == .source.commit
    and .preflight.candidate_artifact_sha256 == .artifact.sha256
    and .preflight.relative_path == "evidence/preflight.log"
    and .policy.release_contract_version == 3
    and .policy.immutable_tree == true
    and .watchdog.immutable_release_bound == true
    and .watchdog.source.commit_bound == true
    and .watchdog.source.commit == .source.commit
    and .watchdog.entrypoint == "scripts/hepta-watchdog.sh"
    and .watchdog.file_count == 9
  ' >/dev/null
  immutable_watchdog="$(dirname "$bound_manifest")/$(jq -r '.watchdog.entrypoint' "$bound_manifest")"
  immutable_watchdog_sha="$(sha256_file "$immutable_watchdog")"
  [[ "$immutable_watchdog_sha" == "$(
    jq -r \
      '.watchdog.files[] | select(.relative_path == "scripts/hepta-watchdog.sh") | .sha256' \
      "$bound_manifest"
  )" ]] || {
    echo "immutable watchdog entrypoint is not manifest-bound" >&2
    exit 1
  }
  chmod u+w "$(dirname "$bound_manifest")" "$(dirname "$immutable_watchdog")" "$immutable_watchdog"
  printf '\n# tampered after materialize\n' >>"$immutable_watchdog"
  chmod 0555 "$immutable_watchdog" "$(dirname "$immutable_watchdog")" "$(dirname "$bound_manifest")"
  if $tool verify --manifest "$bound_manifest" >/dev/null 2>&1; then
    echo "immutable release verification accepted watchdog tampering" >&2
    exit 1
  fi
  chmod u+w "$(dirname "$bound_manifest")" "$(dirname "$immutable_watchdog")" "$immutable_watchdog"
  cp "$root/scripts/hepta-watchdog.sh" "$immutable_watchdog"
  chmod 0555 "$immutable_watchdog" "$(dirname "$immutable_watchdog")" "$(dirname "$bound_manifest")"
  $tool verify --manifest "$bound_manifest" >/dev/null
  watchdog_installer="$root/scripts/hepta-install-live-watchdog"
  watchdog_plist="$tmp/ai.hepta.immutable-watchdog-fixture.plist"
  watchdog_install_receipt="$(
    "$watchdog_installer" \
      --manifest "$bound_manifest" \
      --installed-bin "$(dirname "$bound_manifest")/bin/hepta" \
      --installed-receipt "$bound_manifest" \
      --label ai.hepta.immutable-watchdog-fixture \
      --launch-agent "$watchdog_plist"
  )"
  jq -e \
    --arg program "$immutable_watchdog" \
    --arg manifest "$bound_manifest" \
    '
      .status == "ready"
      and .program == $program
      and .manifest == $manifest
      and .loaded == false
      and .mutable_worktree_dependency == false
    ' >/dev/null <<<"$watchdog_install_receipt"
  plutil -lint "$watchdog_plist" >/dev/null
  [[ "$(
    plutil -extract ProgramArguments.0 raw -o - "$watchdog_plist"
  )" == "$immutable_watchdog" ]] || {
    echo "immutable watchdog plist does not target the release entrypoint" >&2
    exit 1
  }
  source_watchdog_backup="$tmp/source-hepta-watchdog.sh"
  cp "$root/scripts/hepta-watchdog.sh" "$source_watchdog_backup"
  printf '\n# dirty source watchdog must not affect installed plist\n' \
    >>"$root/scripts/hepta-watchdog.sh"
  watchdog_install_receipt="$(
    "$watchdog_installer" \
      --manifest "$bound_manifest" \
      --installed-bin "$(dirname "$bound_manifest")/bin/hepta" \
      --installed-receipt "$bound_manifest" \
      --label ai.hepta.immutable-watchdog-fixture \
      --launch-agent "$watchdog_plist"
  )"
  jq -e --arg program "$immutable_watchdog" '
    .status == "ready"
    and .program == $program
    and .mutable_worktree_dependency == false
  ' >/dev/null <<<"$watchdog_install_receipt"
  cp "$source_watchdog_backup" "$root/scripts/hepta-watchdog.sh"
  : >"$dirty_source_fixture"
  if $tool materialize \
    --artifact "$artifact" \
    --source-commit "$source_commit" \
    --preflight-log "$preflight" \
    --release-root "$tmp/dirty-source-releases" >/dev/null 2>&1; then
    echo "immutable release materialization accepted a dirty source worktree" >&2
    exit 1
  fi
  rm -f "$dirty_source_fixture"
  tampered_evidence_manifest="$(
    $tool materialize \
      --artifact "$artifact" \
      --source-commit "$source_commit" \
      --preflight-log "$preflight" \
      --release-root "$tmp/tampered-evidence-releases"
  )"
  tampered_evidence_file="$(dirname "$tampered_evidence_manifest")/evidence/preflight.log"
  chmod u+w "$(dirname "$tampered_evidence_manifest")" "$(dirname "$tampered_evidence_file")"
  chmod u+w "$tampered_evidence_file"
  printf '%s\n' '[forged-after-materialize]' >>"$tampered_evidence_file"
  chmod 0444 "$tampered_evidence_file"
  chmod 0555 "$(dirname "$tampered_evidence_file")" "$(dirname "$tampered_evidence_manifest")"
  if $tool verify --manifest "$tampered_evidence_manifest" >/dev/null 2>&1; then
    echo "immutable release verification accepted tampered copied preflight evidence" >&2
    exit 1
  fi
  mutated_provenance="$(jq -c 'del(.bound_gate_receipts)' <<<"$provenance")"
  self_test_expect_materialize_denied \
    "missing bound gate receipts" \
    "$tool" "$artifact" "$source_commit" "$mutated_provenance" "$tmp/negative-missing-receipts"
  receipts="$(jq -c '.bound_gate_receipts' <<<"$provenance")"
  legacy_h_receipts="$(
    jq -c \
      --arg codex_lock_sha "$HEPTA_LEGACY_H_CODEX_CARGO_LOCK_SHA" \
      --arg native_lock_sha "$HEPTA_LEGACY_H_NATIVE_CARGO_LOCK_SHA" \
      --arg dependency_contract_sha "$HEPTA_LEGACY_H_DEPENDENCY_CONTRACT_SHA" '
        (.gates[] | select(.id == "native-ingress-composition") | .self_test_receipt.negative_fixtures) = 13
        | (.gates[] | select(.id == "dependency-security") | .receipt.contract_sha256) = $dependency_contract_sha
        | (.gates[] | select(.id == "dependency-security") | .receipt.graphs[0].cargo_lock_sha256) = $codex_lock_sha
        | (.gates[] | select(.id == "dependency-security") | .receipt.graphs[1].cargo_lock_sha256) = $native_lock_sha
        | (.gates[] | select(.id == "gate-compat-debt") | .receipt) = {
            schema:"hepta_gate_compat_debt_receipt_v1",
            status:"ready",
            pair_count:1282,
            captured_shell_pair_count:1239,
            legacy_workgraph_pair_count:8,
            declarative_pair_count:35,
