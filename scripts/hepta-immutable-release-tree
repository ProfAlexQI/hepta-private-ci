    and .service_restarted == false and .launchd_mutated == false and .plist_mutated == false
  ' >/dev/null <<<"$rollback_receipt"
  if [[ "$(sha256_file "$tmp/active/hepta")" != "$fixture_sha" \
    || "$(readlink "$tmp/active/hepta")" != "$(dirname "$rollback_record")/bin/hepta" \
    || "$(readlink "$tmp/active/hepta.manifest")" != "$(dirname "$rollback_record")/manifest.json" ]]; then
    echo "durable rollback did not restore the prior release pair" >&2
    exit 1
  fi
  $tool verify --manifest "$tmp/active/hepta.manifest" >/dev/null
  cutover_receipt="$($tool cutover --manifest "$different_manifest" --active-link "$tmp/active/hepta" --expected-current-sha256 "$fixture_sha")"
  jq -e '.status == "ready" and .backup.created == false and .backup.verified == true' >/dev/null <<<"$cutover_receipt"
  rollback_receipt="$($tool rollback --receipt "$rollback_record" --expected-current-sha256 "$different_sha")"
  jq -e '.status == "ready" and .cas_verified == true' >/dev/null <<<"$rollback_receipt"
  if [[ "$(sha256_file "$tmp/active/hepta")" != "$fixture_sha" \
    || "$(readlink "$tmp/active/hepta.manifest")" != "$(dirname "$rollback_record")/manifest.json" ]]; then
    echo "reused rollback bundle did not support a repeated cutover and rollback" >&2
    exit 1
  fi
  for failure_point in after_active_swap after_manifest_swap; do
    rollback_active="$tmp/rollback-active-$failure_point"
    mkdir -p "$rollback_active"
    cp "$artifact" "$rollback_active/hepta"
    chmod 0755 "$rollback_active/hepta"
    $tool activate --manifest "$bound_manifest" --active-link "$rollback_active/hepta" --expected-current-sha256 "$fixture_sha" >/dev/null
    failure_log="$tmp/$failure_point.stderr"
    rollback_rc=0
    HEPTA_IMMUTABLE_RELEASE_CUTOVER_TEST_FAILURE_POINT="$failure_point" \
      $tool cutover --manifest "$different_manifest" --active-link "$rollback_active/hepta" --expected-current-sha256 "$fixture_sha" >/dev/null 2>"$failure_log" || rollback_rc=$?
    if [[ "$rollback_rc" != "1" ]]; then
      echo "injected $failure_point cutover did not fail" >&2
      exit 1
    fi
    failure_receipt="$(tail -n 1 "$failure_log")"
    jq -e '.status == "rolled_back" and .operation == "cutover" and .rollback.performed == true and .rollback.restored == true' >/dev/null <<<"$failure_receipt"
    if [[ "$(sha256_file "$rollback_active/hepta")" != "$fixture_sha" \
      || "$(readlink "$rollback_active/hepta")" != "$(dirname "$bound_manifest")/bin/hepta" \
      || "$(readlink "$rollback_active/hepta.manifest")" != "$bound_manifest" \
      || "$(sha256_file "$rollback_active/backups/hepta.pre-cutover-$fixture_sha-to-$different_sha/bin/hepta")" != "$fixture_sha" \
      || ! -f "$rollback_active/backups/hepta.pre-cutover-$fixture_sha-to-$different_sha/rollback.json" \
      || -e "$rollback_active/.hepta-immutable-release-cutover.lock" ]]; then
      echo "injected $failure_point cutover did not restore and preserve the reviewed release pair" >&2
      exit 1
    fi
    if find "$rollback_active/backups" -maxdepth 1 -type d -name '.hepta-pre-cutover.*' | rg -q .; then
      echo "injected $failure_point cutover leaked its backup staging directory" >&2
      exit 1
    fi
  done
  jq -n --arg status ready --arg schema_version "$SCHEMA_VERSION" --arg source_commit "$source_commit" --arg artifact_sha256 "$fixture_sha" \
    '{status:$status,schema_version:$schema_version,source_commit:$source_commit,artifact_sha256:$artifact_sha256,real_short_banner_full_source_truth_ready:true,conflicting_resume_banner_denied:true,conflicting_full_source_truth_denied:true,missing_full_source_truth_denied:true,missing_preflight_denied:true,canonical_cargo_target_artifact_selected:true,artifact_override_denied:true,bound_gate_receipts_required_during_materialize:true,bound_gate_receipts_required_during_verify:true,bound_gate_source_and_lock_bound:true,legacy_h_bound_gate_profile_valid:true,mixed_bound_gate_profiles_denied:true,duplicate_missing_and_unknown_gate_ids_denied:true,blocked_receipt_and_self_test_denied:true,dependency_nonzero_findings_and_exceptions_denied:true,raw_configured_zero_new_exception_missing_modified_and_reordered_findings_denied:true,wrong_receipt_schema_hash_and_lock_denied:true,manifest_gate_receipt_tamper_denied:true,immutable_watchdog_closure_bound:true,immutable_watchdog_tamper_denied:true,immutable_watchdog_plist_release_path_bound:true,dirty_source_watchdog_ignored_after_materialization:true,existing_release_evidence_drift_denied:true,same_source_artifact_different_evidence_gets_distinct_identity:true,legacy_unbound_archival_fixture_valid:true,legacy_unbound_activation_denied:true,preflight_candidate_artifact_drift_denied:true,byte_preserving_activation_ready:true,different_bytes_activation_denied:true,stale_cutover_cas_denied:true,identical_bytes_cutover_denied:true,legacy_to_bound_byte_changing_cutover_ready:true,cutover_backup_verified:true,manifest_link_cutover_verified:true,durable_post_cutover_rollback_verified:true,rollback_bundle_reuse_verified:true,after_active_swap_rollback_verified:true,after_manifest_swap_rollback_verified:true,crash_consistent_pair:false,link_pair_consistency_verified_before_restart:true,runtime_deployment_consistency_required_after_restart:true,service_restarted:false,active_process_mutated:false,launchd_mutated:false,plist_mutated:false}'
  echo "hepta immutable release tree self-test passed"
}
[[ $# -gt 0 ]] || usage
command_name="$1"
shift
case "$command_name" in
  materialize) materialize "$@" ;;
  verify) verify_manifest "$@" ;;
  activate) activate "$@" ;;
  cutover) cutover "$@" ;;
  rollback) rollback_release "$@" ;;
  self-test) self_test "$@" ;;
  *) usage ;;
esac
