  chmod 0555 "$(dirname "$tampered_manifest")"
  if $tool verify --manifest "$tampered_manifest" >/dev/null 2>&1; then
    echo "immutable release verification accepted a tampered bound gate receipt" >&2
    exit 1
  fi
  tampered_release_dir="$tmp/tampered-existing-evidence"
  tampered_manifest="$(
    $tool materialize \
