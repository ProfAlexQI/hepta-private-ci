  self_test_expect_materialize_denied \
    "nonexistent source commit" \
    "$tool" "$artifact" "$(printf '1%.0s' {1..40})" "$mutated_provenance" \
    "$tmp/negative-nonexistent-source"
  tampered_release_dir="$tmp/tampered-receipt-release"
  tampered_manifest="$(
    $tool materialize \
      --artifact "$artifact" \
      --source-commit "$source_commit" \
      --preflight-log "$preflight" \
      --release-root "$tampered_release_dir"
