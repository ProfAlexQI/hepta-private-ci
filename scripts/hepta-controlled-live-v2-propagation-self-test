#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
TYPED_REPORT="$ROOT/scripts/hepta-typed-compat-report"
PAIR_RUNNER="$ROOT/scripts/hepta-gate-pair-runner"
LEDGER="$ROOT/scripts/hepta-controlled-live-v2-propagation-ledger.json"
IMPACT="$ROOT/scripts/hepta-controlled-live-worktree-boundary-v2-impact.json"
SPEC_FILE="$ROOT/scripts/hepta-gate-pair-specs-v1.json"

DYNAMIC_IDS=(
  hepta-systems-controlled-live-readiness-audit
  hepta-systems-controlled-live-readiness-denial-readback-index
  hepta-systems-controlled-live-operator-packet-preview
  hepta-systems-controlled-live-operator-packet-non-send-readback
  hepta-systems-controlled-live-required-evidence-collection-plan
  hepta-systems-controlled-live-required-evidence-readback-index
)

fail() {
  printf 'hepta-controlled-live-v2-propagation-self-test: FAIL: %s\n' "$1" >&2
  exit 1
}

for executable in "$TYPED_REPORT" "$PAIR_RUNNER"; do
  [[ -x "$executable" ]] || fail "missing executable: $executable"
done
for source in "$LEDGER" "$IMPACT" "$SPEC_FILE"; do
  [[ -f "$source" ]] || fail "missing contract: $source"
done
command -v git >/dev/null 2>&1 || fail "git is required"
command -v jq >/dev/null 2>&1 || fail "jq is required"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
fixture_root="$tmpdir/repo"
mkdir -p "$fixture_root"
git -C "$fixture_root" init -q

render_chain() {
  local label="$1"
  local report_id
  for report_id in "${DYNAMIC_IDS[@]}"; do
    HEPTA_REPO_ROOT="$fixture_root" "$TYPED_REPORT" "$report_id" \
      >"$tmpdir/$label-${report_id#hepta-systems-controlled-live-}.json"
  done
}

assert_chain() {
  local label="$1"
  local boundary_state="$2"
  local dirty_tracked="$3"
  local active_count="$4"
  local satisfied_count="$5"
  local dirty_slot_state="$6"
  local dirty_slot_active="$7"
  local report_file

  for report_file in "$tmpdir/$label-"*.json; do
    jq -e '
      .runtime == "hepta"
      and .product == "Hepta"
      and .status == "ready_blocked"
      and .production_authority_granted == false
      and .write_authority_granted == false
      and .controlled_live_cutover_ready == false
      and (.side_effects | to_entries | all(.value == false))
    ' "$report_file" >/dev/null
  done

  jq -e \
    --arg boundary_state "$boundary_state" \
    --argjson dirty_tracked "$dirty_tracked" \
    --argjson active_count "$active_count" \
    --argjson satisfied_count "$satisfied_count" \
    --arg dirty_slot_state "$dirty_slot_state" \
    --argjson dirty_slot_active "$dirty_slot_active" \
    '
      .source_worktree_boundary_state == $boundary_state
      and .source_dirty_worktree_boundary_tracked == $dirty_tracked
      and .source_blocker_count == $active_count
      and .stable_blocker_slot_count == 7
      and .active_blocker_count == $active_count
      and .satisfied_entry_count == $satisfied_count
      and .required_evidence_count == $active_count
      and .operator_packet_preview_ready == true
      and .live_execution_allowed == false
      and any(.blocker_readbacks[];
        .source_blocker_id == "dirty_worktree_boundary"
        and .current_state == $dirty_slot_state
        and .active_blocker == $dirty_slot_active
        and .evidence_required == $dirty_slot_active
        and .blocks_cutover == $dirty_slot_active)
    ' "$tmpdir/$label-operator-packet-preview.json" >/dev/null

  jq -e \
    --arg boundary_state "$boundary_state" \
    --argjson active_count "$active_count" \
    --argjson satisfied_count "$satisfied_count" \
    '
      .source_worktree_boundary_state == $boundary_state
      and .source_blocker_count == $active_count
      and .source_active_blocker_count == $active_count
      and .source_satisfied_entry_count == $satisfied_count
      and .stable_blocker_slot_count == 7
      and .non_send_readback_ready == true
      and .packet_send_attempted == false
      and .packet_persisted == false
      and .live_execution_allowed == false
    ' "$tmpdir/$label-operator-packet-non-send-readback.json" >/dev/null

  jq -e \
    --arg boundary_state "$boundary_state" \
    --argjson active_count "$active_count" \
    --argjson satisfied_count "$satisfied_count" \
    --arg dirty_slot_state "$dirty_slot_state" \
    --argjson dirty_slot_active "$dirty_slot_active" \
    '
      .source_worktree_boundary_state == $boundary_state
      and .source_blocker_count == $active_count
      and .stable_blocker_slot_count == 7
      and .active_blocker_count == $active_count
      and .required_evidence_count == $active_count
      and .satisfied_entry_count == $satisfied_count
      and .evidence_collection_plan_ready == true
      and .evidence_recorded_count == 0
      and .approval_accepted == false
      and .live_execution_allowed == false
      and any(.entries[];
        .source_blocker_id == "dirty_worktree_boundary"
        and .current_state == $dirty_slot_state
        and .active_blocker == $dirty_slot_active
        and .evidence_required == $dirty_slot_active
        and .blocks_cutover == $dirty_slot_active)
    ' "$tmpdir/$label-required-evidence-collection-plan.json" >/dev/null

  jq -e \
    --arg boundary_state "$boundary_state" \
    --argjson active_count "$active_count" \
    --argjson satisfied_count "$satisfied_count" \
    --arg dirty_slot_state "$dirty_slot_state" \
    --argjson dirty_slot_active "$dirty_slot_active" \
    '
      .source_worktree_boundary_state == $boundary_state
      and .source_blocker_count == $active_count
      and .stable_blocker_slot_count == 7
      and .active_blocker_count == $active_count
      and .missing_evidence_count == $active_count
      and .satisfied_entry_count == $satisfied_count
      and .readback_index_ready == true
      and .evidence_recorded_count == 0
      and .approval_accepted == false
      and .live_execution_allowed == false
      and any(.entries[];
        .source_blocker_id == "dirty_worktree_boundary"
        and .evidence_state == $dirty_slot_state
        and .active_blocker == $dirty_slot_active
        and .evidence_required == $dirty_slot_active
        and .blocks_cutover == $dirty_slot_active)
    ' "$tmpdir/$label-required-evidence-readback-index.json" >/dev/null
}

render_chain clean
assert_chain clean clean false 6 1 satisfied false
touch "$fixture_root/synthetic-dirty-boundary"
render_chain dirty
assert_chain dirty dirty true 7 0 missing true

jq -e '
  .typed_pair_count == 17
  and .dynamic_worktree_pair_count == 6
  and .stable_blocker_slot_count == 7
  and .clean_active_blocker_count == 6
  and .dirty_active_blocker_count == 7
  and (.static_conservative_gap_and_boundary_pairs | length) == 9
  and .state_contract.controlled_live_cutover_ready == false
  and .state_contract.live_execution_allowed == false
  and .legacy_payloads_preserved_in_place == false
  and .retired_shell_body_count == 46
  and .service_or_external_mutation_allowed == false
' "$LEDGER" >/dev/null
jq -e '
  .typed_pair_count == 17
  and .dynamic_worktree_pair_count == 6
  and .retired_pair_payload_count == 34
  and .retired_supplemental_payload_count == 12
  and .retired_shell_body_count == 46
  and .legacy_payloads_preserved_in_place == false
  and .service_or_external_mutation_allowed == false
' "$IMPACT" >/dev/null

jq -e '
  ([.pairs[] | select(.id | startswith("hepta-systems-controlled")) | select(.template == "typed_rust_report_v1")] | length) == 17
  and ([.supplemental_payloads[] | select(.path | test("hepta-systems-controlled-live-(operator-packet-(preview|non-send-readback)|readiness-(audit|denial-readback-index)|required-evidence-(collection-plan|readback-index))\\.(gate|report)$"))] | length) == 0
' "$SPEC_FILE" >/dev/null

for report_id in "${DYNAMIC_IDS[@]}"; do
  HEPTA_REPO_ROOT="$fixture_root" "$TYPED_REPORT" "$report_id" | jq -S . \
    >"$tmpdir/direct-${report_id#hepta-systems-controlled-live-}.json"
  HEPTA_REPO_ROOT="$fixture_root" "$PAIR_RUNNER" report "$report_id" | jq -S . \
    >"$tmpdir/pair-${report_id#hepta-systems-controlled-live-}.json"
  cmp "$tmpdir/direct-${report_id#hepta-systems-controlled-live-}.json" \
    "$tmpdir/pair-${report_id#hepta-systems-controlled-live-}.json" \
    || fail "typed pair parity mismatch: $report_id"
done

jq -n '{
  status:"ready",
  schema_version:"hepta_controlled_live_v2_typed_propagation_self_test_v1",
  typed_pair_count:17,
  dynamic_worktree_pair_count:6,
  static_conservative_gap_and_boundary_pair_count:9,
  stable_blocker_slot_count:7,
  clean_active_blocker_count:6,
  dirty_active_blocker_count:7,
  pair_report_parity:true,
  source_drift_negative_tests:"rust_focused",
  legacy_payload_blobs_preserved:false,
  retired_shell_body_count:46,
  controlled_live_cutover_ready:false,
  live_execution_allowed:false,
  external_side_effects_performed:false
}'
