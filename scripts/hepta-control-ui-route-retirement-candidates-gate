#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "open3"
require "pathname"
require "set"

ROOT = Pathname.new(
  ENV.fetch("HEPTA_CONTROL_UI_ROUTE_RETIREMENT_REPO_ROOT", Pathname.new(__dir__).join("..").expand_path.to_s),
).expand_path
CATALOG = Pathname.new(
  ENV.fetch(
    "HEPTA_CONTROL_UI_ROUTE_RETIREMENT_CATALOG",
    ROOT.join("codex-rs/hepta-native-gateway/routes/control_ui_route_catalog_v1.jsonl").to_s,
  ),
).expand_path
MANIFEST = Pathname.new(
  ENV.fetch(
    "HEPTA_CONTROL_UI_ROUTE_RETIREMENT_MANIFEST",
    ROOT.join("codex-rs/hepta-native-gateway/routes/control_ui_route_retirement_candidates_v1.json").to_s,
  ),
).expand_path
SEPARATION = Pathname.new(
  ENV.fetch(
    "HEPTA_CONTROL_UI_HTTP_EVIDENCE_SEPARATION_CONTRACT",
    ROOT.join("codex-rs/hepta-native-gateway/routes/control_ui_http_evidence_registry_separation_v1.json").to_s,
  ),
).expand_path
EVIDENCE_SOURCE = ROOT.join(
  "codex-rs/hepta-native-gateway/routes/control_ui_evidence_definition_registry_v1.jsonl",
)
TELEMETRY_TRUST = ROOT.join(
  "codex-rs/hepta-native-gateway/routes/control_ui_legacy_route_telemetry_trust_v1.json",
)
RUST_MANIFEST = ROOT.join("codex-rs/Cargo.toml")
RUST_TOOLCHAIN_MANIFEST = ROOT.join("codex-rs/rust-toolchain.toml")
WINDOW_SUMMARY = ENV["HEPTA_CONTROL_UI_ROUTE_RETIREMENT_WINDOW_SUMMARY"]
WINDOW_EVENTS = ENV["HEPTA_CONTROL_UI_ROUTE_RETIREMENT_WINDOW_EVENTS"]
EVIDENCE_REGISTRY = ROOT.join(
  "codex-rs/hepta-native-gateway/src/native_gateway/generated_evidence_registry.rs",
)
EVIDENCE_API = ROOT.join("codex-rs/hepta-native-gateway/src/native_gateway/evidence_api.rs")
EVIDENCE_DISPATCH = ROOT.join("codex-rs/hepta-native-gateway/src/native_gateway/evidence_dispatch.rs")
NATIVE_REPORT_REGISTRY = ROOT.join(
  "codex-rs/hepta-native-gateway/src/native_gateway/native_report_registry.rs",
)

GENERATED_PATHS = %w[
  codex-rs/hepta-native-gateway/src/route_registry/generated_control_ui_routes.rs
  codex-rs/hepta-native-gateway/src/route_registry/native_report_bindings.rs
  codex-rs/hepta-native-gateway/src/runtime_ingress/generated_control_ui_routes.rs
  codex-rs/hepta-native-gateway/src/route_definition/generated_control_ui_routes.rs
  codex-rs/hepta-native-gateway/src/native_gateway/generated_evidence_registry.rs
].freeze
ROUTE_CONSTANT_SOURCE = "codex-rs/hepta-native-gateway/src/route_registry.rs"
NON_SOURCE_PREFIXES = %w[
  artifacts/
].freeze

def fail!(message)
  warn "hepta-control-ui-route-retirement-candidates-gate: #{message}"
  exit 1
end

def read_json(path, label)
  JSON.parse(path.binread)
rescue Errno::ENOENT
  fail!("missing #{label}: #{path}")
rescue JSON::ParserError => error
  fail!("invalid #{label}: #{error.message}")
end

def read_jsonl(path)
  path.each_line.each_with_object([]) do |line, records|
    stripped = line.strip
    next if stripped.empty?

    records << JSON.parse(stripped)
  rescue JSON::ParserError => error
    fail!("invalid route catalog JSONL: #{error.message}")
  end
rescue Errno::ENOENT
  fail!("missing route catalog: #{path}")
end

def tracked_source_paths
  stdout, stderr, status = Open3.capture3(
    "git", "-C", ROOT.to_s, "ls-files", "--cached", "--others", "--exclude-standard", "-z",
  )
  fail!("unable to enumerate repository sources: #{stderr.strip}") unless status.success?
  stdout.split("\0").reject(&:empty?)
end

def source_contains?(relative_path, marker)
  path = ROOT.join(relative_path)
  fail!("consumer evidence file is missing: #{relative_path}") unless path.file?
  path.binread.include?(marker)
end

def exact_path_consumers(route_path)
  exclusions = Set.new(
    GENERATED_PATHS + [
      CATALOG.relative_path_from(ROOT).to_s,
      MANIFEST.relative_path_from(ROOT).to_s,
      ROUTE_CONSTANT_SOURCE,
    ],
  )
  tracked_source_paths.each_with_object([]) do |relative_path, consumers|
    next if exclusions.include?(relative_path)
    next if relative_path.start_with?("scripts/archive/")
    next if NON_SOURCE_PREFIXES.any? { |prefix| relative_path.start_with?(prefix) }

    path = ROOT.join(relative_path)
    next unless path.file? && path.size <= 5_000_000

    source = path.binread
    next if source.include?("\0")
    consumers << relative_path if source.include?(route_path)
  end.sort
end

def consumer_scope(path)
  case path
  when %r{\Aapps/hepta-control-ui/} then "control_ui"
  when %r{\Aapps/hepta-native/} then "native_ui"
  when %r{\A\.github/} then "ci"
  when %r{\Adocs/} then "docs"
  when %r{\Ascripts/} then "scripts"
  else "other"
  end
end

def trusted_window_replay(event_path, expected_head)
  toolchain = RUST_TOOLCHAIN_MANIFEST.binread[/^channel = "([^"]+)"$/, 1]
  fail!("pinned Rust toolchain is missing") if toolchain.nil? || toolchain.empty?
  rustc, rustc_stderr, rustc_status = Open3.capture3(
    "rustup", "which", "--toolchain", toolchain, "rustc",
  )
  fail!("resolve pinned rustc failed: #{rustc_stderr.strip}") unless rustc_status.success?
  rustdoc, rustdoc_stderr, rustdoc_status = Open3.capture3(
    "rustup", "which", "--toolchain", toolchain, "rustdoc",
  )
  fail!("resolve pinned rustdoc failed: #{rustdoc_stderr.strip}") unless rustdoc_status.success?
  toolchain_bin = Pathname.new(rustc.strip).dirname.to_s
  environment = {
    "RUSTUP_TOOLCHAIN" => toolchain,
    "RUSTC" => rustc.strip,
    "RUSTDOC" => rustdoc.strip,
    "PATH" => "#{toolchain_bin}:#{ENV.fetch('PATH', '')}",
  }
  stdout, stderr, status = Open3.capture3(
    environment,
    "rustup", "run", toolchain, "cargo", "run", "--offline", "--quiet",
    "--manifest-path", RUST_MANIFEST.to_s,
    "-p", "hepta-native-gateway", "--bin", "hepta-legacy-route-window", "--",
    "--events", event_path.to_s, "--expected-head", expected_head, "--allow-blocked",
    chdir: ROOT.to_s,
  )
  fail!("trusted legacy-window replay failed: #{stderr.strip}") unless status.success?
  JSON.parse(stdout)
rescue JSON::ParserError => error
  fail!("trusted legacy-window replay returned invalid JSON: #{error.message}")
end

output_path = nil
until ARGV.empty?
  argument = ARGV.shift
  case argument
  when "--output"
    output_path = ARGV.shift
    fail!("--output requires a path") if output_path.nil? || output_path.empty?
  when "--help"
    puts "Usage: scripts/hepta-control-ui-route-retirement-candidates-gate [--output PATH]"
    exit 0
  else
    fail!("unknown argument: #{argument}")
  end
end

records = read_jsonl(CATALOG)
evidence_source_records = read_jsonl(EVIDENCE_SOURCE)
manifest = read_json(MANIFEST, "retirement candidate manifest")
separation = read_json(SEPARATION, "HTTP/evidence separation contract")
telemetry_trust = read_json(TELEMETRY_TRUST, "legacy route telemetry trust contract")
fail!("retirement candidate schema drifted") unless
  manifest["schema"] == "hepta_control_ui_route_retirement_candidates_v1"
fail!("HTTP/evidence separation contract drifted") unless
  separation["schema"] == "hepta_control_ui_http_evidence_registry_separation_v1" &&
    separation["status"] == "ready" &&
    separation["http_registry_independent"] == true &&
    separation["evidence_registry_independent"] == true &&
    separation["independent_typed_sources"] == true &&
    separation["shared_typed_catalog_source"] == false &&
    separation["stable_evidence_id_preserved"] == true &&
    separation["stable_route_selector_preserved"] == true &&
    separation["stable_renderer_key_preserved"] == true &&
    separation.dig("proof", "typed_evidence_source") == EVIDENCE_SOURCE.relative_path_from(ROOT).to_s &&
    separation.dig("proof", "typed_http_source") == CATALOG.relative_path_from(ROOT).to_s &&
    separation["blockers"] == [] &&
    separation.dig("decision", "separation_precondition_satisfied") == true &&
    separation.dig("decision", "route_retirement_allowed") == false
fail!("legacy route telemetry trust contract drifted") unless
  telemetry_trust["schema"] == "hepta_control_ui_legacy_route_telemetry_trust_v1" &&
    telemetry_trust["status"] == "blocked" &&
    telemetry_trust["trusted_replay_required"] == true &&
    telemetry_trust["environment_run_class_has_promotion_authority"] == false &&
    telemetry_trust["trusted_launcher_identity_configured"] == false &&
    telemetry_trust["deployment_identity_configured"] == false &&
    telemetry_trust["event_authentication_plumbing_ready"] == true &&
    telemetry_trust["event_signature_or_mac_configured"] == false &&
    telemetry_trust["event_epoch_binding_configured"] == false &&
    telemetry_trust["promotion_trust_root_configured"] == false &&
    telemetry_trust["exact_source_epoch_rotation_ready"] == true &&
    telemetry_trust["crashed_segment_quarantine_ready"] == true &&
    telemetry_trust["telemetry_parent_directory_fsync_verified"] == true &&
    telemetry_trust["local_development_may_mint_trust"] == false &&
    telemetry_trust.dig("decision", "promotion_authoritative") == false &&
    telemetry_trust.dig("decision", "route_retirement_allowed") == false &&
    telemetry_trust.dig("decision", "blockers").is_a?(Array) &&
    !telemetry_trust.dig("decision", "blockers").empty?

routes = records.select { |record| record["kind"] == "control_ui_route" }
evidence_source_metadata = evidence_source_records.first
evidence_definitions = evidence_source_records.select do |record|
  record["kind"] == "evidence_definition"
end
fail!("independent evidence source schema or count drifted") unless
  evidence_source_metadata["schema"] == "hepta_control_ui_evidence_definition_registry_v1" &&
    evidence_source_metadata["evidence_definition_count"] == evidence_definitions.length &&
    evidence_source_metadata["renderable_evidence_definition_count"] ==
      evidence_definitions.count { |definition| !definition["renderer_key"].nil? }
special = records.select { |record| record["kind"] == "special_native_report" }
renderers = records.select { |record| record["kind"] == "renderer" }
legacy_routes = routes.select { |route| route["legacy_compatibility_route"] == true }
canonical_routes = routes.select { |route| route["legacy_compatibility_route"] == false }
legacy_get_routes = legacy_routes.select { |route| route["method"] == "GET" }
quarantined_routes = routes.select do |route|
  route["permission_profile"] == "control_ui_quarantined_legacy_mutation"
end

metrics = {
  "route_count" => routes.length,
  "legacy_compatibility_route_count" => legacy_routes.length,
  "canonical_route_count" => canonical_routes.length,
  "quarantined_legacy_mutation_route_count" => quarantined_routes.length,
}
fail!("catalog metrics drifted from candidate manifest") unless
  metrics == manifest.fetch("expected_catalog_metrics")
fail!("separation contract metrics drifted") unless
  separation.values_at(
    "catalog_route_count", "legacy_http_route_count", "evidence_definition_count",
  ) == [
    metrics.fetch("route_count"), metrics.fetch("legacy_compatibility_route_count"),
    evidence_definitions.length,
  ]

evidence_registry_source = EVIDENCE_REGISTRY.binread
evidence_api_source = EVIDENCE_API.binread
evidence_dispatch_source = EVIDENCE_DISPATCH.binread
native_report_registry_source = NATIVE_REPORT_REGISTRY.binread
evidence_renderer = native_report_registry_source[/pub\(super\) fn render_registered_evidence_report\(.*?\n\}/m]
fail!("generated EvidenceDefinition registry count drifted") unless
  evidence_registry_source.scan(/^\s+EvidenceDefinition \{/).length == evidence_definitions.length
fail!("evidence API still depends on the HTTP route-definition registry") if
  evidence_api_source.include?("route_definition_registry")
fail!("evidence dispatch still re-enters HTTP path routing") if
  evidence_dispatch_source.include?("route_native_gateway_request_after_preflight")
fail!("independent renderer-key dispatch is missing or still path-bound") if
  evidence_renderer.nil? || evidence_renderer.include?("route_registry::")
fail!("separation proof counters drifted") unless
  separation.dig("proof", "route_definition_registry_runtime_dependency_count") == 0 &&
    separation.dig("proof", "http_path_to_report_binding_runtime_dependency_count") == 0

current_full_head, full_head_stderr, full_head_status = Open3.capture3(
  "git", "-C", ROOT.to_s, "rev-parse", "HEAD",
)
fail!("unable to resolve exact full source HEAD: #{full_head_stderr.strip}") unless
  full_head_status.success?
compiled_head, compiled_head_stderr, compiled_head_status = Open3.capture3(
  "git", "-C", ROOT.to_s, "rev-parse", "--short=12", "HEAD",
)
fail!("unable to resolve compiled source HEAD: #{compiled_head_stderr.strip}") unless
  compiled_head_status.success?
current_full_head = current_full_head.strip
compiled_head = compiled_head.strip
fail!("compiled source HEAD does not prefix the full HEAD") unless
  compiled_head.length == 12 && current_full_head.start_with?(compiled_head)

trust_blockers = telemetry_trust.dig("decision", "blockers")
window = if WINDOW_SUMMARY.nil? || WINDOW_SUMMARY.empty?
  {
    "configured" => false,
    "trusted_replay_match" => false,
    "producer_eligible" => false,
    "eligible" => false,
    "event_file_rehashed_by_gate" => false,
    "source_full_head" => current_full_head,
    "compiled_source_head" => compiled_head,
    "event_source_resolution_verified" => false,
    "promotion_authoritative" => false,
    "blockers" => (["runtime_window_summary_missing"] + trust_blockers).uniq,
  }
else
  summary_path = Pathname.new(WINDOW_SUMMARY).expand_path
  summary = read_json(summary_path, "legacy HTTP observation window")
  fail!("legacy HTTP event file is required with a window summary") if
    WINDOW_EVENTS.nil? || WINDOW_EVENTS.empty?
  event_path = Pathname.new(WINDOW_EVENTS).expand_path
  fail!("legacy HTTP event file is missing: #{event_path}") unless event_path.file?
  event_file_sha256 = Digest::SHA256.file(event_path).hexdigest
  eligible = summary.dig("decision", "eligible")
  blockers = summary.dig("decision", "blockers")
  fail!("legacy HTTP observation window schema or source binding drifted") unless
    summary["schema"] == "hepta_control_ui_legacy_http_window_v3" &&
      summary["producer"] == "hepta-native-gateway/hepta-legacy-route-window" &&
      summary["promotion_authoritative"] == false &&
      summary["event_hash_chain_verified"] == true &&
      summary["source_epoch_sha256"].is_a?(String) &&
      summary["source_epoch_sha256"].match?(/\A[0-9a-f]{64}\z/) &&
      summary["last_event_body_sha256"].is_a?(String) &&
      summary["last_event_body_sha256"].match?(/\A[0-9a-f]{64}\z/) &&
      [true, false].include?(summary["event_authentication_verified"]) &&
      [true, false].include?(summary["process_stop_marker_observed"]) &&
      summary["durable_process_stop_observed"] == false &&
      [true, false].include?(summary["continuous_coverage_declared"]) &&
      summary["shutdown_flush_verified"] == false &&
      summary["event_file_sha256"].is_a?(String) &&
      summary["event_file_sha256"].match?(/\A[0-9a-f]{64}\z/) &&
      summary["event_file_sha256"] == event_file_sha256 &&
      summary["source_head_sha"] == compiled_head &&
      summary["source_epoch_sha256"] == Digest::SHA256.hexdigest(
        "hepta.control-ui.legacy-http.source-epoch.v1\0#{compiled_head}\0#{Digest::SHA256.file(CATALOG).hexdigest}\0hepta_control_ui_legacy_http_event_v3"
      ) &&
      summary["route_catalog_sha256"] == Digest::SHA256.file(CATALOG).hexdigest &&
      (eligible.instance_of?(TrueClass) || eligible.instance_of?(FalseClass))
  trusted_summary = trusted_window_replay(event_path, compiled_head)
  fail!("legacy HTTP observation window differs from exact-source trusted replay") unless
    trusted_summary == summary
  resolved_event_head, resolve_stderr, resolve_status = Open3.capture3(
    "git", "-C", ROOT.to_s, "rev-parse", "#{summary.fetch('source_head_sha')}^{commit}",
  )
  fail!("compiled event HEAD does not resolve uniquely: #{resolve_stderr.strip}") unless
    resolve_status.success? && resolved_event_head.strip == current_full_head
  numeric_fields = %w[
    event_count process_segment_count operator_active_day_count window_start_unix_ms
    window_end_unix_ms window_span_days trailing_zero_use_days total_legacy_requests
    non_ci_legacy_requests
  ]
  fail!("legacy HTTP observation window metrics are missing or inconsistent") unless
    numeric_fields.all? { |field| summary[field].is_a?(Integer) && summary[field] >= 0 } &&
      summary["event_count"] > 0 && summary["process_segment_count"] > 0 &&
      summary["window_end_unix_ms"] >= summary["window_start_unix_ms"] &&
      (summary["window_end_unix_ms"] - summary["window_start_unix_ms"]) / 86_400_000 ==
        summary["window_span_days"] &&
      summary["trailing_zero_use_days"] <= summary["window_span_days"] &&
      summary["total_legacy_requests"] >= summary["non_ci_legacy_requests"] &&
      summary["routes"].is_a?(Hash)
  fail!("legacy HTTP observation window decision is internally inconsistent") unless
    blockers.is_a?(Array) && blockers.all? { |blocker| blocker.is_a?(String) && !blocker.empty? } &&
      !eligible && summary["status"] == "blocked" && !blockers.empty? &&
      blockers.include?("independent_shutdown_durability_receipt_missing")
  {
    "configured" => true,
    "summary_sha256" => Digest::SHA256.file(summary_path).hexdigest,
    "event_file_sha256" => event_file_sha256,
    "event_file_rehashed_by_gate" => true,
    "source_full_head" => current_full_head,
    "compiled_source_head" => compiled_head,
    "event_source_resolution_verified" => true,
    "trusted_replay_match" => true,
    "producer_eligible" => eligible,
    "promotion_authoritative" => false,
    "eligible" => false,
    "blockers" => (blockers + trust_blockers).uniq,
  }
end

report_id_binding_counts = Hash.new(0)
routes.each do |route|
  report_id_binding_counts[route["native_report_id"]] += 1 unless route["native_report_id"].nil?
end
special.each { |route| report_id_binding_counts[route.fetch("report_id")] += 1 }
renderer_by_id = renderers.to_h { |renderer| [renderer.fetch("id"), renderer] }

legacy_get_with_native_report = legacy_get_routes.count { |route| !route["native_report_id"].nil? }
legacy_get_with_unique_native_report = legacy_get_routes.count do |route|
  report_id = route["native_report_id"]
  !report_id.nil? && report_id_binding_counts[report_id] == 1
end
legacy_get_with_active_renderer = legacy_get_routes.count do |route|
  renderer_by_id.fetch(route["native_report_id"], {})["status"] == "active"
end
legacy_evidence_definitions = evidence_definitions.select do |definition|
  definition["legacy_compatibility_route"] == true
end
legacy_evidence_with_active_renderer = legacy_evidence_definitions.count do |definition|
  renderer = renderers.find { |candidate| candidate["key"] == definition["renderer_key"] }
  renderer && renderer["status"] == "active"
end
fail!("separation evidence/renderer counts drifted") unless
  separation.values_at(
    "canonical_evidence_selector_count", "active_legacy_renderer_count",
  ) == [legacy_evidence_definitions.length, legacy_evidence_with_active_renderer]
structurally_unbound_legacy_get = legacy_get_routes.count do |route|
  route["native_report_id"].nil? && route.fetch("aliases").empty? && !route.fetch("watchdog_probe")
end

candidate_receipts = manifest.fetch("candidates").map do |candidate|
  key = candidate.fetch("key")
  matches = routes.select { |route| route["key"] == key }
  fail!("candidate #{key} does not resolve exactly once") unless matches.length == 1
  route = matches.first
  fail!("candidate #{key} is not a legacy GET route") unless
    route["method"] == "GET" && route["legacy_compatibility_route"] == true
  fail!("candidate #{key} is canonical, aliased, watchdog-bound, or mutation-quarantined") unless
    route["dispatch_handler"] == "RetiredCompatibility" &&
      route.fetch("aliases").empty? &&
      route["watchdog_probe"] == false &&
      route["permission_profile"] == "control_ui_metadata_read"
  fail!("candidate #{key} native report id drifted") unless
    route["native_report_id"] == candidate.fetch("native_report_id")
  fail!("candidate #{key} was marked eligible despite unresolved consumers") unless
    candidate["eligible_for_retirement"] == false

  report_id = route.fetch("native_report_id")
  fail!("candidate #{key} native report binding is no longer unique; re-audit required") unless
    report_id_binding_counts[report_id] == 1
  fail!("candidate #{key} renderer is not active; re-audit required") unless
    renderer_by_id.fetch(report_id, {})["status"] == "active"

  blocker_receipts = candidate.fetch("blockers").map do |blocker|
    marker_present = source_contains?(blocker.fetch("file"), blocker.fetch("marker"))
    fail!("candidate #{key} blocker evidence disappeared: #{blocker.fetch('id')}") unless marker_present
    {
      "id" => blocker.fetch("id"),
      "file" => blocker.fetch("file"),
      "marker_present" => marker_present,
    }
  end
  blocker_ids = blocker_receipts.map { |blocker| blocker.fetch("id") }
  required_blockers = %w[
    active_native_report_renderer
    positive_http_contract_test
    downstream_native_report_chain
  ]
  fail!("candidate #{key} blocker classes drifted") unless blocker_ids.sort == required_blockers.sort

  consumers = exact_path_consumers(route.fetch("path"))
  consumer_counts = consumers.group_by { |path| consumer_scope(path) }
    .transform_values(&:length)
  direct_product_consumer_count = %w[control_ui native_ui ci docs scripts]
    .sum { |scope| consumer_counts.fetch(scope, 0) }
  fail!("candidate #{key} gained a direct product/CI/docs/script path consumer") unless
    direct_product_consumer_count.zero?

  {
    "key" => key,
    "method" => route.fetch("method"),
    "path" => route.fetch("path"),
    "native_report_id" => report_id,
    "dispatch_handler" => route.fetch("dispatch_handler"),
    "watchdog_probe" => route.fetch("watchdog_probe"),
    "aliases" => route.fetch("aliases"),
    "exact_path_external_consumers" => consumers,
    "exact_path_external_consumer_count" => consumers.length,
    "direct_product_surface_consumer_count" => direct_product_consumer_count,
    "native_report_binding_count" => report_id_binding_counts.fetch(report_id),
    "native_report_renderer_status" => renderer_by_id.fetch(report_id).fetch("status"),
    "blockers" => blocker_receipts,
    "eligible_for_retirement" => false,
  }
end

receipt = {
  "schema" => "hepta_control_ui_route_retirement_candidate_receipt_v1",
  "status" => "ready",
  "retirement_status" => "blocked",
  "catalog" => CATALOG.relative_path_from(ROOT).to_s,
  "catalog_sha256" => Digest::SHA256.file(CATALOG).hexdigest,
  "evidence_definition_registry" => EVIDENCE_SOURCE.relative_path_from(ROOT).to_s,
  "evidence_definition_registry_sha256" => Digest::SHA256.file(EVIDENCE_SOURCE).hexdigest,
  "manifest" => MANIFEST.relative_path_from(ROOT).to_s,
  "manifest_sha256" => Digest::SHA256.file(MANIFEST).hexdigest,
  "http_evidence_separation_contract" => SEPARATION.relative_path_from(ROOT).to_s,
  "http_evidence_separation_contract_sha256" => Digest::SHA256.file(SEPARATION).hexdigest,
  "registry_separation" => {
    "status" => separation.fetch("status"),
    "http_registry_independent" => separation.fetch("http_registry_independent"),
    "evidence_registry_independent" => separation.fetch("evidence_registry_independent"),
    "canonical_evidence_selector_count" => separation.fetch("canonical_evidence_selector_count"),
    "evidence_definition_count" => separation.fetch("evidence_definition_count"),
