#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"

parts = (1..4).map do |index|
  Pathname.new(__dir__).join("hepta-ui-v4-exact-head-qualification-index.part#{index}.rb")
end
missing = parts.reject(&:file?)
abort "qualification-index source parts missing: #{missing.join(', ')}" unless missing.empty?
source = parts.map(&:read).join
Kernel.eval(source, TOPLEVEL_BINDING, __FILE__, 1)
