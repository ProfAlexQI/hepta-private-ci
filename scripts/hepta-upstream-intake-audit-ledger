#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
MANIFEST="${HEPTA_UPSTREAM_AUDIT_MANIFEST:-$ROOT/docs/architecture/HEPTA_UPSTREAM_CODEX_CURRENT_INTAKE_2026-07-22_R3.json}"
MODE="${1:-report}"

usage() {
  echo "usage: scripts/hepta-upstream-intake-audit-ledger [report|verify|self-test]" >&2
  exit 2
}

report_v3() {
  local cutoff range_start commit_valid=true manifest_sha256
  cutoff="$(jq -er '.observation.cutoff_head' "$MANIFEST")"
  range_start="$(jq -er '.observation.range_start' "$MANIFEST")"
  git -C "$ROOT" cat-file -e "$cutoff^{commit}"
  git -C "$ROOT" merge-base --is-ancestor "$range_start" "$cutoff"
  while IFS= read -r upstream_commit; do
    if ! git -C "$ROOT" cat-file -e "$upstream_commit^{commit}" 2>/dev/null \
      || ! git -C "$ROOT" merge-base --is-ancestor "$range_start" "$upstream_commit" \
      || ! git -C "$ROOT" merge-base --is-ancestor "$upstream_commit" "$cutoff"; then
      commit_valid=false
    fi
  done < <(jq -r '.commit_inventory[].upstream_commit' "$MANIFEST")
  manifest_sha256="$(shasum -a 256 "$MANIFEST" | awk '{print $1}')"
  jq -cn \
    --arg manifest "${MANIFEST#$ROOT/}" \
    --arg manifest_sha256 "$manifest_sha256" \
    --arg cutoff "$cutoff" \
    --arg range_start "$range_start" \
    --argjson commit_valid "$commit_valid" \
    --argjson inventory "$(jq '.commit_inventory' "$MANIFEST")" '
    {
      schema:"hepta_upstream_intake_audit_ledger_v2",
      compatibility:{accepts_source_schemas:["hepta_upstream_codex_current_intake_v2","hepta_upstream_codex_current_intake_v3"],migration:"additive"},
      status:(if $commit_valid then "attention" else "blocked" end),
      source_schema:"hepta_upstream_codex_current_intake_v3",
      source_manifest:$manifest,
      source_manifest_sha256:$manifest_sha256,
      range_start:$range_start,
      cutoff_commit:$cutoff,
      commit_count:($inventory|length),
      deferred_count:([$inventory[]|select(.disposition=="deferred")]|length),
      rejected_count:([$inventory[]|select(.disposition=="rejected")]|length),
      imported_count:([$inventory[]|select(.disposition=="imported" or .imported)]|length),
      integrated_count:([$inventory[]|select(.integrated)]|length),
      tested_count:([$inventory[]|select(.tested)]|length),
      commit_objects_valid:$commit_valid,
      follow_up_started:false,
      platform_evidence:{macos_fully_verified:false,linux_fully_verified:false},
      release_evidence:{source_bound:false,artifact_bound:false,preflight_bound:false,active_binary_bound:false},
      policy:{bulk_merge_allowed:false,bulk_rebase_allowed:false,whole_tree_replacement_allowed:false,cargo_lock_replacement_allowed:false,production_ready:false}
    }'
}

report_v2() {
  jq -cn \
    --arg manifest "${MANIFEST#$ROOT/}" \
    --arg manifest_sha256 "$(shasum -a 256 "$MANIFEST" | awk '{print $1}')" \
    --arg cutoff "$(jq -er '.observation.cutoff_head' "$MANIFEST")" \
    --argjson selected "$(jq '.selected_absorptions|length' "$MANIFEST")" \
    --argjson deferred "$(jq '.deferred_decisions|length' "$MANIFEST")" '
    {schema:"hepta_upstream_intake_audit_ledger_v2",compatibility:{accepts_source_schemas:["hepta_upstream_codex_current_intake_v2","hepta_upstream_codex_current_intake_v3"],migration:"additive"},status:"historical",source_schema:"hepta_upstream_codex_current_intake_v2",source_manifest:$manifest,source_manifest_sha256:$manifest_sha256,cutoff_commit:$cutoff,selected_absorption_count:$selected,deferred_decision_count:$deferred,policy:{production_ready:false}}'
}

report() {
  [[ -f "$MANIFEST" ]] || { echo "missing upstream intake manifest: $MANIFEST" >&2; return 1; }
  case "$(jq -er '.schema_version' "$MANIFEST")" in
    hepta_upstream_codex_current_intake_v3) report_v3 ;;
    hepta_upstream_codex_current_intake_v2) report_v2 ;;
    *) echo "unsupported upstream intake manifest schema" >&2; return 1 ;;
  esac
}

verify() {
  local ledger
  ledger="$(report)"
  if [[ "$(jq -r '.source_schema' <<<"$ledger")" == "hepta_upstream_codex_current_intake_v3" ]]; then
    jq -e '
      .schema == "hepta_upstream_intake_audit_ledger_v2"
      and .compatibility.migration == "additive"
      and .status == "attention"
      and .commit_count == 83
      and .deferred_count == 74
      and .rejected_count == 9
      and .imported_count == 0
      and .integrated_count == 0
      and .tested_count == 0
      and .commit_objects_valid == true
      and .follow_up_started == false
      and .release_evidence.active_binary_bound == false
      and .policy.production_ready == false
    ' >/dev/null <<<"$ledger"
  else
    jq -e '.schema == "hepta_upstream_intake_audit_ledger_v2" and .status == "historical" and .selected_absorption_count == 12 and .deferred_decision_count == 20 and .policy.production_ready == false' >/dev/null <<<"$ledger"
  fi
  printf '%s\n' "$ledger"
}

self_test() {
  local tmp_manifest
  tmp_manifest="$(mktemp "${TMPDIR:-/tmp}/hepta-upstream-audit-manifest.XXXXXX")"
  trap 'rm -f "$tmp_manifest"' RETURN
  jq '.commit_inventory[0].disposition="imported" | .commit_inventory[0].imported=true' "$MANIFEST" >"$tmp_manifest"
  if HEPTA_UPSTREAM_AUDIT_MANIFEST="$tmp_manifest" "$ROOT/scripts/hepta-upstream-intake-audit-ledger" verify >/dev/null 2>&1; then
    echo "upstream audit ledger accepted a false import claim" >&2
    return 1
  fi
  HEPTA_UPSTREAM_AUDIT_MANIFEST="$ROOT/docs/architecture/HEPTA_UPSTREAM_CODEX_CURRENT_INTAKE_2026-07-21_R2.json" \
    "$ROOT/scripts/hepta-upstream-intake-audit-ledger" verify >/dev/null
  echo '{"schema":"hepta_upstream_intake_audit_ledger_self_test_v2","status":"ready","false_import_claim_denied":true,"v2_predecessor_compatibility_preserved":true}'
}

case "$MODE" in
  report) report ;;
  verify) verify ;;
  self-test) self_test ;;
  *) usage ;;
esac
