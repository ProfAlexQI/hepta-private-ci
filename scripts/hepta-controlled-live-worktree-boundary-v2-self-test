#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
AUDIT_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-readiness-audit-v2.report"
DENIAL_REPORT="$ROOT/scripts/lib/hepta-gate-pair-compat-v1/hepta-systems-controlled-live-readiness-denial-readback-index-v2.report"

fail() {
  printf 'hepta-controlled-live-worktree-boundary-v2-self-test: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ -x "$AUDIT_REPORT" ]] || fail "missing executable v2 audit report: $AUDIT_REPORT"
[[ -x "$DENIAL_REPORT" ]] || fail "missing executable v2 denial report: $DENIAL_REPORT"
command -v git >/dev/null 2>&1 || fail "git is required"
command -v jq >/dev/null 2>&1 || fail "jq is required"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
fixture_root="$tmpdir/repo"
mkdir -p "$fixture_root"

for source_dir in scripts codex-rs docs plugins apps; do
  ln -s "$ROOT/$source_dir" "$fixture_root/$source_dir"
done

git -C "$fixture_root" init -q
git -C "$fixture_root" config user.name "Hepta synthetic fixture"
git -C "$fixture_root" config user.email "hepta-fixture@invalid"
git -C "$fixture_root" add scripts codex-rs docs plugins apps
git -C "$fixture_root" commit -qm "Create controlled-live boundary fixture"

HEPTA_REPO_ROOT="$fixture_root" "$AUDIT_REPORT" >"$tmpdir/clean-audit.json"
HEPTA_REPO_ROOT="$fixture_root" \
  HEPTA_CONTROLLED_LIVE_AUDIT_JSON="$tmpdir/clean-audit.json" \
  "$DENIAL_REPORT" >"$tmpdir/clean-denial.json"

jq -e '
  .status == "ready_blocked"
  and .schema_version == "controlled_live_readiness_audit_v2"
  and .git_status_source == "actual_repository"
  and .git_status_entry_count == 0
  and .worktree_boundary_state == "clean"
  and .dirty_worktree_boundary_tracked == false
  and .satisfied_precondition_count == 6
  and .blocking_precondition_count == 6
  and .blocker_count == 6
  and .controlled_live_audit_ready == true
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and .activation_allowed == false
  and all(.blockers[]; .id != "dirty_worktree_boundary")
' "$tmpdir/clean-audit.json" >/dev/null

jq -e '
  .status == "ready_blocked"
  and .source_worktree_boundary_state == "clean"
  and .source_blocker_count == 6
  and .index_entry_count == 7
  and .active_blocker_count == 6
  and .blocking_entry_count == 6
  and .satisfied_entry_count == 1
  and .readback_index_ready == true
  and .controlled_live_cutover_ready == false
  and .ready_for_live_execution == false
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .current_state == "satisfied" and .active_blocker == false and .blocks_cutover == false)
' "$tmpdir/clean-denial.json" >/dev/null

touch "$fixture_root/synthetic-dirty-boundary"
HEPTA_REPO_ROOT="$fixture_root" "$AUDIT_REPORT" >"$tmpdir/dirty-audit.json"
HEPTA_REPO_ROOT="$fixture_root" \
  HEPTA_CONTROLLED_LIVE_AUDIT_JSON="$tmpdir/dirty-audit.json" \
  "$DENIAL_REPORT" >"$tmpdir/dirty-denial.json"

jq -e '
  .status == "ready_blocked"
  and .schema_version == "controlled_live_readiness_audit_v2"
  and .git_status_source == "actual_repository"
  and .git_status_entry_count == 1
  and .git_untracked_count == 1
  and .git_tracked_change_count == 0
  and .worktree_boundary_state == "dirty"
  and .dirty_worktree_boundary_tracked == true
  and .satisfied_precondition_count == 5
  and .blocking_precondition_count == 7
  and .blocker_count == 7
  and .controlled_live_audit_ready == true
  and .controlled_live_cutover_ready == false
  and .live_execution_allowed == false
  and .activation_allowed == false
  and any(.blockers[]; .id == "dirty_worktree_boundary")
' "$tmpdir/dirty-audit.json" >/dev/null

jq -e '
  .status == "ready_blocked"
  and .source_worktree_boundary_state == "dirty"
  and .source_blocker_count == 7
  and .index_entry_count == 7
  and .active_blocker_count == 7
  and .blocking_entry_count == 7
  and .satisfied_entry_count == 0
  and .readback_index_ready == true
  and .controlled_live_cutover_ready == false
  and .ready_for_live_execution == false
  and any(.entries[]; .source_blocker_id == "dirty_worktree_boundary" and .current_state == "missing" and .active_blocker == true and .blocks_cutover == true)
' "$tmpdir/dirty-denial.json" >/dev/null

jq -n '
  {
    status:"ready",
    schema_version:"hepta_controlled_live_worktree_boundary_v2_self_test",
    clean_fixture:{
      audit_ready:true,
      active_blocker_count:6,
      dirty_worktree_blocker_present:false,
      cutover_ready:false,
      live_execution_allowed:false
    },
    dirty_fixture:{
      audit_ready:true,
      active_blocker_count:7,
      dirty_worktree_blocker_present:true,
      cutover_ready:false,
      live_execution_allowed:false
    },
    stable_readback_slot_count:7,
    repository_state_fabricated:false,
    external_side_effects_performed:false
  }
  '
