#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
pid=""
installed_bin=""
manifest=""
expected_source_commit=""

usage() {
  echo "usage: scripts/hepta-active-binary-consistency-gate --pid PID --installed-bin PATH --manifest PATH --expected-source-commit SHA" >&2
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    --pid) shift; [[ $# -gt 0 ]] || usage; pid="$1" ;;
    --installed-bin) shift; [[ $# -gt 0 ]] || usage; installed_bin="$1" ;;
    --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
    --expected-source-commit) shift; [[ $# -gt 0 ]] || usage; expected_source_commit="$1" ;;
    *) usage ;;
  esac
  shift
done

[[ "$pid" =~ ^[1-9][0-9]*$ ]] || usage
[[ "$expected_source_commit" =~ ^[0-9a-f]{40}$ ]] || {
  echo "expected source commit must be a full Git SHA" >&2
  exit 2
}
[[ -f "$installed_bin" && -x "$installed_bin" ]] || {
  echo "installed binary must be executable: $installed_bin" >&2
  exit 1
}
[[ -f "$manifest" ]] || {
  echo "manifest is missing: $manifest" >&2
  exit 1
}
kill -0 "$pid" 2>/dev/null || {
  echo "active process is not running: $pid" >&2
  exit 1
}
manifest_contract_valid=false
if "$ROOT/scripts/hepta-immutable-release-tree" verify --manifest "$manifest" >/dev/null 2>&1; then
  manifest_contract_valid=true
fi

active_executable=""
case "$(uname -s)" in
  Darwin)
    active_executable="$(lsof -a -p "$pid" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)"
    ;;
  Linux)
    active_executable="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
    active_executable="${active_executable% (deleted)}"
    ;;
  *)
    echo "unsupported platform for active executable identity: $(uname -s)" >&2
    exit 1
    ;;
esac

[[ -n "$active_executable" && -f "$active_executable" ]] || {
  echo "could not resolve active executable for pid $pid" >&2
  exit 1
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }

active_sha256="$(sha256_file "$active_executable")"
installed_sha256="$(sha256_file "$installed_bin")"
manifest_file_sha256="$(sha256_file "$manifest")"
manifest_sha256="$(jq -r '.artifact.sha256 // ""' "$manifest" 2>/dev/null || true)"
manifest_source_commit="$(jq -r '.source.commit // "unknown"' "$manifest" 2>/dev/null || true)"
manifest_bound="$(jq -r '
  .status == "ready"
  and .source.commit_bound == true
  and .source.commit != "unknown"
  and .preflight.bound == true
  and .preflight.passed == true
  and .preflight.source_head == .source.commit
  and .preflight.candidate_source_commit == .source.commit
  and .preflight.candidate_artifact_sha256 == .artifact.sha256
  and .build_provenance.source.commit == .source.commit
  and .build_provenance.artifact.sha256 == .artifact.sha256
' "$manifest" 2>/dev/null || echo false)"

source_commit_matches=false
if [[ "$manifest_source_commit" == "$expected_source_commit" ]]; then
  source_commit_matches=true
fi
installed_manifest_sha_match=false
if [[ -n "$manifest_sha256" && "$installed_sha256" == "$manifest_sha256" ]]; then
  installed_manifest_sha_match=true
fi
active_installed_sha_match=false
if [[ "$active_sha256" == "$installed_sha256" ]]; then
  active_installed_sha_match=true
fi

# Current-reality readiness is a direct readback contract, not a replay of the
# candidate manifest's historical preflight status. Tests may inject the clock
# and observation envelope without sleeping or depending on wall-clock timing.
current_reality_source="${HEPTA_CURRENT_REALITY_SOURCE-active_process_readback}"
current_reality_max_age_seconds="${HEPTA_CURRENT_REALITY_MAX_AGE_SECONDS:-60}"
current_reality_max_future_skew_seconds="${HEPTA_CURRENT_REALITY_MAX_FUTURE_SKEW_SECONDS:-0}"
if [[ ${HEPTA_CURRENT_REALITY_NOW_EPOCH+x} ]]; then
  current_reality_now_epoch="$HEPTA_CURRENT_REALITY_NOW_EPOCH"
  current_reality_clock_source="fixture"
else
  current_reality_now_epoch="$(date -u +%s)"
  current_reality_clock_source="system_utc"
fi
if [[ ${HEPTA_CURRENT_REALITY_OBSERVED_AT_EPOCH+x} ]]; then
  current_reality_observed_at_epoch="$HEPTA_CURRENT_REALITY_OBSERVED_AT_EPOCH"
else
  current_reality_observed_at_epoch="$current_reality_now_epoch"
fi
current_reality_manifest_sha256="${HEPTA_CURRENT_REALITY_MANIFEST_SHA256-$manifest_file_sha256}"
repo_head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"

current_reality="$({
  jq -cn \
    --arg schema_version "hepta_current_reality_observation_v1" \
    --arg source "$current_reality_source" \
    --arg clock_source "$current_reality_clock_source" \
    --arg now "$current_reality_now_epoch" \
    --arg observed_at "$current_reality_observed_at_epoch" \
    --arg max_age "$current_reality_max_age_seconds" \
    --arg max_future_skew "$current_reality_max_future_skew_seconds" \
    --arg repo_head "$repo_head" \
    --arg expected_source_commit "$expected_source_commit" \
    --arg manifest_source_commit "$manifest_source_commit" \
    --arg manifest_sha256 "$manifest_file_sha256" \
    --arg observed_manifest_sha256 "$current_reality_manifest_sha256" \
    '
      def unsigned_integer: test("^(0|[1-9][0-9]{0,17})$");
      ($now | unsigned_integer) as $now_valid
      | ($observed_at | unsigned_integer) as $observed_at_valid
      | ($max_age | unsigned_integer) as $max_age_valid
      | ($max_future_skew | unsigned_integer) as $max_future_skew_valid
      | ($max_age_valid and (($max_age | tonumber) > 0)
          and $max_future_skew_valid
          and (($max_future_skew | tonumber) == 0)) as $freshness_policy_valid
      | (if $now_valid and $observed_at_valid
          then (($now | tonumber) - ($observed_at | tonumber))
          else null
          end) as $age_seconds
      | ($source == "active_process_readback") as $source_verified
      | ($repo_head | test("^[0-9a-f]{40}$")) as $repo_head_valid
      | ($repo_head_valid and $repo_head == $expected_source_commit) as $source_head_matches
      | ($manifest_source_commit == $expected_source_commit) as $manifest_source_matches
      | (($manifest_sha256 | test("^[0-9a-f]{64}$"))
          and $observed_manifest_sha256 == $manifest_sha256) as $manifest_readback_verified
      | ($now_valid and $observed_at_valid and $freshness_policy_valid
          and $age_seconds >= 0
          and $age_seconds <= ($max_age | tonumber)) as $fresh
      | {
          schema_version:$schema_version,
          source:$source,
          clock_source:$clock_source,
          generated_at:(if $now_valid then ($now | tonumber) else null end),
          observed_at:(if $observed_at_valid then ($observed_at | tonumber) else null end),
          age_seconds:$age_seconds,
          max_age_seconds:(if $max_age_valid then ($max_age | tonumber) else null end),
          max_future_skew_seconds:(if $max_future_skew_valid
            then ($max_future_skew | tonumber) else null end),
          timestamp_present:($observed_at != ""),
          timestamp_valid:($now_valid and $observed_at_valid),
          freshness_policy_valid:$freshness_policy_valid,
          future_observation:($age_seconds != null and $age_seconds < 0),
          expired:($age_seconds != null and $max_age_valid
            and $age_seconds > ($max_age | tonumber)),
          fresh:$fresh,
          stale:($fresh | not),
          source_verified:$source_verified,
          repo_head:(if $repo_head_valid then $repo_head else null end),
          expected_source_commit:$expected_source_commit,
          source_head_matches:$source_head_matches,
          manifest_source_commit:$manifest_source_commit,
          manifest_source_matches:$manifest_source_matches,
          manifest_sha256:$manifest_sha256,
          observed_manifest_sha256:$observed_manifest_sha256,
          manifest_readback_verified:$manifest_readback_verified,
          readback_verifiable:($source_verified
            and $source_head_matches
            and $manifest_source_matches
            and $manifest_readback_verified),
          current:($fresh
            and $source_verified
            and $source_head_matches
            and $manifest_source_matches
            and $manifest_readback_verified)
        }
    '
})"
observation_fresh="$(jq -r '.fresh' <<<"$current_reality")"
current_reality_current="$(jq -r '.current' <<<"$current_reality")"

failure_reasons='[]'
if [[ "$manifest_contract_valid" != "true" ]]; then
  failure_reasons="$(jq -cn '$ARGS.positional' --args active_manifest_contract_invalid)"
fi
if [[ "$manifest_bound" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args active_manifest_not_source_preflight_bound)"
fi
if [[ "$installed_sha256" != "$manifest_sha256" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args installed_manifest_sha_mismatch)"
fi
if [[ "$active_sha256" != "$installed_sha256" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args active_installed_sha_mismatch)"
fi
if [[ "$source_commit_matches" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args active_source_commit_mismatch)"
fi
if [[ "$(jq -r '.freshness_policy_valid' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_freshness_policy_invalid)"
fi
if [[ "$(jq -r '.timestamp_present' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_observed_at_missing)"
elif [[ "$(jq -r '.timestamp_valid' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_timestamp_invalid)"
elif [[ "$(jq -r '.future_observation' <<<"$current_reality")" == "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_observation_from_future)"
elif [[ "$(jq -r '.expired' <<<"$current_reality")" == "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_observation_stale)"
fi
if [[ "$(jq -r '.source_verified' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_source_unverified)"
fi
if [[ "$(jq -r '.source_head_matches' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_source_head_mismatch)"
fi
if [[ "$(jq -r '.manifest_source_matches' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_manifest_source_mismatch)"
fi
if [[ "$(jq -r '.manifest_readback_verified' <<<"$current_reality")" != "true" ]]; then
  failure_reasons="$(jq -cn --argjson reasons "$failure_reasons" '$reasons + $ARGS.positional' --args current_reality_manifest_readback_unverified)"
fi

contract_valid=false
if [[ "$manifest_contract_valid" == "true" ]]; then
  contract_valid=true
fi
locally_executable=true
integration_verified=false
if [[ "$contract_valid" == "true" && "$manifest_bound" == "true" && "$source_commit_matches" == "true" && "$installed_manifest_sha_match" == "true" ]]; then
  integration_verified=true
fi
active_binary_consistent=false
if [[ "$installed_manifest_sha_match" == "true" && "$active_installed_sha_match" == "true" ]]; then
  active_binary_consistent=true
fi
current_runtime_ready=false
if [[ "$active_binary_consistent" == "true" && "$current_reality_current" == "true" ]]; then
  current_runtime_ready=true
fi
deployment_consistent=false
if [[ "$integration_verified" == "true" && "$current_runtime_ready" == "true" ]]; then
  deployment_consistent=true
fi
controlled_live=false
live_enabled=false
production_ready=false

jq -cn \
  --argjson contract_valid "$contract_valid" \
  --argjson locally_executable "$locally_executable" \
  --argjson integration_verified "$integration_verified" \
  --argjson active_binary_consistent "$active_binary_consistent" \
  --argjson observation_fresh "$observation_fresh" \
  --argjson current_runtime_ready "$current_runtime_ready" \
  --argjson deployment_consistent "$deployment_consistent" \
  --argjson controlled_live "$controlled_live" \
  --argjson live_enabled "$live_enabled" \
  --argjson production_ready "$production_ready" \
  --arg pid "$pid" \
  --arg active_executable "$active_executable" \
  --arg active_sha256 "$active_sha256" \
  --arg repo_head "$repo_head" \
  --arg installed_bin "$(realpath "$installed_bin")" \
  --arg installed_sha256 "$installed_sha256" \
  --arg manifest "$(realpath "$manifest")" \
  --arg manifest_sha256 "$manifest_sha256" \
  --argjson manifest_contract_valid "$manifest_contract_valid" \
  --arg source_commit "$manifest_source_commit" \
  --arg expected_source_commit "$expected_source_commit" \
  --argjson manifest_source_preflight_bound "$manifest_bound" \
  --argjson source_commit_matches "$source_commit_matches" \
  --argjson installed_manifest_sha_match "$installed_manifest_sha_match" \
  --argjson active_installed_sha_match "$active_installed_sha_match" \
  --argjson current_reality "$current_reality" \
  --argjson failure_reasons "$failure_reasons" \
  '{
    status:(if $deployment_consistent then "ready" else "blocked" end),
    status_scope:"deployment_consistency_gate",
    ready:$deployment_consistent,
    contract_valid:$contract_valid,
    locally_executable:$locally_executable,
    integration_verified:$integration_verified,
    active_binary_consistent:$active_binary_consistent,
    observation_fresh:$observation_fresh,
    current_runtime_ready:$current_runtime_ready,
    deployment_consistent:$deployment_consistent,
    controlled_live:$controlled_live,
    live_enabled:$live_enabled,
    production_ready:$production_ready,
    pid:($pid | tonumber),
    active_executable:$active_executable,
    active_sha256:$active_sha256,
    repo_head:$repo_head,
    installed_binary:$installed_bin,
    installed_sha256:$installed_sha256,
    manifest:$manifest,
    manifest_contract_valid:$manifest_contract_valid,
    manifest_artifact_sha256:$manifest_sha256,
    source_commit:$source_commit,
    expected_source_commit:$expected_source_commit,
    manifest_source_preflight_bound:$manifest_source_preflight_bound,
    source_commit_matches:$source_commit_matches,
    installed_manifest_sha_match:$installed_manifest_sha_match,
    active_installed_sha_match:$active_installed_sha_match,
    active_installed_manifest_sha_match:($installed_manifest_sha_match and $active_installed_sha_match),
    current_reality:$current_reality,
    truth_semantics:{
      highest_verified_level:(
        if $deployment_consistent then "deployment_consistent"
        elif $current_runtime_ready then "current_runtime_ready"
        elif $active_binary_consistent then "active_binary_consistent"
        elif $integration_verified then "integration_verified"
        elif $locally_executable then "locally_executed"
        elif $contract_valid then "static_contract"
        else "configured_or_capable"
        end
      ),
      ready_is_gate_scoped:true,
      contract_readiness_is_not_observation_freshness:true,
      observation_freshness_is_not_current_runtime_readiness:true,
      current_runtime_readiness_is_not_deployment_consistency:true,
      active_process_is_not_controlled_live_evidence:true,
      deployment_consistency_is_not_production_readiness:true
    },
    failure_reasons:$failure_reasons
  }'

[[ "$deployment_consistent" == "true" ]]
