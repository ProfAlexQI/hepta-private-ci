#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "zlib"
require_relative "lib/hepta-normalized-token-bundle-v1"
require_relative "hepta-workgraph-readable-token-source-v1"

ROOT = File.expand_path("..", __dir__)
RUNTIME_ROOT = File.join(ROOT, "codex-rs/hepta-runtime")
SOURCE_ROOT = File.join(RUNTIME_ROOT, "src")
LIB_SOURCE = File.join(SOURCE_ROOT, "lib.rs")
BUNDLE_ROOT = File.join(RUNTIME_ROOT, "codegen/workgraph-v3")
BUNDLE_PATH = File.join(BUNDLE_ROOT, "modules.bundle.gz")
REGISTRY_PATH = File.join(BUNDLE_ROOT, "registry.json")
LEGACY_BUNDLE_PATH = File.join(
  RUNTIME_ROOT,
  "codegen/workgraph-v2/modules.bundle.gz"
)
LEGACY_BUNDLE_ROOT = File.dirname(LEGACY_BUNDLE_PATH)
SCHEMA = "hepta_workgraph_normalized_bundle_v3"
LEGACY_SCHEMA = "hepta_workgraph_module_bundle_v2"
MODULE_PATTERN = /^mod ((?:wg_|work_graph_)[a-z0-9_]+);$/
INCLUDE_LINE = <<~RUST
  include!(concat!(
      env!("OUT_DIR"),
      "/hepta_workgraph_bundle/modules.rs"
  ));
RUST
INCLUDE_PATTERN =
  /include!\(\s*concat!\(\s*env!\("OUT_DIR"\),\s*"\/hepta_workgraph_bundle\/modules\.rs"\s*\)\s*\);\n/m
EXPECTED_MODULE_COUNT = 711
MAX_NORMALIZED_EFFECTIVE_LINES = 297_356
MAX_NORMALIZED_TEMPLATE_COUNT = 454
MAX_CANONICAL_RECORD_BYTES = 89_271

def usage
  warn "usage: scripts/hepta-workgraph-module-bundle [pack|verify|unpack|contains MODULE]"
  exit 2
end

def atomic_write(path, content, mode = nil)
  FileUtils.mkdir_p(File.dirname(path))
  staging = File.join(
    File.dirname(path),
    ".hepta-workgraph-bundle-#{Digest::SHA256.hexdigest(path)[0, 12]}-#{$$}.tmp"
  )
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end

def source_declarations
  File.readlines(LIB_SOURCE, chomp: false).each_with_object([]) do |line, declarations|
    match = MODULE_PATTERN.match(line.chomp)
    declarations << match[1] if match
  end
end

def source_path(module_name)
  File.join(SOURCE_ROOT, "#{module_name}.rs")
end

def normalized_entries
  compressed = File.binread(BUNDLE_PATH)
  payload = Zlib::GzipReader.new(StringIO.new(compressed)).read
  HeptaNormalizedTokenBundle.decode(
    payload,
    schema: SCHEMA,
    name_validator: lambda { |name|
      name.match?(/\A(?:wg_|work_graph_)[a-z0-9_]+\z/)
    }
  )
end

def canonical_entries(strict_metadata:)
  HeptaReadableTokenSource.read(
    root: BUNDLE_ROOT,
    artifact_schema: SCHEMA,
    domain: "hepta_workgraph_modules",
    name_validator: lambda { |name|
      name.match?(/\A(?:wg_|work_graph_)[a-z0-9_]+\z/)
    },
    strict_metadata: strict_metadata
  )
end

def legacy_entries
  payload = Zlib::GzipReader.open(LEGACY_BUNDLE_PATH, &:read).b
  cursor = StringIO.new(payload)
  magic = "#{LEGACY_SCHEMA}\0".b
  raise "invalid legacy WorkGraph bundle magic" unless cursor.read(magic.bytesize) == magic
  count = cursor.read(4)&.unpack1("N")
  raise "missing legacy WorkGraph module count" unless count
  entries = Array.new(count) do
    lengths = cursor.read(8)&.unpack("NN")
    raise "truncated legacy WorkGraph lengths" unless lengths&.length == 2
    name_length, source_length = lengths
    name = cursor.read(name_length)
    expected_sha = cursor.read(32)
    source = cursor.read(source_length)
    raise "truncated legacy WorkGraph module" unless name&.bytesize == name_length &&
      expected_sha&.bytesize == 32 && source&.bytesize == source_length
    raise "legacy WorkGraph SHA mismatch: #{name}" unless Digest::SHA256.digest(source) == expected_sha
    HeptaNormalizedTokenBundle::Entry.new(name.force_encoding(Encoding::UTF_8), source)
  end
  raise "trailing legacy WorkGraph bundle bytes" unless cursor.eof?
  entries.sort_by(&:name)
end

def source_entries
  declarations = source_declarations
  raise "unexpected WorkGraph module count: #{declarations.length}" unless declarations.length == EXPECTED_MODULE_COUNT
  declarations.map do |module_name|
    path = source_path(module_name)
    raise "missing WorkGraph source: #{path}" unless File.file?(path)
    HeptaNormalizedTokenBundle::Entry.new(module_name, File.binread(path))
  end.sort_by(&:name)
end

def build_bundle(entries)
  raise "unexpected WorkGraph module count" unless entries.length == EXPECTED_MODULE_COUNT
  bundle = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:rust_tokens)
  )
  raise "WorkGraph normalized template budget exceeded" if bundle.metrics.fetch(:normalized_template_count) > MAX_NORMALIZED_TEMPLATE_COUNT
  raise "WorkGraph normalized effective-line budget exceeded" if bundle.metrics.fetch(:normalized_effective_lines) > MAX_NORMALIZED_EFFECTIVE_LINES
  FileUtils.mkdir_p(BUNDLE_ROOT)
  canonical = HeptaReadableTokenSource.write(
    root: BUNDLE_ROOT,
    bundle: bundle,
    artifact_schema: SCHEMA,
    domain: "hepta_workgraph_modules",
    artifact_file: File.basename(BUNDLE_PATH),
    atomic_write: method(:atomic_write)
  )
  payload = HeptaNormalizedTokenBundle.encode(bundle, schema: SCHEMA)
  atomic_write(
    BUNDLE_PATH,
    HeptaReadableTokenSource.deterministic_gzip(payload),
    0o644
  )
  write_registry(entries, bundle.metrics, canonical)
end

def write_registry(entries, metrics, canonical)
  registry = {
    schema: SCHEMA,
    status: "normalized",
    module_count: entries.length,
    source_bytes: entries.sum { |entry| entry.source.bytesize },
    source_lines: entries.sum { |entry| entry.source.lines.count },
    aggregate_source_sha256: HeptaNormalizedTokenBundle.aggregate_sha(entries),
    bundle_bytes: File.size(BUNDLE_PATH),
    bundle_sha256: Digest::SHA256.file(BUNDLE_PATH).hexdigest,
    normalized_template_count: metrics.fetch(:normalized_template_count),
    normalized_template_limit: MAX_NORMALIZED_TEMPLATE_COUNT,
    normalized_parameter_row_count: metrics.fetch(:normalized_parameter_row_count),
    normalized_effective_lines: metrics.fetch(:normalized_effective_lines),
    normalized_effective_line_limit: MAX_NORMALIZED_EFFECTIVE_LINES,
    canonical_source_schema: canonical.fetch(:schema),
    canonical_source_files: canonical.fetch(:canonical_files),
    canonical_schema_sha256: Digest::SHA256.file(
      File.join(BUNDLE_ROOT, HeptaReadableTokenSource::SCHEMA_FILE)
    ).hexdigest,
    canonical_templates_sha256: canonical.fetch(:templates_sha256),
    canonical_parameters_sha256: canonical.fetch(:parameters_sha256),
    canonical_max_record_bytes: canonical.fetch(:canonical_max_record_bytes),
    canonical_max_record_byte_limit: MAX_CANONICAL_RECORD_BYTES,
    canonical_record_byte_semantics: canonical.fetch(:jsonl_record_byte_semantics),
    gzip_mtime: HeptaReadableTokenSource::FIXED_GZIP_MTIME,
    gzip_os: HeptaReadableTokenSource::FIXED_GZIP_OS,
    monotonic_ratchet: {
      logical_module_ceiling: EXPECTED_MODULE_COUNT,
      normalized_template_ceiling: MAX_NORMALIZED_TEMPLATE_COUNT,
      normalized_effective_line_ceiling: MAX_NORMALIZED_EFFECTIVE_LINES
    },
    decline_targets: {
      next: {
        logical_module_count: 399,
        normalized_template_count: 399,
        normalized_effective_lines: 260_000
      },
      terminal: {
        logical_module_count: 199,
        normalized_template_count: 199,
        normalized_effective_lines: 180_000
      }
    },
    source_files_materialized: false,
    canonical_source_is_readable: true,
    gzip_is_generated_artifact: true,
    byte_identical_repack_verified: true,
    build_time_module_generation: true,
    reversible_unpack: true
  }
  atomic_write(REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
end

def rewrite_lib_to_bundle
  source = File.binread(LIB_SOURCE)
  declarations = source.lines.each_with_object([]) do |line, names|
    match = MODULE_PATTERN.match(line.chomp)
    names << match[1] if match
  end
  return if declarations.empty? && source.scan(INCLUDE_PATTERN).length == 1
  raise "unexpected WorkGraph declaration count" unless declarations.length == EXPECTED_MODULE_COUNT
  inserted = false
  rewritten = source.lines.each_with_object([]) do |line, output|
    if MODULE_PATTERN.match?(line.chomp)
      unless inserted
        output << INCLUDE_LINE
        inserted = true
      end
    else
      output << line
    end
  end
  raise "WorkGraph bundle include was not inserted" unless inserted
  atomic_write(LIB_SOURCE, rewritten.join, File.stat(LIB_SOURCE).mode & 0o777)
end

def rewrite_lib_to_sources(entries)
  source = File.binread(LIB_SOURCE)
  raise "WorkGraph bundle include is missing" unless source.scan(INCLUDE_PATTERN).length == 1
  declarations = entries.map { |entry| "mod #{entry.name};\n" }.join
  atomic_write(
    LIB_SOURCE,
    source.sub(INCLUDE_PATTERN, declarations),
    File.stat(LIB_SOURCE).mode & 0o777
  )
end

def pack
  entries = if HeptaReadableTokenSource.present?(BUNDLE_ROOT) &&
      source_declarations.empty?
              canonical_entries(strict_metadata: false).first
            elsif File.file?(BUNDLE_PATH) && source_declarations.empty?
              normalized_entries
            elsif File.file?(LEGACY_BUNDLE_PATH) && source_declarations.empty?
              legacy_entries
            else
              source_entries
            end
  build_bundle(entries)
  rewrite_lib_to_bundle
  entries.each { |entry| FileUtils.rm_f(source_path(entry.name)) }
  FileUtils.rm_rf(LEGACY_BUNDLE_ROOT)
  FileUtils.rm_rf(File.join(RUNTIME_ROOT, "codegen/workgraph-v1"))
  verify
end

def verify
  raise "missing normalized WorkGraph bundle" unless File.file?(BUNDLE_PATH) &&
    File.file?(REGISTRY_PATH) &&
    HeptaReadableTokenSource.present?(BUNDLE_ROOT)
  entries, canonical_bundle, canonical = canonical_entries(strict_metadata: true)
  rebuilt = HeptaNormalizedTokenBundle.build(
    entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:rust_tokens)
  )
  canonical_payload = HeptaNormalizedTokenBundle.encode(canonical_bundle, schema: SCHEMA)
  rebuilt_payload = HeptaNormalizedTokenBundle.encode(rebuilt, schema: SCHEMA)
  raise "WorkGraph canonical normalization drifted" unless canonical_payload == rebuilt_payload
  expected_gzip = HeptaReadableTokenSource.deterministic_gzip(rebuilt_payload)
  raise "WorkGraph generated gzip is not byte-identical" unless File.binread(BUNDLE_PATH) ==
    expected_gzip
  artifact_entries = normalized_entries
  raise "WorkGraph artifact reassembly drifted" unless HeptaNormalizedTokenBundle.aggregate_sha(
    artifact_entries
  ) == HeptaNormalizedTokenBundle.aggregate_sha(entries)
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  raise "invalid normalized WorkGraph registry schema" unless registry["schema"] == SCHEMA
  raise "unexpected WorkGraph module count" unless entries.length == EXPECTED_MODULE_COUNT
  raise "WorkGraph module count drifted" unless registry["module_count"] == entries.length
  raise "WorkGraph aggregate SHA drifted" unless registry["aggregate_source_sha256"] == HeptaNormalizedTokenBundle.aggregate_sha(entries)
  raise "WorkGraph source byte count drifted" unless registry["source_bytes"] == entries.sum { |entry| entry.source.bytesize }
  raise "WorkGraph source line count drifted" unless registry["source_lines"] == entries.sum { |entry| entry.source.lines.count }
  raise "WorkGraph bundle SHA drifted" unless registry["bundle_sha256"] == Digest::SHA256.file(BUNDLE_PATH).hexdigest
  raise "WorkGraph bundle byte count drifted" unless registry["bundle_bytes"] == File.size(BUNDLE_PATH)
  raise "WorkGraph normalized template budget exceeded" unless registry[
    "normalized_template_count"
  ].between?(1, MAX_NORMALIZED_TEMPLATE_COUNT)
  raise "WorkGraph normalized template limit drifted" unless registry[
    "normalized_template_limit"
  ] == MAX_NORMALIZED_TEMPLATE_COUNT
  raise "WorkGraph normalized parameter rows drifted" unless registry["normalized_parameter_row_count"] == EXPECTED_MODULE_COUNT
  raise "WorkGraph normalized effective-line budget exceeded" unless registry["normalized_effective_lines"].between?(1, MAX_NORMALIZED_EFFECTIVE_LINES)
  raise "WorkGraph normalized effective-line limit drifted" unless registry[
    "normalized_effective_line_limit"
  ] == MAX_NORMALIZED_EFFECTIVE_LINES
  raise "WorkGraph readable canonical schema drifted" unless registry[
    "canonical_source_schema"
  ] == HeptaReadableTokenSource::SCHEMA
  raise "WorkGraph readable canonical SHA drifted" unless registry[
    "canonical_schema_sha256"
  ] == Digest::SHA256.file(
    File.join(BUNDLE_ROOT, HeptaReadableTokenSource::SCHEMA_FILE)
  ).hexdigest
  raise "WorkGraph canonical template SHA drifted" unless registry[
    "canonical_templates_sha256"
  ] == canonical.fetch("templates_sha256")
  raise "WorkGraph canonical parameter SHA drifted" unless registry[
    "canonical_parameters_sha256"
  ] == canonical.fetch("parameters_sha256")
  raise "WorkGraph canonical record size drifted" unless registry[
    "canonical_max_record_bytes"
  ] == canonical.fetch("canonical_max_record_bytes")
  raise "WorkGraph canonical record-size budget exceeded" unless registry[
    "canonical_max_record_bytes"
  ].between?(1, MAX_CANONICAL_RECORD_BYTES)
  raise "WorkGraph canonical record-size limit drifted" unless registry[
    "canonical_max_record_byte_limit"
  ] == MAX_CANONICAL_RECORD_BYTES
  raise "WorkGraph canonical record byte semantics drifted" unless registry[
    "canonical_record_byte_semantics"
  ] == "record_including_lf"
  raise "WorkGraph gzip profile drifted" unless registry["gzip_mtime"] ==
    HeptaReadableTokenSource::FIXED_GZIP_MTIME &&
    registry["gzip_os"] == HeptaReadableTokenSource::FIXED_GZIP_OS
  source = File.binread(LIB_SOURCE)
  raise "WorkGraph bundle include count drifted" unless source.scan(INCLUDE_PATTERN).length == 1
  raise "materialized WorkGraph declarations remain" unless source_declarations.empty?
  entries.each do |entry|
    raise "materialized WorkGraph source remains: #{entry.name}" if File.exist?(source_path(entry.name))
  end
  raise "legacy WorkGraph bundle remains active" if File.exist?(LEGACY_BUNDLE_ROOT)
  puts "hepta-workgraph-module-bundle: PASS: #{entries.length} modules, #{registry.fetch("normalized_template_count")} templates, #{registry.fetch("normalized_effective_lines")} normalized lines"
end

def unpack
  entries = normalized_entries
  rewrite_lib_to_sources(entries)
  entries.each do |entry|
    atomic_write(source_path(entry.name), entry.source, 0o644)
  end
  puts "hepta-workgraph-module-bundle: unpacked #{entries.length} modules"
end

case ARGV
when ["pack"] then pack
when ["verify"] then verify
when ["unpack"] then unpack
else
  if ARGV.length == 2 && ARGV.first == "contains"
    exit(normalized_entries.any? { |entry| entry.name == ARGV.last } ? 0 : 1)
  end
  usage
end
