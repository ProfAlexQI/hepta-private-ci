#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "zlib"

ROOT = File.expand_path("..", __dir__)
RUNTIME_ROOT = File.join(ROOT, "codex-rs/hepta-runtime")
SOURCE_ROOT = File.join(RUNTIME_ROOT, "src")
LIB_SOURCE = File.join(SOURCE_ROOT, "lib.rs")
BUNDLE_ROOT = File.join(RUNTIME_ROOT, "codegen/workgraph-v2")
BUNDLE_PATH = File.join(BUNDLE_ROOT, "modules.bundle.gz")
REGISTRY_PATH = File.join(BUNDLE_ROOT, "registry.json")
SCHEMA = "hepta_workgraph_module_bundle_v2"
MAGIC = "#{SCHEMA}\0".b
MODULE_PATTERN = /^mod ((?:wg_|work_graph_)[a-z0-9_]+);$/
INCLUDE_LINE = <<~RUST
  include!(concat!(
      env!("OUT_DIR"),
      "/hepta_workgraph_bundle/modules.rs"
  ));
RUST
INCLUDE_PATTERN =
  /include!\(\s*concat!\(\s*env!\("OUT_DIR"\),\s*"\/hepta_workgraph_bundle\/modules\.rs"\s*\)\s*\);\n/m
EXPECTED_MODULE_COUNT = 711

def usage
  warn "usage: scripts/hepta-workgraph-module-bundle [pack|verify|unpack|contains MODULE]"
  exit 2
end

def atomic_write(path, content, mode = nil)
  FileUtils.mkdir_p(File.dirname(path))
  staging = File.join(
    File.dirname(path),
    ".hepta-workgraph-bundle-#{Digest::SHA256.hexdigest(path)[0, 12]}-#{$$}.tmp"
  )
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end

def source_declarations
  File.readlines(LIB_SOURCE, chomp: false).each_with_object([]) do |line, declarations|
    match = MODULE_PATTERN.match(line.chomp)
    declarations << match[1] if match
  end
end

def packed?
  File.file?(BUNDLE_PATH) && File.file?(REGISTRY_PATH) &&
    File.binread(LIB_SOURCE).match?(INCLUDE_PATTERN)
end

def source_path(module_name)
  File.join(SOURCE_ROOT, "#{module_name}.rs")
end

def encode_bundle(entries)
  payload = MAGIC.dup
  payload << [entries.length].pack("N")
  entries.each do |module_name, source|
    name = module_name.b
    body = source.b
    payload << [name.bytesize, body.bytesize].pack("NN")
    payload << name
    payload << Digest::SHA256.digest(body)
    payload << body
  end
  payload
end

def decode_bundle
  payload = Zlib::GzipReader.open(BUNDLE_PATH, &:read).b
  cursor = 0
  magic = payload.byteslice(cursor, MAGIC.bytesize)
  raise "invalid WorkGraph bundle magic" unless magic == MAGIC
  cursor += MAGIC.bytesize
  count = payload.byteslice(cursor, 4)&.unpack1("N")
  raise "missing WorkGraph bundle count" unless count
  cursor += 4
  entries = []
  count.times do
    lengths = payload.byteslice(cursor, 8)&.unpack("NN")
    raise "truncated WorkGraph bundle lengths" unless lengths&.length == 2
    cursor += 8
    name_length, source_length = lengths
    name = payload.byteslice(cursor, name_length)
    raise "truncated WorkGraph module name" unless name&.bytesize == name_length
    cursor += name_length
    expected_sha = payload.byteslice(cursor, 32)
    raise "truncated WorkGraph module digest" unless expected_sha&.bytesize == 32
    cursor += 32
    source = payload.byteslice(cursor, source_length)
    raise "truncated WorkGraph module source" unless source&.bytesize == source_length
    cursor += source_length
    raise "invalid WorkGraph module name" unless name.match?(/\A(?:wg_|work_graph_)[a-z0-9_]+\z/)
    raise "WorkGraph module SHA mismatch: #{name}" unless Digest::SHA256.digest(source) == expected_sha
    entries << [name.force_encoding(Encoding::UTF_8), source]
  end
  raise "trailing bytes in WorkGraph bundle" unless cursor == payload.bytesize
  entries
end

def aggregate_sha(entries)
  digest = Digest::SHA256.new
  entries.each do |module_name, source|
    digest << module_name << "\0" << Digest::SHA256.hexdigest(source) << "\n"
  end
  digest.hexdigest
end

def write_registry(entries)
  registry = {
    schema: SCHEMA,
    status: "packed",
    module_count: entries.length,
    source_bytes: entries.sum { |_module_name, source| source.bytesize },
    source_lines: entries.sum { |_module_name, source| source.lines.count },
    aggregate_source_sha256: aggregate_sha(entries),
    bundle_bytes: File.size(BUNDLE_PATH),
    bundle_sha256: Digest::SHA256.file(BUNDLE_PATH).hexdigest,
    source_files_materialized: false,
    build_time_module_generation: true,
    reversible_unpack: true
  }
  atomic_write(REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
end

def rewrite_lib_to_bundle(module_names)
  lines = File.readlines(LIB_SOURCE, chomp: false)
  declarations = lines.each_with_object([]) do |line, names|
    match = MODULE_PATTERN.match(line.chomp)
    names << match[1] if match
  end
  raise "WorkGraph declaration set drifted" unless declarations == module_names
  inserted = false
  rewritten = lines.each_with_object([]) do |line, output|
    if MODULE_PATTERN.match?(line.chomp)
      unless inserted
        output << INCLUDE_LINE
        inserted = true
      end
    else
      output << line
    end
  end
  raise "WorkGraph bundle include was not inserted" unless inserted
  atomic_write(LIB_SOURCE, rewritten.join, File.stat(LIB_SOURCE).mode & 0o777)
end

def rewrite_lib_to_sources(module_names)
  source = File.binread(LIB_SOURCE)
  raise "WorkGraph bundle include is missing" unless source.scan(INCLUDE_PATTERN).length == 1
  declarations = module_names.map { |module_name| "mod #{module_name};\n" }.join
  atomic_write(
    LIB_SOURCE,
    source.sub(INCLUDE_PATTERN, declarations),
    File.stat(LIB_SOURCE).mode & 0o777
  )
end

def pack
  if packed? && source_declarations.empty?
    verify
    return
  end
  module_names = source_declarations
  raise "unexpected WorkGraph module count: #{module_names.length}" unless module_names.length == EXPECTED_MODULE_COUNT
  raise "duplicate WorkGraph module declaration" unless module_names.uniq.length == module_names.length
  entries = module_names.map do |module_name|
    path = source_path(module_name)
    raise "missing WorkGraph source: #{path}" unless File.file?(path)
    [module_name, File.binread(path)]
  end
  FileUtils.mkdir_p(BUNDLE_ROOT)
  staging = File.join(BUNDLE_ROOT, ".modules.bundle.#{$$}.gz")
  Zlib::GzipWriter.open(staging, Zlib::BEST_COMPRESSION) do |writer|
    writer.mtime = 0
    writer.write(encode_bundle(entries))
  end
  File.rename(staging, BUNDLE_PATH)
  write_registry(entries)
  rewrite_lib_to_bundle(module_names)
  entries.each { |module_name, _source| FileUtils.rm_f(source_path(module_name)) }
  verify
end

def verify
  raise "missing WorkGraph bundle inputs" unless File.file?(BUNDLE_PATH) && File.file?(REGISTRY_PATH)
  entries = decode_bundle
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  raise "invalid WorkGraph bundle registry schema" unless registry["schema"] == SCHEMA
  raise "unexpected WorkGraph bundle module count" unless entries.length == EXPECTED_MODULE_COUNT
  raise "WorkGraph registry module count drifted" unless registry["module_count"] == entries.length
  raise "WorkGraph registry aggregate SHA drifted" unless registry["aggregate_source_sha256"] == aggregate_sha(entries)
  raise "WorkGraph bundle SHA drifted" unless registry["bundle_sha256"] == Digest::SHA256.file(BUNDLE_PATH).hexdigest
  raise "WorkGraph bundle byte count drifted" unless registry["bundle_bytes"] == File.size(BUNDLE_PATH)
  raise "WorkGraph source byte count drifted" unless registry["source_bytes"] == entries.sum { |_name, source| source.bytesize }
  raise "WorkGraph source line count drifted" unless registry["source_lines"] == entries.sum { |_name, source| source.lines.count }
  source = File.binread(LIB_SOURCE)
  raise "WorkGraph bundle include count drifted" unless source.scan(INCLUDE_PATTERN).length == 1
  raise "materialized WorkGraph declarations remain" unless source_declarations.empty?
  entries.each do |module_name, _source|
    raise "materialized WorkGraph source remains: #{module_name}" if File.exist?(source_path(module_name))
  end
  puts "hepta-workgraph-module-bundle: PASS: #{entries.length} modules, #{registry.fetch("source_lines")} source lines"
end

def unpack
  entries = decode_bundle
  rewrite_lib_to_sources(entries.map(&:first))
  entries.each do |module_name, source|
    atomic_write(source_path(module_name), source, 0o644)
  end
  puts "hepta-workgraph-module-bundle: unpacked #{entries.length} modules"
end

if ARGV == ["pack"]
  pack
elsif ARGV == ["verify"]
  verify
elsif ARGV == ["unpack"]
  unpack
elsif ARGV.length == 2 && ARGV.first == "contains"
  module_name = ARGV.fetch(1)
  exit(decode_bundle.any? { |candidate, _source| candidate == module_name } ? 0 : 1)
else
  usage
end
