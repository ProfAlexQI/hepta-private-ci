RECORD_REL = "docs/architecture/HEPTA_UPSTREAM_CODEX_R12_SEMANTIC_ABSORPTION_RECORD_2026-08-03.json"
R13_INTAKE_REL = "docs/architecture/HEPTA_UPSTREAM_CODEX_CURRENT_INTAKE_2026-08-03_R13.json"
R13_RECORD_REL = "docs/architecture/HEPTA_UPSTREAM_CODEX_R13_SEMANTIC_ABSORPTION_RECORD_2026-08-03.json"
REGISTRY_REL = "docs/architecture/HEPTA_UPSTREAM_CODEX_SEMANTIC_ABSORPTION_REGISTRY_V1.json"
CONTRACT_REL = ".github/hepta-ci-contract-v1.json"

RANGE_START = "61a44880a85d2fd0d8770908dea5733495e571c8"
RANGE_END = "5157493c23713ac12034cf250ffb0a8ce0670277"
FROZEN_REF = "refs/remotes/upstream/hepta-intake-20260803-r12"
LOCAL_CLASSIFICATION_BASE = "1577a50e37c6332ab267dea9d838dab8b8c07536"
HISTORICAL_HOSTED_DEFAULT = "9c6715924b4ce273248d03107383defc171a9a58"
R13_END = "bb5054fe47abe73ecbbd454751066a28c89f4bb9"
R13_FROZEN_REF = "refs/remotes/upstream/hepta-intake-20260803-r13"


def run(*args: str) -> str:
    return subprocess.run(
        list(args), cwd=ROOT, check=True, text=True, stdout=subprocess.PIPE
    ).stdout


def git(*args: str) -> str:
    return run("git", *args)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, indent=2, sort_keys=False, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )


def is_commit(value: str) -> bool:
    return git("cat-file", "-t", value).strip() == "commit"


CATEGORY_ORDER = (
    "security_sandbox_network",
    "mcp_plugins_skills",
    "protocol_app_server",
    "code_mode_v8_build",
    "state_thread_persistence",
    "execution_tools_agents",
    "tui_product",
    "release_telemetry_other",
)


def categories_for(paths: list[str], title: str) -> list[str]:
    text = "\n".join(paths).lower() + "\n" + title.lower()
    matches: list[str] = []
    rules = {
        "security_sandbox_network": (
            "sandbox", "network", "permission", "approval", "oauth", "auth_",
            "/auth", "credential", "symlink", "policy", "windows-sandbox",
        ),
        "mcp_plugins_skills": (
            "/mcp", "mcp-", "core-plugins", "/plugin", "skills", "/ext/",
            "connector",
        ),
        "protocol_app_server": (
            "app-server", "/protocol", "codex-api", "backend-client",
            "websocket-client", "realtime",
        ),
        "code_mode_v8_build": (
            "code-mode", "rusty_v8", "third_party/v8", "v8_", "module.bazel",
            "build.bazel", ".github/workflows", "cargo.lock", "cargo.toml",
        ),
        "state_thread_persistence": (
            "thread-store", "/state/", "/rollout", "external-agent-migration",
            "/memories", "sqlite", "history", "migration",
        ),
        "execution_tools_agents": (
            "/exec", "/tools", "/agent", "cloud-tasks", "environment",
            "collaboration", "apply_patch",
        ),
        "tui_product": ("codex-rs/tui", "ratatui", "crossterm", "onboarding"),
        "release_telemetry_other": (
            "/otel", "/analytics", "/feedback", "/login", "/models-manager",
            "release", "docs/", "readme", "scripts/",
        ),
    }
    for category in CATEGORY_ORDER:
        if any(token in text for token in rules[category]):
            matches.append(category)
    return matches or ["release_telemetry_other"]


def priority_for(category: str, title: str) -> str:
    lowered = title.lower()
    if category == "security_sandbox_network" or any(
        token in lowered for token in ("deny", "permission", "corrupt", "malformed")
    ):
        return "P0"
    if category in {
        "mcp_plugins_skills",
        "protocol_app_server",
        "state_thread_persistence",
        "execution_tools_agents",
    }:
        return "P1"
    if category == "code_mode_v8_build":
        return "P1"
    if category == "tui_product":
        return "P3"
    return "P2"


def net_stats(commit: str) -> tuple[int, int, int]:
    insertions = 0
    deletions = 0
    binaries = 0
    for line in git("diff-tree", "--no-commit-id", "--numstat", "-r", commit).splitlines():
        added, removed, _path = line.split("\t", 2)
        if added == "-" or removed == "-":
            binaries += 1
            continue
        insertions += int(added)
        deletions += int(removed)
    return insertions, deletions, binaries


def range_net_stats() -> tuple[int, int, int]:
    insertions = 0
    deletions = 0
    binaries = 0
    for line in git("diff", "--numstat", f"{RANGE_START}..{RANGE_END}").splitlines():
        added, removed, _path = line.split("\t", 2)
        if added == "-" or removed == "-":
            binaries += 1
            continue
        insertions += int(added)
        deletions += int(removed)
    return insertions, deletions, binaries


Absorption = dict[str, Any]


def absorption(
    local_commit: str,
    scope: str,
    semantic_mapping: str,
    files: list[str],
    evidence_source: str,
    *,
    partial: bool = False,
) -> Absorption:
    return {
        "local_commit": local_commit,
        "scope": scope,
        "semantic_mapping": semantic_mapping,
        "files": files,
        "evidence_source": evidence_source,
        "partial": partial,
    }


