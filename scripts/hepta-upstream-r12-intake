def special_deferral(commit: str, category: str) -> dict[str, Any] | None:
    if commit == "97576b1794872e342450ebd577123e052ab57626":
        return {
            "scope": "standalone_code_mode_host_and_v8_runtime_separation",
            "reason": (
                "This is the actual in-range structural fix that removes V8 from the codex-code-mode "
                "crate by moving it to a standalone host/runtime.  Hepta still embeds V8 directly in "
                "codex-code-mode and has no code-mode-host, code-mode-protocol, or code-mode-runtime "
                "crates.  A three-way applicability audit found missing files plus conflicts across "
                "Cargo, core, features, config, install-context, and the local code-mode API; claiming "
                "absorption would be false.  This remains the preferred closure for the Windows "
                "allocator_shim/UCRT collision rather than linker exclusions or test filtering."
            ),
            "missing_prerequisites": [
                "versioned standalone host protocol preserving nested tool identity",
                "move the current Hepta V8 runtime behind a separate host without changing permission authority",
                "immutable install-context host discovery and packaged binary digest binding",
                "code-mode-only and disabled-fallback fail-closed parity",
                "Windows MSVC proof that code-mode-unit-tests no longer link V8 plus terminal host/runtime evidence",
            ],
            "priority_override": "P0",
            "non_claim": "No allocator symbol exclusion, CRT heap mixing, test skip, or disabled code-mode claim is accepted as semantic absorption.",
        }
    return None


def build_inventory() -> list[dict[str, Any]]:
    commits = git("rev-list", "--reverse", f"{RANGE_START}..{RANGE_END}").splitlines()
    if len(commits) != 206:
        raise SystemExit(f"R12 range count drifted: expected 206, found {len(commits)}")
    inventory: list[dict[str, Any]] = []
    previous = RANGE_START
    for commit in commits:
        parents = git("show", "-s", "--format=%P", commit).strip().split()
        if parents != [previous]:
            raise SystemExit(f"R12 history is not a single-parent linear chain at {commit}: {parents}")
        paths = git("diff-tree", "--no-commit-id", "--name-only", "-r", "-M", commit).splitlines()
        title = git("show", "-s", "--format=%s", commit).rstrip("\n")
        touched = categories_for(paths, title)
        primary = touched[0]
        special = special_deferral(commit, primary)
        status = "deferred"
        if commit in ABSORPTIONS:
            status = "partially_absorbed_with_explicit_deferral" if ABSORPTIONS[commit]["partial"] else "absorbed"
        insertions, deletions, binary_files = net_stats(commit)
        entry: dict[str, Any] = {
            "upstream_commit": commit,
            "parent_commit": previous,
            "authored_at": git("show", "-s", "--format=%aI", commit).strip(),
            "title": title,
            "primary_category": primary,
            "touched_categories": touched,
            "hepta_v2_priority": special.get("priority_override") if special else priority_for(primary, title),
            "status": status,
            "changed_file_count": len(paths),
            "insertions": insertions,
            "deletions": deletions,
            "binary_file_touch_count": binary_files,
            "changed_files": paths,
            "source_imported": False,
            "merge_performed": False,
            "rebase_performed": False,
            "cherry_pick_performed": False,
        }
        if commit in ABSORPTIONS:
            entry["absorption_scope"] = ABSORPTIONS[commit]["scope"]
        if status != "absorbed":
            detail = PARTIAL_DEFERRALS.get(commit) or special
            if detail:
                entry["deferral_scope"] = detail["scope"]
                entry["deferral_reason"] = detail["reason"]
                entry["missing_prerequisites"] = detail["missing_prerequisites"]
            else:
                reason, prerequisites = DEFAULT_DEFERRALS[primary]
                entry["deferral_scope"] = f"r12_{primary}_{commit[:12]}"
                entry["deferral_reason"] = reason
                entry["missing_prerequisites"] = prerequisites
        inventory.append(entry)
        previous = commit
    if previous != RANGE_END:
        raise SystemExit("R12 range does not end at the frozen upstream head")
    return inventory


def generate() -> None:
    for commit in (
        RANGE_START,
        RANGE_END,
        R13_END,
        LOCAL_CLASSIFICATION_BASE,
        HISTORICAL_HOSTED_DEFAULT,
    ):
        if not is_commit(commit):
            raise SystemExit(f"required commit object is unavailable: {commit}")
    frozen = git("rev-parse", "--verify", FROZEN_REF).strip()
    if frozen != RANGE_END:
        raise SystemExit(f"R12 frozen ref mismatch: expected {RANGE_END}, found {frozen}")
    r13_frozen = git("rev-parse", "--verify", R13_FROZEN_REF).strip()
    if r13_frozen != R13_END:
        raise SystemExit(f"R13 frozen ref mismatch: expected {R13_END}, found {r13_frozen}")

    inventory = build_inventory()
    by_category: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for entry in inventory:
        by_category[entry["primary_category"]].append(entry)

    shard_descriptors: list[dict[str, Any]] = []
    for category in CATEGORY_ORDER:
        entries = by_category.get(category, [])
        if not entries:
            continue
        shard_rel = f"docs/architecture/upstream-r12/HEPTA_UPSTREAM_CODEX_R12_INVENTORY_{category.upper()}_2026-08-03.json"
        shard_path = ROOT / shard_rel
        write_json(
            shard_path,
            {
                "schema_version": "hepta_upstream_codex_r12_inventory_shard_v1",
                "category": category,
                "range_start_exclusive": RANGE_START,
                "range_end_inclusive": RANGE_END,
                "commit_count": len(entries),
                "commit_inventory": entries,
            },
        )
        shard_descriptors.append(
            {"category": category, "path": shard_rel, "sha256": sha256_file(shard_path), "commit_count": len(entries)}
        )

    range_lines = ("\n".join(entry["upstream_commit"] for entry in inventory) + "\n").encode()
    range_digest = sha256_bytes(range_lines)
    file_surface = git("diff", "--name-status", f"{RANGE_START}..{RANGE_END}").splitlines()
    sorted_surface = ("\n".join(sorted(file_surface)) + "\n").encode()
    normalized_inventory = json.dumps(inventory, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    net_insertions, net_deletions, net_binary_files = range_net_stats()
    status_counts = Counter(entry["status"] for entry in inventory)
    category_counts = Counter(entry["primary_category"] for entry in inventory)
    priority_counts = Counter(entry["hepta_v2_priority"] for entry in inventory)
    unresolved = [entry["upstream_commit"] for entry in inventory if entry["status"] != "absorbed"]

    intake = {
        "schema_version": "hepta_upstream_codex_current_intake_v12",
        "intake_id": "upstream-codex-intake-2026-08-03-r12",
        "predecessor_intake": {
            "path": "docs/architecture/HEPTA_UPSTREAM_CODEX_CURRENT_INTAKE_2026-07-26_R11.json",
            "sha256": sha256_file(ROOT / "docs/architecture/HEPTA_UPSTREAM_CODEX_CURRENT_INTAKE_2026-07-26_R11.json"),
            "cutoff_head": RANGE_START,
            "preserved": True,
            "modified_by_r12": False,
        },
        "observation": {
            "state": "observed_classified_and_exhaustively_dispositioned",
            "observed_at": "2026-08-03T00:00:00Z",
            "upstream_repository": "https://github.com/openai/codex.git",
            "target_branch": "main",
            "target_ref": "refs/remotes/upstream/main",
            "observed_upstream_head": RANGE_END,
            "range_start_exclusive": RANGE_START,
            "range_end_inclusive": RANGE_END,
            "commit_count": len(inventory),
            "merge_commit_count": 0,
            "net_changed_file_count": len(file_surface),
            "net_insertions": net_insertions,
            "net_deletions": net_deletions,
            "net_binary_file_count": net_binary_files,
            "commit_file_touches": sum(entry["changed_file_count"] for entry in inventory),
            "predecessor_relationship": "linear_ancestor",
            "ordinary_merge_allowed": False,
            "ordinary_rebase_allowed": False,
            "direct_cherry_pick_default": False,
            "required_integration_mode": "selective_semantic_transplant_with_behavioral_evidence",
            "fetch_command": f"git fetch --no-tags upstream {RANGE_END}:{FROZEN_REF}",
            "range_identity": {"algorithm": "sha256(git_rev_list_reverse_range_lf)", "digest": range_digest},
            "file_surface_identity": {"algorithm": "sha256(c_locale_sorted_name_status_lf)", "digest": sha256_bytes(sorted_surface)},
            "normalized_inventory_identity": {"algorithm": "sha256(canonical_json_inventory)", "digest": sha256_bytes(normalized_inventory)},
        },
        "storage_layout": {
            "inventory_shards": shard_descriptors,
            "shard_commit_count": sum(shard["commit_count"] for shard in shard_descriptors),
        },
        "classification_summary": {
            "commit_count": len(inventory),
            "status_counts": dict(sorted(status_counts.items())),
            "priority_counts": dict(sorted(priority_counts.items())),
            "category_counts": {category: category_counts.get(category, 0) for category in CATEGORY_ORDER},
            "absorbed_commit_count": sum(entry["status"] == "absorbed" for entry in inventory),
            "partially_absorbed_commit_count": sum(entry["status"].startswith("partially_") for entry in inventory),
            "deferred_only_commit_count": sum(entry["status"] == "deferred" for entry in inventory),
            "unresolved_commit_count": len(unresolved),
            "unresolved_commits": unresolved,
        },
        "coverage_contract": {
            "schema_version": "hepta_upstream_codex_complete_range_coverage_v1",
            "every_range_commit_in_inventory": True,
            "every_inventory_commit_has_disposition": True,
            "absorbed_status_requires_absorption_only": True,
            "partial_status_requires_absorption_and_deferral": True,
            "deferred_status_requires_deferral_only": True,
            "exact_range_commit_count": 206,
            "allow_unclassified_commit": False,
            "allow_implicit_deferral": False,
        },
        "range_exclusions": [
            {
                "commit": HISTORICAL_HOSTED_DEFAULT,
                "relationship": "ancestor_of_r12_range_start",
                "title": git("show", "-s", "--format=%s", HISTORICAL_HOSTED_DEFAULT).strip(),
                "counted_in_r12": False,
                "semantic_note": "This historical commit made hosted mode the default but did not remove V8 from codex-code-mode; the in-range structural split is 97576b1794872e342450ebd577123e052ab57626.",
            }
        ],
        "claims": {
            "upstream_fully_consumed": False,
            "source_imported_at_observation": False,
            "merge_performed": False,
            "rebase_performed": False,
            "cherry_pick_performed": False,
            "deployment_performed": False,
            "live_enablement_performed": False,
        },
    }
    intake_path = ROOT / INTAKE_REL
    write_json(intake_path, intake)

    absorptions: list[dict[str, Any]] = []
    deferrals: list[dict[str, Any]] = []
    by_commit = {entry["upstream_commit"]: entry for entry in inventory}
    for commit in (entry["upstream_commit"] for entry in inventory):
        entry = by_commit[commit]
        if commit in ABSORPTIONS:
            spec = ABSORPTIONS[commit]
            absorptions.append(
                {
                    "upstream_commit": commit,
                    "upstream_title": entry["title"],
                    "disposition": "semantic_transplant",
                    "scope": spec["scope"],
                    "hepta_commit": spec["local_commit"],
                    "semantic_mapping": spec["semantic_mapping"],
                    "core_files": spec["files"],
                    "regression_coverage": [spec["evidence_source"]],
                    "non_claims": [
                        "This bounded mapping does not claim byte-for-byte source identity, whole-tree import, or full upstream parity."
                    ],
                }
            )
        if entry["status"] != "absorbed":
            detail = PARTIAL_DEFERRALS.get(commit) or special_deferral(commit, entry["primary_category"])
            if detail:
                scope = detail["scope"]
                reason = detail["reason"]
                prerequisites = detail["missing_prerequisites"]
                non_claim = detail.get("non_claim", "No local behavior is claimed equivalent for this deferred scope.")
            else:
                reason, prerequisites = DEFAULT_DEFERRALS[entry["primary_category"]]
                scope = entry["deferral_scope"]
                non_claim = "No local behavior is claimed equivalent for this deferred scope."
            deferrals.append(
                {
                    "upstream_commit": commit,
                    "upstream_title": entry["title"],
                    "disposition": f"deferred_{scope}",
                    "scope": scope,
                    "reason": reason,
                    "missing_prerequisites": prerequisites,
                    "tests_run": False,
                    "hepta_commit": None,
                    "non_claims": [non_claim],
                }
            )

    record = {
        "schema_version": "hepta_upstream_codex_semantic_absorption_record_v1",
        "record_id": "r12",
        "source_intake": {
            "path": INTAKE_REL,
            "manifest_sha256": sha256_file(intake_path),
            "commit": LOCAL_CLASSIFICATION_BASE,
            "commit_role": "local_semantic_classification_base",
            "source_manifest_introducing_commit": None,
            "source_manifest_introducing_commit_binding_pending": True,
            "range_start_exclusive": RANGE_START,
            "range_end_inclusive": RANGE_END,
            "ordinary_merge_performed": False,
            "ordinary_rebase_performed": False,
            "cherry_pick_performed": False,
        },
        "coverage_contract": {
            "range_commit_count": len(inventory),
            "dispositioned_unique_commit_count": len({item["upstream_commit"] for item in absorptions + deferrals}),
            "absorption_entry_count": len(absorptions),
            "deferral_entry_count": len(deferrals),
            "unresolved_unique_commit_count": len({item["upstream_commit"] for item in deferrals}),
            "complete_range_coverage": True,
        },
        "absorptions": absorptions,
        "deferrals": deferrals,
        "claims": {
            "absorbed_commit_count": len(absorptions),
            "existing_semantic_equivalent_count": 0,
            "deferred_commit_count": len(deferrals),
            "upstream_fully_consumed": False,
            "merge_performed": False,
            "rebase_performed": False,
            "cherry_pick_performed": False,
            "live_enablement": False,
            "deployment": False,
            "publication": False,
        },
    }
    record_path = ROOT / RECORD_REL
    write_json(record_path, record)

    r13_commit = R13_END
    r13_title = git("show", "-s", "--format=%s", r13_commit).strip()
    r13_paths = git("diff-tree", "--no-commit-id", "--name-only", "-r", "-M", r13_commit).splitlines()
    r13_insertions, r13_deletions, r13_binary_files = net_stats(r13_commit)
    r13_entry = {
        "upstream_commit": r13_commit,
        "parent_commit": RANGE_END,
        "authored_at": git("show", "-s", "--format=%aI", r13_commit).strip(),
        "title": r13_title,
        "primary_category": "state_thread_persistence",
        "touched_categories": categories_for(r13_paths, r13_title),
        "hepta_v2_priority": "P1",
        "status": "deferred",
        "changed_file_count": len(r13_paths),
        "insertions": r13_insertions,
        "deletions": r13_deletions,
        "binary_file_touch_count": r13_binary_files,
        "changed_files": r13_paths,
        "deferral_scope": "provider_rollout_budget_units_private_usage_propagation",
        "deferral_reason": (
            "The provider-only rollout budget unit must be parsed from Responses SSE usage and "
            "propagated through TokenUsage, session, goal, memory, state, and app-server consumers "
            "while remaining absent from serialized protocol, JSON Schema, and TypeScript.  The "
            "R12 classification base has no such field or end-to-end regression, so equivalence is "
            "not claimed."
        ),
        "missing_prerequisites": [
            "private non-serialized TokenUsage field with serde, schemars, and TypeScript exclusion",
            "Responses SSE unit and end-to-end fractional-number parsing evidence",
            "all local TokenUsage constructors and accounting consumers updated without exposing provider metadata",
        ],
        "source_imported": False,
        "merge_performed": False,
        "rebase_performed": False,
        "cherry_pick_performed": False,
    }
    r13_range_digest = sha256_bytes((r13_commit + "\n").encode())
    r13_surface = git("diff", "--name-status", f"{RANGE_END}..{R13_END}").splitlines()
    r13_surface_digest = sha256_bytes(("\n".join(sorted(r13_surface)) + "\n").encode())
    r13_inventory_digest = sha256_bytes(
        json.dumps([r13_entry], sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    )
    r13_intake = {
        "schema_version": "hepta_upstream_codex_current_intake_v13",
        "intake_id": "upstream-codex-intake-2026-08-03-r13",
        "predecessor_intake": {
            "path": INTAKE_REL,
            "sha256": sha256_file(intake_path),
            "cutoff_head": RANGE_END,
            "preserved": True,
            "modified_by_r13": False,
        },
        "observation": {
            "state": "observed_classified_and_exhaustively_dispositioned",
            "observed_at": "2026-08-03T00:30:00Z",
            "upstream_repository": "https://github.com/openai/codex.git",
            "target_branch": "main",
            "target_ref": "refs/remotes/upstream/main",
            "observed_upstream_head": R13_END,
            "range_start_exclusive": RANGE_END,
            "range_end_inclusive": R13_END,
            "commit_count": 1,
            "merge_commit_count": 0,
            "net_changed_file_count": len(r13_surface),
            "net_insertions": r13_insertions,
            "net_deletions": r13_deletions,
