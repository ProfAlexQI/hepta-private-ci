    registry = json.loads(registry_path.read_text(encoding="utf-8"))
    registry["records"] = [item for item in registry["records"] if item.get("id") not in {"r12", "r13"}]
    bindings: list[dict[str, Any]] = []
    for item in absorptions:
        bindings.append(
