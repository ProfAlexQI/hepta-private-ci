    contract_path = ROOT / CONTRACT_REL
    contract = json.loads(contract_path.read_text(encoding="utf-8"))
    refs = [
        item
        for item in contract["upstream_intake"]["refs"]
        if item.get("role") not in {"current_r12", "current_r13"}
    ]
    refs.append({"role": "current_r12", "ref": FROZEN_REF, "sha": RANGE_END})
    refs.append({"role": "current_r13", "ref": R13_FROZEN_REF, "sha": R13_END})
    contract["upstream_intake"]["refs"] = refs
    contract["upstream_truth"]["registry_sha256"] = sha256_file(registry_path)
