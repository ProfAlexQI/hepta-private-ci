               AND operation_id = ? AND operation_binding_sha256 = ?
               AND operation_sequence = ?",
        )""",
    "mark submitted operation where",
)

# This bind sequence is unique to the uncertainty UPDATE inside mark_submitted.
store = replace_once(
    store,
    '        .bind(&lease.client_user_message_id)\n'
