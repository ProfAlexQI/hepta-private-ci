onQueueReceipt,\n'
    '        submitted_at_ms: u64,\n'
    '    ) -> Result<AutomationTask, AutomationError> {\n'
    '        if lease.task.owner_agent_id != self.owner_agent_id\n'
    '            || receipt.client_user_message_id != lease.client_user_message_id\n'
    '            || receipt.queued_submission_id.is_empty()\n'
    '        {\n'
