#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SPEC_FILE="$ROOT/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-specs-v1.json"

usage() {
  echo "usage: scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-runner <id|--validate>" >&2
  exit 2
}

sha256_text() {
  printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
}

validate_registry() {
  jq -e '
    .schema_version == "hepta_artifact_download_install_affordance_result_receipt_route_gate_specs_v1"
    and .executor == "scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-runner"
    and .receipt_state_machine == ["precondition", "denial", "receipt", "persistence", "retention", "terminal"]
    and (.specs | length) == 3
    and ((.specs | map(.id) | unique | length) == 3)
    and (.specs | all(
      (.id | test("^[a-z0-9-]+$"))
      and .gate_spec.method == "GET"
      and .gate_spec.pattern == ("/api/" + .id)
      and .gate_spec.source_command == ("/" + .id + " --json")
      and .gate_spec.capability == .id
      and .gate_spec.receipt_state == "terminal"
      and (.gate_spec.side_effect_boundary | contains("read-only"))
      and (.wrapper | test("^scripts/[a-z0-9-]+-route-gate\\.sh$"))
      and (.source.mode | IN("file", "report"))
      and (.source.path | test("^scripts/[a-z0-9-]+(-gate-specs-v1\\.json|-gate\\.sh)$"))
      and (.source.hash_field | endswith("sha256"))
      and (.source.requirements | type == "array")
      and (.native_requirements | type == "array" and length >= 7)
      and (.focused_test | test("^[a-z0-9_]+$"))
      and (.test_log_stem | test("^[a-z0-9-]+$"))
      and (.live_validation.true_fields | type == "array")
      and (.live_validation.false_fields | type == "array")
      and (.live_validation.zero_fields | type == "array")
      and (.live_validation.number_fields | type == "object")
      and (.live_validation.array_lengths | type == "object")
      and (.report_fields | type == "object")
      and (.report_fields.side_effects as $side_effects
        | ($side_effects | type) == "object"
          and ($side_effects | to_entries | all(.value == false)))
      and (.baseline_normalized_output_sha256 | test("^[0-9a-f]{64}$"))
      and (.pass_message | length > 0)
    ))
  ' "$SPEC_FILE" >/dev/null
}

[[ -f "$SPEC_FILE" ]] || {
  echo "missing artifact download/install affordance result-receipt route registry: $SPEC_FILE" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}

[[ $# == 1 ]] || usage
if [[ "$1" == "--validate" ]]; then
  validate_registry
  echo '{"schema":"hepta_artifact_download_install_affordance_result_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
  exit 0
fi

id="$1"
[[ "$id" =~ ^[a-z0-9-]+$ ]] || usage
validate_registry
spec="$(jq -cer --arg id "$id" '.specs[] | select(.id == $id)' "$SPEC_FILE")" || {
  echo "unknown artifact download/install affordance result-receipt route spec id: $id" >&2
  exit 1
}

BASE_URL="${HEPTA_LIVE_URL:-http://127.0.0.1:7373}"
MANIFEST="${HEPTA_MANIFEST:-codex-rs/Cargo.toml}"
REQUIRE_LIVE_ENDPOINT="${HEPTA_ROUTE_GATE_REQUIRE_LIVE_ENDPOINT:-0}"
EXPECTED_ROUTE_COUNT="${HEPTA_EXPECTED_ROUTE_COUNT:-$(HEPTA_REPO_ROOT="$ROOT" bash "$ROOT/scripts/lib/hepta-native-route-count.sh")}"
NATIVE_GATEWAY_SOURCE="hepta-native-gateway-source-set-v1"

cd "$ROOT"
source scripts/lib/hepta-json-report-capture.sh
source scripts/lib/hepta-source-set.sh

source_spec="$(jq -c '.source' <<<"$spec")"
source_path="$(jq -r '.path' <<<"$source_spec")"
source_mode="$(jq -r '.mode' <<<"$source_spec")"
if [[ "$source_mode" == "file" ]]; then
  while IFS= read -r needle; do
    require_source_text "$source_path" "$needle" "$id source invariant"
  done < <(jq -r '.requirements[]' <<<"$source_spec")
  source_hash="$(sha256_file "$source_path")"
else
  min_samples="${HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES:-24}"
  [[ "$min_samples" =~ ^[0-9]+$ && "$min_samples" -ge 24 ]] || {
    echo "HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES must be an unsigned integer of at least 24" >&2
    exit 2
  }
  source_json="$(
    capture_json_report "$(jq -r '.capture_label' <<<"$source_spec")" \
      env HEPTA_LIVE_URL="$BASE_URL" HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES="$min_samples" \
      HEPTA_TERMINAL_SOAK_INTERVAL_SECONDS="${HEPTA_TERMINAL_SOAK_INTERVAL_SECONDS:-0}" \
      HEPTA_LONG_SOAK_OBSERVATION_INTERVAL_SECONDS="${HEPTA_LONG_SOAK_OBSERVATION_INTERVAL_SECONDS:-0}" \
      HEPTA_LONG_SOAK_FRESHNESS_OBSERVATION_INTERVAL_SECONDS="${HEPTA_LONG_SOAK_FRESHNESS_OBSERVATION_INTERVAL_SECONDS:-0}" \
      "$source_path"
  )"
  jq -e --argjson source_spec "$source_spec" '
    . as $source
    | .runtime == "hepta"
      and .status == "ready"
      and .gate == $source_spec.expected_gate
      and .[$source_spec.ready_field] == true
      and (.side_effects | type) == "object"
      and (.side_effects | to_entries | all(.value == false))
  ' >/dev/null <<<"$source_json"
  source_hash="$(sha256_text "$source_json")"
fi

while IFS= read -r requirement; do
  require_source_text \
    "$(jq -r '.file' <<<"$requirement")" \
    "$(jq -r '.text' <<<"$requirement")" \
    "$id native route invariant"
done < <(jq -c '.native_requirements[]' <<<"$spec")

TEST_LOG="$(mktemp "/tmp/$(jq -r '.test_log_stem' <<<"$spec").XXXXXX")"
cargo test --offline --manifest-path "$MANIFEST" -q -p hepta-native-gateway --lib \
  "$(jq -r '.focused_test' <<<"$spec")" -- --nocapture >"$TEST_LOG"

live_json='{}'
if [[ "$REQUIRE_LIVE_ENDPOINT" == "1" ]]; then
  live_json="$(curl -fsS "$BASE_URL$(jq -r '.gate_spec.pattern' <<<"$spec")")"
  validation="$(jq -c '.live_validation' <<<"$spec")"
  jq -e --argjson expected "$EXPECTED_ROUTE_COUNT" --argjson validation "$validation" '
    . as $actual
    | .status == "ready"
      and .route_count == $expected
      and .implemented_route_count == $expected
      and .missing_route_count == 0
      and .route_count_source_command_accepted == true
      and ($validation.true_fields | all(. as $key | $actual[$key] == true))
      and ($validation.false_fields | all(. as $key | $actual[$key] == false))
      and ($validation.zero_fields | all(. as $key | $actual[$key] == 0))
      and ($validation.number_fields | to_entries | all(. as $item | $actual[$item.key] == $item.value))
      and ($validation.array_lengths | to_entries | all(. as $item | ($actual[$item.key] | length) == $item.value))
      and (.side_effects | type) == "object"
      and (.side_effects | to_entries | all(.value == false))
  ' >/dev/null <<<"$live_json"
fi

terminal_json="$(capture_json_report "hepta-preflight-terminal-coverage-inventory-gate" scripts/hepta-preflight-terminal-coverage-inventory-gate.sh)"
jq -e '
  .status == "ready"
  and .preflight_terminal_coverage_inventory_ready == true
  and .required_marker_count == .present_required_marker_count
  and .missing_required_marker_count == 0
  and .duplicate_required_marker_count == 0
  and .out_of_order_required_marker_count == 0
' >/dev/null <<<"$terminal_json"

live_route_status="$(jq -r '.status // "skipped"' <<<"$live_json")"
live_route_count="$(jq -r '.route_count // 0' <<<"$live_json")"
live_missing_route_count="$(jq -r '.missing_route_count // 0' <<<"$live_json")"
report="$(
  jq -n \
    --arg base_url "$BASE_URL" \
    --arg source_hash "$source_hash" \
    --arg native_gateway_sha256 "$(sha256_file "$NATIVE_GATEWAY_SOURCE")" \
    --arg focused_test_log "$TEST_LOG" \
    --arg terminal_coverage_sha256 "$(sha256_text "$terminal_json")" \
    --arg live_route_status "$live_route_status" \
    --argjson live_endpoint_checked "$([[ "$REQUIRE_LIVE_ENDPOINT" == "1" ]] && echo true || echo false)" \
    --argjson live_route_count "$live_route_count" \
    --argjson live_missing_route_count "$live_missing_route_count" \
    --argjson spec "$spec" '
    {
        product:"Hepta",
        runtime:"hepta",
        status:"ready",
        base_url:$base_url,
        gate:($spec.id | gsub("-"; "_") + "_route_gate"),
        endpoint:$spec.gate_spec.pattern,
        source_command:$spec.gate_spec.source_command
      }
      + $spec.report_fields
      | .[$spec.source.hash_field] = $source_hash
      | .native_gateway_sha256 = $native_gateway_sha256
      | .focused_test_log = $focused_test_log
      | .terminal_coverage_sha256 = $terminal_coverage_sha256
      | .live_endpoint_checked = $live_endpoint_checked
      | .live_route_status = $live_route_status
      | .live_route_count = $live_route_count
      | .live_missing_route_count = $live_missing_route_count
    '
)"

actual_output_sha="$(
  jq -S '
    del(
      .base_url,
      .focused_test_log,
      .live_endpoint_checked,
      .live_route_status,
      .live_route_count,
      .live_missing_route_count
    )
    | with_entries(select(.key | endswith("sha256") | not))
  ' <<<"$report" | shasum -a 256 | cut -d ' ' -f1
)"
expected_output_sha="$(jq -r '.baseline_normalized_output_sha256' <<<"$spec")"
[[ "$actual_output_sha" == "$expected_output_sha" ]] || {
  echo "artifact download/install affordance result-receipt route normalized output parity mismatch for $id: $actual_output_sha != $expected_output_sha" >&2
  exit 1
}

jq . <<<"$report"
jq -r '.pass_message' <<<"$spec" >&2
