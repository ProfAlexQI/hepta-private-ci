    apps/hepta-native/src/home/hepta_telegram_base_contract/tests/contract_part_*.rs
  verify_file_max codex-rs/hepta-core/src/upstream_codex_sync.rs 9700
  verify_file_max codex-rs/hepta-core/src/upstream_codex_sync/tests.rs 4000
  local report_root
  for report_root in \
