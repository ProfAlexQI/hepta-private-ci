#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

verify_file_max() {
  local file="$1"
  local max_lines="$2"
  local actual
  actual="$(wc -l <"$file" | tr -d '[:space:]')"
  if (( actual > max_lines )); then
    echo "architecture line budget exceeded: ${file} has ${actual}, max ${max_lines}" >&2
    return 1
  fi
}

verify_total_max() {
  local max_lines="$1"
  shift
  local total
  total="$(wc -l "$@" | awk '$2 != "total" { total += $1 } END { print total + 0 }')"
  if (( total > max_lines )); then
    echo "architecture aggregate line budget exceeded: ${total} > ${max_lines}: $*" >&2
    return 1
  fi
}

verify() {
  local direct_source_set_hash_consumer
  local source_set_consumer
  local stale_native_source_consumer

  source scripts/lib/hepta-source-set.sh

  verify_file_max codex-rs/hepta-native-gateway/src/native_gateway.rs 6000
  for file in codex-rs/hepta-native-gateway/src/native_gateway/*.rs; do
    verify_file_max "$file" 60000
  done
  verify_total_max 181000 \
    codex-rs/hepta-native-gateway/src/native_gateway.rs \
    codex-rs/hepta-native-gateway/src/native_gateway/*.rs

  verify_file_max codex-rs/hepta-runtime/src/lib.rs 1500
  for file in codex-rs/hepta-runtime/src/runtime_kernel/*.rs; do
    verify_file_max "$file" 6000
  done
  verify_total_max 33000 \
    codex-rs/hepta-runtime/src/lib.rs \
    codex-rs/hepta-runtime/src/runtime_kernel/*.rs

  verify_file_max codex-rs/hepta-runtime/src/query.rs 6000
  for file in codex-rs/hepta-runtime/src/query/*.rs; do
    verify_file_max "$file" 4000
  done
  verify_total_max 12500 \
    codex-rs/hepta-runtime/src/query.rs \
    codex-rs/hepta-runtime/src/query/*.rs

  [[ -x scripts/hepta-budgeted-test ]]
  rg -q 'HEPTA_JSON_REPORT_CAPTURE_MAX_ENTRIES:-2048' scripts/lib/hepta-json-report-capture.sh
  rg -q 'HEPTA_JSON_REPORT_CAPTURE_MAX_TOTAL_BYTES:-134217728' scripts/lib/hepta-json-report-capture.sh
  rg -q 'HEPTA_JSON_REPORT_CAPTURE_MAX_REPORT_BYTES:-2097152' scripts/lib/hepta-json-report-capture.sh
  [[ -x scripts/hepta-route-gate-runner ]]
  scripts/hepta-route-gate-runner --validate >/dev/null
  [[ "$(jq '.families[0].specs | length' scripts/hepta-route-gate-specs-v1.json)" == 3 ]]
  for route_gate_id in \
    hepta-first-model-invocation-operator-approval-final-authorization-dry-run-result-receipt-replay-idempotency-denial \
    hepta-first-model-invocation-operator-approval-final-authorization-dry-run-result-receipt-ordering-monotonicity-denial \
    hepta-first-model-invocation-operator-approval-final-authorization-dry-run-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${route_gate_id}-route-gate.sh" 5
    rg -Fq 'scripts/hepta-route-gate-runner' "scripts/${route_gate_id}-route-gate.sh"
  done
  [[ -x scripts/hepta-core-activation-chain-gate-runner ]]
  scripts/hepta-core-activation-chain-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-core-activation-chain-gate-specs-v1.json)" == 3 ]]
  for core_activation_gate_id in \
    hepta-core-activation-operator-approval-gap-ledger-summary-briefing-acknowledgement-activation-command-result-receipt-replay-idempotency-denial \
    hepta-core-activation-operator-approval-gap-ledger-summary-briefing-acknowledgement-activation-command-result-receipt-ordering-monotonicity-denial \
    hepta-core-activation-operator-approval-gap-ledger-summary-briefing-acknowledgement-activation-command-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${core_activation_gate_id}-gate.sh" 5
    rg -Fq 'scripts/hepta-core-activation-chain-gate-runner' \
      "scripts/${core_activation_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-provider-router-activation-chain-gate-runner ]]
  verify_file_max scripts/hepta-provider-router-activation-chain-gate-runner 250
  verify_file_max scripts/hepta-provider-router-activation-chain-gate-specs-v1.json 6000
  scripts/hepta-provider-router-activation-chain-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-provider-router-activation-chain-gate-specs-v1.json)" == 3 ]]
  for provider_router_activation_gate_id in \
    hepta-memory-intelligence-kg-full-enablement-runtime-provider-router-activation-command-result-receipt-replay-idempotency-denial \
    hepta-memory-intelligence-kg-full-enablement-runtime-provider-router-activation-command-result-receipt-ordering-monotonicity-denial \
    hepta-memory-intelligence-kg-full-enablement-runtime-provider-router-activation-command-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${provider_router_activation_gate_id}-gate.sh" 5
    rg -Fq 'scripts/hepta-provider-router-activation-chain-gate-runner' \
      "scripts/${provider_router_activation_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-operator-canary-activation-chain-gate-runner ]]
  verify_file_max scripts/hepta-operator-canary-activation-chain-gate-runner 250
  verify_file_max scripts/hepta-operator-canary-activation-chain-gate-specs-v1.json 6000
  scripts/hepta-operator-canary-activation-chain-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-operator-canary-activation-chain-gate-specs-v1.json)" == 3 ]]
  for operator_canary_activation_gate_id in \
    hepta-memory-intelligence-kg-full-enablement-operator-canary-controlled-request-harness-operator-review-acknowledgement-activation-command-result-receipt-replay-idempotency-denial \
    hepta-memory-intelligence-kg-full-enablement-operator-canary-controlled-request-harness-operator-review-acknowledgement-activation-command-result-receipt-ordering-monotonicity-denial \
    hepta-memory-intelligence-kg-full-enablement-operator-canary-controlled-request-harness-operator-review-acknowledgement-activation-command-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${operator_canary_activation_gate_id}-gate.sh" 5
    rg -Fq 'scripts/hepta-operator-canary-activation-chain-gate-runner' \
      "scripts/${operator_canary_activation_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-release-publication-result-receipt-gate-runner ]]
  verify_file_max scripts/hepta-release-publication-result-receipt-gate-runner 220
  verify_file_max scripts/hepta-release-publication-result-receipt-gate-specs-v1.json 4500
  scripts/hepta-release-publication-result-receipt-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-release-publication-result-receipt-gate-specs-v1.json)" == 3 ]]
  for release_publication_result_receipt_gate_id in \
    hepta-memory-intelligence-kg-full-live-activation-operator-readiness-packet-template-packet-acceptance-receipt-release-publication-result-receipt-replay-idempotency-denial \
    hepta-memory-intelligence-kg-full-live-activation-operator-readiness-packet-template-packet-acceptance-receipt-release-publication-result-receipt-ordering-monotonicity-denial \
    hepta-memory-intelligence-kg-full-live-activation-operator-readiness-packet-template-packet-acceptance-receipt-release-publication-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${release_publication_result_receipt_gate_id}-gate.sh" 5
    rg -Fq 'scripts/hepta-release-publication-result-receipt-gate-runner' \
      "scripts/${release_publication_result_receipt_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-artifact-download-install-affordance-result-receipt-gate-runner ]]
  verify_file_max scripts/hepta-artifact-download-install-affordance-result-receipt-gate-runner 240
  verify_file_max scripts/hepta-artifact-download-install-affordance-result-receipt-gate-specs-v1.json 5500
  scripts/hepta-artifact-download-install-affordance-result-receipt-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-artifact-download-install-affordance-result-receipt-gate-specs-v1.json)" == 3 ]]
  for artifact_download_install_affordance_result_receipt_gate_id in \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-replay-idempotency-denial \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-ordering-monotonicity-denial \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${artifact_download_install_affordance_result_receipt_gate_id}-gate.sh" 5
    rg -Fq 'scripts/hepta-artifact-download-install-affordance-result-receipt-gate-runner' \
      "scripts/${artifact_download_install_affordance_result_receipt_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-memory-live-mutation-result-receipt-gate-runner ]]
  verify_file_max scripts/hepta-memory-live-mutation-result-receipt-gate-runner 210
  verify_file_max scripts/hepta-memory-live-mutation-result-receipt-gate-specs-v1.json 2600
  scripts/hepta-memory-live-mutation-result-receipt-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-memory-live-mutation-result-receipt-gate-specs-v1.json)" == 3 ]]
  for memory_live_mutation_result_receipt_gate_id in \
    hepta-memory-live-mutation-operator-write-execution-activation-command-result-receipt-replay-idempotency-denial \
    hepta-memory-live-mutation-operator-write-execution-activation-command-result-receipt-ordering-monotonicity-denial \
    hepta-memory-live-mutation-operator-write-execution-activation-command-result-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${memory_live_mutation_result_receipt_gate_id}-gate.sh" 4
    rg -Fq 'scripts/hepta-memory-live-mutation-result-receipt-gate-runner' \
      "scripts/${memory_live_mutation_result_receipt_gate_id}-gate.sh"
  done
  [[ -x scripts/hepta-terminal-public-claim-delivery-receipt-gate-runner ]]
  verify_file_max scripts/hepta-terminal-public-claim-delivery-receipt-gate-runner 210
  verify_file_max scripts/hepta-terminal-public-claim-delivery-receipt-gate-specs-v1.json 4500
  scripts/hepta-terminal-public-claim-delivery-receipt-gate-runner --validate >/dev/null
  [[ "$(jq '.specs | length' scripts/hepta-terminal-public-claim-delivery-receipt-gate-specs-v1.json)" == 3 ]]
  for terminal_public_claim_delivery_receipt_gate_id in \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-replay-idempotency-denial \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-ordering-monotonicity-denial \
    hepta-memory-intelligence-kg-full-live-activation-artifact-download-install-affordance-result-receipt-operator-intent-consent-evidence-artifact-signing-terminal-public-claim-delivery-receipt-cancellation-supersession-denial
  do
    verify_file_max "scripts/${terminal_public_claim_delivery_receipt_gate_id}-gate.sh" 3
    rg -Fq 'scripts/hepta-terminal-public-claim-delivery-receipt-gate-runner' \
      "scripts/${terminal_public_claim_delivery_receipt_gate_id}-gate.sh"
  done
  hepta_source_path_contains \
    "$HEPTA_NATIVE_GATEWAY_SOURCE_SET_V1" \
    'hepta_full_live_activation_closure_index_report'
  hepta_source_path_contains \
    "$HEPTA_RUNTIME_PUBLIC_API_SOURCE_SET_V1" \
    'ModelProviderMemoryContextActivationExecutionInput'
  hepta_source_path_contains \
    "$HEPTA_RUNTIME_QUERY_SOURCE_SET_V1" \
    'context_recall_turn_handoff'
  [[ "$(hepta_source_path_sha256 "$HEPTA_NATIVE_GATEWAY_SOURCE_SET_V1")" =~ ^[0-9a-f]{64}$ ]]
  [[ "$(hepta_source_path_sha256 "$HEPTA_RUNTIME_PUBLIC_API_SOURCE_SET_V1")" =~ ^[0-9a-f]{64}$ ]]
  [[ "$(hepta_source_path_sha256 "$HEPTA_RUNTIME_QUERY_SOURCE_SET_V1")" =~ ^[0-9a-f]{64}$ ]]

  while IFS= read -r source_set_consumer; do
    rg -Fq 'source-set.sh' "$source_set_consumer" \
      || {
        echo "source-set gate does not load canonical helper: $source_set_consumer" >&2
        return 1
      }
  done < <(
    rg -l --glob 'hepta-*gate.sh' \
      'hepta-(native-gateway|runtime-public-api|runtime-query)-source-set-v1' \
      scripts
  )

  direct_source_set_hash_consumer="$(
    rg -l --glob 'hepta-*gate.sh' \
      'shasum -a 256 "\$(NATIVE_GATEWAY_SOURCE|RUNTIME_LIB_SOURCE|RUNTIME_QUERY_SOURCE)"' \
      scripts \
      || true
  )"
  [[ -z "$direct_source_set_hash_consumer" ]] \
    || {
      echo "gate hashes a source-set identifier as a file: $direct_source_set_hash_consumer" >&2
      return 1
    }

  stale_native_source_consumer="$(
    rg -l --glob 'hepta-*gate.sh' \
      '\$repo_root/codex-rs/hepta-native-gateway/src/native_gateway\.rs' \
      scripts \
      || true
  )"
  [[ -z "$stale_native_source_consumer" ]] \
    || {
      echo "gate still scans the pre-split Native Gateway monolith: $stale_native_source_consumer" >&2
      return 1
    }
  stale_native_source_consumer="$(
    rg -l --glob 'hepta-*gate.sh' \
      'NATIVE_GATEWAY_SOURCE="(\$REPO_ROOT/)?codex-rs/hepta-native-gateway/src/native_gateway\.rs"' \
      scripts \
      || true
  )"
  [[ "$stale_native_source_consumer" == "scripts/hepta-route-gate-dynamic-count-regression-gate.sh" ]] \
    || {
      echo "unexpected direct Native Gateway monolith assignment: $stale_native_source_consumer" >&2
      return 1
    }
  if rg -q --glob 'hepta-*gate.sh' \
    'RUNTIME_LIB_SOURCE="(\$REPO_ROOT/)?codex-rs/hepta-runtime/src/lib\.rs"' \
    scripts; then
    echo "gate still scans Runtime public exports through lib.rs alone" >&2
    return 1
  fi
  if rg -q --glob 'hepta-*gate.sh' \
    'native_gateway_source[[:space:]]*:[[:space:]]*"codex-rs/hepta-native-gateway/src/native_gateway\.rs"' \
    scripts; then
    echo "gate still reports the pre-split Native Gateway monolith as its source" >&2
    return 1
  fi

  echo '{"schema":"hepta_architecture_budget_v1","status":"ready","native_gateway_main_max_lines":6000,"native_gateway_domain_max_lines":60000,"native_gateway_total_max_lines":181000,"runtime_lib_max_lines":1500,"runtime_domain_max_lines":6000,"runtime_total_max_lines":33000,"runtime_query_main_max_lines":6000,"runtime_query_domain_max_lines":4000,"runtime_query_total_max_lines":12500,"report_dag_max_entries":2048,"report_dag_max_bytes":134217728,"report_max_bytes":2097152}'
}

self_test_report_dag_budget() (
  local cache_dir
  cache_dir="$(mktemp -d /tmp/hepta-report-dag-budget-self.XXXXXX)"
  trap 'rm -rf "$cache_dir"' EXIT

  if (
    export HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR="$cache_dir"
    export HEPTA_JSON_REPORT_CAPTURE_MAX_ENTRIES=1
    export HEPTA_JSON_REPORT_CAPTURE_MAX_TOTAL_BYTES=1024
    export HEPTA_JSON_REPORT_CAPTURE_MAX_REPORT_BYTES=512
    source scripts/lib/hepta-json-report-capture.sh
    capture_json_report first sh -c 'printf "{\"entry\":1}\n"'
    capture_json_report second sh -c 'printf "{\"entry\":2}\n"'
  ) >/dev/null 2>&1; then
    echo "report DAG entry-budget self-test unexpectedly passed" >&2
    return 1
  fi

  if (
    export HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR="$cache_dir/oversize"
    export HEPTA_JSON_REPORT_CAPTURE_MAX_ENTRIES=4
    export HEPTA_JSON_REPORT_CAPTURE_MAX_TOTAL_BYTES=1024
    export HEPTA_JSON_REPORT_CAPTURE_MAX_REPORT_BYTES=16
    source scripts/lib/hepta-json-report-capture.sh
    capture_json_report oversize sh -c 'printf "{\"payload\":\"0123456789abcdef\"}\n"'
  ) >/dev/null 2>&1; then
    echo "report per-entry budget self-test unexpectedly passed" >&2
    return 1
  fi
)

self_test() {
  verify >/dev/null
  scripts/hepta-budgeted-test self-test >/dev/null
  self_test_report_dag_budget
  echo '{"schema":"hepta_architecture_budget_self_test_v1","status":"ready","line_budgets_enforced":true,"report_dag_budgets_enforced":true,"test_timeout_enforced":true,"workspace_write_budget_enforced":true}'
}

case "${1:-verify}" in
  verify)
    verify
    ;;
  self-test)
    self_test
    ;;
  *)
    echo "usage: $0 [verify|self-test]" >&2
    exit 2
    ;;
esac
