self_test_line_budget_negative_fixture() {
  local denial
  local fixture="scripts/testdata/hepta-architecture-budget/over-budget.txt"
  local fixture_root="scripts/testdata/hepta-architecture-budget"

  [[ -f "$fixture" ]] || {
    echo "architecture line-budget negative fixture is missing: $fixture" >&2
    return 1
  }
  [[ "$(wc -l <"$fixture" | tr -d '[:space:]')" == 3 ]] || {
    echo "architecture line-budget negative fixture must contain exactly three lines" >&2
    return 1
  }

  if denial="$(verify_file_max "$fixture" 2 2>&1)"; then
    echo "architecture file line-budget negative fixture unexpectedly passed" >&2
    return 1
  fi
  [[ "$denial" == "architecture line budget exceeded: $fixture has 3, max 2" ]] || {
    echo "architecture file line-budget negative fixture failed unexpectedly: $denial" >&2
    return 1
  }

  if denial="$(verify_total_max 2 "$fixture" 2>&1)"; then
    echo "architecture aggregate line-budget negative fixture unexpectedly passed" >&2
    return 1
  fi
  [[ "$denial" == "architecture aggregate line budget exceeded: 3 > 2: $fixture" ]] || {
    echo "architecture aggregate line-budget negative fixture failed unexpectedly: $denial" >&2
    return 1
  }

  if denial="$(verify_tree_total_max 2 '*.txt' "$fixture_root" 2>&1)"; then
    echo "architecture tree line-budget negative fixture unexpectedly passed" >&2
    return 1
  fi
  [[ "$denial" == "architecture tree line budget exceeded: 3 > 2: pattern=*.txt roots=$fixture_root" ]] || {
    echo "architecture tree line-budget negative fixture failed unexpectedly: $denial" >&2
    return 1
  }
}

self_test_build_output_pruned() (
  local denial
  local fixture_root
  local generated_root
  local maintained_root

  fixture_root="$(mktemp -d /tmp/hepta-architecture-budget-target-self.XXXXXX)"
  trap 'rm -rf "$fixture_root"' EXIT
  maintained_root="$fixture_root/maintained"
  generated_root="$fixture_root/generated"
  mkdir -p "$maintained_root/target/build" "$generated_root"
  printf 'maintained-1\nmaintained-2\nmaintained-3\n' >"$maintained_root/source.txt"
  printf 'generated-1\ngenerated-2\n' >"$generated_root/generated.txt"
  printf 'ignored-1\nignored-2\nignored-3\nignored-4\n' >"$maintained_root/target/build/output.txt"

  verify_tree_total_max 3 '*.txt' "$maintained_root"
  if denial="$(verify_tree_total_max 2 '*.txt' "$maintained_root" 2>&1)"; then
    echo "architecture target-pruning tree fixture unexpectedly passed" >&2
    return 1
  fi
  [[ "$denial" == "architecture tree line budget exceeded: 3 > 2: pattern=*.txt roots=$maintained_root" ]] || {
    echo "architecture target-pruning tree fixture failed unexpectedly: $denial" >&2
    return 1
  }

  verify_tree_with_generated_total_max 5 '*.txt' "$generated_root" "$maintained_root"
  if denial="$(verify_tree_with_generated_total_max 4 '*.txt' "$generated_root" "$maintained_root" 2>&1)"; then
    echo "architecture target-pruning generated fixture unexpectedly passed" >&2
    return 1
  fi
  [[ "$denial" == "architecture maintainable-source line budget exceeded: 5 > 4: pattern=*.txt generated=$generated_root roots=$maintained_root" ]] || {
    echo "architecture target-pruning generated fixture failed unexpectedly: $denial" >&2
    return 1
  }
)

self_test_first_model_invocation_test_family_split() {
  local family_file="codex-rs/hepta-native-gateway/src/native_gateway/tests/first_model_invocation.rs"
  local parent_file
  parent_file="$(
    rg -l 'mod first_model_invocation_tests \{' \
      codex-rs/hepta-native-gateway/src/native_gateway/tests.rs \
      codex-rs/hepta-native-gateway/src/native_gateway/tests/contract_part_*.rs
  )"

  [[ -f "$family_file" ]]
  [[ "$(printf '%s\n' "$parent_file" | sed '/^$/d' | wc -l | tr -d ' ')" == 1 ]]
  rg -Fq 'mod first_model_invocation_tests {' "$parent_file"
  rg -Fq 'include!("first_model_invocation.rs");' "$parent_file"
  [[ "$(rg -c '^[[:space:]]*#\[test\]' "$family_file")" == 1 ]]
  [[ "$(rg -o 'HEPTA_FIRST_MODEL_[A-Z0-9_]+_ENDPOINT' "$family_file" | sort -u | wc -l | tr -d ' ')" == 17 ]]
}

self_test_report_dag_budget() (
  local cache_dir
  cache_dir="$(mktemp -d /tmp/hepta-report-dag-budget-self.XXXXXX)"
  trap 'rm -rf "$cache_dir"' EXIT

  if (
    export HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR="$cache_dir"
    export HEPTA_JSON_REPORT_CAPTURE_MAX_ENTRIES=1
    export HEPTA_JSON_REPORT_CAPTURE_MAX_TOTAL_BYTES=1024
    export HEPTA_JSON_REPORT_CAPTURE_MAX_REPORT_BYTES=512
    source scripts/lib/hepta-json-report-capture.sh
    capture_json_report first sh -c 'printf "{\"entry\":1}\n"'
    capture_json_report second sh -c 'printf "{\"entry\":2}\n"'
  ) >/dev/null 2>&1; then
    echo "report DAG entry-budget self-test unexpectedly passed" >&2
    return 1
  fi

  if (
    export HEPTA_JSON_REPORT_CAPTURE_CACHE_DIR="$cache_dir/oversize"
    export HEPTA_JSON_REPORT_CAPTURE_MAX_ENTRIES=4
    export HEPTA_JSON_REPORT_CAPTURE_MAX_TOTAL_BYTES=1024
    export HEPTA_JSON_REPORT_CAPTURE_MAX_REPORT_BYTES=16
    source scripts/lib/hepta-json-report-capture.sh
    capture_json_report oversize sh -c 'printf "{\"payload\":\"0123456789abcdef\"}\n"'
  ) >/dev/null 2>&1; then
    echo "report per-entry budget self-test unexpectedly passed" >&2
    return 1
  fi
)

self_test() {
  verify >/dev/null
  self_test_line_budget_negative_fixture
  self_test_build_output_pruned
  self_test_first_model_invocation_test_family_split
  scripts/hepta-budgeted-test self-test >/dev/null
  self_test_report_dag_budget
  echo '{"schema":"hepta_architecture_budget_self_test_v1","status":"ready","line_budgets_enforced":true,"whole_tree_budgets_enforced":true,"giant_file_budgets_enforced":true,"architecture_v2_slice_budgets_enforced":true,"first_model_invocation_data_matrix_enforced":true,"report_dag_budgets_enforced":true,"test_timeout_enforced":true,"workspace_write_budget_enforced":true}'
}

case "${1:-verify}" in
  verify)
    verify
    ;;
  self-test)
    self_test
    ;;
  *)
    echo "usage: $0 [verify|self-test]" >&2
    exit 2
    ;;
esac
