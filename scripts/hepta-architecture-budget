    codex-rs/hepta-native-gateway/src/native_gateway/memory_kg_reports/identity_and_signing_denials
  do
    verify_split_family 3 4800 "$report_root"/part_*.rs
  done
  verify_file_max codex-rs/core/src/session/tests.rs 20
  verify_split_family 4 3800 codex-rs/core/src/session/tests/contract_part_*.rs
  verify_file_max codex-rs/core/src/config/config_tests.rs 20
  verify_split_family 4 3000 \
    codex-rs/core/src/config/config_tests/contract_part_*.rs
  verify_file_max scripts/hepta-preflight-evidence-pack 270
  [[ -x scripts/hepta-preflight-evidence-pack ]] || {
    echo "preflight evidence packer is not executable" >&2
    return 1
  }
  scripts/hepta-preflight-evidence-pack self-test \
    | jq -e '
      .schema == "hepta_preflight_evidence_pack_self_test_v1"
      and .status == "ready"
      and .deterministic_repack == true
      and .exact_roundtrip == true
      and .tamper_rejected == true
    ' >/dev/null
  verify_file_max scripts/hepta-architecture-release-ratchet 380
  [[ -x scripts/hepta-architecture-release-ratchet ]] || {
    echo "architecture release ratchet is not executable" >&2
    return 1
  }
  scripts/hepta-architecture-release-ratchet self-test \
    | jq -e '
      .schema == "hepta_architecture_release_ratchet_self_test_v1"
      and .status == "ready"
      and .unchanged_receipt_accepted == true
      and .increased_discrete_debt_denied == true
      and .increased_canonical_record_size_denied == true
      and .raised_ceiling_denied == true
      and .growth_above_3_percent_denied == true
      and .raw_and_gzip_previous_receipt_extraction == true
    ' >/dev/null
}

maintainable_tree_with_generated_line_total() {
  local pattern="$1"
  local generated_root="$2"
  shift 2
  {
    maintainable_tree_line_counts "$pattern" "$@"
    if [[ -f "$generated_root/registry.json" ]] \
      && jq -e '.schema == "hepta_workgraph_normalized_bundle_v3"' \
        "$generated_root/registry.json" >/dev/null 2>&1
    then
      jq -r '.normalized_effective_lines' "$generated_root/registry.json"
    else
      find "$generated_root" -type f -exec wc -l {} +
    fi
  } | awk '$2 != "total" { total += $1 } END { print total + 0 }'
}

verify_tree_total_max() {
  local max_lines="$1"
  local pattern="$2"
  shift 2
  local total
  total="$(maintainable_tree_line_total "$pattern" "$@")"
  if (( total > max_lines )); then
    echo "architecture tree line budget exceeded: ${total} > ${max_lines}: pattern=$pattern roots=$*" >&2
    return 1
  fi
}

verify_tree_with_generated_total_max() {
  local max_lines="$1"
  local pattern="$2"
  local generated_root="$3"
  shift 3
  local total
  total="$(maintainable_tree_with_generated_line_total "$pattern" "$generated_root" "$@")"
  if (( total > max_lines )); then
    echo "architecture maintainable-source line budget exceeded: ${total} > ${max_lines}: pattern=$pattern generated=$generated_root roots=$*" >&2
    return 1
  fi
}

