#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

ARCHITECTURE_RATCHET="scripts/hepta-architecture-ratchet-v1.json"

jq -e '
  .schema == "hepta_architecture_ratchet_v1"
  and .status == "o2_hard_targets_met"
  and .counting_semantics.worktree_umask_independent == true
  and (.ceilings | keys | sort) == (.baselines | keys | sort)
  and (.baselines | keys | sort) == (.decline_targets.next | keys | sort)
  and (.decline_targets.next | keys | sort) == (.decline_targets.terminal | keys | sort)
  and ([.baselines, .decline_targets.next, .decline_targets.terminal]
    | all(.work_graph_logical_modules >= 0
      and .work_graph_effective_lines >= 0
      and .gate_compat_pairs >= 0
      and .gate_compat_effective_lines >= 0
      and .single_exec_wrappers >= 0
      and .first_party_modules_over_5000 >= 0))
  and ((.baselines.work_graph_logical_modules == 4
        and .decline_targets.next.work_graph_logical_modules == 4
        and .decline_targets.terminal.work_graph_logical_modules == 4)
       or (.decline_targets.next.work_graph_logical_modules < .baselines.work_graph_logical_modules
           and .decline_targets.terminal.work_graph_logical_modules < .decline_targets.next.work_graph_logical_modules))
  and ((.decline_targets.next.work_graph_effective_lines == 25000
        and .decline_targets.terminal.work_graph_effective_lines == 25000
        and .decline_targets.terminal.work_graph_effective_lines < .baselines.work_graph_effective_lines)
       or (.decline_targets.next.work_graph_effective_lines < .baselines.work_graph_effective_lines
           and .decline_targets.terminal.work_graph_effective_lines < .decline_targets.next.work_graph_effective_lines))
  and .decline_targets.next.gate_compat_pairs <= .baselines.gate_compat_pairs
  and .decline_targets.terminal.gate_compat_pairs < .decline_targets.next.gate_compat_pairs
  and .decline_targets.next.gate_compat_effective_lines < .baselines.gate_compat_effective_lines
  and .decline_targets.terminal.gate_compat_effective_lines < .decline_targets.next.gate_compat_effective_lines
  and ((.baselines.single_exec_wrappers == 0
        and .decline_targets.next.single_exec_wrappers == 0
        and .decline_targets.terminal.single_exec_wrappers == 0)
       or (.decline_targets.next.single_exec_wrappers < .baselines.single_exec_wrappers
           and .decline_targets.terminal.single_exec_wrappers < .decline_targets.next.single_exec_wrappers))
  and ((.baselines.first_party_modules_over_5000 == 0
        and .decline_targets.next.first_party_modules_over_5000 == 0
        and .decline_targets.terminal.first_party_modules_over_5000 == 0)
       or (.decline_targets.next.first_party_modules_over_5000 < .baselines.first_party_modules_over_5000
           and .decline_targets.terminal.first_party_modules_over_5000 < .decline_targets.next.first_party_modules_over_5000))
' "$ARCHITECTURE_RATCHET" >/dev/null

architecture_sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

RUNTIME_WHOLE_TREE_MAX_LINES=413411
HEPTA_OWNED_RUST_WHOLE_TREE_MAX_LINES=927294
HEPTA_FIRST_PARTY_RUST_COMPLETE_MAX_LINES=946184
SCRIPTS_PHYSICAL_MAX_LINES=408307
SCRIPTS_WHOLE_TREE_MAX_LINES=568857
WORK_GRAPH_MAX_FILES=1
WORK_GRAPH_MAX_EFFECTIVE_LINES="$(jq -er '.ceilings.work_graph_effective_lines' "$ARCHITECTURE_RATCHET")"
GATE_COMPAT_MAX_PAIRS="$(jq -er '.ceilings.gate_compat_pairs' "$ARCHITECTURE_RATCHET")"
GATE_COMPAT_MAX_EFFECTIVE_LINES="$(jq -er '.ceilings.gate_compat_effective_lines' "$ARCHITECTURE_RATCHET")"
SINGLE_EXEC_WRAPPER_MAX_COUNT="$(jq -er '.ceilings.single_exec_wrappers' "$ARCHITECTURE_RATCHET")"
GIANT_MODULE_OVER_10000_MAX_COUNT=0
GIANT_MODULE_OVER_5000_MAX_COUNT="$(jq -er '.ceilings.first_party_modules_over_5000' "$ARCHITECTURE_RATCHET")"
GATE_COMPAT_ROOT="scripts/lib/hepta-gate-pair-compat-v2"
TREE_CLASSIFICATION="docs/architecture/hepta-tree-classification-v1.json"

resolve_budget_file() {
  local logical_path="$1"
  local relocated_path
  local compatibility_root
  if [[ -e "$logical_path" ]]; then
    printf '%s\n' "$logical_path"
    return
  fi
  relocated_path="$(scripts/hepta-long-path-resolve "$logical_path")"
  if [[ -e "$relocated_path" ]]; then
    printf '%s\n' "$relocated_path"
    return
  fi
  compatibility_root="${HEPTA_COMPAT_OVERLAY_ROOT:-}"
  if [[ -z "$compatibility_root" ]]; then
    compatibility_root="$(scripts/hepta-gate-pair-payload-bundle materialize-overlay)"
    export HEPTA_COMPAT_OVERLAY_ROOT="$compatibility_root"
  fi
  if [[ -e "$compatibility_root/$logical_path" ]]; then
    printf '%s\n' "$compatibility_root/$logical_path"
    return
  fi
  return 1
}

rg() {
  local arguments=("$@")
  local last_index=$((${#arguments[@]} - 1))
  local candidate="${arguments[$last_index]}"
  local resolved
  if [[ "$candidate" != -* && ! -e "$candidate" ]]; then
    resolved="$(resolve_budget_file "$candidate")" || {
      command rg "$@"
      return
    }
    arguments[$last_index]="$resolved"
  fi
  command rg "${arguments[@]}"
}

verify_file_max() {
  local file="$1"
  local max_lines="$2"
  local actual
  file="$(resolve_budget_file "$file")" || {
    echo "missing architecture budget file: $file" >&2
    return 1
  }
  actual="$(wc -l <"$file" | tr -d '[:space:]')"
  if (( actual > max_lines )); then
    echo "architecture line budget exceeded: ${file} has ${actual}, max ${max_lines}" >&2
    return 1
  fi
}

verify_symlink_alias() {
  local alias_path="$1"
  local expected_target="$2"
  [[ -L "$alias_path" && "$(readlink "$alias_path")" == "$expected_target" ]] || {
    echo "architecture compatibility alias drifted: $alias_path" >&2
    return 1
  }
}

verify_route_gate_alias() {
  local alias_path="$1"
  local expected_runner="$2"
  verify_symlink_alias "$alias_path" hepta-route-gate-alias-launch
  jq -e --arg alias_path "$alias_path" --arg expected_runner "$expected_runner" '
    any(.entries[];
      .logical_path == $alias_path
      and .runner == $expected_runner
    )
  ' scripts/hepta-route-gate-aliases-v1.json >/dev/null
}

verify_gate_alias() {
  local alias_path="$1"
  local expected_runner="$2"
  verify_symlink_alias "$alias_path" hepta-gate-alias-launch
  jq -e --arg alias_path "$alias_path" --arg expected_runner "$expected_runner" '
    any(.entries[];
      .logical_path == $alias_path
      and .runner == $expected_runner
    )
  ' scripts/hepta-gate-aliases-v1.json >/dev/null
}

verify_total_max() {
  local max_lines="$1"
  shift
  local total
  total="$(wc -l "$@" | awk '$2 != "total" { total += $1 } END { print total + 0 }')"
  if (( total > max_lines )); then
    echo "architecture aggregate line budget exceeded: ${total} > ${max_lines}: $*" >&2
    return 1
  fi
}

maintainable_tree_line_counts() {
  local pattern="$1"
  shift
  find "$@" -type d -name target -prune -o -type f -name "$pattern" -exec wc -l {} +
}

maintainable_tree_line_total() {
  local pattern="$1"
  shift
  maintainable_tree_line_counts "$pattern" "$@" \
    | awk '$2 != "total" { total += $1 } END { print total + 0 }'
}

maintainable_scripts_physical_line_total() {
  find scripts -type f \
    ! -path "$GATE_COMPAT_ROOT/payloads.bundle.gz" \
    ! -path "$GATE_COMPAT_ROOT/templates.jsonl" \
    ! -path "$GATE_COMPAT_ROOT/parameters.jsonl" \
    ! -path "$GATE_COMPAT_ROOT/family-state-v1/*" \
    -exec wc -l {} + \
    | awk '$2 != "total" { total += $1 } END { print total + 0 }'
}

maintainable_scripts_effective_line_total() {
  local physical compat_effective
  physical="$(maintainable_scripts_physical_line_total)"
  scripts/hepta-gate-compat-family-verify verify >/dev/null
  compat_effective="$(jq -er '.result.normalized_effective_lines' \
    scripts/hepta-gate-compat-family-receipt-v1.json)"
  printf '%s\n' "$((physical + compat_effective))"
}

verify_tree_classification() {
  verify_file_max "$TREE_CLASSIFICATION" 130
  jq -e '
    .schema == "hepta.tree-classification.v1"
    and .product_boundary == "openclaw_governed_backend"
    and (.classifications.active.roots | index("codex-rs/hepta-durable-store") != null)
    and (.classifications.active.roots | index("codex-rs/hepta-egress") != null)
    and (.classifications.active.roots | index("codex-rs/hepta-paths") != null)
    and (.classifications.active.roots | index("codex-rs/http-client") != null)
    and (.classifications.active.roots | index("codex-rs/websocket-client") != null)
    and .classifications.active.targeted_upstream_surfaces == [
      "codex-rs/app-server",
      "codex-rs/app-server-protocol",
      "codex-rs/backend-client",
      "codex-rs/cli",
      "codex-rs/codex-api",
      "codex-rs/codex-backend-openapi-models",
      "codex-rs/codex-mcp",
      "codex-rs/core",
      "codex-rs/core-plugins",
      "codex-rs/exec-server",
      "codex-rs/features",
      "codex-rs/mcp-server",
      "codex-rs/protocol",
      "codex-rs/rmcp-client",
      "codex-rs/thread-store",
      "codex-rs/tui"
    ]
    and .classifications.active.operational_tools == [
      "scripts/hepta-architecture-release-ratchet",
      "scripts/hepta-preflight-evidence-pack"
    ]
    and (.classifications.compat.roots | index("codex-rs/hepta-runtime/codegen/workgraph-v3") != null)
    and (.classifications.compat.roots | index("scripts/lib/hepta-gate-pair-compat-v2") != null)
    and .classifications.conditional.roots == ["codex-rs/exec-server-protocol"]
    and .classifications.generated.canonical_roots == [
      "codex-rs/hepta-runtime/codegen/workgraph-v3",
      "scripts/lib/hepta-gate-pair-compat-v2"
    ]
    and .classifications.generated.artifact_files == [
      "codex-rs/hepta-runtime/codegen/workgraph-v3/modules.bundle.gz",
      "scripts/lib/hepta-gate-pair-compat-v2/payloads.bundle.gz"
    ]
    and .merge_policy.whole_tree_merge == false
    and .merge_policy.archive_ref_merge == false
    and .merge_policy.targeted_semantic_intake_only == true
    and .merge_policy.preserve_incremental_hepta_authority == true
  ' "$TREE_CLASSIFICATION" >/dev/null
  while IFS= read -r classified_root; do
    [[ -e "$classified_root" ]] || {
      echo "classified Hepta tree root is missing: $classified_root" >&2
      return 1
    }
  done < <(
    jq -r '
      .classifications.active.roots[],
      .classifications.active.targeted_upstream_surfaces[],
      .classifications.active.operational_tools[],
      .classifications.compat.roots[],
      .classifications.conditional.roots[],
      .classifications.generated.canonical_roots[],
      .classifications.generated.artifact_files[]
    ' "$TREE_CLASSIFICATION" | LC_ALL=C sort -u
  )
}

verify_split_family() {
  local expected_count="$1"
  local max_lines="$2"
  shift 2
  [[ "$#" -eq "$expected_count" ]] || {
    echo "architecture split-family count drifted: actual=$# expected=$expected_count files=$*" >&2
    return 1
  }
  local file
  for file in "$@"; do
    [[ -f "$file" ]] || {
      echo "architecture split-family member is missing: $file" >&2
      return 1
    }
    verify_file_max "$file" "$max_lines"
  done
}

