#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

verify_file_max() {
  local file="$1"
  local max_lines="$2"
  local actual
  actual="$(wc -l <"$file" | tr -d '[:space:]')"
  if (( actual > max_lines )); then
    echo "architecture line budget exceeded: ${file} has ${actual}, max ${max_lines}" >&2
    return 1
  fi
}

verify_total_max() {
  local max_lines="$1"
  shift
  local total
  total="$(wc -l "$@" | awk '$2 != "total" { total += $1 } END { print total + 0 }')"
  if (( total > max_lines )); then
    echo "architecture aggregate line budget exceeded: ${total} > ${max_lines}: $*" >&2
    return 1
  fi
}

verify_tree_total_max() {
  local max_lines="$1"
  local pattern="$2"
  shift 2
  local total
  total="$({ find "$@" -type f -name "$pattern" -exec wc -l {} +; } \
    | awk '$2 != "total" { total += $1 } END { print total + 0 }')"
  if (( total > max_lines )); then
    echo "architecture tree line budget exceeded: ${total} > ${max_lines}: pattern=$pattern roots=$*" >&2
    return 1
  fi
}

