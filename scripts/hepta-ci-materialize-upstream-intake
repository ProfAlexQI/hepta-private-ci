#!/usr/bin/env bash
set -euo pipefail

ROOT="${HEPTA_CI_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
CONTRACT="${HEPTA_CI_CONTRACT:-$ROOT/.github/hepta-ci-contract-v1.json}"
EXPECTED_URL="https://github.com/openai/codex.git"
EXPECTED_PREDECESSOR_REF="refs/remotes/upstream/hepta-intake-20260721"
EXPECTED_PREDECESSOR_SHA="45ac251e178416ff5c3022457ad8d2778c0d4549"
EXPECTED_R2_REF="refs/remotes/upstream/hepta-intake-20260721-r2"
EXPECTED_R2_SHA="88fac6fe108237a105d3203e3508b0d531054312"

usage() {
  echo "usage: scripts/hepta-ci-materialize-upstream-intake <verify|materialize>" >&2
  exit 2
}

load_contract() {
  command -v jq >/dev/null || {
    echo "missing Hepta upstream intake tool: jq" >&2
    return 1
  }
  if ! jq -e \
    --arg url "$EXPECTED_URL" \
    --arg predecessor_ref "$EXPECTED_PREDECESSOR_REF" \
    --arg predecessor_sha "$EXPECTED_PREDECESSOR_SHA" \
    --arg r2_ref "$EXPECTED_R2_REF" \
    --arg r2_sha "$EXPECTED_R2_SHA" \
    '
      .upstream_intake == {
        url:$url,
        materialize_command:"scripts/hepta-ci-materialize-upstream-intake materialize",
        refs:[
          {role:"predecessor",ref:$predecessor_ref,sha:$predecessor_sha},
          {role:"current_r2",ref:$r2_ref,sha:$r2_sha}
        ]
      }
    ' "$CONTRACT" >/dev/null; then
    echo "Hepta upstream intake contract does not match the frozen cutoff set" >&2
    return 1
  fi
  url="$(jq -er '.upstream_intake.url' "$CONTRACT")"
  refs_tsv="$(jq -er '.upstream_intake.refs[] | [.role,.ref,.sha] | @tsv' "$CONTRACT")"
}

verify_ref() {
  local role="$1"
  local ref="$2"
  local sha="$3"
  local actual
  actual="$(git -C "$ROOT" rev-parse --verify "$ref^{commit}" 2>/dev/null)" || {
    echo "Hepta frozen upstream intake ref is missing for $role: $ref" >&2
    return 1
  }
  if [[ "$actual" != "$sha" ]]; then
    echo "Hepta frozen upstream intake ref mismatch for $role: expected $sha, found $actual" >&2
    return 1
  fi
}

materialize_ref() {
  local role="$1"
  local ref="$2"
  local sha="$3"
  local existing fetched
  existing="$(git -C "$ROOT" rev-parse --verify "$ref^{commit}" 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    if [[ "$existing" != "$sha" ]]; then
      echo "Hepta frozen upstream intake ref for $role already exists at unexpected commit: $existing" >&2
      return 1
    fi
    return 0
  fi

  if ! git -C "$ROOT" cat-file -e "$sha^{commit}" 2>/dev/null; then
    git -C "$ROOT" fetch --no-tags --filter=blob:none "$url" "$sha"
    fetched="$(git -C "$ROOT" rev-parse --verify 'FETCH_HEAD^{commit}')"
    if [[ "$fetched" != "$sha" ]]; then
      echo "Hepta frozen upstream intake fetch mismatch for $role: expected $sha, found $fetched" >&2
      return 1
    fi
  fi

  git -C "$ROOT" update-ref "$ref" "$sha" 0000000000000000000000000000000000000000
  verify_ref "$role" "$ref" "$sha"
}

verify_refs() {
  local role ref sha
  while IFS=$'\t' read -r role ref sha; do
    verify_ref "$role" "$ref" "$sha"
  done <<<"$refs_tsv"
}

materialize_refs() {
  local role ref sha
  while IFS=$'\t' read -r role ref sha; do
    materialize_ref "$role" "$ref" "$sha"
  done <<<"$refs_tsv"
  verify_refs
}

[[ $# -eq 1 ]] || usage
load_contract
case "$1" in
  verify)
    verify_refs
    ;;
  materialize)
    materialize_refs
    ;;
  *)
    usage
    ;;
esac

jq -n \
  --arg schema hepta_ci_upstream_intake_v2 \
  --arg status ready \
  --arg url "$url" \
  --argjson refs "$(jq -c '.upstream_intake.refs' "$CONTRACT")" \
  '{schema:$schema,status:$status,url:$url,refs:$refs,exact_fetch_only:true,predecessor_ref_preserved:true,current_r2_ref_materialized:true,merge_performed:false,checkout_performed:false,push_performed:false}'
