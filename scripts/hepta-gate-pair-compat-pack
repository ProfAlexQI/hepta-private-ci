#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
PAYLOAD_TOOL="$ROOT/scripts/hepta-gate-pair-payload-bundle"
ENTRYPOINT_TOOL="$ROOT/scripts/hepta-gate-pair-entrypoint-prune"

usage() {
  printf '%s\n' 'usage: scripts/hepta-gate-pair-compat-pack [pack|verify|unpack]' >&2
  exit 2
}

[[ $# == 1 ]] || usage
case "$1" in
  pack)
    "$PAYLOAD_TOOL" pack
    "$ENTRYPOINT_TOOL" pack
    ;;
  verify)
    "$PAYLOAD_TOOL" verify
    "$ENTRYPOINT_TOOL" verify
    ;;
  unpack)
    "$PAYLOAD_TOOL" unpack
    "$ENTRYPOINT_TOOL" unpack
    ;;
  *)
    usage
    ;;
esac
