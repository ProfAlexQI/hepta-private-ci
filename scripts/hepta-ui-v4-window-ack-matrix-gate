#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pathname"

root = Pathname.new(__dir__).join("..").expand_path
files = {
  shared: root.join("apps/hepta-native/src/shared/mod.rs"),
  request: root.join("apps/hepta-native/src/shared/hepta_makepad_window_material.rs"),
  ack: root.join("apps/hepta-native/src/shared/hepta_window_visual_ack.rs"),
  probe: root.join("apps/hepta-native/src/bin/hepta-ui-v4-filter-matrix-probe.rs"),
  runner: root.join("scripts/hepta-ui-v4-native-component-matrix"),
  component_matrix: root.join("docs/ui/HEPTA_NATIVE_COMPONENT_MATRIX_V1.json"),
  control_matrix: root.join("docs/ui/HEPTA_NATIVE_CONTROL_MIGRATION_V1.json"),
  material_matrix: root.join("docs/ui/HEPTA_PLATFORM_MATERIAL_ADAPTER_MATRIX_V1.json"),
  scenario_schema: root.join("docs/ui/schemas/hepta.ui.v4.native-component-scenario.v1.schema.json"),
  aggregate_schema: root.join("docs/ui/schemas/hepta.ui.v4.native-component-matrix.v1.schema.json"),
  workflow: root.join(".github/workflows/hepta-ui-v4-window-ack-matrix.yml")
}.freeze

checks = {}
files.each { |name, path| checks["file.#{name}"] = path.file? && !path.zero? }

def emit(checks, status)
  false_claims = {
    native_compile_validation: false,
    backend_ack_runtime_validation: false,
    runtime_readback: false,
    component_matrix_runtime_validation: false,
    screenshot_validation: false,
    native_product_runtime_validation: false,
    system_material_binding: false,
    device_validation: false,
    production_authority: false,
    effect_authority: false,
    live_adapter_authority: false,
    operator_acceptance: false,
    promotion: false,
    release: false
  }
  failures = checks.reject { |_name, passed| passed }.keys
  puts JSON.pretty_generate({
    schema: "hepta.ui.v4.window-ack-component-matrix-source-gate.v1",
    status: status,
    source_implemented: failures.empty?,
    acknowledgement_contract_source: failures.empty?,
    component_matrix_producer_source: failures.empty?,
    checks: checks,
    failures: failures
  }.merge(false_claims))
  exit(failures.empty? ? 0 : 1)
end

emit(checks, "FAIL_MISSING_INPUT") unless checks.values.all?

shared = files.fetch(:shared).read
request = files.fetch(:request).read
ack = files.fetch(:ack).read
probe = files.fetch(:probe).read
runner = files.fetch(:runner).read
component_matrix = JSON.parse(files.fetch(:component_matrix).read)
control_matrix = JSON.parse(files.fetch(:control_matrix).read)
material_matrix = JSON.parse(files.fetch(:material_matrix).read)
scenario_schema = JSON.parse(files.fetch(:scenario_schema).read)
aggregate_schema = JSON.parse(files.fetch(:aggregate_schema).read)
workflow = files.fetch(:workflow).read

checks["shared.ack_declared"] = shared.include?("pub mod hepta_window_visual_ack;")
checks["request.exact_identity_and_deduplicated_queue"] = %w[
  generation window_index window_generation framework_request_queued
].all? { |term| request.include?(term) } &&
  request.include?("window.window_visuals() == visuals") &&
  request.include?("CxOsOp::SetWindowVisuals")
checks["request.partial_only"] = %w[
  transient_system_material_bound: false complete_profile_bound: false
  system_material_bound: false runtime_readback: false
].all? { |term| request.include?(term) }

checks["ack.identity_requires_queued_request"] =
  ack.include?("from_makepad_receipt") &&
  ack.include?("!receipt.framework_request_queued") &&
  ack.include?("RejectedNoQueuedRequest")
checks["ack.identity_fields"] = %w[
  request_sequence platform window_index window_generation requested_visuals
  persistent_chrome_requested
].all? { |term| ack.include?(term) }
checks["ack.backend_and_stale_rejection"] = %w[
  WindowsDwm MacosAppKit RejectedRequestSequence RejectedPlatform
  RejectedWindowIdentity RejectedBackend RejectedBackendFailure
].all? { |term| ack.include?(term) }
checks["ack.scoped_readback"] =
  ack.include?("HeptaWindowVisualReadbackScope") &&
  ack.include?("HeptaWindowVisualReadback") &&
  ack.include?("BackdropOnly") && ack.include?("FullVisuals") &&
  ack.include?("RejectedReadbackMismatch")
checks["ack.partial_success_states"] = %w[
  VerifiedPersistentChromeWithoutReadback
  VerifiedPersistentChromeWithBackdropReadback
  VerifiedPersistentChromeWithFullReadback
  VerifiedSolidFallbackWithoutReadback
  VerifiedSolidFallbackWithBackdropReadback
  VerifiedSolidFallbackWithFullReadback
].all? { |term| ack.include?(term) }
checks["ack.no_complete_or_authority_claim"] = %w[
  transient_system_material_bound: false complete_profile_bound: false
  system_material_bound: false production_authority: false
  effect_authority: false live_adapter_authority: false
  operator_acceptance: false promotion: false release: false
].all? { |term| ack.include?(term) }
checks["ack.producer_and_runtime_unbound"] =
  ack.include?("HEPTA_WINDOW_VISUAL_ACK_PRODUCER_BOUND: bool = false") &&
  ack.include?("HEPTA_WINDOW_VISUAL_ACK_RUNTIME_VALIDATED: bool = false") &&
  ack.include?("HEPTA_WINDOW_VISUAL_ACK_FULL_VISUAL_READBACK_VALIDATED: bool = false")
checks["ack.focused_tests"] = %w[
  acknowledgement_identity_requires_a_queued_framework_request
  stale_sequence_and_window_generation_are_rejected
  backend_and_readback_contracts_fail_closed
  backdrop_only_readback_is_partial_not_full_visual_readback
  full_readback_requires_every_visual_field_to_match
  solid_fallback_backdrop_acknowledgement_is_not_a_material_binding_claim
].all? { |term| ack.include?(term) }
checks["ack.no_unsafe_ffi"] =
  !ack.match?(/\bunsafe\b/) && !ack.match?(/extern\s+"(?:C|system)"/)

checks["probe.actual_component_areas"] = %w[
  mod.widgets.RoomFilterInputBar filter.area().rect(cx)
  input.area().rect(cx) clear.area().rect(cx)
].all? { |term| probe.include?(term) }
checks["probe.exact_candidate_window_and_screenshot"] = %w[
  HEPTA_CANDIDATE_COMMIT HEPTA_CANDIDATE_TREE exactWindowIdBound
  capture_next_frame_to_file Sha256::digest write_json_atomic cx.quit()
].all? { |term| probe.include?(term) }
checks["probe.no_network_or_product_claim"] =
  %w[HttpRequest WebSocket XMLHttpRequest EventSource start_matrix_tokio].none? do |term|
    probe.include?(term)
  end && %w[componentMatrix nativeProductRuntime systemMaterialBinding deviceMatrix].all? do |key|
    probe.match?(/"#{key}":\s*false/)
  end

scenario_ids = component_matrix.fetch("scenarios").map { |scenario| scenario.fetch("id") }
checks["matrix.nine_unique_scenarios"] = scenario_ids.length == 9 && scenario_ids.uniq.length == 9
checks["matrix.synthetic_disclosure"] = component_matrix.fetch("scenarios")
  .select { |scenario| scenario["synthetic"] }
  .all? { |scenario| scenario.fetch("claimBoundary").include?("component") }
checks["matrix.runtime_and_authority_unclaimed"] =
  component_matrix.fetch("scenarios").all? { |scenario| scenario.fetch("runtimeStatus") == "REQUIRED_NOT_RUN" } &&
  component_matrix.dig("qualification", "componentMatrix") == false &&
  component_matrix.fetch("authority").values.none?
checks["runner.bounded_nine_scenario_evidence"] =
  runner.scan(/Scenario\.new\(/).length == 9 &&
  runner.include?("Process.spawn") && runner.include?("Timeout.timeout") &&
  runner.include?("Digest::SHA256.hexdigest") &&
  runner.include?("PASS_NATIVE_COMPONENT_MATRIX")
checks["schemas.fail_closed"] =
  scenario_schema.dig("properties", "qualification", "properties", "nativeProductRuntime", "const") == false &&
  aggregate_schema.dig("properties", "qualification", "properties", "systemMaterialBinding", "const") == false &&
  aggregate_schema.dig("properties", "scenarios", "minItems") == 9
checks["matrices.authority_and_runtime_unclaimed"] =
  control_matrix.fetch("authority").values.none? &&
  control_matrix.fetch("items").all? { |item| item.fetch("runtimeStatus") != "PASS" } &&
  material_matrix.fetch("authority").values.none? &&
  material_matrix.fetch("platforms").all? { |platform| platform.fetch("runtimeStatus") != "PASS" }
checks["workflow.read_only_source_compile_and_manual_matrix"] =
  workflow.include?("ruby scripts/hepta-ui-v4-window-ack-matrix-gate") &&
  %w[ubuntu-latest windows-latest macos-latest].all? { |os| workflow.include?(os) } &&
  workflow.include?("run_component_matrix") && workflow.include?("xvfb-run") &&
  workflow.include?("contents: read") &&
  !workflow.match?(/^\s*(?:deploy|publish|release)\s*:/i)

failed = checks.reject { |_name, passed| passed }
emit(
  checks,
  failed.empty? ? "PASS_WINDOW_ACK_COMPONENT_MATRIX_SOURCE_ONLY" : "FAIL_WINDOW_ACK_COMPONENT_MATRIX_SOURCE"
)
