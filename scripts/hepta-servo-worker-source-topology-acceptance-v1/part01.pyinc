#!/usr/bin/env python3
"""Review-only acceptance boundary for the verified Servo Worker source/API topology.

This standard-library-only tool verifies that an already accepted exact Servo
source pointer and a source/API topology verification receipt are consistently
bound. It can create a review challenge and verify a manually authored topology
pointer plus live GitHub review evidence. It never fetches, builds, links,
launches or executes Servo and has no command that creates or updates the
accepted topology pointer.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import importlib.util
import json
import os
import pathlib
import re
import stat
import sys
from types import ModuleType
from typing import Any

