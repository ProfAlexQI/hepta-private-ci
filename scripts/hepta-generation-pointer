#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  hepta-generation-pointer verify --active-program PATH [--verifier PATH]
  hepta-generation-pointer migrate --active-program PATH [--verifier PATH]
  hepta-generation-pointer cutover --active-program PATH --manifest PATH --expected-current-sha256 SHA [--verifier PATH]
  hepta-generation-pointer rollback --receipt PATH --expected-current-sha256 SHA [--verifier PATH]
  hepta-generation-pointer self-test
EOF
  exit 64
}

sha256_file() { shasum -a 256 "$1" | awk '{print $1}'; }
require_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]] || { echo "invalid SHA-256: $1" >&2; exit 1; }; }
canonical_file() {
  [[ -e "$1" ]] || { echo "path does not exist: $1" >&2; return 1; }
  local directory base
  directory="$(cd "$(dirname "$1")" && pwd -P)"
  base="$(basename "$1")"
  python3 - "$directory/$base" <<'PY'
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
}

default_verifier() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  printf '%s\n' "$script_dir/hepta-immutable-release-tree"
}

verify_manifest() {
  local verifier="$1" manifest="$2"
  "$verifier" verify --manifest "$manifest" >/dev/null
}

layout_paths() {
  local active_program="$1"
  ACTIVE_DIR="$(cd "$(dirname "$active_program")" && pwd -P)"
  ACTIVE_PROGRAM="$ACTIVE_DIR/$(basename "$active_program")"
  ACTIVE_MANIFEST="$ACTIVE_PROGRAM.manifest"
  INSTALL_ROOT="$(cd "$ACTIVE_DIR/.." && pwd -P)"
  GENERATION_LINK="$INSTALL_ROOT/active"
}

verify_layout() {
  local active_program="$1" verifier="$2"
  layout_paths "$active_program"
  [[ -L "$GENERATION_LINK" ]] || { echo "generation pointer is missing: $GENERATION_LINK" >&2; return 1; }
  [[ -L "$ACTIVE_PROGRAM" && "$(readlink "$ACTIVE_PROGRAM")" == "../active/bin/hepta" ]] || {
    echo "active program is not the stable generation-relative link" >&2
    return 1
  }
  [[ -L "$ACTIVE_MANIFEST" && "$(readlink "$ACTIVE_MANIFEST")" == "../active/manifest.json" ]] || {
    echo "active manifest is not the stable generation-relative link" >&2
    return 1
  }
  local release_dir manifest artifact expected_sha
  release_dir="$(canonical_file "$GENERATION_LINK")"
  manifest="$(canonical_file "$ACTIVE_MANIFEST")"
  [[ "$manifest" == "$release_dir/manifest.json" ]] || { echo "generation manifest escaped its release" >&2; return 1; }
  verify_manifest "$verifier" "$manifest"
  artifact="$release_dir/$(jq -r '.artifact.relative_path' "$manifest")"
  [[ "$(canonical_file "$ACTIVE_PROGRAM")" == "$(canonical_file "$artifact")" ]] || {
    echo "generation program and manifest do not resolve through one release" >&2
    return 1
  }
  expected_sha="$(jq -r '.artifact.sha256' "$manifest")"
  require_sha256 "$expected_sha"
  [[ "$(sha256_file "$ACTIVE_PROGRAM")" == "$expected_sha" ]] || {
    echo "generation artifact does not match its manifest" >&2
    return 1
  }
  jq -cn \
    --arg schema "hepta_generation_pointer_state_v1" \
    --arg generation_link "$GENERATION_LINK" \
    --arg release_dir "$release_dir" \
    --arg active_program "$ACTIVE_PROGRAM" \
    --arg active_manifest "$ACTIVE_MANIFEST" \
    --arg artifact_sha256 "$expected_sha" \
    --arg manifest_sha256 "$(sha256_file "$manifest")" \
    '{schema:$schema,status:"ready",generation_link:$generation_link,release_dir:$release_dir,active_program:$active_program,active_manifest:$active_manifest,artifact_sha256:$artifact_sha256,manifest_sha256:$manifest_sha256,single_atomic_pointer:true,crash_consistent_pair:true}'
}

migrate_layout() {
  local active_program="$1" verifier="$2"
  layout_paths "$active_program"
  if [[ -L "$GENERATION_LINK" ]]; then
    verify_layout "$ACTIVE_PROGRAM" "$verifier"
    return
  fi
  [[ ! -e "$GENERATION_LINK" ]] || { echo "generation path already exists and is not a symlink" >&2; exit 1; }
  [[ -f "$ACTIVE_PROGRAM" && -x "$ACTIVE_PROGRAM" && -f "$ACTIVE_MANIFEST" ]] || {
    echo "legacy active release pair is missing" >&2
    exit 1
  }
  verify_manifest "$verifier" "$ACTIVE_MANIFEST"
  local current_sha manifest_sha release_dir artifact tmp_suffix
  current_sha="$(sha256_file "$ACTIVE_PROGRAM")"
  manifest_sha="$(jq -r '.artifact.sha256' "$ACTIVE_MANIFEST")"
  [[ "$current_sha" == "$manifest_sha" ]] || { echo "legacy active release pair is inconsistent" >&2; exit 1; }
  release_dir="$(dirname "$(canonical_file "$ACTIVE_MANIFEST")")"
  artifact="$release_dir/$(jq -r '.artifact.relative_path' "$ACTIVE_MANIFEST")"
  [[ "$(canonical_file "$ACTIVE_PROGRAM")" == "$(canonical_file "$artifact")" ]] || {
    echo "legacy active pair does not resolve to one immutable release" >&2
    exit 1
  }
  tmp_suffix="$$.$RANDOM"
  ln -s "$release_dir" "$INSTALL_ROOT/.active-generation.$tmp_suffix"
  mv -fh "$INSTALL_ROOT/.active-generation.$tmp_suffix" "$GENERATION_LINK"
  ln -s "../active/manifest.json" "$ACTIVE_DIR/.hepta-generation-manifest.$tmp_suffix"
  mv -f "$ACTIVE_DIR/.hepta-generation-manifest.$tmp_suffix" "$ACTIVE_MANIFEST"
  ln -s "../active/bin/hepta" "$ACTIVE_DIR/.hepta-generation-program.$tmp_suffix"
  mv -f "$ACTIVE_DIR/.hepta-generation-program.$tmp_suffix" "$ACTIVE_PROGRAM"
  verify_layout "$ACTIVE_PROGRAM" "$verifier" >/dev/null
  jq -cn \
    --arg schema "hepta_generation_pointer_migration_v1" \
    --arg generation_link "$GENERATION_LINK" \
    --arg release_dir "$release_dir" \
    --arg artifact_sha256 "$current_sha" \
    '{schema:$schema,status:"ready",generation_link:$generation_link,release_dir:$release_dir,artifact_sha256:$artifact_sha256,bytes_changed:false,single_atomic_pointer:true,crash_consistent_pair:true,service_restarted:false}'
}

cutover_generation() {
  local active_program="$1" verifier="$2" manifest="$3" expected_current_sha="$4"
  require_sha256 "$expected_current_sha"
  verify_layout "$active_program" "$verifier" >/dev/null
  layout_paths "$active_program"
  manifest="$(canonical_file "$manifest")"
  verify_manifest "$verifier" "$manifest"
  local current_release current_manifest current_sha target_release target_sha suffix
  current_release="$(canonical_file "$GENERATION_LINK")"
  current_manifest="$current_release/manifest.json"
  current_sha="$(sha256_file "$ACTIVE_PROGRAM")"
  [[ "$current_sha" == "$expected_current_sha" ]] || { echo "active generation changed since review" >&2; exit 1; }
  target_release="$(dirname "$manifest")"
  target_sha="$(jq -r '.artifact.sha256' "$manifest")"
  require_sha256 "$target_sha"
  [[ "$target_sha" != "$current_sha" ]] || { echo "generation cutover requires different target bytes" >&2; exit 1; }
  suffix="$$.$RANDOM"
  ln -s "$target_release" "$INSTALL_ROOT/.active-generation.$suffix"
  [[ "$(sha256_file "$INSTALL_ROOT/.active-generation.$suffix/bin/hepta")" == "$target_sha" ]] || {
    echo "staged generation artifact SHA-256 mismatch" >&2
    exit 1
  }
  mv -fh "$INSTALL_ROOT/.active-generation.$suffix" "$GENERATION_LINK"
  verify_layout "$ACTIVE_PROGRAM" "$verifier" >/dev/null
  jq -cn \
    --arg schema "hepta_generation_pointer_cutover_receipt_v1" \
    --arg generation_link "$GENERATION_LINK" \
    --arg active_program "$ACTIVE_PROGRAM" \
    --arg active_manifest "$ACTIVE_MANIFEST" \
    --arg previous_release "$current_release" \
    --arg previous_artifact_sha256 "$current_sha" \
    --arg previous_manifest_sha256 "$(sha256_file "$current_manifest")" \
    --arg deployed_release "$target_release" \
    --arg deployed_artifact_sha256 "$target_sha" \
    --arg deployed_manifest_sha256 "$(sha256_file "$manifest")" \
    '{schema:$schema,status:"ready",generation_link:$generation_link,active_program:$active_program,active_manifest:$active_manifest,previous:{release:$previous_release,artifact_sha256:$previous_artifact_sha256,manifest_sha256:$previous_manifest_sha256},deployed:{release:$deployed_release,artifact_sha256:$deployed_artifact_sha256,manifest_sha256:$deployed_manifest_sha256},cas_verified:true,bytes_changed:true,single_atomic_pointer:true,crash_consistent_pair:true,service_restarted:false}'
}

rollback_generation() {
  local receipt="$1" verifier="$2" expected_current_sha="$3"
  require_sha256 "$expected_current_sha"
  [[ -f "$receipt" && ! -L "$receipt" ]] || { echo "generation rollback receipt must be regular" >&2; exit 1; }
  jq -e '
    .schema == "hepta_generation_pointer_cutover_receipt_v1"
    and .status == "ready"
    and .single_atomic_pointer == true
    and .crash_consistent_pair == true
    and (.previous.release | startswith("/"))
    and (.deployed.release | startswith("/"))
  ' "$receipt" >/dev/null || { echo "invalid generation rollback receipt" >&2; exit 1; }
  local active_program generation_link previous_release previous_sha deployed_release deployed_sha suffix
  active_program="$(jq -r '.active_program' "$receipt")"
  generation_link="$(jq -r '.generation_link' "$receipt")"
  previous_release="$(jq -r '.previous.release' "$receipt")"
  previous_sha="$(jq -r '.previous.artifact_sha256' "$receipt")"
  deployed_release="$(jq -r '.deployed.release' "$receipt")"
  deployed_sha="$(jq -r '.deployed.artifact_sha256' "$receipt")"
  [[ "$expected_current_sha" == "$deployed_sha" ]] || { echo "rollback CAS differs from receipt" >&2; exit 1; }
  verify_layout "$active_program" "$verifier" >/dev/null
  [[ "$(canonical_file "$generation_link")" == "$deployed_release" \
    && "$(sha256_file "$active_program")" == "$deployed_sha" ]] || {
    echo "deployed generation changed since rollback review" >&2
    exit 1
  }
  verify_manifest "$verifier" "$previous_release/manifest.json"
  [[ "$(sha256_file "$previous_release/bin/hepta")" == "$previous_sha" ]] || {
    echo "previous generation artifact no longer matches receipt" >&2
    exit 1
  }
  suffix="$$.$RANDOM"
  ln -s "$previous_release" "$(dirname "$generation_link")/.active-generation.$suffix"
  mv -fh "$(dirname "$generation_link")/.active-generation.$suffix" "$generation_link"
  verify_layout "$active_program" "$verifier" >/dev/null
  jq -cn --arg schema "hepta_generation_pointer_rollback_receipt_v1" \
    --arg generation_link "$generation_link" --arg restored_release "$previous_release" \
    --arg artifact_sha256 "$previous_sha" \
    '{schema:$schema,status:"ready",generation_link:$generation_link,restored_release:$restored_release,artifact_sha256:$artifact_sha256,cas_verified:true,single_atomic_pointer:true,crash_consistent_pair:true,service_restarted:false}'
}

self_test() {
  local root install_root verifier release_a release_b sha_a sha_b cutover_receipt
  root="$(mktemp -d /tmp/hepta-generation-pointer-self-test.XXXXXX)"
  trap "chmod -R u+w '$root' 2>/dev/null || true; rm -R '$root'" EXIT
  install_root="$root/install"
  release_a="$install_root/releases/a"
  release_b="$install_root/releases/b"
  mkdir -p "$install_root/bin" "$release_a/bin" "$release_b/bin"
  printf 'release-a\n' >"$release_a/bin/hepta"
  printf 'release-b\n' >"$release_b/bin/hepta"
  chmod 0555 "$release_a/bin/hepta" "$release_b/bin/hepta"
  sha_a="$(sha256_file "$release_a/bin/hepta")"
  sha_b="$(sha256_file "$release_b/bin/hepta")"
  jq -n --arg sha "$sha_a" '{artifact:{relative_path:"bin/hepta",sha256:$sha}}' >"$release_a/manifest.json"
  jq -n --arg sha "$sha_b" '{artifact:{relative_path:"bin/hepta",sha256:$sha}}' >"$release_b/manifest.json"
  chmod 0444 "$release_a/manifest.json" "$release_b/manifest.json"
  chmod 0555 "$release_a" "$release_b"
  verifier="$root/verifier"
  cat >"$verifier" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$1" == "verify" && "$2" == "--manifest" ]]
manifest="$3"
manifest="$(python3 - "$manifest" <<'PY'
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
)"
artifact="$(dirname "$manifest")/$(jq -r '.artifact.relative_path' "$manifest")"
[[ "$(shasum -a 256 "$artifact" | awk '{print $1}')" == "$(jq -r '.artifact.sha256' "$manifest")" ]]
EOF
  chmod 0555 "$verifier"
  ln -s "$release_a/bin/hepta" "$install_root/bin/hepta"
  ln -s "$release_a/manifest.json" "$install_root/bin/hepta.manifest"
  migrate_layout "$install_root/bin/hepta" "$verifier" >/dev/null
  verify_layout "$install_root/bin/hepta" "$verifier" >/dev/null
  cutover_receipt="$root/cutover.json"
  cutover_generation "$install_root/bin/hepta" "$verifier" "$release_b/manifest.json" "$sha_a" >"$cutover_receipt"
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_b" ]]
  if (cutover_generation "$install_root/bin/hepta" "$verifier" "$release_a/manifest.json" "$sha_a") >/dev/null 2>&1; then
    echo "generation cutover accepted stale CAS" >&2
    exit 1
  fi
  rollback_generation "$cutover_receipt" "$verifier" "$sha_b" >/dev/null
  [[ "$(sha256_file "$install_root/bin/hepta")" == "$sha_a" ]]
  jq -cn '{schema:"hepta_generation_pointer_self_test_v1",status:"ready",migration_preserved_bytes:true,cutover_single_pointer:true,rollback_single_pointer:true,stale_cas_denied:true,crash_consistent_pair:true}'
}

command="${1:-}"
[[ -n "$command" ]] || usage
shift
active_program="" manifest="" receipt="" expected_current_sha="" verifier="$(default_verifier)"
while (( $# > 0 )); do
  case "$1" in
    --active-program) shift; [[ $# -gt 0 ]] || usage; active_program="$1" ;;
    --manifest) shift; [[ $# -gt 0 ]] || usage; manifest="$1" ;;
    --receipt) shift; [[ $# -gt 0 ]] || usage; receipt="$1" ;;
    --expected-current-sha256) shift; [[ $# -gt 0 ]] || usage; expected_current_sha="$1" ;;
    --verifier) shift; [[ $# -gt 0 ]] || usage; verifier="$1" ;;
    *) usage ;;
  esac
  shift
done
case "$command" in
  verify) [[ -n "$active_program" ]] || usage; verify_layout "$active_program" "$verifier" ;;
  migrate) [[ -n "$active_program" ]] || usage; migrate_layout "$active_program" "$verifier" ;;
  cutover) [[ -n "$active_program" && -n "$manifest" && -n "$expected_current_sha" ]] || usage; cutover_generation "$active_program" "$verifier" "$manifest" "$expected_current_sha" ;;
  rollback) [[ -n "$receipt" && -n "$expected_current_sha" ]] || usage; rollback_generation "$receipt" "$verifier" "$expected_current_sha" ;;
  self-test) [[ -z "$active_program$manifest$receipt$expected_current_sha" ]] || usage; self_test ;;
  *) usage ;;
esac
