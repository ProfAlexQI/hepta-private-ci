#!/usr/bin/env bash
set -euo pipefail

IMAGE_PATH=""
TEMPLATE_PATH=""
MODE=""
REPORT_PATH=""

usage() {
  cat <<'EOF'
usage: scripts/hepta-android-login-template-probe \
  --image /absolute/capture.png \
  --template /absolute/reference.png \
  --mode portrait|landscape|ime \
  [--output /absolute/report.json]

Downsamples an Android emulator capture and a versioned login-surface template
to the same fixed geometry, compares RGB/luma edges plus dark/Hepta-teal masks,
and emits a deterministic machine-readable template-match report. This is a
bounded visual identity check, not OCR or semantic accessibility evidence.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image) IMAGE_PATH="${2:-}"; shift 2 ;;
    --template) TEMPLATE_PATH="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --output) REPORT_PATH="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 64 ;;
  esac
done

[[ -s "$IMAGE_PATH" ]] || { echo "error: --image must be a non-empty image" >&2; exit 64; }
[[ -s "$TEMPLATE_PATH" ]] || { echo "error: --template must be a non-empty image" >&2; exit 64; }
case "$MODE" in
  portrait|ime) WIDTH=64; HEIGHT=128 ;;
  landscape) WIDTH=128; HEIGHT=64 ;;
  *) echo "error: --mode must be portrait, landscape, or ime" >&2; exit 64 ;;
esac
for command in jq mktemp ruby shasum sips; do
  command -v "$command" >/dev/null 2>&1 || { echo "error: $command is required" >&2; exit 2; }
done

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/hepta-android-login-template.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT
IMAGE_BMP="$TMP_DIR/image.bmp"
TEMPLATE_BMP="$TMP_DIR/template.bmp"
sips -z "$HEIGHT" "$WIDTH" -s format bmp "$IMAGE_PATH" --out "$IMAGE_BMP" >/dev/null
sips -z "$HEIGHT" "$WIDTH" -s format bmp "$TEMPLATE_PATH" --out "$TEMPLATE_BMP" >/dev/null

REPORT="$(ruby -rjson -rdigest -e '
  image_path, template_path, image_bmp, template_bmp, mode, width_text, height_text = ARGV
  expected_width = Integer(width_text, 10)
  expected_height = Integer(height_text, 10)

  decode = lambda do |path|
    data = File.binread(path)
    abort "invalid BMP signature" unless data.byteslice(0, 2) == "BM".b
    pixel_offset = data.byteslice(10, 4).unpack1("V")
    width = data.byteslice(18, 4).unpack1("l<")
    raw_height = data.byteslice(22, 4).unpack1("l<")
    bits = data.byteslice(28, 2).unpack1("v")
    compression = data.byteslice(30, 4).unpack1("V")
    abort "unexpected normalized geometry" unless width == expected_width && raw_height.abs == expected_height
    abort "unsupported normalized BMP" unless [24, 32].include?(bits) && [0, 3].include?(compression)
    bytes = bits / 8
    row_stride = ((width * bits + 31) / 32) * 4
    top_down = raw_height.negative?
    pixels = Array.new(width * expected_height)
    expected_height.times do |y|
      stored_y = top_down ? y : (expected_height - 1 - y)
      width.times do |x|
        offset = pixel_offset + stored_y * row_stride + x * bytes
        b = data.getbyte(offset)
        g = data.getbyte(offset + 1)
        r = data.getbyte(offset + 2)
        pixels[y * width + x] = [r, g, b]
      end
    end
    pixels
  end

  image = decode.call(image_bmp)
  template = decode.call(template_bmp)
  count = image.length
  luma = ->(rgb) { (rgb[0] * 299 + rgb[1] * 587 + rgb[2] * 114) / 1000.0 }
  teal = ->(rgb) { rgb[0] < 85 && rgb[1].between?(75, 175) && rgb[2].between?(90, 205) && rgb[2] > rgb[0] + 35 }
  dark = ->(rgb) { luma.call(rgb) < 95 }

  rgb_error = image.zip(template).sum do |actual, expected|
    (actual[0] - expected[0]).abs + (actual[1] - expected[1]).abs + (actual[2] - expected[2]).abs
  end.fdiv(count * 3)

  edge_error_sum = 0.0
  edge_samples = 0
  expected_height.times do |y|
    expected_width.times do |x|
      index = y * expected_width + x
      if x + 1 < expected_width
        a = (luma.call(image[index + 1]) - luma.call(image[index])).abs
        b = (luma.call(template[index + 1]) - luma.call(template[index])).abs
        edge_error_sum += (a - b).abs
        edge_samples += 1
      end
      if y + 1 < expected_height
        a = (luma.call(image[index + expected_width]) - luma.call(image[index])).abs
        b = (luma.call(template[index + expected_width]) - luma.call(template[index])).abs
        edge_error_sum += (a - b).abs
        edge_samples += 1
      end
    end
  end
  edge_error = edge_error_sum.fdiv(edge_samples)

  mask_iou = lambda do |predicate|
    intersection = 0
    union = 0
    image.zip(template).each do |actual, expected|
      actual_on = predicate.call(actual)
      expected_on = predicate.call(expected)
      intersection += 1 if actual_on && expected_on
      union += 1 if actual_on || expected_on
    end
    union.zero? ? 1.0 : intersection.fdiv(union)
  end
  teal_iou = mask_iou.call(teal)
  dark_iou = mask_iou.call(dark)

  thresholds = {
    max_rgb_mean_absolute_error: 12.0,
    max_luma_edge_mean_absolute_error: 13.0,
    min_hepta_teal_mask_iou: 0.72,
    min_dark_shape_mask_iou: 0.58,
    max_component_rgb_mean_absolute_error: 16.0,
  }
  detections = [
    {name: "normalized_rgb_template", ready: rgb_error <= thresholds[:max_rgb_mean_absolute_error], score: rgb_error, comparator: "lte", threshold: thresholds[:max_rgb_mean_absolute_error], normalized_box: [0.0, 0.0, 1.0, 1.0]},
    {name: "luma_edge_structure", ready: edge_error <= thresholds[:max_luma_edge_mean_absolute_error], score: edge_error, comparator: "lte", threshold: thresholds[:max_luma_edge_mean_absolute_error], normalized_box: [0.0, 0.0, 1.0, 1.0]},
    {name: "hepta_teal_geometry", ready: teal_iou >= thresholds[:min_hepta_teal_mask_iou], score: teal_iou, comparator: "gte", threshold: thresholds[:min_hepta_teal_mask_iou], normalized_box: [0.08, 0.04, 0.84, 0.92]},
    {name: "dark_text_and_provider_geometry", ready: dark_iou >= thresholds[:min_dark_shape_mask_iou], score: dark_iou, comparator: "gte", threshold: thresholds[:min_dark_shape_mask_iou], normalized_box: [0.04, 0.03, 0.92, 0.94]},
  ]

  component_boxes = case mode
  when "portrait"
    {
      "hepta_badge" => [0.40, 0.04, 0.20, 0.09],
      "sign_in_to_hepta_title" => [0.22, 0.11, 0.56, 0.06],
      "user_id_input" => [0.15, 0.17, 0.70, 0.07],
      "password_input" => [0.15, 0.23, 0.70, 0.07],
      "homeserver_input" => [0.15, 0.29, 0.70, 0.08],
      "login_action" => [0.15, 0.38, 0.70, 0.07],
      "sso_provider_row" => [0.13, 0.46, 0.74, 0.10],
      "sign_up_action" => [0.34, 0.57, 0.32, 0.08],
    }
  when "landscape"
    {
      "hepta_badge" => [0.25, 0.07, 0.10, 0.17],
      "sign_in_to_hepta_title" => [0.19, 0.23, 0.22, 0.10],
      "user_id_input" => [0.14, 0.33, 0.32, 0.12],
      "password_input" => [0.14, 0.45, 0.32, 0.12],
      "homeserver_input" => [0.14, 0.57, 0.32, 0.12],
      "login_action" => [0.14, 0.76, 0.32, 0.13],
      "sso_provider_row" => [0.48, 0.13, 0.32, 0.18],
      "sign_up_action" => [0.55, 0.38, 0.16, 0.13],
    }
  else
    {
      "hepta_badge" => [0.40, 0.04, 0.20, 0.09],
      "sign_in_to_hepta_title" => [0.22, 0.11, 0.56, 0.06],
      "user_id_input" => [0.15, 0.17, 0.70, 0.07],
      "password_input" => [0.15, 0.23, 0.70, 0.07],
      "homeserver_input_focused" => [0.15, 0.29, 0.70, 0.08],
      "login_action" => [0.15, 0.38, 0.70, 0.07],
      "same_login_form_above_ime" => [0.08, 0.04, 0.84, 0.58],
      "ime_keyboard" => [0.00, 0.64, 1.00, 0.34],
    }
  end
  component_boxes.each do |name, box|
    x0 = (box[0] * expected_width).floor.clamp(0, expected_width - 1)
    y0 = (box[1] * expected_height).floor.clamp(0, expected_height - 1)
    x1 = ((box[0] + box[2]) * expected_width).ceil.clamp(x0 + 1, expected_width)
    y1 = ((box[1] + box[3]) * expected_height).ceil.clamp(y0 + 1, expected_height)
    indices = (y0...y1).flat_map { |y| (x0...x1).map { |x| y * expected_width + x } }
    error = indices.sum do |index|
      actual = image[index]
      expected = template[index]
      (actual[0] - expected[0]).abs + (actual[1] - expected[1]).abs + (actual[2] - expected[2]).abs
    end.fdiv(indices.length * 3)
    detections << {
      name: name,
      ready: error <= thresholds[:max_component_rgb_mean_absolute_error],
      score: error,
      comparator: "lte",
      threshold: thresholds[:max_component_rgb_mean_absolute_error],
      normalized_box: box,
    }
  end
  ready = detections.all? { |item| item[:ready] }
  report = {
    schema_version: 1,
    kind: "hepta-android-login-template-probe",
    status: ready ? "ready" : "not_ready",
    ready: ready,
    mode: mode,
    image: {path: File.expand_path(image_path), sha256: Digest::SHA256.file(image_path).hexdigest},
    template: {path: File.expand_path(template_path), sha256: Digest::SHA256.file(template_path).hexdigest, width: expected_width, height: expected_height},
    algorithm: "normalized_rgb_luma_edge_and_color_mask_v1",
    detections: detections,
    metrics: {rgb_mean_absolute_error: rgb_error, luma_edge_mean_absolute_error: edge_error, hepta_teal_mask_iou: teal_iou, dark_shape_mask_iou: dark_iou},
    thresholds: thresholds,
    claim_boundary: "login_surface_visual_template_only_not_semantic_accessibility_or_authentication",
  }
  puts JSON.pretty_generate(report)
' "$IMAGE_PATH" "$TEMPLATE_PATH" "$IMAGE_BMP" "$TEMPLATE_BMP" "$MODE" "$WIDTH" "$HEIGHT")"

if [[ -n "$REPORT_PATH" ]]; then
  [[ "$REPORT_PATH" = /* ]] || { echo "error: --output must be absolute" >&2; exit 64; }
  mkdir -p "$(dirname "$REPORT_PATH")"
  printf '%s\n' "$REPORT" >"$REPORT_PATH"
fi
printf '%s\n' "$REPORT"
jq -e '.ready == true' >/dev/null <<<"$REPORT"
