#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
UNIFIED_RUNNER="$ROOT/scripts/hepta-route-gate-runner"
UNIFIED_REGISTRY="$ROOT/scripts/hepta-route-gate-specs-v1.json"
MEMORY_COMPAT_RUNNER="$ROOT/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-runner"
MEMORY_COMPAT_REGISTRY="$ROOT/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json"
RUNTIME_COMPAT_RUNNER="$ROOT/scripts/hepta-runtime-provider-router-activation-command-result-receipt-route-gate-runner"
RUNTIME_COMPAT_REGISTRY="$ROOT/scripts/hepta-runtime-provider-router-activation-command-result-receipt-route-gate-specs-v1.json"
ARTIFACT_COMPAT_RUNNER="$ROOT/scripts/hepta-artifact-signing-receipt-route-gate-runner"
ARTIFACT_COMPAT_REGISTRY="$ROOT/scripts/hepta-artifact-signing-receipt-route-gate-specs-v1.json"
RELEASE_COMPAT_RUNNER="$ROOT/scripts/hepta-release-publication-result-receipt-route-gate-runner"
RELEASE_COMPAT_REGISTRY="$ROOT/scripts/hepta-release-publication-result-receipt-route-gate-specs-v1.json"
ARTIFACT_DOWNLOAD_COMPAT_RUNNER="$ROOT/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-runner"
ARTIFACT_DOWNLOAD_COMPAT_REGISTRY="$ROOT/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-specs-v1.json"
MODE="${1:---schema}"

[[ "$MODE" == "--schema" || "$MODE" == "--runtime-parity" ]] || {
  echo "usage: scripts/hepta-route-gate-family-registry-self-test [--schema|--runtime-parity]" >&2
  exit 2
}

expected_unified_validation='{"schema":"hepta_route_gate_specs_validation_v1","status":"ready","family_count":6,"spec_count":18}'
expected_memory_validation='{"schema":"hepta_memory_live_mutation_activation_command_result_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
expected_runtime_validation='{"schema":"hepta_runtime_provider_router_activation_command_result_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
expected_artifact_validation='{"schema":"hepta_artifact_signing_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
expected_release_validation='{"schema":"hepta_release_publication_result_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
expected_artifact_download_validation='{"schema":"hepta_artifact_download_install_affordance_result_receipt_route_gate_specs_validation_v1","status":"ready","family_count":1,"spec_count":3}'
[[ "$("$UNIFIED_RUNNER" --validate)" == "$expected_unified_validation" ]]
[[ "$("$MEMORY_COMPAT_RUNNER" --validate)" == "$expected_memory_validation" ]]
[[ "$("$RUNTIME_COMPAT_RUNNER" --validate)" == "$expected_runtime_validation" ]]
[[ "$("$ARTIFACT_COMPAT_RUNNER" --validate)" == "$expected_artifact_validation" ]]
[[ "$("$RELEASE_COMPAT_RUNNER" --validate)" == "$expected_release_validation" ]]
[[ "$("$ARTIFACT_DOWNLOAD_COMPAT_RUNNER" --validate)" == "$expected_artifact_download_validation" ]]

fixture_root="$(mktemp -d /tmp/hepta-route-gate-family-registry.XXXXXX)"
trap 'rm -rf "$fixture_root"' EXIT

reset_fixture() {
  rm -rf "$fixture_root/scripts"
  mkdir -p "$fixture_root/scripts"
  cp "$UNIFIED_RUNNER" "$fixture_root/scripts/hepta-route-gate-runner"
  cp "$UNIFIED_REGISTRY" "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
  cp "$MEMORY_COMPAT_REGISTRY" \
    "$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json"
  cp "$RUNTIME_COMPAT_REGISTRY" \
    "$fixture_root/scripts/hepta-runtime-provider-router-activation-command-result-receipt-route-gate-specs-v1.json"
  cp "$ARTIFACT_COMPAT_REGISTRY" \
    "$fixture_root/scripts/hepta-artifact-signing-receipt-route-gate-specs-v1.json"
  cp "$RELEASE_COMPAT_REGISTRY" \
    "$fixture_root/scripts/hepta-release-publication-result-receipt-route-gate-specs-v1.json"
  cp "$ARTIFACT_DOWNLOAD_COMPAT_REGISTRY" \
    "$fixture_root/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-specs-v1.json"
  chmod +x "$fixture_root/scripts/hepta-route-gate-runner"
}

replace_json() {
  local filter="$1"
  local target="$2"
  local staged="$target.next"
  jq "$filter" "$target" >"$staged"
  mv "$staged" "$target"
}

assert_fixture_rejected() {
  local label="$1"
  if "$fixture_root/scripts/hepta-route-gate-runner" --validate \
    >"$fixture_root/$label.stdout" 2>"$fixture_root/$label.stderr"; then
    echo "route gate family negative fixture unexpectedly passed: $label" >&2
    exit 1
  fi
}

reset_fixture
replace_json '.families[1].id = .families[0].id' \
  "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
assert_fixture_rejected duplicate_family_id

reset_fixture
replace_json '.families[1].execution_profile = "unknown_profile_v1"' \
  "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
assert_fixture_rejected unknown_execution_profile

reset_fixture
replace_json '.families[1].spec_registry = "../escape.json"' \
  "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
assert_fixture_rejected registry_path_traversal

reset_fixture
replace_json '.families[1].spec_registry = "scripts/hepta-missing-route-gate-specs-v1.json"' \
  "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
assert_fixture_rejected missing_family_registry

reset_fixture
replace_json '.schema_version = "wrong_schema_v1"' \
  "$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected incompatible_family_schema

reset_fixture
replace_json '.schema_version = "wrong_schema_v1"' \
  "$fixture_root/scripts/hepta-runtime-provider-router-activation-command-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected incompatible_second_family_schema

reset_fixture
replace_json '.schema_version = "wrong_schema_v1"' \
  "$fixture_root/scripts/hepta-release-publication-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected incompatible_release_publication_family_schema

reset_fixture
replace_json '.schema_version = "wrong_schema_v1"' \
  "$fixture_root/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected incompatible_artifact_download_family_schema

reset_fixture
replace_json '.specs[0].source.mode = "live"' \
  "$fixture_root/scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected invalid_artifact_download_source_mode

reset_fixture
replace_json '.families[5].profile_suffix_ladder |= reverse' \
  "$fixture_root/scripts/hepta-route-gate-specs-v1.json"
assert_fixture_rejected reordered_artifact_download_suffix_ladder

reset_fixture
replace_json '.specs[0].baseline_normalized_output_sha256 = "not-a-sha"' \
  "$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected invalid_normalized_output_receipt

reset_fixture
duplicate_id="$(jq -r '.families[0].specs[0].id' "$fixture_root/scripts/hepta-route-gate-specs-v1.json")"
staged="$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json.next"
jq --arg id "$duplicate_id" '
  .specs[0].id = $id
  | .specs[0].gate_spec.pattern = ("/api/" + $id)
  | .specs[0].gate_spec.source_command = ("/" + $id + " --json")
  | .specs[0].gate_spec.capability = $id
' "$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json" >"$staged"
mv "$staged" \
  "$fixture_root/scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-specs-v1.json"
assert_fixture_rejected duplicate_cross_family_spec_id

set +e
compat_usage="$($MEMORY_COMPAT_RUNNER 2>&1)"
compat_usage_rc=$?
compat_unknown="$($MEMORY_COMPAT_RUNNER hepta-unknown-memory-route 2>&1)"
compat_unknown_rc=$?
runtime_usage="$($RUNTIME_COMPAT_RUNNER 2>&1)"
runtime_usage_rc=$?
runtime_unknown="$($RUNTIME_COMPAT_RUNNER hepta-unknown-runtime-route 2>&1)"
runtime_unknown_rc=$?
runtime_id="$(jq -r '.specs[0].id' "$RUNTIME_COMPAT_REGISTRY")"
runtime_invalid_soak="$(HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES=invalid "$RUNTIME_COMPAT_RUNNER" "$runtime_id" 2>&1)"
runtime_invalid_soak_rc=$?
runtime_below_soak="$(HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES=23 "$RUNTIME_COMPAT_RUNNER" "$runtime_id" 2>&1)"
runtime_below_soak_rc=$?
artifact_usage="$($ARTIFACT_COMPAT_RUNNER 2>&1)"
artifact_usage_rc=$?
artifact_unknown="$($ARTIFACT_COMPAT_RUNNER hepta-unknown-artifact-signing-route 2>&1)"
artifact_unknown_rc=$?
release_usage="$($RELEASE_COMPAT_RUNNER 2>&1)"
release_usage_rc=$?
release_unknown="$($RELEASE_COMPAT_RUNNER hepta-unknown-release-publication-route 2>&1)"
release_unknown_rc=$?
artifact_download_usage="$($ARTIFACT_DOWNLOAD_COMPAT_RUNNER 2>&1)"
artifact_download_usage_rc=$?
artifact_download_unknown="$($ARTIFACT_DOWNLOAD_COMPAT_RUNNER hepta-unknown-artifact-route 2>&1)"
artifact_download_unknown_rc=$?
artifact_download_id="$(jq -r '.specs[2].id' "$ARTIFACT_DOWNLOAD_COMPAT_REGISTRY")"
artifact_download_invalid_soak="$(HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES=invalid "$ARTIFACT_DOWNLOAD_COMPAT_RUNNER" "$artifact_download_id" 2>&1)"
artifact_download_invalid_soak_rc=$?
artifact_download_below_soak="$(HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES=23 "$ARTIFACT_DOWNLOAD_COMPAT_RUNNER" "$artifact_download_id" 2>&1)"
artifact_download_below_soak_rc=$?
set -e
[[ "$compat_usage_rc" == 2 ]]
[[ "$compat_usage" == \
  "usage: scripts/hepta-memory-live-mutation-activation-command-result-receipt-route-gate-runner <id|--validate>" ]]
[[ "$compat_unknown_rc" == 1 ]]
[[ "$compat_unknown" == \
  "unknown Memory live-mutation activation-command result-receipt route spec id: hepta-unknown-memory-route" ]]
[[ "$runtime_usage_rc" == 2 ]]
[[ "$runtime_usage" == \
  "usage: scripts/hepta-runtime-provider-router-activation-command-result-receipt-route-gate-runner <id|--validate>" ]]
[[ "$runtime_unknown_rc" == 1 ]]
[[ "$runtime_unknown" == \
  "unknown runtime provider-router activation-command result-receipt route spec id: hepta-unknown-runtime-route" ]]
[[ "$runtime_invalid_soak_rc" == 2 ]]
[[ "$runtime_invalid_soak" == \
  "HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES must be an unsigned integer" ]]
[[ "$runtime_below_soak_rc" == 1 ]]
[[ "$runtime_below_soak" == "minimum long-soak samples must be at least 24" ]]
[[ "$artifact_usage_rc" == 2 ]]
[[ "$artifact_usage" == \
  "usage: scripts/hepta-artifact-signing-receipt-route-gate-runner <id|--validate>" ]]
[[ "$artifact_unknown_rc" == 1 ]]
[[ "$artifact_unknown" == \
  "unknown artifact-signing receipt route spec id: hepta-unknown-artifact-signing-route" ]]
[[ "$release_usage_rc" == 2 ]]
[[ "$release_usage" == \
  "usage: scripts/hepta-release-publication-result-receipt-route-gate-runner <id|--validate>" ]]
[[ "$release_unknown_rc" == 1 ]]
[[ "$release_unknown" == \
  "unknown release-publication result-receipt route spec id: hepta-unknown-release-publication-route" ]]
[[ "$artifact_download_usage_rc" == 2 ]]
[[ "$artifact_download_usage" == \
  "usage: scripts/hepta-artifact-download-install-affordance-result-receipt-route-gate-runner <id|--validate>" ]]
[[ "$artifact_download_unknown_rc" == 1 ]]
[[ "$artifact_download_unknown" == \
  "unknown artifact download/install affordance result-receipt route spec id: hepta-unknown-artifact-route" ]]
[[ "$artifact_download_invalid_soak_rc" == 2 ]]
[[ "$artifact_download_invalid_soak" == \
  "HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES must be an unsigned integer of at least 24" ]]
[[ "$artifact_download_below_soak_rc" == 2 ]]
[[ "$artifact_download_below_soak" == \
  "HEPTA_LIVE_MUTATION_MIN_SOAK_SAMPLES must be an unsigned integer of at least 24" ]]

assert_runtime_parity() {
  local compatibility_runner="$1"
  local compatibility_registry="$2"
  local message_stream="$3"
  local id parity_index=0 parity_prefix
  while IFS= read -r id; do
    parity_index=$((parity_index + 1))
    parity_prefix="$fixture_root/parity-$parity_index"
    "$UNIFIED_RUNNER" "$id" >"$parity_prefix.unified.out" 2>"$parity_prefix.unified.err"
    "$compatibility_runner" "$id" >"$parity_prefix.compat.out" 2>"$parity_prefix.compat.err"
    if [[ "$message_stream" == "stdout" ]]; then
      [[ "$(tail -n 1 "$parity_prefix.unified.out")" == \
        "$(jq -r --arg id "$id" '.specs[] | select(.id == $id) | .pass_message' "$compatibility_registry")" ]]
      [[ "$(tail -n 1 "$parity_prefix.compat.out")" == \
        "$(tail -n 1 "$parity_prefix.unified.out")" ]]
      sed '$d' "$parity_prefix.unified.out" >"$parity_prefix.unified.json"
      sed '$d' "$parity_prefix.compat.out" >"$parity_prefix.compat.json"
    else
      cp "$parity_prefix.unified.out" "$parity_prefix.unified.json"
      cp "$parity_prefix.compat.out" "$parity_prefix.compat.json"
      if [[ "$message_stream" == "stderr" ]]; then
        [[ "$(cat "$parity_prefix.unified.err")" == \
          "$(jq -r --arg id "$id" '.specs[] | select(.id == $id) | .pass_message' "$compatibility_registry")" ]]
      fi
    fi
    cmp "$parity_prefix.unified.err" "$parity_prefix.compat.err"
    jq -S 'del(.focused_test_log)' "$parity_prefix.unified.json" \
      >"$parity_prefix.unified.normalized.json"
    jq -S 'del(.focused_test_log)' "$parity_prefix.compat.json" \
      >"$parity_prefix.compat.normalized.json"
    cmp "$parity_prefix.unified.normalized.json" \
      "$parity_prefix.compat.normalized.json"
  done < <(jq -r '.specs[].id' "$compatibility_registry")
}

if [[ "$MODE" == "--runtime-parity" ]]; then
  assert_runtime_parity "$MEMORY_COMPAT_RUNNER" "$MEMORY_COMPAT_REGISTRY" none
  assert_runtime_parity "$RUNTIME_COMPAT_RUNNER" "$RUNTIME_COMPAT_REGISTRY" stdout
  assert_runtime_parity "$ARTIFACT_COMPAT_RUNNER" "$ARTIFACT_COMPAT_REGISTRY" stdout
  assert_runtime_parity "$RELEASE_COMPAT_RUNNER" "$RELEASE_COMPAT_REGISTRY" stdout
  assert_runtime_parity "$ARTIFACT_DOWNLOAD_COMPAT_RUNNER" "$ARTIFACT_DOWNLOAD_COMPAT_REGISTRY" stderr
fi

printf '{"schema":"hepta_route_gate_family_registry_self_test_v1","status":"ready","negative_fixture_count":12,"compatibility_exit_fixture_count":14,"runtime_parity_checked":%s}\n' \
  "$([[ "$MODE" == "--runtime-parity" ]] && echo true || echo false)"
