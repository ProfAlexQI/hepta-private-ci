#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "pathname"
require "rbconfig"

REVISION = "c4335cee10b22aca768510c9d072b0ca1bba15c8"
REMOTE = "https://github.com/kevinaboos/makepad.git"
CANONICAL_PATCHER_BLOB = "369e607f4f80d08d739d2f83778fb4e37aa50d4e"
REPAIR_WRAPPER = "scripts/hepta-ui-v4-run-fixed-makepad-windows-ack-patch"
MAX_FAILURE_MESSAGE_BYTES = 4096

class MaterializationError < StandardError; end

def run!(*command, chdir: nil)
  options = chdir ? { chdir: chdir.to_s } : {}
  stdout, stderr, status = Open3.capture3(*command, **options)
  return stdout.strip if status.success?

  detail = stderr.to_s.strip
  detail = stdout.to_s.strip if detail.empty?
  raise MaterializationError,
        "#{command.join(' ')} failed#{detail.empty? ? '' : ": #{detail}"}"
end

def write_json_atomic(path, value)
  destination = Pathname.new(path).expand_path
  destination.dirname.mkpath
  temporary = destination.sub_ext(".tmp")
  temporary.write(JSON.pretty_generate(value) + "\n")
  File.rename(temporary, destination)
end

def git_object_id?(value)
  value.to_s.match?(/\A[0-9a-f]{40}\z/)
end

def candidate_payload
  commit = ENV.fetch("HEPTA_CANDIDATE_COMMIT", "UNBOUND")
  tree = ENV.fetch("HEPTA_CANDIDATE_TREE", "UNBOUND")
  {
    commit: commit,
    tree: tree,
    bound: git_object_id?(commit) && git_object_id?(tree)
  }
end

def bounded_utf8(value, max_bytes)
  string = value.to_s.encode(
    Encoding::UTF_8,
    invalid: :replace,
    undef: :replace,
    replace: "�"
  )
  return string if string.bytesize <= max_bytes

  bounded = string.byteslice(0, max_bytes)
  bounded = bounded.byteslice(0, bounded.bytesize - 1) until bounded.valid_encoding?
  bounded
end

def false_qualification
  {
    patchedCheckoutMaterialized: false,
    patchAppliedInWorktree: false,
    patchedMakepadCompile: false,
    heptaHookCompile: false,
    windowsRuntime: false,
    backdropReadback: false,
    transientSystemMaterial: false,
    completeProfile: false,
    systemMaterialBinding: false,
    nativeProductRuntime: false,
    deviceValidation: false
  }
end

def false_authority
  {
    network: false,
    mutation: false,
    effect: false,
    liveAdapter: false,
    production: false,
    operatorAcceptance: false,
    promotion: false,
    release: false
  }
end

checkout_arg = ARGV.shift or abort "usage: #{$PROGRAM_NAME} CHECKOUT_DIR CARGO_CONFIG RECEIPT_JSON"
config_arg = ARGV.shift or abort "missing Cargo config path"
receipt_arg = ARGV.shift or abort "missing materialization receipt path"
abort "unexpected arguments" unless ARGV.empty?

repo_root = Pathname.new(__dir__).join("..").expand_path
checkout = Pathname.new(checkout_arg).expand_path
config = Pathname.new(config_arg).expand_path
receipt = Pathname.new(receipt_arg).expand_path
patch_receipt = receipt.sub_ext(".patch.json")
candidate = candidate_payload
stage = "initialize"

begin
  stage = "prepare_outputs"
  FileUtils.rm_f([
    config,
    receipt,
    receipt.sub_ext(".tmp"),
    patch_receipt,
    patch_receipt.sub_ext(".tmp")
  ])

  stage = "prepare_checkout"
  FileUtils.rm_rf(checkout)
  checkout.mkpath
  run!("git", "init", "--quiet", chdir: checkout)
  run!("git", "remote", "add", "origin", REMOTE, chdir: checkout)

  stage = "fetch_exact_revision"
  run!("git", "fetch", "--quiet", "--depth", "1", "origin", REVISION, chdir: checkout)
  run!("git", "checkout", "--quiet", "--detach", "FETCH_HEAD", chdir: checkout)

  stage = "apply_exact_patch"
  patcher = repo_root.join(REPAIR_WRAPPER)
  raise MaterializationError, "repair wrapper is missing" unless patcher.file?
  run!(RbConfig.ruby, patcher.to_s, checkout.to_s, patch_receipt.to_s, chdir: repo_root)
  raise MaterializationError, "patch receipt is missing" unless patch_receipt.file?
  patch_payload = JSON.parse(patch_receipt.read)
  unless patch_payload.fetch("status") == "PASS_PATCH_APPLIED_TO_EXACT_WORKTREE_SOURCE_ONLY"
    raise MaterializationError, "patch did not reach source-only PASS"
  end

  stage = "write_cargo_override"
  config.dirname.mkpath
  widgets = checkout.join("widgets").to_s.tr("\\", "/")
  code_editor = checkout.join("code_editor").to_s.tr("\\", "/")
  config_text = <<~TOML
    [patch."https://github.com/kevinaboos/makepad"]
    makepad-widgets = { path = #{widgets.inspect} }
    makepad-code-editor = { path = #{code_editor.inspect} }
  TOML
  config.write(config_text)

  stage = "write_success_receipt"
  payload = {
    schema: "hepta.ui.v4.vendored-makepad-windows-hook-materialization.v1",
    status: "PASS_PATCHED_CHECKOUT_MATERIALIZED_SOURCE_ONLY",
    candidate: candidate,
    makepad: {
      remote: REMOTE,
      revision: REVISION,
      checkout: checkout.to_s,
      head: run!("git", "rev-parse", "HEAD", chdir: checkout),
      dirty: !run!("git", "status", "--porcelain", chdir: checkout).empty?,
      diffSha256: patch_payload.dig("makepad", "diffSha256"),
      changedFiles: patch_payload.dig("makepad", "changedFiles"),
      patcher: REPAIR_WRAPPER,
      canonicalPatcherBlob: CANONICAL_PATCHER_BLOB
    },
    cargoOverride: {
      config: config.to_s,
      sha256: Digest::SHA256.hexdigest(config_text),
      defaultDependencyChanged: false
    },
    qualification: false_qualification.merge(
      patchedCheckoutMaterialized: true,
      patchAppliedInWorktree: true
    ),
    authority: false_authority
  }
  write_json_atomic(receipt, payload)
  puts JSON.pretty_generate(payload)
rescue StandardError => error
  FileUtils.rm_f(config)
  message = bounded_utf8(error.message, MAX_FAILURE_MESSAGE_BYTES)
  message = error.class.name if message.empty?
  payload = {
    schema: "hepta.ui.v4.vendored-makepad-windows-hook-materialization.v1",
    status: "FAIL_PATCHED_CHECKOUT_MATERIALIZATION",
    candidate: candidate,
    makepad: {
      remote: REMOTE,
      revision: REVISION,
      checkout: checkout.to_s,
      patcher: REPAIR_WRAPPER,
      canonicalPatcherBlob: CANONICAL_PATCHER_BLOB
    },
    cargoOverride: {
      config: config.to_s,
      defaultDependencyChanged: false
    },
    failure: {
      stage: stage,
      errorClass: error.class.name,
      message: message,
      messageBytes: message.bytesize,
      patchReceiptPresent: patch_receipt.file?
    },
    qualification: false_qualification,
    authority: false_authority
  }
  write_json_atomic(receipt, payload)
  warn JSON.pretty_generate(payload)
  exit 1
end
