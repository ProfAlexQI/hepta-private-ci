#!/usr/bin/env ruby
# frozen_string_literal: true
require "base64"
require "digest"
require "fileutils"
require "json"
require "stringio"
require "tmpdir"
require "zlib"
require_relative "lib/hepta-normalized-token-bundle-v1"
require_relative "lib/hepta-promoted-gate-aliases"
require_relative "hepta-workgraph-readable-token-source-v1"
ROOT = File.expand_path("..", __dir__)
SCRIPTS_ROOT = File.join(ROOT, "scripts")
SPEC_PATH = File.join(SCRIPTS_ROOT, "hepta-gate-pair-specs-v1.json")
STORE_RELATIVE = "scripts/lib/hepta-gate-pair-compat-v1"
STORE_ROOT = File.join(ROOT, STORE_RELATIVE)
BUNDLE_ROOT = File.join(SCRIPTS_ROOT, "lib/hepta-gate-pair-compat-v2")
BUNDLE_PATH = File.join(BUNDLE_ROOT, "payloads.bundle.gz")
REGISTRY_PATH = File.join(BUNDLE_ROOT, "registry.json")
CURRENT_REALITY_REGISTRY_PATH = File.join(BUNDLE_ROOT, "current-reality-capabilities.json")
CURRENT_REALITY_PAYLOAD = [
  STORE_RELATIVE,
  "hepta-systems-current-reality-capability-matrix.report"
].join("/")
ENTRYPOINT_REGISTRY_PATH = File.join(SCRIPTS_ROOT, "hepta-gate-pair-entrypoints-v2.json")
LONG_PATH_REGISTRY_PATH = File.join(SCRIPTS_ROOT, "lib/hepta-long-path-v1/registry.json")
SCHEMA = "hepta_gate_pair_normalized_payload_bundle_v3"
LEGACY_SCHEMA = "hepta_gate_pair_payload_bundle_v2"
MARKER = "# hepta_gate_pair_gzip_base64_v1:"
SPEC_COUNTS = JSON.parse(File.binread(SPEC_PATH))
EXPECTED_PAYLOAD_COUNT = SPEC_COUNTS.fetch("pairs").flat_map do |pair|
  [pair["gate_implementation"], pair["report_implementation"]].compact
end.uniq.length + SPEC_COUNTS.fetch("supplemental_payloads", []).length
MAX_NORMALIZED_PAYLOAD_COUNT = 361
MAX_NORMALIZED_EFFECTIVE_LINES = 145_377
MAX_CANONICAL_RECORD_BYTES = 355_618
LEGACY_GZIP_MTIME = 0
LEGACY_GZIP_XFL = 0
LEGACY_GZIP_OS = 3
LEGACY_GZIP_COMPRESSION_METHOD = 8
LEGACY_GZIP_HEADER = [0x1f, 0x8b, LEGACY_GZIP_COMPRESSION_METHOD, 0,
                      LEGACY_GZIP_MTIME, LEGACY_GZIP_XFL, LEGACY_GZIP_OS].pack("C4VC2").freeze
LEGACY_ENVELOPE_PREFIX = "#!/usr/bin/env bash\n" \
  'exec "${HEPTA_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)}/scripts/hepta-gate-pair-compat-exec" "$0" "$@" ' \
  "#{MARKER}"
def usage
  warn "usage: scripts/hepta-gate-pair-payload-bundle [pack|verify|unpack|materialize-overlay|--decode-to PATH OUTPUT|--legacy-blob-to PATH OUTPUT]"
  exit 2
end
def atomic_write(path, content, mode = nil)
  FileUtils.mkdir_p(File.dirname(path))
  staging = File.join(
    File.dirname(path),
    ".hepta-gate-payload-#{Digest::SHA256.hexdigest(path)[0, 12]}-#{$$}.tmp"
  )
  File.binwrite(staging, content)
  File.chmod(mode, staging) if mode
  File.rename(staging, path)
end
def decode_envelope(path)
  decode_envelope_bytes(File.binread(path))
end
def decode_envelope_bytes(body)
  line = body.lines[1]
  return body unless line&.include?(MARKER)
  payload = line.split(MARKER, 2).fetch(1).strip
  Zlib::GzipReader.new(StringIO.new(Base64.strict_decode64(payload))).read
end
def legacy_blob(logical_path, source)
  return source unless registered_hashes.key?(logical_path)
  deflater = Zlib::Deflate.new(
    Zlib::DEFAULT_COMPRESSION,
    -Zlib::MAX_WBITS,
    Zlib::DEF_MEM_LEVEL,
    Zlib::DEFAULT_STRATEGY
  )
  compressed = deflater.deflate(source, Zlib::FINISH)
  deflater.close
  gzip = LEGACY_GZIP_HEADER + compressed +
    [Zlib.crc32(source), source.bytesize & 0xffffffff].pack("V2")
  LEGACY_ENVELOPE_PREFIX + Base64.strict_encode64(gzip) + "\n"
end

def legacy_blob_aggregate_sha(entries)
  digest = Digest::SHA256.new
  entries.sort.each do |logical_path, source|
    digest << logical_path << "\0"
    digest << Digest::SHA256.hexdigest(legacy_blob(logical_path, source)) << "\n"
  end
  digest.hexdigest
end

def decode_legacy_bundle(payload)
  cursor = StringIO.new(payload)
  magic = "#{LEGACY_SCHEMA}\0".b
  raise "invalid legacy gate payload bundle magic" unless cursor.read(magic.bytesize) == magic
  count = cursor.read(4)&.unpack1("N")
  raise "missing legacy gate payload count" unless count
  entries = {}
  count.times do
    lengths = cursor.read(8)&.unpack("NN")
    raise "truncated legacy gate payload lengths" unless lengths&.length == 2
    path_length, source_length = lengths
    logical_path = cursor.read(path_length)
    expected_sha = cursor.read(32)
    source = cursor.read(source_length)
    raise "truncated legacy gate payload" unless logical_path&.bytesize == path_length &&
      expected_sha&.bytesize == 32 && source&.bytesize == source_length
    logical_path = logical_path.force_encoding(Encoding::UTF_8)
    validate_logical_path(logical_path)
    raise "legacy gate payload SHA mismatch: #{logical_path}" unless Digest::SHA256.digest(source) == expected_sha
    raise "duplicate legacy gate payload path: #{logical_path}" if entries.key?(logical_path)
    entries[logical_path] = source
  end
  raise "trailing legacy gate payload bundle bytes" unless cursor.eof?
  entries
end

def decode_bundle(allow_legacy: false)
  payload = Zlib::GzipReader.open(BUNDLE_PATH, &:read).b
  if payload.start_with?("#{LEGACY_SCHEMA}\0".b)
    raise "legacy gate payload bundle requires pack migration" unless allow_legacy
    return decode_legacy_bundle(payload)
  end
  HeptaNormalizedTokenBundle.decode(
    payload,
    schema: SCHEMA,
    name_validator: lambda { |name|
      name.match?(
        %r{\Ascripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(?:gate|report)\z}
      )
    }
  ).to_h { |entry| [entry.name, entry.source] }
end

def canonical_entries(strict_metadata:)
  entries, bundle, metadata = HeptaReadableTokenSource.read(
    root: BUNDLE_ROOT,
    artifact_schema: SCHEMA,
    domain: "hepta_gate_pair_compat_payloads",
    name_validator: lambda { |name|
      name.match?(
        %r{\Ascripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(?:gate|report)\z}
      )
    },
    strict_metadata: strict_metadata
  )
  [entries.to_h { |entry| [entry.name, entry.source] }, bundle, metadata]
end

def validate_logical_path(logical_path)
  raise "invalid gate payload path: #{logical_path}" unless logical_path.match?(
    %r{\Ascripts/lib/hepta-gate-pair-compat-v1/[a-z0-9-]+\.(?:gate|report)\z}
  )
end

def spec
  @spec ||= JSON.parse(File.binread(SPEC_PATH))
end

def registered_hashes
  hashes = {}
  spec.fetch("pairs").each do |pair|
    [
      ["gate_implementation", "gate_implementation_sha256"],
      ["report_implementation", "report_implementation_sha256"]
    ].each do |path_key, sha_key|
      logical_path = pair[path_key]
      expected_sha = pair[sha_key]
      next unless logical_path && expected_sha
      existing = hashes[logical_path]
      raise "conflicting gate payload hash: #{logical_path}" if existing && existing != expected_sha
      hashes[logical_path] = expected_sha
    end
  end
  spec.fetch("supplemental_payloads", []).each do |payload|
    logical_path = payload.fetch("path")
    expected_sha = payload.fetch("sha256")
    existing = hashes[logical_path]
    raise "conflicting supplemental payload hash: #{logical_path}" if existing && existing != expected_sha
    hashes[logical_path] = expected_sha
  end
  hashes
end
def active_entries(entries)
  selected = entries.select { |logical_path, _source| registered_hashes.key?(logical_path) }
  registered_hashes.each do |logical_path, expected_sha|
    source = selected.fetch(logical_path) { raise "missing registered payload: #{logical_path}" }
    raise "registered payload SHA drifted: #{logical_path}" unless Digest::SHA256.hexdigest(source) == expected_sha
  end
  selected
end
def aggregate_sha(entries)
  digest = Digest::SHA256.new
  entries.sort.each do |logical_path, source|
    digest << logical_path << "\0" << Digest::SHA256.hexdigest(source) << "\n"
  end
  digest.hexdigest
end
def write_registry(entries, metrics, _canonical)
  registry = {
    schema: SCHEMA,
    status: "normalized",
    payload_count: entries.length,
    normalized_payload_count: metrics.fetch(:normalized_template_count),
    normalized_payload_limit: MAX_NORMALIZED_PAYLOAD_COUNT,
    normalized_parameter_row_count: metrics.fetch(:normalized_parameter_row_count),
    normalized_effective_lines: metrics.fetch(:normalized_effective_lines),
    normalized_effective_line_limit: MAX_NORMALIZED_EFFECTIVE_LINES,
    registered_payload_count: registered_hashes.length,
    source_bytes: entries.sum { |_logical_path, source| source.bytesize },
    aggregate_source_sha256: aggregate_sha(entries),
    bundle_bytes: File.size(BUNDLE_PATH),
    bundle_sha256: Digest::SHA256.file(BUNDLE_PATH).hexdigest,
    source_registry_sha256: Digest::SHA256.file(SPEC_PATH).hexdigest,
    canonical_schema_sha256: Digest::SHA256.file(
      File.join(BUNDLE_ROOT, HeptaReadableTokenSource::SCHEMA_FILE)
    ).hexdigest,
    canonical_templates_sha256: _canonical.fetch(:templates_sha256),
    canonical_parameters_sha256: _canonical.fetch(:parameters_sha256),
    canonical_max_record_bytes: _canonical.fetch(:canonical_max_record_bytes),
    canonical_max_record_byte_limit: MAX_CANONICAL_RECORD_BYTES,
    canonical_record_byte_semantics: _canonical.fetch(:jsonl_record_byte_semantics),
    legacy_blob_generation: "deterministic_raw_or_gzip_default_mtime_zero_v1",
    legacy_blob_count: entries.length,
    legacy_blob_aggregate_sha256: legacy_blob_aggregate_sha(entries),
    source_files_materialized: false,
    runtime_overlay_generation: true,
    reversible_unpack: true
  }
  atomic_write(REGISTRY_PATH, JSON.pretty_generate(registry) + "\n", 0o644)
  write_current_reality_registry(entries)
end
def write_bundle(entries)
  normalized_entries = entries.sort.map do |logical_path, source|
    HeptaNormalizedTokenBundle::Entry.new(logical_path, source)
  end
  bundle = HeptaNormalizedTokenBundle.build(
    normalized_entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  if bundle.metrics.fetch(:normalized_template_count) > MAX_NORMALIZED_PAYLOAD_COUNT
    raise "normalized gate payload budget exceeded: #{bundle.metrics.fetch(:normalized_template_count)}"
  end
  if bundle.metrics.fetch(:normalized_effective_lines) > MAX_NORMALIZED_EFFECTIVE_LINES
    raise "normalized gate payload effective-line budget exceeded: #{bundle.metrics.fetch(:normalized_effective_lines)}"
  end
  FileUtils.mkdir_p(BUNDLE_ROOT)
  canonical = HeptaReadableTokenSource.write(
    root: BUNDLE_ROOT,
    bundle: bundle,
    artifact_schema: SCHEMA,
    domain: "hepta_gate_pair_compat_payloads",
    artifact_file: File.basename(BUNDLE_PATH),
    atomic_write: method(:atomic_write)
  )
  payload = HeptaNormalizedTokenBundle.encode(bundle, schema: SCHEMA)
  atomic_write(
    BUNDLE_PATH,
    HeptaReadableTokenSource.deterministic_gzip(payload),
    0o644
  )
  write_registry(entries, bundle.metrics, canonical)
end
def current_reality_registry(entries)
  source = entries.fetch(CURRENT_REALITY_PAYLOAD)
  close = source.index("\n  ] as $capabilities |")
  raise "current-reality capability registry has no closing marker" unless close
  prefix = source.byteslice(0, close)
  open = prefix.rindex("\n  [\n    {\n      id:")
  raise "current-reality capability registry has no opening marker" unless open
  ids = prefix.byteslice(open, prefix.bytesize - open).scan(/\n      id:"([a-z0-9_]+)"/).flatten
  raise "current-reality capability registry is empty" if ids.empty?
  raise "current-reality capability registry has duplicate ids" unless ids.uniq.length == ids.length
  {
    schema: "hepta_current_reality_capability_registry_v1",
    source_payload: CURRENT_REALITY_PAYLOAD,
    source_sha256: Digest::SHA256.hexdigest(source),
    capability_ids: ids
  }
end

def write_current_reality_registry(entries)
  atomic_write(
    CURRENT_REALITY_REGISTRY_PATH,
    JSON.pretty_generate(current_reality_registry(entries)) + "\n",
    0o644
  )
end

def pack
  if HeptaReadableTokenSource.present?(BUNDLE_ROOT) &&
      !HeptaPromotedGateAliases.materialized_payload_store?(ROOT)
    entries = active_entries(canonical_entries(strict_metadata: false).first)
    write_bundle(entries)
    verify
    return
  end
  if File.file?(BUNDLE_PATH) && !HeptaPromotedGateAliases.materialized_payload_store?(ROOT)
    entries = active_entries(decode_bundle(allow_legacy: true))
    write_bundle(entries)
    verify
    return
  end
  raise "missing compatibility payload store" unless Dir.exist?(STORE_ROOT)
  entries = Dir.glob(File.join(STORE_ROOT, "*.{gate,report}")).sort.to_h do |path|
    [path.delete_prefix("#{ROOT}/"), decode_envelope(path)]
  end
  raise "unexpected compatibility payload count: #{entries.length}" unless entries.length == EXPECTED_PAYLOAD_COUNT
  entries = active_entries(entries)
  write_bundle(entries)
  FileUtils.rm_rf(STORE_ROOT)
  verify
end

def verify
  raise "missing gate payload bundle" unless File.file?(BUNDLE_PATH) &&
    File.file?(REGISTRY_PATH) &&
    HeptaReadableTokenSource.present?(BUNDLE_ROOT)
  entries, canonical_bundle, canonical = canonical_entries(strict_metadata: true)
  normalized_entries = entries.sort.map do |logical_path, source|
    HeptaNormalizedTokenBundle::Entry.new(logical_path, source)
  end
  rebuilt = HeptaNormalizedTokenBundle.build(
    normalized_entries,
    tokenizer: HeptaNormalizedTokenBundle.method(:shell_tokens)
  )
  canonical_payload = HeptaNormalizedTokenBundle.encode(canonical_bundle, schema: SCHEMA)
  rebuilt_payload = HeptaNormalizedTokenBundle.encode(rebuilt, schema: SCHEMA)
  raise "gate payload canonical normalization drifted" unless canonical_payload ==
    rebuilt_payload
  expected_gzip = HeptaReadableTokenSource.deterministic_gzip(rebuilt_payload)
  raise "gate payload generated gzip is not byte-identical" unless File.binread(
    BUNDLE_PATH
  ) == expected_gzip
  artifact_entries = decode_bundle
  raise "gate payload artifact reassembly drifted" unless aggregate_sha(artifact_entries) ==
    aggregate_sha(entries)
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  raise "invalid gate payload registry schema" unless registry["schema"] == SCHEMA
  raise "unexpected gate payload count" unless entries.length == EXPECTED_PAYLOAD_COUNT
  raise "gate payload registry count drifted" unless registry["payload_count"] == entries.length
  raise "normalized gate payload count drifted" unless registry[
    "normalized_payload_count"
  ] == rebuilt.metrics.fetch(:normalized_template_count)
  raise "normalized gate payload count exceeds budget" unless registry[
    "normalized_payload_count"
  ].between?(1, MAX_NORMALIZED_PAYLOAD_COUNT)
  raise "normalized gate payload limit drifted" unless registry[
    "normalized_payload_limit"
  ] == MAX_NORMALIZED_PAYLOAD_COUNT
  raise "normalized gate payload parameter rows drifted" unless registry["normalized_parameter_row_count"] == EXPECTED_PAYLOAD_COUNT
  raise "normalized gate effective lines drifted" unless registry[
    "normalized_effective_lines"
  ] == rebuilt.metrics.fetch(:normalized_effective_lines)
  raise "normalized gate effective-line budget exceeded" unless registry[
    "normalized_effective_lines"
  ].between?(1, MAX_NORMALIZED_EFFECTIVE_LINES)
  raise "gate payload bundle SHA drifted" unless registry["bundle_sha256"] == Digest::SHA256.file(BUNDLE_PATH).hexdigest
  raise "gate payload canonical template SHA drifted" unless canonical.fetch(
    "templates_sha256"
  ) == Digest::SHA256.file(
    File.join(BUNDLE_ROOT, HeptaReadableTokenSource::TEMPLATE_FILE)
  ).hexdigest
  raise "gate payload canonical parameter SHA drifted" unless canonical.fetch(
    "parameters_sha256"
  ) == Digest::SHA256.file(
    File.join(BUNDLE_ROOT, HeptaReadableTokenSource::PARAMETER_FILE)
  ).hexdigest
  raise "gate payload canonical schema SHA drifted" unless registry[
    "canonical_schema_sha256"
  ] == Digest::SHA256.file(
    File.join(BUNDLE_ROOT, HeptaReadableTokenSource::SCHEMA_FILE)
  ).hexdigest
  raise "gate payload canonical template registry SHA drifted" unless registry[
    "canonical_templates_sha256"
  ] == canonical.fetch("templates_sha256")
  raise "gate payload canonical parameter registry SHA drifted" unless registry[
    "canonical_parameters_sha256"
  ] == canonical.fetch("parameters_sha256")
  raise "gate payload canonical record size drifted" unless registry[
    "canonical_max_record_bytes"
  ] == canonical.fetch("canonical_max_record_bytes")
  raise "gate payload canonical record-size budget exceeded" unless registry[
    "canonical_max_record_bytes"
  ].between?(1, MAX_CANONICAL_RECORD_BYTES)
  raise "gate payload canonical record-size limit drifted" unless registry[
    "canonical_max_record_byte_limit"
  ] == MAX_CANONICAL_RECORD_BYTES
  raise "gate payload canonical record byte semantics drifted" unless registry[
    "canonical_record_byte_semantics"
  ] == "record_including_lf"
  raise "gate payload aggregate SHA drifted" unless registry["aggregate_source_sha256"] == aggregate_sha(entries)
  raise "gate payload source registry SHA drifted" unless registry["source_registry_sha256"] == Digest::SHA256.file(SPEC_PATH).hexdigest
  raise "legacy gate payload generation drifted" unless registry["legacy_blob_generation"] ==
    "deterministic_raw_or_gzip_default_mtime_zero_v1"
  raise "legacy gate payload count drifted" unless registry["legacy_blob_count"] == entries.length
  actual_legacy_aggregate = legacy_blob_aggregate_sha(entries)
  unless registry["legacy_blob_aggregate_sha256"] == actual_legacy_aggregate
    raise "legacy gate payload aggregate drifted: registry=#{registry["legacy_blob_aggregate_sha256"]} " \
      "actual=#{actual_legacy_aggregate}"
  end
  legacy_roundtrip_path = registered_hashes.keys.min
  legacy_roundtrip_source = entries.fetch(legacy_roundtrip_path)
  raise "legacy gate payload gzip roundtrip drifted" unless decode_envelope_bytes(
    legacy_blob(legacy_roundtrip_path, legacy_roundtrip_source)
  ) == legacy_roundtrip_source
  expected_current_reality_registry = JSON.pretty_generate(current_reality_registry(entries)) + "\n"
  raise "current-reality capability registry drifted" unless File.file?(CURRENT_REALITY_REGISTRY_PATH) &&
    File.binread(CURRENT_REALITY_REGISTRY_PATH) == expected_current_reality_registry
  registered_hashes.each do |logical_path, expected_sha|
    source = entries.fetch(logical_path) { raise "missing registered bundled payload: #{logical_path}" }
    raise "bundled payload SHA drifted: #{logical_path}" unless Digest::SHA256.hexdigest(source) == expected_sha
  end
  HeptaPromotedGateAliases.verify_source_aliases(ROOT)
  puts "hepta-gate-pair-payload-bundle: PASS: #{entries.length} payloads"
end

def unpack
  entries = decode_bundle
  entries.each do |logical_path, source|
    atomic_write(File.join(ROOT, logical_path), source, 0o755)
  end
  puts "hepta-gate-pair-payload-bundle: unpacked #{entries.length} payloads"
end

def decode_to(logical_path, output)
  relative = logical_path.delete_prefix("#{ROOT}/")
  source = decode_bundle.fetch(relative) { raise "unknown bundled gate payload: #{relative}" }
  atomic_write(output, source, 0o600)
end

def legacy_blob_to(logical_path, output)
  relative = logical_path.delete_prefix("#{ROOT}/")
  raise "invalid legacy gate payload blob path: #{relative}" unless relative.match?(
    %r{\A#{Regexp.escape(STORE_RELATIVE)}/[a-z0-9-]+\.(?:gate|report)\z}
  )
  source = decode_bundle.fetch(relative) { raise "unknown legacy gate payload blob: #{relative}" }
  atomic_write(output, legacy_blob(relative, source), 0o600)
end

def wrapper_body(kind, id)
  <<~SH
    #!/usr/bin/env bash
    set -euo pipefail

    ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
    exec "$ROOT/scripts/hepta-gate-pair-runner" #{kind} "#{id}"
  SH
end

def link_children(source_root, target_root, excluded)
  FileUtils.mkdir_p(target_root)
  Dir.children(source_root).sort.each do |name|
    next if excluded.include?(name)
    File.symlink(File.join(source_root, name), File.join(target_root, name))
  end
end

def materialize_long_path_aliases(staging)
  return unless File.file?(LONG_PATH_REGISTRY_PATH)
  registry = JSON.parse(File.binread(LONG_PATH_REGISTRY_PATH))
  raise "invalid Hepta long-path registry schema" unless registry["schema"] ==
    "hepta_long_path_relocation_v1"
  registry.fetch("entries").each do |entry|
    original = entry.fetch("original_path")
    relocated = entry.fetch("relocated_path")
    raise "invalid Hepta long-path alias" if original.start_with?("/") ||
      relocated.start_with?("/") ||
      original.split("/").include?("..") ||
      relocated.split("/").include?("..")
    target = File.join(ROOT, relocated)
    raise "missing relocated Hepta long-path target: #{relocated}" unless File.file?(target)
    alias_path = File.join(staging, original)
    FileUtils.mkdir_p(File.dirname(alias_path))
    File.symlink(target, alias_path)
  end
end

def materialize_overlay
  registry = JSON.parse(File.binread(REGISTRY_PATH))
  overlay_inputs = [
    registry.fetch("bundle_sha256"),
    Digest::SHA256.file(__FILE__).hexdigest,
    *HeptaPromotedGateAliases.input_sha256s(ROOT),
    Digest::SHA256.file(ENTRYPOINT_REGISTRY_PATH).hexdigest,
    File.file?(LONG_PATH_REGISTRY_PATH) ?
      Digest::SHA256.file(LONG_PATH_REGISTRY_PATH).hexdigest :
      "no-long-path-registry"
  ]
  overlay_inputs_sha256 = Digest::SHA256.hexdigest(overlay_inputs.join("\n") + "\n")
  cache_key = [
    Digest::SHA256.hexdigest(ROOT)[0, 12],
    overlay_inputs_sha256[0, 16]
  ].join("-")
  destination = File.join(Dir.tmpdir, "hepta-gate-pair-overlay-#{cache_key}")
  marker = File.join(destination, ".hepta-gate-pair-overlay.json")
  if File.file?(marker)
    current = JSON.parse(File.binread(marker))
    if current["repo_root"] == ROOT &&
        current["overlay_inputs_sha256"] == overlay_inputs_sha256
      puts destination
      return
    end
  end
  staging = "#{destination}.#{$$}.tmp"
  FileUtils.rm_rf(staging)
  FileUtils.mkdir_p(staging)
  link_children(ROOT, staging, [".git", "docs", "scripts"])
  overlay_docs = File.join(staging, "docs")
  link_children(File.join(ROOT, "docs"), overlay_docs, ["architecture"])
  link_children(
    File.join(ROOT, "docs/architecture"),
    File.join(overlay_docs, "architecture"),
    []
  )
  overlay_scripts = File.join(staging, "scripts")
  pair_wrapper_names = spec.fetch("pairs").flat_map do |pair|
    ["#{pair.fetch("id")}-gate.sh", File.basename(pair.fetch("report_path"))]
  end.each_with_object({}) { |name, names| names[name] = true }
  link_children(SCRIPTS_ROOT, overlay_scripts, ["lib", *pair_wrapper_names.keys])
  overlay_lib = File.join(overlay_scripts, "lib")
  link_children(File.join(SCRIPTS_ROOT, "lib"), overlay_lib, [
    "hepta-gate-pair-compat-v1",
    "hepta-gate-pair-compat-v2"
  ])
  File.symlink(BUNDLE_ROOT, File.join(overlay_lib, "hepta-gate-pair-compat-v2"))
  decode_bundle.each do |logical_path, source|
    atomic_write(File.join(staging, logical_path), source, 0o755)
  end
  HeptaPromotedGateAliases.materialize(ROOT, staging)
  spec.fetch("pairs").each do |pair|
    id = pair.fetch("id")
    atomic_write(File.join(overlay_scripts, "#{id}-gate.sh"), wrapper_body("gate", id), 0o755)
    atomic_write(
      File.join(staging, pair.fetch("report_path")),
      wrapper_body("report", id),
      0o755
    )
  end
  materialize_long_path_aliases(staging)
  atomic_write(
    File.join(staging, ".hepta-gate-pair-overlay.json"),
    JSON.generate(
      repo_root: ROOT,
      bundle_sha256: registry.fetch("bundle_sha256"),
      overlay_inputs_sha256: overlay_inputs_sha256
    ) + "\n",
    0o600
  )
  begin
    File.rename(staging, destination)
  rescue Errno::EEXIST, Errno::ENOTEMPTY
    FileUtils.rm_rf(staging)
  end
  puts destination
end

if ARGV.length == 1 && {"pack"=>method(:pack), "verify"=>method(:verify),
                        "unpack"=>method(:unpack), "materialize-overlay"=>method(:materialize_overlay)}.key?(ARGV.first)
  {"pack"=>method(:pack), "verify"=>method(:verify), "unpack"=>method(:unpack),
   "materialize-overlay"=>method(:materialize_overlay)}.fetch(ARGV.first).call
elsif ARGV.length == 3 && ARGV.first == "--decode-to"
  decode_to(ARGV.fetch(1), ARGV.fetch(2))
elsif ARGV.length == 3 && ARGV.first == "--legacy-blob-to"
  legacy_blob_to(ARGV.fetch(1), ARGV.fetch(2))
else
  usage
end
