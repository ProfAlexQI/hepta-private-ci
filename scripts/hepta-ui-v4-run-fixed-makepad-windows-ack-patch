#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "pathname"
require "rbconfig"
require "tempfile"

EXPECTED_PATCHER_BLOB = "369e607f4f80d08d739d2f83778fb4e37aa50d4e"
RUST_HEREDOC = "<<~'RUST'.chomp"
FIXED_RUST_HEREDOC = "<<-'RUST'.chomp"
MINIMUM_EXPECTED_RUST_HEREDOCS = 8

repo_root = Pathname.new(__dir__).join("..").expand_path
original = repo_root.join("scripts/hepta-ui-v4-apply-makepad-windows-ack-patch")
abort "canonical patcher is missing" unless original.file?

actual_blob, blob_error, blob_status = Open3.capture3(
  "git", "hash-object", original.to_s,
  chdir: repo_root.to_s
)
abort "hash canonical patcher failed: #{blob_error}" unless blob_status.success?
abort "canonical patcher drifted: #{actual_blob.strip}" unless
  actual_blob.strip == EXPECTED_PATCHER_BLOB

source = original.read
heredoc_count = source.scan(RUST_HEREDOC).length
abort "canonical Rust heredoc set drifted: #{heredoc_count}" unless
  heredoc_count >= MINIMUM_EXPECTED_RUST_HEREDOCS

inside_heredoc = false
fixed_count = 0
fixed_source = source.lines.map do |line|
  if line.include?(RUST_HEREDOC)
    abort "nested Rust heredoc is unsupported" if inside_heredoc
    inside_heredoc = true
    fixed_count += 1
    line.sub(RUST_HEREDOC, FIXED_RUST_HEREDOC)
  elsif inside_heredoc && line.strip == "RUST"
    inside_heredoc = false
    line
  elsif inside_heredoc && !line.strip.empty?
    abort "Rust heredoc structural indentation drifted" unless line.start_with?("    ")
    line.sub(/\A    /, "")
  else
    line
  end
end.join

abort "unterminated Rust heredoc" if inside_heredoc
abort "not every Rust heredoc was repaired" unless fixed_count == heredoc_count
abort "broken squiggly Rust heredoc remains" if fixed_source.include?(RUST_HEREDOC)
abort "repaired heredoc count drifted" unless
  fixed_source.scan(FIXED_RUST_HEREDOC).length == heredoc_count

Tempfile.create(["hepta-ui-v4-fixed-makepad-patcher", ".rb"]) do |temporary|
  temporary.write(fixed_source)
  temporary.flush
  stdout, stderr, status = Open3.capture3(
    RbConfig.ruby,
    temporary.path,
    *ARGV,
    chdir: repo_root.to_s
  )
  $stdout.write(stdout)
  $stderr.write(stderr)
  exit(status.exitstatus || 1) unless status.success?
end
