load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "hepta-mnl-trust-v1-lib",
    srcs = glob(["src/*.rs"]),
    crate_name = "codex_hepta_mnl_trust_v1",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = [
        "//codex-rs/hepta-mnl-replay-v1:__pkg__",
        "//codex-rs/hepta-nix-mnl-v1:__pkg__",
    ],
    deps = [
        "@crates//:ed25519-dalek",
        "@crates//:gix-hash",
        "@crates//:gix-object",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "hepta-mnl-trust-v1-tests",
    crate = ":hepta-mnl-trust-v1-lib",
    deps = ["@crates//:static_assertions"],
)
