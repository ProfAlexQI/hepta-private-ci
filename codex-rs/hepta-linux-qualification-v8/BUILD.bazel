load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "hepta-linux-qualification-v8-lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "codex_hepta_linux_qualification_v8",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//codex-rs/hepta-linux-v8-native:__pkg__"],
    deps = [
        "@crates//:base64",
        "@crates//:ed25519-dalek",
        "@crates//:serde",
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "hepta-linux-qualification-v8-tests",
    crate = ":hepta-linux-qualification-v8-lib",
    deps = [
        "@crates//:pretty_assertions",
        "@crates//:serde_json",
    ],
)
