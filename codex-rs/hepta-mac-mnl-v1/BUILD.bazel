rust_binary(
    name = "hepta-mac-mnl-verify-v1",
    srcs = ["src/bin/hepta-mac-mnl-verify-v1.rs"],
    crate_root = "src/bin/hepta-mac-mnl-verify-v1.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":hepta-mac-mnl-v1-lib",
    ],
