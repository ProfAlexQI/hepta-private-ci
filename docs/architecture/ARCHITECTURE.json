  "nonNegotiableInvariants": [
    "Codex App Server remains the sole session, thread, turn, model-call and tool-execution spine.",
    "Agentd is a thin composition and lifecycle host and owns no product-domain durable fact.",
    "Every durable fact has exactly one schema owner and one authoritative writer.",
    "Cross-owner mutation uses local transaction, durable intent, outbox, destination dedupe/apply, acknowledgement and reconciliation.",
    "A queue or dispatch acknowledgement is never terminal external-effect success.",
    "Indeterminate remains open until a current-fence reconciler records ReconciledApplied, ReconciledNotApplied or Quarantined.",
    "Every irreversible boundary consumes a final-payload-bound, operation-bound, short-lived, revocation-revision-bound VerifiedUseToken.",
    "No boundary adapter may mint the capability or verified-use token it consumes.",
    "Qualification fixtures, signers and test verifiers cannot link into production artifacts.",
    "Feature presence, registration, executable qualification, operator acceptance, promotion and release are distinct states.",
    "Central optimizers select plans but do not issue physical capabilities or execute effects.",
    "A module exposes a bounded Pareto candidate set; no local module may unilaterally claim global optimality."
  ],
  "dependencyLayers": [
    "platform.types",
    "platform.wire",
    "kernel contracts and domain ports",
    "domain modules",
    "checked adapters",
    "composition daemons and presentation"
  ],
  "forbiddenDependencyRules": [
    "codex implementation crates -> Hepta implementation crates",
    "wire crates -> SQL/domain/runtime/daemon crates",
    "domain crates -> Agentd/Matrixd/UI binaries",
    "qualification code -> production writer",
    "boundary adapter -> its own authority issuer",
    "runtime control optimizer -> physical effect adapter",
    "engineering control plane -> runtime authority kernel"
  ],
  "crossOwnerProtocol": {
    "transport": "transactional_outbox",
    "delivery": "at_least_once",
    "destinationRequirement": "idempotent_digest_bound_commit",
    "blindRetryAfterBoundary": false,
