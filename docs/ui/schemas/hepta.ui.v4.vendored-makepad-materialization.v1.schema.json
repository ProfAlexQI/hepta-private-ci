{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hepta.ai/schemas/ui/hepta.ui.v4.vendored-makepad-materialization.v1.schema.json",
  "title": "Hepta UI v4 vendored Makepad materialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate",
    "makepad",
    "cargoOverride",
    "qualification",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "hepta.ui.v4.vendored-makepad-windows-hook-materialization.v1"
    },
    "status": {
      "enum": [
        "PASS_PATCHED_CHECKOUT_MATERIALIZED_SOURCE_ONLY",
        "FAIL_PATCHED_CHECKOUT_MATERIALIZATION"
      ]
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "makepad": {
      "$ref": "#/$defs/makepad"
    },
    "cargoOverride": {
      "$ref": "#/$defs/cargoOverride"
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "bound"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 40
        },
        "tree": {
          "type": "string",
          "minLength": 7,
          "maxLength": 40
        },
        "bound": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bound": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "$ref": "#/$defs/gitObject"
              },
              "tree": {
                "$ref": "#/$defs/gitObject"
              }
            }
          }
        }
      ]
    },
    "makepad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote",
        "revision",
        "checkout",
        "patcher",
        "canonicalPatcherBlob"
      ],
      "properties": {
        "remote": {
          "const": "https://github.com/kevinaboos/makepad.git"
        },
        "revision": {
          "const": "c4335cee10b22aca768510c9d072b0ca1bba15c8"
        },
        "checkout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "head": {
          "$ref": "#/$defs/gitObject"
        },
        "dirty": {
          "type": "boolean"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "changedFiles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "const": "platform/src/cx_api.rs"
            },
            {
              "const": "platform/src/lib.rs"
            },
            {
              "const": "platform/src/os/windows/win32_window.rs"
            },
            {
              "const": "platform/src/os/windows/windows.rs"
            },
            {
              "const": "platform/src/window.rs"
            }
          ],
          "items": false
        },
        "patcher": {
          "const": "scripts/hepta-ui-v4-run-fixed-makepad-windows-ack-patch"
        },
        "canonicalPatcherBlob": {
          "const": "369e607f4f80d08d739d2f83778fb4e37aa50d4e"
        }
      }
    },
    "cargoOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "defaultDependencyChanged"
      ],
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "defaultDependencyChanged": {
          "const": false
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "errorClass",
        "message",
        "messageBytes",
        "patchReceiptPresent"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "errorClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "messageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "patchReceiptPresent": {
          "type": "boolean"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patchedCheckoutMaterialized",
        "patchAppliedInWorktree",
        "patchedMakepadCompile",
        "heptaHookCompile",
        "windowsRuntime",
        "backdropReadback",
        "transientSystemMaterial",
        "completeProfile",
        "systemMaterialBinding",
        "nativeProductRuntime",
        "deviceValidation"
      ],
      "properties": {
        "patchedCheckoutMaterialized": {
          "type": "boolean"
        },
        "patchAppliedInWorktree": {
          "type": "boolean"
        },
        "patchedMakepadCompile": {
          "const": false
        },
        "heptaHookCompile": {
          "const": false
        },
        "windowsRuntime": {
          "const": false
        },
        "backdropReadback": {
          "const": false
        },
        "transientSystemMaterial": {
          "const": false
        },
        "completeProfile": {
          "const": false
        },
        "systemMaterialBinding": {
          "const": false
        },
        "nativeProductRuntime": {
          "const": false
        },
        "deviceValidation": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "mutation",
        "effect",
        "liveAdapter",
        "production",
        "operatorAcceptance",
        "promotion",
        "release"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "mutation": {
          "const": false
        },
        "effect": {
          "const": false
        },
        "liveAdapter": {
          "const": false
        },
        "production": {
          "const": false
        },
        "operatorAcceptance": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "release": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS_PATCHED_CHECKOUT_MATERIALIZED_SOURCE_ONLY"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "failure"
          ]
        },
        "properties": {
          "candidate": {
            "properties": {
              "bound": {
                "const": true
              }
            }
          },
          "makepad": {
            "required": [
              "head",
              "dirty",
              "diffSha256",
              "changedFiles"
            ],
            "properties": {
              "head": {
                "const": "c4335cee10b22aca768510c9d072b0ca1bba15c8"
              },
              "dirty": {
                "const": true
              }
            }
          },
          "cargoOverride": {
            "required": [
              "sha256"
            ]
          },
          "qualification": {
            "properties": {
              "patchedCheckoutMaterialized": {
                "const": true
              },
              "patchAppliedInWorktree": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL_PATCHED_CHECKOUT_MATERIALIZATION"
          }
        }
      },
      "then": {
        "required": [
          "failure"
        ],
        "properties": {
          "qualification": {
            "properties": {
              "patchedCheckoutMaterialized": {
                "const": false
              },
              "patchAppliedInWorktree": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
