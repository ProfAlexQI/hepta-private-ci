  "required_exact_source_fields": [
    "repository",
    "pull_request_number",
    "head_commit",
    "head_tree",
    "parent_commit",
    "cargo_lock_sha256",
    "workflow_blob_sha256",
    "plan_blob_sha256",
    "stage_matrix_blob_sha256",
    "implementation_status_blob_sha256",
    "blocker_ledger_blob_sha256",
    "runner_os",
    "runner_arch",
    "runner_name_or_image",
    "rustc_version",
    "cargo_version"
  ],
  "source_inventory_gate": {
    "required": true,
    "rules": [
      "every owned source and script path invoked by a required workflow exists at exact head",
      "every Cargo package named by a required command exists in cargo metadata --locked",
      "future package names are forbidden until their Cargo.toml, workspace membership and lock entry coexist",
      "all current truth JSON parses and references the active plan",
      "all authority fields remain closed",
      "historical receipts are not modified"
    ]
  },
  "source_rust_gate": {
    "toolchain": "1.95.0 unless exact-head evidence proves a workspace-owned incompatibility and a separate toolchain migration is approved",
    "packages": [
      "codex-hepta-infer-core",
      "codex-hepta-infer-client",
      "codex-hepta-inferd"
    ],
    "commands": [
      "cargo fmt -p codex-hepta-infer-core -p codex-hepta-infer-client -p codex-hepta-inferd -- --check",
      "cargo check --locked --all-targets -p codex-hepta-infer-core -p codex-hepta-infer-client -p codex-hepta-inferd",
      "cargo test --locked --all-targets -p codex-hepta-infer-core -p codex-hepta-infer-client -p codex-hepta-inferd",
      "cargo clippy --locked --all-targets --no-deps -p codex-hepta-infer-core -p codex-hepta-infer-client -p codex-hepta-inferd -- -D warnings"
    ],
    "all_steps_must_be_non_empty": true,
    "runner_id_must_be_nonzero": true,
    "skipped_is_pass": false,
    "cancelled_is_pass": false
  },
  "required_control_plane_test_classes": [
    "public same-user peer cannot publish Start Token Complete",
    "public same-user peer cannot RestartBackend",
    "role error code is stable",
    "queue inflight and running global limits",
    "queue inflight and running per-tenant limits",
    "terminal paths release reservations exactly once",
    "deadline expiry before and after queueing",
    "token chain known vectors",
    "token count mismatch rejection",
    "result digest mismatch rejection",
    "output token limit rejection",
    "connection semaphore saturation",
    "partial frame read timeout",
    "response write timeout",
    "atomic receipt persistence",
    "restart receipt recovery",
    "receipt corruption duplicate size and budget rejection",
    "no raw prompt media source code or model output in default receipt"
  ],
  "source_receipt_required_claims": {
    "source_inventory": "PASS",
    "formatting": "PASS",
    "locked_check": "PASS",
    "all_target_tests": "PASS",
    "strict_clippy": "PASS",
