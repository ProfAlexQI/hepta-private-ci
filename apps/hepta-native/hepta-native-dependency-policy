#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ledger="${HEPTA_NATIVE_DEPENDENCY_POLICY_LEDGER:-$script_dir/dependency-source-policy-v1.json}"
manifest="$script_dir/Cargo.toml"
lockfile="$script_dir/Cargo.lock"
deny_config="$script_dir/deny.toml"
deny_bin="${HEPTA_CARGO_DENY_BIN:-}"

fail() {
  printf 'hepta-native dependency policy: %s\n' "$*" >&2
  exit 1
}

for tool in cargo jq shasum; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool is unavailable: $tool"
done

if [[ -z "$deny_bin" ]]; then
  deny_bin="$(command -v cargo-deny || true)"
fi
[[ -n "$deny_bin" && -x "$deny_bin" ]] || fail "cargo-deny 0.20.2 is unavailable"
[[ -f "$ledger" ]] || fail "policy ledger is missing: $ledger"
[[ -f "$manifest" && -f "$lockfile" && -f "$deny_config" ]] \
  || fail "native manifest, lockfile, or deny config is missing"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/hepta-native-dependency-policy.XXXXXX")"
trap 'rm -rf -- "$tmp_dir"' EXIT

sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

jq -e '
  .schema_version == "hepta_native_dependency_source_policy_v1"
  and .cargo_lock.path == "Cargo.lock"
  and (.cargo_lock.sha256 | test("^[0-9a-f]{64}$"))
  and .root_manifest.path == "Cargo.toml"
  and (.root_manifest.sha256 | test("^[0-9a-f]{64}$"))
  and .cargo_deny.version == "0.20.2"
  and .cargo_deny.config_path == "deny.toml"
  and (.cargo_deny.config_sha256 | test("^[0-9a-f]{64}$"))
  and .cargo_deny.checks == ["bans", "licenses", "sources"]
  and (.declared_git_dependencies | type) == "array"
  and (.declared_git_dependencies | length) == 13
  and ([.declared_git_dependencies[].name] | unique | length) == 13
  and all(.declared_git_dependencies[];
    (.source | test("^git\\+https://[^#?]+(?:\\.git)?\\?rev=[0-9a-f]{40}$"))
  )
  and (.resolved_git_sources | type) == "array"
  and (.resolved_git_sources | length) == .resolved_git_source_count
  and ([.resolved_git_sources[].url] | unique | length) == .resolved_git_source_count
  and ([.resolved_git_sources[].cargo_lock_source] | unique | length)
      == .resolved_git_source_count
  and all(.resolved_git_sources[];
    (.commit | test("^[0-9a-f]{40}$"))
    and .cargo_lock_source
        == ("git+" + .url + "?rev=" + .commit + "#" + .commit)
    and (.package_count | type) == "number"
    and .package_count > 0
  )
  and ([.resolved_git_sources[].package_count] | add)
      == .resolved_git_package_count
  and .resolved_git_source_count == 7
  and .resolved_git_package_count == 126
  and (.license_clarifications | length) == 2
  and ([.license_clarifications[].package] | sort)
      == ["makepad-latex-math", "makepad-regex"]
  and all(.license_clarifications[];
    .version == "0.1.0"
    and .expression == "MIT"
    and (.package_manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.license_sha256 | test("^[0-9a-f]{64}$"))
    and (.cargo_deny_xxhash32 | test("^0x[0-9a-f]{8}$"))
  )
  and .claims.all_resolved_git_sources_are_exact_revision_pinned == true
  and .claims.new_or_unlisted_git_sources_are_denied == true
  and .claims.git_commit_drift_is_denied == true
  and .claims.license_clarifications_are_package_source_and_file_hash_bound == true
  and .claims.broad_license_exceptions_are_forbidden == true
' "$ledger" >/dev/null || fail "policy ledger schema or invariants are invalid"

actual_lock_sha="$(sha256_file "$lockfile")"
expected_lock_sha="$(jq -r '.cargo_lock.sha256' "$ledger")"
[[ "$actual_lock_sha" == "$expected_lock_sha" ]] \
  || fail "Cargo.lock SHA-256 does not match the exact policy ledger"

actual_manifest_sha="$(sha256_file "$manifest")"
expected_manifest_sha="$(jq -r '.root_manifest.sha256' "$ledger")"
[[ "$actual_manifest_sha" == "$expected_manifest_sha" ]] \
  || fail "Cargo.toml SHA-256 does not match the exact policy ledger"

actual_deny_sha="$(sha256_file "$deny_config")"
expected_deny_sha="$(jq -r '.cargo_deny.config_sha256' "$ledger")"
[[ "$actual_deny_sha" == "$expected_deny_sha" ]] \
  || fail "deny.toml SHA-256 does not match the exact policy ledger"

deny_version="$("$deny_bin" --version)"
[[ "$deny_version" == "cargo-deny 0.20.2" ]] \
  || fail "expected cargo-deny 0.20.2, got: $deny_version"

{
  printf '%s\n' "$manifest"
  find "$script_dir/third_party" -type f -name Cargo.toml -print | sort
} >"$tmp_dir/manifests"

while IFS= read -r current_manifest; do
  while IFS= read -r manifest_line; do
    active_line="${manifest_line%%#*}"
    [[ "$active_line" == *"git ="* ]] || continue
    [[ "$active_line" != *"branch ="* ]] \
      || fail "branch-floating git dependency in $current_manifest"
    [[ "$active_line" == *"rev ="* ]] \
      || fail "git dependency is not exact-revision pinned in $current_manifest"
  done <"$current_manifest"
done <"$tmp_dir/manifests"

cargo metadata \
  --manifest-path "$manifest" \
  --locked \
  --all-features \
  --format-version 1 >"$tmp_dir/metadata.json"

jq -cS --arg manifest "$manifest" '
  [
    .packages[]
    | select(.name == "hepta-native" and .manifest_path == $manifest)
    | .dependencies[]
    | select(.source != null and (.source | startswith("git+")))
    | {name, source}
  ]
  | sort_by(.name, .source)
' "$tmp_dir/metadata.json" >"$tmp_dir/actual-declared.json"

jq -cS '
  [.declared_git_dependencies[] | {name, source}]
  | sort_by(.name, .source)
' "$ledger" >"$tmp_dir/expected-declared.json"

cmp -s "$tmp_dir/actual-declared.json" "$tmp_dir/expected-declared.json" \
  || fail "declared git dependency set differs from the exact policy ledger"

jq -cS '
  [
    .packages[]
    | select(.source != null and (.source | startswith("git+")))
    | {cargo_lock_source: .source}
  ]
  | group_by(.cargo_lock_source)
  | map({
      cargo_lock_source: .[0].cargo_lock_source,
      package_count: length
    })
  | sort_by(.cargo_lock_source)
' "$tmp_dir/metadata.json" >"$tmp_dir/actual-resolved.json"

jq -cS '
  [
    .resolved_git_sources[]
    | {cargo_lock_source, package_count}
  ]
  | sort_by(.cargo_lock_source)
' "$ledger" >"$tmp_dir/expected-resolved.json"

cmp -s "$tmp_dir/actual-resolved.json" "$tmp_dir/expected-resolved.json" \
  || fail "resolved git source/commit/package counts differ from the exact policy ledger"

jq -e '
  all(.[];
    .cargo_lock_source
    | capture("^git\\+https://.+\\?rev=(?<requested>[0-9a-f]{40})#(?<resolved>[0-9a-f]{40})$")
    | .requested == .resolved
  )
' "$tmp_dir/actual-resolved.json" >/dev/null \
  || fail "a resolved git source is branch-floating or commit-mismatched"

jq -r '
  .license_clarifications[]
  | [
      .package,
      .version,
      .source,
      .package_manifest_sha256,
      .license_path_from_package,
      .license_sha256
    ]
  | @tsv
' "$ledger" >"$tmp_dir/license-clarifications.tsv"

while IFS=$'\t' read -r package version source manifest_sha license_rel license_sha; do
  package_manifest="$(
    jq -r \
      --arg package "$package" \
      --arg version "$version" \
      --arg source "$source" '
        [
          .packages[]
          | select(
              .name == $package
              and .version == $version
              and .source == $source
            )
          | .manifest_path
        ]
        | if length == 1 then .[0] else empty end
      ' "$tmp_dir/metadata.json"
  )"
  [[ -n "$package_manifest" && -f "$package_manifest" ]] \
    || fail "license clarification package identity is absent or ambiguous: $package"
  [[ "$(sha256_file "$package_manifest")" == "$manifest_sha" ]] \
    || fail "package manifest evidence drifted for license clarification: $package"

  package_dir="$(CDPATH= cd -- "$(dirname -- "$package_manifest")" && pwd -P)"
  license_dir="$(CDPATH= cd -- "$package_dir/$(dirname -- "$license_rel")" && pwd -P)"
  license_file="$license_dir/$(basename -- "$license_rel")"
  [[ -f "$license_file" ]] \
    || fail "license evidence file is missing for: $package"
  [[ "$(sha256_file "$license_file")" == "$license_sha" ]] \
    || fail "license evidence SHA-256 drifted for: $package"
done <"$tmp_dir/license-clarifications.tsv"

set +e
"$deny_bin" \
  --manifest-path "$manifest" \
  --config "$deny_config" \
  --frozen \
  --format json \
  check bans licenses sources \
  >"$tmp_dir/cargo-deny.stdout" \
  2>"$tmp_dir/cargo-deny.jsonl"
deny_rc=$?
set -e

[[ "$deny_rc" -eq 0 ]] || {
  sed -n '1,120p' "$tmp_dir/cargo-deny.jsonl" >&2
  fail "cargo-deny rejected the native dependency graph"
}

deny_summary="$(
  jq -c 'select(.type == "summary") | .fields' "$tmp_dir/cargo-deny.jsonl"
)"
[[ "$(printf '%s\n' "$deny_summary" | wc -l | tr -d ' ')" == "1" ]] \
  || fail "cargo-deny emitted an invalid summary count"

jq -e '
  .bans.errors == 0
  and .licenses.errors == 0
  and .licenses.warnings == 0
  and .sources.errors == 0
  and .sources.warnings == 0
' <<<"$deny_summary" >/dev/null \
  || fail "cargo-deny source/license policy is not clean"

unexpected_warning_count="$(
  jq -r '
    select(
      .type == "diagnostic"
      and .fields.severity == "warning"
      and .fields.code != "duplicate"
    )
    | 1
  ' "$tmp_dir/cargo-deny.jsonl" | wc -l | tr -d ' '
)"
[[ "$unexpected_warning_count" == "0" ]] \
  || fail "cargo-deny emitted a warning other than duplicate-version inventory"

ledger_sha="$(sha256_file "$ledger")"

jq -cnS \
  --arg lock_sha "$actual_lock_sha" \
  --arg manifest_sha "$actual_manifest_sha" \
  --arg ledger_sha "$ledger_sha" \
  --arg deny_config_sha "$actual_deny_sha" \
  --arg deny_version "$deny_version" \
  --argjson deny_summary "$deny_summary" \
  --argjson resolved_git_source_count \
    "$(jq '.resolved_git_source_count' "$ledger")" \
  --argjson resolved_git_package_count \
    "$(jq '.resolved_git_package_count' "$ledger")" \
  --argjson license_clarification_count \
    "$(jq '.license_clarifications | length' "$ledger")" '
  {
    schema_version: "hepta_native_dependency_policy_receipt_v1",
    status: "ready",
    cargo_lock_sha256: $lock_sha,
    root_manifest_sha256: $manifest_sha,
    source_policy_ledger_sha256: $ledger_sha,
    cargo_deny: {
      version: $deny_version,
      config_sha256: $deny_config_sha,
      exit_code: 0,
      summary: $deny_summary
    },
    resolved_git_source_count: $resolved_git_source_count,
    resolved_git_package_count: $resolved_git_package_count,
    license_clarification_count: $license_clarification_count,
    source_revision_pinning_ready: true,
    license_evidence_ready: true
  }
'
