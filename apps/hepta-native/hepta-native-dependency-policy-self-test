#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
gate="$script_dir/hepta-native-dependency-policy"
ledger="$script_dir/dependency-source-policy-v1.json"

fail() {
  printf 'hepta-native dependency policy self-test: %s\n' "$*" >&2
  exit 1
}

for tool in jq; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool is unavailable: $tool"
done
[[ -x "$gate" && -f "$ledger" ]] || fail "policy gate or ledger is missing"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/hepta-native-dependency-policy-self-test.XXXXXX")"
trap 'rm -rf -- "$tmp_dir"' EXIT

"$gate" >"$tmp_dir/positive.json"
jq -e '
  .schema_version == "hepta_native_dependency_policy_receipt_v1"
  and .status == "ready"
  and .source_revision_pinning_ready == true
  and .license_evidence_ready == true
  and .cargo_deny.exit_code == 0
  and .cargo_deny.summary.licenses.errors == 0
  and .cargo_deny.summary.licenses.warnings == 0
  and .cargo_deny.summary.sources.errors == 0
  and .cargo_deny.summary.sources.warnings == 0
' "$tmp_dir/positive.json" >/dev/null || fail "positive policy receipt is invalid"

expect_rejected() {
  fixture="$1"
  label="$2"
  if HEPTA_NATIVE_DEPENDENCY_POLICY_LEDGER="$fixture" \
    "$gate" >"$tmp_dir/$label.stdout" 2>"$tmp_dir/$label.stderr"; then
    fail "negative fixture was accepted: $label"
  fi
}

jq '.cargo_lock.sha256 = ("0" * 64)' "$ledger" >"$tmp_dir/bad-lock.json"
expect_rejected "$tmp_dir/bad-lock.json" "bad-lock"

jq '
  .resolved_git_sources[0].commit = ("1" * 40)
' "$ledger" >"$tmp_dir/commit-drift.json"
expect_rejected "$tmp_dir/commit-drift.json" "commit-drift"

jq '
  .resolved_git_sources += [.resolved_git_sources[0]]
  | .resolved_git_source_count += 1
  | .resolved_git_package_count += .resolved_git_sources[0].package_count
' "$ledger" >"$tmp_dir/duplicate-source.json"
expect_rejected "$tmp_dir/duplicate-source.json" "duplicate-source"

jq '
  .license_clarifications[0].license_sha256 = ("0" * 64)
' "$ledger" >"$tmp_dir/license-drift.json"
expect_rejected "$tmp_dir/license-drift.json" "license-drift"

jq -cnS '
  {
    schema_version: "hepta_native_dependency_policy_self_test_receipt_v1",
    status: "ready",
    positive_fixture_count: 1,
    negative_fixture_count: 4,
    rejected_negative_fixtures: [
      "bad-lock",
      "commit-drift",
      "duplicate-source",
      "license-drift"
    ]
  }
'
