{
  "schemaVersion": 3,
  "name": "Hepta semantic light glass",
  "version": 3,
  "description": "Canonical semantic roles for Native and Control. Shared roles intentionally have identical values; surface-specific roles preserve each renderer's independently validated composition.",
  "color": {
    "shared": {
      "text": "#142a32ff",
      "focus": "#0f7290ff",
      "secondaryAccent": "#14b8a6ff"
    },
    "native": {
      "environment": "#eef3f5ff",
      "content": "#fcfdfeff",
      "surface": "#f7fafbfa",
      "glass": "#eaf1f3e8",
      "glassStrong": "#f5f8f9ee",
      "input": "#f8fafbf8",
      "muted": "#566a78ff",
      "dim": "#5c6e79ff",
      "hairline": "#8fb4bf66",
      "hairlineStrong": "#6f9eaa8f",
      "focusHover": "#0b5d78ff",
      "focusSurface": "#dceff4e8",
      "focusSurfaceHover": "#d0e8eef2",
      "selection": "#0f729026",
      "success": "#137a5aff",
      "successSurface": "#e7f6eff2",
      "danger": "#b63845ff",
      "dangerSurface": "#fcedeff2",
      "warning": "#9a6500ff",
      "disabled": "#b9c4c9ff",
      "disabledSurface": "#e6eceeff",
      "shadow": "#17304714"
    },
    "control": {
      "environment": "#eef5f7ff",
      "panel": "#e8eff1f0",
      "input": "#f1f5f5f2",
      "muted": "#506575ff",
      "dim": "#566a78ff",
      "hairline": "#a5ccd7b8",
      "activeSurface": "#eaf7fcee",
      "success": "#128a61ff",
      "glassShadow": "#1730471f",
      "glassGlow": "#0f72901f",
      "elevated": "#f7fafbff",
      "textStrong": "#0b222bff",
      "mutedStrong": "#344e59ff",
      "accentHover": "#0a667bff"
    }
  },
  "radius": {
    "shared": {
      "control": 10,
      "floating": 18
    },
    "native": {
      "panel": 14
    },
    "control": {
      "panel": 16
    }
  },
  "motion": {
    "control": {
      "fastMs": 100,
      "normalMs": 180
    }
  },
  "materialLayers": {
    "environment": {
      "surfaceAlpha": 1.0,
      "hairlineAlpha": 0.0,
      "shadowAlpha": 0.0,
      "radiusPx": 0,
      "blurPx": 0
    },
    "stableContent": {
      "surfaceAlpha": 0.98,
      "hairlineAlpha": 0.18,
      "shadowAlpha": 0.03,
      "radiusPx": 16,
      "blurPx": 0
    },
    "glassChrome": {
      "surfaceAlpha": 0.88,
      "hairlineAlpha": 0.32,
      "shadowAlpha": 0.07,
      "radiusPx": 16,
      "blurPx": 14
    },
    "floatingGlass": {
      "surfaceAlpha": 0.94,
      "hairlineAlpha": 0.42,
      "shadowAlpha": 0.11,
      "radiusPx": 18,
      "blurPx": 20
    },
    "limits": {
      "maxVisibleBackdropLayers": 2,
      "maxStableContentBackdropLayers": 0
    }
  },
  "rendererPolicy": {
    "nativeOutput": "apps/hepta-native/src/shared/hepta_theme.rs",
    "controlOutput": "apps/hepta-control-ui/light-glass-tokens.generated.css",
    "defaultMode": "check",
    "writeRequiresFlag": "--write"
  }
}
